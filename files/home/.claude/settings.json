      "Bash(gh pr view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(obsidian backlinks*)",
      "Bash(obsidian daily:read*)",
      "Bash(obsidian files*)",
      "Bash(obsidian links*)",
      "Bash(obsidian outline*)",
      "Bash(obsidian read*)",
      "Bash(obsidian search*)",
      "Bash(obsidian tags*)",
      "Bash(obsidian tasks*)",
      "Bash(obsidian vault*)",
      "Bash(obsidian vault=* backlinks*)",
      "Bash(obsidian vault=* daily:read*)",
      "Bash(obsidian vault=* files*)",
      "Bash(obsidian vault=* links*)",
      "Bash(obsidian vault=* outline*)",
      "Bash(obsidian vault=* read*)",
      "Bash(obsidian vault=* search*)",
      "Bash(obsidian vault=* tags*)",
      "Bash(obsidian vault=* tasks*)",
      "Bash(obsidian vault=* vault*)",
      "Bash(obsidian vault=* vaults*)",
      "Bash(obsidian vaults*)",
      "Read(~/.cache/ws-tomd/**)"
