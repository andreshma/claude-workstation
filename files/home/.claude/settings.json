        "*.crates.io",
        "*.github.com",
        "*.githubusercontent.com",
        "*.nuget.org",
        "api.nuget.org",
        "crates.io",
        "files.pythonhosted.org",
        "github.com",
        "learn.microsoft.com",
        "mcr.microsoft.com",
        "packages.microsoft.com",
        "pypi.org",
        "registry.npmjs.org",
        "registry.terraform.io",
        "registry.yarnpkg.com",
        "releases.hashicorp.com",
        "static.rust-lang.org"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.azure",
        "~/.config/gh",
        "~/.kube",
        "~/.ssh",
        "~/.docker/config.json",
        "~/.claude/.credentials.json",
        "~/.claude-personal/.credentials.json",
        "~/.config/anthropic",
        "~/.config/anthropic-copiloto",
        "~/.gnupg",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.git-credentials",
        "~/.config/git/credentials",
        "~/.terraform.d",
        "~/.config/ws-telegram",
        "~/.local/share/ws-telemetria/otel",
        "~/.bash_history",
        "/@WINHOME@/.ssh",
        "/@WINHOME@/.aws",
        "/@WINHOME@/.azure",
        "/@WINHOME@/.kube",
        "/@WINHOME@/.docker",
        "/@WINHOME@/.gnupg",
        "/@WINHOME@/.git-credentials",
        "/@WINHOME@/.netrc",
        "/@WINHOME@/.npmrc",
        "/@WINHOME@/.pypirc",
        "/@WINHOME@/.terraform.d",
        "/@WINHOME@/AppData/Roaming/GitHub CLI",
        "/@WINHOME@/AppData/Roaming/gcloud",
        "/@WINHOME@/AppData/Local/Google/Chrome/User Data",
        "/@WINHOME@/AppData/Local/Microsoft/Edge/User Data",
        "/@WINHOME@/AppData/Roaming/Mozilla/Firefox/Profiles",
        "/@WINHOME@/AppData/Local/Microsoft/Credentials",
        "/@WINHOME@/AppData/Roaming/Microsoft/Credentials",
        "/@WINHOME@/AppData/Roaming/Microsoft/Protect"
