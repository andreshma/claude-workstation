    "deny": [
      "Bash(*--unregister*)",
      "Bash(aws configure export-credentials*)",
      "Bash(aws configure get*)",
      "Bash(aws ecr get-login-password*)",
      "Bash(aws secretsmanager get-secret-value*)",
      "Bash(aws ssm get-parameter*--with-decryption*)",
      "Bash(aws sts get-session-token*)",
      "Bash(az * keys list*)",
      "Bash(az account get-access-token*)",
      "Bash(az keyvault secret download*)",
      "Bash(az keyvault secret show*)",
      "Bash(gh release delete*)",
      "Bash(gh repo delete*)",
      "Bash(obsidian delete*)",
      "Bash(obsidian dev*)",
      "Bash(obsidian eval*)",
      "Bash(obsidian plugin:install*)",
      "Bash(obsidian plugin:uninstall*)",
      "Bash(obsidian publish*)",
      "Bash(obsidian theme:install*)",
      "Bash(obsidian vault=* delete*)",
      "Bash(obsidian vault=* dev*)",
      "Bash(obsidian vault=* eval*)",
      "Bash(obsidian vault=* plugin:install*)",
      "Bash(obsidian vault=* plugin:uninstall*)",
      "Bash(obsidian vault=* publish*)",
      "Bash(obsidian vault=* theme:install*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude-personal/.credentials.json)",
      "Read(~/.config/anthropic/**)",
      "Read(~/.config/anthropic-copiloto/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Read(~/.terraform.d/**)",
      "Read(~/.config/ws-telegram/**)",
      "Read(~/.local/share/ws-telemetria/otel/**)",
      "Read(~/.bash_history)",
      "Read(/@WINHOME@/.ssh/**)",
      "Read(/@WINHOME@/.aws/**)",
      "Read(/@WINHOME@/.azure/**)",
      "Read(/@WINHOME@/.kube/**)",
      "Read(/@WINHOME@/.docker/**)",
      "Read(/@WINHOME@/.gnupg/**)",
      "Read(/@WINHOME@/.git-credentials)",
      "Read(/@WINHOME@/.netrc)",
      "Read(/@WINHOME@/.npmrc)",
      "Read(/@WINHOME@/.pypirc)",
      "Read(/@WINHOME@/.terraform.d/**)",
      "Read(/@WINHOME@/AppData/Roaming/GitHub CLI/**)",
      "Read(/@WINHOME@/AppData/Roaming/gcloud/**)",
      "Read(/@WINHOME@/AppData/Local/Google/Chrome/User Data/**)",
      "Read(/@WINHOME@/AppData/Local/Microsoft/Edge/User Data/**)",
      "Read(/@WINHOME@/AppData/Roaming/Mozilla/Firefox/Profiles/**)",
      "Read(/@WINHOME@/AppData/Local/Microsoft/Credentials/**)",
      "Read(/@WINHOME@/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(/@WINHOME@/AppData/Roaming/Microsoft/Protect/**)",
      "Bash(az * show-connection-string*)",
      "Bash(az * credential show*)",
      "Bash(az * list-keys*)",
      "Bash(az * appsettings list*)",
      "Bash(az * list-credentials*)",
      "Bash(ws-secret get*)",
      "Bash(* ws-secret get*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git config *core.hooksPath*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config *ws.gate*)",
      "Read(~/.ssh/**)",
      "Read(~/.azure/**)",
      "Read(~/.gnupg/**)"
    ],
    "ask": [
      "Bash(aws * create-*)",
      "Bash(aws * delete-*)",
      "Bash(aws * put-*)",
      "Bash(aws * run-instances*)",
      "Bash(aws * terminate-*)",
      "Bash(aws * update-*)",
      "Bash(aws cloudformation deploy*)",
      "Bash(aws s3 cp*)",
      "Bash(aws s3 mv*)",
      "Bash(aws s3 rm*)",
      "Bash(aws s3 sync*)",
      "Bash(azd deploy*)",
      "Bash(azd down*)",
      "Bash(azd provision*)",
      "Bash(azd up*)",
      "Bash(docker push*)",
      "Bash(docker rmi*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(git add --all*)",
      "Bash(git add -A*)",
      "Bash(git add .*)",
      "Bash(helm install*)",
      "Bash(helm rollback*)",
      "Bash(helm uninstall*)",
      "Bash(helm upgrade*)",
      "Bash(k6 run*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(mysql *)",
      "Bash(psql *)",
      "Bash(sqlcmd *)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform state *)",
      "mcp__azure__*deploy*",
      "mcp__azure__*restart*",
      "mcp__azure__*set*",
      "mcp__azure__*start*",
      "mcp__azure__*stop*",
      "mcp__azure__*update*",
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker compose up *)",
      "Bash(docker compose run *)",
      "Bash(docker build *)",
      "Bash(docker cp *)",
      "Bash(docker pull *)",
      "Bash(docker push *)",
      "Bash(pwsh.exe *)",
      "Bash(pwsh *)",
      "Bash(powershell.exe *)",
      "Bash(cmd.exe *)",
      "Bash(wsl.exe *)",
      "mcp__azure__*create*",
      "mcp__azure__*delete*",
      "mcp__azure__*remove*",
      "mcp__azure__*purge*",
      "mcp__azure__*assign*",
      "mcp__azure__*import*",
      "mcp__azure__*scale*",
      "mcp__azure__*rotate*",
      "mcp__azure__*regenerate*",
      "mcp__azure__*install*",
      "mcp__azure__*execute*",
      "mcp__azure__*invoke*",
      "mcp__azure__keyvault",
      "mcp__azure__appconfig",
      "mcp__azure__role",
      "mcp__azure__deploy",
      "mcp__azure__azd",
      "mcp__azure__extension_cli_*",
      "mcp__azure__storage",
      "mcp__azure__cosmos",
      "mcp__azure__sql",
      "mcp__azure__postgres",
      "mcp__azure__mysql",
      "mcp__azure__redis",
      "mcp__azure__kusto",
      "mcp__claude_ai_Microsoft_365__*send*",
