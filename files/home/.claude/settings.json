  },
  "model": "claude-fable-5-2",
  "fallbackModel": [
    "claude-opus-5-5",
    "claude-sonnet-5-5"
  ],
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh wait"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/win-notify.sh wait"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-sandbox-aviso.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh posttool"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/lint-on-edit.sh",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-sandbox-aviso.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh posttool"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh tool"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit.sh tool"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/guard.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/read-convert.sh",
            "timeout": 180
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh end"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit.sh end"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/win-hook.sh",
            "args": [
              "mempalace.exe",
              "hook",
              "run",
              "--hook",
              "session-end",
              "--harness",
              "claude-code"
            ],
            "timeout": 45
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit.sh start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/ws-cache",
            "args": [
              "--max",
              "1800",
              "--tope",
              "25",
              "60",
              "pwsh.exe",
              "-NoProfile",
              "-File",
              "C:\\Users\\@WIN_USER@\\source\\repos\\mempalace-ops\\mempalace-health.ps1"
            ],
            "timeout": 25,
            "statusMessage": "Checking MemPalace health..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/win-hook.sh",
            "args": [
              "mempalace.exe",
              "hook",
              "run",
              "--hook",
              "session-start",
              "--harness",
              "claude-code"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.local/bin/ws-cache",
            "args": [
              "60",
              "pwsh.exe",
              "-NoProfile",
              "-File",
              "C:\\Users\\@WIN_USER@\\source\\repos\\recall\\start-recall.ps1"
            ],
            "timeout": 10,
            "statusMessage": "Starting recall..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/win-hook.sh",
            "args": [
              "mempalace.exe",
              "hook",
              "run",
              "--hook",
              "stop",
              "--harness",
              "claude-code"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/win-notify.sh done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh error"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh substart"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh substop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh prompt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit.sh prompt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/intent-route.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/win-hook.sh",
            "args": [
              "/@WINHOME@/source/repos/recall/.venv/Scripts/python.exe",
              "-I",
              "C:\\Users\\@WIN_USER@\\source\\repos\\recall\\recall_hook.py"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/win-notify.sh prompt"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ws-ruteo.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/audit.sh denied"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "@HOME@/.claude/hooks/win-hook.sh",
            "args": [
              "mempalace.exe",
              "hook",
              "run",
              "--hook",
              "precompact",
              "--harness",
              "claude-code"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ws-trazas.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/tmux-state.sh compact"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
