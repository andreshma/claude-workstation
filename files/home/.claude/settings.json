      "mcp__claude_ai_Microsoft_365__*modify*",
      "mcp__claude_ai_Microsoft_365__*move*",
      "mcp__claude_ai_Microsoft_365__*copy*",
      "mcp__claude_ai_Microsoft_365__*rename*",
      "mcp__claude_ai_Microsoft_365__*upload*",
      "mcp__claude_ai_Microsoft_365__*respond*",
      "mcp__claude_ai_Microsoft_365__*vacation*",
      "mcp__mempalace__*delete*",
      "mcp__mempalace__*invalidate*",
      "mcp__mempalace__*supersede*"
