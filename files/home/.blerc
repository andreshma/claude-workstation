# ~/.blerc — ble.sh configuration (line editor with suggestions and colors).
# Gray suggestion from history: → (or Ctrl+F) accepts all of it, Alt+F one word.

# Automatic suggestions: they appear after a short pause so they do not distract.
bleopt complete_auto_delay=300
bleopt complete_auto_history=1

# No bell and no flashing; the completion menu does not take half the screen.
bleopt edit_abell=
bleopt edit_vbell=
bleopt complete_menu_maxlines=10

# Discreet colors: the suggestion in dim gray and errors (nonexistent command) in red.
ble-face -s auto_complete fg=242
ble-face -s command_function fg=33
ble-face -s syntax_error fg=203,bold
bleopt accept_line_threshold=-1
