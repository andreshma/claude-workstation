#!/usr/bin/env bash
#
# tmux-active — at a glance, the tabs that are working NOW or had recent activity, across all groups, without
# visiting them one by one. Ctrl+b a (or Menu → a).
#   First what is waiting for you (✋ approve, ❓ question, ✖ error), then what is working (🧠 🔧 🐝 📦) and last
#   what finished recently (✔ done < 15 min ago, ⛔ interrupted). Grouped by group (tmux session).
#   Enter goes to the tab · Ctrl+R refreshes (it refreshes itself every 3 s if your fzf supports it) · Esc closes
# Usage: tmux-active [--minutes 15]   ·   tmux-active --list [--minutes N]   (rows only; tests)
set -uo pipefail
TAB=$'\t'
MIN=15
for ((i = 1; i <= $#; i++)); do [[ "${!i}" == --minutes ]] && { j=$((i + 1)); MIN="${!j}"; }; done

list_rows() {
  [[ -x "$HOME/.local/bin/tmux-status" ]] && "$HOME/.local/bin/tmux-status" --all
  local now; now=$(date +%s)
  tmux list-windows -a -F "#{?session_grouped,#{session_group},#{session_name}}${TAB}#{session_name}${TAB}#{window_id}${TAB}#{window_index} #{window_name}${TAB}#{?#{@cphase},#{@cphase},-}${TAB}#{?#{@cs},#{@cs},-}${TAB}#{?#{@cdet},#{@cdet},-}${TAB}#{?#{@cts},#{@cts},0}${TAB}#{window_activity}${TAB}#{?#{@label},#{@label},}" 2>/dev/null |
  awk -F"$TAB" -v OFS="$TAB" -v now="$now" -v min="$MIN" '
    $1 != $2 { next }                       # linked session (monitor 2): already listed with its group
    {
      f = $5; last = ($8 > $9 ? $8 : $9); ago = now - last
      if (f ~ /^(permission|question|yourturn|error)$/) p = 0
      else if (f ~ /^(thinking|tool|compacting)$/)             p = 1
      else if (ago <= min * 60)                                    p = 2
      else next
      det = ($7 == "-" ? "" : $7); state = ($6 == "-" ? (f == "-" ? "activity" : f) : $6)
      printf "%d%s%s%s%s:%s%s\033[36m%-10.10s\033[0m %-22.22s %-24.24s %-40.40s %s\n", p, OFS, $1, OFS, $2, $3, OFS, "[" $1 "]", $4, state, det, $10
    }' | sort -t"$TAB" -k1,1n -k2,2 | cut -f3-
}

if [[ " $* " == *" --list "* ]]; then list_rows; exit 0; fi
command -v fzf >/dev/null || { list_rows | cut -f2-; read -rsn1; exit 0; }
header="$(printf '%-10s %-22s %-24s %-40s %s' GROUP TAB STATE 'DOING' LABEL)"
extra=()
# fzf ≥ 0.36: --listen lets the list be refreshed from outside every 3 s.
if fzf --help 2>/dev/null | grep -q -- '--listen'; then
  port=$(( 20000 + RANDOM % 20000 ))
  extra=(--listen "127.0.0.1:$port")
  ( sleep 3; while kill -0 $$ 2>/dev/null; do
      curl -s -XPOST "127.0.0.1:$port" -d "reload($0 --list --minutes $MIN)" >/dev/null 2>&1 || break; sleep 3; done ) &
fi
sel="$(list_rows | fzf --ansi --delimiter="$TAB" --with-nth=2 --no-sort --reverse --cycle "${extra[@]}" \
        --header="$header"$'\n'"Active now or with activity in the last $MIN min · Enter goes · Ctrl+R refreshes · Esc closes" \
        --bind "ctrl-r:reload($0 --list --minutes $MIN)" --prompt 'active> ')" || exit 0
target="${sel%%"$TAB"*}"
tmux switch-client -t "=${target%%:*}" 2>/dev/null
tmux select-window -t "${target#*:}" 2>/dev/null
