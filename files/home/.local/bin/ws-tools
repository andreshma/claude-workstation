#!/usr/bin/env bash
#
# ws-tools — inventory of the workstation's tools in WSL (what is there, which version, what
# is missing) and installation per tool or per group from official sources: apt (signed
# repos), pipx (PyPI), GitHub binaries verified against the checksum of their release, or npm packages pinned with
# a committed package-lock.json (ws-pinned: exact version and sha512 of every tarball, install scripts off).
#
# Usage:
#   ws-tools                                 inventory
#   ws-tools install <group|tool>...         groups: base cloud aws containers quality
#                                            python web rust sql dev
#   ws-tools install --force ...             installs even if C: has less than 10 GB free
set -uo pipefail
MIN_FREE_GB=10
AGG_VER=v1.9.0
AGG_SHA=ddcbf6ca044c8ac3a434dcb9ee89fb9e3be87209982b7c2adb55f782e8f0f390

# name|group|version command|how to install (apt:package, pipx:package, fn:function, manual:text)
# The version command cannot contain "|" (it is the field separator).
TOOLS=(
  "tmux|base|tmux -V|apt:tmux"
  "git|base|git --version|apt:git"
  "fzf|base|fzf --version|apt:fzf"
  "jq|base|jq --version|apt:jq"
  "curl|base|curl --version|apt:curl"
  "unzip|base|unzip -v|apt:unzip"
  "rsync|base|rsync --version|apt:rsync"
  "bubblewrap|base|bwrap --version|apt:bubblewrap"
  "socat|base|socat -V|apt:socat"
  "gitleaks|base|gitleaks version|apt:gitleaks"
  "shellcheck|base|shellcheck --version|apt:shellcheck"
  "gh|base|gh --version|apt:gh"
  "ripgrep|base|rg --version|apt:ripgrep"
  "fd|base|fdfind --version|apt:fd-find"
  "bat|base|batcat --version|apt:bat"
  "pipx|base|pipx --version|apt:pipx"
  "asciinema|base|asciinema --version|apt:asciinema"
  "agg|base|agg --version|fn:agg"
  "starship|base|starship --version|fn:starship"
  "wslu|base|wslview --version|apt:wslu"
  "az|cloud|az version --query '\"azure-cli\"' -o tsv|fn:az"
  "bicep|cloud|$HOME/.azure/bin/bicep --version|fn:bicep"
  "azd|cloud|azd version|fn:azd"
  "kubectl|cloud|kubectl version --client|fn:aks"
  "kubelogin|cloud|kubelogin --version|fn:aks"
  "kubectx|cloud|command -v kubectx|apt:kubectx"
  "helm|cloud|helm version --short|fn:helm"
  "k9s|cloud|k9s version --short|fn:k9s"
  "terraform|cloud|terraform version|fn:terraform"
  "tflint|cloud|tflint --version|fn:tflint"
  "aws|aws|aws --version|fn:awscli"
  "docker|containers|docker --version|manual:Docker Desktop → Settings → Resources → WSL integration → Ubuntu"
  "compose|containers|docker compose version|manual:comes with Docker Desktop"
  "scout|containers|docker scout --help >/dev/null 2>&1 && echo available|manual:comes with Docker Desktop (docker scout cves <image>)"
  "hadolint|containers|hadolint --version|fn:hadolint"
  "checkov|quality|checkov --version|pipx:checkov"
  "pre-commit|quality|pre-commit --version|pipx:pre-commit"
  "k6|quality|k6 version|fn:k6"
  "osv-scanner|quality|osv-scanner --version|fn:osv"
  "markitdown|quality|markitdown --version|pipx:markitdown[all]"
  "pandoc|quality|pandoc --version|apt:pandoc"
  "pdfimages|quality|pdfimages -v 2>&1|apt:poppler-utils"
  "yamllint|quality|yamllint --version|apt:yamllint"
  "python3|python|python3 -m venv --help >/dev/null && python3 --version|apt:python3-venv"
  "chafa|base|chafa --version | head -1|apt:chafa"
  "numpy|python|python3 -c 'import numpy; print(numpy.__version__)'|apt:python3-numpy"
  "uv|python|uv --version|pipx:uv"
  "ruff|python|ruff --version|fn:ruff"
  "node-lts|web|node -e 'process.exit(+process.versions.node.split(\".\")[0] % 2)' && node --version|fn:fnm"
  "pnpm|web|pnpm --version|fn:pnpm"
  "agent-browser|web|$HOME/.local/bin/agent-browser --version|fn:agent_browser"
  "chrome-devtools-mcp|web|$HOME/.local/share/ws-kit/npm/chrome-devtools-mcp/node_modules/.bin/chrome-devtools-mcp --version|fn:chrome_devtools_mcp"
  "angular|web|command -v ng|manual:per project with npx ng …, or npm i -g @angular/cli with the fnm Node"
  "rustup|rust|rustup --version|fn:rustup"
  "cargo|rust|cargo --version|fn:rustup"
  "psql|sql|psql --version|apt:postgresql-client"
  "sqlite3|sql|sqlite3 --version|apt:sqlite3"
  "mysql|sql|mysql --version|apt:mariadb-client"
  "sqlcmd|sql|sqlcmd --version|fn:sqlcmd"
  "dotnet|dev|dotnet --version|apt:dotnet-sdk-8.0"
  "pwsh.exe|dev|pwsh.exe -NoLogo -NoProfile -Command \$PSVersionTable.PSVersion.ToString()|manual:PowerShell 7 on Windows (optional; the popup uses 5.1)"
)

field() { cut -d'|' -f"$2" <<<"$1"; }
# version_of <command> — first line of its output; fails if the command fails. Reads the whole
# output before trimming it: with pipefail, cutting the pipe (grep -m1) gave false MISSING.
version_of() {
  local out; out="$(timeout 8 bash -c "$1" 2>/dev/null)" || return 1
  out="$(grep -m1 . <<<"$out")"; [[ -n "$out" ]] || return 1
  tr -s ' ' <<<"$out" | cut -c1-48
}

inventory() {
  local t n g v how ok=0 miss=0
  printf '%-19s %-13s %-7s %s\n' TOOL GROUP STATUS "VERSION / HOW TO INSTALL"
  for t in "${TOOLS[@]}"; do
    n="$(field "$t" 1)"; g="$(field "$t" 2)"; how="$(field "$t" 4)"
    if v="$(version_of "$(field "$t" 3)")" && [[ -n "$v" ]]; then
      printf '%-19s %-13s \033[32m%-7s\033[0m %s\n' "$n" "$g" OK "$v"; ok=$((ok + 1))
    else
      printf '%-19s %-13s \033[31m%-7s\033[0m %s\n' "$n" "$g" MISSING "${how#*:}"; miss=$((miss + 1))
    fi
  done
  printf '\n%d installed, %d missing. Install with: ws-tools install <group|tool>\n' "$ok" "$miss"
}

# --- installers (fn:) ----------------------------------------------------------
apt_repo() { # apt_repo <name> <key url> <deb line with KEYRING>
  local kr="/usr/share/keyrings/$1.gpg"
  [[ -f "/etc/apt/sources.list.d/$1.list" ]] && return 0
  curl -fsSL "$2" | sudo gpg --dearmor --yes -o "$kr"
  echo "${3//KEYRING/$kr}" | sudo tee "/etc/apt/sources.list.d/$1.list" >/dev/null
  sudo apt-get update -qq
}
gh_latest() { # gh_latest <repo> <asset> <checksums file> <destination>
  local base="https://github.com/$1/releases/latest/download" d exp act; d="$(mktemp -d)"
  if ! curl -fsSL -o "$d/$2" "$base/$2" || ! curl -fsSL -o "$d/sums" "$base/$3"; then echo "  could not download $2"; rm -rf "$d"; return 1; fi
  exp="$(awk -v f="$2" '$2 == f || $2 == "*" f { print $1; exit }' "$d/sums")"
  [[ -n "$exp" ]] || exp="$(awk 'NF == 1 { print $1; exit }' "$d/sums")"
  act="$(sha256sum "$d/$2" | cut -d' ' -f1)"
  if [[ -z "$exp" || "$exp" != "$act" ]]; then echo "  checksum of $2 does not match; not installing"; rm -rf "$d"; return 1; fi
  cp "$d/$2" "$4"; rm -rf "$d"
}
fn_agg() {
  local f; f="$(mktemp)"
  curl -fsSL -o "$f" "https://github.com/asciinema/agg/releases/download/$AGG_VER/agg-x86_64-unknown-linux-musl" &&
    echo "$AGG_SHA  $f" | sha256sum -c --quiet && install -m 755 "$f" "$HOME/.local/bin/agg"; rm -f "$f"
}
fn_az()        { curl -fsSL https://aka.ms/InstallAzureCLIDeb -o /tmp/az-install.sh && sudo bash /tmp/az-install.sh; }
fn_bicep()     { az bicep install; }
fn_aks()       { sudo az aks install-cli; }
fn_terraform() {
  apt_repo hashicorp https://apt.releases.hashicorp.com/gpg \
    "deb [signed-by=KEYRING] https://apt.releases.hashicorp.com $(lsb_release -cs) main"
  sudo apt-get install -y terraform
}
fn_helm() {
  apt_repo helm https://packages.buildkite.com/helm-linux/helm-debian/gpgkey \
    "deb [signed-by=KEYRING] https://packages.buildkite.com/helm-linux/helm-debian/any/ any main"
  sudo apt-get install -y helm
}
fn_k6() {
  if [[ ! -f /etc/apt/sources.list.d/k6.list ]]; then
    sudo gpg --no-default-keyring --keyring /usr/share/keyrings/k6-archive-keyring.gpg \
      --keyserver hkp://keyserver.ubuntu.com:80 --recv-keys C5AD17C747E3415A3642D57D77C6C491D6AC1D69
    echo "deb [signed-by=/usr/share/keyrings/k6-archive-keyring.gpg] https://dl.k6.io/deb stable main" |
      sudo tee /etc/apt/sources.list.d/k6.list >/dev/null
    sudo apt-get update -qq
  fi
  sudo apt-get install -y k6
}
fn_tflint() {
  local d; d="$(mktemp -d)"
  gh_latest terraform-linters/tflint tflint_linux_amd64.zip checksums.txt "$d/t.zip" &&
    unzip -o -q "$d/t.zip" -d "$d" && install -m 755 "$d/tflint" "$HOME/.local/bin/tflint"; rm -rf "$d"
}
fn_k9s() {
  local d; d="$(mktemp -d)"
  gh_latest derailed/k9s k9s_linux_amd64.deb checksums.sha256 "$d/k9s.deb" && sudo apt-get install -y "$d/k9s.deb"; rm -rf "$d"
}
fn_hadolint() { gh_latest hadolint/hadolint hadolint-Linux-x86_64 hadolint-Linux-x86_64.sha256 "$HOME/.local/bin/hadolint" && chmod 755 "$HOME/.local/bin/hadolint"; }
fn_awscli() {
  local d; d="$(mktemp -d)"
  curl -fsSL -o "$d/aws.zip" https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip &&
    unzip -q "$d/aws.zip" -d "$d" && sudo "$d/aws/install" --update; rm -rf "$d"
}
fn_osv() { gh_latest google/osv-scanner osv-scanner_linux_amd64 osv-scanner_SHA256SUMS "$HOME/.local/bin/osv-scanner" && chmod 755 "$HOME/.local/bin/osv-scanner"; }
fn_starship() {
  local d; d="$(mktemp -d)"
  gh_latest starship/starship starship-x86_64-unknown-linux-musl.tar.gz starship-x86_64-unknown-linux-musl.tar.gz.sha256 "$d/s.tgz" &&
    tar -xzf "$d/s.tgz" -C "$d" && install -m 755 "$d/starship" "$HOME/.local/bin/starship"; rm -rf "$d"
}
fn_ruff() { uv tool install ruff; }
fn_rustup() {
  curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh &&
    sh /tmp/rustup-init.sh -y --profile default && echo "  Open a new terminal to have cargo in the PATH."
}
fn_fnm() {
  local dir="$HOME/.local/share/fnm"
  curl -fsSL https://fnm.vercel.app/install -o /tmp/fnm-install.sh && bash /tmp/fnm-install.sh --skip-shell --install-dir "$dir" || return 1
  grep -q 'fnm env' "$HOME/.bashrc" ||
    printf '\n# Node LTS with fnm (uses /tmp if /run/user/$UID does not exist yet when WSL starts)\nexport PATH="%s:$PATH"\n_fnm_rt="${XDG_RUNTIME_DIR:-}"; [ -d "$_fnm_rt" ] || { _fnm_rt="/tmp/fnm-$UID"; mkdir -p "$_fnm_rt" && chmod 700 "$_fnm_rt"; }\neval "$(XDG_RUNTIME_DIR="$_fnm_rt" fnm env --use-on-cd --shell bash)"; unset _fnm_rt\n' "$dir" >> "$HOME/.bashrc"
  "$dir/fnm" install --lts && "$dir/fnm" default lts-latest && echo "  Open a new terminal to use the Node LTS."
}
fn_pnpm() { npm install -g pnpm || echo "  If it fails on permissions, install the fnm Node first (ws-tools install node-lts)."; }
fn_sqlcmd() {
  if [[ ! -f /etc/apt/sources.list.d/microsoft-prod.list ]]; then
    curl -fsSL "https://packages.microsoft.com/config/ubuntu/$(lsb_release -rs)/packages-microsoft-prod.deb" -o /tmp/pmp.deb &&
      sudo dpkg -i /tmp/pmp.deb && sudo apt-get update -qq
  fi
  sudo apt-get install -y sqlcmd
}
# Pinned npm packages (ws-pinned): the kit's package-lock.json, npm ci --ignore-scripts, a hash of the installed tree.
fn_agent_browser() {
  "$HOME/.local/bin/ws-pinned" install agent-browser || return 1
  # Chrome for Testing in agent-browser's own profile and cache (downloaded from Google over HTTPS; Google publishes
  # no checksum for it). System libraries, if Chrome does not start: agent-browser install --with-deps (sudo).
  "$HOME/.local/bin/agent-browser" install || echo "  Chrome for Testing was not installed: agent-browser install (or --with-deps)"
  echo "  Allowed domains: ~/.config/agent-browser/allowed-domains.txt (kit, localhost) + allowed-domains.local.txt (yours)."
}
fn_chrome_devtools_mcp() {
  "$HOME/.local/bin/ws-pinned" install chrome-devtools-mcp || return 1
  echo "  Opt-in MCP server: it needs a Chrome reachable from WSL (docs/USAGE.md, chrome-devtools). Register it with:"
  echo "  bash ~/code/claude-workstation/install.sh --mcp-opt-in chrome-devtools"
}
fn_azd() { curl -fsSL https://aka.ms/install-azd.sh -o /tmp/install-azd.sh && bash /tmp/install-azd.sh; }

install_tools() {
  local force=0 want=() t n g how apt=() pipx=() fns=() manual=()
  for a in "$@"; do [[ "$a" == --force ]] && force=1 || want+=("$a"); done
  (( ${#want[@]} )) || { echo "Give groups or tools: base cloud quality dev | terraform helm …"; return 2; }
  local free; free="$(df -BG --output=avail /mnt/c 2>/dev/null | tail -1 | tr -dc 0-9)"
  if (( force == 0 && ${free:-0} < MIN_FREE_GB )); then
    echo "C: has ${free:-?} GB free (minimum $MIN_FREE_GB). The Ubuntu disk grows on C:; free up space or use --force."
    return 1
  fi
  for t in "${TOOLS[@]}"; do
    n="$(field "$t" 1)"; g="$(field "$t" 2)"; how="$(field "$t" 4)"
    [[ " ${want[*]} " == *" $n "* || " ${want[*]} " == *" $g "* ]] || continue
    version_of "$(field "$t" 3)" | grep -q . && continue        # already installed
    case "$how" in
      apt:*)    apt+=("${how#apt:}") ;;
      pipx:*)   pipx+=("${how#pipx:}") ;;
      fn:*)     [[ " ${fns[*]} " == *" ${how#fn:} "* ]] || fns+=("${how#fn:}") ;;
      manual:*) manual+=("$n: ${how#manual:}") ;;
    esac
  done
  (( ${#apt[@]} ))  && { echo "==> apt: ${apt[*]}"; sudo apt-get install -y "${apt[@]}"; }
  (( ${#pipx[@]} )) && { echo "==> pipx: ${pipx[*]}"; for p in "${pipx[@]}"; do pipx install "$p"; done; pipx ensurepath >/dev/null; }
  for f in "${fns[@]}"; do echo "==> $f"; "fn_$f" || echo "  $f failed"; done
  (( ${#manual[@]} )) && { echo "==> By hand:"; printf '  %s\n' "${manual[@]}"; }
  echo; inventory
}

case "${1:-}" in
  ""|inventory|check) inventory ;;
  install) shift; install_tools "$@" ;;
  -h|--help) sed -n '3,11p' "$0" ;;
  *) echo "usage: ws-tools [install <group|tool>...]" >&2; exit 2 ;;
esac
