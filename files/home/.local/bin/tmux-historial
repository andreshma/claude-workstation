#!/usr/bin/env bash
#
# tmux-historial — “which tab did I see that error in yesterday?”: search over what went through all your panes.
# OFF by default (it stores screen text). Menu → Views → y (on/off) · h (search).
#   tmux-historial on|off       turns it on/off (option @historial)
#   tmux-historial [text]       searches with fzf (context preview); Enter goes to the tab if it is still open
#   tmux-historial --muestrear  (run by tmux-fondo every minute) stores the NEW lines of each pane
#   tmux-historial --estado     size and days stored
# How it stores: every minute it takes each pane's already-drawn screen (capture-pane: clean text, no terminal
# codes), keeps only what is new, redacts it (ws-redactar) and appends it to
# ~/.local/share/tmux-historial/YYYY-MM-DD/<group>_<tab>.log (0700). Deleted after 30 days (WS_HISTORIAL_DIAS).
# Panes with Claude are stored too: the full conversation is already in its transcripts.
set -uo pipefail
D="${WS_HISTORIAL_DIR:-$HOME/.local/share/tmux-historial}"; DIAS="${WS_HISTORIAL_DIAS:-30}"
ST="${XDG_RUNTIME_DIR:-/tmp}/tmux-historial-$(id -u)"
mkdir -p "$D" "$ST" && chmod 700 "$D" "$ST"
TAB=$'\t'

case "${1:-}" in
  on)  tmux set -g @historial on; echo "Searchable history: on (stored every minute; $DIAS days)"; exit 0 ;;
  off) tmux set -g @historial off; echo "Searchable history: off (what is already stored stays in $D)"; exit 0 ;;
  --estado)
    echo "History: $(tmux show -gqv @historial || true) · $(du -sh "$D" 2>/dev/null | cut -f1) in $(find "$D" -mindepth 1 -maxdepth 1 -type d | wc -l) days · $D"; exit 0 ;;
  --muestrear)
    hoy="$D/$(date +%F)"; mkdir -p "$hoy"
    ST="$ST/$(tmux display -p '#{pid}')"; mkdir -p "$ST"   # %N ids are reused across tmux servers
    while IFS="$TAB" read -r pid s wi wn; do
      seg="$ST/${pid#%}"
      nuevo="$(tmux capture-pane -p -J -t "$pid" -S -300 2>/dev/null | sed -e 's/[[:space:]]*$//' | grep -v '^$')" || continue
      [[ -n "$nuevo" ]] || continue
      if [[ -f "$seg" ]]; then
        # Only what was not in the previous sample: the lines after the last match of the tail.
        cola="$(tail -n 3 "$seg")"
        resto="$(awk -v c="$cola" 'BEGIN{n=split(c,C,"\n")} {L[NR]=$0} END{s=0; for(i=NR;i>=n;i--){ok=1; for(j=1;j<=n;j++) if(L[i-n+j]!=C[j]){ok=0;break}; if(ok){s=i;break}} for(i=s+1;i<=NR;i++) print L[i]}' <<<"$nuevo")"
      else resto="$nuevo"; fi
      printf '%s\n' "$nuevo" | tail -n 3 > "$seg"
      [[ -n "$resto" ]] || continue
      nom="$(printf '%s_%s-%s' "$s" "$wi" "$wn" | tr -c 'A-Za-z0-9_.-' '_' | cut -c1-60)"
      { printf '### %s %s\n' "$(date +%H:%M)" "$pid"; ws-redactar <<<"$resto"; } >> "$hoy/$nom.log"
    done < <(tmux list-panes -a -F "#{pane_id}${TAB}#{session_name}${TAB}#{window_index}${TAB}#{window_name}")
    find "$D" -mindepth 1 -maxdepth 1 -type d -mtime "+$DIAS" -exec rm -rf {} + 2>/dev/null
    exit 0 ;;
esac

command -v rg >/dev/null && BUSCA=(rg --no-heading --line-number --color=never -i) || BUSCA=(grep -rni --color=never)
q="${*:-}"
sel="$(cd "$D" && "${BUSCA[@]}" -- "${q:-.}" . 2>/dev/null | sed 's#^\./##' | sort -r -t/ -k1,1 \
       | fzf --delimiter=: --with-nth=1,3.. --reverse --query "$q" --prompt 'history> ' \
             --header 'Type to filter · Enter: go to the tab (if still open) and copy the line' \
             --preview "sed -n \"\$(( {2} > 6 ? {2} - 6 : 1 )),\$(( {2} + 6 ))p\" '$D'/{1}" --preview-window 'down,40%')" || exit 0
archivo="${sel%%:*}"; linea="${sel#*:*:}"
printf '%s' "$linea" | ws-copiar 2>/dev/null || printf '%s' "$linea" | tmux load-buffer -w -
pane="$(awk -v n="$(cut -d: -f2 <<<"$sel")" 'NR<=n && /^### / {p=$3} END{print p}' "$D/$archivo")"
if [[ -n "$pane" ]] && tmux display -p -t "$pane" '#{pane_id}' >/dev/null 2>&1; then
  tmux switch-client -t "$(tmux display -p -t "$pane" '#{session_name}')" 2>/dev/null
  tmux select-window -t "$pane"; tmux select-pane -t "$pane"
else echo "The tab no longer exists; the line was copied."; sleep 1.5; fi
