#!/usr/bin/env bash
#
# tmux-solo — "solo mode": Claude in auto mode WITHOUT your sandbox, to let it work on its own.
#   · commands run without the sandbox and without asking you one by one: the auto mode
#     classifier reviews each action (profile ~/.config/claude-solo/settings.json, that session only)
#   · the ask rules (terraform, kubectl, AWS, DB, git push…) STILL ASK YOU; deny,
#     guard.sh and the dangerous rm commands stay blocked
# Your other tabs keep the sandbox. After restarting the workstation, everything goes back to normal.
#
# Usage:
#   tmux-solo this [PANE]        switches the current tab to solo mode (resumes the conversation)
#   tmux-solo normal [PANE]      returns it to normal mode (resumes the conversation)
#   tmux-solo new [FOLDER]      new tab in solo mode
#   tmux-solo worktree [FOLDER]  new tab in a worktree <repo>.wt/solo-<date> (branch solo/<date>)
set -euo pipefail
profile="$HOME/.config/claude-solo/settings.json"
CMD_SOLO="claude --permission-mode auto --settings '$profile'"
# In an existing tab: claude-resume continues the folder's conversation and starts a new one when there is none
# («claude -c» ends with «No conversation found to continue» in a tab where Claude never received a message).
msg() { tmux display "$1"; }
[[ -f "$profile" ]] || { msg "$profile is missing"; exit 1; }

# claude_running <pane> — is there a Claude running in the pane? Two signals, one is enough:
#   1) the foreground command is not a shell (Claude's native binary is named after its
#      version, e.g. "2.1.325", not "claude");
#   2) among the pane's descendants there is a claude process (or node running Claude).
claude_running() {
  local root cur
  cur="$(tmux display -p -t "$1" '#{pane_current_command}')"
  [[ "$cur" =~ ^(bash|zsh|sh|fish|dash)$ ]] || return 0
  root="$(tmux display -p -t "$1" '#{pane_pid}')"
  ps -e -o pid=,ppid=,comm=,args= | awk -v r="$root" '
    { parent[$1] = $2
      if ($3 ~ /^claude$/ || $4 ~ /(^|\/)claude$/ || $4 ~ /\/claude\/versions\// || ($3 == "node" && $0 ~ /claude/)) c[$1] = 1 }
    END { for (p in c) for (q = parent[p]; q > 1; q = parent[q]) if (q == r) { found = 1; break }
          exit !found }'
}

# restart_claude <pane> <command> — closes the Claude in the pane (if any) and launches the command.
restart_claude() {
  local pane="$1" cmd="$2" i=0
  if claude_running "$pane"; then
    # Ctrl+C first: it clears whatever is typed in the input box; otherwise «<text>/exit» is sent as a message and
    # Claude never closes. If /exit still does not close it in 10 s, Ctrl+C twice (Claude's own way out).
    tmux send-keys -t "$pane" Escape; sleep 0.5
    tmux send-keys -t "$pane" C-c; sleep 0.4
    claude_running "$pane" && { tmux send-keys -t "$pane" -l "/exit"; tmux send-keys -t "$pane" Enter; }
    for (( i = 0; i < 40; i++ )); do
      claude_running "$pane" || break
      (( i == 20 )) && { tmux send-keys -t "$pane" C-c; sleep 0.3; tmux send-keys -t "$pane" C-c; }
      sleep 0.5
    done
    (( i < 40 )) || { msg "Claude did not close; close it yourself (/exit) and try again"; exit 1; }
  fi
  tmux send-keys -t "$pane" -l "$cmd"; tmux send-keys -t "$pane" Enter
}

action="${1:-this}"; shift || true
case "$action" in
  this|normal)
    pane="${1:-$(tmux display -p '#{pane_id}')}"
    win="$(tmux display -p -t "$pane" '#{window_id}')"
    name="$(tmux display -p -t "$pane" '#W')"; name="${name#🤖}"
    if [[ "$action" == this ]]; then
      restart_claude "$pane" "${CMD_SOLO/claude /claude-resume }"
      tmux set -w -t "$win" @csolo 1; tmux rename-window -t "$win" "🤖$name"
      msg "Solo mode on $name: auto, no sandbox · it asks you about anything critical"
    else
      restart_claude "$pane" "claude-resume"
      tmux set -wu -t "$win" @csolo; tmux rename-window -t "$win" "$name"
      msg "$name back in normal mode (with sandbox)"
    fi
    ;;
  new|worktree)
    dir="${1:-$(tmux display -p '#{pane_current_path}')}"
    name="$(basename "$dir")"
    if [[ "$action" == worktree ]]; then
      root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || { msg "$dir is not a git repo"; exit 1; }
      stamp="$(date +%Y%m%d-%H%M)"
      dir="$root.wt/solo-$stamp"
      git -C "$root" worktree add -q -b "solo/$stamp" "$dir" >/dev/null 2>&1 || { msg "Could not create the worktree $dir"; exit 1; }
      name="$(basename "$root")@solo"
    fi
    win="$(tmux new-window -P -F '#{window_id}' -c "$dir" -n "🤖$name" "$CMD_SOLO; exec bash -l")"
    tmux set -w -t "$win" @csolo 1; tmux set -w -t "$win" automatic-rename off
    msg "Solo Claude on $name: type the task and let it work"
    ;;
  *) echo "usage: tmux-solo this|normal|new|worktree [PANE|FOLDER]" >&2; exit 2 ;;
esac
