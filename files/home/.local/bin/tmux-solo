#!/usr/bin/env bash
#
# tmux-solo — "solo mode": Claude in auto mode WITHOUT your sandbox, to let it work on its own.
#   · commands run without the sandbox and without asking you one by one: the auto mode
#     classifier reviews each action (profile ~/.config/claude-solo/settings.json, that session only)
#   · the ask rules (terraform, kubectl, AWS, DB, git push…) STILL ASK YOU; deny,
#     guard.sh and the dangerous rm commands stay blocked
# Your other tabs keep the sandbox. After restarting the workstation, everything goes back to normal.
#
# Usage:
#   tmux-solo esta [PANE]        switches the current tab to solo mode (resumes the conversation)
#   tmux-solo normal [PANE]      returns it to normal mode (resumes the conversation)
#   tmux-solo nueva [FOLDER]     new tab in solo mode
#   tmux-solo worktree [FOLDER]  new tab in a worktree <repo>.wt/solo-<date> (branch solo/<date>)
set -euo pipefail
perfil="$HOME/.config/claude-solo/settings.json"
CMD_SOLO="claude --permission-mode auto --settings '$perfil'"
msg() { tmux display "$1"; }
[[ -f "$perfil" ]] || { msg "$perfil is missing"; exit 1; }

# claude_corre <pane> — is there a Claude running in the pane? Two signals, one is enough:
#   1) the foreground command is not a shell (Claude's native binary is named after its
#      version, e.g. "2.1.325", not "claude");
#   2) among the pane's descendants there is a claude process (or node running Claude).
claude_corre() {
  local raiz cur
  cur="$(tmux display -p -t "$1" '#{pane_current_command}')"
  [[ "$cur" =~ ^(bash|zsh|sh|fish|dash)$ ]] || return 0
  raiz="$(tmux display -p -t "$1" '#{pane_pid}')"
  ps -e -o pid=,ppid=,comm=,args= | awk -v r="$raiz" '
    { padre[$1] = $2
      if ($3 ~ /^claude$/ || $4 ~ /(^|\/)claude$/ || $4 ~ /\/claude\/versions\// || ($3 == "node" && $0 ~ /claude/)) c[$1] = 1 }
    END { for (p in c) for (q = padre[p]; q > 1; q = padre[q]) if (q == r) { hay = 1; break }
          exit !hay }'
}

# reiniciar_claude <pane> <command> — closes the Claude in the pane (if any) and launches the command.
reiniciar_claude() {
  local pane="$1" cmd="$2" i=0
  if claude_corre "$pane"; then
    # Ctrl+C first: it clears whatever is typed in the input box; otherwise «<text>/exit» is sent as a message and
    # Claude never closes. If /exit still does not close it in 10 s, Ctrl+C twice (Claude's own way out).
    tmux send-keys -t "$pane" Escape; sleep 0.5
    tmux send-keys -t "$pane" C-c; sleep 0.4
    claude_corre "$pane" && { tmux send-keys -t "$pane" -l "/exit"; tmux send-keys -t "$pane" Enter; }
    for (( i = 0; i < 40; i++ )); do
      claude_corre "$pane" || break
      (( i == 20 )) && { tmux send-keys -t "$pane" C-c; sleep 0.3; tmux send-keys -t "$pane" C-c; }
      sleep 0.5
    done
    (( i < 40 )) || { msg "Claude did not close; close it yourself (/exit) and try again"; exit 1; }
  fi
  tmux send-keys -t "$pane" -l "$cmd"; tmux send-keys -t "$pane" Enter
}

accion="${1:-esta}"; shift || true
case "$accion" in
  esta|normal)
    pane="${1:-$(tmux display -p '#{pane_id}')}"
    win="$(tmux display -p -t "$pane" '#{window_id}')"
    nombre="$(tmux display -p -t "$pane" '#W')"; nombre="${nombre#🤖}"
    if [[ "$accion" == esta ]]; then
      # -c resumes the most recent conversation in this folder.
      reiniciar_claude "$pane" "${CMD_SOLO/claude /claude -c }"
      tmux set -w -t "$win" @csolo 1; tmux rename-window -t "$win" "🤖$nombre"
      msg "Solo mode on $nombre: auto, no sandbox · it asks you about anything critical"
    else
      reiniciar_claude "$pane" "claude -c"
      tmux set -wu -t "$win" @csolo; tmux rename-window -t "$win" "$nombre"
      msg "$nombre back in normal mode (with sandbox)"
    fi
    ;;
  nueva|worktree)
    dir="${1:-$(tmux display -p '#{pane_current_path}')}"
    nombre="$(basename "$dir")"
    if [[ "$accion" == worktree ]]; then
      raiz="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || { msg "$dir is not a git repo"; exit 1; }
      stamp="$(date +%Y%m%d-%H%M)"
      dir="$raiz.wt/solo-$stamp"
      git -C "$raiz" worktree add -q -b "solo/$stamp" "$dir" >/dev/null 2>&1 || { msg "Could not create the worktree $dir"; exit 1; }
      nombre="$(basename "$raiz")@solo"
    fi
    win="$(tmux new-window -P -F '#{window_id}' -c "$dir" -n "🤖$nombre" "$CMD_SOLO; exec bash -l")"
    tmux set -w -t "$win" @csolo 1; tmux set -w -t "$win" automatic-rename off
    msg "Solo Claude on $nombre: type the task and let it work"
    ;;
  *) echo "usage: tmux-solo esta|normal|nueva|worktree [PANE|FOLDER]" >&2; exit 2 ;;
esac
