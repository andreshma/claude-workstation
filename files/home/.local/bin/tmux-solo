#!/usr/bin/env bash
#
# tmux-solo — "solo mode": Claude in auto mode INSIDE your sandbox, to let it work on its own (WS-AI-004).
#   · commands run without asking you one by one, but inside bubblewrap and the network allowlist
#     (profile ~/.config/claude-solo/settings.json: autoAllowBashIfSandboxed; that session only, generated with the
#     normal level's exclusions by «tmux-level --settings-file solo»); the auto mode classifier reviews everything
#     else, including the commands excluded from the sandbox (az, gh, git push…)
#   · the ask rules (terraform, kubectl, AWS, DB, git push, memory writes…) STILL ASK YOU; deny, guard.sh and the
#     dangerous rm commands stay blocked
#   · it expires: after @csolo_hours (4 h by default) tmux-watch returns the tab to normal mode
# Your other tabs keep their level. After restarting the workstation, everything goes back to normal. The tab keeps
# its profile (ws-profile, ADR-021): the restart types «eval "$(ws-profile --export NAME)" &&» before Claude.
#
# Usage:
#   tmux-solo this [PANE] [--hours N] [--unsandboxed]   switches the tab to solo mode (resumes the conversation)
#   tmux-solo normal [PANE]                              returns it to normal mode (resumes the conversation)
#   tmux-solo new [FOLDER] [--here] [--hours N]          new tab in solo mode; in a git repo it gets its own worktree
#                                                         <repo>.wt/solo-<date> (branch solo/<date>) unless --here
#   tmux-solo worktree [FOLDER] [--hours N]              the same, always in a new worktree
# --unsandboxed is the old solo mode (auto with the sandbox OFF): an audited exception for work the sandbox cannot do;
# prefer the normal level for that. WS_SOLO_HOURS or the tmux option @csolo_hours set the default expiry (1 to 24).
set -euo pipefail
PATH="$HOME/.local/bin:$PATH"   # tmux menus may start it with a minimal PATH (tmux-level, claude-resume)
profile="$HOME/.config/claude-solo/settings.json"
action="${1:-this}"; shift || true
target="" here=0 nosb=0 hours=""
while (( $# )); do
  case "$1" in
    --here) here=1 ;;
    --unsandboxed) nosb=1 ;;
    --hours) hours="${2:-}"; shift ;;
    *) target="$1" ;;
  esac
  shift
done
[[ -n "$hours" ]] || hours="${WS_SOLO_HOURS:-$(tmux show -gqv @csolo_hours 2>/dev/null)}"
hours="${hours:-4}"
[[ "$hours" =~ ^[0-9]+$ ]] && (( hours >= 1 && hours <= 24 )) || { tmux display "tmux-solo: --hours must be 1 to 24"; exit 2; }
msg() { tmux display "$1"; }
[[ -f "$profile" ]] || { msg "$profile is missing"; exit 1; }
if (( nosb )); then   # generated each time, never shipped: the exception is visible in the audit log and the tab name
  profile="${WS_LEVELS_DIR:-$HOME/.config/claude-levels}/solo-unsandboxed.json"
  mkdir -p "${profile%/*}" && chmod 700 "${profile%/*}"
  printf '{"sandbox":{"enabled":false}}\n' > "$profile"; chmod 600 "$profile"
else   # the solo settings plus normal's exclusions (the user settings are strict, ADR-013)
  profile="$(tmux-level --settings-file solo)" || { msg "tmux-level could not build the solo profile"; exit 1; }
fi
CMD_SOLO="claude --permission-mode auto --settings '$profile'"
CMD_NORMAL="$(tmux-level --command normal 2>/dev/null)" || CMD_NORMAL="claude-resume"
audit() { printf '{"cwd":"%s"}' "$PWD" | "$HOME/.claude/hooks/audit.sh" "$1" "$2" >/dev/null 2>&1 || true; }
# mark <window> — solo marks: @csolo, its expiry (read by tmux-watch) and the unsandboxed flag.
mark() {
  tmux set -w -t "$1" @csolo 1 \; set -w -t "$1" @csolo_until "$(( $(date +%s) + hours * 3600 ))"
  if (( nosb )); then tmux set -w -t "$1" @csolo_nosb 1; else tmux set -wu -t "$1" @csolo_nosb 2>/dev/null || true; fi
  audit "$( (( nosb )) && echo solo-unsandboxed || echo solo-on)" "$hours h"
}
# In an existing tab: claude-resume continues the folder's conversation and starts a new one when there is none
# («claude -c» ends with «No conversation found to continue» in a tab where Claude never received a message).
# claude_running <pane> — is there a Claude running in the pane? Two signals, one is enough:
#   1) the foreground command is not a shell (Claude's native binary is named after its
#      version, e.g. "2.1.325", not "claude");
#   2) among the pane's descendants there is a claude process (or node running Claude).
claude_running() {
  local root cur
  cur="$(tmux display -p -t "$1" '#{pane_current_command}')"
  [[ "$cur" =~ ^(bash|zsh|sh|fish|dash)$ ]] || return 0
  root="$(tmux display -p -t "$1" '#{pane_pid}')"
  ps -e -o pid=,ppid=,comm=,args= | awk -v r="$root" '
    { parent[$1] = $2
      if ($3 ~ /^claude$/ || $4 ~ /(^|\/)claude$/ || $4 ~ /\/claude\/versions\// || ($3 == "node" && $0 ~ /claude/)) c[$1] = 1 }
    END { for (p in c) for (q = parent[p]; q > 1; q = parent[q]) if (q == r) { found = 1; break }
          exit !found }'
}

# restart_claude <pane> <command> — closes the Claude in the pane (if any) and launches the command.
restart_claude() {
  local pane="$1" cmd="$2" i=0
  if claude_running "$pane"; then
    # Ctrl+C first: it clears whatever is typed in the input box; otherwise «<text>/exit» is sent as a message and
    # Claude never closes. If /exit still does not close it in 10 s, Ctrl+C twice (Claude's own way out).
    tmux send-keys -t "$pane" Escape; sleep 0.5
    tmux send-keys -t "$pane" C-c; sleep 0.4
    claude_running "$pane" && { tmux send-keys -t "$pane" -l "/exit"; tmux send-keys -t "$pane" Enter; }
    for (( i = 0; i < 40; i++ )); do
      claude_running "$pane" || break
      (( i == 20 )) && { tmux send-keys -t "$pane" C-c; sleep 0.3; tmux send-keys -t "$pane" C-c; }
      sleep 0.5
    done
    (( i < 40 )) || { msg "Claude did not close; close it yourself (/exit) and try again"; exit 1; }
  fi
  tmux send-keys -t "$pane" -l "$cmd"; tmux send-keys -t "$pane" Enter
}

case "$action" in
  this|normal)
    pane="${target:-$(tmux display -p '#{pane_id}')}"
    win="$(tmux display -p -t "$pane" '#{window_id}')"
    name="$(tmux display -p -t "$pane" '#W')"; name="${name#🤖}"; name="${name#🔓}"
    if [[ "$action" == this ]]; then
      restart_claude "$pane" "$(tmux-level --prefix "$pane" 2>/dev/null)${CMD_SOLO/claude /claude-resume }"
      mark "$win"; tmux rename-window -t "$win" "$( (( nosb )) && echo 🔓)🤖$name"
      if (( nosb )); then msg "Solo mode WITHOUT sandbox on $name for $hours h (audited exception) · it asks you about anything critical"
      else msg "Solo mode on $name for $hours h: auto inside the sandbox · it asks you about anything critical"; fi
    else
      restart_claude "$pane" "$(tmux-level --prefix "$pane" 2>/dev/null)$CMD_NORMAL"
      for o in @csolo @csolo_until @csolo_nosb; do tmux set -wu -t "$win" "$o" 2>/dev/null || true; done
      tmux rename-window -t "$win" "$name"; audit solo-off "$name"
      msg "$name back in normal mode"
    fi
    ;;
  new|worktree)
    dir="${target:-$(tmux display -p '#{pane_current_path}')}"
    name="$(basename "$dir")"
    root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || root=""
    if [[ "$action" == worktree && -z "$root" ]]; then msg "$dir is not a git repo"; exit 1; fi
    # In a repo, solo work goes to its own worktree and branch by default: you review it like a pull request.
    if [[ -n "$root" ]] && (( ! here )); then
      stamp="$(date +%Y%m%d-%H%M)"
      dir="$root.wt/solo-$stamp"
      git -C "$root" worktree add -q -b "solo/$stamp" "$dir" >/dev/null 2>&1 || { msg "Could not create the worktree $dir"; exit 1; }
      name="$(basename "$root")@solo"
    fi
    win="$(tmux new-window -P -F '#{window_id}' -c "$dir" -n "$( (( nosb )) && echo 🔓)🤖$name" "$CMD_SOLO; exec bash -l")"
    mark "$win"; tmux set -w -t "$win" automatic-rename off
    msg "Solo Claude on $name for $hours h: type the task and let it work"
    ;;
  *) echo "usage: tmux-solo this|normal|new|worktree [PANE|FOLDER] [--here] [--hours N] [--unsandboxed]" >&2; exit 2 ;;
esac
