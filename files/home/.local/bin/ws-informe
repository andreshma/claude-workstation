#!/usr/bin/env python3
"""ws-informe — full report on how you work with Claude, and what to do about it. Menu → Usage → i.

Measures (all local, no conversation text except normalized and redacted recurring phrases):
  · usage: equivalent cost, turns, active hours, sessions, cache, by project and model
  · pattern: at what hours and on what days you work, turn duration, turns per session, your wait to approve
  · models and routing: mix by cost, routing decisions (accepted, rejected, silenced)
  · agents: which subagents you use, how much, in which projects, with which model, how long they take
  · tools: uses, times, errors, MCP, skills (from the traces)
  · prompts: most used slash commands and phrases your repeated requests start with (command or skill candidates)
  · MemPalace: diary saves (ok/failed), mined, Hub restarts and errors, palace size
  · recall: decisions, threshold, latency and what it would inject (tools/shadow_report.py in the recall repo)
With --ia, Claude (Sonnet, no tools) reads the aggregated METRICS and writes concrete findings and suggestions;
with --ia-memoria it also queries MemPalace through its MCP (status, wings, graph) and summarizes it.
Output: %UserProfile%\\ws-telemetria\\informe-YYYY-MM-DD.html and .md (and ~/.local/share/ws-telemetria/informes/).
Usage: ws-informe [--dias 30] [--ia] [--ia-memoria] [--json] [--abrir]
Paths (optional) in ~/.config/ws-informe.conf: recall_repo=… · recall_log=… · mempalace_dir=…
"""
from __future__ import annotations

import datetime as dt
import glob
import hashlib
import html
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import statistics
import subprocess  # nosec B404 — claude, python from the recall repo, wslpath, explorer with fixed arguments
import sys
from collections import Counter, defaultdict
from pathlib import Path

HOME = Path.home()
BIN = HOME / ".local/bin"
CLAUDE = Path(os.environ.get("WS_TELEMETRIA_CLAUDE", HOME / ".claude"))
DATOS = Path(os.environ.get("WS_TELEMETRIA_DIR", HOME / ".local/share/ws-telemetria"))
CACHE = DATOS / "cache-informe"
TICKET = re.compile(r"[A-Z][A-Z0-9]+-\d+")
# Spanish on purpose: the prompts being normalized are typed in Spanish (stop words here, accented letters in normalizar).
STOP = set("a al con de del el en es la las lo los me mi no o para por que se si su te tu un una y ya the to of and in it is this".split())


def conf() -> dict:
    c = {"recall_repo": "@WINHOME@/source/repos/recall",
         "recall_log": "@WINHOME@/AppData/Local/recall/shadow.log",
         "mempalace_dir": "@WINHOME@/.mempalace"}
    f = HOME / ".config/ws-informe.conf"
    if f.exists():
        for l in f.read_text(encoding="utf-8").splitlines():
            if "=" in l and not l.strip().startswith("#"):
                k, v = l.split("=", 1); c[k.strip()] = v.strip()
    return c


def telemetria():
    """ws-telemetria as a module (prices, turns, traces, estimation): a single source of truth."""
    cargador = importlib.machinery.SourceFileLoader("wst", str(BIN / "ws-telemetria"))
    spec = importlib.util.spec_from_loader("wst", cargador)
    m = importlib.util.module_from_spec(spec); cargador.exec_module(m)
    return m


def redactar(t: str) -> str:
    try:
        return subprocess.run([str(BIN / "ws-redactar")], input=t, capture_output=True, text=True, timeout=10).stdout  # nosec B603
    except (OSError, subprocess.SubprocessError):
        return t


def local(ts: str | None):
    try:
        return dt.datetime.fromisoformat((ts or "").replace("Z", "+00:00")).astimezone()
    except ValueError:
        return None


# ---- transcripts: normalized prompts and subagents (cached per file) -----------------------------------
def normalizar(t: str) -> str:
    t = re.sub(r"```.*?```", " ", t, flags=re.S)
    t = re.sub(r"https?://\S+|[\w.-]*[/\\][\w./\\-]+|\b\d[\d.,:]*\b|[`\"'«»()\[\]{}<>]", " ", t.lower())
    palabras = [p for p in re.findall(r"[a-záéíóúñü]+", t) if p not in STOP]
    return " ".join(palabras[:6])


def extraer(f: Path) -> dict:
    sub = "/subagents/" in str(f)
    prompts, agentes, comandos = [], [], []
    with open(f, encoding="utf-8", errors="replace") as fh:
        for linea in fh:
            try:
                o = json.loads(linea)
            except ValueError:
                continue
            ts = o.get("timestamp"); proy = re.split(r"[\\/]", (o.get("cwd") or "").rstrip("\\/"))[-1] or "?"
            m = o.get("message") or {}
            c = m.get("content")
            if o.get("type") == "user" and not sub and not o.get("isMeta"):
                texto = c if isinstance(c, str) else " ".join(b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text")
                if not texto or texto.startswith("<local-command") or "tool_result" in json.dumps(c)[:200]:
                    continue
                cm = re.search(r"<command-name>(/[\w:-]+)</command-name>", texto) or re.match(r"\s*(/[\w:-]+)", texto)
                if cm:
                    comandos.append([ts, cm.group(1)]); continue
                if texto.lstrip().startswith("<"):
                    continue
                n = normalizar(texto)
                if len(n.split()) >= 3:
                    prompts.append([ts, proy, n])
            elif o.get("type") == "assistant":
                for b in c or []:
                    if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") in ("Task", "Agent"):
                        i = b.get("input") or {}
                        agentes.append([ts, proy, i.get("subagent_type") or "general-purpose", i.get("model") or "", m.get("model") or ""])
    return {"prompts": prompts, "agentes": agentes, "comandos": comandos}


def transcripciones() -> dict:
    CACHE.mkdir(parents=True, exist_ok=True)
    total = {"prompts": [], "agentes": [], "comandos": []}
    for f in glob.glob(str(CLAUDE / "projects/**/*.jsonl"), recursive=True):
        p = Path(f)
        try:
            st = p.stat()
        except OSError:
            continue
        clave = hashlib.sha1(f.encode(), usedforsecurity=False).hexdigest()
        c = CACHE / f"{clave}.json"; firma = f"i1:{st.st_mtime_ns}:{st.st_size}"
        d = None
        if c.exists():
            try:
                d = json.loads(c.read_text())
                d = d["datos"] if d.get("firma") == firma else None
            except (ValueError, KeyError):
                d = None
        if d is None:
            d = extraer(p); c.write_text(json.dumps({"firma": firma, "datos": d}))
        for k in total:
            total[k] += d[k]
    return total


# ---- MemPalace and recall --------------------------------------------------------------------------
def mempalace(c: dict, desde: dt.date) -> dict | None:
    d = Path(c["mempalace_dir"])
    if not d.exists():
        return None
    r = {"diario": Counter(), "por_dia": defaultdict(Counter), "hub": Counter(), "palacio_mb": None}
    hook = d / "hook_state/hook.log"
    if hook.exists():
        # The log only carries the time ([HH:MM:SS]). The day is rebuilt by counting day changes (the time goes back)
        # backwards from the file's modification date. It is approximate: a day with no activity goes unnoticed.
        lineas = open(hook, encoding="utf-8", errors="replace").read().splitlines()
        saltos, previo, marca = 0, None, []
        for l in lineas:
            m = re.match(r"\[(\d{2}):(\d{2}):(\d{2})\]", l)
            if m:
                seg = int(m.group(1)) * 3600 + int(m.group(2)) * 60 + int(m.group(3))
                if previo is not None and seg < previo - 60:
                    saltos += 1
                previo = seg
            marca.append(saltos)
        ultimo = dt.date.fromtimestamp(hook.stat().st_mtime)
        r["fechas_aprox"] = True
        for l, s in zip(lineas, marca):
            fecha = re.search(r"\d{4}-\d{2}-\d{2}", l)
            dia = fecha.group(0) if fecha else (ultimo - dt.timedelta(days=saltos - s)).isoformat()
            if dia < desde.isoformat():
                continue
            for patron, k in ((r"Diary checkpoint (saved|sent|forwarded)", "guardado"), (r"Diary checkpoint failed|did not report back", "fallido"),
                              (r"Save marker advanced without diary", "sin_diario"), (r"\bmin(e|ing)\b", "minado")):
                if re.search(patron, l, re.I):
                    r["diario"][k] += 1; r["por_dia"][dia][k] += 1
    for hl in d.glob("server/*/hub.log"):
        for l in open(hl, encoding="utf-8", errors="replace"):
            if "listening on" in l:
                r["hub"]["arranques"] += 1
            if re.search(r"CUBLAS failure|ONNXRuntimeError|Filtered search failed", l):
                r["hub"]["errores_embedding"] += 1
    sq = d / "palace/chroma.sqlite3"
    if sq.exists():
        r["palacio_mb"] = round(sq.stat().st_size / 1048576)
    r["por_dia"] = {k: dict(v) for k, v in sorted(r["por_dia"].items())[-14:]}
    r["diario"] = dict(r["diario"]); r["hub"] = dict(r["hub"])
    return r


def recall(c: dict, desde: dt.date) -> dict | None:
    rep = Path(c["recall_repo"]) / "tools/shadow_report.py"
    if not rep.exists() or not Path(c["recall_log"]).exists():
        return None
    try:
        out = subprocess.run([sys.executable, "-I", str(rep), "--log", c["recall_log"], "--since", desde.isoformat()],  # nosec B603
                             capture_output=True, text=True, timeout=120).stdout
        return json.loads(out)
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


RUIDO = ("session being continued", "request interrupted", "caveat messages below")

# ---- machine resources, tokens, learning and ideas ------------------------------------------------------
def recursos(wst, desde: dt.date) -> dict | None:
    """CPU, RAM, disk operations and MB read/written by the Claude processes, per day and per project.
    Comes from the per-minute samples of ws-telemetria (raw/recursos-YYYY-MM-DD.jsonl); the counters are cumulative
    per process, so the difference between the first and the last sample of each process in the day is added up."""
    raw = getattr(wst, "RAW", None)
    if not raw or not Path(raw).is_dir():
        return None
    dias, proy, muestras = [], defaultdict(lambda: {"cpu_s": 0.0, "seg": 0.0, "ram": 0, "ops": 0, "leidos": 0, "escritos": 0}), 0
    for f in sorted(Path(raw).glob("recursos-*.jsonl")):
        dia = f.stem.replace("recursos-", "")
        if dia < desde.isoformat():
            continue
        por_pid = defaultdict(list)
        with open(f, encoding="utf-8", errors="replace") as fh:
            for linea in fh:
                try:
                    r = json.loads(linea)
                    por_pid[r["pid"]].append(r)
                except (ValueError, KeyError, TypeError):
                    continue
        t = {"cpu_s": 0.0, "ops": 0, "leidos": 0, "escritos": 0}
        ram_min = defaultdict(int); ts = []
        for rs in por_pid.values():
            rs.sort(key=lambda r: r["ts"]); muestras += len(rs)
            a = proy[rs[-1].get("proyecto") or "?"]
            a["ram"] = max(a["ram"], max(r.get("rss_kb", 0) for r in rs))
            for r in rs:
                ram_min[int(r["ts"] // 60)] += r.get("rss_kb", 0); ts.append(r["ts"])
            if len(rs) > 1:
                cpu = max(0.0, rs[-1]["cpu_s"] - rs[0]["cpu_s"]); t["cpu_s"] += cpu; a["cpu_s"] += cpu; a["seg"] += rs[-1]["ts"] - rs[0]["ts"]
                for k in ("ops", "leidos", "escritos"):
                    v = max(0, rs[-1].get(k, 0) - rs[0].get(k, 0)); t[k] += v; a[k] += v
        seg = (max(ts) - min(ts)) if len(ts) > 1 else 0
        dias.append({"dia": dia, "procesos": len(por_pid), "cpu_min": round(t["cpu_s"] / 60, 1),
                     "cpu_pct": round(100 * t["cpu_s"] / seg, 1) if seg else 0,
                     "ram_pico_mb": round(max(ram_min.values(), default=0) / 1024),
                     "iops": round(t["ops"] / seg, 1) if seg else 0,
                     "leidos_mb": round(t["leidos"] / 1e6, 1), "escritos_mb": round(t["escritos"] / 1e6, 1)})
    if not dias:
        return None
    return {"dias": dias, "muestras": muestras,
            "proyectos": sorted(({"proyecto": k, "cpu_min": round(v["cpu_s"] / 60, 1), "cpu_pct": round(100 * v["cpu_s"] / v["seg"], 1) if v["seg"] else 0,
                                  "ram_mb": round(v["ram"] / 1024), "iops": round(v["ops"] / v["seg"], 1) if v["seg"] else 0,
                                  "leidos_mb": round(v["leidos"] / 1e6, 1), "escritos_mb": round(v["escritos"] / 1e6, 1)}
                                 for k, v in proy.items()), key=lambda x: -x["cpu_min"])[:10]}


def tokens(turnos: list[dict]) -> dict:
    """Tokens by type and your words and Claude's in the period (counts only, never the text)."""
    t = Counter(); pp, rp = [], []
    for x in turnos:
        for m in x["modelos"].values():
            for k in ("in", "out", "cw", "cr", "think"):
                t[k] += m.get(k, 0)
        if not x.get("subagente") and not x.get("auto"):
            pp.append(x.get("prompt_palabras") or 0)
            if x.get("resp_palabras"):
                rp.append(x["resp_palabras"])
    n = len(pp) or 1; ent = t["in"] + t["cw"] + t["cr"]
    return {"entrada_nueva": t["in"], "cache_escrita": t["cw"], "cache_leida": t["cr"], "salida": t["out"], "razonamiento": t["think"],
            "total": ent + t["out"], "cache_pct": round(100 * t["cr"] / ent, 1) if ent else 0,
            "razonamiento_pct": round(100 * t["think"] / t["out"], 1) if t["out"] else 0, "por_turno": round((ent + t["out"]) / n),
            "palabras_tuyas": sum(pp), "palabras_claude": sum(rp),
            "prompt_mediano": round(statistics.median(pp)) if pp else 0, "respuesta_mediana": round(statistics.median(rp)) if rp else 0,
            "palabras_claude_por_tuya": round(sum(rp) / sum(pp), 1) if sum(pp) else 0}


def base_estimacion(turnos: list[dict], proyectos: list[dict], rec: dict | None) -> list[dict]:
    """Real data per project to estimate future work: active hours, turns, tokens, words, cost, lines,
    commits and CPU, plus the ratios that serve as a unit (per active hour and per 100 lines added)."""
    ag = defaultdict(lambda: {"tokens": 0, "salida": 0, "tuyas": 0, "claude": 0})
    for t in turnos:
        a = ag[t.get("proyecto") or "?"]
        for m in t["modelos"].values():
            a["tokens"] += m.get("in", 0) + m.get("cw", 0) + m.get("cr", 0) + m.get("out", 0); a["salida"] += m.get("out", 0)
        if not t.get("subagente") and not t.get("auto"):
            a["tuyas"] += t.get("prompt_palabras") or 0; a["claude"] += t.get("resp_palabras") or 0
    cpu = {x["proyecto"]: x for x in (rec or {}).get("proyectos", [])}
    out = []
    for p in proyectos:
        a, h, lin = ag[p["clave"]], p.get("horas_activas") or 0, p.get("lineas_mas") or 0
        out.append({"proyecto": p["clave"], "horas_activas": h, "turnos": p["turnos"], "costo": p["costo"], "tokens": a["tokens"], "tokens_salida": a["salida"],
                    "palabras_tuyas": a["tuyas"], "palabras_claude": a["claude"], "lineas_mas": lin, "commits": p.get("commits") or 0,
                    "cpu_min": (cpu.get(p["clave"]) or {}).get("cpu_min"), "ram_mb": (cpu.get(p["clave"]) or {}).get("ram_mb"),
                    "costo_por_hora": round(p["costo"] / h, 2) if h else None, "turnos_por_hora": round(p["turnos"] / h, 1) if h else None,
                    "tokens_salida_por_hora": round(a["salida"] / h) if h else None, "palabras_tuyas_por_hora": round(a["tuyas"] / h) if h else None,
                    "costo_por_100_lineas": round(100 * p["costo"] / lin, 2) if lin else None})
    return out


def aprendizaje(desde: dt.date) -> dict:
    """What Claude already keeps about you and what you have tailored: memories by type (and the new ones in the
    period), slash commands, skills, agents and rules. Only names, type and date: memory contents are not copied."""
    base = Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")
    mem, tipos = [], Counter()
    for f in base.glob("projects/*/memory/*.md"):
        if f.name == "MEMORY.md":
            continue
        try:
            cab = f.read_text(encoding="utf-8", errors="replace")[:1500]
            fecha = dt.date.fromtimestamp(f.stat().st_mtime)
        except OSError:
            continue
        tipo = (re.search(r"^\s*type:\s*(\w+)", cab, re.M) or [None, "untyped"])[1]
        nombre = (re.search(r"^name:\s*(.+)$", cab, re.M) or [None, f.stem])[1].strip()
        tipos[tipo] += 1
        mem.append({"nombre": nombre[:60], "tipo": tipo, "fecha": fecha.isoformat(), "nueva": fecha >= desde})

    def nombres(patron: str) -> list[str]:
        return sorted({(f.parent.name if f.name == "SKILL.md" else f.stem) for f in base.glob(patron)})

    reglas = base / "CLAUDE.md"
    cmds, skills, agentes = nombres("commands/**/*.md"), nombres("skills/*/SKILL.md"), nombres("agents/*.md")
    return {"memorias": len(mem), "memorias_nuevas": sum(m["nueva"] for m in mem), "por_tipo": dict(tipos.most_common()),
            "recientes": sorted(mem, key=lambda m: m["fecha"], reverse=True)[:12],
            "comandos_propios": cmds, "skills_propias": skills, "agentes_propios": agentes,
            "reglas_lineas": len(reglas.read_text(encoding="utf-8", errors="replace").splitlines()) if reglas.is_file() else 0}


def ideas(d: dict) -> list[dict]:
    """What to improve, create and watch, derived from the metrics with fixed rules (no AI): each idea carries its evidence."""
    out = []

    def idea(tipo: str, titulo: str, evidencia: str) -> None:
        out.append({"tipo": tipo, "titulo": titulo, "evidencia": evidencia})

    u, tk, te, ap = d["uso"], d.get("tokens") or {}, d.get("tendencia") or {}, d.get("aprendizaje") or {}
    a, b = te.get("actual") or {}, te.get("anterior") or {}
    for r in d["recurrentes"][:5]:
        idea("crear", f"Slash command or skill for “{r['frase']}”", f"you asked for it {r['veces']} times in {r['proyectos']} project(s); ws-aprender comandos builds it")
    if b.get("costo") and a.get("costo", 0) > 1.3 * b["costo"]:
        idea("vigilar", "This week's cost went up", f"${a['costo']:,.2f} in 7 days versus ${b['costo']:,.2f} in the previous 7 (+{100 * (a['costo'] - b['costo']) / b['costo']:.0f} %)")
    if a.get("sub_pct", 0) >= 40:
        idea("mejorar", "Subagents weigh heavily on the cost", f"{a['sub_pct']} % of the cost of the last 7 days; check which ones can run on a smaller model")
    caros = [m for m in d["modelos"] if m["pct"] >= 85]
    if caros:
        idea("mejorar", f"Almost everything runs on {caros[0]['modelo']}", f"{caros[0]['pct']} % of the cost; routing can send mechanical work to a smaller model")
    if tk and tk["cache_pct"] < 90:
        idea("mejorar", "Little input from cache", f"{tk['cache_pct']} % (over 95 % is normal); short sessions or context that changes a lot")
    if u["turno_p90_min"] >= 10:
        idea("mejorar", "One in ten turns is very long", f"p90 of {u['turno_p90_min']} min; split those tasks or send them to the background")
    for h in d["herramientas"]:
        if h.get("usos", 0) >= 20 and h.get("errores", 0) / h["usos"] >= 0.15:
            idea("mejorar", f"{h.get('nombre')} fails often", f"{h['errores']} of {h['usos']} calls with an error ({100 * h['errores'] / h['usos']:.0f} %)")
    ag = d["agentes"]
    if ag and ag[0]["tipo"] == "general-purpose" and ag[0]["usos"] >= 20:
        idea("crear", "A tailored agent for what general-purpose does today", f"{ag[0]['usos']} uses of the generic agent")
    usados = {x.get("nombre") for x in d.get("skills") or []}
    sin_uso = [x for x in ap.get("skills_propias", []) if x not in usados]
    if ap.get("skills_propias") and len(sin_uso) >= 3 and d.get("skills"):
        idea("vigilar", "Installed skills you did not use", f"{len(sin_uso)} of {len(ap['skills_propias'])} unused in the period: " + ", ".join(sin_uso[:6]))
    if ap and not ap.get("memorias_nuevas"):
        idea("mejorar", "Claude saved nothing new about you in the period", f"{ap.get('memorias', 0)} memories in total; run ws-aprender hechos")
    rt = d.get("ruteo") or {}
    resp = rt.get("aceptado", 0) + rt.get("rechazado", 0)
    if resp >= 10 and rt.get("aceptado", 0) / resp < 0.5:
        idea("mejorar", "You reject most routing suggestions", f"{rt.get('aceptado', 0)} accepted out of {resp}; adjust the rules you reject most")
    rc = d.get("recursos")
    if rc and max(x["ram_pico_mb"] for x in rc["dias"]) >= 8000:
        idea("vigilar", "High Claude memory peak", f"{max(x['ram_pico_mb'] for x in rc['dias']):,} MB adding up all processes; close idle tabs")
    if u["espera_min"] >= 30:
        idea("mejorar", "You spend time approving permissions", f"{u['espera_min']} min of waiting; add to allow the read-only things you approve most")
    return out


# ---- calculation -------------------------------------------------------------------------------------
def calcular(dias: int) -> dict:
    wst = telemetria(); tabla = wst.precios()
    hoy = dt.date.today(); desde = hoy - dt.timedelta(days=dias)
    turnos = [t for t in wst.turnos_todos() if t.get("inicio") and wst.dia_local(t["inicio"]) >= desde.isoformat()] \
        if hasattr(wst, "dia_local") else [t for t in wst.turnos_todos() if (t.get("inicio") or "")[:10] >= desde.isoformat()]
    tr = wst.trazas(desde)
    principales = [t for t in turnos if not t.get("subagente") and not t.get("auto")]
    costo = lambda t: sum(wst.costo(m, k, tabla) for k, m in t["modelos"].items())  # noqa: E731
    # Pattern: hour × day of the week (turns), turn duration, turns per session
    mapa = [[0] * 24 for _ in range(7)]
    durs, por_sesion = [], Counter()
    for t in principales:
        a, b = local(t["inicio"]), local(t.get("fin"))
        if a:
            mapa[a.weekday()][a.hour] += 1
        if a and b:
            durs.append(max(0, (b - a).total_seconds()))
        por_sesion[t["sesion"]] += 1
    proyectos = wst.estimacion(turnos, tr, "proyecto", desde)[:12]
    mezcla = Counter()
    for t in turnos:
        for k, m in t["modelos"].items():
            mezcla[k] += wst.costo(m, k, tabla)
    total = sum(costo(t) for t in turnos)
    ruteo = Counter(r.get("decision") for r in wst._eventos("ruteo", dias)) if hasattr(wst, "_eventos") else Counter()
    det = wst.detalle_herramientas(tr, turnos) if tr else None
    # Transcripts: agents, recurring prompts, commands
    tx = transcripciones()
    en = lambda ts: (local(ts) or dt.datetime.min.replace(tzinfo=dt.timezone.utc)).date() >= desde  # noqa: E731
    ag = [a for a in tx["agentes"] if en(a[0])]
    ag_tipo = Counter(a[2] for a in ag)
    ag_proy = defaultdict(Counter)
    for a in ag:
        ag_proy[a[2]][a[1]] += 1
    ag_modelo = Counter((a[2], a[3] or "inherited") for a in ag)
    ag_dur = defaultdict(list)
    for t in tr:
        if t.get("tipo") == "subagente" and t.get("fase") == "fin" and t.get("dur_ms"):
            ag_dur[t.get("agente") or "?"].append(t["dur_ms"] / 60000)
    # Drop what you did not write: the automatic summary when a session is continued and the interruption notice.
    pr = [p for p in tx["prompts"] if en(p[0]) and not p[2].startswith(RUIDO)]
    frases = Counter(p[2] for p in pr)
    recurrentes = [{"frase": redactar(f).strip(), "veces": n, "proyectos": len({p[1] for p in pr if p[2] == f})}
                   for f, n in frases.most_common(40) if n >= 3][:20]
    cmds = Counter(c[1] for c in tx["comandos"] if en(c[0]))
    c = conf()
    d = {
        "generado": dt.datetime.now().strftime("%Y-%m-%d %H:%M"), "dias": dias, "desde": desde.isoformat(),
        "uso": {"costo": round(total, 2), "turnos": len(principales), "sesiones": len(por_sesion),
                "horas_activas": wst._horas([(wst._ts(t["inicio"]), wst._ts(t.get("fin") or t["inicio"])) for t in principales]),
                "turno_med_min": round(statistics.median(durs) / 60, 1) if durs else 0,
                "turno_p90_min": round(sorted(durs)[int(len(durs) * 0.9)] / 60, 1) if durs else 0,
                "turnos_por_sesion": round(statistics.median(por_sesion.values()), 1) if por_sesion else 0,
                "espera_min": det["espera"]["total_min"] if det else 0},
        "mapa": mapa,
        "proyectos": [{k: p[k] for k in ("clave", "costo", "horas_activas", "turnos", "modelo", "lineas_mas", "commits")} for p in proyectos],
        "modelos": [{"modelo": k, "costo": round(v, 2), "pct": round(100 * v / total) if total else 0} for k, v in mezcla.most_common()],
        "ruteo": dict(ruteo),
        "agentes": [{"tipo": k, "usos": n, "proyectos": ", ".join(p for p, _ in ag_proy[k].most_common(3)),
                     "modelo": ", ".join(sorted({m for (t, m) in ag_modelo if t == k})),
                     "min_mediana": round(statistics.median(ag_dur[k]), 1) if ag_dur.get(k) else None} for k, n in ag_tipo.most_common(15)],
        "herramientas": (det or {}).get("herramientas", [])[:12], "bash": (det or {}).get("bash_categorias", []),
        "mcp": (det or {}).get("mcp", []), "skills": (det or {}).get("skills", []), "errores": (det or {}).get("errores_tipo", []),
        "comandos": [{"comando": k, "veces": n} for k, n in cmds.most_common(15)],
        "recurrentes": recurrentes,
        "mempalace": mempalace(c, desde), "recall": recall(c, desde),
    }
    d["tokens"] = tokens(turnos)
    d["recursos"] = recursos(wst, desde)
    d["estimacion_base"] = base_estimacion(turnos, proyectos, d["recursos"])
    d["tendencia"] = wst.tendencias(wst.turnos_todos()) if hasattr(wst, "tendencias") else None
    d["razones"] = wst.razones(wst.turnos_todos(), dias) if hasattr(wst, "razones") else None
    d["otel"] = wst.otel_resumen(dias) if hasattr(wst, "otel_resumen") else None
    d["aprendizaje"] = aprendizaje(desde)
    d["ideas"] = ideas(d)
    return d


# ---- Claude: findings and suggestions -------------------------------------------------------------------
def claude_texto(prompt: str, entrada: str, herramientas: str = "", modelo: str = "sonnet") -> str:
    if not shutil.which("claude"):
        return "(Claude is not in PATH)"
    # No TMUX_PANE: the tab's hooks (model routing, state) must not treat this call as a message of yours.
    args = ["env", "-u", "TMUX_PANE", "-u", "TMUX", "claude", "-p", "--model", modelo, "--no-session-persistence",
            *(["--allowedTools", herramientas] if herramientas else ["--tools", ""]),
            "--append-system-prompt", "Answer in English, directly, with short bullets. Do not make up numbers: use only the ones in the JSON.",
            prompt]
    try:
        r = subprocess.run(args, input=entrada, capture_output=True, text=True, timeout=300)  # nosec B603
        out = r.stdout.strip()
        if "operation blocked by hook" in out[:300] or out.startswith("UserPromptSubmit"):
            return "(Claude did not answer: a hook blocked the query. Run ws-informe --ia again.)"
        return out or f"(no answer: {r.stderr.strip()[:200]})"
    except (OSError, subprocess.SubprocessError) as e:
        return f"(could not query Claude: {e})"


def ia(d: dict, memoria: bool) -> dict:
    out = {}
    out["hallazgos"] = claude_texto(
        "You are the productivity analyst of an architect/tech lead who uses Claude Code daily. With the metrics JSON "
        "(stdin) write: 1) 5 findings with numbers; 2) recurring prompts worth turning into slash commands, skills or "
        "templates (propose a name and what they would do); 3) agents: which add value, which are superfluous and "
        "which are missing; 4) models and routing: where to save without losing quality; 5) MemPalace and recall: what "
        "to adjust (threshold, cleanup, what to save); 6) the 5 most valuable concrete actions for next week.",
        json.dumps({k: v for k, v in d.items() if k not in ("mapa", "tendencia", "aprendizaje")} | {"aprendizaje": {k: v for k, v in (d.get("aprendizaje") or {}).items() if k != "recientes"},
                    "semana_actual": (d.get("tendencia") or {}).get("actual"), "semana_anterior": (d.get("tendencia") or {}).get("anterior")}, ensure_ascii=False))
    if memoria:
        out["memoria"] = claude_texto(
            "Use mempalace_status, mempalace_kg_stats and mempalace_graph_stats. Summarize: palace size, largest wings, "
            "wings DUPLICATED by name (e.g. “x” and “wing_x”) with their drawers, rooms, graph facts and relations, and "
            "recommend how to clean up and which structured facts are worth recording (preferences, decisions, projects).",
            "", "mcp__mempalace__mempalace_status,mcp__mempalace__mempalace_kg_stats,mcp__mempalace__mempalace_graph_stats", "sonnet")
    return out


# ---- output -----------------------------------------------------------------------------------------
def markdown(d: dict, x: dict) -> str:
    u = d["uso"]
    md = [f"# Report on working with Claude — last {d['dias']} days (since {d['desde']})", "",
          f"_Generated {d['generado']} by `ws-informe`. Cost = API equivalent._", "",
          "| Cost | Turns | Sessions | Active hours | Median turn | p90 turn | Turns/session | Your wait to approve |",
          "|---:|---:|---:|---:|---:|---:|---:|---:|",
          f"| ${u['costo']:,.2f} | {u['turnos']} | {u['sesiones']} | {u['horas_activas']} | {u['turno_med_min']} min | {u['turno_p90_min']} min | {u['turnos_por_sesion']} | {u['espera_min']} min |", ""]
    if x.get("hallazgos"):
        # Claude's headings go down two levels: “## 1) …” used to split the report into loose sections.
        md += ["## Findings and suggestions (Claude)", "", re.sub(r"(?m)^(#{1,3})\s", lambda m: "#" * min(4, len(m.group(1)) + 2) + " ", x["hallazgos"]), ""]
    if d.get("ideas"):
        et = {"crear": "Create", "mejorar": "Improve", "vigilar": "Watch"}
        md += ["## What to improve and what to create", "", "| Type | What | Evidence |", "|---|---|---|"]
        md += [f"| {et.get(i['tipo'], i['tipo'])} | {i['titulo']} | {i['evidencia']} |" for i in d["ideas"]] + [""]
    te = d.get("tendencia")
    if te and te.get("actual"):
        a, b = te["actual"], te["anterior"]

        def cambio(x, y):
            return "—" if not y else f"{'▲' if x > y else '▼' if x < y else '＝'} {abs(100 * (x - y) / y):.0f} %"
        filas = [("Cost", f"${a['costo']:,.2f}", f"${b['costo']:,.2f}", cambio(a["costo"], b["costo"])),
                 ("Your turns", a["turnos"], b["turnos"], cambio(a["turnos"], b["turnos"])),
                 ("Sessions", a["sesiones"], b["sesiones"], cambio(a["sesiones"], b["sesiones"])),
                 ("Input from cache", f"{a['cache_pct']} %", f"{b['cache_pct']} %", cambio(a["cache_pct"], b["cache_pct"])),
                 ("Median turn", f"{a['dur_p50']} s", f"{b['dur_p50']} s", cambio(a["dur_p50"], b["dur_p50"])),
                 ("p90 turn", f"{a['dur_p90']} s", f"{b['dur_p90']} s", cambio(a["dur_p90"], b["dur_p90"])),
                 ("Cost in subagents", f"{a['sub_pct']} %", f"{b['sub_pct']} %", cambio(a["sub_pct"], b["sub_pct"])),
                 ("Cost in automatic work (no message from you)", f"{a.get('auto_pct', 0)} %", f"{b.get('auto_pct', 0)} %", cambio(a.get("auto_pct", 0), b.get("auto_pct", 0)))]
        md += ["## Last 7 days versus the previous 7", "", "| Metric | Now | Before | Change |", "|---|---:|---:|---:|"]
        md += [f"| {m} | {x} | {y} | {c} |" for m, x, y, c in filas]
        md += ["", "## Weekly trend", "", "| Week (Monday) | Cost | Turns | Sessions | Cache | Reasoning | Median turn | p90 turn |", "|---|---:|---:|---:|---:|---:|---:|---:|"]
        md += [f"| {f['inicio']}{' (in progress)' if f.get('parcial') else ''} | ${f['costo']:,.2f} | {f['turnos']} | {f['sesiones']} | {f['cache_pct']} % | {f['razon_pct']} % | {f['dur_p50']} s | {f['dur_p90']} s |"
               for f in te["semanas"] if f["turnos"]] + [""]
    tk = d.get("tokens")
    if tk:
        md += ["## Tokens and words", "", "| New input | Cache written | Cache read | Output | Reasoning | Total | Per turn |", "|---:|---:|---:|---:|---:|---:|---:|",
               f"| {tk['entrada_nueva']:,} | {tk['cache_escrita']:,} | {tk['cache_leida']:,} | {tk['salida']:,} | {tk['razonamiento']:,} ({tk['razonamiento_pct']} % of the output) | {tk['total']:,} | {tk['por_turno']:,} |",
               "", "| Your words | Claude's words | Median prompt | Median answer | Claude's words per word of yours |", "|---:|---:|---:|---:|---:|",
               f"| {tk['palabras_tuyas']:,} | {tk['palabras_claude']:,} | {tk['prompt_mediano']} | {tk['respuesta_mediana']} | {tk['palabras_claude_por_tuya']} |", ""]
    rc = d.get("recursos")
    if rc:
        md += ["## Machine resources (Claude processes)", "", "| Day | Processes | CPU (min) | Average CPU | Peak RAM | Disk operations/s | Read | Written |", "|---|---:|---:|---:|---:|---:|---:|---:|"]
        md += [f"| {x['dia']} | {x['procesos']} | {x['cpu_min']} | {x['cpu_pct']} % | {x['ram_pico_mb']:,} MB | {x['iops']} | {x['leidos_mb']:,} MB | {x['escritos_mb']:,} MB |" for x in rc["dias"][-14:]]
        md += ["", "| Project | CPU (min) | Average CPU | Max RAM of one process | Disk operations/s | Read | Written |", "|---|---:|---:|---:|---:|---:|---:|"]
        md += [f"| {x['proyecto']} | {x['cpu_min']} | {x['cpu_pct']} % | {x['ram_mb']:,} MB | {x['iops']} | {x['leidos_mb']:,} MB | {x['escritos_mb']:,} MB |" for x in rc["proyectos"]] + [""]
    md += ["## Projects", "", "| Project | Cost | Hours | Turns | Model | +lines | Commits |", "|---|---:|---:|---:|---|---:|---:|"]
    md += [f"| {p['clave']} | ${p['costo']:,.2f} | {p['horas_activas']} | {p['turnos']} | {p['modelo']} | {p['lineas_mas']} | {p['commits']} |" for p in d["proyectos"]]
    md += ["", "## Models", "", *[f"- {m['modelo']}: ${m['costo']:,.2f} ({m['pct']} %)" for m in d["modelos"]]]
    if d["ruteo"]:
        md += ["", "## Routing", "", ", ".join(f"{k}: {v}" for k, v in d["ruteo"].items())]
    md += ["", "## Agents", "", "| Agent | Uses | Projects | Requested model | Min (median) |", "|---|---:|---|---|---:|"]
    md += [f"| {a['tipo']} | {a['usos']} | {a['proyectos']} | {a['modelo']} | {a['min_mediana'] if a['min_mediana'] is not None else '—'} |" for a in d["agentes"]] or ["| (no subagents) | | | | |"]
    md += ["", "## Recurring prompts (command or skill candidates)", "", "| Starts with | Times | Projects |", "|---|---:|---:|"]
    md += [f"| {r['frase']} | {r['veces']} | {r['proyectos']} |" for r in d["recurrentes"]] or ["| (none with 3 or more) | | |"]
    md += ["", "## Most used slash commands", "", ", ".join(f"`{c['comando']}` {c['veces']}" for c in d["comandos"]) or "—"]
    rz = d.get("razones")
    if rz and rz.get("razones"):
        md += ["", "## Estimation ratios (unit of work → text, model, cost and machine)", "", "| Group | Ratio | Value | Unit | Computed over |", "|---|---|---:|---|---|"]
        md += [f"| {x['grupo']} | {x['nombre']} | {x['valor']:,} | {x['unidad']} | {x['base']} |" for x in rz["razones"]]
    ot = d.get("otel")
    if ot and ot.get("api"):
        a, c = ot["api"], ot.get("codigo") or {}
        s = lambda x: "—" if x is None else (f"{x / 1000:.1f} s" if x >= 1000 else f"{x:.0f} ms")  # noqa: E731
        md += ["", "## API, permissions and active time (OpenTelemetry, local collector)", "",
               "| Calls | Typical duration | p95 | First token | Errors | Out of retries | Cost |", "|---:|---:|---:|---:|---:|---:|---:|",
               f"| {a['llamadas']:,} | {s(a['med_ms'])} | {s(a['p95_ms'])} | {s(a.get('ttft_med_ms'))} | {a['errores']} ({a['error_pct']} %) | {a['agotados']} | ${a['costo']:,.2f} |",
               "", f"Code according to Claude Code: +{c.get('lineas_mas', 0):,} / −{c.get('lineas_menos', 0):,} lines · {c.get('commits', 0)} commits · {c.get('prs', 0)} PR. "
               f"Active time: yours {sum(x['tuyo_min'] for x in ot.get('activo', [])) / 60:.1f} h, Claude's {sum(x['claude_min'] for x in ot.get('activo', [])) / 60:.1f} h."]
        if ot.get("errores"):
            md += ["", "API errors by code: " + ", ".join(f"{e['codigo']}: {e['n']}" for e in ot["errores"])]
        if ot.get("permisos"):
            md += ["", "| Who decides the permission | Accepts | Rejects |", "|---|---:|---:|"] + [f"| {p['fuente']} | {p['acepta']} | {p['rechaza']} |" for p in ot["permisos"]]
        if ot.get("hooks"):
            md += ["", "| Hook | Times | Median | p95 | Total |", "|---|---:|---:|---:|---:|"] + [f"| {h['evento']} | {h['n']} | {s(h['med_ms'])} | {s(h['p95_ms'])} | {h['total_s']} s |" for h in ot["hooks"]]
        if ot.get("subagentes"):
            md += ["", "| Subagent | Times | Typical duration | Tokens | Tools |", "|---|---:|---:|---:|---:|"] + [f"| {x['tipo']} | {x['n']} | {s(x['med_ms'])} | {x['tokens']:,} | {x['herramientas']} |" for x in ot["subagentes"]]
    eb = d.get("estimacion_base")
    if eb:
        v = lambda x, f="{:,}": "—" if x is None else f.format(x)  # noqa: E731
        md += ["", "## Estimation baseline (real data per project)", "",
               "| Project | Active hours | Turns | Tokens | Your words | Claude's words | +lines | Commits | CPU (min) | Cost | Cost/hour | Turns/hour | Output tokens/hour | Cost per 100 lines |",
               "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
        md += [f"| {e['proyecto']} | {e['horas_activas']} | {e['turnos']} | {e['tokens']:,} | {e['palabras_tuyas']:,} | {e['palabras_claude']:,} | {e['lineas_mas']:,} | {e['commits']} | {v(e['cpu_min'])} | "
               f"${e['costo']:,.2f} | {v(e['costo_por_hora'], '${:,.2f}')} | {v(e['turnos_por_hora'])} | {v(e['tokens_salida_por_hora'])} | {v(e['costo_por_100_lineas'], '${:,.2f}')} |" for e in eb]
    hs = d.get("herramientas") or []
    if hs:
        md += ["", "## Operations: tools", "", "| Tool | Uses | With error | Median | p95 | Minutes | Approx. cost |", "|---|---:|---:|---:|---:|---:|---:|"]
        md += [f"| {h.get('nombre')} | {h.get('usos', 0)} | {h.get('errores', 0)} | {(h.get('med_ms') or 0) / 1000:.1f} s | {(h.get('p95_ms') or 0) / 1000:.1f} s | {h.get('total_min', 0)} | ${h.get('costo', 0):,.2f} |" for h in hs]
    for titulo, clave, nombre in (("Terminal operations by type", "bash", "categoria"), ("MCP servers", "mcp", "servidor"), ("Skills used", "skills", "nombre"), ("Errors by type", "errores", "tipo")):
        filas = d.get(clave) or []
        if filas:
            md += ["", f"## {titulo}", "", ", ".join(f"{f.get(nombre) or f.get('nombre') or f.get('categoria') or '?'}: {f.get('usos', f.get('n', f.get('min', '')))}" for f in filas[:15])]
    ap = d.get("aprendizaje")
    if ap:
        md += ["", "## What Claude has learned about you and what you have tailored", "",
               "| Memories | New in the period | By type | Own slash commands | Own skills | Own agents | Rules (lines of CLAUDE.md) |", "|---:|---:|---|---:|---:|---:|---:|",
               f"| {ap['memorias']} | {ap['memorias_nuevas']} | {', '.join(f'{k}: {v}' for k, v in ap['por_tipo'].items()) or '—'} | {len(ap['comandos_propios'])} | {len(ap['skills_propias'])} | {len(ap['agentes_propios'])} | {ap['reglas_lineas']} |"]
        if ap["recientes"]:
            md += ["", "| Recent memory | Type | Date |", "|---|---|---|"] + [f"| {m['nombre']} | {m['tipo']} | {m['fecha']} |" for m in ap["recientes"]]
        for t, k in (("Your own commands", "comandos_propios"), ("Your own agents", "agentes_propios")):
            if ap[k]:
                md += ["", f"{t}: " + ", ".join(f"`{x}`" for x in ap[k][:30])]
    mp = d.get("mempalace")
    if mp:
        di, hu = mp["diario"], mp["hub"]
        tot = di.get("guardado", 0) + di.get("fallido", 0)
        md += ["", "## MemPalace", "", "| Diary saved | Diary failed | Failure | Mined | Hub starts | Embedding errors | Size |", "|---:|---:|---:|---:|---:|---:|---:|",
               f"| {di.get('guardado', 0):,} | {di.get('fallido', 0):,} | {100 * di.get('fallido', 0) / tot if tot else 0:.0f} % | {di.get('minado', 0):,} | {hu.get('arranques', 0)} | {hu.get('errores_embedding', 0)} | {mp['palacio_mb']:,} MB |"]
        if mp.get("por_dia"):
            md += ["", "| Day" + (" (approximate)" if mp.get("fechas_aprox") else "") + " | Saved | Failed | Mined |", "|---|---:|---:|---:|"]
            md += [f"| {k} | {v.get('guardado', 0)} | {v.get('fallido', 0)} | {v.get('minado', 0)} |" for k, v in mp["por_dia"].items()]
    if x.get("memoria"):
        md += ["", x["memoria"]]
    rc = d.get("recall")
    if rc:
        de, la, wi = rc.get("decisions") or {}, rc.get("latency_ms") or {}, rc.get("would_inject_at") or {}
        md += ["", "## recall", "", "| Decision | Times |", "|---|---:|"] + [f"| {k} | {v:,} |" for k, v in de.items()]
        md += ["", f"Hook latency: median {la.get('p50', '—')} ms, p95 {la.get('p95', '—')} ms. Searches: {rc.get('searched', 0):,}."]
        if wi:
            md += ["", "| Threshold | Would inject |", "|---:|---:|"] + [f"| {k} | {v:,} |" for k, v in wi.items() if 0.69 < float(k) < 0.81]
    return "\n".join(md) + "\n"


def _barras_svg(titulo: str, puntos: list[tuple[str, float]], fmt) -> str:
    """SVG bars without libraries: one per period, with the value printed on top and in the title."""
    if not puntos or not any(v for _, v in puntos):
        return ""
    W, H, mi, mb, mt = 720, 170, 8, 20, 16
    bw = (W - mi) / len(puntos); mx = max(v for _, v in puntos) or 1
    g = ""
    for i, (e, v) in enumerate(puntos):
        h = (H - mb - mt) * v / mx; x = mi + i * bw; y = H - mb - h
        g += (f'<rect x="{x + 2:.1f}" y="{y:.1f}" width="{max(1, bw - 4):.1f}" height="{h:.1f}" rx="2" fill="var(--acc)"><title>{html.escape(e)}: {html.escape(fmt(v))}</title></rect>'
              + (f'<text x="{x + bw / 2:.1f}" y="{y - 3:.1f}" text-anchor="middle">{html.escape(fmt(v))}</text>' if bw > 40 else "")
              + (f'<text x="{x + bw / 2:.1f}" y="{H - 5}" text-anchor="middle">{html.escape(e)}</text>' if len(puntos) <= 16 or i % 3 == 0 else ""))
    return f'<figure><figcaption>{html.escape(titulo)}</figcaption><svg viewBox="0 0 {W} {H}" width="100%" role="img" aria-label="{html.escape(titulo)}">{g}</svg></figure>'


def graficas(d: dict) -> str:
    te, rc, out = d.get("tendencia") or {}, d.get("recursos") or {}, []
    sem = [f for f in te.get("semanas", [])]
    corto = lambda s: s[8:10] + "/" + s[5:7]  # noqa: E731
    out.append(_barras_svg("Cost per week (Monday to Sunday, local time)", [(corto(f["inicio"]), f["costo"]) for f in sem], lambda v: f"${v:,.0f}"))
    out.append(_barras_svg("Turns per week", [(corto(f["inicio"]), f["turnos"]) for f in sem], lambda v: f"{v:,.0f}"))
    out.append(_barras_svg("p90 turn per week (seconds)", [(corto(f["inicio"]), f["dur_p90"]) for f in sem], lambda v: f"{v:,.0f} s"))
    dias = rc.get("dias", [])[-30:]
    out.append(_barras_svg("Peak RAM per day (MB, all Claude processes)", [(corto(x["dia"]), x["ram_pico_mb"]) for x in dias], lambda v: f"{v:,.0f}"))
    out.append(_barras_svg("CPU per day (processor minutes)", [(corto(x["dia"]), x["cpu_min"]) for x in dias], lambda v: f"{v:,.0f}"))
    out.append(_barras_svg("Disk operations per second, per day", [(corto(x["dia"]), x["iops"]) for x in dias], lambda v: f"{v:,.0f}"))
    out = [o for o in out if o]
    return ("<h2>Charts</h2><div class='graf'>" + "".join(out) + "</div>") if out else ""


def _md_linea(t: str) -> str:
    """Minimal, safe inline Markdown: escapes everything and then applies bold, italics and code."""
    t = html.escape(t)
    t = re.sub(r"`([^`]+)`", r"<code>\1</code>", t)
    t = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", t)
    return re.sub(r"(?<![\w*])_([^_]+)_(?![\w*])", r"<i>\1</i>", t)


def _es_num(c: str) -> bool:
    return bool(re.fullmatch(r"[−+\-]?\$?[\d.,]+\s?(%|s|ms|min|h|MB|GB|×|k|M)?|—|[▲▼＝] ?[\d.,]+ ?%", c.strip()))


def _md_html(texto: str) -> str:
    """Markdown → HTML for the report body: headings, tables (numbers right-aligned), lists and paragraphs."""
    out, lista = [], []

    def cerrar_lista():
        if lista:
            out.append("<ul>" + "".join(f"<li>{x}</li>" for x in lista) + "</ul>")
            lista.clear()

    for bloque in re.split(r"\n\s*\n", texto.strip()):
        lineas = [x for x in bloque.splitlines() if x.strip()]
        if not lineas:
            continue
        if lineas[0].lstrip().startswith("|") and len(lineas) > 1:
            cerrar_lista()
            filas = [[c.strip() for c in x.strip().strip("|").split("|")] for x in lineas if not re.match(r"^\s*\|[-:| ]+\|\s*$", x)]
            cab, cuerpo = filas[0], filas[1:]
            num = [bool(cuerpo) and all(_es_num(f[i]) for f in cuerpo if i < len(f) and f[i]) for i in range(len(cab))]
            td = lambda f: "".join(f'<td class="{"n" if i < len(num) and num[i] else ""}">{_md_linea(c)}</td>' for i, c in enumerate(f))  # noqa: E731
            out.append('<div class="tabla"><table><thead><tr>' + "".join(f'<th class="{"n" if num[i] else ""}">{_md_linea(c)}</th>' for i, c in enumerate(cab))
                       + "</tr></thead><tbody>" + "".join(f"<tr>{td(f)}</tr>" for f in cuerpo) + "</tbody></table></div>")
            continue
        for x in lineas:
            s = x.strip()
            m = re.match(r"^(#{1,4})\s+(.*)$", s)
            if m:
                cerrar_lista()
                n = min(4, len(m.group(1)) + 1)
                out.append(f"<h{n}>{_md_linea(m.group(2))}</h{n}>")
            elif re.match(r"^([-*•]|\d+[.)])\s+", s):
                lista.append(_md_linea(re.sub(r"^([-*•]|\d+[.)])\s+", "", s)))
            else:
                cerrar_lista()
                out.append(f"<p>{_md_linea(s)}</p>")
        cerrar_lista()
    return "".join(out)


def _barras_h(titulo: str, filas: list[tuple[str, float]], fmt, nota: str = "") -> str:
    """Horizontal bars (HTML and CSS): one per category, sorted, with the value printed."""
    filas = [(e, v) for e, v in filas if v]
    if not filas:
        return ""
    mx = max(v for _, v in filas) or 1
    cuerpo = "".join(f'<div class="bh"><span class="bh-e" title="{html.escape(str(e))}">{html.escape(str(e))}</span>'
                     f'<span class="bh-t"><i style="width:{max(1.5, 100 * v / mx):.1f}%"></i></span><span class="bh-v">{html.escape(fmt(v))}</span></div>'
                     for e, v in filas[:10])
    return f'<figure><figcaption>{html.escape(titulo)}</figcaption>{cuerpo}{f"<small>{html.escape(nota)}</small>" if nota else ""}</figure>'


def distribucion(d: dict) -> str:
    """Where the cost, the time and the errors go: by project, model, agent, tool and command type."""
    usd = lambda v: f"${v:,.0f}"  # noqa: E731
    n = lambda v: f"{v:,.0f}"     # noqa: E731
    out = [
        _barras_h("Cost by project", [(p["clave"], p["costo"]) for p in d.get("proyectos") or []], usd),
        _barras_h("Cost by model", [(m["modelo"].replace("claude-", ""), m["costo"]) for m in d.get("modelos") or []], usd),
        _barras_h("Most used subagents (times)", [(a["tipo"], a["usos"]) for a in d.get("agentes") or []], n),
        _barras_h("Most used tools (times)", [(h.get("nombre"), h.get("usos", 0)) for h in d.get("herramientas") or []], n),
        _barras_h("Terminal time by command type (minutes)", [(b.get("nombre"), b.get("total_min", 0)) for b in d.get("bash") or []], n),
        _barras_h("Tool errors by type", [(e.get("tipo"), e.get("n", 0)) for e in d.get("errores") or []], n),
        _barras_h("Active hours by project", [(p["clave"], p["horas_activas"]) for p in d.get("proyectos") or []], lambda v: f"{v:,.1f} h"),
        _barras_h("Model routing decisions", sorted((d.get("ruteo") or {}).items(), key=lambda x: -x[1]), n,
                  "igual = you were already on the suggested model · silenciado = you asked not to be asked"),
    ]
    out = [o for o in out if o]
    return ('<h2 class="sep" id="distribucion">Where the cost and the time go</h2><div class="graf">' + "".join(out) + "</div>") if out else ""


# Group of each detail section (by how its title starts) and order of the groups on the page.
GRUPOS = (("claude", "What Claude says", ("Findings and suggestions",)),
          ("semana", "This week and trend", ("Last 7 days", "Weekly trend")),
          ("costo", "Projects, models and agents", ("Projects", "Models", "Routing", "Agents")),
          ("estimar", "For estimating", ("Estimation ratios", "Estimation baseline", "Tokens and words")),
          ("operacion", "Operation", ("API, permissions", "Operations", "Terminal operations", "MCP servers", "Skills used", "Errors by type",
                                      "Most used slash commands", "Recurring prompts")),
          ("maquina", "Machine", ("Machine resources",)),
          ("memoria", "Memory and learning", ("What Claude has learned", "MemPalace", "recall")))


def html_doc(md_texto: str, d: dict) -> str:
    """Self-contained HTML of the report: key figures, ideas, hour map, charts and the detail by sections."""
    u = d["uso"]
    te = d.get("tendencia") or {}
    a, b = te.get("actual") or {}, te.get("anterior") or {}

    def cambio(x, y, malo_si_sube=True):
        if not y:
            return ""
        p = 100 * (x - y) / y
        cls = "neutro" if abs(p) < 0.5 else ("mal" if (p > 0) == malo_si_sube else "bien")
        return f'<span class="delta {cls}">{"▲" if p > 0 else "▼"} {abs(p):.0f} % versus the previous 7 days</span>'

    tiles = [("Equivalent cost", f"${u['costo']:,.0f}", f"{d['dias']} days · " + (f"${a['costo']:,.0f} this week" if a else "")),
             ("Your turns", f"{u['turnos']:,}", f"{u['sesiones']} sessions · {u['turnos_por_sesion']} per session"),
             ("Active hours", f"{u['horas_activas']:,.0f}", "with some turn running"),
             ("Typical turn", f"{u['turno_med_min']} min", f"one in ten goes over {u['turno_p90_min']} min"),
             ("Waiting for your approval", f"{u['espera_min']:,.0f} min", "in permission dialogs")]
    if a:
        tiles.append(("Cost outside your turns", f"{a.get('sub_pct', 0) + a.get('auto_pct', 0):.0f} %",
                      f"subagents {a.get('sub_pct', 0)} % · automatic work {a.get('auto_pct', 0)} % (7 days)"))
    if a and b:
        tiles[0] = (tiles[0][0], tiles[0][1], cambio(a.get("costo", 0), b.get("costo", 0)) or tiles[0][2])
    kpis = "".join(f'<div class="kpi"><span>{html.escape(t)}</span><b>{html.escape(v)}</b><small>{s}</small></div>' for t, v, s in tiles)

    et = {"crear": "Create", "mejorar": "Improve", "vigilar": "Watch"}
    ideas = "".join(f'<div class="idea {html.escape(i["tipo"])}"><span class="chip">{et.get(i["tipo"], i["tipo"])}</span><b>{_md_linea(i["titulo"])}</b>'
                    f'<small>{_md_linea(i["evidencia"])}</small></div>' for i in d.get("ideas") or [])

    dias = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    mx = max([max(f) for f in d["mapa"]] + [1])
    celdas = "".join(f"<tr><th>{dias[i]}</th>" + "".join(
        f'<td style="background:rgba(196,100,58,{(0.12 + 0.88 * v / mx) if v else 0:.2f})" title="{dias[i]} {h}:00 · {v} turns"></td>' for h, v in enumerate(f)) + "</tr>"
        for i, f in enumerate(d["mapa"]))

    # The detail: the Markdown by sections, without the header (it goes in the cards) or the ideas table (it goes on top).
    partes = re.split(r"(?m)^## ", md_texto)
    por_grupo: dict[str, list[str]] = {g[0]: [] for g in GRUPOS}
    por_grupo["otros"] = []
    for sec in partes[1:]:
        titulo, _, cuerpo = sec.partition("\n")
        titulo = titulo.strip()
        if titulo.startswith("What to improve and what to create"):
            continue
        grupo = next((g[0] for g in GRUPOS if titulo.startswith(g[2])), "otros")
        cuerpo_html = _md_html(cuerpo)
        ancho = max((fila.count("<th") for fila in re.findall(r"<thead>.*?</thead>", cuerpo_html, re.S)), default=0)
        clase = " ".join(c for c in ("ia" if grupo == "claude" else "", "ancho" if ancho > 5 or grupo == "claude" else "") if c)
        por_grupo[grupo].append(f'<section class="{clase}"><h2>{_md_linea(titulo)}</h2>{cuerpo_html}</section>')
    nombres = {g[0]: g[1] for g in GRUPOS} | {"otros": "Other"}
    orden = [g for g in [*nombres] if por_grupo.get(g)]
    detalle = "".join(f'<h2 class="sep" id="{g}">{html.escape(nombres[g])}</h2><div class="rejilla">{"".join(por_grupo[g])}</div>' for g in orden)
    nav = [("resumen", "Summary"), ("ideas", "What to improve"), ("horas", "When you work"), ("tendencias", "Trends"), ("distribucion", "Where it goes"),
           *[(g, nombres[g]) for g in orden]]
    nav_html = "".join(f'<a href="#{i}">{html.escape(t)}</a>' for i, t in nav)

    return f"""<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Report on working with Claude</title><style>
:root{{--bg:#f6f5f1;--fg:#1f1e1b;--mut:#6b675f;--line:#e3e0d8;--acc:#c4643a;--panel:#fff;--ok:#3f7d4e;--warn:#b07b1f;--bad:#b3402e}}
@media (prefers-color-scheme:dark){{:root{{--bg:#161513;--fg:#ece9e2;--mut:#a39e93;--line:#34322d;--acc:#e08a5c;--panel:#1f1e1b;--ok:#7cbf8b;--warn:#e0b45c;--bad:#e58a78}}}}
*{{box-sizing:border-box}} body{{margin:0;background:var(--bg);color:var(--fg);font:14px/1.5 "Segoe UI",system-ui,sans-serif}}
main{{max-width:1180px;margin:0 auto;padding:28px 20px 48px;display:flex;flex-direction:column;gap:22px}}
header h1{{font-size:24px;margin:0 0 2px;font-weight:600}} header p{{margin:0;color:var(--mut);font-size:13px}}
h2{{font-size:16px;margin:0 0 10px;font-weight:600}} h3{{font-size:14px;margin:14px 0 6px}} h4{{font-size:13px;margin:10px 0 4px;color:var(--mut)}}
section,.bloque{{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px 18px;min-width:0}}
section.ia{{border-left:4px solid var(--acc)}} section p{{margin:6px 0;max-width:80ch}} section ul{{margin:6px 0;padding-left:20px;max-width:80ch}} li{{margin:3px 0}}
.kpis{{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}}
.kpi{{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:14px 16px;min-width:0}}
.kpi span{{color:var(--mut);font-size:12.5px;display:block}} .kpi b{{font-size:28px;font-weight:600;font-variant-numeric:tabular-nums;display:block;line-height:1.2}}
.kpi small{{color:var(--mut);font-size:12px}}
.delta.mal{{color:var(--warn)}} .delta.bien{{color:var(--ok)}} .delta.neutro{{color:var(--mut)}}
.ideas{{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:12px}}
.idea{{background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--mut);border-radius:10px;padding:12px 14px;display:flex;flex-direction:column;gap:4px;min-width:0}}
.idea.crear{{border-left-color:var(--ok)}} .idea.mejorar{{border-left-color:var(--warn)}} .idea.vigilar{{border-left-color:var(--bad)}}
.idea small{{color:var(--mut);font-size:12.5px;overflow-wrap:anywhere}} .chip{{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--mut)}}
.tabla{{overflow-x:auto;margin:8px 0}} table{{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}}
th,td{{border-bottom:1px solid var(--line);padding:6px 10px 6px 0;text-align:left;vertical-align:top}} th{{color:var(--mut);font-weight:500;font-size:12px;white-space:nowrap}}
td.n,th.n{{text-align:right;white-space:nowrap}} tr:last-child td{{border-bottom:0}} code{{background:var(--line);border-radius:4px;padding:0 4px;font-size:12.5px}}
.mapa{{table-layout:fixed}} .mapa th{{font-size:11px;padding:2px;text-align:center}} .mapa td{{height:18px;border:2px solid var(--panel);border-radius:4px;padding:0}}
.graf{{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:12px}} figure{{margin:0;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 14px}}
figcaption{{color:var(--mut);font-size:12.5px;margin-bottom:4px}} svg text{{fill:var(--mut);font-size:10px}}
h2.sep{{margin:10px 0 -8px;font-size:15px;scroll-margin-top:56px}}
nav{{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line);padding:8px 0;display:flex;gap:6px;flex-wrap:wrap;margin:-6px 0}}
nav a{{color:var(--fg);text-decoration:none;font-size:12.5px;border:1px solid var(--line);border-radius:999px;padding:3px 11px;background:var(--panel)}} nav a:hover{{border-color:var(--acc)}}
.rejilla{{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,470px),1fr));gap:14px;align-items:start}} .rejilla .ancho{{grid-column:1/-1}}
.bh{{display:grid;grid-template-columns:minmax(90px,34%) 1fr auto;gap:8px;align-items:center;font-size:12.5px;margin:5px 0}}
.bh-e{{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}} .bh-t{{height:10px;background:var(--line);border-radius:5px;overflow:hidden}}
.bh-t i{{display:block;height:100%;background:var(--acc);border-radius:5px}} .bh-v{{font-variant-numeric:tabular-nums;color:var(--mut);white-space:nowrap}}
figure small{{color:var(--mut);font-size:11.5px;display:block;margin-top:6px}}
</style></head><body><main>
<header><h1>Report on working with Claude</h1><p>Last {d['dias']} days (since {html.escape(d['desde'])}) · generated {html.escape(d['generado'])} · cost = equivalent at API prices</p></header>
<nav>{nav_html}</nav>
<div class="kpis" id="resumen">{kpis}</div>
{'<h2 class="sep" id="ideas">What to improve and what to create</h2><div class="ideas">' + ideas + '</div>' if ideas else ''}
<div class="bloque" id="horas"><h2>When you work (turns per hour and day)</h2><table class="mapa"><tr><th></th>{''.join(f'<th>{h}</th>' for h in range(24))}</tr>{celdas}</table></div>
{graficas(d).replace('<h2>Charts</h2>', '<h2 class="sep" id="tendencias">Trends</h2>')}
{distribucion(d)}
{detalle}
</main></body></html>"""


def destino() -> Path:
    out = DATOS / "informes"; out.mkdir(parents=True, exist_ok=True)
    return out


def ventana_windows() -> Path | None:
    try:
        u = subprocess.run(["wslvar", "USERPROFILE"], capture_output=True, text=True, timeout=10).stdout.strip()  # nosec B603 B607
        return Path(subprocess.run(["wslpath", "-u", u], capture_output=True, text=True, timeout=10).stdout.strip()) / "ws-telemetria" if u else None  # nosec B603 B607
    except (OSError, subprocess.SubprocessError):
        return None


def main() -> int:
    a = sys.argv[1:]
    dias = int(a[a.index("--dias") + 1]) if "--dias" in a else 30
    d = calcular(dias)
    if "--json" in a:
        print(json.dumps(d, ensure_ascii=False, indent=1)); return 0
    x = ia(d, "--ia-memoria" in a) if ("--ia" in a or "--ia-memoria" in a) else {}
    md = markdown(d, x)
    nombre = f"informe-{dt.date.today().isoformat()}"
    out = destino(); (out / f"{nombre}.md").write_text(md, encoding="utf-8"); (out / f"{nombre}.html").write_text(html_doc(md, d), encoding="utf-8")
    final = out / f"{nombre}.html"
    w = None if os.environ.get("WS_INFORME_SIN_WINDOWS") else ventana_windows()
    if w:
        try:
            w.mkdir(parents=True, exist_ok=True)
            for ext in ("md", "html"):
                shutil.copyfile(out / f"{nombre}.{ext}", w / f"{nombre}.{ext}")
            final = w / f"{nombre}.html"
        except OSError:
            pass
    print(md if "--abrir" not in a else "")
    print(f"Report: {final}")
    if "--abrir" in a:
        try:
            subprocess.run(["explorer.exe", subprocess.run(["wslpath", "-w", str(final)], capture_output=True, text=True).stdout.strip()], timeout=15)  # nosec B603 B607
        except (OSError, subprocess.SubprocessError):
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
