#!/usr/bin/env bash
#
# ws-check — checks the state of the workstation (tmux + Claude Code) without changing anything.
chk() { printf '%-42s %s\n' "$1" "$(eval "$2" >/dev/null 2>&1 && echo OK || echo MISSING)"; }
S=~/.claude/settings.json
echo "== tmux status bar (UTF-8)"
chk "LANG=C.UTF-8 in ~/.bashrc"          "grep -qx 'export LANG=C.UTF-8' ~/.bashrc"
chk "tmux with UTF-8"                    "tmux show-environment -g LANG | grep -qi utf"
echo "== Azure MCP"
chk "Node installed"                     "command -v node"
chk "azure MCP registered"               "claude mcp get azure"
chk "extra confirmations mcp__azure"     "jq -e '.permissions.ask | index(\"mcp__azure__*update*\")' $S"
echo "== Obsidian"
chk "wrapper ~/.local/bin/obsidian"      "test -x ~/.local/bin/obsidian"
chk "Obsidian responds"                  "timeout 15 obsidian version"
chk "Obsidian permissions"               "jq -e '.permissions.deny | index(\"Bash(obsidian eval*)\")' $S"
chk "Obsidian section in standards.md"  "grep -q '^## Obsidian' ~/.claude/standards.md"
echo "== Sandbox (pilot)"
chk "bubblewrap and socat"               "command -v bwrap && command -v socat"
echo "== Kit"
chk "repo ~/code/claude-workstation"     "test -f ~/code/claude-workstation/export.sh"
chk "export done (files/)"               "test -d ~/code/claude-workstation/files"
chk "initial commit"                     "git -C ~/code/claude-workstation log --oneline -1"
echo "== Base (phases 1 and 2)"
chk "claude-resume (restore)"            "grep -q 'claude->claude-resume' ~/.tmux.conf"
chk "save every 1 min"                   "grep -q \"continuum-save-interval '1'\" ~/.tmux.conf"
chk "MemPalace in WSL (5 hooks)"         "test \$(grep -c win-hook $S) -ge 5"
chk "MCP microsoft-learn"                "claude mcp get microsoft-learn"
chk "MCP ms-release-comms"               "claude mcp get ms-release-comms"
chk "gh authenticated"                   "gh auth status"
chk "default model configured"           "jq -e '.model | strings | length > 0' $S"
echo "== Additional security"
chk "global sandbox"                     "jq -e '.sandbox.enabled' $S"
chk "gitleaks + global hooks"            "command -v gitleaks && test \"\$(git config --global core.hooksPath)\" = \"$HOME/.config/git/hooks\""
chk "conversation backup (<2 h)"         "test -n \"\$(find @WINHOME@/.claude-wsl-backup/.last -mmin -120 2>/dev/null)\""
