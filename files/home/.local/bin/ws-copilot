#!/usr/bin/env bash
#
# ws-copilot — API engine of the terminal copilot using Anthropic's official CLI (`ant`).
# Signs in with Claude Console OAuth: no API key to create, store or rotate. The login lives in
# its own directory (ANTHROPIC_CONFIG_DIR=~/.config/anthropic-copilot) so that Claude Code
# never picks it up as an alternative credential for your sessions.
#
# Usage:
#   ws-copilot install [VERSION]    downloads ant (official release) and verifies its SHA-256
#   ws-copilot login                signs in (pick the Console organization and workspace)
#   ws-copilot status               shows the active credential and workspace
#   ws-copilot test                 minimal query to Haiku and measures the latency
#   ws-copilot logout               signs the copilot out
set -euo pipefail
DIR="${AI_SHELL_ANT_DIR:-$HOME/.config/anthropic-copilot}"
VERSION_DEF="2.10.0"
A() { env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_PROFILE ANTHROPIC_CONFIG_DIR="$DIR" ant "$@"; }

install_ant() {
  local v="${1:-$VERSION_DEF}" arch t base
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) echo "✖ unsupported architecture" >&2; exit 1 ;; esac
  if command -v ant >/dev/null && [[ "$(ant --version 2>/dev/null)" == *"$v"* ]]; then echo "  same    ant $v"; return; fi
  t="$(mktemp -d)"; trap 'rm -rf "$t"' RETURN
  base="https://github.com/anthropics/anthropic-cli/releases/download/v$v"
  curl -fsSL -o "$t/ant.tgz" "$base/ant_${v}_linux_${arch}.tar.gz"
  curl -fsSL -o "$t/sums.txt" "$base/ant_${v}_checksums.txt"
  # Integrity: the tarball must match the checksum published in the same release.
  ( cd "$t" && grep " ant_${v}_linux_${arch}.tar.gz\$" sums.txt | sed "s# ant_${v}_linux_${arch}.tar.gz\$# ant.tgz#" | sha256sum -c --quiet ) \
    || { echo "✖ the SHA-256 checksum of ant does not match; not installing" >&2; exit 1; }
  tar -xzf "$t/ant.tgz" -C "$t" ant
  install -D -m 755 "$t/ant" "$HOME/.local/bin/ant"
  echo "  done    ant $("$HOME/.local/bin/ant" --version 2>/dev/null) in ~/.local/bin (SHA-256 verified)"
}

case "${1:-status}" in
  install) shift; install_ant "$@" ;;
  login)
    mkdir -p "$DIR" && chmod 700 "$DIR"
    if [[ -z "${BROWSER:-}" ]] && command -v wslview >/dev/null; then export BROWSER=wslview; fi
    echo "Pick the Claude Console organization and workspace that will pay for the copilot."
    echo "If the browser does not open, run: ws-copilot login --no-browser (and paste the code here)."
    shift; A auth login "$@" ;;
  status) A auth status ;;
  test)
    t0=$(date +%s%N)
    r="$(printf '{"model":"claude-haiku-5-5","max_tokens":10,"messages":[{"role":"user","content":"Reply only: ok"}]}' \
         | A messages create --format json 2>&1)" || { echo "✖ $r" >&2; exit 1; }
    echo "  reply: $(jq -r '.content[0].text' <<<"$r") · $(( ($(date +%s%N) - t0) / 1000000 )) ms · tokens: $(jq -c '.usage | {input_tokens, output_tokens}' <<<"$r")" ;;
  logout) A auth logout ;;
  *) sed -n '8,13p' "$0"; exit 2 ;;
esac
