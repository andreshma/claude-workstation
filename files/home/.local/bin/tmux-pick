#!/usr/bin/env bash
#
# tmux-pick — salta a una pestaña escribiendo parte de su nombre (fzf), con vista previa.
# Orden: primero las que esperan tu aprobación o tienen error (⚠), luego las que tienen
# alerta (!), luego las inactivas (⏳) y al final por actividad más reciente.
# Muestra número, nombre, estado de Claude y contexto. Lo abren Alt+s, Ctrl+b f y el menú.
set -uo pipefail
TAB=$'\t'
fmt="#{session_name}:#{window_index}${TAB}#{window_index}${TAB}#{window_name}${TAB}#{?#{@cs},#{@cs},-}"
fmt+="${TAB}#{?#{@cctx},#{@cctx}%,}${TAB}#{window_bell_flag}${TAB}#{@cstall}${TAB}#{@cmain}${TAB}#{window_activity}"

list="$(tmux list-windows -a -F "$fmt" | awk -F "$TAB" -v OFS="$TAB" '{
    p = 3; m = " "
    if ($8 == "te necesita" || $8 == "te toca" || $8 == "error API") { p = 0; m = "⚠" }
    else if ($6 == 1) { p = 1; m = "!" }
    else if ($7 == 1) { p = 2; m = "⏳" }
    print p, $9, $1, sprintf("%s %3s  %-30s %-16s %5s", m, $2, substr($3, 1, 30), substr($4, 1, 16), $5)
  }' | sort -t "$TAB" -k1,1n -k2,2nr | cut -f3-)"

sel="$(fzf --reverse --delimiter="$TAB" --with-nth=2 --prompt='pestaña> ' \
  --header='Escribe parte del nombre · Enter: ir · Esc: cancelar' \
  --preview 'tmux capture-pane -ep -t {1} | tail -n 60' --preview-window='right,55%' <<<"$list")" || exit 0
t="${sel%%"$TAB"*}"
tmux switch-client -t "${t%%:*}" \; select-window -t "$t"
