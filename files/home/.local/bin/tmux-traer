#!/usr/bin/env bash
#
# tmux-traer — abre en tmux las conversaciones recientes de Claude que no tienen pestaña, organizadas en una
# sesión tmux por grupo (las etiquetas de ~/.config/tmux-claude/roots.txt: repos, code, downloads…;
# lo que no cae en ninguna va a «otros»).
#
# Uso:
#   tmux-traer                 muestra la lista (últimos 7 días) y pregunta antes de abrir
#   tmux-traer --dias 14       otra ventana de tiempo
#   tmux-traer --iniciar       arranca Claude en cada pestaña (por defecto la deja lista: escribe
#                              `claude --resume <id>` y espera tu Enter, para no levantar 20 Claude a la vez)
#   tmux-traer --reorganizar   además mueve las pestañas que ya tienes en «dev» a la sesión de su grupo
#   tmux-traer --dry-run       solo muestra qué haría
#   tmux-traer --windows       trae las del Claude de WINDOWS (C:\Users\…\.claude): copia cada conversación a WSL
#                              (el original no se toca) y la abre aquí. Con muchas, eliges con fzf (Tab marca).
#   tmux-traer --windows --solo-importar   copia todas a WSL sin abrir pestañas: quedan en `claude -r` de cada carpeta
#   --max N                    máximo de pestañas a abrir sin preguntar una por una (por defecto 15)
# Navegar: Alt+↑/↓ cambia de grupo, Ctrl+b S lista los grupos con sus pestañas, Alt+1…9 dentro del grupo.
set -uo pipefail
conf="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-claude/roots.txt"
PROY="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
TAB=$'\t'
dias=7 iniciar=0 reorg=0 seco=0 win=0 solo_imp=0 max=15
while (( $# )); do
  case "$1" in
    --dias) dias="${2:?número de días}"; shift 2 ;;
    --iniciar) iniciar=1; shift ;;
    --reorganizar) reorg=1; shift ;;
    --dry-run) seco=1; shift ;;
    --windows) win=1; shift ;;
    --solo-importar) solo_imp=1; shift ;;
    --max) max="${2:?número}"; shift 2 ;;
    *) sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
  esac
done
command -v tmux >/dev/null && tmux list-sessions >/dev/null 2>&1 || { echo "✖ tmux no está corriendo"; exit 1; }

#######################################
# Grupo de una carpeta: la etiqueta de la raíz de roots.txt que la contiene (la más larga gana).
#######################################
grupo_de() {
  local d="$1" label root mejor="" largo=0
  [[ -f "$conf" ]] || { echo otros; return; }
  while IFS='|' read -r label _ root; do
    [[ -z "$label" || "$label" == \#* ]] && continue
    root="${root/#\~/$HOME}"
    if [[ "$d" == "$root" || "$d" == "$root"/* ]] && (( ${#root} > largo )); then mejor="$label"; largo=${#root}; fi
  done < "$conf"
  echo "${mejor:-otros}"
}
nombre_de() {   # repo o repo@rama para worktrees <repo>.wt/<rama>
  local d="$1"
  if [[ "$d" == *.wt/* ]]; then local r="${d%%.wt/*}"; echo "$(basename "$r")@$(basename "$d")"; else basename "$d"; fi
}

# Carpetas que ya tienen pestaña (en cualquier sesión)
declare -A abierta=()
while IFS= read -r d; do [[ -n "$d" ]] && abierta["$d"]=1; done < <(tmux list-panes -a -F '#{pane_current_path}' 2>/dev/null)

# Conversaciones recientes: la más reciente por carpeta de proyecto (la carpeta real sale del registro, campo cwd).
win_home() {
  local p=""; command -v wslvar >/dev/null && p="$(wslvar USERPROFILE 2>/dev/null || true)"
  [[ -n "$p" ]] || p="$( (cd /mnt/c 2>/dev/null && cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null) | tr -d '\r')"
  [[ -n "$p" ]] && wslpath -u "$p" 2>/dev/null
}
enc() { sed 's#[^A-Za-z0-9]#-#g' <<<"$1"; }   # nombre de carpeta de proyecto, como lo hace Claude
ORIG="$PROY"
if (( win )); then
  ORIG="$(win_home)/.claude/projects"; [[ -d "$ORIG" ]] || { echo "✖ No encuentro $ORIG"; exit 1; }
fi
declare -A conv=() fecha=() archivo=()
for pd in "$ORIG"/*/; do
  f="$(find "$pd" -maxdepth 1 -name '*.jsonl' -mtime "-$dias" -printf '%T@ %p\n' 2>/dev/null | sort -rn | sed -n 1p | cut -d' ' -f2-)"
  [[ -n "$f" ]] || continue
  cwd="$(tail -n 80 "$f" 2>/dev/null | jq -r 'select(.cwd != null) | .cwd' 2>/dev/null | tail -1)"
  [[ -n "$cwd" ]] || continue
  if (( win )); then
    [[ "$cwd" =~ ^[A-Za-z]:\\ ]] || continue          # solo rutas de Windows (C:\…)
    cwd="$(wslpath -u "$cwd" 2>/dev/null)" || continue
  fi
  [[ -d "$cwd" ]] || continue
  m="$(stat -c %Y "$f")"
  if [[ -z "${fecha[$cwd]:-}" ]] || (( m > ${fecha[$cwd]} )); then fecha["$cwd"]="$m"; conv["$cwd"]="$(basename "$f" .jsonl)"; archivo["$cwd"]="$f"; fi
done

#######################################
# Copia una conversación del Claude de Windows a WSL (y su carpeta de subagentes); no sobrescribe.
#######################################
importar() {
  local f="$1" cwd="$2" d id; id="$(basename "$f" .jsonl)"; d="$PROY/$(enc "$cwd")"
  mkdir -p "$d"
  [[ -e "$d/$id.jsonl" ]] || cp -p "$f" "$d/$id.jsonl"
  [[ -d "${f%.jsonl}" && ! -e "$d/$id" ]] && cp -rp "${f%.jsonl}" "$d/$id"
  return 0
}
if (( win && solo_imp )); then
  n=0
  for pd in "$ORIG"/*/; do
    while IFS= read -r -d '' f; do
      cwd="$(tail -n 80 "$f" 2>/dev/null | jq -r 'select(.cwd != null) | .cwd' 2>/dev/null | tail -1)"
      [[ "$cwd" =~ ^[A-Za-z]:\\ ]] || continue
      cwd="$(wslpath -u "$cwd" 2>/dev/null)" || continue
      [[ -d "$cwd" ]] || continue                     # carpeta que ya no existe: no sirve en WSL
      importar "$f" "$cwd"; n=$((n + 1))
    done < <(find "$pd" -maxdepth 1 -name '*.jsonl' -mtime "-$dias" -print0 2>/dev/null)
  done
  echo "✔ $n conversaciones del Claude de Windows copiadas a WSL (las ya copiadas no se tocan)."
  echo "  En cada pestaña: claude -r para elegir una. El original en Windows no cambió."
  exit 0
fi

lista=()
for cwd in "${!conv[@]}"; do
  [[ -n "${abierta[$cwd]:-}" ]] && continue
  [[ "$cwd" == "$HOME" ]] && continue
  lista+=("$(grupo_de "$cwd")${TAB}$(nombre_de "$cwd")${TAB}${cwd}${TAB}${conv[$cwd]}${TAB}${fecha[$cwd]}")
done
mapfile -t lista < <(printf '%s\n' "${lista[@]}" | sed '/^$/d' | sort -t "$TAB" -k1,1 -k2,2)

if (( ${#lista[@]} == 0 )) && (( ! reorg )); then echo "✔ Todas las conversaciones de los últimos $dias días ya tienen pestaña."; exit 0; fi
if (( ${#lista[@]} )); then
  echo "Conversaciones de los últimos $dias días sin pestaña (${#lista[@]}):"
  g_ant=""
  for l in "${lista[@]}"; do
    IFS="$TAB" read -r g n d id m <<<"$l"
    [[ "$g" != "$g_ant" ]] && { echo "  [$g]"; g_ant="$g"; }
    printf '    %-34s %s\n' "$n" "$(date -d "@$m" '+%d/%m %H:%M')"
  done
fi
(( seco )) && { (( reorg )) && echo "(--reorganizar movería las pestañas de «dev» a su grupo)"; exit 0; }
if (( ${#lista[@]} > max )) && command -v fzf >/dev/null; then
  echo "Son ${#lista[@]}: elige cuáles abrir (Tab marca, Ctrl+A todas, Enter abre)."
  mapfile -t lista < <(printf '%s\n' "${lista[@]}" | sort -t "$TAB" -k5,5nr \
    | fzf --multi --delimiter="$TAB" --with-nth=1,2 --bind 'ctrl-a:select-all' \
          --header 'Tab marca · Ctrl+A todas · Enter abre' --prompt 'abrir> ' \
          --preview 'echo {3}; echo; date -d @{5} "+última conversación: %d/%m/%Y %H:%M"')
  (( ${#lista[@]} )) || { echo "Nada cambió."; exit 0; }
fi
read -rp "¿Abrirlas $( (( iniciar )) && echo "y arrancar Claude en cada una" || echo "(listas para retomar con Enter)")? [s/N] " r
[[ "$r" =~ ^[sS]$ ]] || { echo "Nada cambió."; exit 0; }

asegura_sesion() {   # crea la sesión del grupo si no existe, con una pestaña inicial que se reemplaza
  tmux has-session -t "=$1" 2>/dev/null && return 0
  tmux new-session -d -s "$1" -n "·$1" -c "$HOME"
}
for l in "${lista[@]}"; do
  IFS="$TAB" read -r g n d id _ <<<"$l"
  asegura_sesion "$g"
  (( win )) && importar "${archivo[$d]}" "$d"
  w="$(tmux new-window -d -P -F '#{window_id}' -t "=$g:" -n "$n" -c "$d")"
  if (( iniciar )); then tmux send-keys -t "$w" "claude --resume $id" Enter
  else tmux send-keys -t "$w" "claude --resume $id"; fi   # lista: Enter para retomar
  echo "  abierta  [$g] $n"
done

if (( reorg )); then
  while IFS="$TAB" read -r wid d; do
    g="$(grupo_de "$d")"; asegura_sesion "$g"
    tmux move-window -d -s "$wid" -t "=$g:" 2>/dev/null && echo "  movida   [$g] $(tmux display -p -t "$wid" '#W')"
  done < <(tmux list-windows -t '=dev' -F "#{window_id}${TAB}#{pane_current_path}" 2>/dev/null | awk -F "$TAB" -v h="$HOME" '$2 != h')
fi

# Quita la pestaña inicial «·grupo» de las sesiones nuevas si ya tienen otras
for s in $(tmux list-sessions -F '#S'); do
  w="$(tmux list-windows -t "=$s" -F '#{window_id} #W' | awk -v n="·$s" '$2 == n { print $1 }')"
  [[ -n "$w" ]] && (( $(tmux list-windows -t "=$s" | wc -l) > 1 )) && tmux kill-window -t "$w"
done
echo "✔ Listo. Grupos: $(tmux list-sessions -F '#S(#{session_windows})' | tr '\n' ' ')"
echo "  Alt+↑/↓ cambia de grupo · Ctrl+b S lista grupos y pestañas · Alt+1…9 dentro del grupo"
