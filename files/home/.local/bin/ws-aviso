#!/usr/bin/env bash
#
# ws-aviso — aviso de Windows (toast) y, si se pide, también por Telegram. Al hacer clic en el aviso, Windows
# Terminal pasa al frente y tmux va a la pestaña del panel (protocolo ws-claude://foco/N del parche 31).
#
# Uso: ws-aviso [--panel %N] [--telegram] [--forzar] "título" "texto"
#   --panel     panel de tmux al que lleva el clic
#   --telegram  además manda el aviso por Telegram (ws-telegram notificar), ya redactado
#   --forzar    avisa aunque los avisos de Windows estén apagados o estés en modo enfoque
# Título y texto se redactan (ws-redactar) y viajan a PowerShell en base64 dentro de -EncodedCommand: nunca se
# interpretan como código. Registro sin el texto: ~/.local/share/ws-telemetria/avisos/AAAA-MM-DD.jsonl.
# WS_AVISO_LOG=archivo: solo registra (pruebas).
set -uo pipefail
panel="" tg=0 forzar=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --panel) panel="${2#%}"; shift 2 ;;
    --telegram) tg=1; shift ;;
    --forzar) forzar=1; shift ;;
    *) break ;;
  esac
done
red() { ws-redactar <<<"$1" 2>/dev/null || printf '%s' "$1"; }
titulo="$(red "${1:-Estación}")"; texto="$(red "${2:-}")"
[[ "$panel" =~ ^[0-9]+$ ]] || panel=""
d="$HOME/.local/share/ws-telemetria/avisos"; mkdir -p "$d" && chmod 700 "$d"
jq -nc --arg t "$titulo" --arg p "$panel" --argjson tg "$tg" '{ts: (now | todate), titulo: $t, panel: $p, telegram: ($tg == 1)}' >> "$d/$(date +%F).jsonl" 2>/dev/null

if [[ -n "${WS_AVISO_LOG:-}" ]]; then printf '%s\t%s\t%s\t%s\n' "$titulo" "${texto//$'\n'/ ⏎ }" "$panel" "$tg" >> "$WS_AVISO_LOG"; exit 0; fi

if (( tg )) && command -v ws-telegram >/dev/null; then ws-telegram notificar "$titulo"$'\n'"$texto" >/dev/null 2>&1 & fi

if (( !forzar )); then
  [[ "$(tmux show -gqv @cnotify 2>/dev/null)" == off || -n "$(tmux show -gqv @enf_fin 2>/dev/null)" ]] && exit 0
fi
ps="$(command -v powershell.exe || echo /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe)"
[[ -x "$ps" ]] || exit 0
b64() { printf '%s' "$1" | head -c 900 | base64 -w0; }
script="$(cat <<'PS'
$d = { param($b) [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b)) }
$t = & $d $args[0]; $m = & $d $args[1]; $l = $args[2]
[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > $null
[Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom.XmlDocument, ContentType = WindowsRuntime] > $null
$e = [Security.SecurityElement]; $a = ""
if ($l -match '^[0-9]+$') { $a = " activationType='protocol' launch='ws-claude://foco/$l'" }
$x = New-Object Windows.Data.Xml.Dom.XmlDocument
$x.LoadXml("<toast$a><visual><binding template='ToastGeneric'><text>" + $e::Escape($t) + "</text><text>" + $e::Escape($m) + "</text></binding></visual></toast>")
$app = '{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\WindowsPowerShell\v1.0\powershell.exe'
[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier($app).Show([Windows.UI.Notifications.ToastNotification]::new($x))
PS
)"
enc="$(printf '& { %s } %s %s %s' "$script" "'$(b64 "$titulo")'" "'$(b64 "$texto")'" "'$panel'" | iconv -t UTF-16LE | base64 -w0)"
timeout 20 "$ps" -NoProfile -NonInteractive -EncodedCommand "$enc" >/dev/null 2>&1 &
exit 0
