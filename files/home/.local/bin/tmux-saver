#!/usr/bin/env bash
#
# tmux-saver — screensaver (tmux lock-command). It starts after a few minutes without touching the terminal and
# any key dismisses it; your tabs and your Claudes keep working behind it. It does not appear in presentation mode
# or while a permission dialog is open.
#
# The scenes are drawn by tmux-art (animated ASCII art, all original designs); this script picks which one and
# saves your preferences. The shading-engine scenes need python3-numpy; without it the others are shown.
#
# Usage: tmux-saver                     scene from your preferences (random by default)
#        tmux-saver --scene <name>      a specific scene (tmux-art --all lists them) or «gallery»
#                                        gallery: your images and animated GIFs turned into characters with chafa
#                                          (sudo apt install chafa). Put them in ~/.config/tmux-claude/gallery
#                                          (or point WS_GALLERY at another folder). WS_GALLERY_SEC = seconds per
#                                          image (25); WS_GALLERY_SYMBOLS=ascii to use only letters and signs.
#        tmux-saver --next-scene   switches the saved scene to the next one (used by the menu)
#        tmux-saver --pin <name>       saves that scene («random» = a different one each time)
#        tmux-saver --toggle             turns the screensaver on / off (used by the menu)
#        tmux-saver --test <scene> <n>   draws n frames without waiting for keys (tests)
#        tmux-saver --saved-scene        prints the saved scene (used by tmux-theme)
set -uo pipefail
export LC_ALL=C.UTF-8
cfg="$HOME/.config/tmux-claude/appearance"
SCENES=(random gallery ocean boreal clouds planet blackhole flight pond fire lava tunnel fractal donut peaks aurora snowfall sailboat fish pipes battle campfire cherry rain galaxy nebula hyperspace)
# get <key> [old key] — the preference; the Spanish key of earlier versions is read when the new one is missing.
get() { local v; v="$(sed -n "s/^$1=//p" "$cfg" 2>/dev/null | tail -1)"; [[ -n "$v" || -z "${2:-}" ]] || v="$(sed -n "s/^$2=//p" "$cfg" 2>/dev/null | tail -1)"; echo "$v"; }
# scene_name <name> — scene names saved or typed with the Spanish names of earlier versions.
scene_name() {
  case "$1" in
    aleatoria) echo random ;; galeria) echo gallery ;; oceano) echo ocean ;; nubes) echo clouds ;; planeta) echo planet ;;
    agujero) echo blackhole ;; vuelo) echo flight ;; estanque) echo pond ;; fuego) echo fire ;; tunel) echo tunnel ;;
    dona) echo donut ;; cumbres) echo peaks ;; nevada) echo snowfall ;; velero) echo sailboat ;; peces) echo fish ;;
    tuberias) echo pipes ;; batalla) echo battle ;; fogata) echo campfire ;; cerezo) echo cherry ;; lluvia) echo rain ;;
    galaxia) echo galaxy ;; nebulosa) echo nebula ;; hiperespacio) echo hyperspace ;; *) echo "$1" ;;
  esac
}
saved_scene() { scene_name "$(get scene escena)"; }
put() { mkdir -p "${cfg%/*}"; touch "$cfg"; if grep -q "^$1=" "$cfg"; then sed -i "s/^$1=.*/$1=$2/" "$cfg"; else echo "$1=$2" >> "$cfg"; fi; }

case "${1:-}" in
  --toggle)
    if [[ "$(get saver protector)" == off ]]; then put saver on; else put saver off; fi
    "$HOME/.local/bin/tmux-theme" apply
    tmux display "Screensaver: $([[ "$(get saver protector)" == off ]] && echo off || echo on)"
    exit 0 ;;
  --saved-scene) saved_scene; exit 0 ;;
  --pin)
    e="$(scene_name "${2:-random}")"
    [[ " ${SCENES[*]} " == *" $e "* ]] || { echo "tmux-saver: unknown scene «$e» (available: ${SCENES[*]})" >&2; exit 2; }
    put scene "$e"
    if [[ "$e" == random ]]; then tmux set -gu @saver_scene 2>/dev/null; else tmux set -g @saver_scene "$e" 2>/dev/null; fi
    echo "Screensaver scene: $e"; exit 0 ;;
  --next-scene)
    cur="$(saved_scene)"; cur="${cur:-random}"; next=random
    for i in "${!SCENES[@]}"; do [[ "${SCENES[$i]}" == "$cur" ]] && next="${SCENES[$(( (i + 1) % ${#SCENES[@]} ))]}"; done
    put scene "$next"; tmux set -g @saver_scene "$next"; tmux display "Screensaver scene: $next"; exit 0 ;;
esac

TEST=0; FRAMES=0; scene=""
case "${1:-}" in
  --scene) scene="$(scene_name "${2:-random}")" ;;
  --test)   TEST=1; scene="$(scene_name "${2:-aurora}")"; FRAMES="${3:-5}" ;;
  *)
    [[ "$(tmux show -gqv @present 2>/dev/null)" == on ]] && exit 0
    # Only an open permission dialog holds the screensaver back. «your turn» (Claude ended with a question) does
    # not: it is the normal state of almost any idle tab, and with it the screensaver never appeared.
    tmux list-windows -a -F '#{@cmain}' 2>/dev/null | grep -qx 'needs you' && exit 0
    scene="$(saved_scene)" ;;
esac
scene="${scene:-random}"

# ── Gallery: images and GIFs with chafa ───────────────────────────────────────
GAL="${WS_GALLERY:-$HOME/.config/tmux-claude/gallery}"
gallery_files() {
  command -v chafa >/dev/null || return 0
  find -L "$GAL" -maxdepth 2 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.gif' -o -iname '*.webp' \) 2>/dev/null
}
gallery() {
  local imgs f pid n=0 secs="${WS_GALLERY_SEC:-25}" symbols="${WS_GALLERY_SYMBOLS:-}" c r
  mapfile -t imgs < <(gallery_files | shuf)
  (( ${#imgs[@]} )) || return 1
  c="${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}"; r="${LINES:-$(tput lines 2>/dev/null || echo 30)}"
  (( TEST )) && secs=0
  printf '\033[?25l'; trap 'printf "\033[0m\033[2J\033[H\033[?25h"' EXIT
  while :; do
    for f in "${imgs[@]}"; do
      printf '\033[0m\033[2J\033[H'
      chafa --format symbols ${symbols:+--symbols "$symbols"} --size "${c}x$(( r - 1 ))" --duration "$secs" -- "$f" </dev/null 2>/dev/null &
      pid=$!
      if (( TEST )); then wait "$pid"; n=$(( n + 1 )); (( n >= FRAMES )) && exit 0; continue; fi
      if read -rsn1 -t "$secs"; then kill "$pid" 2>/dev/null; exit 0; fi
      kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
    done
  done
}
if [[ "$scene" == gallery ]]; then gallery || scene=random; fi   # no chafa or no images: an art scene
ART="$HOME/.local/bin/tmux-art"
# A saved scene that no longer exists (the pixel art ones were retired) falls back to random.
[[ " ${SCENES[*]} " == *" $scene "* ]] || scene=random
if [[ "$scene" == random ]]; then
  # tmux-art --list only names the ones it can draw (the shading-engine ones need numpy).
  mapfile -t pool < <("$ART" --list 2>/dev/null); (( ${#pool[@]} )) || pool=(aurora)
  [[ -n "$(gallery_files | head -1)" ]] && pool+=(gallery)   # with images and chafa, the gallery joins the pool too
  scene="${pool[RANDOM % ${#pool[@]}]}"
fi
[[ "$scene" == gallery ]] && { gallery || scene=aurora; }
if (( TEST )); then exec "$ART" "$scene" --test "$FRAMES"; else exec "$ART" "$scene"; fi
