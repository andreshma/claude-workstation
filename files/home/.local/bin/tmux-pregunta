#!/usr/bin/env bash
#
# tmux-pregunta — pregunta rápida a Claude en una flotante, sin ensuciar el contexto de la pestaña. Ctrl+b ?
#   Escribe la pregunta y Enter. Termina la línea con «+p» para incluir las últimas 60 líneas del panel (redactadas).
#   La respuesta se muestra en pantalla; c la copia, Enter o q cierra.
# Modelo: Haiku por defecto (WS_PREGUNTA_MODELO=sonnet|opus para otro). Sin herramientas y sin guardar sesión:
# no puede tocar archivos ni ejecutar nada. Cada pregunta queda contada (sin texto) en la telemetría.
# Uso: tmux-pregunta [panel]
set -uo pipefail
p="${1:-}"
modelo="${WS_PREGUNTA_MODELO:-haiku}"
command -v claude >/dev/null || { echo "No encuentro claude en PATH."; sleep 2; exit 1; }
printf '\e[1mPregunta rápida a Claude (%s)\e[0m · termina con +p para incluir la pantalla del panel · Esc/Ctrl+C sale\n\n' "$modelo"
read -e -r -p '› ' q || exit 0
[[ -n "${q// /}" ]] || exit 0
ctx=""
if [[ "$q" == *+p && -n "$p" ]]; then
  q="${q%+p}"
  ctx="$(tmux capture-pane -p -J -t "$p" -S -60 2>/dev/null | sed -e 's/[[:space:]]*$//' | ws-redactar)"
fi
printf '\n\e[2mpensando…\e[0m\r'
r="$( { [[ -n "$ctx" ]] && printf 'Contexto (pantalla de mi terminal):\n```\n%s\n```\n\n' "$ctx"; printf '%s\n' "$q"; } \
      | env -u TMUX_PANE -u TMUX timeout 120 claude -p --model "$modelo" --tools "" --no-session-persistence \
          --append-system-prompt "Responde en español, breve y directo; si es un comando, dalo en un bloque de código." 2>&1)" \
  || r="✖ No hubo respuesta (${r:0:200})"
d="$HOME/.local/share/ws-telemetria/preguntas"; mkdir -p "$d" && chmod 700 "$d"
jq -nc --arg m "$modelo" --argjson c "${#q}" --argjson x "$([[ -n "$ctx" ]] && echo true || echo false)" \
  '{ts: (now | todate), modelo: $m, chars: $c, con_pantalla: $x}' >> "$d/$(date +%F).jsonl" 2>/dev/null
clear; printf '\e[1m› %s\e[0m\n\n%s\n\n\e[2mc copia · Enter o q cierra\e[0m' "$q" "$r"
read -rsn1 k
if [[ "$k" == c ]]; then printf '%s' "$r" | ws-copiar 2>/dev/null || printf '%s' "$r" | tmux load-buffer -w -; fi
