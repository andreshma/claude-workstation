#!/usr/bin/env bash
#
# tmux-flot-run — corre el comando de una ventana flotante dentro de su propia sesión tmux
# (servidor aparte "-L flot"), para que la flotante se use como una pestaña normal:
# rueda = scroll, arrastrar = seleccionar y copiar al portapapeles de Windows, Ctrl+b [ y / =
# buscar, Shift+clic = abrir URL. Los menús lo anteponen al comando de cada display-popup.
#
# Uso (dentro de display-popup): tmux-flot-run [--persistente] comando [args...]
#   --persistente  al cerrar con Ctrl+b d la sesión sigue viva y la próxima vez se retoma
#                  (sin la opción, cada apertura arranca limpia para mostrar datos frescos)
# Los scripts que corren adentro siguen hablando con el tmux de afuera (TMUX externo), así que
# pueden cambiar de pestaña, leer estados o abrir ventanas como antes.
set -uo pipefail
persistente=0
if [[ "${1:-}" == --persistente ]]; then persistente=1; shift; fi
(( $# )) || { echo "uso: tmux-flot-run [--persistente] comando [args...]" >&2; exit 2; }

externo="${TMUX:-}"
pane="${TMUX_PANE:-$(tmux display -p '#{pane_id}' 2>/dev/null || true)}"
conf="$HOME/.config/tmux-claude/flot.conf"
nombre="f$(printf '%s' "$*" | md5sum | cut -c1-8)"
cmd="$(printf '%q ' "$@")"
T=(tmux -L flot -f "$conf")

(( persistente )) || "${T[@]}" kill-session -t "$nombre" 2>/dev/null
# env -u TMUX: tmux no permite anidar sesiones si ve TMUX. Adentro se restaura el TMUX externo.
exec env -u TMUX "${T[@]}" new-session -A -s "$nombre" -c "$PWD" \
  "env TMUX='$externo' TMUX_PANE='$pane' WS_FLOT_SESION='$nombre' $cmd"
