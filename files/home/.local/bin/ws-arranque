#!/usr/bin/env bash
#
# ws-arranque — measures what makes a new terminal (interactive bash) slow to open and shows
# the 12 lines of your startup files that take the longest. Read-only; changes nothing.
# Usage: ws-arranque
set -uo pipefail
log="$(mktemp)"; trap 'rm -f "$log"' EXIT
t0=$(date +%s%N)
PS4='+ ${EPOCHREALTIME} ${BASH_SOURCE[0]##*/}:${LINENO} ' bash -ixc exit 2>"$log" >/dev/null </dev/null
echo "Total startup: $(( ($(date +%s%N) - t0) / 1000000 )) ms"
echo "Slowest lines (time until the next line):"
awk '/^\++ [0-9]+\.[0-9]+ /{ if (prev != "") { d = $2 - pt; if (d > 0.005) printf "%7.0f ms  %s\n", d * 1000, prev } pt = $2; prev = $3 }' "$log" \
  | sort -rn | head -12
