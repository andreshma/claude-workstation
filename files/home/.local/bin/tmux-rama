#!/usr/bin/env bash
#
# tmux-rama — estado de la rama de cada pestaña en la barra: CI (✔ verde · ✖ rojo · ● corriendo), PR (#12, ✓
# aprobado, ✎ cambios pedidos, 📝 borrador) y ticket (ABC-123). GitHub (gh) y Azure DevOps (az repos/pipelines).
# Lo corre tmux-fondo cada minuto; consulta cada repo+rama como máximo cada 3 min (caché) y con tiempo límite.
# Uso: tmux-rama --actualizar      todas las pestañas → opción @crama de cada una (la barra la muestra)
#      tmux set -g @rama_barra off  la apaga (on o vacío: encendida)
#      tmux-rama <carpeta>         imprime el estado de esa carpeta (pruebas y diagnóstico)
# Sin gh/az o sin sesión: no muestra nada (nunca bloquea la barra).
set -uo pipefail
CACHE="${XDG_RUNTIME_DIR:-/tmp}/tmux-rama-$(id -u)"; mkdir -p "$CACHE" 2>/dev/null && chmod 700 "$CACHE"
TTL="${WS_RAMA_TTL:-180}"
g() { GIT_OPTIONAL_LOCKS=0 timeout 2 git -C "$dir" "$@" 2>/dev/null; }

estado() {   # carpeta → texto corto para la barra
  local dir="$1" b url c k ci="" pr="" t=""
  b="$(g branch --show-current)" || return 0
  [[ -n "$b" ]] || return 0
  [[ "$b" =~ ([A-Z][A-Z0-9]+-[0-9]+) ]] && t="${BASH_REMATCH[1]}"
  url="$(g remote get-url origin)"
  k="$(printf '%s|%s' "$url" "$b" | md5sum | cut -c1-16)"; c="$CACHE/$k"
  if [[ -f "$c" ]] && (( $(date +%s) - $(stat -c %Y "$c") < TTL )); then cat "$c"; return 0; fi
  if [[ "$url" == *github.com* ]] && command -v gh >/dev/null; then
    local j; j="$(cd "$dir" && timeout 8 gh pr view "$b" --json number,isDraft,reviewDecision,statusCheckRollup 2>/dev/null)"
    if [[ -n "$j" ]]; then
      pr="$(jq -r '"#\(.number)" + (if .isDraft then "📝" elif .reviewDecision == "APPROVED" then "✓" elif .reviewDecision == "CHANGES_REQUESTED" then "✎" else "" end)' <<<"$j")"
      ci="$(jq -r '[.statusCheckRollup[]? | (.conclusion // .state // .status | ascii_upcase)] as $s
        | if ($s | length) == 0 then "" elif any($s[]; test("FAIL|ERROR|CANCEL|TIMED")) then "✖" elif any($s[]; test("PENDING|QUEUED|IN_PROGRESS|EXPECTED")) then "●" else "✔" end' <<<"$j")"
    else
      ci="$(cd "$dir" && timeout 8 gh run list --branch "$b" --limit 1 --json status,conclusion \
            -q '.[0] | if . == null then "" elif .status != "completed" then "●" elif .conclusion == "success" then "✔" else "✖" end' 2>/dev/null)"
    fi
  elif [[ "$url" == *dev.azure.com* || "$url" == *visualstudio.com* ]] && command -v az >/dev/null; then
    local id
    id="$(timeout 10 az repos pr list --source-branch "refs/heads/$b" --status active --detect true \
          --query '[0].[pullRequestId, isDraft, join(`,`, reviewers[].to_string(vote))]' -o tsv 2>/dev/null)"
    if [[ -n "$id" ]]; then
      read -r n dr votos <<<"$id"; pr="#$n"
      [[ "$dr" == True ]] && pr+="📝"; [[ ",$votos," == *",10,"* ]] && pr+="✓"; [[ ",$votos," == *",-5,"* || ",$votos," == *",-10,"* ]] && pr+="✎"
    fi
    ci="$(timeout 10 az pipelines runs list --branch "refs/heads/$b" --top 1 --detect true --query '[0].[status,result]' -o tsv 2>/dev/null \
          | awk '{ if ($1 != "completed") print "●"; else if ($2 == "succeeded") print "✔"; else if ($2 != "") print "✖" }')"
  fi
  printf '%s' "$(printf '%s %s %s' "${ci:+CI$ci}" "$pr" "$t" | xargs)" > "$c"; cat "$c"
}

if [[ "${1:-}" == --actualizar ]]; then
  # En paralelo: con muchas pestañas sin caché, una tras otra pasaría del minuto.
  while IFS=$'\t' read -r w d; do
    ( v="$(estado "$d")"
      if [[ -n "$v" ]]; then tmux set -w -t "$w" @crama "$v"; else tmux set -wu -t "$w" @crama; fi ) &
  done < <(tmux list-windows -a -F $'#{window_id}\t#{pane_current_path}' | sort -u -k1,1)
  wait; exit 0
fi
estado "${1:-$PWD}"; echo
