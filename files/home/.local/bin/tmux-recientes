#!/usr/bin/env python3
"""tmux-recientes — your recent work with Claude, from ALL projects, in one list: open or not, go straight to it.
Not in the menu and without a shortcut (Ctrl+b j was freed): run it by name.

Each row: how long ago, project, branch, whether it has an open tab (● group:tab) and your last request (redacted).
On the right, a preview: your latest requests and the last thing Claude answered.
  Enter   if it has a tab, goes to it; otherwise opens one in its group and resumes THAT conversation (claude --resume <id>)
  Ctrl+Y  copies the command to resume it · Ctrl+R refreshes · type to filter by project, branch or text
Usage: tmux-recientes [--dias 7]   ·   tmux-recientes --lista [--dias N]   ·   tmux-recientes --ver <file.jsonl>
Reads the header and the end of each conversation (not the whole file) with a per-file cache: it is fast even with
hundreds of conversations.
"""
from __future__ import annotations

import datetime as dt
import json
import os
import re
import shutil
import subprocess  # nosec B404 — tmux, fzf, ws-redactar, ws-copiar with fixed arguments
import sys
import time
from pathlib import Path

HOME = Path.home()
CLAUDE = Path(os.environ.get("WS_TELEMETRIA_CLAUDE", HOME / ".claude"))
CACHE = Path(os.environ.get("XDG_RUNTIME_DIR") or HOME / ".cache") / f"tmux-recientes-{os.getuid()}.json"
BIN = HOME / ".local/bin"
SEP = "\t"


def sh(*a: str, entrada: str | None = None) -> str:
    try:
        return subprocess.run(list(a), input=entrada, capture_output=True, text=True, timeout=20).stdout  # nosec B603
    except (OSError, subprocess.SubprocessError):
        return ""


def texto_de(c) -> str:
    if isinstance(c, str):
        return c
    return " ".join(b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text")


def es_prompt(o: dict) -> bool:
    if o.get("type") != "user" or o.get("isMeta"):
        return False
    t = texto_de((o.get("message") or {}).get("content"))
    return bool(t.strip()) and not t.lstrip().startswith("<")


def resumen(f: Path) -> dict | None:
    """Header (cwd, branch, start) and end (last request, last answer) without reading the whole file."""
    info = {"cwd": "", "rama": "", "pedido": "", "respuesta": ""}
    try:
        with open(f, "rb") as fh:
            for _ in range(40):
                l = fh.readline()
                if not l:
                    break
                try:
                    o = json.loads(l)
                except ValueError:
                    continue
                info["cwd"] = info["cwd"] or o.get("cwd") or ""
                info["rama"] = info["rama"] or o.get("gitBranch") or ""
            ini = max(0, f.stat().st_size - 200_000)
            fh.seek(ini)
            cola = fh.read().decode("utf-8", "replace").splitlines()[1 if ini else 0:]   # the first one may be cut off
    except OSError:
        return None
    for l in reversed(cola):
        try:
            o = json.loads(l)
        except ValueError:
            continue
        info["cwd"] = info["cwd"] or o.get("cwd") or ""
        info["rama"] = o.get("gitBranch") or info["rama"]
        if not info["respuesta"] and o.get("type") == "assistant":
            info["respuesta"] = texto_de((o.get("message") or {}).get("content"))[:600]
        if not info["pedido"] and es_prompt(o):
            info["pedido"] = texto_de(o["message"]["content"])[:300]
        if info["pedido"] and info["respuesta"]:
            break
    return info if info["cwd"] else None


def conversaciones(dias: int) -> list[dict]:
    limite = time.time() - dias * 86400
    try:
        cache = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    nuevas, filas = {}, []
    for f in (CLAUDE / "projects").glob("*/*.jsonl"):
        try:
            st = f.stat()
        except OSError:
            continue
        if st.st_mtime < limite or st.st_size < 200:
            continue
        clave, firma = str(f), f"{st.st_mtime_ns}:{st.st_size}"
        r = cache.get(clave)
        if not r or r.get("firma") != firma:
            r = resumen(f)
            if not r:
                continue
            r["firma"] = firma
        nuevas[clave] = r
        filas.append({**r, "archivo": clave, "id": f.stem, "mtime": st.st_mtime})
    try:
        CACHE.write_text(json.dumps(nuevas)); os.chmod(CACHE, 0o600)
    except OSError:
        pass
    return sorted(filas, key=lambda x: -x["mtime"])


def pestanas() -> dict:
    """folder → «group:index name» of the tab that has it open (and its window id)."""
    out = {}
    for l in sh("tmux", "list-panes", "-a", "-F", "#{pane_current_path}\t#{?session_grouped,#{session_group},#{session_name}}\t#{session_name}\t#{window_index} #{window_name}\t#{window_id}").splitlines():
        p = l.split("\t")
        if len(p) == 5 and p[1] == p[2] and os.path.realpath(p[0]) not in out:
            out[os.path.realpath(p[0])] = (f"{p[1]}:{p[3]}", f"{p[2]}:{p[4]}")
    return out


def hace(t: float) -> str:
    s = int(time.time() - t)
    return f"{s // 60}m" if s < 3600 else (f"{s // 3600}h" if s < 86400 else f"{s // 86400}d")


def redactar(t: str) -> str:
    r = sh(str(BIN / "ws-redactar"), entrada=t)
    return r or t


def lista(dias: int) -> str:
    convs, pest = conversaciones(dias), pestanas()
    textos = redactar("\n".join(re.sub(r"\s+", " ", c["pedido"])[:110] or "—" for c in convs)).splitlines() if convs else []
    lineas = []
    for c, t in zip(convs, textos + [""] * len(convs)):
        ab = pest.get(os.path.realpath(c["cwd"]))
        estado = f"\033[32m● {ab[0][:22]}\033[0m" if ab else "\033[2m○ no tab\033[0m"
        proy = Path(c["cwd"]).name
        accion = f"ir{SEP}{ab[1]}" if ab else f"abrir{SEP}{c['cwd']}"
        lineas.append(f"{accion}{SEP}{c['id']}{SEP}{c['archivo']}{SEP}"
                      f"{hace(c['mtime']):>4}  \033[36m{proy[:22]:<22}\033[0m {c['rama'][:20]:<20} {estado:<34} {t}")
    return "\n".join(lineas)


def ver(archivo: str) -> str:
    pedidos, ultima = [], ""
    for l in open(archivo, encoding="utf-8", errors="replace"):
        try:
            o = json.loads(l)
        except ValueError:
            continue
        if es_prompt(o):
            pedidos.append(texto_de(o["message"]["content"]))
        elif o.get("type") == "assistant":
            t = texto_de((o.get("message") or {}).get("content"))
            ultima = t or ultima
    txt = "Your latest requests:\n" + "\n".join(f"  › {p[:300]}" for p in pedidos[-4:]) + f"\n\nClaude's latest:\n{ultima[-1200:]}"
    return redactar(txt)


def grupo_de(carpeta: str) -> str:
    conf = HOME / ".config/tmux-claude/roots.txt"
    if conf.exists():
        for l in conf.read_text(encoding="utf-8").splitlines():
            p = l.split("|")
            if len(p) == 3 and not l.startswith("#"):
                raiz = p[2].replace("~", str(HOME), 1)
                if carpeta == raiz or carpeta.startswith(raiz.rstrip("/") + "/"):
                    return p[0]
    return sh("tmux", "display", "-p", "#S").strip() or "dev"


def main() -> int:
    a = sys.argv[1:]
    dias = int(a[a.index("--dias") + 1]) if "--dias" in a else 7
    if a and a[0] == "--lista":
        print(lista(dias)); return 0
    if a and a[0] == "--ver":
        print(ver(a[1])); return 0
    if not shutil.which("fzf"):
        print(lista(dias)); input(); return 0
    yo = os.path.abspath(sys.argv[0])
    r = subprocess.run(["fzf", "--ansi", "--delimiter", SEP, "--with-nth", "5", "--no-sort", "--reverse", "--expect", "ctrl-y",  # nosec B603 B607
                        "--prompt", "recent> ", "--preview", f"{yo} --ver {{4}}", "--preview-window", "right,45%,wrap",
                        "--header", f"Work from the last {dias} days · Enter: go (or open and resume) · Ctrl+Y copies the command · Ctrl+R refreshes",
                        "--bind", f"ctrl-r:reload({yo} --lista --dias {dias})"],
                       input=lista(dias), capture_output=True, text=True)
    salida = r.stdout.splitlines()
    if len(salida) < 2:
        return 0
    tecla, campos = salida[0], salida[1].split(SEP)
    accion, destino, sid = campos[0], campos[1], campos[2]
    if tecla == "ctrl-y":
        sh(str(BIN / "ws-copiar"), entrada=f"claude --resume {sid}"); sh("tmux", "display", f"Copied: claude --resume {sid}"); return 0
    if accion == "ir":
        s, w = destino.split(":", 1)
        sh("tmux", "switch-client", "-t", f"={s}"); sh("tmux", "select-window", "-t", w); return 0
    g = grupo_de(destino)
    if subprocess.run(["tmux", "has-session", "-t", f"={g}"], capture_output=True).returncode:  # nosec B603 B607
        sh("tmux", "new-session", "-d", "-s", g, "-c", destino)
        w = sh("tmux", "list-windows", "-t", f"={g}", "-F", "#{window_id}").split()[0]
    else:
        w = sh("tmux", "new-window", "-d", "-P", "-F", "#{window_id}", "-t", f"={g}:", "-c", destino, "-n", Path(destino).name).strip()
    sh("tmux", "send-keys", "-t", w, f"claude --resume {sid}", "Enter")
    sh("tmux", "switch-client", "-t", f"={g}"); sh("tmux", "select-window", "-t", w)
    return 0


if __name__ == "__main__":
    sys.exit(main())
