#!/usr/bin/env bash
#
# tmux-nivel — nivel de protección de Claude POR PESTAÑA (ADR-012). Reinicia Claude en la pestaña con el nivel
# elegido y retoma la conversación (claude -c). Menú → Claude → Protección.
#
#   completo  🔒  sandbox de Claude Code encendido y SIN escapatorias (allowUnsandboxedCommands=false, sin comandos
#                excluidos) + todas las reglas del kit (allow, ask, deny, guard.sh). az, gh, git push, kubectl… quedan
#                DENTRO del sandbox: sin red ni credenciales, casi todos fallarán; para eso está «normal».
#   normal        tu configuración de siempre (lo que hay en ~/.claude/settings.json).
#   puro      🔓  Claude casi como viene: sin sandbox y sin los permisos allow/ask del kit (pregunta como Claude sin
#                kit). Queda el PISO de ADR-013, que ningún nivel apaga: las reglas deny (credenciales, secretos,
#                saltarse la compuerta de git) y guard.sh. También los hooks que no restringen (estado, trazas,
#                avisos, MemPalace, recall, barra) y lo que impongan tu organización y el propio repo.
#
# Los perfiles se GENERAN cada vez desde tu ~/.claude/settings.json (siempre al día) en
# ~/.config/claude-niveles/{completo,puro}.json (0600). Los dos arrancan con --setting-sources project,local, para NO
# cargar los ajustes de usuario, y --settings con el perfil completo. Hace falta así porque Claude Code FUSIONA las
# listas de todas las fuentes que carga (documentado en «Lists merge instead of overriding»): pasar una lista vacía de
# comandos excluidos no quita los de tu settings.json; la única forma de quitarlos es no cargar esa fuente.
# Si tu Claude no tiene --setting-sources, avisa y no cambia. Ojo: lo que un repo defina en su .claude/settings*.json
# (también comandos excluidos) se sigue sumando.
# En «completo», además, los comandos en sandbox solo LEEN el proyecto de la pestaña: tus otros repos (las carpetas
# de roots.txt) y tus documentos de Windows quedan fuera. Si Claude necesita consultar otro repo, usa «normal».
# Uso: tmux-nivel completo|normal|puro [PANE]
#      tmux-nivel --perfil completo|puro [settings.json] [carpeta]   imprime el perfil generado (pruebas)
#      tmux-nivel --comando completo|normal|puro [carpeta]           imprime el comando con que arrancaría Claude
set -euo pipefail
D="${WS_NIVELES_DIR:-$HOME/.config/claude-niveles}"
USR="$HOME/.claude/settings.json"

# aislar <carpeta> — JSON {deny: […], allow: […]} para que los comandos en sandbox lean solo ESTE proyecto: niega las
# carpetas donde viven tus otros repos y documentos (las de roots.txt y las del perfil de Windows) y vuelve a permitir
# el proyecto de la pestaña y sus worktrees. En Claude Code gana la ruta más específica, así que el proyecto queda
# legible aunque esté dentro de una carpeta negada. WS_COMPLETO_LECTURA=0 lo apaga.
aislar() {
  local d r c raiz linea w
  local -a deny=() allow=()
  d="$(realpath -e "${1:-.}" 2>/dev/null)" || d="${1:-.}"
  c="$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ "$c" == */.git ]]; then raiz="${c%/.git}"; else raiz="$(git -C "$d" rev-parse --show-toplevel 2>/dev/null || echo "$d")"; fi
  allow=("$raiz" "$raiz.wt" "$d")
  while IFS='|' read -r _ _ linea; do
    linea="${linea%$'\r'}"; [[ -n "$linea" ]] || continue
    r="${linea/#\~/$HOME}"; [[ -d "$r" ]] && deny+=("${r%/}")
  done < <(grep -vE '^[[:space:]]*(#|$)' "$HOME/.config/tmux-claude/roots.txt" 2>/dev/null)
  w="$(wslpath "$(cmd.exe /c 'echo %UserProfile%' 2>/dev/null | tr -d '\r')" 2>/dev/null || true)"
  [[ -n "${WS_WINHOME:-}" ]] && w="$WS_WINHOME"
  if [[ -n "$w" && -d "$w" ]]; then
    for r in "$w/Documents" "$w/Desktop" "$w/Downloads" "$w/Pictures" "$w/Videos" "$w"/OneDrive*; do [[ -d "$r" ]] && deny+=("$r"); done
  fi
  # Rutas absolutas con doble barra: en los ajustes de Claude Code «/ruta» se resuelve contra la carpeta de los
  # ajustes y solo «//ruta» es absoluta de verdad.
  jq -nc '{deny: ($ARGS.positional[:($n | tonumber)] | map("/" + .) | unique), allow: ($ARGS.positional[($n | tonumber):] | map("/" + .) | unique)}' \
     --arg n "${#deny[@]}" --args "${deny[@]}" "${allow[@]}"
}

perfil() {   # nivel [settings] [carpeta del proyecto] → JSON
  local s="${2:-$USR}" lec='{"deny":[],"allow":[]}'; [[ -f "$s" ]] || s=/dev/null
  case "$1" in
    completo)
      # Todo tu settings.json (permisos, hooks, barra…) menos la lista de comandos que salen del sandbox. Con la
      # carpeta del proyecto, además, la lectura queda limitada a ese proyecto.
      [[ -n "${3:-}" && "${WS_COMPLETO_LECTURA:-1}" != 0 ]] && lec="$(aislar "$3")"
      jq --argjson lec "$lec" '(. // {}) | .sandbox = (((.sandbox // {}) + {enabled: true, allowUnsandboxedCommands: false}) | del(.excludedCommands))
          | .sandbox.filesystem.denyRead = (((.sandbox.filesystem.denyRead // []) + $lec.deny) | unique)
          | if ($lec.allow | length) > 0 then .sandbox.filesystem.allowRead = (((.sandbox.filesystem.allowRead // []) + $lec.allow) | unique) else . end' "$s" 2>/dev/null \
        || echo '{"sandbox":{"enabled":true,"allowUnsandboxedCommands":false}}' ;;
    puro)
      # allow y ask fuera (sin deny que los frene, los allow amplios dejarían a «puro» más abierto que Claude sin kit);
      # deny y los hooks se quedan: son el piso.
      jq '(. // {})
          | .permissions = {deny: (.permissions.deny // [])}
          | .sandbox = ((.sandbox // {}) + {enabled: false})' "$s" 2>/dev/null || echo '{}' ;;
    *) echo "nivel inválido: $1" >&2; return 2 ;;
  esac
}

tiene_fuentes() { claude --help 2>/dev/null | grep -q -- '--setting-sources'; }

comando() {   # nivel [carpeta] → comando de Claude (retoma la conversación de la carpeta)
  local f="$D/completo.json"
  mkdir -p "$D" && chmod 700 "$D"
  case "$1" in
    normal) echo "claude -c" ;;
    completo)
      tiene_fuentes || { echo "✖ Tu Claude no tiene --setting-sources: «completo» no puede quitar los comandos excluidos del sandbox" >&2; return 1; }
      # Con carpeta, el perfil es propio de ese proyecto (lleva sus rutas de lectura).
      [[ -n "${2:-}" ]] && f="$D/completo-$(printf '%s' "$2" | md5sum | cut -c1-12).json"
      perfil completo "" "${2:-}" > "$f"; chmod 600 "$f"
      echo "claude -c --setting-sources project,local --settings '$f'" ;;
    puro)
      tiene_fuentes || { echo "✖ Tu Claude no tiene --setting-sources: «puro» no puede quitar las reglas de usuario" >&2; return 1; }
      perfil puro > "$D/puro.json"; chmod 600 "$D/puro.json"
      echo "claude -c --setting-sources project,local --settings '$D/puro.json'" ;;
    *) echo "nivel inválido: $1" >&2; return 2 ;;
  esac
}

case "${1:-}" in
  --perfil) perfil "${2:?nivel}" "${3:-}" "${4:-}"; exit $? ;;
  --comando) comando "${2:?nivel}" "${3:-}"; exit $? ;;
  completo|normal|puro) ;;
  *) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

nivel="$1"; pane="${2:-$(tmux display -p '#{pane_id}')}"
win="$(tmux display -p -t "$pane" '#{window_id}')"
cmd="$(comando "$nivel" "$(tmux display -p -t "$pane" '#{pane_current_path}')" 2>&1)" || { tmux display -d 5000 "$cmd"; exit 1; }

# ¿Hay Claude en el panel? (el binario nativo se llama por su versión, p. ej. 2.1.329)
corre() { [[ ! "$(tmux display -p -t "$pane" '#{pane_current_command}')" =~ ^(bash|zsh|sh|fish|dash)$ ]]; }
if corre; then
  tmux send-keys -t "$pane" Escape; sleep 0.5
  tmux send-keys -t "$pane" -l "/exit"; tmux send-keys -t "$pane" Enter
  for (( i = 0; i < 40; i++ )); do corre || break; sleep 0.5; done
  (( i < 40 )) || { tmux display "Claude no cerró; ciérralo tú (/exit) y vuelve a intentar"; exit 1; }
fi
tmux send-keys -t "$pane" -l "$cmd"; tmux send-keys -t "$pane" Enter
case "$nivel" in
  completo) tmux set -w -t "$win" @cnivel completo \; set -w -t "$win" @cnivel_ico "🔒" ;;
  puro)     tmux set -w -t "$win" @cnivel puro \; set -w -t "$win" @cnivel_ico "🔓" ;;
  normal)   tmux set -wu -t "$win" @cnivel \; set -wu -t "$win" @cnivel_ico ;;
esac
tmux set -wu -t "$win" @csolo 2>/dev/null   # el modo solo es otro arranque: al elegir nivel, se deja
d="$(mkdir -p "$HOME/.local/share/ws-telemetria/niveles" && echo "$HOME/.local/share/ws-telemetria/niveles")"
jq -nc --arg n "$nivel" --arg p "$(basename "$(tmux display -p -t "$pane" '#{pane_current_path}')")" \
  '{ts: (now | todate), nivel: $n, proyecto: $p}' >> "$d/$(date +%F).jsonl" 2>/dev/null || true
case "$nivel" in
  completo) tmux display -d 4000 "🔒 Protección completa: sandbox sin escapatorias, lectura solo de este proyecto + reglas del kit" ;;
  puro)     tmux display -d 4000 "🔓 Claude puro: sin sandbox ni permisos del kit; queda el piso (deny y guard)" ;;
  normal)   tmux display -d 4000 "Protección normal (tu configuración de siempre)" ;;
esac
