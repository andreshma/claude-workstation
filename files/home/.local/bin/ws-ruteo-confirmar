#!/usr/bin/env bash
#
# ws-ruteo-confirmar <pane> <level> <rule> <current> — routing popup (opened by the hook).
#   [y] / Enter  switches the tab's model (/model <ID>, without touching your default model) and sends the text
#                ([s] also works)
#   [n]          sends with the current model and does not suggest that level again on this tab for 30 min
#   [x] / Esc    gives the text back to Claude's input box without sending it, so you can edit it
# No answer in 30 s = [n]. With Telegram active, the question also reaches your phone with buttons and the wait
# is 2 min (the first answer wins); if no terminal is attached, only Telegram answers.
set -uo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/ws-ruteo.sh"
p="$1" nivel="$2" regla="$3" actual="$4"; n="${p#%}"
txt="$WS_RUTEO_RUN/prompt-$n"; eleccion="$WS_RUTEO_RUN/eleccion-$n"

if [[ "${5:-}" == --dentro ]]; then
  primera="$(head -c 400 "$txt" | tr '\n' ' ' | cut -c1-64)"
  ctx="$(tmux show -wqv -t "$p" @cctx 2>/dev/null)"
  printf '\n  \e[1m%s…\e[0m\n\n' "$primera"
  printf '  Looks like level \e[1;36m%s\e[0m (%s) · this tab uses \e[1m%s\e[0m\n' "$nivel" "$regla" "$actual"
  printf '  Switching re-reads the conversation without cache%s.\n\n' "${ctx:+ (context: ${ctx}%)}"
  printf '  \e[1m[y]\e[0m switch to %s and send   \e[1m[n]\e[0m send with %s   \e[1m[x]\e[0m edit\n  ' "$nivel" "$actual"
  # With Telegram active, the same question reaches your phone and it waits 2 min; whichever answers first wins.
  remoto="$WS_RUTEO_RUN/remoto-$n"; rm -f "$remoto"; lim=30
  if "$HOME/.local/bin/ws-telegram" activo 2>/dev/null; then
    : > "$remoto.esperando"; lim=120
    "$HOME/.local/bin/ws-telegram" preguntar "$p" \
      "Model routing: «${primera}…» looks like level ${nivel} (rule ${regla}); the tab uses ${actual}." \
      "s=Switch to ${nivel} and send;n=Send with ${actual};x=Edit on the PC" "$remoto" >/dev/null 2>&1 || true
    printf '  (you can also answer in Telegram; waiting 2 min)\n  '
  fi
  k="" fin=1
  for (( i = 0; i < lim; i++ )); do
    if [[ -t 0 ]]; then
      if IFS= read -rsn1 -t 1 k; then fin=0; break; fi
    else sleep 1; fi   # no popup (terminal closed): only Telegram can answer
    if [[ -s "$remoto" ]]; then k="$(head -c1 "$remoto")"; fin=0; break; fi
  done
  rm -f "$remoto" "$remoto.esperando"
  (( fin )) && k=n
  case "$k" in y|Y|s|S|"") echo s ;; x|X|$'\e') echo x ;; *) echo n ;; esac > "$eleccion"
  exit 0
fi

rm -f "$eleccion"
sleep 0.3   # let Claude finish processing the block before opening the popup
if ! tmux display-popup -t "$p" -E -w 78 -h 12 -T " Model routing " "$0 '$p' '$nivel' '$regla' '$actual' --dentro" 2>/dev/null; then
  # With no terminal attached there is no popup: if Telegram is active, the question goes to the phone only; otherwise
  # it carries on with the current model.
  if "$HOME/.local/bin/ws-telegram" activo 2>/dev/null; then "$0" "$p" "$nivel" "$regla" "$actual" --dentro </dev/null >/dev/null 2>&1
  else sleep 1; fi
fi
e="$(cat "$eleccion" 2>/dev/null || echo n)"; rm -f "$eleccion"
chars="$(wc -c < "$txt" 2>/dev/null || echo 0)"
case "$e" in
  s) ruteo_cambiar "$p" "$nivel"; ruteo_pegar "$p" "$txt" enviar
     ruteo_registrar hook "$nivel" "$regla" "$actual" aceptado "$chars" ;;
  x) ruteo_pegar "$p" "$txt" solo-pegar
     ruteo_registrar hook "$nivel" "$regla" "$actual" editar "$chars" ;;
  *) tmux set -w -t "$p" @cruteo_no "$nivel:$(date +%s)"
     ruteo_pegar "$p" "$txt" enviar
     ruteo_registrar hook "$nivel" "$regla" "$actual" rechazado "$chars" ;;
esac
