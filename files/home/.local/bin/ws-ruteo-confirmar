#!/usr/bin/env bash
#
# ws-ruteo-confirmar <panel> <nivel> <regla> <actual> — ventana emergente del ruteo (la abre el hook).
#   [s] / Enter  cambia el modelo de la pestaña (/model <ID>, sin tocar tu modelo por defecto) y envía el texto
#   [n]          envía con el modelo actual y no vuelve a sugerir ese nivel en esta pestaña por 30 min
#   [x] / Esc    devuelve el texto al cuadro de Claude sin enviarlo, para que lo edites
# Sin respuesta en 30 s = [n]. Con Telegram activo, la pregunta también llega al celular con botones y la espera
# es de 2 min (gana la primera respuesta); si no hay terminal conectada, solo responde Telegram.
set -uo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/ws-ruteo.sh"
p="$1" nivel="$2" regla="$3" actual="$4"; n="${p#%}"
txt="$WS_RUTEO_RUN/prompt-$n"; eleccion="$WS_RUTEO_RUN/eleccion-$n"

if [[ "${5:-}" == --dentro ]]; then
  primera="$(head -c 400 "$txt" | tr '\n' ' ' | cut -c1-64)"
  ctx="$(tmux show -wqv -t "$p" @cctx 2>/dev/null)"
  printf '\n  \e[1m%s…\e[0m\n\n' "$primera"
  printf '  Parece de nivel \e[1;36m%s\e[0m (%s) · esta pestaña usa \e[1m%s\e[0m\n' "$nivel" "$regla" "$actual"
  printf '  Cambiar vuelve a leer la conversación sin caché%s.\n\n' "${ctx:+ (contexto: ${ctx}%)}"
  printf '  \e[1m[s]\e[0m cambiar a %s y enviar   \e[1m[n]\e[0m enviar con %s   \e[1m[x]\e[0m editar\n  ' "$nivel" "$actual"
  # Con Telegram activo, la misma pregunta llega al celular y se espera 2 min; lo que conteste primero gana.
  remoto="$WS_RUTEO_RUN/remoto-$n"; rm -f "$remoto"; lim=30
  if "$HOME/.local/bin/ws-telegram" activo 2>/dev/null; then
    : > "$remoto.esperando"; lim=120
    "$HOME/.local/bin/ws-telegram" preguntar "$p" \
      "Ruteo de modelo: «${primera}…» parece de nivel ${nivel} (regla ${regla}); la pestaña usa ${actual}." \
      "s=Cambiar a ${nivel} y enviar;n=Enviar con ${actual};x=Editar en la PC" "$remoto" >/dev/null 2>&1 || true
    printf '  (también puedes responder en Telegram; espero 2 min)\n  '
  fi
  k="" fin=1
  for (( i = 0; i < lim; i++ )); do
    if [[ -t 0 ]]; then
      if IFS= read -rsn1 -t 1 k; then fin=0; break; fi
    else sleep 1; fi   # sin ventana (terminal cerrada): solo Telegram puede responder
    if [[ -s "$remoto" ]]; then k="$(head -c1 "$remoto")"; fin=0; break; fi
  done
  rm -f "$remoto" "$remoto.esperando"
  (( fin )) && k=n
  case "$k" in s|S|"") echo s ;; x|X|$'\e') echo x ;; *) echo n ;; esac > "$eleccion"
  exit 0
fi

rm -f "$eleccion"
sleep 0.3   # que Claude termine de procesar el bloqueo antes de abrir la ventana
if ! tmux display-popup -t "$p" -E -w 78 -h 12 -T " Ruteo de modelo " "$0 '$p' '$nivel' '$regla' '$actual' --dentro" 2>/dev/null; then
  # Sin terminal conectada no hay ventana: si Telegram está activo, la pregunta va solo al celular; si no, sigue con el actual.
  if "$HOME/.local/bin/ws-telegram" activo 2>/dev/null; then "$0" "$p" "$nivel" "$regla" "$actual" --dentro </dev/null >/dev/null 2>&1
  else sleep 1; fi
fi
e="$(cat "$eleccion" 2>/dev/null || echo n)"; rm -f "$eleccion"
chars="$(wc -c < "$txt" 2>/dev/null || echo 0)"
case "$e" in
  s) ruteo_cambiar "$p" "$nivel"; ruteo_pegar "$p" "$txt" enviar
     ruteo_registrar hook "$nivel" "$regla" "$actual" aceptado "$chars" ;;
  x) ruteo_pegar "$p" "$txt" solo-pegar
     ruteo_registrar hook "$nivel" "$regla" "$actual" editar "$chars" ;;
  *) tmux set -w -t "$p" @cruteo_no "$nivel:$(date +%s)"
     ruteo_pegar "$p" "$txt" enviar
     ruteo_registrar hook "$nivel" "$regla" "$actual" rechazado "$chars" ;;
esac
