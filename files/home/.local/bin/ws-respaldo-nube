#!/usr/bin/env bash
#
# ws-respaldo-nube — ENCRYPTED (age) copy of the light backup to OneDrive, and its recovery test.
#
# Usage:
#   ws-respaldo-nube configurar   installs age if missing, creates the key, stores the private one in Windows
#                                 Credential Manager and shows it to you ONCE for your password manager
#   ws-respaldo-nube [--si-toca]  encrypts the last light backup and copies it to OneDrive (keeps 7; --si-toca: if
#                                 the last copy is more than 20 h old). ws-telegram triggers it hourly.
#   ws-respaldo-nube probar       decrypts the last OneDrive copy into a temp folder and checks the tar is healthy
#   ws-respaldo-nube bajar [file] [destination]   decrypts a copy so ws-restore-lite can restore it
#   ws-respaldo-nube estado
#
# Why this way: the light backup contains conversations (they may hold client code or data); it only goes to
# the cloud encrypted. The private key lives in Credential Manager (ws/age-respaldo) and in YOUR password
# manager: if you lose the laptop, without that external copy the cloud backups cannot be opened.
# Destination: <organization OneDrive ("OneDrive - Name") | OneDrive>\Respaldos\estacion-wsl (change it in ~/.config/ws-backup/nube.conf: destino=…).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
CONF="$HOME/.config/ws-backup"
PUB="$CONF/nube-recipient"
GUARDA=7
die() { echo "✖ $*" >&2; exit 1; }

win_home() {
  local p=""; command -v wslvar >/dev/null && p="$(wslvar USERPROFILE 2>/dev/null || true)"
  [[ -n "$p" ]] || p="$( (cd /mnt/c 2>/dev/null && cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null) | tr -d '\r')"
  [[ -n "$p" ]] && wslpath -u "$p" 2>/dev/null
}
WH="$(win_home)"
LOCAL="${WS_BACKUP_DEST:-$WH/WSL-Backups/lite}"
destino() {
  local d; d="$(sed -n 's/^destino=//p' "$CONF/nube.conf" 2>/dev/null | tail -1)"
  if [[ -z "$d" ]]; then
    local org; org="$(compgen -G "$WH/OneDrive - *" | head -1)"   # the organization's OneDrive, if any
    if [[ -n "$org" && -d "$org" ]]; then d="$org/Respaldos/estacion-wsl"
    elif [[ -d "$WH/OneDrive" ]]; then d="$WH/OneDrive/Respaldos/estacion-wsl"; fi
  fi
  printf '%s' "$d"
}
ultimo() { find "$1" -maxdepth 1 -name "$2" ! -name '*.sha256' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-; }
identidad() {   # 0600 temp file with the private key; the caller deletes it
  local t; t="$(mktemp)"; chmod 600 "$t"
  ws-secret get age-respaldo > "$t" 2>/dev/null; [[ -s "$t" ]] || { rm -f "$t"; return 1; }
  printf '%s' "$t"
}

configurar() {
  command -v age >/dev/null || { echo "Installing age (official Ubuntu package)…"; sudo apt-get install -y -qq age >/dev/null || die "could not install age"; }
  mkdir -p "$CONF" && chmod 700 "$CONF"
  if [[ -s "$PUB" ]] && ws-secret has age-respaldo 2>/dev/null; then echo "✔ Already configured (public key in $PUB)."; return; fi
  local t clave; t="$(mktemp -d)"; chmod 700 "$t"
  age-keygen -o "$t/llave" 2>/dev/null || die "age-keygen failed"
  clave="$(grep '^AGE-SECRET-KEY-' "$t/llave")"; age-keygen -y "$t/llave" > "$PUB"
  printf '%s\n' "$clave" | ws-secret set age-respaldo >/dev/null || { rm -rf "$t"; die "could not store the key in Windows"; }
  rm -rf "$t"
  echo
  echo "⚠ Save this private key in your password manager NOW (without it the cloud backups cannot be opened"
  echo "  if you lose this laptop). It will not be shown again:"
  echo; echo "  $clave"; echo
  read -rp "Have you saved it? [y/N] " r; [[ "$r" =~ ^([yY]([eE][sS])?|[sS]([iI]|í|Í)?)$ ]] || echo "  You can see it again with: ws-secret get age-respaldo"
  clear 2>/dev/null || true
  echo "✔ Configured. Destination: $(destino)"; respaldar
}

respaldar() {
  [[ -s "$PUB" ]] || die "first: ws-respaldo-nube configurar"
  command -v age >/dev/null || die "age is missing (ws-respaldo-nube configurar)"
  local d src nom out; d="$(destino)"; [[ -n "$d" ]] || die "OneDrive not found; set destino= in $CONF/nube.conf"
  mkdir -p "$d" || die "cannot write to $d"
  if [[ "${1:-}" == --si-toca ]]; then
    local u; u="$(ultimo "$d" 'claude-lite-*.age')"
    [[ -n "$u" ]] && (( $(date +%s) - $(stat -c %Y "$u") < 20 * 3600 )) && exit 0
  fi
  src="$(ultimo "$LOCAL" 'claude-lite-*.tar.*')"; [[ -n "$src" ]] || die "no light backup in $LOCAL (ws-backup-lite --ahora)"
  nom="$(basename "$src")"; nom="${nom%.age}.age"; out="$d/$nom"
  [[ -f "$out" ]] && { echo "✔ Already in the cloud: $nom"; return; }
  if [[ "$src" == *.age ]]; then cp "$src" "$out.tmp"; else age -R "$PUB" -o "$out.tmp" "$src" || { rm -f "$out.tmp"; die "age failed"; }; fi
  mv "$out.tmp" "$out" && (cd "$d" && sha256sum "$nom" > "$nom.sha256")
  # Rotation: only the 7 most recent
  find "$d" -maxdepth 1 -name 'claude-lite-*.age' -printf '%T@ %p\n' | sort -rn | tail -n +$((GUARDA + 1)) | cut -d' ' -f2- \
    | while IFS= read -r v; do rm -f "$v" "$v.sha256"; done
  echo "✔ Encrypted copy in the cloud: $nom ($(du -h "$out" | cut -f1))"
}

probar() {
  local d f id n; d="$(destino)"; f="$(ultimo "$d" 'claude-lite-*.age')"
  [[ -n "$f" ]] || { echo "✖ No copies in the cloud ($d)"; return 1; }
  (cd "$d" && sha256sum -c --quiet "$(basename "$f").sha256") || { echo "✖ The checksum does not match: $(basename "$f")"; return 1; }
  id="$(identidad)" || { echo "✖ Private key not found (ws/age-respaldo)"; return 1; }
  n="$(age -d -i "$id" "$f" 2>/dev/null | zstd -dc 2>/dev/null | tar -t 2>/dev/null | wc -l)"; rm -f "$id"
  (( n > 0 )) || { echo "✖ Could not decrypt, or the tar is damaged: $(basename "$f")"; return 1; }
  echo "✔ The cloud copy decrypts and is healthy: $(basename "$f") ($n files, $(( ($(date +%s) - $(stat -c %Y "$f")) / 3600 )) h)"
}

bajar() {
  local d f id dest; d="$(destino)"; f="${1:-$(ultimo "$d" 'claude-lite-*.age')}"; dest="${2:-$LOCAL}"
  [[ -f "$f" ]] || f="$d/$f"; [[ -f "$f" ]] || die "$1 not found"
  id="$(identidad)" || die "private key not found: ws-secret set age-respaldo (paste the one from your password manager)"
  mkdir -p "$dest"; age -d -i "$id" -o "$dest/$(basename "${f%.age}")" "$f"; local rc=$?; rm -f "$id"
  (( rc == 0 )) || die "could not decrypt"
  (cd "$dest" && sha256sum "$(basename "${f%.age}")" > "$(basename "${f%.age}").sha256")
  echo "✔ Decrypted to $dest/$(basename "${f%.age}"). Next: ws-restore-lite (test) and ws-restore-lite --restaurar"
}

case "${1:-}" in
  configurar) configurar ;;
  probar) probar ;;
  bajar) shift; bajar "$@" ;;
  estado)
    echo "Public key: $([[ -s "$PUB" ]] && echo yes || echo "no (ws-respaldo-nube configurar)") · private key in Windows: $(ws-secret has age-respaldo 2>/dev/null && echo yes || echo no)"
    echo "Destination: $(destino)"
    f="$(ultimo "$(destino)" 'claude-lite-*.age')"; [[ -n "$f" ]] && echo "Last copy: $(basename "$f") ($(( ($(date +%s) - $(stat -c %Y "$f")) / 3600 )) h)" || echo "No copies yet" ;;
  ""|--si-toca|--ahora) respaldar "${1:-}" ;;
  *) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
