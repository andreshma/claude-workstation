#!/usr/bin/env bash
#
# ws-backup-lite — light backup of the Claude environment and the workstation (instead of the full
# distro snapshot). The setup already lives in the kit (GitHub); this saves the DATA:
#   · ~/.claude: conversations (subagents too), todos, plans, /rewind checkpoints, prompt
#     history, memory, agents, audit log and a copy of its anchors (no login, no caches)
#   · tmux saves (tabs, panes and the conversation of each one) and ~/.config/tmux-claude
#   · MemPalace (if present) and extra paths from ~/.config/ws-backup/extra.txt
#   · inventory for reinstalling: apt, pipx, az, npm -g, cargo, versions, kube contexts
#   · warning about repos in ~/code with uncommitted changes or unpushed commits
# Never includes credentials (~/.claude/.credentials.json, ~/.azure, ~/.kube, ~/.aws, gh).
# Destination: %UserProfile%\WSL-Backups\lite (local disk, not OneDrive). Rotation: WS_BACKUP_KEEP (14).
# Encrypted with age by default (WS-SEC-013): to every key in ~/.config/ws-backup/age-recipients and to the cloud
# key of ws-backup-cloud (cloud-recipient), whichever exist. With neither, or without age, it is made in clear with a
# loud warning and logged as UNENCRYPTED (ws-audit reports it): run ws-backup-cloud setup once.
# Expiry: after each backup it also prunes the Windows-side copies that ws-backup and tmux-backup keep
# (%UserProfile%\.claude-wsl-backup and .tmux-resurrect-backup) older than WS_BACKUP_COPY_DAYS (30): conversation
# copies whose original Claude Code already deleted, and tmux saves (the newest and last.txt always stay); encrypted
# copies (<name>.age, written by ws-mirror.sh) and clear ones alike.
#
# Usage: ws-backup-lite [--now | --if-due | --prune-copies]
#   --now    (default) back up now
#   --if-due  only if the last backup is more than 20 h old (called by tmux-backup)
#   --prune-copies  only the expiry pass of the Windows-side copies
set -euo pipefail
umask 077
MODE="${1:---now}"
KEEP="${WS_BACKUP_KEEP:-14}"
CONF="$HOME/.config/ws-backup"
LOG="$HOME/.local/state/ws-backup-lite.log"
mkdir -p "$(dirname "$LOG")"

# win_home — Windows user folder as seen from WSL (no hard-coded paths).
win_home() {
  if [[ -n "${WS_BACKUP_DEST:-}" ]]; then return; fi
  local p=""
  command -v wslvar >/dev/null && p="$(wslvar USERPROFILE 2>/dev/null || true)"
  [[ -n "$p" ]] || p="$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r' || true)"
  [[ -n "$p" ]] && wslpath -u "$p"
}
DEST="${WS_BACKUP_DEST:-$(win_home)/WSL-Backups/lite}"
[[ "$DEST" == /* ]] || { echo "✖ Windows folder not found; set WS_BACKUP_DEST" >&2; exit 1; }

#######################################
# Expiry of the Windows-side copies (WS_BACKUP_COPY_DAYS, default 30; 0 turns it off).
#   .claude-wsl-backup: files older than that whose original under ~/.claude no longer exists (ws-backup copies
#     incrementally and never deletes, so a conversation Claude Code cleaned up stayed there for ever);
#   .tmux-resurrect-backup: tmux_resurrect_*.txt(.age) older than that, except the newest; last.txt(.age) stays.
# Globals: WS_BACKUP_WINHOME (the Windows profile seen from WSL; detected when unset). Outputs: count to the log.
#######################################
prune_copies() {
  local days="${WS_BACKUP_COPY_DAYS:-30}" wh n=0 f rel newest
  [[ "$days" =~ ^[0-9]+$ ]] && (( days > 0 )) || return 0
  wh="${WS_BACKUP_WINHOME:-}"
  # A run with its own destination (ws-test, a manual test) never prunes the real Windows profile: its HOME is not
  # the one the copies came from, so every copy would look orphaned.
  [[ -z "$wh" && -n "${WS_BACKUP_DEST:-}" ]] && return 0
  if [[ -z "$wh" ]]; then
    command -v wslvar >/dev/null && wh="$(wslvar USERPROFILE 2>/dev/null || true)"
    [[ -n "$wh" ]] || wh="$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r' || true)"
    [[ -n "$wh" ]] && wh="$(wslpath -u "$wh" 2>/dev/null || true)"
  fi
  [[ "$wh" == /* ]] || return 0
  if [[ -d "$wh/.claude-wsl-backup" ]]; then
    while IFS= read -r -d '' f; do
      rel="${f#"$wh/.claude-wsl-backup/"}"; rel="${rel%.age}"   # encrypted copies are <name>.age (ws-mirror.sh)
      [[ -e "$HOME/.claude/$rel" ]] && continue          # the original still exists: the copy mirrors it
      rm -f -- "$f" && n=$((n + 1))
    done < <(find "$wh/.claude-wsl-backup" -mindepth 2 -type f -mtime +"$days" -print0 2>/dev/null)
    find "$wh/.claude-wsl-backup" -mindepth 2 -type d -empty -delete 2>/dev/null || true
  fi
  if [[ -d "$wh/.tmux-resurrect-backup" ]]; then
    # Saves in clear (tmux_resurrect_*.txt) and encrypted (*.txt.age) alike; the newest of either kind stays.
    local saves=(\( -name 'tmux_resurrect_*.txt' -o -name 'tmux_resurrect_*.txt.age' \))
    newest="$(find "$wh/.tmux-resurrect-backup" -maxdepth 1 "${saves[@]}" -printf '%T@ %p\n' 2>/dev/null \
              | sort -rn | head -1 | cut -d' ' -f2-)"
    while IFS= read -r -d '' f; do
      [[ "$f" == "$newest" ]] && continue
      rm -f -- "$f" && n=$((n + 1))
    done < <(find "$wh/.tmux-resurrect-backup" -maxdepth 1 "${saves[@]}" -mtime +"$days" -print0 2>/dev/null)
  fi
  (( n == 0 )) || echo "$(date -Is) expired $n Windows-side copies older than $days days" >> "$LOG"
}
if [[ "$MODE" == "--prune-copies" ]]; then prune_copies; exit 0; fi

# One backup at a time (tmux can trigger it several times in a row).
# WS_BACKUP_LOCK: its own lock (ws-test uses it so it does not collide with your real backup)
exec 9>"${WS_BACKUP_LOCK:-/tmp/ws-backup-lite-$UID.lock}"
flock -n 9 || exit 0

latest() { find "$DEST" -maxdepth 1 -name 'claude-lite-*.tar.*' ! -name '*.sha256' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1; }
if [[ "$MODE" == "--if-due" ]]; then
  u="$(latest)"; [[ -n "$u" ]] && (( $(date +%s) - ${u%%.*} < 20 * 3600 )) && exit 0
fi

mkdir -p "$DEST"
free_gb=$(df -BG --output=avail "$DEST" | tail -1 | tr -dc '0-9')
min_gb="${WS_BACKUP_MIN_GB:-5}"
(( free_gb >= min_gb )) || { echo "✖ Only $free_gb GB free at the destination (minimum $min_gb)" | tee -a "$LOG" >&2; exit 1; }

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
INV="$TMP/inventory"; mkdir -p "$INV"

#######################################
# What is included (paths relative to $HOME). Only the ones that exist.
#######################################
paths=(.claude .local/share/tmux/resurrect .config/tmux-claude .config/ws-backup .config/starship.toml)
for m in .mempalace .local/share/mempalace mempalace; do [[ -e "$HOME/$m" ]] && paths+=("$m"); done
if [[ -f "$CONF/extra.txt" ]]; then
  while IFS= read -r r; do r="${r%%#*}"; r="${r// /}"; [[ -n "$r" && -e "$HOME/$r" ]] && paths+=("$r"); done < "$CONF/extra.txt"
fi
existing=(); for r in "${paths[@]}"; do [[ -e "$HOME/$r" ]] && existing+=("$r"); done
printf '%s\n' "${existing[@]}" > "$INV/included.txt"

# Credentials and regenerable caches stay out. Credentials are recovered by logging in, never from a backup.
excl=(--exclude='.claude/.credentials.json' --exclude='.claude/statsig' --exclude='.claude/shell-snapshots'
      --exclude='.claude/debug' --exclude='.claude/ide' --exclude='.claude/cache' --exclude='.claude/local'
      --exclude='.claude/downloads' --exclude='.claude/telemetry' --exclude='.claude/plugins/cache'
      --exclude='.claude/plugins/marketplaces' --exclude='*.lock' --exclude='*.sock'
      --exclude='.config/ws-backup/age-identity*')

#######################################
# Inventory for reinstalling (every command is optional).
#######################################
inv() { local f="$1"; shift; timeout 60 "$@" > "$INV/$f" 2>/dev/null || rm -f "$INV/$f"; }
# The audit log's anchors live outside ~/.claude, on the Windows side (WS-SEC-011): a copy travels with the backup
# (and so off the machine with ws-backup-cloud), so a rewritten log can still be checked against them.
anchors="${CLAUDE_AUDIT_ANCHORS:-}"
if [[ -z "$anchors" ]]; then
  w="${WS_BACKUP_WINHOME:-$(cat "$HOME/.claude/audit/.winhome" 2>/dev/null || true)}"
  [[ -n "$w" ]] && anchors="$w/ws-telemetry/audit-anchors.txt"
fi
if [[ -n "$anchors" && -s "$anchors" ]]; then cp "$anchors" "$INV/audit-anchors.txt"; fi
inv apt-manual.txt     apt-mark showmanual
inv pipx.txt           pipx list --short
inv npm-global.txt     npm ls -g --depth=0
inv cargo.txt          cargo install --list
inv az-extensions.txt az extension list --query '[].name' -o tsv
inv kube-contexts.txt kubectl config get-contexts -o name
inv ws-tools.txt       "$HOME/.local/bin/ws-tools"
{
  echo "date: $(date -Is)"; echo "host: $(hostname)"; echo "user: $(id -un)"
  echo "ubuntu: $(lsb_release -ds 2>/dev/null)"; echo "claude: $(claude --version 2>/dev/null | head -1)"
  echo "node: $(node -v 2>/dev/null)"; echo "tmux: $(tmux -V 2>/dev/null)"
  echo "kit: $(git -C "$HOME/code/claude-workstation" describe --tags --always 2>/dev/null)"
} > "$INV/versions.txt"

# Repos inside WSL: they are not copied (they are on GitHub), but it warns about what would be lost.
pending=0
while IFS= read -r g; do
  d="${g%/.git}"; s=""
  [[ -n "$(git -C "$d" status --porcelain 2>/dev/null | head -1)" ]] && s+=" uncommitted-changes"
  a="$(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null || echo "no-upstream")"
  [[ "$a" != 0 ]] && s+=" unpushed:$a"
  [[ -n "$s" ]] && { echo "${d/#"$HOME"/\~}:$s"; pending=$((pending + 1)); }
done < <(find "$HOME/code" -maxdepth 3 -name .git -type d 2>/dev/null) > "$INV/repos-pending.txt"

#######################################
# Pack → verify → publish (atomic) → rotate.
#######################################
stamp="$(date +%Y%m%d-%H%M)"
if command -v zstd >/dev/null; then ext="tar.zst"; comp=(zstd -q -T0 -10); else ext="tar.gz"; comp=(gzip -6); fi
name="claude-lite-$stamp.$ext"
# Recipients: your age-recipients plus the cloud key, so the cloud copy (ws-backup-cloud) and a local restore both
# open it with the key kept in Credential Manager. age is given every key with -R.
age_args=(); for r in "$CONF/age-recipients" "$CONF/cloud-recipient"; do [[ -s "$r" ]] && age_args+=(-R "$r"); done
encrypt=0 clear_why=""
if (( ${#age_args[@]} == 0 )); then clear_why="no recipient (ws-backup-cloud setup creates one)"
elif ! command -v age >/dev/null; then clear_why="age is not installed (sudo apt-get install age)"
else encrypt=1; name+=".age"; fi
if (( ! encrypt )); then
  printf '\033[1;31m⚠ UNENCRYPTED backup: %s. It holds your conversations in clear on the Windows disk.\033[0m\n' \
    "$clear_why" >&2
fi
part="$DEST/.$name.partial"
trap 'rm -rf "$TMP" "$part"' EXIT   # if something fails halfway, no incomplete file is left behind

{
  nice -n 19 tar -C "$HOME" "${excl[@]}" --warning=no-file-changed --ignore-failed-read -cf - "${existing[@]}" -C "$TMP" inventory \
    || [[ $? -eq 1 ]]   # 1 = files that changed during the copy (active conversations): acceptable
} | "${comp[@]}" | if (( encrypt )); then age "${age_args[@]}"; else cat; fi > "$part"

# Verification: it reads end to end and contains conversations (unless encrypted: size only).
if (( ! encrypt )); then
  n=$(tar -tf "$part" 2>/dev/null | grep -v '/subagents/' | grep -c '^\.claude/projects/.*\.jsonl$' || true)
  if ! tar -tf "$part" >/dev/null 2>&1; then rm -f "$part"; echo "✖ $(date -Is) unreadable file; nothing was rotated" | tee -a "$LOG" >&2; exit 1; fi
else n="?"; fi
[[ -s "$part" ]] || { rm -f "$part"; echo "✖ empty backup" | tee -a "$LOG" >&2; exit 1; }
mv "$part" "$DEST/$name"
( cd "$DEST" && sha256sum "$name" > "$name.sha256" )

# Rotation only after a verified backup.
find "$DEST" -maxdepth 1 -name 'claude-lite-*.tar.*' ! -name '*.sha256' -printf '%T@ %p\n' | sort -rn | tail -n +"$((KEEP + 1))" \
  | cut -d' ' -f2- | while IFS= read -r v; do rm -f "$v" "$v.sha256"; done

prune_copies || true
size="$(du -h "$DEST/$name" | cut -f1)"
state="encrypted"; (( encrypt )) || state="UNENCRYPTED: $clear_why"
msg="$(date -Is) ok $name ($size, $n conversations, repos with pending work: $pending, $state)"
echo "$msg" >> "$LOG"
[[ "$MODE" == "--if-due" ]] || { echo "✔ $DEST/$name ($size) · $n conversations · repos with pending work: $pending"; (( pending )) && sed 's/^/  ⚠ /' "$INV/repos-pending.txt"; }
exit 0
