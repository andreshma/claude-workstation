#!/usr/bin/env bash
#
# ws-restore-lite — tests or restores a ws-backup-lite backup.
#
# Usage: ws-restore-lite [--test | --restore] [FILE] [--identity AGE_FILE]
#        ws-restore-lite --mirror PATH [--to DIR] [--identity AGE_FILE]
#   --test     (default) extracts into a temp folder and checks that everything can be
#                recovered: integrity, readable conversations, tmux, inventory and
#                that it does NOT contain credentials. Does not touch your $HOME.
#   --restore  extracts into $HOME. Asks for confirmation; will not run with Claude open; what
#                already exists and differs is kept as <file>.~N~ (no overwrite).
#   --mirror   recovers a file or folder of the Windows-side mirrors (%UserProfile%\.claude-wsl-backup from ws-backup,
#                .tmux-resurrect-backup from tmux-backup) into DIR (default ~/.local/state/ws-restore/mirror-<date>):
#                .age copies are decrypted, clear ones (older mirrors) copied; ~/.claude is not touched.
#   FILE         by default, the most recent backup in %UserProfile%\WSL-Backups\lite
#   --identity   age identity for an encrypted (.age) backup; by default the cloud key ws-backup-cloud keeps in
#                the Windows Credential Manager (ws/age-backup), which ws-backup-lite always encrypts to
# Order on a new machine: the kit's install.sh → ws-restore-lite --restore → logins.
set -euo pipefail
MODE="--test" FILE="" IDENT="" MIRROR="" TO=""
while (( $# )); do
  case "$1" in
    --test|--restore) MODE="$1" ;;
    --mirror) MODE="--mirror"; MIRROR="${2:?missing mirror path}"; shift ;;
    --to) TO="${2:?missing destination folder}"; shift ;;
    --identity) IDENT="${2:?missing identity file}"; shift ;;
    -h|--help) sed -n '3,18p' "$0"; exit 0 ;;
    *) FILE="$1" ;;
  esac
  shift
done

win_home() {
  local p=""
  command -v wslvar >/dev/null && p="$(wslvar USERPROFILE 2>/dev/null || true)"
  [[ -n "$p" ]] || p="$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r' || true)"
  [[ -n "$p" ]] && wslpath -u "$p"
}
# load_cloud_key — without --identity, the cloud key from Credential Manager (ws-backup-cloud setup) into a 0600 temp
# file deleted on exit. Globals: IDENT, ID_TMP.
ID_TMP=""
cleanup_id() { [[ -z "$ID_TMP" ]] || rm -f "$ID_TMP"; }
trap cleanup_id EXIT
load_cloud_key() {
  [[ -z "$IDENT" ]] && command -v ws-secret >/dev/null || return 0
  ID_TMP="$(mktemp)"; chmod 600 "$ID_TMP"
  for k in age-backup age-respaldo; do ws-secret get "$k" > "$ID_TMP" 2>/dev/null && [[ -s "$ID_TMP" ]] && break; done
  if [[ -s "$ID_TMP" ]]; then IDENT="$ID_TMP"; return 0; fi
  rm -f "$ID_TMP"; ID_TMP=""
}

#######################################
# --mirror: a file or folder of the Windows-side mirrors into a folder of its own. Each <name>.age is decrypted to
# <name>, a clear copy (a mirror written before WS-SEC-013 or without a key) is copied as it is; mtimes are kept and
# nothing is overwritten.
#######################################
if [[ "$MODE" == "--mirror" ]]; then
  [[ -e "$MIRROR" ]] || { echo "✖ $MIRROR does not exist" >&2; exit 1; }
  src="$(cd "$(dirname "$MIRROR")" && pwd)/$(basename "$MIRROR")"
  TO="${TO:-$HOME/.local/state/ws-restore/mirror-$(date +%Y%m%d-%H%M%S)}"
  mkdir -p "$TO"; chmod 700 "$TO"
  if [[ -n "$(find "$src" -type f -name '*.age' -print -quit 2>/dev/null)" ]]; then
    load_cloud_key
    [[ -n "$IDENT" ]] \
      || { echo "✖ encrypted mirror: use --identity <age file> (the key of ws-backup-cloud setup)" >&2; exit 1; }
  fi
  base="$(dirname "$src")"; n=0 bad=0
  while IFS= read -r -d '' f; do
    rel="${f#"$base/"}"; out="$TO/${rel%.age}"
    [[ -e "$out" ]] && continue
    mkdir -p "$(dirname "$out")"
    if [[ "$f" == *.age ]]; then
      if age -d -i "$IDENT" -o "$out" "$f" 2>/dev/null; then touch -r "$f" "$out"; n=$((n + 1))
      else rm -f "$out"; bad=$((bad + 1)); echo "  FAIL   could not decrypt $rel" >&2; fi
    else cp -p "$f" "$out" && n=$((n + 1)); fi
  done < <(find "$src" -type f ! -name '.*' -print0 2>/dev/null)
  echo "✔ $n files from $src in $TO$( (( bad )) && echo " ($bad could not be decrypted)")"
  echo "  Copy back what you need without overwriting, e.g.: cp -rn \"$TO/projects/<folder>\" ~/.claude/projects/"
  (( bad == 0 )) || exit 1
  exit 0
fi

DEST="${WS_BACKUP_DEST:-$(win_home)/WSL-Backups/lite}"
if [[ -z "$FILE" ]]; then
  FILE="$(find "$DEST" -maxdepth 1 -name 'claude-lite-*.tar.*' ! -name '*.sha256' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"
fi
[[ -f "$FILE" ]] || { echo "✖ No backup in $DEST (run ws-backup-lite)" >&2; exit 1; }

failures=0
ok()    { printf '  \e[32mok\e[0m     %s\n' "$1"; }
warn() { printf '  \e[33mwarn\e[0m   %s\n' "$1"; }
fail() { printf '  \e[31mFAIL\e[0m   %s\n' "$1"; failures=$((failures + 1)); }

echo "Backup: $FILE ($(du -h "$FILE" | cut -f1), $(( ($(date +%s) - $(stat -c %Y "$FILE")) / 3600 )) h)"
if [[ -f "$FILE.sha256" ]]; then
  if ( cd "$(dirname "$FILE")" && sha256sum -c --quiet "$(basename "$FILE").sha256" ) 2>/dev/null; then ok "SHA-256 checksum matches"
  else fail "the SHA-256 checksum does not match: damaged file"; exit 1; fi
else warn "no .sha256 file"; fi

# An encrypted backup without --identity: the cloud key from Credential Manager, in a 0600 temp file deleted on exit.
if [[ "$FILE" == *.age && -z "$IDENT" ]]; then
  load_cloud_key
  [[ -n "$ID_TMP" ]] && ok "encrypted: using the cloud key from the Windows Credential Manager"
fi

# read_backup — decrypts (if needed) and decompresses to stdout.
read_backup() {
  # The compression is read from the name without .age: set before the pipeline (its stages are subshells, so a
  # name changed inside the first stage never reached the second, and encrypted backups did not extract).
  local a="$FILE" inner="${FILE%.age}"
  if [[ "$a" == *.age ]]; then
    [[ -n "$IDENT" ]] || { echo "✖ encrypted backup: use --identity <age file>" >&2; return 1; }
    age -d -i "$IDENT" "$a"
  else cat "$a"; fi | case "$inner" in *.zst) zstd -dc -q ;; *.gz) gzip -dc ;; *) cat ;; esac
}

#######################################
# --test: everything in a temp folder
#######################################
if [[ "$MODE" == "--test" ]]; then
  T="$(mktemp -d)"; trap 'rm -rf "$T"; cleanup_id' EXIT
  if read_backup | tar -C "$T" -xf - 2>"$T.err"; then ok "extracts completely"; else fail "could not extract: $(head -1 "$T.err")"; exit 1; fi
  rm -f "$T.err"

  # count: under set -e and pipefail a find over a missing folder (a backup without ~/.claude/projects) used to end
  # the script silently, with no FAIL line and no verdict.
  count() { find "$@" 2>/dev/null | wc -l || true; }
  n=$(count "$T/.claude/projects" -maxdepth 2 -name '*.jsonl')
  (( n > 0 )) && ok "$n conversations" || fail "contains no conversations (~/.claude/projects)"
  s=$(count "$T/.claude/projects" -path '*/subagents/*.jsonl')
  ok "$s subagent conversations"
  # The 5 most recent conversations must be readable line by line (what claude -r does).
  bad=0
  while IFS= read -r f; do jq -e . "$f" >/dev/null 2>&1 || bad=$((bad + 1)); done \
    < <(find "$T/.claude/projects" -maxdepth 2 -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -5 | cut -d' ' -f2-)
  (( bad == 0 )) && ok "recent conversations read fine" || fail "$bad recent conversations damaged"
  for d in history.jsonl todos file-history settings.json; do
    [[ -e "$T/.claude/$d" ]] && ok ".claude/$d" || warn ".claude/$d not included (it may not exist on your machine)"
  done
  if [[ -e "$T/.local/share/tmux/resurrect/last" ]]; then
    ok "tmux: $(grep -c '^window' "$T/.local/share/tmux/resurrect/last" 2>/dev/null || echo 0) saved tabs"
  else fail "does not contain the tmux save"; fi
  # Backups made before the rename carry inventario/ with the Spanish file names.
  INV="$T/inventory" included=included.txt pending=repos-pending.txt
  [[ -d "$INV" ]] || { INV="$T/inventario" included=incluido.txt pending=repos-pendientes.txt; }
  if grep -qE 'mempalace' "$INV/$included" 2>/dev/null; then ok "MemPalace included"
  elif jq -er '.mcpServers.mempalace.command // ""' "$HOME/.claude.json" 2>/dev/null | grep -q '^/mnt/'; then
    ok "MemPalace runs on Windows: its data does not depend on WSL"
  else warn "MemPalace not included (add its folder to ~/.config/ws-backup/extra.txt)"; fi
  [[ -s "$INV/apt-manual.txt" ]] && ok "inventory for reinstalling ($(count "$INV" -maxdepth 1 -type f) files)" || fail "no package inventory"
  cred=$(find "$T" \( -name '.credentials.json' -o -path '*/.azure/*' -o -path '*/.kube/config' -o -path '*/.aws/credentials' -o -name 'age-identity*' \) 2>/dev/null | head -3 || true)
  [[ -z "$cred" ]] && ok "no credentials inside" || fail "contains credentials: $cred"
  if [[ -s "$INV/$pending" ]]; then
    warn "repos in ~/code with unpushed work at backup time:"; sed 's/^/           /' "$INV/$pending"
  fi
  echo; (( failures == 0 )) && echo "Can be restored." || { echo "✖ $failures failed"; exit 1; }
  exit 0
fi

#######################################
# --restore: into $HOME, without overwriting
#######################################
if pgrep -x claude >/dev/null; then echo "✖ Close Claude in every tab before restoring (it writes to ~/.claude)." >&2; exit 1; fi
echo "It will be extracted into $HOME. What exists and differs will be kept as <file>.~N~."
read -rp "Restore? [y/N] " r; [[ "$r" =~ ^([yY]([eE][sS])?|[sS]([iI]|í|Í)?)$ ]] || { echo "Cancelled."; exit 0; }
read_backup | tar -C "$HOME" --backup=numbered --exclude='inventory' --exclude='inventario' -xf -
mkdir -p "$HOME/.local/state/ws-restore"
inv=inventory   # inventario: backups made before the rename
read_backup | tar -C "$HOME/.local/state/ws-restore" -xf - inventory 2>/dev/null \
  || { inv=inventario; read_backup | tar -C "$HOME/.local/state/ws-restore" -xf - inventario; }
echo "✔ Restored. Inventory in ~/.local/state/ws-restore/$inv"
cat <<EOF

Next steps:
  1. Packages:   xargs -a ~/.local/state/ws-restore/$inv/apt-manual.txt sudo apt-get install -y
  2. Tools:      ws-tools install base cloud quality   (compare with $inv/ws-tools.txt)
  3. Logins:     claude auth login · az login · gh auth login · aws sso login
  4. tmux:       Ctrl+b Ctrl+r (restores tabs; each one resumes its conversation)
EOF
