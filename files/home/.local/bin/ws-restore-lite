#!/usr/bin/env bash
#
# ws-restore-lite — tests or restores a ws-backup-lite backup.
#
# Usage: ws-restore-lite [--probar | --restaurar] [FILE] [--identidad AGE_FILE]
#   --probar     (default) extracts into a temp folder and checks that everything can be
#                recovered: integrity, readable conversations, tmux, inventory and
#                that it does NOT contain credentials. Does not touch your $HOME.
#   --restaurar  extracts into $HOME. Asks for confirmation; will not run with Claude open; what
#                already exists and differs is kept as <file>.~N~ (no overwrite).
#   FILE         by default, the most recent backup in %UserProfile%\WSL-Backups\lite
# Order on a new machine: the kit's install.sh → ws-restore-lite --restaurar → logins.
set -euo pipefail
MODO="--probar" ARCH="" IDENT=""
while (( $# )); do
  case "$1" in
    --probar|--restaurar) MODO="$1" ;;
    --identidad) IDENT="${2:?missing identity file}"; shift ;;
    -h|--help) sed -n '3,13p' "$0"; exit 0 ;;
    *) ARCH="$1" ;;
  esac
  shift
done

win_home() {
  local p=""
  command -v wslvar >/dev/null && p="$(wslvar USERPROFILE 2>/dev/null || true)"
  [[ -n "$p" ]] || p="$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r' || true)"
  [[ -n "$p" ]] && wslpath -u "$p"
}
DEST="${WS_BACKUP_DEST:-$(win_home)/WSL-Backups/lite}"
if [[ -z "$ARCH" ]]; then
  ARCH="$(find "$DEST" -maxdepth 1 -name 'claude-lite-*.tar.*' ! -name '*.sha256' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"
fi
[[ -f "$ARCH" ]] || { echo "✖ No backup in $DEST (run ws-backup-lite)" >&2; exit 1; }

fallas=0
ok()    { printf '  \e[32mok\e[0m     %s\n' "$1"; }
aviso() { printf '  \e[33mwarn\e[0m   %s\n' "$1"; }
falla() { printf '  \e[31mFAIL\e[0m   %s\n' "$1"; fallas=$((fallas + 1)); }

echo "Backup: $ARCH ($(du -h "$ARCH" | cut -f1), $(( ($(date +%s) - $(stat -c %Y "$ARCH")) / 3600 )) h)"
if [[ -f "$ARCH.sha256" ]]; then
  if ( cd "$(dirname "$ARCH")" && sha256sum -c --quiet "$(basename "$ARCH").sha256" ) 2>/dev/null; then ok "SHA-256 checksum matches"
  else falla "the SHA-256 checksum does not match: damaged file"; exit 1; fi
else aviso "no .sha256 file"; fi

# leer — decrypts (if needed) and decompresses to stdout.
leer() {
  local a="$ARCH"
  if [[ "$a" == *.age ]]; then
    [[ -n "$IDENT" ]] || { echo "✖ encrypted backup: use --identidad <age file>" >&2; return 1; }
    age -d -i "$IDENT" "$a"; a="${a%.age}"
  else cat "$a"; fi | case "$a" in *.zst) zstd -dc -q ;; *.gz) gzip -dc ;; *) cat ;; esac
}

#######################################
# --probar: everything in a temp folder
#######################################
if [[ "$MODO" == "--probar" ]]; then
  T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
  if leer | tar -C "$T" -xf - 2>"$T.err"; then ok "extracts completely"; else falla "could not extract: $(head -1 "$T.err")"; exit 1; fi
  rm -f "$T.err"

  n=$(find "$T/.claude/projects" -maxdepth 2 -name '*.jsonl' 2>/dev/null | wc -l)
  (( n > 0 )) && ok "$n conversations" || falla "contains no conversations (~/.claude/projects)"
  s=$(find "$T/.claude/projects" -path '*/subagents/*.jsonl' 2>/dev/null | wc -l)
  ok "$s subagent conversations"
  # The 5 most recent conversations must be readable line by line (what claude -r does).
  malas=0
  while IFS= read -r f; do jq -e . "$f" >/dev/null 2>&1 || malas=$((malas + 1)); done \
    < <(find "$T/.claude/projects" -maxdepth 2 -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -5 | cut -d' ' -f2-)
  (( malas == 0 )) && ok "recent conversations read fine" || falla "$malas recent conversations damaged"
  for d in history.jsonl todos file-history settings.json; do
    [[ -e "$T/.claude/$d" ]] && ok ".claude/$d" || aviso ".claude/$d not included (it may not exist on your machine)"
  done
  if [[ -e "$T/.local/share/tmux/resurrect/last" ]]; then
    ok "tmux: $(grep -c '^window' "$T/.local/share/tmux/resurrect/last" 2>/dev/null || echo 0) saved tabs"
  else falla "does not contain the tmux save"; fi
  if grep -qE 'mempalace' "$T/inventario/incluido.txt" 2>/dev/null; then ok "MemPalace included"
  elif jq -er '.mcpServers.mempalace.command // ""' "$HOME/.claude.json" 2>/dev/null | grep -q '^/mnt/'; then
    ok "MemPalace runs on Windows: its data does not depend on WSL"
  else aviso "MemPalace not included (add its folder to ~/.config/ws-backup/extra.txt)"; fi
  [[ -s "$T/inventario/apt-manual.txt" ]] && ok "inventory for reinstalling ($(ls "$T/inventario" | wc -l) files)" || falla "no package inventory"
  cred=$(find "$T" \( -name '.credentials.json' -o -path '*/.azure/*' -o -path '*/.kube/config' -o -path '*/.aws/credentials' -o -name 'age-identity*' \) 2>/dev/null | head -3)
  [[ -z "$cred" ]] && ok "no credentials inside" || falla "contains credentials: $cred"
  if [[ -s "$T/inventario/repos-pendientes.txt" ]]; then
    aviso "repos in ~/code with unpushed work at backup time:"; sed 's/^/           /' "$T/inventario/repos-pendientes.txt"
  fi
  echo; (( fallas == 0 )) && echo "Can be restored." || { echo "✖ $fallas failed"; exit 1; }
  exit 0
fi

#######################################
# --restaurar: into $HOME, without overwriting
#######################################
if pgrep -x claude >/dev/null; then echo "✖ Close Claude in every tab before restoring (it writes to ~/.claude)." >&2; exit 1; fi
echo "It will be extracted into $HOME. What exists and differs will be kept as <file>.~N~."
read -rp "Restore? [y/N] " r; [[ "$r" =~ ^([yY]([eE][sS])?|[sS]([iI]|í|Í)?)$ ]] || { echo "Cancelled."; exit 0; }
leer | tar -C "$HOME" --backup=numbered --exclude='inventario' -xf -
mkdir -p "$HOME/.local/state/ws-restore"
leer | tar -C "$HOME/.local/state/ws-restore" -xf - inventario
echo "✔ Restored. Inventory in ~/.local/state/ws-restore/inventario"
cat <<EOF

Next steps:
  1. Packages:   xargs -a ~/.local/state/ws-restore/inventario/apt-manual.txt sudo apt-get install -y
  2. Tools:      ws-tools install base nube calidad   (compare with inventario/ws-tools.txt)
  3. Logins:     claude auth login · az login · gh auth login · aws sso login
  4. tmux:       Ctrl+b Ctrl+r (restores tabs; each one resumes its conversation)
EOF
