#!/usr/bin/env bash
#
# ws-history — looks for possible secrets in the bash history WITHOUT showing them: only the line number and
# the first command of the line (curl, export…). Single source of the pattern for ws-audit.
#
# Usage:
#   ws-history              lists the suspicious lines (exits with 1 if there are any)
#   ws-history --count     prints only how many there are (for ws-audit)
#   ws-history --clean    deletes them after confirming. No backup on purpose: the backup would keep
#                             the same secrets. Deleting does NOT replace rotating the credentials.
set -euo pipefail

f="${WS_HISTFILE:-$HOME/.bash_history}"
# Upper and lower case (grep -i). Formats with the value after = or after a space.
PATTERN='(ghp_|github_pat_|sk-ant-|xox[bp]-|AKIA[0-9A-Z]{16}|AccountKey=|SharedAccessSignature|client_secret=|(pass(word|wd)?|pwd|secret|token|api[_-]?key)=[^ &'"'"'"]{6,}|--(password|client-secret|secret|token)[= ]+[^ ]{6,}|Authorization: *Bearer +[A-Za-z0-9._-]{20,})'

[[ -f "$f" ]] || { [[ "${1:-}" == --count ]] && echo 0 || echo "ok  $f does not exist"; exit 0; }

# Suspicious line numbers; if the previous one is a timestamp (#1700000000) it is deleted too.
mapfile -t L < <(grep -niE -- "$PATTERN" "$f" | cut -d: -f1 | sort -un)

case "${1:-}" in
  --count) echo "${#L[@]}"; exit 0 ;;
  ""|--clean) ;;
  *) echo "Usage: ws-history [--count|--clean]" >&2; exit 2 ;;
esac

if (( ${#L[@]} == 0 )); then echo "ok  no apparent secrets in ${f/#"$HOME"/\~}"; exit 0; fi

echo "Possible secrets in ${f/#"$HOME"/\~} (values are not shown):"
for n in "${L[@]}"; do printf '  line %-6s  %s …\n' "$n" "$(sed -n "${n}p" "$f" | awk '{print $1}')"; done

[[ "${1:-}" == --clean ]] || { echo "Rotate those credentials and then: ws-history --clean"; exit 1; }

read -rp "Delete these ${#L[@]} lines from the history? [y/N] " r
[[ "$r" =~ ^([yY]([eE][sS])?|[sS]([iI]|í|Í)?)$ ]] || { echo "  Nothing was deleted."; exit 1; }
expr=""
for n in "${L[@]}"; do
  expr+="${n}d;"
  (( n > 1 )) && sed -n "$((n - 1))p" "$f" | grep -qE '^#[0-9]+$' && expr+="$((n - 1))d;"
done
sed -i "$expr" "$f"
chmod 600 "$f"
echo "  done    ${#L[@]} lines deleted; $(ws_n=$(grep -ciE -- "$PATTERN" "$f" || true); echo "${ws_n:-0}") suspicious ones left."
echo "  Important: in every terminal still open run  history -c; history -r  (or close it);"
echo "  otherwise it may write those lines back on exit."
