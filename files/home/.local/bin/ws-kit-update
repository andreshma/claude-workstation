#!/usr/bin/env bash
#
# ws-kit-update — updates the workstation from the kit on GitHub (andreshma/claude-workstation), with rollback.
#
# Usage:
#   ws-kit-update             checks and, if there is a new version, asks and applies it
#   ws-kit-update --check   only reports whether there is a new version (exit 10 = yes; 0 = no). ws-telegram runs it hourly.
#   ws-kit-update --apply   applies without asking (for use from another script)
#
# Apply = git pull --ff-only → install.sh (copies every file that changes to ~/.local/share/ws-kit/backup.<date>/)
# → ws-test. If ws-test fails, it goes back to the previous commit and reinstalls (the rollback is the kit's git
# history, not the backup folders); it reports the result over Telegram if configured.
# It touches nothing if you have uncommitted local changes or unpushed commits (on your main machine the kit
# is usually ahead: there is nothing to pull there).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
KIT="${WS_KIT:-$HOME/code/claude-workstation}"
mode="${1:-}"
die() { echo "✖ $*" >&2; exit 1; }
notify_tg() { command -v ws-telegram >/dev/null && ws-telegram active 2>/dev/null && ws-telegram send "$1" >/dev/null 2>&1 || true; }

[[ -d "$KIT/.git" ]] || die "kit not found in $KIT"
cd "$KIT" || exit 1
git fetch -q origin 2>/dev/null || die "could not reach GitHub (git fetch)"
local_="$(git rev-parse HEAD)"; remote="$(git rev-parse '@{u}' 2>/dev/null)" || die "the branch does not track origin"
behind="$(git rev-list --count 'HEAD..@{u}')"; ahead="$(git rev-list --count '@{u}..HEAD')"
remote_ver="$(git describe --tags --abbrev=0 '@{u}' 2>/dev/null || echo "${remote:0:7}")"
local_ver="$(git describe --tags --abbrev=0 HEAD 2>/dev/null || echo "${local_:0:7}")"

if (( behind == 0 )); then
  [[ "$mode" == --check ]] || echo "✔ Up to date ($local_ver)$( (( ahead )) && echo "; you have $ahead unpushed commits")"
  exit 0
fi
news="$(git log --format='• %s' 'HEAD..@{u}' | head -12)"
if [[ "$mode" == --check ]]; then
  printf 'New kit version: %s (you have %s, %s commits behind)\n%s\n' "$remote_ver" "$local_ver" "$behind" "$news"
  exit 10
fi

echo "New version: $remote_ver (you have $local_ver, $behind commits behind)"; echo "$news"
[[ -z "$(git status --porcelain)" ]] || die "uncommitted changes in the kit; push or discard them before updating"
(( ahead == 0 )) || die "you have $ahead unpushed commits; run git push first (or git pull --rebase by hand)"
if [[ "$mode" != --apply ]]; then
  read -rp "Update now? [y/N] " r; [[ "$r" =~ ^([yY]([eE][sS])?|[sS]([iI]|í|Í)?)$ ]] || { echo "Nothing changed."; exit 0; }
fi

echo "==> Pulling $remote_ver"
git pull -q --ff-only || die "git pull failed; nothing changed"
echo "==> Installing (every file that changes is copied first to ~/.local/share/ws-kit/backup.<date>/)"
if ! bash install.sh; then
  echo "✖ install.sh failed: going back to $local_ver"; git reset -q --hard "$local_"; bash install.sh >/dev/null 2>&1
  notify_tg "🔴 ws-kit-update: install.sh failed on $remote_ver; rolled back to $local_ver."; exit 1
fi
echo "==> Testing (ws-test)"
if ! ws-test; then
  echo "✖ The tests failed: going back to $local_ver"; git reset -q --hard "$local_"; bash install.sh >/dev/null 2>&1
  notify_tg "🔴 ws-kit-update: the tests failed on $remote_ver; rolled back to $local_ver. Check on the PC: ws-test"
  exit 1
fi
tmux source-file "$HOME/.tmux.conf" 2>/dev/null || true
echo "✔ Workstation at $remote_ver. Claude sessions already open pick up hooks and settings when restarted."
notify_tg "✅ Workstation updated to $remote_ver."
