#!/usr/bin/env bash
#
# ws-kit-update — updates the workstation from the kit on GitHub (andreshma/claude-workstation) to the newest SIGNED
# release, with rollback.
#
# Usage:
#   ws-kit-update                    checks and, if there is a new signed release, asks and applies it
#   ws-kit-update --check            only reports (exit 10 = a new signed release; 11 = a newer release whose signature
#                                    fails; 0 = nothing). ws-telegram runs it hourly.
#   ws-kit-update --apply            applies without asking (for use from another script)
#   ws-kit-update --allow-unsigned   accepts a release tag without a valid signature (forks without a key); logged
#
# Only release tags count, never the branch tip: it fetches the vX.Y.Z tags, takes the newest one ahead of HEAD and
# runs `git verify-tag` with the allowed signers in ~/.config/ws-kit/allowed_signers (+ allowed_signers.local). The
# check uses the INSTALLED signers file, not the one in the release, so a release cannot vouch for itself.
# Apply = git merge --ff-only <tag> → install.sh (copies every file that changes to
# ~/.local/share/ws-kit/backup.<date>/) → ws-test. If ws-test fails, it goes back to the previous commit and reinstalls (the rollback is the kit's git
# history, not the backup folders); it reports the result over Telegram if configured.
# It touches nothing if you have uncommitted local changes or commits the release does not contain (on your main
# machine the kit is usually ahead: there is nothing to apply there).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
KIT="${WS_KIT:-$HOME/code/claude-workstation}"
SIGNERS="${WS_KIT_SIGNERS:-$HOME/.config/ws-kit/allowed_signers}"
LOG="${WS_KIT_UPDATE_LOG:-$HOME/.local/state/ws-kit-update.log}"
NS="refs/ws-kit/tags"            # remote tags are fetched here, so a moved tag never overwrites a local one
mode="" unsigned=0
for a in "$@"; do
  case "$a" in
    --check|--apply) mode="$a" ;;
    --allow-unsigned) unsigned=1 ;;
    -h|--help) sed -n '3,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac
done
die() { echo "✖ $*" >&2; exit 1; }
notify_tg() { command -v ws-telegram >/dev/null && ws-telegram active 2>/dev/null && ws-telegram send "$1" >/dev/null 2>&1 || true; }
record() { mkdir -p "$(dirname "$LOG")" && printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"; }

#######################################
# Verifies a fetched release tag: an annotated tag whose own name matches the ref, signed by an allowed key.
# Arguments: tag name (vX.Y.Z). Outputs: the reason on failure. Returns: 0 if valid.
#######################################
verify_release() {
  local t="$1" ref="$NS/$1" keys rc
  [[ "$(git cat-file -t "$ref" 2>/dev/null)" == tag ]] || { echo "$t is a lightweight tag (no signature)"; return 1; }
  [[ "$(git cat-file tag "$ref" | sed -n 's/^tag //p' | head -1)" == "$t" ]] \
    || { echo "$t points to a tag object named otherwise"; return 1; }
  keys="$(mktemp)"; cat "$SIGNERS" "$SIGNERS.local" 2>/dev/null | grep -vE '^[[:space:]]*(#|$)' > "$keys"
  if [[ ! -s "$keys" ]]; then rm -f "$keys"; echo "no maintainer key in ${SIGNERS/#"$HOME"/\~}"; return 1; fi
  git -c gpg.ssh.allowedSignersFile="$keys" verify-tag "$ref" >/dev/null 2>&1; rc=$?; rm -f "$keys"
  (( rc == 0 )) || { echo "the signature of $t does not verify against the allowed signers"; return 1; }
}

[[ -d "$KIT/.git" ]] || die "kit not found in $KIT"
cd "$KIT" || exit 1
git fetch -q --prune --no-tags origin "+refs/tags/v*:$NS/v*" 2>/dev/null || die "could not reach GitHub (git fetch)"
local_="$(git rev-parse HEAD)"
local_ver="$(git describe --tags --abbrev=0 HEAD 2>/dev/null || echo "${local_:0:7}")"

# Newest vX.Y.Z (version order) whose commit is not in HEAD yet.
tag=""
while IFS= read -r t; do
  [[ "$t" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
  git merge-base --is-ancestor "$NS/$t^{commit}" HEAD 2>/dev/null && break   # this one and older ones are in HEAD
  tag="$t"; break
done < <(git for-each-ref --format='%(refname:strip=3)' "$NS/" | sort -rV)

if [[ -z "$tag" ]]; then
  [[ "$mode" == --check ]] || echo "✔ Up to date ($local_ver)"
  exit 0
fi
target="$(git rev-parse "$NS/$tag^{commit}")"
if why="$(verify_release "$tag")"; then signed="signed ✔"
elif (( unsigned )); then signed="UNSIGNED (--allow-unsigned: $why)"
else
  if [[ "$mode" == --check ]]; then printf 'Kit release %s found, but %s: not offered.\n' "$tag" "$why"; exit 11; fi
  record "refused $tag: $why"
  notify_tg "🚨 ws-kit-update refused $tag: $why. Nothing was installed."
  die "$tag refused: $why. Nothing changed. Forks without a key: ws-kit-update --allow-unsigned"
fi
behind="$(git rev-list --count "HEAD..$target")"; extra="$(git rev-list --count "$target..HEAD")"
news="$(git log --format='• %s' "HEAD..$target" | head -12)"
if [[ "$mode" == --check ]]; then
  printf 'New kit version: %s, %s (you have %s, %s commits behind)\n%s\n' \
    "$tag" "$signed" "$local_ver" "$behind" "$news"
  exit 10
fi

echo "New version: $tag, $signed (you have $local_ver, $behind commits behind)"; echo "$news"
[[ -z "$(git status --porcelain)" ]] || die "uncommitted changes in the kit; push or discard them before updating"
(( extra == 0 )) || die "you have $extra commits that $tag does not contain; update by hand (git merge $tag)"
if [[ "$mode" != --apply ]]; then
  read -rp "Update now? [y/N] " r; [[ "$r" =~ ^([yY]([eE][sS])?|[sS]([iI]|í|Í)?)$ ]] || { echo "Nothing changed."; exit 0; }
fi
if (( unsigned )); then
  record "applied UNSIGNED $tag (--allow-unsigned): $why"
  notify_tg "⚠️ ws-kit-update: $tag applied without a valid signature (--allow-unsigned)."
fi

echo "==> Moving to $tag"
git merge -q --ff-only "$target" || die "git merge --ff-only failed; nothing changed"
record "applied $tag ($signed) from $local_ver"
echo "==> Installing (every file that changes is copied first to ~/.local/share/ws-kit/backup.<date>/)"
if ! bash install.sh; then
  echo "✖ install.sh failed: going back to $local_ver"; git reset -q --hard "$local_"; bash install.sh >/dev/null 2>&1
  record "rolled back $tag: install.sh failed"
  notify_tg "🔴 ws-kit-update: install.sh failed on $tag; rolled back to $local_ver."; exit 1
fi
echo "==> Testing (ws-test)"
if ! ws-test; then
  echo "✖ The tests failed: going back to $local_ver"; git reset -q --hard "$local_"; bash install.sh >/dev/null 2>&1
  record "rolled back $tag: ws-test failed"
  notify_tg "🔴 ws-kit-update: the tests failed on $tag; rolled back to $local_ver. Check on the PC: ws-test"
  exit 1
fi
tmux source-file "$HOME/.tmux.conf" 2>/dev/null || true
echo "✔ Workstation at $tag. Claude sessions already open pick up hooks and settings when restarted."
notify_tg "✅ Workstation updated to $tag."
