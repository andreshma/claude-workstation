#!/usr/bin/env bash
#
# ws-completions — generates Tab completion for the installed tools in
# ~/.local/share/bash-completion/completions (bash-completion loads them on the first Tab of
# each command). Each file is produced by the tool itself, not by a downloaded script.
# Run it again after installing tools (ws-update can call it).
set -uo pipefail
D="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
mkdir -p "$D"
ok=() no=()

# gen <command> <file> <generator...> — writes only if the command exists and generates something.
gen() {
  local cmd="$1" f="$2"; shift 2
  command -v "$cmd" >/dev/null 2>&1 || return 0
  if timeout 20 "$@" > "$D/$f.tmp" 2>/dev/null && [[ -s "$D/$f.tmp" ]]; then mv "$D/$f.tmp" "$D/$f"; ok+=("$cmd")
  else rm -f "$D/$f.tmp"; no+=("$cmd"); fi
}
# lin <command> <complete line> — for tools that complete themselves (complete -C).
lin() { command -v "$1" >/dev/null 2>&1 || return 0; printf '%s\n' "$2" > "$D/$1"; ok+=("$1"); }

gen kubectl kubectl kubectl completion bash
gen helm    helm    helm completion bash
gen gh      gh      gh completion -s bash
gen fnm     fnm     fnm completions --shell bash
gen pnpm    pnpm    pnpm completion bash
gen npm     npm     npm completion
gen rustup  rustup  rustup completions bash
gen cargo   cargo   rustup completions bash cargo
gen uv      uv      uv generate-shell-completion bash
gen docker  docker  docker completion bash
gen kind    kind    kind completion bash
gen k9s     k9s     k9s completion bash
gen starship starship starship completions bash
lin terraform "complete -C $(command -v terraform 2>/dev/null) terraform"
lin aws       "complete -C $(command -v aws_completer 2>/dev/null || echo aws_completer) aws"
lin az        "[[ -f /etc/bash_completion.d/azure-cli ]] && source /etc/bash_completion.d/azure-cli"
if command -v register-python-argcomplete >/dev/null; then gen pipx pipx register-python-argcomplete pipx; fi

printf 'Completion ready for: %s\n' "${ok[*]:-none}"
(( ${#no[@]} )) && printf 'Could not generate: %s\n' "${no[*]}"
exit 0
