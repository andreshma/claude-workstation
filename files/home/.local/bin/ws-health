#!/usr/bin/env bash
#
# ws-health — resilience checks for the workstation: disk space, distro snapshot,
# tmux save up to date and kit in sync. Exit 1 if anything fails.
set -uo pipefail
W=@WINHOME@
fail=0
ok()  { printf '%-46s OK\n' "$1"; }
bad() { printf '%-46s FAIL   %s\n' "$1" "$2"; fail=1; }
pct_free() { df -P "$1" | awk 'NR==2 { sub("%", "", $5); print 100 - $5 }'; }

echo "== Resilience"
f="$(pct_free / 2>/dev/null)"; f="${f:-0}"
if (( f >= 15 )); then ok "free space on / ($f %)"; else bad "free space on / ($f %)" "free up space (minimum 15 %)"; fi
# On C: absolute space is what counts: 15 % of a 1 TB disk is too much margin.
g="$(df -BG --output=avail /mnt/c 2>/dev/null | tail -1 | tr -dc '0-9')"; g="${g:-0}"
if (( g >= 50 )); then ok "free space on /mnt/c ($g GB)"; else bad "free space on /mnt/c ($g GB)" "free up space (minimum 50 GB)"; fi

# The daily light backup (ws-backup-lite) is enough; the full snapshot is optional.
lite="$(find "${WS_BACKUP_DEST:-$W/WSL-Backups/lite}" -maxdepth 1 -name 'claude-lite-*.tar.*' ! -name '*.sha256' -printf '%T@\n' 2>/dev/null | sort -rn | head -1)"
snap="$(find "$W/WSL-Backups" -maxdepth 1 -name 'Ubuntu-*.vhdx' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1)"
if [[ -n "$lite" ]] && (( $(date +%s) - ${lite%%.*} < 2 * 86400 )); then ok "light backup of Claude (<2 days)"
elif [[ -n "$snap" ]] && (( $(date +%s) - ${snap%%.*} < 8 * 86400 )); then ok "distro snapshot (<8 days)"
else bad "light backup or snapshot" "run ws-backup-lite (Menu → Workstation)"; fi

last="$HOME/.local/share/tmux/resurrect/last"
saved="$(grep -c '^window' "$last" 2>/dev/null)"; saved="${saved:-0}"
open="$(tmux list-windows -a 2>/dev/null | wc -l)"
if (( saved > 0 )) && (( open == 0 || saved == open )); then ok "tmux save up to date ($saved tabs)"
else bad "tmux save up to date" "$saved saved vs $open open: Ctrl+b Ctrl+s"; fi
# The save runs every minute and tmux-recover --validate refreshes the date of a good save: an old date with tmux
# running means the saving stopped, which nothing else would show until the next restart.
if (( open > 0 )); then
  age=$(( $(date +%s) - $(stat -c %Y "$(readlink -f "$last")" 2>/dev/null || echo 0) ))
  up=$(( $(date +%s) - $(tmux display -p '#{start_time}' 2>/dev/null || date +%s) ))
  if (( up < 300 || age < 300 )); then ok "tmux save confirmed in the last 5 min"
  else bad "tmux save confirmed in the last 5 min" "last confirmed $(( age / 60 )) min ago: Ctrl+b Ctrl+s, then check continuum"; fi
fi

k="$HOME/code/claude-workstation"
if [[ -d "$k/.git" && -z "$(git -C "$k" status --porcelain 2>/dev/null)" && -z "$(git -C "$k" log --oneline '@{u}..' 2>/dev/null)" ]]; then
  ok "kit has no pending changes"
else bad "kit has no pending changes" "export.sh, commit and push"; fi
exit "$fail"
