#!/usr/bin/env bash
#
# tmux-hud — real-time resource monitor on the SECOND line of the tmux status bar (it covers nothing and does not
# steal focus). Ctrl+b v shows or hides it.
#   CPU ▁▂▅▇ 43%  RAM ▃▄▄▅ 61% 9.8/16G  NET ↓1.2M ↑180K  C: 38% free  $4.2/h  Claude 🧠2 ✋1 ✔5
# CPU, RAM and network come from /proc (WSL); sparklines with the last 16 samples (one per status bar refresh).
# The whole MACHINE: the active tab's own panel (tmux-res) is drawn before it, labelled «tab» and «host».
# Every field has a fixed width (%3d%%, 4-column byte rates, counts in 2 columns): the line never shifts.
# $/h: API equivalent of the last 10 min (ws-telemetry rate, every 60 s). Claude: tabs working, waiting for
# you and done (tmux-status).
# Usage: tmux-hud              (called by the status bar with #(…))
#        tmux-hud --toggle   shows or hides the second line
set -uo pipefail
export LC_ALL=C.UTF-8   # ${#s} and printf widths count characters, not bytes
ST="${XDG_RUNTIME_DIR:-/tmp}/tmux-hud-$(id -u)"; mkdir -p "$ST" 2>/dev/null && chmod 700 "$ST"
BARS="▁▂▃▄▅▆▇█"

if [[ "${1:-}" == --toggle ]]; then
  if [[ "$(tmux show -gv status 2>/dev/null)" == 2 ]]; then tmux set -g status on \; set -g @hud off; tmux display "Monitor hidden (Ctrl+b v)"
  else tmux set -g status 2 \; set -g @hud on; tmux display "Monitor visible (Ctrl+b v hides it)"; fi
  exit 0
fi

tc() { local v; v="$(tmux show -gqv "@t_$1" 2>/dev/null)"; printf '%s' "${v:-$2}"; }
spark() {   # file value(0-100) → sparkline of the last 16 samples
  local f="$ST/$1" v="$2" s="" n
  { [[ -f "$f" ]] && tail -n 15 "$f"; echo "$v"; } > "$f.tmp" && mv "$f.tmp" "$f"
  while read -r n; do s+="${BARS:$(( n * 7 / 100 )):1}"; done < "$f"
  printf '%s' "$s"
}
# human <bytes> → always 4 columns: "  0B" "999B" "1.2K" " 12K" "999K" "1.0M" … (binary units)
human() {
  awk -v b="$1" 'BEGIN { split("B K M G T", u, " "); i = 1; v = b + 0; if (v < 0) v = 0
    if (v < 999.5) { printf "%3d%s", v + 0.5, u[1]; exit }
    for (i = 2; i <= 5; i++) { v /= 1024; if (v < 9.95) { printf "%3.1f%s", v, u[i]; exit }
      if (v < 999.5) { printf "%3d%s", v + 0.5, u[i]; exit } }
    printf "999T" }'
}
color() {   # percentage → color (ok, warning, alert)
  if (( $1 >= 85 )); then tc alert colour196; elif (( $1 >= 65 )); then tc tool colour214; else tc ok colour82; fi
}

# CPU: difference of /proc/stat against the previous sample.
read -r _ u n s i w q sq st _ < /proc/stat
tot=$(( u + n + s + i + w + q + sq + st )); idle=$(( i + w ))
t0=$tot; o0=$idle; [[ -f "$ST/cpu" ]] && read -r t0 o0 < "$ST/cpu"
echo "$tot $idle" > "$ST/cpu"
dt=$(( tot - t0 )); cpu=0; (( dt > 0 )) && cpu=$(( 100 * (dt - (idle - o0)) / dt ))
# RAM
tm=$(awk '/^MemTotal/ {print $2}' /proc/meminfo); avail=$(awk '/^MemAvailable/ {print $2}' /proc/meminfo)
ram=$(( 100 * (tm - avail) / tm ))
ramtxt="$(awk -v u=$(( tm - avail )) -v t="$tm" 'BEGIN { printf "%5.1f/%.0fG", u / 1048576, t / 1048576 }')"
# Network: bytes per second since the previous sample (every interface except lo).
read -r rx tx < <(awk -F'[: ]+' 'NR > 2 && $2 != "lo" { r += $3; t += $11 } END { print r + 0, t + 0 }' /proc/net/dev)
now=$(date +%s)
r0=$rx; x0=$tx; a0=$((now - 1)); [[ -f "$ST/net" ]] && read -r r0 x0 a0 < "$ST/net"
echo "$rx $tx $now" > "$ST/net"
secs=$(( now - a0 )); (( secs < 1 )) && secs=1
down=$(( (rx - r0) / secs )); up=$(( (tx - x0) / secs )); (( down < 0 )) && down=0; (( up < 0 )) && up=0
# Disk C: (every 60 s) and $/h (every 60 s, in the background)
if [[ ! -f "$ST/disk" ]] || (( now - $(stat -c %Y "$ST/disk") > 60 )); then
  df -P /mnt/c 2>/dev/null | awk 'NR == 2 { gsub("%", "", $5); print 100 - $5 }' > "$ST/disk"
fi
disk="$(cat "$ST/disk" 2>/dev/null)"
if command -v ws-cache >/dev/null && command -v ws-telemetry >/dev/null; then
  usd="$(ws-cache 60 ws-telemetry rate 2>/dev/null | jq -r '.usd_h // empty' 2>/dev/null)"
fi
# Claude: tabs by phase
read -r working waiting finished < <(tmux list-windows -a -F '#{@cphase}' 2>/dev/null | awk '
  /^(thinking|tool|compacting)$/ { t++ } /^(permission|question|yourturn|error)$/ { e++ } /^(done|interrupted)$/ { l++ }
  END { print t + 0, e + 0, l + 0 }')

D="$(tc dim colour244)"
spark_fixed() { local s; s="$(spark "$@")"; while (( ${#s} < 16 )); do s=" $s"; done; printf '%s' "$s"; }
printf '#[fg=%s]CPU #[fg=%s]%s %3d%%  #[fg=%s]RAM #[fg=%s]%s %3d%% #[fg=%s]%s  NET #[default]↓%s ↑%s' \
  "$D" "$(color "$cpu")" "$(spark_fixed cpu.h "$cpu")" "$cpu" "$D" "$(color "$ram")" "$(spark_fixed ram.h "$ram")" "$ram" \
  "$D" "$ramtxt" "$(human "$down")" "$(human "$up")"
[[ -n "$disk" ]] && printf '  #[fg=%s]C: #[fg=%s]%3d%% free' "$D" "$(color $(( 100 - disk )))" "$disk"
# $/h: the slot stays when there is no value yet, so the counts after it do not move.
command -v ws-telemetry >/dev/null && printf '  #[fg=%s]$#[default]%5s/h' "$D" "${usd:---}"
printf '  #[fg=%s]Claude #[fg=%s]🧠%2d #[fg=%s]✋%2d #[fg=%s]✔%2d#[default]' "$D" "$(tc think colour39)" "$working" \
  "$(tc alert colour196)" "$waiting" "$(tc ok colour82)" "$finished"
