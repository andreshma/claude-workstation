#!/usr/bin/env bash
#
# tmux-save-now — saves the tmux session as soon as its structure changes (tab created,
# closed, renamed, pane created or closed). Called by tmux hooks; it batches consecutive
# changes: it saves at most once every 10 s and in the background. tmux-background also calls it
# once a minute, so the save and its «confirmed» date do not depend on continuum.
set -uo pipefail
# Right after the server starts, tmux is still restoring: saving now would overwrite the last good
# save with an empty session (it happened on 2026-11-14). continuum takes over afterwards.
started="$(tmux display -p '#{start_time}' 2>/dev/null || echo 0)"
(( $(date +%s) - started >= 180 )) || exit 0
stamp="/tmp/tmux-save-now-$(id -u)"
now="$(date +%s)"; last="$(cat "$stamp" 2>/dev/null || echo 0)"
(( now - last >= 10 )) || exit 0
echo "$now" > "$stamp"
sleep 2   # let tmux finish applying the change before saving
"$HOME/.tmux/plugins/tmux-resurrect/scripts/save.sh" quiet >/dev/null 2>&1
exit 0
