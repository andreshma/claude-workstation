#!/usr/bin/env bash
#
# tmux-recuperar — recovers the tmux tabs from any tmux-resurrect save.
#
# Usage:
#   tmux-recuperar                 lists the saves (time, tabs, names) and restores the chosen one
#   tmux-recuperar --marcar-arranque   (called by .tmux.conf when the server starts) remembers which was the
#                                  last save BEFORE anything could overwrite it with an empty session
#   tmux-recuperar --auto-arranque     (called by .tmux.conf in the background) if after startup the session
#                                  ended up empty and the startup save had tabs, it restores it by itself
#   tmux-recuperar --validar       (resurrect post-save-all hook) if a save came out empty (it happens when
#                                  closing tmux: panes close while it is saving), it deletes it
#                                  and points "last" at the latest save with tabs
# It only deletes empty saves; for the rest, it changes what "last" points to and uses resurrect's restore.
# WS_RECUPERAR_ESPERA: seconds to wait before auto-restoring (20; the tests use less).
set -uo pipefail
R="$HOME/.local/share/tmux/resurrect"
RESTORE="$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
MARCA="$R/last-al-arrancar"

edad_servidor() { echo $(( $(date +%s) - $(tmux display -p '#{start_time}' 2>/dev/null || echo 0) )); }
pestanas() { local n; n="$(grep -c '^window' "$1" 2>/dev/null)"; echo "${n:-0}"; }
# nombres <file> — names of the saved tabs, comma-separated.
nombres() { awk -F'\t' '$1 == "window" { sub(/^:/, "", $4); printf "%s%s", (n++ ? ", " : ""), $4 }' "$1" 2>/dev/null; }

# ultimo_valido [EXCLUDE] — the most recent save that is not empty and has at least one tab.
ultimo_valido() {
  local f
  while IFS= read -r f; do
    [[ "$f" == "${1:-}" ]] && continue
    [[ -s "$f" ]] && (( $(pestanas "$f") >= 1 )) && { echo "$f"; return 0; }
  done < <(find "$R" -maxdepth 1 -name 'tmux_resurrect_*.txt' -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-)
  return 1
}

restaurar() {
  ln -sf "$1" "$R/last"
  # -b: the restore runs inside the tmux server; the caller does not wait for it
  # (a synchronous run-shell from a pane can hang while the panes are being recreated).
  tmux run-shell -b "$RESTORE"
  tmux display "Restored: $(basename "$1") ($(pestanas "$1") tabs)"
}

case "${1:-}" in
  --marcar-arranque)
    # Only on a real server start (not when reloading the configuration). If "last" ended up
    # empty (interrupted shutdown), the latest save with tabs is marked.
    (( $(edad_servidor) < 30 )) || exit 0
    obj="$(readlink -f "$R/last" 2>/dev/null)"
    if [[ -s "$obj" ]] && (( $(pestanas "$obj") >= 1 )); then cp -P "$R/last" "$MARCA"
    elif bueno="$(ultimo_valido)"; then ln -sf "$bueno" "$MARCA"; fi
    exit 0 ;;

  --validar)
    obj="$(readlink -f "$R/last" 2>/dev/null)"
    [[ -n "$obj" ]] || exit 0
    if [[ ! -s "$obj" ]] || (( $(pestanas "$obj") == 0 )); then
      bueno="$(ultimo_valido "$obj")" && ln -sf "$bueno" "$R/last"
      [[ -s "$obj" ]] || rm -f "$obj"                   # only empty saves are deleted
    fi
    exit 0 ;;

  --auto-arranque)
    sleep "${WS_RECUPERAR_ESPERA:-20}"   # lets continuum finish; if it restored, there are tabs by now
    obj="$(readlink -f "$MARCA" 2>/dev/null)"
    [[ -s "$obj" ]] || obj="$(ultimo_valido)" || exit 0
    abiertas="$(tmux list-windows -a 2>/dev/null | wc -l)"
    guardadas="$(pestanas "$obj")"
    # Only if the session ended up practically empty, the save had more and it is from the last 24 h.
    if (( abiertas <= 1 && guardadas >= 2 )) && (( $(date +%s) - $(stat -c %Y "$obj") < 86400 )); then
      restaurar "$obj"
    fi
    exit 0 ;;
esac

# Interactive: pick a save with fzf.
command -v fzf >/dev/null || { echo "fzf is missing"; exit 1; }
marca="$(readlink -f "$MARCA" 2>/dev/null || true)"
elegido="$(
  find "$R" -maxdepth 1 -name 'tmux_resurrect_*.txt' -printf '%T@ %p\n' | sort -rn | head -40 | cut -d' ' -f2- |
  while IFS= read -r f; do
    t="$(basename "$f" .txt)"; t="${t#tmux_resurrect_}"
    etiqueta=""; [[ "$f" == "$marca" ]] && etiqueta="  ← at startup"
    printf '%s\t%s %s:%s  %2s tabs  %s%s\n' "$f" "${t:0:4}-${t:4:2}-${t:6:2}" "${t:9:2}" "${t:11:2}" \
      "$(pestanas "$f")" "$(nombres "$f" | cut -c1-70)" "$etiqueta"
  done | fzf --with-nth=2.. --delimiter='\t' --no-sort --reverse \
      --header='Pick the save to restore (the most recent one with your tabs, before the problem)' \
  | cut -f1
)"
[[ -n "$elegido" ]] || exit 0
read -rp "Restore $(basename "$elegido") ($(pestanas "$elegido") tabs)? [y/N] " r
[[ "$r" =~ ^([yY]([eE][sS])?|[sS]([iIíÍ])?)$ ]] && restaurar "$elegido"
