#!/usr/bin/env bash
#
# tmux-panel — manda a Claude la salida de otro panel (pruebas, build, logs) sin copiar y pegar. Ctrl+b e.
#
# Toma las últimas N líneas del otro panel de la pestaña (si hay varios, el último que usaste; si no hay otro,
# te deja elegir cualquier panel), las redacta (ws-redactar) y las PEGA en el prompt de Claude dentro de un
# bloque de código, sin Enter: tú escribes qué hacer con eso y lo envías.
#
# Uso: tmux-panel <panel-de-Claude> [--lineas 200]       (Ctrl+b e lo llama con el panel actual)
#      tmux-panel --elegir <panel-de-Claude> [--lineas N] (interno: lista de paneles con fzf en una flotante)
#      tmux-panel --texto <panel-origen> [--lineas N]    (solo imprime el bloque; para pruebas)
set -uo pipefail
TAB=$'\t'
modo=pegar
case "${1:-}" in --elegir) modo=elegir; shift ;; --texto) modo=texto; shift ;; esac
destino="${1:?panel}"; shift
lineas=200; [[ "${1:-}" == --lineas && "${2:-}" =~ ^[0-9]+$ ]] && lineas="$2"

bloque() {   # panel-origen → texto listo para pegar
  local o="$1" cmd dir txt
  cmd="$(tmux display -p -t "$o" '#{pane_current_command}' 2>/dev/null)"
  dir="$(tmux display -p -t "$o" '#{b:pane_current_path}' 2>/dev/null)"
  txt="$(tmux capture-pane -p -J -t "$o" -S "-$lineas" 2>/dev/null | sed -e 's/[[:space:]]*$//' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' | ws-redactar)"
  printf 'Salida del panel de al lado (%s en %s, últimas %s líneas; secretos redactados):\n```\n%s\n```\n' "${cmd:-?}" "${dir:-?}" "$lineas" "$txt"
}
pegar() {   # origen destino
  local f; f="$(mktemp)"; bloque "$1" > "$f"
  tmux load-buffer -b ws-panel "$f" && tmux paste-buffer -p -d -b ws-panel -t "$2"
  rm -f "$f"; tmux display -d 2500 "Salida pegada en el prompt de Claude: escribe qué hacer y Enter"
}

case "$modo" in
  texto) bloque "$destino"; exit 0 ;;
  elegir)
    sel="$(tmux list-panes -a -F "#{pane_id}${TAB}#{session_name}:#{window_index} #{window_name} · #{pane_current_command} · #{b:pane_current_path}" \
           | grep -v "^${destino}${TAB}" | fzf --delimiter="$TAB" --with-nth=2 --reverse --prompt 'panel> ' \
               --header 'Elige el panel cuya salida quieres mandar a Claude' \
               --preview 'tmux capture-pane -p -J -t {1} -S -40 | tail -40' --preview-window 'down,50%')" || exit 0
    pegar "${sel%%"$TAB"*}" "$destino"; exit 0 ;;
esac

ventana="$(tmux display -p -t "$destino" '#{window_id}')"
mapfile -t otros < <(tmux list-panes -t "$ventana" -F '#{pane_last} #{pane_id}' | awk -v d="$destino" '$2 != d' | sort -r | awk '{print $2}')
if (( ${#otros[@]} >= 1 )); then pegar "${otros[0]}" "$destino"
else tmux display-popup -E -w 85% -h 75% "$HOME/.local/bin/tmux-flot-run $HOME/.local/bin/tmux-panel --elegir '$destino' --lineas $lineas"; fi
