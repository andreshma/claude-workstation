#!/usr/bin/env bash
#
# tmux-panel — sends Claude the output of another pane (tests, build, logs) without copy and paste. Ctrl+b e.
#
# Takes the last N lines of the tab's other pane (if there are several, the last one you used; if there is no
# other, it lets you pick any pane), redacts them (ws-redactar) and PASTES them into Claude's prompt inside a
# code block, without Enter: you type what to do with it and send it.
#
# Usage: tmux-panel <claude-pane> [--lineas 200]         (Ctrl+b e calls it with the current pane)
#      tmux-panel --elegir <claude-pane> [--lineas N]    (internal: pane list with fzf in a popup)
#      tmux-panel --texto <source-pane> [--lineas N]     (only prints the block; for tests)
set -uo pipefail
TAB=$'\t'
modo=pegar
case "${1:-}" in --elegir) modo=elegir; shift ;; --texto) modo=texto; shift ;; esac
destino="${1:?pane}"; shift
lineas=200; [[ "${1:-}" == --lineas && "${2:-}" =~ ^[0-9]+$ ]] && lineas="$2"

bloque() {   # source-pane → text ready to paste
  local o="$1" cmd dir txt
  cmd="$(tmux display -p -t "$o" '#{pane_current_command}' 2>/dev/null)"
  dir="$(tmux display -p -t "$o" '#{b:pane_current_path}' 2>/dev/null)"
  txt="$(tmux capture-pane -p -J -t "$o" -S "-$lineas" 2>/dev/null | sed -e 's/[[:space:]]*$//' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' | ws-redactar)"
  printf 'Output of the pane next to this one (%s in %s, last %s lines; secrets redacted):\n```\n%s\n```\n' "${cmd:-?}" "${dir:-?}" "$lineas" "$txt"
}
pegar() {   # source target
  local f; f="$(mktemp)"; bloque "$1" > "$f"
  tmux load-buffer -b ws-panel "$f" && tmux paste-buffer -p -d -b ws-panel -t "$2"
  rm -f "$f"; tmux display -d 2500 "Output pasted into Claude's prompt: type what to do and press Enter"
}

case "$modo" in
  texto) bloque "$destino"; exit 0 ;;
  elegir)
    sel="$(tmux list-panes -a -F "#{pane_id}${TAB}#{session_name}:#{window_index} #{window_name} · #{pane_current_command} · #{b:pane_current_path}" \
           | grep -v "^${destino}${TAB}" | fzf --delimiter="$TAB" --with-nth=2 --reverse --prompt 'pane> ' \
               --header 'Pick the pane whose output you want to send to Claude' \
               --preview 'tmux capture-pane -p -J -t {1} -S -40 | tail -40' --preview-window 'down,50%')" || exit 0
    pegar "${sel%%"$TAB"*}" "$destino"; exit 0 ;;
esac

ventana="$(tmux display -p -t "$destino" '#{window_id}')"
mapfile -t otros < <(tmux list-panes -t "$ventana" -F '#{pane_last} #{pane_id}' | awk -v d="$destino" '$2 != d' | sort -r | awk '{print $2}')
if (( ${#otros[@]} >= 1 )); then pegar "${otros[0]}" "$destino"
else tmux display-popup -E -w 85% -h 75% "$HOME/.local/bin/tmux-flot-run $HOME/.local/bin/tmux-panel --elegir '$destino' --lineas $lineas"; fi
