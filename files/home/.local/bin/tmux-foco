#!/usr/bin/env bash
#
# tmux-foco <N | ws-claude://foco/N> — goes to the tmux tab and pane %N.
# Called by Windows when you click a Claude notification (ws-claude:// protocol, see ws-claude-foco.ps1).
#
# Security: any web page can ask to open ws-claude://… (the browser asks first).
# So it only accepts a pane number and only switches tab or pane: it runs nothing else.
# Silent; exit 0 if it focused, 1 if the argument is invalid, 2 if the pane no longer exists.
set -uo pipefail
a="${1:-}"
a="${a#ws-claude://foco/}"; a="${a%/}"
[[ "$a" =~ ^[0-9]{1,6}$ ]] || exit 1
p="%$a"
unset TMUX
s="$(tmux display -p -t "$p" '#{session_name}' 2>/dev/null)" || exit 2
[[ -n "$s" ]] || exit 2
# Switches every client to that session (normally one: the Windows Terminal window).
while read -r c; do [[ -n "$c" ]] && tmux switch-client -c "$c" -t "$s" 2>/dev/null; done \
  < <(tmux list-clients -F '#{client_name}' 2>/dev/null)
tmux select-window -t "$p" \; select-pane -t "$p" 2>/dev/null
exit 0
