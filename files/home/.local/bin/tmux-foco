#!/usr/bin/env bash
#
# tmux-foco <N | ws-claude://foco/N> — lleva a la pestaña y al panel %N de tmux.
# Lo llama Windows al hacer clic en un aviso de Claude (protocolo ws-claude://, ver ws-claude-foco.ps1).
#
# Seguridad: cualquier página web puede pedir abrir ws-claude://… (el navegador pregunta antes).
# Por eso solo acepta un número de panel y solo cambia de pestaña o panel: no ejecuta nada más.
# Silencioso; exit 0 si enfocó, 1 si el argumento no es válido, 2 si el panel ya no existe.
set -uo pipefail
a="${1:-}"
a="${a#ws-claude://foco/}"; a="${a%/}"
[[ "$a" =~ ^[0-9]{1,6}$ ]] || exit 1
p="%$a"
unset TMUX
s="$(tmux display -p -t "$p" '#{session_name}' 2>/dev/null)" || exit 2
[[ -n "$s" ]] || exit 2
# Cambia todos los clientes a esa sesión (normalmente uno: la ventana de Windows Terminal).
while read -r c; do [[ -n "$c" ]] && tmux switch-client -c "$c" -t "$s" 2>/dev/null; done \
  < <(tmux list-clients -F '#{client_name}' 2>/dev/null)
tmux select-window -t "$p" \; select-pane -t "$p" 2>/dev/null
exit 0
