#!/usr/bin/env bash
#
# tmux-backup — copia los respaldos de tmux-resurrect a Windows después de cada guardado
# (hook @resurrect-hook-post-save-all). Si WSL se daña o se reinstala, el estado de las
# pestañas sobrevive en C:\Users\@WIN_USER@\.tmux-resurrect-backup.
src="${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect"
dst=@WINHOME@/.tmux-resurrect-backup
mkdir -p "$dst" && cp -u "$src"/tmux_resurrect_*.txt "$dst"/ 2>/dev/null && cp -fL "$src/last" "$dst/last.txt" 2>/dev/null
"$HOME/.local/bin/ws-backup" >/dev/null 2>&1 &
"$HOME/.local/bin/ws-backup-lite" --si-toca >/dev/null 2>&1 &
"$HOME/.local/bin/ws-telemetria" build --si-toca >/dev/null 2>&1 &
"$HOME/.local/bin/ws-telegram" asegurar >/dev/null 2>&1 &
exit 0
