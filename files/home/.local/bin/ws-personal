#!/usr/bin/env bash
#
# ws-personal — versions your personal configuration in a PRIVATE git repo: what does NOT go into the team kit
# (status bar segments, budgets, routing and Telegram settings, your own templates, your CLAUDE.md…).
# Born from losing mempalace-tmux.sh because it was not in git. ADR-011.
#
# Usage:
#   ws-personal init [--github]   creates ~/code/estacion-personal (git); with --github also the private repo
#                                 <your-user>/estacion-personal and links it (gh, asks first)
#   ws-personal sync [--silencioso]  copies the paths in incluir.txt to the repo, scans for secrets, commit and push
#   ws-personal estado            what changed since the last commit and when the last push was
#   ws-personal agregar <path>    adds a path (relative to ~) to incluir.txt and syncs
#   ws-personal restaurar         copies from the repo to ~ (asks; backs up what it replaces as .bak.<date>)
# The repo: ~/code/estacion-personal (WS_PERSONAL_DIR). What is versioned: its incluir.txt file (one path per line,
# relative to ~; folders end with /). Never: credentials, tokens, .credentials.json, ws-telegram/config.
# Security: before every commit, gitleaks (if installed) and ws-redactar; if anything looks like a secret, no commit.
# tmux-fondo runs `ws-personal sync --silencioso` once a day.
set -uo pipefail
R="${WS_PERSONAL_DIR:-$HOME/code/estacion-personal}"
INC="$R/incluir.txt"
silencio=0
msg() { (( silencio )) || echo "$@"; }
die() { echo "✖ $*" >&2; exit 1; }
PROHIBIDO='(^|/)(\.credentials\.json|credentials|\.env|.*\.pem|.*\.key|id_rsa.*|id_ed25519.*|ws-telegram/config|.*token.*|.*secret.*)$'

incluir_defecto() {
  cat <<'EOF'
# Paths (relative to ~) that ws-personal versions. Folders end with /. "#" = comment.
.config/ws-local/
.config/ws-telemetria/presupuestos.conf
.config/ws-ruteo/ajustes.conf
.config/ws-ruteo/modelos.conf
.config/ws-telegram/ajustes
.config/tmux-claude/plantillas/
.config/tmux-claude/roots.txt
.claude/CLAUDE.md
EOF
}

rutas() { grep -vE '^[[:space:]]*(#|$)' "$INC" | sed 's/[[:space:]]*$//'; }

copiar_al_repo() {   # ~ → repo/home (only what is listed; what no longer exists in ~ is removed from the repo)
  local r o d
  rm -rf "$R/home.nuevo"; mkdir -p "$R/home.nuevo"
  while IFS= read -r r; do
    [[ "$r" == /* || "$r" == *..* ]] && { msg "  skipped $r (must be relative to ~ and without ..)"; continue; }
    o="$HOME/$r"; [[ -e "$o" ]] || continue
    if [[ -d "$o" ]]; then
      d="$R/home.nuevo/${r%/}"; mkdir -p "$d"
      ( cd "$o" && find . -type f ! -name '*.bak.*' ! -name '*.tmp' -print0 ) | while IFS= read -r -d '' f; do
        [[ "${r%/}/${f#./}" =~ $PROHIBIDO ]] && continue
        install -D -m "$(stat -c %a "$o/${f#./}")" "$o/${f#./}" "$d/${f#./}"   # keeps +x (segments)
      done
    else
      [[ "$r" =~ $PROHIBIDO ]] && { msg "  skipped $r (looks like a credential)"; continue; }
      install -D -m "$(stat -c %a "$o")" "$o" "$R/home.nuevo/$r"
    fi
  done < <(rutas)
  rm -rf "${R:?}/home"; mv "$R/home.nuevo" "$R/home"
}

secretos() {   # 0 = clean
  local f hall=0
  if command -v gitleaks >/dev/null; then
    gitleaks detect --no-git --no-banner --redact -s "$R/home" >/dev/null 2>&1 || { echo "✖ gitleaks found possible secrets in $R/home (gitleaks detect --no-git -s $R/home -v)" >&2; hall=1; }
  fi
  while IFS= read -r -d '' f; do
    if ! cmp -s "$f" <(ws-redactar < "$f" 2>/dev/null || cat "$f"); then echo "✖ possible secret in ${f#"$R/home/"} (ws-redactar would mask it)" >&2; hall=1; fi
  done < <(find "$R/home" -type f -print0)
  return $hall
}

sync() {
  [[ -d "$R/.git" ]] || die "First: ws-personal init"
  copiar_al_repo
  secretos || { echo "  No commit made. Remove the secret (or take that path out of incluir.txt) and try again." >&2; return 1; }
  git -C "$R" add -A
  if git -C "$R" diff --cached --quiet; then msg "  (no changes)"; else
    git -C "$R" -c core.hooksPath=/dev/null commit -q -m "chore(personal): sync configuration $(date +%F)" && msg "  commit  $(git -C "$R" log -1 --format=%s)"
  fi
  git -C "$R" config ws.gate.allowMain true   # repos created before this version
  if git -C "$R" remote get-url origin >/dev/null 2>&1; then
    timeout 60 git -C "$R" push -q -u origin HEAD 2>/dev/null && msg "  push    $(git -C "$R" remote get-url origin)" || echo "⚠ Could not push (no network or no gh session?)" >&2
  else msg "  note    no remote: ws-personal init --github to keep it off this PC"; fi
  date +%s > "$R/.git/ws-ultimo-sync"
}

case "${1:-estado}" in
  init)
    mkdir -p "$R"; cd "$R" || exit 1
    [[ -d .git ]] || { git init -q -b main && msg "  done    local repo $R"; }
    # Single-person personal repo: the gate (ws-gate) allows direct push to main here.
    git config ws.gate.allowMain true
    [[ -f "$INC" ]] || { incluir_defecto > "$INC"; msg "  done    incluir.txt (edit it to add or remove paths)"; }
    [[ -f README.md ]] || printf '# estacion-personal\n\nPersonal workstation configuration (it does not go into the team kit). Managed by `ws-personal` (ADR-011).\n\n- What is versioned: `incluir.txt`\n- Copy: `home/` mirrors `~`\n- Restore on another PC: `ws-personal restaurar`\n' > README.md
    printf 'home.nuevo/\n*.bak.*\n' > .gitignore
    sync
    if [[ "${2:-}" == --github ]] && ! git remote get-url origin >/dev/null 2>&1; then
      command -v gh >/dev/null || die "gh is missing (ws-tools install gh)"
      u="$(gh api user -q .login 2>/dev/null)" || die "No gh session: gh auth login"
      read -r -p "Create the PRIVATE repo $u/estacion-personal on GitHub and push? [y/N] " s
      [[ "$s" =~ ^([yY]([eE][sS])?|[sS]([iI]|í|Í)?)$ ]] || exit 0
      gh repo create "$u/estacion-personal" --private --source "$R" --remote origin --push \
        --description "Personal configuration of the tmux + Claude workstation (ws-personal)" && msg "  done    github.com/$u/estacion-personal (private)"
      [[ "$(gh repo view "$u/estacion-personal" --json visibility -q .visibility 2>/dev/null)" == PRIVATE ]] || echo "⚠ Check: the repo did NOT end up private" >&2
    fi ;;
  sync) [[ "${2:-}" == --silencioso ]] && silencio=1; sync ;;
  estado)
    [[ -d "$R/.git" ]] || { echo "No personal repo (ws-personal init)"; exit 0; }
    echo "Repo: $R · remote: $(git -C "$R" remote get-url origin 2>/dev/null || echo 'none')"
    u="$(cat "$R/.git/ws-ultimo-sync" 2>/dev/null)"
    if [[ -n "$u" ]]; then echo "Last sync: $(date -d "@$u" '+%F %H:%M')"; else echo "Last sync: never"; fi
    echo "Paths: $(rutas | wc -l) · last commit: $(git -C "$R" log -1 --format='%cr — %s' 2>/dev/null)"
    copiar_al_repo; git -C "$R" status --short -- home | head -20 ;;
  agregar)
    r="${2:?path relative to ~}"; [[ -e "$HOME/$r" ]] || die "Not found: ~/$r"
    grep -qxF "$r" "$INC" || echo "$r" >> "$INC"; sync ;;
  restaurar)
    [[ -d "$R/home" ]] || die "Nothing to restore in $R/home"
    echo "This will be copied to ~ (whatever exists is backed up as .bak.<date>):"; ( cd "$R/home" && find . -type f | sed 's#^\./#  ~/#' )
    read -r -p "Restore? [y/N] " s; [[ "$s" =~ ^([yY]([eE][sS])?|[sS]([iI]|í|Í)?)$ ]] || exit 0
    st="$(date +%Y%m%d-%H%M%S)"
    ( cd "$R/home" && find . -type f -print0 ) | while IFS= read -r -d '' f; do
      d="$HOME/${f#./}"; [[ -f "$d" ]] && ! cmp -s "$R/home/${f#./}" "$d" && cp -p "$d" "$d.bak.$st"
      install -D -m "$(stat -c %a "$R/home/${f#./}")" "$R/home/${f#./}" "$d"; echo "  done    ~/${f#./}"
    done ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
