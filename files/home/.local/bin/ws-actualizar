#!/usr/bin/env bash
#
# ws-actualizar — updates the workstation from the kit on GitHub (andreshma/claude-workstation), with rollback.
#
# Usage:
#   ws-actualizar             checks and, if there is a new version, asks and applies it
#   ws-actualizar --revisar   only reports whether there is a new version (exit 10 = yes; 0 = no). ws-telegram runs it hourly.
#   ws-actualizar --aplicar   applies without asking (for use from another script)
#
# Apply = git pull --ff-only → install.sh (backs up every file that changes) → ws-test. If ws-test fails,
# it goes back to the previous commit and reinstalls; it reports the result over Telegram if configured.
# It touches nothing if you have uncommitted local changes or unpushed commits (on your main machine the kit
# is usually ahead: there is nothing to pull there).
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"
KIT="${WS_KIT:-$HOME/code/claude-workstation}"
modo="${1:-}"
die() { echo "✖ $*" >&2; exit 1; }
avisar_tg() { command -v ws-telegram >/dev/null && ws-telegram activo 2>/dev/null && ws-telegram notificar "$1" >/dev/null 2>&1 || true; }

[[ -d "$KIT/.git" ]] || die "kit not found in $KIT"
cd "$KIT" || exit 1
git fetch -q origin 2>/dev/null || die "could not reach GitHub (git fetch)"
local_="$(git rev-parse HEAD)"; remoto="$(git rev-parse '@{u}' 2>/dev/null)" || die "the branch does not track origin"
atras="$(git rev-list --count 'HEAD..@{u}')"; adelante="$(git rev-list --count '@{u}..HEAD')"
ver_remota="$(git describe --tags --abbrev=0 '@{u}' 2>/dev/null || echo "${remoto:0:7}")"
ver_local="$(git describe --tags --abbrev=0 HEAD 2>/dev/null || echo "${local_:0:7}")"

if (( atras == 0 )); then
  [[ "$modo" == --revisar ]] || echo "✔ Up to date ($ver_local)$( (( adelante )) && echo "; you have $adelante unpushed commits")"
  exit 0
fi
novedades="$(git log --format='• %s' 'HEAD..@{u}' | head -12)"
if [[ "$modo" == --revisar ]]; then
  printf 'New kit version: %s (you have %s, %s commits behind)\n%s\n' "$ver_remota" "$ver_local" "$atras" "$novedades"
  exit 10
fi

echo "New version: $ver_remota (you have $ver_local, $atras commits behind)"; echo "$novedades"
[[ -z "$(git status --porcelain)" ]] || die "uncommitted changes in the kit; push or discard them before updating"
(( adelante == 0 )) || die "you have $adelante unpushed commits; run git push first (or git pull --rebase by hand)"
if [[ "$modo" != --aplicar ]]; then
  read -rp "Update now? [y/N] " r; [[ "$r" =~ ^([yY]([eE][sS])?|[sS]([iI]|í|Í)?)$ ]] || { echo "Nothing changed."; exit 0; }
fi

echo "==> Pulling $ver_remota"
git pull -q --ff-only || die "git pull failed; nothing changed"
echo "==> Installing (every file that changes is backed up as .bak.<date>)"
if ! bash install.sh; then
  echo "✖ install.sh failed: going back to $ver_local"; git reset -q --hard "$local_"; bash install.sh >/dev/null 2>&1
  avisar_tg "🔴 ws-actualizar: install.sh failed on $ver_remota; rolled back to $ver_local."; exit 1
fi
echo "==> Testing (ws-test)"
if ! ws-test; then
  echo "✖ The tests failed: going back to $ver_local"; git reset -q --hard "$local_"; bash install.sh >/dev/null 2>&1
  avisar_tg "🔴 ws-actualizar: the tests failed on $ver_remota; rolled back to $ver_local. Check on the PC: ws-test"
  exit 1
fi
tmux source-file "$HOME/.tmux.conf" 2>/dev/null || true
echo "✔ Workstation at $ver_remota. Claude sessions already open pick up hooks and settings when restarted."
avisar_tg "✅ Workstation updated to $ver_remota."
