#!/usr/bin/env bash
#
# tmux-open — pick a folder with fzf and open it in its own tab with Claude (function tw).
# If there is already a tab in that folder, it jumps to it.
# Roots in ~/.config/tmux-claude/roots.txt, one per line: label|depth|path
#
# In the list:  Enter opens · → enters the subfolders of the highlighted one · ← goes up one level
# Groups: if a tab already exists in any group it jumps to it; otherwise it creates it in its group's session
# (label from roots.txt). To go back to everything in the current session: grupos=off in ~/.config/tmux-claude/ajustes
# Usage: tmux-open [--opus]   (--opus opens the new tab with Claude on Opus, function two)
#      tmux-open --dir <folder>    opens that folder without asking (used by tmux-favoritos)
# Internal (used by fzf while navigating): --lista · --hijos <path> · --arriba <path> <label>
set -euo pipefail
conf="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-claude/roots.txt"
TAB=$'\t'
AQUI="  · (this folder)"

#######################################
# Valid roots: "label<TAB>absolute path<TAB>depth".
#######################################
raices() {
  local label depth root
  [[ -f "$conf" ]] || return 0
  while IFS='|' read -r label depth root; do
    [[ -z "$label" || "$label" == \#* ]] && continue
    root="${root/#\~/$HOME}"
    [[ -d "$root" ]] && printf '%s\t%s\t%s\n' "$label" "$root" "$depth"
  done < "$conf"
}

#######################################
# Visible label of a path: "label/relative" according to the root that contains it.
#######################################
etiqueta_de() {
  local label root depth
  while IFS="$TAB" read -r label root depth; do
    if [[ "$1" == "$root" ]]; then echo "$label"; return; fi
    if [[ "$1" == "$root"/* ]]; then echo "$label/${1#"$root"/}"; return; fi
  done < <(raices)
  echo "${1/#"$HOME"/\~}"
}

dentro_de_raiz() {
  local label root depth
  while IFS="$TAB" read -r label root depth; do
    [[ "$1" == "$root" || "$1" == "$root"/* ]] && return 0
  done < <(raices)
  return 1
}

subdirs() {   # subfolders down to the given depth, no hidden ones or node_modules
  find "$1" -mindepth 1 -maxdepth "$2" -type d -not -path '*/.*' -not -path '*/node_modules*' 2>/dev/null | sort
}

#######################################
# Initial list: the folders of each root, "label/relative-path<TAB>absolute-path".
#######################################
list_dirs() {
  local label root depth d
  while IFS="$TAB" read -r label root depth; do
    while IFS= read -r d; do printf '%s/%s\t%s\n' "$label" "${d#"$root"/}" "$d"; done < <(subdirs "$root" "$depth")
  done < <(raices)
}

#######################################
# Subfolders of a folder (→). The first line opens the folder itself.
#######################################
hijos() {
  local base="$1" e d
  [[ -d "$base" ]] || { list_dirs; return; }
  e="$(etiqueta_de "$base")"
  printf '%s%s\t%s\n' "$e" "$AQUI" "$base"
  while IFS= read -r d; do printf '%s/%s\t%s\n' "$e" "${d##*/}" "$d"; done < <(subdirs "$base" 1)
}

#######################################
# Goes up one level (←): from a subfolder it shows its grandparent's; outside the roots, the initial list.
#######################################
arriba() {
  local p="$1" etiqueta="${2:-}" destino
  if [[ "$etiqueta" == *"$AQUI" ]]; then destino="$(dirname "$p")"; else destino="$(dirname "$(dirname "$p")")"; fi
  if dentro_de_raiz "$destino" && ! raices | cut -f2 | grep -qxF "$(dirname "$p")"; then hijos "$destino"; else list_dirs; fi
}

case "${1:-}" in
  --lista) list_dirs | sort; exit 0 ;;
  --hijos) hijos "$2"; exit 0 ;;
  --arriba) arriba "$2" "${3:-}"; exit 0 ;;
esac

fn=tw; prompt='open> '
[[ "${1:-}" == --opus ]] && { fn=two; prompt='open with Opus> '; }
dir=""
if [[ "${1:-}" == --dir ]]; then dir="$(realpath -e -- "${2:?folder}")" || exit 1; fi
if [[ -z "$dir" ]]; then
[[ -f "$conf" ]] || { echo "Missing $conf"; read -rsn1; exit 1; }
yo="$(printf '%q' "$0")"
sel="$(list_dirs | sort | fzf --reverse --delimiter="$TAB" --with-nth=1 --prompt="$prompt" \
  --header '→ subfolders · ← up · Enter open' \
  --bind "right:reload($yo --hijos {2})+clear-query" \
  --bind "left:reload($yo --arriba {2} {1})+clear-query" \
  --preview 'git -C {2} log --oneline -8 2>/dev/null; echo; ls -p {2} | head -40')" || exit 0
dir="${sel#*"$TAB"}"
fi

# Existing tab in ANY group (session): jump to it.
destino="$(tmux list-windows -a -F "#{session_name}${TAB}#{window_id}${TAB}#{pane_current_path}" |
  awk -F "$TAB" -v d="$dir" '$3 == d { print $1 "\t" $2; exit }')"
if [[ -n "$destino" ]]; then
  tmux switch-client -t "=${destino%%"$TAB"*}" 2>/dev/null; tmux select-window -t "${destino#*"$TAB"}"
  exit 0
fi
# New: in its group's session (label from roots.txt), created if it does not exist.
grupo="$(etiqueta_de "$dir")"; grupo="${grupo%%/*}"; [[ "$grupo" == "~"* || "$grupo" == /* ]] && grupo=other
if [[ "$fn" == tw ]] && [[ "$(sed -n 's/^grupos=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/tmux-claude/ajustes" 2>/dev/null)" != off ]]; then
  nombre="$(basename "$dir")"; [[ "$dir" == *.wt/* ]] && nombre="$(basename "${dir%%.wt/*}")@$(basename "$dir")"
  cmd="$(bash -c 'source ~/.config/tmux-claude/functions.sh && _claude_cmd "$1"' _ "$dir")"
  if tmux has-session -t "=$grupo" 2>/dev/null; then
    w="$(tmux new-window -P -F '#{window_id}' -t "=$grupo:" -n "$nombre" -c "$dir")"
  else
    tmux new-session -d -s "$grupo" -n "$nombre" -c "$dir"; w="$(tmux list-windows -t "=$grupo" -F '#{window_id}' | sed -n 1p)"
  fi
  tmux send-keys -t "$w" "$cmd" Enter
  tmux switch-client -t "=$grupo"; tmux select-window -t "$w"
else
  bash -c 'source ~/.config/tmux-claude/functions.sh && "$1" "$2"' _ "$fn" "$dir"
fi
