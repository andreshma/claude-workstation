#!/usr/bin/env bash
#
# ws-backup — copies Claude's conversations (~/.claude/projects) and the audit log
# (~/.claude/audit) to Windows. Incremental, deletes nothing at the destination; at most every 15 minutes.
# Called by tmux-backup after every tmux-resurrect save.
dst=@WINHOME@/.claude-wsl-backup
stamp="$dst/.last"
if [ -f "$stamp" ] && [ $(( $(date +%s) - $(stat -c %Y "$stamp") )) -lt 900 ]; then exit 0; fi
mkdir -p "$dst" && rsync -a ~/.claude/projects ~/.claude/audit "$dst/" 2>/dev/null && touch "$stamp"
exit 0
