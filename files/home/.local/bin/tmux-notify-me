#!/usr/bin/env bash
#
# tmux-notify-me — “notify me when it finishes”: mark a pane running a long command (build, terraform, tests,
# deploy) and when it ends you get a Windows and Telegram notification with the result. Ctrl+b N (again: cancels).
#
# If the pane is at the shell with nothing running, it waits for the next command you launch there.
# End = the pane returns to the shell (bash/zsh/fish) or closes. Result: ❌ if the last lines contain
# error/failed/fatal/exception/exit code ≠ 0, ✅ otherwise. It carries the last 8 lines, redacted.
# Usage: tmux-notify-me <pane>  ·  tmux-notify-me --watch <pane>  (internal, in the background)
# Limit: 12 h. Variables for tests: WS_NOTIFY_ME_PAUSE (s between checks, 2).
set -uo pipefail
PAUSE="${WS_NOTIFY_ME_PAUSE:-2}"
SHELLS='^(bash|zsh|fish|sh|dash|-bash)$'

if [[ "${1:-}" != --watch ]]; then
  p="${1:?pane}"
  if [[ -n "$(tmux show -pqv -t "$p" @notifyme 2>/dev/null)" ]]; then
    tmux set -pu -t "$p" @notifyme; tmux display "🔕 No longer notifying you about this pane"; exit 0
  fi
  tmux set -p -t "$p" @notifyme "$(date +%s)"
  tmux run-shell -b "'$0' --watch '$p'"
  c="$(tmux display -p -t "$p" '#{pane_current_command}')"
  if [[ "$c" =~ $SHELLS ]]; then tmux display -d 3000 "🔔 I will notify you when the next command in this pane finishes"
  else tmux display -d 3000 "🔔 I will notify you when «$c» finishes"; fi
  exit 0
fi

p="${2:?pane}"; mark="$(tmux show -pqv -t "$p" @notifyme)"; start=$(date +%s); cmd=""
alive() { [[ "$(tmux show -pqv -t "$p" @notifyme 2>/dev/null)" == "$mark" ]]; }
current() { tmux display -p -t "$p" '#{pane_current_command}' 2>/dev/null; }
c="$(current)"
while alive && [[ "$c" =~ $SHELLS ]] && (( $(date +%s) - start < 43200 )); do sleep "$PAUSE"; c="$(current)"; done   # wait for it to start
alive || exit 0
cmd="$c"; t0=$(date +%s)
while alive && [[ -n "$c" && ! "$c" =~ $SHELLS ]] && (( $(date +%s) - start < 43200 )); do sleep "$PAUSE"; c="$(current)"; done
alive || [[ -z "$c" ]] || exit 0
dur=$(( $(date +%s) - t0 )); dtxt="$((dur / 60)) min $((dur % 60)) s"
name="$(tmux display -p -t "$p" '#{window_index} #{window_name}' 2>/dev/null || echo 'pane closed')"
tail_txt="$(tmux capture-pane -p -J -t "$p" -S -40 2>/dev/null | sed -e 's/[[:space:]]*$//' | grep -v '^$' | tail -8)"
if grep -qiE 'error|failed|fatal|exception|panic|exit (code|status) [1-9]|✖|FAIL\b' <<<"$tail_txt"; then r="❌"; else r="✅"; fi
tmux set -pu -t "$p" @notifyme 2>/dev/null
ws-notify --pane "$p" --telegram --force "$r Finished «$cmd» ($dtxt) · $name" "$tail_txt"
tmux display -d 4000 "$r Finished «$cmd» in $name ($dtxt)" 2>/dev/null
