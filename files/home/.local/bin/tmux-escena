#!/usr/bin/env bash
#
# tmux-escena — picks the screensaver scene from a list (instead of stepping through them one by one).
# Menu → Appearance → s.
#   Enter: sets it and shows it right away (any key returns) · Ctrl+F: only sets it · «aleatoria»: a different
#   one each time. The list comes from the scenes tmux-saver has, so it includes the new ones.
# Usage: tmux-escena   ·   tmux-escena --lista   (name<TAB>description; tests)
set -uo pipefail
TAB=$'\t'
SAVER="$HOME/.local/bin/tmux-saver"
declare -A DESC=(
  [boreal]="Northern lights over mountains, reflected in a lake (shading engine; needs python3-numpy)"
  [nubes]="Flight over a sea of clouds at sunset (shading engine; needs python3-numpy)"
  [agujero]="A black hole with its disk of glowing gas (shading engine; needs python3-numpy)"
  [estanque]="Raindrops open rings on a pond under the moon (shading engine; needs python3-numpy)"
  [fuego]="Flames rising across the whole screen (shading engine; needs python3-numpy)"
  [tunel]="An endless tunnel of light (shading engine; needs python3-numpy)"
  [fractal]="A Julia fractal that changes shape (shading engine; needs python3-numpy)"
  [galeria]="Your images and animated GIFs turned into characters (chafa). Folder: ~/.config/tmux-claude/galeria"
  [oceano]="Sunset over the sea, with the sun's glitter on the waves (shading engine; needs python3-numpy)"
  [planeta]="A ringed gas giant spins in front of the stars (shading engine; needs python3-numpy)"
  [dona]="A spinning colored donut, with light and shine (shading engine; needs python3-numpy)"
  [lava]="Lava lamp: blobs that merge and split (shading engine; needs python3-numpy)"
  [vuelo]="Low flight over mountains, valleys and lakes (shading engine; needs python3-numpy)"
  [cumbres]="Mountain range at night: moon, pines, a reflecting lake and shooting stars (ASCII art)"
  [aurora]="Northern lights over a snowy forest (ASCII art)"
  [nevada]="Cabin with its windows lit, smoke and falling snow (ASCII art)"
  [velero]="A sailboat crosses the sea under the moon (ASCII art)"
  [peces]="Seabed: fish, jellyfish, seaweed and bubbles (ASCII art)"
  [tuberias]="Colored pipes that grow and fill the screen"
  [batalla]="Battle in space: two fleets, beams and explosions (ASCII art)"
  [fogata]="Campfire next to the tent, with sparks and the forest around it (ASCII art)"
  [cerezo]="Cherry tree in bloom at sunset; the petals fall with the wind (ASCII art)"
  [lluvia]="Rain over the city at night, with lightning and reflections on the street (ASCII art)"
  [galaxia]="A spinning spiral galaxy (ASCII art)"
  [nebulosa]="Flowing clouds of colored gas (ASCII art)"
  [hiperespacio]="The stars rush past at full speed (ASCII art)"
)

escenas() { sed -n 's/^ESCENAS=(\(.*\))[[:space:]]*$/\1/p' "$SAVER" 2>/dev/null | tr ' ' '\n' | grep -vx -e '' -e aleatoria; }
lista() {
  local actual e; actual="$(tmux show -gqv @saver_scene 2>/dev/null)"
  printf 'aleatoria\t%s A different one each time\n' "$([[ -z "$actual" ]] && echo '✓' || echo ' ')"
  while read -r e; do printf '%s\t%s %s\n' "$e" "$([[ "$e" == "$actual" ]] && echo '✓' || echo ' ')" "${DESC[$e]:-$e}"; done < <(escenas)
}
[[ "${1:-}" == --lista ]] && { lista; exit 0; }
command -v fzf >/dev/null || { lista; read -rsn1; exit 0; }
salida="$(lista | fzf --delimiter="$TAB" --with-nth=1,2 --reverse --no-sort --expect=ctrl-f --prompt 'scene> ' \
           --header 'Enter: set it and show it now (any key returns) · Ctrl+F: only set it · Esc closes')" || exit 0
tecla="$(head -1 <<<"$salida")"; e="$(sed -n 2p <<<"$salida" | cut -f1)"
[[ -n "$e" ]] || exit 0
# The choice is saved to the preferences (it used to stay only in tmux and the screensaver kept the old scene).
"$SAVER" --fijar "$e" >/dev/null || exit 0
if [[ "$e" == aleatoria ]]; then tmux display "Screensaver: random scene"; exit 0; fi
if [[ "$tecla" == ctrl-f ]]; then tmux display "Screensaver: scene «$e»"
else tmux run-shell -b -d 0.4 'tmux lock-client'; fi   # once the popup has closed: the screensaver with that scene
