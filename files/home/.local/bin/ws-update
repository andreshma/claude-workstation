#!/usr/bin/env bash
#
# ws-update — updates the workstation: Claude Code, tmux plugins and system packages.
# The Azure MCP is pinned to a version: this only reports a new one, so you can review it first.
set -u
echo "== Claude Code";     claude update
echo "== tmux plugins";    ~/.tmux/plugins/tpm/bin/update_plugins all
echo "== Packages (includes az, gh, tmux)"; sudo apt-get update -qq && sudo apt-get upgrade -y
echo "== Azure MCP"
cur="$(claude mcp get azure 2>/dev/null | grep -o '@azure/mcp@[0-9][0-9.]*' | cut -d@ -f3)"
new="$(npm view @azure/mcp version 2>/dev/null)"
if [ "$cur" = "$new" ]; then echo "up to date ($cur)"; else echo "new version $new (you have ${cur:-?}): review its changelog and re-register it with that version"; fi
echo "== Sandbox exclusions"; ws-sandbox-repos
echo "== Status";          ws-check
