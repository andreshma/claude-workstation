#!/usr/bin/env bash
#
# claude-resume — used by tmux-resurrect on restore: resumes the folder's last conversation and,
# if there is none to resume (no messages ever, or only -p sessions), opens a new Claude.
k="${PWD//[^A-Za-z0-9]/-}"
if compgen -G "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$k/*.jsonl" >/dev/null; then
  claude --continue "$@" || exec claude "$@"
else
  exec claude "$@"
fi
