#!/usr/bin/env bash
#
# tmux-watch — the workstation's watchdog. tmux runs it every status-interval from the status bar
# (#(tmux-watch)) and its output is the traffic light you see on the right:
#   ⚠ 2,5      tabs waiting for your approval or with an API error
#   ⏳ 3(12m)  tabs with no Claude activity for a while (stalled?)
#   ⛔ STOP    the emergency stop is on (ws-stop-all; resume with ws-stop-all --clear)
#   🚨 2       sessions with repeated guard blocks, denials or sandbox hits (ws-anomaly; Windows alert with the tab)
#   ◉ $4.1/h   estimated usage of all sessions over the last 10 min (green/yellow/red)
#   5h 82%     usage limits, if your plan exposes them
# It also sends Windows reminders (via win-notify.sh alert), with a pause between them.
# Thresholds (tmux options, with their default value):
#   @cwatch_remind 3 (min)   @cwatch_stall 10 (min)   @cburn_warn 5   @cburn_crit 15 (USD/h)
#   @canomaly_n 5 (blocks)   @canomaly_min 10 (min)   @ws_watch_width 24 (columns the segment always takes)
# Solo mode expiry (WS-AI-004): a tab whose @csolo_until has passed is returned to normal mode (tmux-solo normal).
# WS_WATCH_STATE and WS_WATCH_BURN override the state folders in /tmp (tests).
# Usage: tmux-watch          output for the bar
#      tmux-watch --goto     jumps to the first tab that is waiting or stalled
set -uo pipefail
uid="$(id -u)"; burn="${WS_WATCH_BURN:-/tmp/claude-burn-$uid}"; st="${WS_WATCH_STATE:-/tmp/claude-watch-$uid}"
mkdir -p "$st" && chmod 700 "$st"
now="$(date +%s)"
opt() { local v; v="$(tmux show -gqv "$1")"; echo "${v:-$2}"; }
remind=$(( $(opt @cwatch_remind 3) * 60 )); stall=$(( $(opt @cwatch_stall 10) * 60 ))
warn="$(opt @cburn_warn 5)"; crit="$(opt @cburn_crit 15)"
# tcolor <name> <default> — semantic colour of the active theme (see tmux-theme).
tcolor() { local v; v="$(tmux show -gqv "@t_$1" 2>/dev/null)"; echo "${v:-$2}"; }
notify_on() { [[ "$(tmux show -gqv @cnotify)" != off ]]; }

# alert <key> <every (s)> <pane> <title> <message> — Windows notification with a per-key pause.
alert() {
  local f="$st/$1" last; last="$(cat "$f" 2>/dev/null || echo 0)"
  (( now - last >= $2 )) || return 0
  echo "$now" > "$f"; notify_on || return 0
  jq -nc --arg t "$4" --arg m "$5" '{title: $t, message: $m}' |
    TMUX_PANE="$3" "$HOME/.claude/hooks/win-notify.sh" alert >/dev/null 2>&1
}
mins() { echo "$(( ($1 + 59) / 60 ))m"; }

# Local OpenTelemetry collector (ws-otel): if it is not running, start it. Without it, what Claude emits is lost.
if [[ -x "$HOME/.local/bin/ws-otel" ]]; then
  op="$(cat "${XDG_RUNTIME_DIR:-/tmp}/ws-otel-$(id -u)/pid" 2>/dev/null)"
  { [[ -n "$op" ]] && kill -0 "$op" 2>/dev/null; } || ( "$HOME/.local/bin/ws-otel" ensure >/dev/null 2>&1 & )
fi

waiting=(); stalled=(); goto=""; cands=()
while IFS='|' read -r wid idx name pane main ts sub; do
  [[ -n "$main" ]] || { tmux set -wu -t "$wid" @cstall 2>/dev/null; continue; }
  age=$(( now - ${ts:-$now} ))
  case "$main" in   # @cmain values are stored identifiers written by tmux-state.sh
    "needs you"|"API error")
      waiting+=("$idx"); goto="${goto:-$wid}"; cands+=("$wid"); tmux set -wu -t "$wid" @cstall 2>/dev/null
      (( age >= remind )) && alert "wait-$wid" "$remind" "$pane" "Claude · $idx $name" \
        "Still waiting for your answer ($main) for $(mins "$age")" ;;
    "your turn")   # Claude finished leaving you something: counts in ⚠, with a single reminder (not an open dialog)
      waiting+=("$idx"); goto="${goto:-$wid}"; cands+=("$wid"); tmux set -wu -t "$wid" @cstall 2>/dev/null
      (( age >= remind )) && alert "wait-$wid" 86400 "$pane" "Claude · $idx $name" \
        "It left you something to do or answer $(mins "$age") ago" ;;
    "done") rm -f "$st/wait-$wid" "$st/stall-$wid"; tmux set -wu -t "$wid" @cstall 2>/dev/null ;;
    *)
      if (( age >= stall )); then
        stalled+=("$idx($(mins "$age"))"); goto="${goto:-$wid}"; cands+=("$wid"); tmux set -w -t "$wid" @cstall 1
        alert "stall-$wid" $(( stall * 2 )) "$pane" "Claude · $idx $name" \
          "No activity for $(mins "$age") (state: $main${sub:+, $sub agents}). Stalled?"
      else tmux set -wu -t "$wid" @cstall 2>/dev/null; fi ;;
  esac
done < <(tmux list-windows -a -F '#{window_id}|#{window_index}|#{window_name}|#{pane_id}|#{@cmain}|#{@cts}|#{@csub}' 2>/dev/null)

# Solo mode that expired: back to normal mode, once (the mark is cleared before tmux-solo runs).
while IFS='|' read -r wid pane until name; do
  [[ "$until" =~ ^[0-9]+$ ]] && (( now >= until )) || continue
  tmux set -wu -t "$wid" @csolo_until 2>/dev/null
  ( "$HOME/.local/bin/tmux-solo" normal "$pane" >/dev/null 2>&1 & )
  alert "solo-$wid" 60 "$pane" "Claude · ${name#🤖}" "Solo mode expired: the tab went back to normal mode (same conversation)"
done < <(tmux list-windows -a -f '#{@csolo}' -F '#{window_id}|#{pane_id}|#{@csolo_until}|#{window_name}' 2>/dev/null)

# Anomalies (WS-AI-030): ws-anomaly runs in the background at most once a minute; the bar shows its last answer.
anom=()
if [[ -x "$HOME/.local/bin/ws-anomaly" ]]; then
  if (( now - $(stat -c %Y "$st/anomaly" 2>/dev/null || echo 0) >= 60 )); then
    : >> "$st/anomaly"; touch "$st/anomaly"
    ( "$HOME/.local/bin/ws-anomaly" --tsv --threshold "$(opt @canomaly_n 5)" --minutes "$(opt @canomaly_min 10)" \
        > "$st/anomaly.tmp" 2>/dev/null && mv "$st/anomaly.tmp" "$st/anomaly" & )
  fi
  while IFS=$'\t' read -r ases n kinds proj apane; do
    [[ -n "$ases" ]] || continue
    anom+=("$proj")
    alert "anomaly-${ases//[^A-Za-z0-9_-]/_}" 1800 "${apane:-$(tmux display -p '#{pane_id}' 2>/dev/null)}" "Claude · $proj: $n blocked actions" \
      "In $(opt @canomaly_min 10) min ($kinds). An agent may be probing. Menu → Claude → Emergency stop, or ws-stop-all --pane ${apane:-<pane>}"
  done < "$st/anomaly"
fi

if [[ "${1:-}" == --goto ]]; then
  # Jumps to the NEXT one waiting for you, not the one already in front of you (it used to pick the first, which was
  # often the current one, and seemed to do nothing). switch-client also switches group; select-window only within it.
  cur="$(tmux display -p '#{window_id}' 2>/dev/null)"; goto=""; seen=0
  for w in "${cands[@]}"; do [[ "$w" == "$cur" ]] && { seen=1; continue; }; (( seen )) && { goto="$w"; break; }; done
  [[ -n "$goto" ]] || for w in "${cands[@]}"; do [[ "$w" != "$cur" ]] && { goto="$w"; break; }; done
  if [[ -n "$goto" ]]; then
    ses="$(tmux display -p -t "$goto" '#{session_id}' 2>/dev/null)"
    [[ -n "$ses" ]] && tmux switch-client -t "$ses" 2>/dev/null
    tmux select-window -t "$goto"
  elif (( ${#cands[@]} )); then tmux display "This is the only tab waiting for you"
  else tmux display "No tab is waiting or stalled"; fi
  exit 0
fi

# Usage: sum of the rates of each session with samples in the last 10 min.
rate="$(find "$burn" -maxdepth 1 -name '*.log' -mmin -10 2>/dev/null | while read -r f; do
  awk -v now="$now" 'NF == 2 && $1 >= now - 600 { if (!t0) { t0 = $1; c0 = $2 } c1 = $2 }
    END { if (t0 && now - t0 >= 60) printf "%.4f\n", (c1 - c0) / (now - t0) * 3600; else print 0 }' "$f"
  awk -v now="$now" 'NF == 2 && $1 >= now - 1200' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
done | awk '{ s += $1 } END { printf "%.1f", s + 0 }')"
find "$burn" -maxdepth 1 -name '*.log' -mmin +60 -delete 2>/dev/null
read -r five week < <(cat "$burn/limits" 2>/dev/null || echo "-1 -1")
lim=$(( ${five:--1} > ${week:--1} ? ${five:--1} : ${week:--1} ))

level="$(awk -v r="$rate" -v w="$warn" -v c="$crit" -v l="$lim" \
  'BEGIN { if (r >= c || l >= 90) print "crit"; else if (r >= w || l >= 75) print "warn"; else print "ok" }')"
case "$level" in crit) c="$(tcolor alert colour196)" ;; warn) c="$(tcolor tool colour214)" ;; *) c="$(tcolor ok colour82)" ;; esac
[[ "$level" == crit ]] && alert burn 1800 "$(tmux display -p '#{pane_id}' 2>/dev/null)" "Claude · high usage" \
  "Estimated usage of \$${rate}/h over the last 10 min$( (( lim >= 0 )) && echo "; usage limit at ${lim}%")"

out=""
[[ -e "${WS_STATE_DIR:-$HOME/.local/state}/ws-stop-all" ]] && out+="#[fg=$(tcolor alert colour196),bold,reverse] ⛔ STOP #[default] "
(( ${#anom[@]} )) && out+="#[fg=$(tcolor alert colour196),bold]🚨 ${#anom[@]}#[default] "
(( ${#waiting[@]} )) && out+="#[fg=$(tcolor alert colour196),bold]⚠ $(IFS=,; echo "${waiting[*]}")#[default] "
(( ${#stalled[@]} )) && out+="#[fg=$(tcolor tool colour214)]⏳ $(IFS=,; echo "${stalled[*]}")#[default] "
[[ "$rate" != 0.0 || "$level" != ok ]] && out+="#[fg=$c]◉ \$${rate}/h#[default] "
(( five >= 0 )) && out+="#[fg=$c]5h ${five}%#[default] "
# Automatic theme: if Windows switched between light and dark, reapply (at most every 2 min).
if [[ "$(tmux show -gqv @theme_mode)" == auto ]]; then
  last="$(cat "$st/theme-check" 2>/dev/null || echo 0)"
  if (( now - last >= 120 )); then echo "$now" > "$st/theme-check"; ( "$HOME/.local/bin/tmux-theme" check >/dev/null 2>&1 & ); fi
fi
# Patch 53: background tasks (CI/PR of each tab, searchable history), at most once a minute.
( "$HOME/.local/bin/tmux-background" >/dev/null 2>&1 & )
# Fixed width (@ws_watch_width columns, 24): the traffic light comes and goes and its numbers change; padded and cut
# to one width it never moves the tab list (tmux-fit counts the columns tmux draws).
w="$(opt @ws_watch_width 24)"; [[ "$w" =~ ^[0-9]+$ ]] || w=24
if [[ -x "$HOME/.local/bin/tmux-fit" ]]; then printf '%s' "$out" | "$HOME/.local/bin/tmux-fit" -r "$w"; else printf '%s' "$out"; fi
