#!/usr/bin/env bash
#
# tmux-estado — pinta el estado de Claude de cada pestaña con su tiempo: lo que ves en la barra, el tablero
# (Ctrl+b D), el resumen (Ctrl+b i), los menús y Telegram. Los hooks (tmux-state.sh) dicen QUÉ pasa y DESDE
# CUÁNDO; este script lo convierte en texto y lo refresca con la barra (tmux-fondo lo llama en cada refresco).
#
#   🧠 pensando 42s · 🔧 Bash 2m · ✋ aprobar Bash 5m · ❓ te pregunta 1m · 📦 compactando · 🐝 3 agentes 4m
#   ✔ listo hace 12m · ⏳ sin avance 11m · ⛔ interrumpido · ✖ error API
#
# Opciones de ventana que LEE (las escribe tmux-state.sh):
#   @cfase   pensando|herramienta|permiso|pregunta|tetoca|compactando|listo|error|interrumpido
#   @cdesde  epoch del inicio de la fase · @cdet detalle («Bash: npm test») · @cturno epoch del prompt
#   @csub    subagentes activos · @cts epoch del último evento · @cpane panel de Claude
# Y ESCRIBE: @cs (texto con tiempo), @csc (color), @cturno_txt (duración del turno), @cfase=interrumpido si en
# pantalla aparece «Interrupted» tras 20 s sin eventos (Esc no dispara ningún hook).
# Sin avance: @cwatch_stall minutos (10) sin eventos mientras piensa o ejecuta.
# Uso: tmux-estado --pintar <ventana>   ·   tmux-estado --todas   ·   tmux-estado --dur <segundos>
set -uo pipefail

dur() {   # segundos → 42s · 7m · 1h05
  local s="${1:-0}"; (( s < 0 )) && s=0
  if (( s < 60 )); then printf '%ss' "$s"; elif (( s < 3600 )); then printf '%sm' $((s / 60)); else printf '%sh%02d' $((s / 3600)) $((s % 3600 / 60)); fi
}
tcolor() { local v; v="$(tmux show -gqv "@t_$1" 2>/dev/null)"; printf '%s' "${v:-$2}"; }

pintar() {   # ventana
  local w="$1" fase desde det sub cts turno pane ahora e txt col stall cs0 csc0 tt0
  # Separador TAB con «-» en los vacíos: tmux 3.4 escapa los caracteres de control (\x1f) en «display -p» y
  # «read» junta tabuladores seguidos (un campo vacío corría los demás).
  local o fmt=""
  for o in @cfase @cdesde @cdet @csub @cts @cturno @cpane @cs @csc @cturno_txt; do fmt+="#{?#{${o}},#{${o}},-}"$'\t'; done
  IFS=$'\t' read -r fase desde det sub cts turno pane cs0 csc0 tt0 < <(tmux display -p -t "$w" "$fmt" 2>/dev/null) || return 0
  for o in fase desde det sub cts turno pane cs0 csc0 tt0; do [[ "${!o}" == - ]] && printf -v "$o" ''; done
  [[ -n "$fase" ]] || return 0
  ahora=$(date +%s); e=$(( ahora - ${desde:-$ahora} ))
  stall="$(tmux show -gqv @cwatch_stall 2>/dev/null)"; stall=$(( ${stall:-10} * 60 ))

  # Autocorrección: no todo dispara un hook (Esc, permiso denegado, salir de Claude, un evento perdido), así que
  # si lleva 15 s sin eventos se contrasta con lo que hay en pantalla y el estado no se queda pegado.
  if [[ -n "$pane" ]] && { [[ -z "$cts" ]] || (( ahora - cts > 15 )); }; then
    local cmd vis trabaja=0 dialogo=0 nueva=""
    cmd="$(tmux display -p -t "$pane" '#{pane_current_command}' 2>/dev/null)"
    if [[ -z "$cmd" || "$cmd" =~ ^(bash|zsh|fish|sh|dash)$ ]]; then
      # Claude ya no corre en ese panel (salió, se cerró): fuera el estado.
      for o in @cs @csc @cfase @cdesde @cdet @cturno @cturno_txt @csub; do tmux set -wu -t "$w" "$o" 2>/dev/null; done
      return 0
    fi
    vis="$(tmux capture-pane -p -t "$pane" 2>/dev/null)"
    grep -qi 'esc to interrupt' <<<"$vis" && trabaja=1
    grep -qE '^[[:space:]│]*❯[[:space:]]*[0-9]+\.' <<<"$vis" && dialogo=1
    case "$fase" in
      pensando|herramienta|compactando)
        if (( !trabaja && !dialogo )); then
          if grep -q 'Interrupted' <<<"$vis"; then nueva=interrumpido; else nueva=listo; fi
        fi ;;
      permiso|pregunta) (( dialogo )) || { (( trabaja )) && nueva=pensando || nueva=listo; } ;;
      listo|interrumpido|error|tetoca) (( trabaja )) && nueva=pensando ;;
    esac
    if [[ -n "$nueva" ]]; then
      tmux set -w -t "$w" @cfase "$nueva" \; set -w -t "$w" @cdesde "${cts:-$ahora}" 2>/dev/null
      [[ "$nueva" == listo || "$nueva" == interrumpido ]] && tmux set -wu -t "$w" @cturno 2>/dev/null
      fase="$nueva"; e=$(( ahora - ${cts:-$ahora} ))
    fi
  fi

  case "$fase" in
    permiso)      txt="✋ aprobar${det:+ ${det%%:*}} $(dur "$e")"; col="$(tcolor alert colour196)" ;;
    pregunta)     txt="❓ te pregunta $(dur "$e")"; col="$(tcolor alert colour196)" ;;
    tetoca)       txt="👉 te toca $(dur "$e")"; col="$(tcolor alert colour196)" ;;
    error)        txt="✖ error API"; col="$(tcolor alert colour196)" ;;
    compactando)  txt="📦 compactando $(dur "$e")"; col="$(tcolor think colour39)" ;;
    interrumpido) txt="⛔ interrumpido"; (( e >= 60 )) && txt+=" hace $(dur "$e")"; col="$(tcolor tool colour214)" ;;
    listo)        txt="✔ listo"; (( e >= 60 )) && txt+=" hace $(dur "$e")"; col="$(tcolor ok colour82)" ;;
    pensando|herramienta)
      if [[ -n "$cts" ]] && (( ahora - cts > stall )); then
        txt="⏳ sin avance $(dur $(( ahora - cts )))"; col="$(tcolor tool colour214)"
      elif [[ -n "$sub" && "$sub" != 0 ]]; then
        txt="🐝 $sub agente$([[ "$sub" == 1 ]] || echo s) $(dur $(( ahora - ${turno:-$desde} )))"; col="$(tcolor agent colour177)"
      elif [[ "$fase" == herramienta ]]; then
        txt="🔧 $(cut -c1-14 <<<"${det%%:*}") $(dur "$e")"; col="$(tcolor tool colour214)"
      else
        txt="🧠 pensando $(dur "$e")"; col="$(tcolor think colour39)"
      fi ;;
    *) return 0 ;;
  esac
  # Solo se escribe lo que cambió: cada escritura redibuja la barra (y hace parpadear un menú abierto).
  [[ "$txt" == "$cs0" ]] || tmux set -w -t "$w" @cs "$txt" 2>/dev/null
  [[ "$col" == "$csc0" ]] || tmux set -w -t "$w" @csc "$col" 2>/dev/null
  if [[ -n "$turno" ]]; then
    local tt; tt="$(dur $(( ahora - turno )))"
    [[ "$tt" == "$tt0" ]] || tmux set -w -t "$w" @cturno_txt "$tt" 2>/dev/null
  fi
}

case "${1:-}" in
  --pintar) pintar "${2:?ventana}" ;;
  --todas)  while read -r w; do pintar "$w"; done < <(tmux list-windows -a -F '#{window_id}' 2>/dev/null | sort -u) ;;
  --dur)    dur "${2:-0}"; echo ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
exit 0
