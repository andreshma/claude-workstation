#!/usr/bin/env bash
#
# tmux-estado — paints each tab's Claude state with its time: what you see in the status bar, the dashboard
# (Ctrl+b D), the summary (Ctrl+b i), the menus and Telegram. The hooks (tmux-state.sh) say WHAT is happening and
# SINCE WHEN; this script turns it into text and refreshes it with the bar (tmux-fondo calls it on every refresh).
#
#   🧠 thinking 42s · 🔧 Bash 2m · ✋ approve Bash 5m · ❓ asking you 1m · 📦 compacting · 🐝 3 agents 4m
#   ✔ done 12m ago · ⏳ stalled 11m · ⛔ interrupted · ✖ API error
#
# Window options it READS (written by tmux-state.sh):
#   @cfase   pensando|herramienta|permiso|pregunta|tetoca|compactando|listo|error|interrumpido
#   @cdesde  epoch of the phase start · @cdet detail («Bash: npm test») · @cturno epoch of the prompt
#   @csub    active subagents · @cts epoch of the last event · @cpane Claude's pane
# And WRITES: @cs (text with time), @csc (colour), @cturno_txt (turn duration), @cfase=interrumpido if
# «Interrupted» shows on screen after 20 s without events (Esc fires no hook).
# Stalled: @cwatch_stall minutes (10) without events while thinking or running a tool.
# Usage: tmux-estado --pintar <window>   ·   tmux-estado --todas   ·   tmux-estado --dur <seconds>
set -uo pipefail

dur() {   # seconds → 42s · 7m · 1h05
  local s="${1:-0}"; (( s < 0 )) && s=0
  if (( s < 60 )); then printf '%ss' "$s"; elif (( s < 3600 )); then printf '%sm' $((s / 60)); else printf '%sh%02d' $((s / 3600)) $((s % 3600 / 60)); fi
}
tcolor() { local v; v="$(tmux show -gqv "@t_$1" 2>/dev/null)"; printf '%s' "${v:-$2}"; }

pintar() {   # window
  local w="$1" fase desde det sub cts turno pane ahora e txt col stall cs0 csc0 tt0
  # TAB separator with «-» in the empty ones: tmux 3.4 escapes control characters (\x1f) in «display -p» and
  # «read» collapses consecutive tabs (an empty field shifted the rest).
  local o fmt=""
  for o in @cfase @cdesde @cdet @csub @cts @cturno @cpane @cs @csc @cturno_txt; do fmt+="#{?#{${o}},#{${o}},-}"$'\t'; done
  IFS=$'\t' read -r fase desde det sub cts turno pane cs0 csc0 tt0 < <(tmux display -p -t "$w" "$fmt" 2>/dev/null) || return 0
  for o in fase desde det sub cts turno pane cs0 csc0 tt0; do [[ "${!o}" == - ]] && printf -v "$o" ''; done
  [[ -n "$fase" ]] || return 0
  ahora=$(date +%s); e=$(( ahora - ${desde:-$ahora} ))
  stall="$(tmux show -gqv @cwatch_stall 2>/dev/null)"; stall=$(( ${stall:-10} * 60 ))

  # Self-correction: not everything fires a hook (Esc, permission denied, leaving Claude, a lost event), so
  # after 15 s without events it is checked against what is on screen and the state does not get stuck.
  if [[ -n "$pane" ]] && { [[ -z "$cts" ]] || (( ahora - cts > 15 )); }; then
    local cmd vis trabaja=0 dialogo=0 nueva=""
    cmd="$(tmux display -p -t "$pane" '#{pane_current_command}' 2>/dev/null)"
    if [[ -z "$cmd" || "$cmd" =~ ^(bash|zsh|fish|sh|dash)$ ]]; then
      # Claude no longer runs in that pane (it exited or closed): clear the state.
      for o in @cs @csc @cfase @cdesde @cdet @cturno @cturno_txt @csub; do tmux set -wu -t "$w" "$o" 2>/dev/null; done
      return 0
    fi
    vis="$(tmux capture-pane -p -t "$pane" 2>/dev/null)"
    grep -qi 'esc to interrupt' <<<"$vis" && trabaja=1
    grep -qE '^[[:space:]│]*❯[[:space:]]*[0-9]+\.' <<<"$vis" && dialogo=1
    case "$fase" in
      pensando|herramienta|compactando)
        if (( !trabaja && !dialogo )); then
          if grep -q 'Interrupted' <<<"$vis"; then nueva=interrumpido; else nueva=listo; fi
        fi ;;
      permiso|pregunta) (( dialogo )) || { (( trabaja )) && nueva=pensando || nueva=listo; } ;;
      listo|interrumpido|error|tetoca) (( trabaja )) && nueva=pensando ;;
    esac
    if [[ -n "$nueva" ]]; then
      tmux set -w -t "$w" @cfase "$nueva" \; set -w -t "$w" @cdesde "${cts:-$ahora}" 2>/dev/null
      [[ "$nueva" == listo || "$nueva" == interrumpido ]] && tmux set -wu -t "$w" @cturno 2>/dev/null
      fase="$nueva"; e=$(( ahora - ${cts:-$ahora} ))
    fi
  fi

  case "$fase" in
    permiso)      txt="✋ approve${det:+ ${det%%:*}} $(dur "$e")"; col="$(tcolor alert colour196)" ;;
    pregunta)     txt="❓ asking you $(dur "$e")"; col="$(tcolor alert colour196)" ;;
    tetoca)       txt="👉 waiting for you $(dur "$e")"; col="$(tcolor alert colour196)" ;;
    error)        txt="✖ API error"; col="$(tcolor alert colour196)" ;;
    compactando)  txt="📦 compacting $(dur "$e")"; col="$(tcolor think colour39)" ;;
    interrumpido) txt="⛔ interrupted"; (( e >= 60 )) && txt+=" $(dur "$e") ago"; col="$(tcolor tool colour214)" ;;
    listo)        txt="✔ done"; (( e >= 60 )) && txt+=" $(dur "$e") ago"; col="$(tcolor ok colour82)" ;;
    pensando|herramienta)
      if [[ -n "$cts" ]] && (( ahora - cts > stall )); then
        txt="⏳ stalled $(dur $(( ahora - cts )))"; col="$(tcolor tool colour214)"
      elif [[ -n "$sub" && "$sub" != 0 ]]; then
        txt="🐝 $sub agent$([[ "$sub" == 1 ]] || echo s) $(dur $(( ahora - ${turno:-$desde} )))"; col="$(tcolor agent colour177)"
      elif [[ "$fase" == herramienta ]]; then
        txt="🔧 $(cut -c1-14 <<<"${det%%:*}") $(dur "$e")"; col="$(tcolor tool colour214)"
      else
        txt="🧠 thinking $(dur "$e")"; col="$(tcolor think colour39)"
      fi ;;
    *) return 0 ;;
  esac
  # Only what changed is written: every write redraws the bar (and makes an open menu flicker).
  [[ "$txt" == "$cs0" ]] || tmux set -w -t "$w" @cs "$txt" 2>/dev/null
  [[ "$col" == "$csc0" ]] || tmux set -w -t "$w" @csc "$col" 2>/dev/null
  if [[ -n "$turno" ]]; then
    local tt; tt="$(dur $(( ahora - turno )))"
    [[ "$tt" == "$tt0" ]] || tmux set -w -t "$w" @cturno_txt "$tt" 2>/dev/null
  fi
}

case "${1:-}" in
  --pintar) pintar "${2:?window}" ;;
  --todas)  while read -r w; do pintar "$w"; done < <(tmux list-windows -a -F '#{window_id}' 2>/dev/null | sort -u) ;;
  --dur)    dur "${2:-0}"; echo ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
exit 0
