#!/usr/bin/env python3
"""ws-menus — revisa los menús de tmux y genera el manual completo de la estación.

Revisión (sin argumentos o --md archivo): en ~/.config/tmux-claude/menu*.tmux reporta
  · tecla repetida dentro del mismo menú (tmux solo respeta la primera: la otra opción queda inalcanzable)
  · la misma acción en varios menús (duplicado: decide en cuál se queda)
  · la misma etiqueta en varios menús
  · scripts de ~/.local/bin que el menú llama y no existen
Manual (--manual [archivo] · --ver): Markdown generado de lo que REALMENTE está instalado, así nunca se desactualiza:
  teclas directas de ~/.tmux.conf, todos los menús con su ruta de teclas (Ctrl+b m → s → u), los comandos de
  ~/.local/bin con su descripción y los subcomandos de ws-telegram y ws-telemetria. Se guarda en
  ~/.local/share/ws-manual/manual.md y se copia a %UserProfile%\\ws-telemetria\\manual-estacion.md.
  --ver lo genera y lo abre en pantalla (glow si está; si no, less).
Uso: ws-menus [--md archivo] | --manual [archivo] | --ver   (la revisión sale con 1 si hay teclas repetidas o scripts que faltan)
"""
import os
import re
import shutil
import subprocess  # nosec B404 — solo wslvar/wslpath/less/glow con argumentos fijos
import sys
from collections import defaultdict
from pathlib import Path

HOME = Path.home()
DIR = HOME / ".config/tmux-claude"
BIN = HOME / ".local/bin"
ITEM = re.compile(r'''^\s*(?:"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)')\s+(\S+)\s+(?:"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)')\s*\\?\s*$''')


def items(f: Path):
    for n, linea in enumerate(f.read_text(encoding="utf-8").splitlines(), 1):
        m = ITEM.match(linea)
        if not m:
            continue
        etiqueta = m.group(1) if m.group(1) is not None else m.group(2)
        cmd = m.group(4) if m.group(4) is not None else m.group(5)
        if not etiqueta or etiqueta.startswith("-"):
            continue
        yield n, etiqueta, m.group(3), cmd


def normal(cmd: str) -> str:
    """Acción comparable: cada script propio con sus argumentos (sin tmux-flot-run ni opciones de la ventana);
    si no llama scripts, el comando de tmux con espacios uniformes. Mismo script con otros argumentos (tema
    claro vs oscuro, cr fable vs opus) son acciones distintas."""
    c = cmd.replace("\\\"", "").replace('"', "").replace("'", "")
    partes = re.findall(r"(?:~|\$HOME)/\.local/bin/([\w.-]+)((?:\s+(?!(?:~|\$HOME)/)[^\s;]+)*)", c)
    partes = [(n, a.strip()) for n, a in partes if n not in ("tmux-flot-run", "tmux-pause")]
    if partes:
        return "script: " + " | ".join(f"{n} {a}".strip() for n, a in partes)
    return re.sub(r"\s+", " ", c).strip()


def revisar() -> int:
    menus = sorted(DIR.glob("menu*.tmux"))
    teclas_dup, faltan, por_accion, por_etiqueta = [], [], defaultdict(list), defaultdict(list)
    total = 0
    for f in menus:
        vistas = {}
        for n, et, tecla, cmd in items(f):
            total += 1
            if tecla in vistas and tecla not in ("''",):
                teclas_dup.append(f"{f.name}: tecla «{tecla}» en «{vistas[tecla]}» y en «{et}» (línea {n}; la segunda no se puede elegir con teclado)")
            vistas.setdefault(tecla, et)
            if not cmd.startswith("source-file"):          # navegar entre menús no cuenta como acción duplicada
                por_accion[normal(cmd)].append(f"{f.name}:{tecla} «{et}»")
            if not et.strip().startswith("‹"):                 # «‹ Volver» se repite a propósito
                por_etiqueta[et.strip().lower()].append(f.name)
            for s in re.findall(r"(?:~|\$HOME)/\.local/bin/([\w.-]+)", cmd):
                if not (BIN / s).exists():
                    faltan.append(f"{f.name}: «{et}» llama a {s}, que no existe")
    dup_acc = {k: v for k, v in por_accion.items() if len(v) > 1}
    dup_et = {k: v for k, v in por_etiqueta.items() if len(set(v)) > 1}
    out = [f"# Revisión de menús ({len(menus)} menús, {total} opciones)", ""]
    out += ["## Teclas repetidas en el mismo menú (corregir)", *(f"- {x}" for x in teclas_dup or ["ninguna ✔"]), ""]
    out += ["## Scripts que no existen (corregir)", *(f"- {x}" for x in faltan or ["ninguno ✔"]), ""]
    out += ["## Misma acción en varios menús (revisar: ¿a propósito o duplicado?)"]
    out += [f"- `{k[:90]}` → {', '.join(v)}" for k, v in sorted(dup_acc.items())] or ["- ninguna ✔"]
    out += ["", "## Misma etiqueta en varios menús"]
    out += [f"- «{k}» → {', '.join(sorted(set(v)))}" for k, v in sorted(dup_et.items())] or ["- ninguna ✔"]
    texto = "\n".join(out) + "\n"
    print(texto)
    if len(sys.argv) > 2 and sys.argv[1] == "--md":
        Path(sys.argv[2]).write_text(texto, encoding="utf-8")
    return 1 if teclas_dup or faltan else 0


# ---------------------------------------------------------------------------------------------
# Manual
# ---------------------------------------------------------------------------------------------
def _ramas(m) -> str:
    """#{?cond,A,B}: si una rama está vacía es una marca de estado (✓) y se quita; «…» (un valor) tampoco se muestra."""
    a, b = m.group(1).strip(), m.group(2).strip()
    if not a or not b:
        return ""
    vivas = [x for x in (a, b) if x != "…"]
    return " / ".join(vivas)


def legible(etiqueta: str) -> str:
    """Etiqueta de tmux sin formatos: #{?c,A,B} → «A / B»; resto de #{…} y #[…] fuera."""
    s = etiqueta
    for _ in range(6):
        s2 = re.sub(r"#\{\?[^{}]*?,([^,{}]*),([^,{}]*)\}", _ramas, s)
        s2 = re.sub(r"#\{[^{}]*\}", "…", s2)
        if s2 == s:
            break
        s = s2
    s = re.sub(r"#\[[^\]]*\]", "", s).replace("\\\"", '"')
    return re.sub(r"\s+", " ", s.lstrip("-")).strip(" /") or etiqueta


def sin_comillas(t: str) -> str:
    return t[1:-1] if len(t) >= 3 and t[0] == t[-1] and t[0] in "'\"" else t


def tecla_legible(t: str) -> str:
    t = sin_comillas(t)
    return {"BSpace": "⌫", "Enter": "Enter", "Space": "Espacio", "Escape": "Esc"}.get(t, t)


def que_hace(cmd: str) -> str:
    if cmd.strip().startswith("source-file") and "menu" in cmd:
        return "submenú"
    s = normal(cmd)
    if s.startswith("script: "):
        partes = [" ".join(w for w in p.split() if re.fullmatch(r"[-\w.]+", w)) for p in s[8:].split(" | ")]
        return "`" + " · ".join(partes)[:70] + "`"
    for patron, txt in ((r"send-keys", "teclea en Claude"), (r"display-popup", "ventana flotante"), (r"run-shell", "acción"),
                        (r"select-window|previous-window|next-window|last-window", "navegar"), (r"split-window", "dividir"),
                        (r"resize-pane", "zoom"), (r"kill-", "cerrar"), (r"copy-mode", "modo copia")):
        if re.search(patron, cmd):
            return txt
    return "tmux"


DIRECTAS = [   # (regex del comando, descripción) para ~/.tmux.conf; gana la primera que coincide
    (r"^display-menu", "Menú de la pestaña"), (r"menu\.tmux", "Menú principal"), (r"tmux-pick", "Buscar pestaña por nombre"), (r"tmux-open", "Abrir repo o carpeta (→ entra a subcarpetas, ← sube)"),
    (r"tmux-dash", "Tablero de pestañas (Enter va a la pestaña)"), (r"tmux-agents", "Subagentes en vivo"), (r"tmux-help", "Atajos de teclado"),
    (r"tmux-resumen", "Resumen de la pestaña: qué, dónde y en qué se quedó"), (r"lazygit", "lazygit en la carpeta"),
    (r"tmux-pwsh", "PowerShell flotante"), (r"--persistente", "Shell flotante persistente (Ctrl+b d la oculta)"),
    (r"switch-client -p", "Grupo anterior"), (r"switch-client -n", "Grupo siguiente"), (r"choose-tree", "Grupos con sus pestañas"),
    (r"swap-window -d -t -1", "Mover pestaña a la izquierda"), (r"swap-window -d -t \+1", "Mover pestaña a la derecha"),
    (r"previous-window", "Pestaña anterior"), (r"next-window", "Pestaña siguiente"), (r"last-window", "Última pestaña usada"),
    (r"capture-pane.*load-buffer", "Copiar las últimas 200 líneas al portapapeles"), (r"pipe-pane", "Grabar la salida del panel en ~/logs (sí/no)"),
    (r"source-file ~/\.tmux\.conf", "Recargar la configuración"), (r"new-window", "Pestaña nueva en la misma carpeta"),
    (r"split-window -v", "Dividir arriba/abajo"), (r"split-window -h", "Dividir lado a lado"),
    (r"main-vertical", "Layout principal"), (r"tiled", "Mosaico"), (r"begin-selection", "Empezar selección"),
    (r"copy-selection", "Copiar selección"), (r"display-menu", "Menú de la pestaña"),
]
TECLAS_RATON = {"MouseDown1StatusRight": "Clic en la derecha de la barra", "MouseDown3Status": "Clic derecho en una pestaña",
                "DoubleClick1Status": "Doble clic en una pestaña"}


def prefijo(conf: str) -> str:
    m = re.search(r"^\s*set(?:-option)?\s+-g\s+prefix\s+(\S+)", conf, re.M)
    p = (m.group(1) if m else "C-b").strip("'\"")
    return p.replace("C-", "Ctrl+").replace("M-", "Alt+")


def atajo(tabla: str, tecla: str, pre: str) -> str:
    t = sin_comillas(tecla)
    if t in TECLAS_RATON:
        return TECLAS_RATON[t]
    t = t.replace("M-S-", "Alt+Shift+").replace("M-", "Alt+").replace("C-", "Ctrl+")
    t = t.replace("Left", "←").replace("Right", "→").replace("Up", "↑").replace("Down", "↓")
    return {"-n": t, "copy-mode-vi": f"(en modo copia) {t}"}.get(tabla, f"{pre} {t}")


def teclas_directas() -> list[tuple[str, str]]:
    f = HOME / ".tmux.conf"
    if not f.exists():
        return []
    conf = f.read_text(encoding="utf-8")
    pre = prefijo(conf)
    filas, alt_num = [], False
    for linea in conf.replace("\\\n", " ").splitlines():
        m = re.match(r"^\s*bind(?:-key)?\s+((?:-[nr]\s+|-T\s+\S+\s+)*)(\S+)\s+(.*)$", linea)
        if not m:
            continue
        flags, tecla, cmd = m.group(1), m.group(2), m.group(3)
        tabla = "-n" if "-n" in flags else (re.search(r"-T\s+(\S+)", flags).group(1) if "-T" in flags else "")
        if tabla == "-n" and re.fullmatch(r"M-[1-9]", tecla):
            if not alt_num:
                filas.append(("Alt+1 … Alt+9", "Ir a la pestaña con ese número")); alt_num = True
            continue
        coment = re.search(r"\s#\s+(.+)$", cmd)
        desc = coment.group(1).strip() if coment else next((d for rx, d in DIRECTAS if re.search(rx, cmd)), "")
        if not desc:
            desc = "`" + re.sub(r"\s+", " ", cmd)[:60] + "`"
        filas.append((atajo(tabla, tecla, pre), desc))
    return filas


def menus_en_arbol() -> list[tuple[str, str, list]]:
    """[(ruta, título, [(tecla, etiqueta, qué hace)])] desde menu.tmux siguiendo los submenús."""
    pre = prefijo((HOME / ".tmux.conf").read_text(encoding="utf-8")) if (HOME / ".tmux.conf").exists() else "Ctrl+b"
    vistos, salida = set(), []

    def visitar(f: Path, ruta: str):
        if f in vistos or not f.exists():
            return
        vistos.add(f)
        texto = f.read_text(encoding="utf-8")
        t = re.search(r'-T\s+"(?:#\[[^\]]*\])?([^"]*)"', texto)
        tramos = [x for x in (t.group(1).split("·") if t else []) if "#" not in x and x.strip()]
        titulo = "Menú principal" if f.name == "menu.tmux" else (legible(" · ".join(x.strip() for x in tramos)) if tramos else f.stem)
        filas, subs = [], []
        for _, et, tecla, cmd in items(f):
            if et.strip().startswith("‹"):
                continue
            filas.append((tecla_legible(tecla), legible(et), que_hace(cmd)))
            sm = re.search(r"source-file\s+\S*?(menu[\w-]*\.tmux)", cmd)
            if sm and cmd.strip().startswith("source-file"):
                subs.append((DIR / sm.group(1), f"{ruta} → {tecla_legible(tecla)}"))
        salida.append((ruta, titulo, filas))
        for sf, sr in subs:
            visitar(sf, sr)

    visitar(DIR / "menu.tmux", f"{pre} m")
    for f in sorted(DIR.glob("menu*.tmux")):         # menús que no cuelgan del principal
        visitar(f, f"(otro) {f.stem}")
    return salida


def descripcion(p: Path) -> str:
    try:
        cabeza = p.read_text(encoding="utf-8", errors="replace").splitlines()[:12]
    except (OSError, UnicodeError):
        return ""
    for i, linea in enumerate(cabeza):
        m = re.match(r'^\s*(?:#|"""|\'\'\')\s*' + re.escape(p.name) + r"(?:\.\w+)?\s*(?:\[[^\]]*\]\s*)?(?:<[^>]*>\s*)?[—–:-]+\s*(.+)$", linea)
        if not m:
            continue
        texto = m.group(1).strip()
        for sig in cabeza[i + 1:i + 3]:
            if re.search(r"[.:]\s*$", texto):
                break
            c = re.sub(r'^\s*#?\s?', "", sig).strip()
            if not c or c.startswith(("Uso", "-", "·")):
                break
            texto += " " + c
        texto = re.split(r"(?<=[a-záéíóúñ)])\.\s", texto, maxsplit=1)[0]
        texto = texto.rstrip('".:')
        return texto if len(texto) <= 170 else texto[:170].rsplit(" ", 1)[0] + "…"
    return ""


def comandos() -> list[tuple[str, str]]:
    if not BIN.is_dir():
        return []
    filas = []
    for p in sorted(BIN.iterdir()):
        if p.is_file() and os.access(p, os.X_OK) and re.match(r"^(ws-|tmux-|cr$|claude-|devrestore)", p.name):
            filas.append((p.name, descripcion(p)))
    return filas


def subcomandos(p: Path) -> list[tuple[str, str]]:
    """Líneas «<script> args   descripción» del bloque Uso: de la cabecera (bash o Python) y, en bash, las ramas
    del case con comentario que no estén ya (salvo las internas)."""
    try:
        texto = p.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    filas, vistas = [], set()
    uso = re.search(r"^(?:#\s*)?Uso:\s*\n(.*?)(?:\n#?\s*\n|\n\"\"\"|\n[^#\s])", texto, re.S | re.M)
    for linea in (uso.group(1).splitlines() if uso else []):
        m = re.match(r"^#?\s+(" + re.escape(p.name) + r"(?:\s.*?)?)(?:\s{2,}(\S.*))?$", linea)
        if m:
            filas.append((m.group(1).strip(), (m.group(2) or "").strip()))
            vistas.add(m.group(1).split()[1].split("|")[0] if len(m.group(1).split()) > 1 else "")
    for m in re.finditer(r"^\s{2}([a-z][a-z|-]*)\)[^#\n]*#\s*(.+)$", texto, re.M):
        nombre, nota = m.group(1), m.group(2).strip()
        if nombre.split("|")[0] not in vistas and not re.search(r"interno|prueba|lo usa", nota):
            filas.append((f"{p.name} {nombre}", re.sub(r"^" + re.escape(p.name) + r"\s+\S+\s*", "", nota) or nota))
    return filas


def ventana_windows() -> Path | None:
    for cmd in (["wslvar", "USERPROFILE"],):
        try:
            w = subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout.strip()  # nosec B603
            if w:
                return Path(subprocess.run(["wslpath", "-u", w], capture_output=True, text=True, timeout=10).stdout.strip()) / "ws-telemetria"  # nosec B603 B607
        except (OSError, subprocess.SubprocessError):
            continue
    return None


def c(x: str) -> str:
    """Celda de tabla Markdown: sin | sueltos."""
    return str(x).replace("|", "\\|")


def manual(destino: Path | None) -> Path:
    import datetime as dt
    md = ["# Manual de la estación (tmux + Claude)", "",
          f"_Generado {dt.datetime.now():%Y-%m-%d %H:%M} desde lo instalado (`ws-menus --manual`). Menú → m → Manual lo abre._", "",
          "## Teclas directas", "", "| Atajo | Qué hace |", "|---|---|"]
    md += [f"| {c(a)} | {c(d)} |" for a, d in teclas_directas()] or ["| (no encontré ~/.tmux.conf) | |"]
    for ruta, titulo, filas in menus_en_arbol():
        md += ["", f"## {titulo} — `{ruta}`", "", "| Tecla | Opción | Tipo |", "|---|---|---|"]
        md += [f"| {c(t)} | {c(e)} | {c(q)} |" for t, e, q in filas]
    md += ["", "## Comandos de la terminal", "", "| Comando | Qué hace |", "|---|---|"]
    md += [f"| `{n}` | {c(d)} |" for n, d in comandos()]
    md += ["", "## Opciones de cada comando", ""]
    for n, _ in comandos():
        sub = subcomandos(BIN / n)
        if len(sub) >= 2:
            md += [f"### {n}", "", "| Uso | Qué hace |", "|---|---|", *(f"| `{c(a)}` | {c(d)} |" for a, d in sub), ""]
    texto = "\n".join(md) + "\n"
    destino = destino or (HOME / ".local/share/ws-manual/manual.md")
    destino.parent.mkdir(parents=True, exist_ok=True)
    destino.write_text(texto, encoding="utf-8")
    w = ventana_windows() if not os.environ.get("WS_MENUS_SIN_WINDOWS") else None
    if w:
        try:
            w.mkdir(parents=True, exist_ok=True); shutil.copyfile(destino, w / "manual-estacion.md")
        except OSError:
            pass
    return destino


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--manual":
        p = manual(Path(sys.argv[2]) if len(sys.argv) > 2 else None)
        print(f"Manual: {p}"); return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--ver":
        p = manual(None)
        visor = ["glow", "-p", str(p)] if shutil.which("glow") else ["less", "-R", str(p)]
        return subprocess.run(visor).returncode  # nosec B603
    return revisar()


if __name__ == "__main__":
    sys.exit(main())
