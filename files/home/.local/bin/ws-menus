#!/usr/bin/env python3
"""ws-menus — checks the tmux menus and generates the full workstation manual.

Check (no arguments or --md file): in ~/.config/tmux-claude/menu*.tmux it reports
  · a key repeated inside the same menu (tmux only honors the first one: the other option is unreachable)
  · the same action in several menus (duplicate: decide which one keeps it)
  · the same label in several menus
  · scripts in ~/.local/bin that the menu calls and do not exist
Manual (--manual [file] · --show): Markdown generated from what is ACTUALLY installed, so it never goes stale:
  direct keys from ~/.tmux.conf, every menu with its key path (Ctrl+b m → s → u), the commands in
  ~/.local/bin with their description and the subcommands of ws-telegram and ws-telemetry. It is saved to
  ~/.local/share/ws-manual/manual.md and copied to %UserProfile%\\ws-telemetry\\workstation-manual.md.
  --show generates it and opens it on screen (glow if installed; otherwise less).
Usage: ws-menus [--md file] | --manual [file] | --show   (the check exits with 1 if there are repeated keys or missing scripts)
"""
import os
import re
import shutil
import subprocess  # nosec B404 — only wslvar/wslpath/less/glow with fixed arguments
import sys
from collections import defaultdict
from pathlib import Path

HOME = Path.home()
DIR = HOME / ".config/tmux-claude"
BIN = HOME / ".local/bin"
ITEM = re.compile(r'''^\s*(?:"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)')\s+(\S+)\s+(?:"((?:[^"\\]|\\.)*)"|'((?:[^'\\]|\\.)*)')\s*\\?\s*$''')


def items(f: Path):
    for n, line in enumerate(f.read_text(encoding="utf-8").splitlines(), 1):
        m = ITEM.match(line)
        if not m:
            continue
        label = m.group(1) if m.group(1) is not None else m.group(2)
        cmd = m.group(4) if m.group(4) is not None else m.group(5)
        if not label or label.startswith("-"):
            continue
        yield n, label, m.group(3), cmd


def normal(cmd: str) -> str:
    """Comparable action: each own script with its arguments (without tmux-popup-run or popup options);
    if it calls no scripts, the tmux command with uniform spacing. The same script with other arguments (light
    vs dark theme, cr fable vs opus) counts as different actions."""
    c = cmd.replace("\\\"", "").replace('"', "").replace("'", "")
    parts = re.findall(r"(?:~|\$HOME)/\.local/bin/([\w.-]+)((?:\s+(?!(?:~|\$HOME)/)[^\s;]+)*)", c)
    parts = [(n, a.strip()) for n, a in parts if n not in ("tmux-popup-run", "tmux-pause")]
    if parts:
        return "script: " + " | ".join(f"{n} {a}".strip() for n, a in parts)
    return re.sub(r"\s+", " ", c).strip()


def check() -> int:
    menus = sorted(DIR.glob("menu*.tmux"))
    dup_keys, missing, by_action, by_label = [], [], defaultdict(list), defaultdict(list)
    total = 0
    for f in menus:
        seen = {}
        for n, lbl, key, cmd in items(f):
            total += 1
            if key in seen and key not in ("''",):
                dup_keys.append(f"{f.name}: key «{key}» in «{seen[key]}» and in «{lbl}» (line {n}; the second one cannot be picked from the keyboard)")
            seen.setdefault(key, lbl)
            if not cmd.startswith("source-file"):          # navigating between menus does not count as a duplicate action
                by_action[normal(cmd)].append(f"{f.name}:{key} «{lbl}»")
            if not lbl.strip().startswith("‹"):                 # «‹ Back» is repeated on purpose
                by_label[lbl.strip().lower()].append(f.name)
            for s in re.findall(r"(?:~|\$HOME)/\.local/bin/([\w.-]+)", cmd):
                if not (BIN / s).exists():
                    missing.append(f"{f.name}: «{lbl}» calls {s}, which does not exist")
    dup_actions = {k: v for k, v in by_action.items() if len(v) > 1}
    dup_labels = {k: v for k, v in by_label.items() if len(set(v)) > 1}
    out = [f"# Menu check ({len(menus)} menus, {total} options)", ""]
    out += ["## Keys repeated in the same menu (fix)", *(f"- {x}" for x in dup_keys or ["none ✔"]), ""]
    out += ["## Scripts that do not exist (fix)", *(f"- {x}" for x in missing or ["none ✔"]), ""]
    out += ["## Same action in several menus (review: on purpose or duplicate?)"]
    out += [f"- `{k[:90]}` → {', '.join(v)}" for k, v in sorted(dup_actions.items())] or ["- none ✔"]
    out += ["", "## Same label in several menus"]
    out += [f"- «{k}» → {', '.join(sorted(set(v)))}" for k, v in sorted(dup_labels.items())] or ["- none ✔"]
    text = "\n".join(out) + "\n"
    print(text)
    if len(sys.argv) > 2 and sys.argv[1] == "--md":
        Path(sys.argv[2]).write_text(text, encoding="utf-8")
    return 1 if dup_keys or missing else 0


# ---------------------------------------------------------------------------------------------
# Manual
# ---------------------------------------------------------------------------------------------
def _branches(m) -> str:
    """#{?cond,A,B}: an empty branch means a state mark (✓) and is dropped; «…» (a value) is not shown either."""
    a, b = m.group(1).strip(), m.group(2).strip()
    if not a or not b:
        return ""
    live = [x for x in (a, b) if x != "…"]
    return " / ".join(live)


def readable(label: str) -> str:
    """tmux label without formats: #{?c,A,B} → «A / B»; any other #{…} and #[…] removed."""
    s = label
    for _ in range(6):
        s2 = re.sub(r"#\{\?[^{}]*?,([^,{}]*),([^,{}]*)\}", _branches, s)
        s2 = re.sub(r"#\{[^{}]*\}", "…", s2)
        if s2 == s:
            break
        s = s2
    s = re.sub(r"#\[[^\]]*\]", "", s).replace("\\\"", '"')
    return re.sub(r"\s+", " ", s.lstrip("-")).strip(" /") or label


def unquote(t: str) -> str:
    return t[1:-1] if len(t) >= 3 and t[0] == t[-1] and t[0] in "'\"" else t


def readable_key(t: str) -> str:
    t = unquote(t)
    return {"BSpace": "⌫", "Enter": "Enter", "Space": "Space", "Escape": "Esc"}.get(t, t)


def what_it_does(cmd: str) -> str:
    if cmd.strip().startswith("source-file") and "menu" in cmd:
        return "submenu"
    s = normal(cmd)
    if s.startswith("script: "):
        parts = [" ".join(w for w in p.split() if re.fullmatch(r"[-\w.]+", w)) for p in s[8:].split(" | ")]
        return "`" + " · ".join(parts)[:70] + "`"
    for pattern, txt in ((r"send-keys", "types into Claude"), (r"display-popup", "floating window"), (r"run-shell", "action"),
                        (r"select-window|previous-window|next-window|last-window", "navigate"), (r"split-window", "split"),
                        (r"resize-pane", "zoom"), (r"kill-", "close"), (r"copy-mode", "copy mode")):
        if re.search(pattern, cmd):
            return txt
    return "tmux"


DIRECT = [   # (command regex, description) for ~/.tmux.conf; the first match wins
    (r"^display-menu", "Tab menu"), (r"menu\.tmux", "Main menu"), (r"tmux-pick", "Find a tab by name"), (r"tmux-open", "Open a repo or folder (→ enters subfolders, ← goes up)"),
    (r"tmux-dash", "Tab dashboard (Enter goes to the tab)"), (r"tmux-agents", "Live subagents"), (r"tmux-help", "Keyboard shortcuts"),
    (r"tmux-summary", "Tab summary: what, where and where it left off"), (r"lazygit", "lazygit in the folder"),
    (r"tmux-pwsh", "Floating PowerShell"), (r"--persistent", "Persistent floating shell (Ctrl+b d hides it)"),
    (r"switch-client -p", "Previous group"), (r"switch-client -n", "Next group"), (r"choose-tree", "Groups with their tabs"),
    (r"swap-window -d -t -1", "Move tab left"), (r"swap-window -d -t \+1", "Move tab right"),
    (r"previous-window", "Previous tab"), (r"next-window", "Next tab"), (r"last-window", "Last tab used"),
    (r"capture-pane.*load-buffer", "Copy the last 200 lines to the clipboard"), (r"pipe-pane", "Log the pane output to ~/logs (on/off)"),
    (r"source-file ~/\.tmux\.conf", "Reload the configuration"), (r"new-window", "New tab in the same folder"),
    (r"split-window -v", "Split top/bottom"), (r"split-window -h", "Split side by side"),
    (r"main-vertical", "Main layout"), (r"tiled", "Tiled"), (r"begin-selection", "Start selection"),
    (r"copy-selection", "Copy selection"), (r"display-menu", "Tab menu"),
]
MOUSE_KEYS = {"MouseDown1StatusRight": "Click on the right of the status bar", "MouseDown3Status": "Right click on a tab",
                "DoubleClick1Status": "Double click on a tab"}


def prefix(conf: str) -> str:
    m = re.search(r"^\s*set(?:-option)?\s+-g\s+prefix\s+(\S+)", conf, re.M)
    p = (m.group(1) if m else "C-b").strip("'\"")
    return p.replace("C-", "Ctrl+").replace("M-", "Alt+")


def shortcut(table: str, key: str, pre: str) -> str:
    t = unquote(key)
    if t in MOUSE_KEYS:
        return MOUSE_KEYS[t]
    t = t.replace("M-S-", "Alt+Shift+").replace("M-", "Alt+").replace("C-", "Ctrl+")
    t = t.replace("Left", "←").replace("Right", "→").replace("Up", "↑").replace("Down", "↓")
    return {"-n": t, "copy-mode-vi": f"(in copy mode) {t}"}.get(table, f"{pre} {t}")


def direct_keys() -> list[tuple[str, str]]:
    f = HOME / ".tmux.conf"
    if not f.exists():
        return []
    conf = f.read_text(encoding="utf-8")
    pre = prefix(conf)
    rows, alt_num = [], False
    for line in conf.replace("\\\n", " ").splitlines():
        m = re.match(r"^\s*bind(?:-key)?\s+((?:-[nr]\s+|-T\s+\S+\s+)*)(\S+)\s+(.*)$", line)
        if not m:
            continue
        flags, key, cmd = m.group(1), m.group(2), m.group(3)
        table = "-n" if "-n" in flags else (re.search(r"-T\s+(\S+)", flags).group(1) if "-T" in flags else "")
        if table == "-n" and re.fullmatch(r"M-[1-9]", key):
            if not alt_num:
                rows.append(("Alt+1 … Alt+9", "Go to the tab with that number")); alt_num = True
            continue
        comment = re.search(r"\s#\s+(.+)$", cmd)
        desc = comment.group(1).strip() if comment else next((d for rx, d in DIRECT if re.search(rx, cmd)), "")
        if not desc:
            desc = "`" + re.sub(r"\s+", " ", cmd)[:60] + "`"
        rows.append((shortcut(table, key, pre), desc))
    return rows


def menu_tree() -> list[tuple[str, str, list]]:
    """[(path, title, [(key, label, what it does)])] from menu.tmux following the submenus."""
    pre = prefix((HOME / ".tmux.conf").read_text(encoding="utf-8")) if (HOME / ".tmux.conf").exists() else "Ctrl+b"
    visited, result = set(), []

    def visit(f: Path, path: str):
        if f in visited or not f.exists():
            return
        visited.add(f)
        text = f.read_text(encoding="utf-8")
        t = re.search(r'-T\s+"(?:#\[[^\]]*\])?([^"]*)"', text)
        segments = [x for x in (t.group(1).split("·") if t else []) if "#" not in x and x.strip()]
        title = "Main menu" if f.name == "menu.tmux" else (readable(" · ".join(x.strip() for x in segments)) if segments else f.stem)
        rows, subs = [], []
        for _, lbl, key, cmd in items(f):
            if lbl.strip().startswith("‹"):
                continue
            rows.append((readable_key(key), readable(lbl), what_it_does(cmd)))
            sm = re.search(r"source-file\s+\S*?(menu[\w-]*\.tmux)", cmd)
            if sm and cmd.strip().startswith("source-file"):
                subs.append((DIR / sm.group(1), f"{path} → {readable_key(key)}"))
        result.append((path, title, rows))
        for sf, sr in subs:
            visit(sf, sr)

    visit(DIR / "menu.tmux", f"{pre} m")
    for f in sorted(DIR.glob("menu*.tmux")):         # menus that do not hang from the main one
        visit(f, f"(other) {f.stem}")
    return result


def describe(p: Path) -> str:
    try:
        head = p.read_text(encoding="utf-8", errors="replace").splitlines()[:12]
    except (OSError, UnicodeError):
        return ""
    for i, line in enumerate(head):
        m = re.match(r'^\s*(?:#|"""|\'\'\')\s*' + re.escape(p.name) + r"(?:\.\w+)?\s*(?:\[[^\]]*\]\s*)?(?:<[^>]*>\s*)?[—–:-]+\s*(.+)$", line)
        if not m:
            continue
        text = m.group(1).strip()
        for nxt in head[i + 1:i + 3]:
            if re.search(r"[.:]\s*$", text):
                break
            c = re.sub(r'^\s*#?\s?', "", nxt).strip()
            if not c or c.startswith(("Usage", "-", "·")):
                break
            text += " " + c
        text = re.split(r"(?<=[a-z)])\.\s", text, maxsplit=1)[0]
        text = text.rstrip('".:')
        return text if len(text) <= 170 else text[:170].rsplit(" ", 1)[0] + "…"
    return ""


def commands() -> list[tuple[str, str]]:
    if not BIN.is_dir():
        return []
    rows = []
    for p in sorted(BIN.iterdir()):
        if p.is_file() and os.access(p, os.X_OK) and re.match(r"^(ws-|tmux-|cr$|claude-|devrestore)", p.name):
            rows.append((p.name, describe(p)))
    return rows


def subcommands(p: Path) -> list[tuple[str, str]]:
    """Lines «<script> args   description» from the Usage: block of the header (bash or Python) and, in bash, the
    commented case branches not listed yet (except the internal ones)."""
    try:
        text = p.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    rows, seen = [], set()
    usage = re.search(r"^(?:#\s*)?Usage:\s*\n(.*?)(?:\n#?\s*\n|\n\"\"\"|\n[^#\s])", text, re.S | re.M)
    for line in (usage.group(1).splitlines() if usage else []):
        m = re.match(r"^#?\s+(" + re.escape(p.name) + r"(?:\s.*?)?)(?:\s{2,}(\S.*))?$", line)
        if m:
            rows.append((m.group(1).strip(), (m.group(2) or "").strip()))
            seen.add(m.group(1).split()[1].split("|")[0] if len(m.group(1).split()) > 1 else "")
    for m in re.finditer(r"^\s{2}([a-z][a-z|-]*)\)[^#\n]*#\s*(.+)$", text, re.M):
        name, note = m.group(1), m.group(2).strip()
        if name.split("|")[0] not in seen and not re.search(r"internal|test|used by", note):
            rows.append((f"{p.name} {name}", re.sub(r"^" + re.escape(p.name) + r"\s+\S+\s*", "", note) or note))
    return rows


def windows_dir() -> Path | None:
    for cmd in (["wslvar", "USERPROFILE"],):
        try:
            w = subprocess.run(cmd, capture_output=True, text=True, timeout=10).stdout.strip()  # nosec B603
            if w:
                return Path(subprocess.run(["wslpath", "-u", w], capture_output=True, text=True, timeout=10).stdout.strip()) / "ws-telemetry"  # nosec B603 B607
        except (OSError, subprocess.SubprocessError):
            continue
    return None


def c(x: str) -> str:
    """Markdown table cell: no stray | characters."""
    return str(x).replace("|", "\\|")


def manual(dest: Path | None) -> Path:
    import datetime as dt
    md = ["# Workstation manual (tmux + Claude)", "",
          f"_Generated {dt.datetime.now():%Y-%m-%d %H:%M} from what is installed (`ws-menus --manual`). Menu → m (Full manual) opens it._", "",
          "## Direct keys", "", "| Shortcut | What it does |", "|---|---|"]
    md += [f"| {c(a)} | {c(d)} |" for a, d in direct_keys()] or ["| (~/.tmux.conf not found) | |"]
    for path, title, rows in menu_tree():
        md += ["", f"## {title} — `{path}`", "", "| Key | Option | Type |", "|---|---|---|"]
        md += [f"| {c(t)} | {c(e)} | {c(q)} |" for t, e, q in rows]
    md += ["", "## Terminal commands", "", "| Command | What it does |", "|---|---|"]
    md += [f"| `{n}` | {c(d)} |" for n, d in commands()]
    md += ["", "## Options of each command", ""]
    for n, _ in commands():
        sub = subcommands(BIN / n)
        if len(sub) >= 2:
            md += [f"### {n}", "", "| Usage | What it does |", "|---|---|", *(f"| `{c(a)}` | {c(d)} |" for a, d in sub), ""]
    text = "\n".join(md) + "\n"
    dest = dest or (HOME / ".local/share/ws-manual/manual.md")
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(text, encoding="utf-8")
    w = windows_dir() if not os.environ.get("WS_MENUS_NO_WINDOWS") else None
    if w:
        try:
            w.mkdir(parents=True, exist_ok=True); shutil.copyfile(dest, w / "workstation-manual.md")
        except OSError:
            pass
    return dest


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--manual":
        p = manual(Path(sys.argv[2]) if len(sys.argv) > 2 else None)
        print(f"Manual: {p}"); return 0
    if len(sys.argv) > 1 and sys.argv[1] == "--show":
        p = manual(None)
        viewer = ["glow", "-p", str(p)] if shutil.which("glow") else ["less", "-R", str(p)]
        return subprocess.run(viewer).returncode  # nosec B603
    return check()


if __name__ == "__main__":
    sys.exit(main())
