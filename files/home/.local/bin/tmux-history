#!/usr/bin/env bash
#
# tmux-history — “which tab did I see that error in yesterday?”: search over what went through all your panes.
# OFF by default (it stores screen text). Menu → Views → y (on/off) · h (search).
#   tmux-history on|off       turns it on/off (option @history)
#   tmux-history [text]       searches with fzf (context preview); Enter goes to the tab if it is still open
#   tmux-history --sample  (run by tmux-background every minute) stores the NEW lines of each pane
#   tmux-history --status     size and days stored
# How it stores: every minute it takes each pane's already-drawn screen (capture-pane: clean text, no terminal
# codes), keeps only what is new, redacts it (ws-redact) and appends it to
# ~/.local/share/tmux-history/YYYY-MM-DD/<group>_<tab>.log (0700). Deleted after 30 days (WS_HISTORY_DAYS).
# Panes with Claude are stored too: the full conversation is already in its transcripts.
set -uo pipefail
D="${WS_HISTORY_DIR:-$HOME/.local/share/tmux-history}"; DAYS="${WS_HISTORY_DAYS:-30}"
ST="${XDG_RUNTIME_DIR:-/tmp}/tmux-history-$(id -u)"
mkdir -p "$D" "$ST" && chmod 700 "$D" "$ST"
TAB=$'\t'

case "${1:-}" in
  on)  tmux set -g @history on; echo "Searchable history: on (stored every minute; $DAYS days)"; exit 0 ;;
  off) tmux set -g @history off; echo "Searchable history: off (what is already stored stays in $D)"; exit 0 ;;
  --status)
    echo "History: $(tmux show -gqv @history || true) · $(du -sh "$D" 2>/dev/null | cut -f1) in $(find "$D" -mindepth 1 -maxdepth 1 -type d | wc -l) days · $D"; exit 0 ;;
  --sample)
    today="$D/$(date +%F)"; mkdir -p "$today"
    ST="$ST/$(tmux display -p '#{pid}')"; mkdir -p "$ST"   # %N ids are reused across tmux servers
    while IFS="$TAB" read -r pid s wi wn; do
      seen="$ST/${pid#%}"
      new="$(tmux capture-pane -p -J -t "$pid" -S -300 2>/dev/null | sed -e 's/[[:space:]]*$//' | grep -v '^$')" || continue
      [[ -n "$new" ]] || continue
      if [[ -f "$seen" ]]; then
        # Only what was not in the previous sample: the lines after the last match of the tail.
        tail_lines="$(tail -n 3 "$seen")"
        rest="$(awk -v c="$tail_lines" 'BEGIN{n=split(c,C,"\n")} {L[NR]=$0} END{s=0; for(i=NR;i>=n;i--){ok=1; for(j=1;j<=n;j++) if(L[i-n+j]!=C[j]){ok=0;break}; if(ok){s=i;break}} for(i=s+1;i<=NR;i++) print L[i]}' <<<"$new")"
      else rest="$new"; fi
      printf '%s\n' "$new" | tail -n 3 > "$seen"
      [[ -n "$rest" ]] || continue
      name="$(printf '%s_%s-%s' "$s" "$wi" "$wn" | tr -c 'A-Za-z0-9_.-' '_' | cut -c1-60)"
      { printf '### %s %s\n' "$(date +%H:%M)" "$pid"; ws-redact <<<"$rest"; } >> "$today/$name.log"
    done < <(tmux list-panes -a -F "#{pane_id}${TAB}#{session_name}${TAB}#{window_index}${TAB}#{window_name}")
    find "$D" -mindepth 1 -maxdepth 1 -type d -mtime "+$DAYS" -exec rm -rf {} + 2>/dev/null
    exit 0 ;;
esac

command -v rg >/dev/null && SEARCH=(rg --no-heading --line-number --color=never -i) || SEARCH=(grep -rni --color=never)
q="${*:-}"
sel="$(cd "$D" && "${SEARCH[@]}" -- "${q:-.}" . 2>/dev/null | sed 's#^\./##' | sort -r -t/ -k1,1 \
       | fzf --delimiter=: --with-nth=1,3.. --reverse --query "$q" --prompt 'history> ' \
             --header 'Type to filter · Enter: go to the tab (if still open) and copy the line' \
             --preview "sed -n \"\$(( {2} > 6 ? {2} - 6 : 1 )),\$(( {2} + 6 ))p\" '$D'/{1}" --preview-window 'down,40%')" || exit 0
file="${sel%%:*}"; line="${sel#*:*:}"
printf '%s' "$line" | ws-copy 2>/dev/null || printf '%s' "$line" | tmux load-buffer -w -
pane="$(awk -v n="$(cut -d: -f2 <<<"$sel")" 'NR<=n && /^### / {p=$3} END{print p}' "$D/$file")"
if [[ -n "$pane" ]] && tmux display -p -t "$pane" '#{pane_id}' >/dev/null 2>&1; then
  tmux switch-client -t "$(tmux display -p -t "$pane" '#{session_name}')" 2>/dev/null
  tmux select-window -t "$pane"; tmux select-pane -t "$pane"
else echo "The tab no longer exists; the line was copied."; sleep 1.5; fi
