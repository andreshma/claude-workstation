#!/usr/bin/env bash
#
# tmux-help — everyday shortcuts of the workstation (tmux, Claude Code, shell and PowerShell).
# Opens with Ctrl+b h; any key closes it.
B=$'\033[1m'; M=$'\033[1;35m'; Y=$'\033[33m'; D=$'\033[2m'; R=$'\033[0m'
cat <<TXT
${M}TMUX${R}  ${D}Ctrl+b and then the key · Alt+N without prefix${R}
  ${Y}m${R} or click on ${B}≡ menu${R} (status bar): menu with everything   ${Y}right click${R} on a tab: rename, close, move
  ${Y}o${R} open repo or folder    ${Y}f${R} finder             ${Y}D${R} dashboard        ${Y}A${R} subagents (v: reasoning)
  ${M}Finder:${R} ${Y}f${R} tabs · ${Y}a${R} active · ${Y}F${R} favorites · ${Y}j${R} recent — inside: ${Y}Tab${R} view · ${Y}Ctrl+S${R} reply · ${Y}Alt+Y/N${R} approve/reject · ${Y}Ctrl+O${R} open here
  ${Y}g${R} persistent shell       ${Y}P${R} PowerShell         ${Y}h${R} this help        ${Y}d${R} leave without closing anything
  ${M}No prefix:${R} ${Y}Alt+1…9${R} go · ${Y}Alt+←/→${R} previous/next · ${Y}Alt+0${R} last one used · ${Y}Alt+s${R} find · ${Y}Alt+Shift+←/→${R} move
  ${Y}'${R} go by number (e.g. 12)      ${Y},${R} rename           ${Y}&${R} close tab        ${D}mouse wheel on the status bar: switch${R}
  ${Y}z${R} zoom   ${Y}% "${R} split   ${Y}x${R} close pane   ${Y}[${R} scroll and copy (q quits)   ${Y}Tab${R} extrakto
  ${D}Status bar:${R} ${B}⚠ 2,5${R} waiting for your approval · ${B}⏳ 3(12m)${R} no activity · ${B}◉ \$4/h${R} usage (green/yellow/red)
  In the menu (${Y}Ctrl+b m${R}): ${Y}g${R} go to the next one waiting for you · Views: ${Y}r${R} record, ${Y}V${R} recordings · Workstation: ${Y}I${R} tools, ${Y}Q${R} repo quality
  ${Y}Ctrl+s${R} save   ${Y}Ctrl+r${R} restore   ${Y}r${R} reload config   ${Y}Ctrl+b${R} sends Ctrl+B to Claude

${M}CLAUDE CODE${R}
  ${Y}Esc${R} interrupt   ${Y}Esc Esc${R} go back to an earlier point   ${Y}Shift+Tab${R} modes (plan, auto)   ${Y}Alt+P${R} model
  ${Y}Ctrl+O${R} transcript with reasoning   ${Y}↓${R} subagent panel → ${Y}Enter${R} opens its transcript
  ${Y}Ctrl+B${R} (in tmux: Ctrl+b Ctrl+b) send the task to the background   ${Y}/tasks${R} tasks and subagents
  ${Y}Ctrl+T${R} checklist   ${Y}Ctrl+R${R} history   ${Y}Ctrl+G${R} editor   ${Y}Shift+Enter${R} new line   ${Y}?${R} Claude help
  ${Y}!${R} your own command (outside the sandbox)   ${Y}@${R} file   ${Y}/compact /model /sandbox /exit${R}
  ${Y}claude -c${R} resume   ${Y}claude -r${R} pick a conversation

${M}SHELL${R}  ${B}tw${R} repo · ${B}two${R} with Opus · ${B}twt${R} worktree · ${B}tp${R} pane · ${B}ws-check ws-health ws-update${R} · ${B}claude-report${R}
${M}POWERSHELL${R}  ${B}dev devo devdash devagents devsave devcheck devsnapshot devrestoretest${R}
TXT
printf '\n%sAny key closes%s' "$D" "$R"; read -rsn1
