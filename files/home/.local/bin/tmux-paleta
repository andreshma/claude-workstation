#!/usr/bin/env python3
"""tmux-paleta — command palette: find and run any menu option by typing, like Ctrl+Shift+P
in VS Code. Ctrl+b Space.

Reads the installed menus (~/.config/tmux-claude/menu*.tmux, with the same parser as ws-menus), so it is
always up to date. Shows the key path so you learn it (Ctrl+b m → e → t). Enter runs the option
on the tab from which you opened the palette.
Usage: tmux-paleta <pane>   ·   tmux-paleta --lista   (only prints «path<TAB>option<TAB>command»; for tests)
"""
import importlib.machinery
import importlib.util
import os
import re
import shutil
import subprocess  # nosec B404 — fzf and tmux with fixed arguments
import sys
import tempfile
from pathlib import Path

BIN = Path.home() / ".local/bin"


def cargar_ws_menus():
    cargador = importlib.machinery.SourceFileLoader("ws_menus", str(BIN / "ws-menus"))
    spec = importlib.util.spec_from_loader("ws_menus", cargador)
    mod = importlib.util.module_from_spec(spec)
    cargador.exec_module(mod)
    return mod


def opciones() -> list[tuple[str, str, str]]:
    """[(key path, readable label, tmux command)] of every final option (no submenus)."""
    wm = cargar_ws_menus()
    pre = "Ctrl+b"
    filas, vistos = [], set()

    def visitar(f: Path, ruta: str):
        if f in vistos or not f.exists():
            return
        vistos.add(f)
        for _, et, tecla, cmd in wm.items(f):
            if et.strip().startswith("‹"):
                continue
            paso = f"{ruta} → {wm.tecla_legible(tecla)}"
            if cmd.strip().startswith("source-file") and "menu" in cmd:
                m = re.search(r"(menu[\w-]*\.tmux)", cmd)
                if m:
                    visitar(wm.DIR / m.group(1), paso)
                continue
            filas.append((paso, wm.legible(et), cmd))

    visitar(wm.DIR / "menu.tmux", f"{pre} m")
    for f in sorted(wm.DIR.glob("menu*.tmux")):
        visitar(f, f"({f.stem})")
    return filas


def main() -> int:
    filas = opciones()
    if "--lista" in sys.argv:
        for r, e, c in filas:
            print(f"{r}\t{e}\t{c}")
        return 0
    if not shutil.which("fzf"):
        print("fzf is missing (ws-tools install fzf)."); return 1
    entrada = "\n".join(f"{i}\t{e}\t\033[2m{r}\033[0m" for i, (r, e, _) in enumerate(filas))
    sel = subprocess.run(["fzf", "--ansi", "--delimiter=\t", "--with-nth=2,3", "--reverse", "--tiebreak=begin,length",
                          "--prompt", "› ", "--header", "Type what you want to do · Enter runs · Esc closes"],
                         input=entrada, capture_output=True, text=True).stdout.strip()  # nosec B603 B607
    if not sel:
        return 0
    cmd = filas[int(sel.split("\t", 1)[0])][2].replace('\\"', '"')
    # Same as display-menu: the #{formats} in the command expand against the tab from which you opened the
    # palette; it runs once the popup has closed (so «the current tab» is that one too).
    panel = next((a for a in sys.argv[1:] if a.startswith("%")), "")
    if panel:
        cmd = subprocess.run(["tmux", "display", "-p", "-t", panel, cmd], capture_output=True, text=True).stdout.rstrip("\n") or cmd  # nosec B603 B607
    fd, tmp = tempfile.mkstemp(prefix="tmux-paleta-", suffix=".tmux")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(cmd + "\n")
    subprocess.run(["tmux", "run-shell", "-b", "-d", "0.3", f"tmux source-file '{tmp}'; rm -f '{tmp}'"])  # nosec B603 B607
    return 0


if __name__ == "__main__":
    sys.exit(main())
