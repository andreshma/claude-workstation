#!/usr/bin/env python3
"""ws-traspaso — exports a tab's work so that ANOTHER Claude can continue it (another PC, claude.ai, a colleague,
another account). Menu → Claude → E.

Builds a handoff package in Markdown:
  · summary written by Claude (Sonnet, no tools): goal, status, decisions, pending items, key files, how to
    continue and risks — from the conversation messages, REDACTED (ws-redactar)
  · hard data: folder, branch, uncommitted changes, latest commits, diff against the base branch, Claude's task
    list and the files it touched
  · with --conversacion, also the transcript (.jsonl) to resume it with `claude --resume` on another PC
It is saved in %UserProfile%\\ws-telemetria\\traspasos\\ (and ~/.local/share/ws-telemetria/traspasos/) and copied
to the clipboard to paste it into claude.ai or another Claude.
Usage: ws-traspaso [folder|%pane] [--conversacion] [--sin-ia]
"""
from __future__ import annotations

import datetime as dt
import json
import os
import re
import shutil
import subprocess  # nosec B404 — git, claude, tmux, ws-redactar, ws-copiar with fixed arguments
import sys
from pathlib import Path

HOME = Path.home()
BIN = HOME / ".local/bin"
CLAUDE = Path(os.environ.get("WS_TELEMETRIA_CLAUDE", HOME / ".claude"))
DATOS = Path(os.environ.get("WS_TELEMETRIA_DIR", HOME / ".local/share/ws-telemetria"))


def sh(*a: str, entrada: str | None = None, t: int = 30) -> str:
    try:
        return subprocess.run(list(a), input=entrada, capture_output=True, text=True, timeout=t).stdout.strip()  # nosec B603
    except (OSError, subprocess.SubprocessError):
        return ""


def redactar(t: str) -> str:
    return sh(str(BIN / "ws-redactar"), entrada=t) or t


def carpeta_de(arg: str | None) -> Path:
    if arg and arg.startswith("%"):
        return Path(sh("tmux", "display", "-p", "-t", arg, "#{pane_current_path}") or os.getcwd())
    if arg:
        return Path(arg).resolve()
    if os.environ.get("TMUX"):
        return Path(sh("tmux", "display", "-p", "#{pane_current_path}") or os.getcwd())
    return Path.cwd()


def transcripcion(carpeta: Path) -> Path | None:
    clave = re.sub(r"[^A-Za-z0-9]", "-", str(carpeta))
    d = CLAUDE / "projects" / clave
    fs = sorted(d.glob("*.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True) if d.is_dir() else []
    return fs[0] if fs else None


def leer(f: Path) -> dict:
    msgs, tareas, archivos = [], [], []
    for linea in open(f, encoding="utf-8", errors="replace"):
        try:
            o = json.loads(linea)
        except ValueError:
            continue
        c = (o.get("message") or {}).get("content")
        if o.get("type") == "user" and not o.get("isMeta"):
            t = c if isinstance(c, str) else " ".join(b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text")
            if t and not t.lstrip().startswith("<"):
                msgs.append(("You", t))
        elif o.get("type") == "assistant":
            for b in c or []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text"):
                    msgs.append(("Claude", b["text"]))
                elif b.get("type") == "tool_use":
                    i = b.get("input") or {}
                    if b.get("name") == "TodoWrite":
                        tareas = i.get("todos") or tareas
                    if i.get("file_path") and b.get("name") in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
                        archivos.append(i["file_path"])
    return {"msgs": msgs, "tareas": tareas, "archivos": list(dict.fromkeys(archivos))}


def git(carpeta: Path) -> dict:
    g = lambda *a: sh("git", "-C", str(carpeta), *a)  # noqa: E731
    if not g("rev-parse", "--git-dir"):
        return {}
    rama = g("branch", "--show-current")
    base = next((b for b in ("main", "master", "develop") if g("rev-parse", "-q", "--verify", b) and b != rama), "")
    return {"rama": rama, "remoto": g("remote", "get-url", "origin"), "estado": g("status", "--short")[:3000],
            "commits": g("log", "--oneline", "-8"), "base": base,
            "diff_base": g("diff", "--stat", f"{base}...HEAD")[-2500:] if base else ""}


def resumen_ia(msgs: list, carpeta: Path) -> str:
    if not shutil.which("claude"):
        return "_(Claude is not available: only the data below is included)_"
    texto = "\n\n".join(f"### {q}\n{t[:4000]}" for q, t in msgs)[-60000:]
    texto = redactar(texto)
    prompt = ("You are preparing a HANDOFF PACKAGE so that another Claude instance (or a person) can continue this "
              f"work in “{carpeta.name}”. From the conversation (stdin), write in Markdown, in English, with these "
              "sections: Goal · Current status (what is done) · Decisions made and why · Pending items (in order) · "
              "Key files and commands · How to continue (concrete first step) · Risks and assumptions. Be concrete and "
              "brief; do not make up anything that is not in the conversation.")
    return sh("env", "-u", "TMUX_PANE", "-u", "TMUX", "claude", "-p", "--model", "sonnet", "--tools", "", "--no-session-persistence", prompt, entrada=texto, t=300) \
        or "_(Claude did not answer: only the data below is included)_"


def main() -> int:
    a = sys.argv[1:]
    arg = next((x for x in a if not x.startswith("--")), None)
    carpeta = carpeta_de(arg)
    f = transcripcion(carpeta)
    datos = leer(f) if f else {"msgs": [], "tareas": [], "archivos": []}
    g = git(carpeta)
    hoy = dt.datetime.now().strftime("%Y-%m-%d_%H%M")
    md = [f"# Handoff: {carpeta.name} — {dt.datetime.now():%Y-%m-%d %H:%M}", "",
          f"_Package to continue this work in another Claude. Original folder: `{carpeta}`._", ""]
    md += ["## Summary", "", resumen_ia(datos["msgs"], carpeta) if datos["msgs"] and "--sin-ia" not in a else "_(no summary from Claude)_", ""]
    if datos["tareas"]:
        md += ["## Claude's task list", ""] + [f"- [{'x' if t.get('status') == 'completed' else ' '}] {t.get('content', '')}" for t in datos["tareas"]] + [""]
    if g:
        md += ["## Repository", "", f"- Branch: `{g['rama']}` · remote: `{g['remoto'] or '—'}`" + (f" · base: `{g['base']}`" if g["base"] else ""), "",
               "Latest commits:", "```", g["commits"] or "—", "```", "Uncommitted changes:", "```", g["estado"] or "(none)", "```"]
        if g["diff_base"]:
            md += [f"Diff against `{g['base']}`:", "```", g["diff_base"], "```"]
        md.append("")
    if datos["archivos"]:
        md += ["## Files Claude touched", ""] + [f"- `{os.path.relpath(p, carpeta) if p.startswith(str(carpeta)) else p}`" for p in datos["archivos"][-30:]] + [""]
    if datos["msgs"]:
        ult = [t for q, t in datos["msgs"] if q == "You"][-3:]
        md += ["## Your latest requests", ""] + [f"> {redactar(t[:600]).strip()}" for t in ult] + [""]
    out = DATOS / "traspasos"; out.mkdir(parents=True, exist_ok=True)
    nombre = f"{carpeta.name}-{hoy}"
    texto = "\n".join(md) + "\n"
    if "--conversacion" in a and f:
        shutil.copyfile(f, out / f"{nombre}.jsonl")
        clave = re.sub(r"[^A-Za-z0-9]", "-", str(carpeta))
        texto += ("\n## Resume the conversation on another PC with Claude Code\n\n"
                  f"1. Copy `{nombre}.jsonl` to `~/.claude/projects/<encoded-folder>/` (here it was `{clave}`: every "
                  "character of the path that is not a letter or a digit becomes `-`).\n2. In that folder: `claude --resume` and pick it.\n")
    (out / f"{nombre}.md").write_text(texto, encoding="utf-8")
    final = out / f"{nombre}.md"
    w = None if os.environ.get("WS_TRASPASO_SIN_WINDOWS") else sh("wslvar", "USERPROFILE")
    if w:
        wd = Path(sh("wslpath", "-u", w)) / "ws-telemetria/traspasos"
        try:
            wd.mkdir(parents=True, exist_ok=True)
            for ext in ("md", "jsonl"):
                if (out / f"{nombre}.{ext}").exists():
                    shutil.copyfile(out / f"{nombre}.{ext}", wd / f"{nombre}.{ext}")
            final = wd / f"{nombre}.md"
        except OSError:
            pass
    sh(str(BIN / "ws-copiar"), entrada=texto)
    print(texto)
    print(f"Handoff: {final}  (also on the clipboard: paste it into claude.ai or another Claude)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
