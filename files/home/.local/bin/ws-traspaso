#!/usr/bin/env python3
"""ws-traspaso — exporta el trabajo de una pestaña para que OTRO Claude lo continúe (otra PC, claude.ai, un colega,
otra cuenta). Menú → Claude → E.

Arma un paquete de traspaso en Markdown:
  · resumen hecho por Claude (Sonnet, sin herramientas): objetivo, estado, decisiones, pendientes, archivos clave,
    cómo continuar y riesgos — a partir de los mensajes de la conversación, REDACTADOS (ws-redactar)
  · datos duros: carpeta, rama, cambios sin commit, últimos commits, diff contra la rama base, lista de tareas de
    Claude y archivos que tocó
  · con --conversacion, además la transcripción (.jsonl) para retomarla con `claude --resume` en otra PC
Se guarda en %UserProfile%\\ws-telemetria\\traspasos\\ (y ~/.local/share/ws-telemetria/traspasos/) y se copia al
portapapeles para pegarlo en claude.ai o en otro Claude.
Uso: ws-traspaso [carpeta|%panel] [--conversacion] [--sin-ia]
"""
from __future__ import annotations

import datetime as dt
import json
import os
import re
import shutil
import subprocess  # nosec B404 — git, claude, tmux, ws-redactar, ws-copiar con argumentos fijos
import sys
from pathlib import Path

HOME = Path.home()
BIN = HOME / ".local/bin"
CLAUDE = Path(os.environ.get("WS_TELEMETRIA_CLAUDE", HOME / ".claude"))
DATOS = Path(os.environ.get("WS_TELEMETRIA_DIR", HOME / ".local/share/ws-telemetria"))


def sh(*a: str, entrada: str | None = None, t: int = 30) -> str:
    try:
        return subprocess.run(list(a), input=entrada, capture_output=True, text=True, timeout=t).stdout.strip()  # nosec B603
    except (OSError, subprocess.SubprocessError):
        return ""


def redactar(t: str) -> str:
    return sh(str(BIN / "ws-redactar"), entrada=t) or t


def carpeta_de(arg: str | None) -> Path:
    if arg and arg.startswith("%"):
        return Path(sh("tmux", "display", "-p", "-t", arg, "#{pane_current_path}") or os.getcwd())
    if arg:
        return Path(arg).resolve()
    if os.environ.get("TMUX"):
        return Path(sh("tmux", "display", "-p", "#{pane_current_path}") or os.getcwd())
    return Path.cwd()


def transcripcion(carpeta: Path) -> Path | None:
    clave = re.sub(r"[^A-Za-z0-9]", "-", str(carpeta))
    d = CLAUDE / "projects" / clave
    fs = sorted(d.glob("*.jsonl"), key=lambda f: f.stat().st_mtime, reverse=True) if d.is_dir() else []
    return fs[0] if fs else None


def leer(f: Path) -> dict:
    msgs, tareas, archivos = [], [], []
    for linea in open(f, encoding="utf-8", errors="replace"):
        try:
            o = json.loads(linea)
        except ValueError:
            continue
        c = (o.get("message") or {}).get("content")
        if o.get("type") == "user" and not o.get("isMeta"):
            t = c if isinstance(c, str) else " ".join(b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text")
            if t and not t.lstrip().startswith("<"):
                msgs.append(("Tú", t))
        elif o.get("type") == "assistant":
            for b in c or []:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text" and b.get("text"):
                    msgs.append(("Claude", b["text"]))
                elif b.get("type") == "tool_use":
                    i = b.get("input") or {}
                    if b.get("name") == "TodoWrite":
                        tareas = i.get("todos") or tareas
                    if i.get("file_path") and b.get("name") in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
                        archivos.append(i["file_path"])
    return {"msgs": msgs, "tareas": tareas, "archivos": list(dict.fromkeys(archivos))}


def git(carpeta: Path) -> dict:
    g = lambda *a: sh("git", "-C", str(carpeta), *a)  # noqa: E731
    if not g("rev-parse", "--git-dir"):
        return {}
    rama = g("branch", "--show-current")
    base = next((b for b in ("main", "master", "develop") if g("rev-parse", "-q", "--verify", b) and b != rama), "")
    return {"rama": rama, "remoto": g("remote", "get-url", "origin"), "estado": g("status", "--short")[:3000],
            "commits": g("log", "--oneline", "-8"), "base": base,
            "diff_base": g("diff", "--stat", f"{base}...HEAD")[-2500:] if base else ""}


def resumen_ia(msgs: list, carpeta: Path) -> str:
    if not shutil.which("claude"):
        return "_(Claude no está disponible: va solo con los datos de abajo)_"
    texto = "\n\n".join(f"### {q}\n{t[:4000]}" for q, t in msgs)[-60000:]
    texto = redactar(texto)
    prompt = ("Vas a preparar un PAQUETE DE TRASPASO para que otra instancia de Claude (o una persona) continúe este "
              f"trabajo en «{carpeta.name}». Con la conversación (stdin), escribe en Markdown, en español, con estas "
              "secciones: Objetivo · Estado actual (qué quedó hecho) · Decisiones tomadas y por qué · Pendientes (en orden) · "
              "Archivos y comandos clave · Cómo continuar (primer paso concreto) · Riesgos y supuestos. Sé concreto y breve; "
              "no inventes nada que no esté en la conversación.")
    return sh("env", "-u", "TMUX_PANE", "-u", "TMUX", "claude", "-p", "--model", "sonnet", "--tools", "", "--no-session-persistence", prompt, entrada=texto, t=300) \
        or "_(Claude no respondió: va solo con los datos de abajo)_"


def main() -> int:
    a = sys.argv[1:]
    arg = next((x for x in a if not x.startswith("--")), None)
    carpeta = carpeta_de(arg)
    f = transcripcion(carpeta)
    datos = leer(f) if f else {"msgs": [], "tareas": [], "archivos": []}
    g = git(carpeta)
    hoy = dt.datetime.now().strftime("%Y-%m-%d_%H%M")
    md = [f"# Traspaso: {carpeta.name} — {dt.datetime.now():%Y-%m-%d %H:%M}", "",
          f"_Paquete para continuar este trabajo en otro Claude. Carpeta original: `{carpeta}`._", ""]
    md += ["## Resumen", "", resumen_ia(datos["msgs"], carpeta) if datos["msgs"] and "--sin-ia" not in a else "_(sin resumen de Claude)_", ""]
    if datos["tareas"]:
        md += ["## Lista de tareas de Claude", ""] + [f"- [{'x' if t.get('status') == 'completed' else ' '}] {t.get('content', '')}" for t in datos["tareas"]] + [""]
    if g:
        md += ["## Repositorio", "", f"- Rama: `{g['rama']}` · remoto: `{g['remoto'] or '—'}`" + (f" · base: `{g['base']}`" if g["base"] else ""), "",
               "Últimos commits:", "```", g["commits"] or "—", "```", "Cambios sin commit:", "```", g["estado"] or "(ninguno)", "```"]
        if g["diff_base"]:
            md += [f"Diferencia contra `{g['base']}`:", "```", g["diff_base"], "```"]
        md.append("")
    if datos["archivos"]:
        md += ["## Archivos que tocó Claude", ""] + [f"- `{os.path.relpath(p, carpeta) if p.startswith(str(carpeta)) else p}`" for p in datos["archivos"][-30:]] + [""]
    if datos["msgs"]:
        ult = [t for q, t in datos["msgs"] if q == "Tú"][-3:]
        md += ["## Tus últimos pedidos", ""] + [f"> {redactar(t[:600]).strip()}" for t in ult] + [""]
    out = DATOS / "traspasos"; out.mkdir(parents=True, exist_ok=True)
    nombre = f"{carpeta.name}-{hoy}"
    texto = "\n".join(md) + "\n"
    if "--conversacion" in a and f:
        shutil.copyfile(f, out / f"{nombre}.jsonl")
        clave = re.sub(r"[^A-Za-z0-9]", "-", str(carpeta))
        texto += ("\n## Retomar la conversación en otra PC con Claude Code\n\n"
                  f"1. Copia `{nombre}.jsonl` a `~/.claude/projects/<carpeta-codificada>/` (aquí era `{clave}`: cada carácter "
                  "que no es letra ni número de la ruta se vuelve `-`).\n2. En esa carpeta: `claude --resume` y elígela.\n")
    (out / f"{nombre}.md").write_text(texto, encoding="utf-8")
    final = out / f"{nombre}.md"
    w = None if os.environ.get("WS_TRASPASO_SIN_WINDOWS") else sh("wslvar", "USERPROFILE")
    if w:
        wd = Path(sh("wslpath", "-u", w)) / "ws-telemetria/traspasos"
        try:
            wd.mkdir(parents=True, exist_ok=True)
            for ext in ("md", "jsonl"):
                if (out / f"{nombre}.{ext}").exists():
                    shutil.copyfile(out / f"{nombre}.{ext}", wd / f"{nombre}.{ext}")
            final = wd / f"{nombre}.md"
        except OSError:
            pass
    sh(str(BIN / "ws-copiar"), entrada=texto)
    print(texto)
    print(f"Traspaso: {final}  (también en el portapapeles: pégalo en claude.ai o en otro Claude)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
