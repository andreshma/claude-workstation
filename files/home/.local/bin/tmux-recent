#!/usr/bin/env python3
"""tmux-recent — your recent work with Claude, from ALL projects: the data behind the «recent» view of tmux-find.

Each row: how long ago, project, branch, whether it has an open tab (● group:tab) and your last request (redacted).
The conversation text (your latest requests and the last thing Claude answered) is what the finder shows on the right.
Usage:
  tmux-recent [--days 7]             opens the finder on the recent view (Ctrl+b j)
  tmux-recent --list [--days N]      the rows: go|open<TAB>tab|folder<TAB>id<TAB>file<TAB>visible text
  tmux-recent --show <file.jsonl>    your latest requests and Claude's last answer in that conversation (redacted)
  tmux-recent --latest <folder>      path of the latest conversation of that folder (nothing if there is none)
  tmux-recent --open <file.jsonl>    opens a tab in the conversation's group and resumes THAT conversation
Reads the header and the end of each conversation (not the whole file) with a per-file cache: it is fast even with
hundreds of conversations.
"""
from __future__ import annotations

import datetime as dt
import json
import os
import re
import subprocess  # nosec B404 — tmux and ws-redact with fixed arguments
import sys
import time
from pathlib import Path

HOME = Path.home()
CLAUDE = Path(os.environ.get("WS_TELEMETRY_CLAUDE", HOME / ".claude"))
CACHE = Path(os.environ.get("XDG_RUNTIME_DIR") or HOME / ".cache") / f"tmux-recent-{os.getuid()}.json"
BIN = HOME / ".local/bin"
SEP = "\t"


def sh(*a: str, stdin: str | None = None) -> str:
    try:
        return subprocess.run(list(a), input=stdin, capture_output=True, text=True, timeout=20).stdout  # nosec B603
    except (OSError, subprocess.SubprocessError):
        return ""


def text_of(c) -> str:
    if isinstance(c, str):
        return c
    return " ".join(b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text")


def is_prompt(o: dict) -> bool:
    if o.get("type") != "user" or o.get("isMeta"):
        return False
    t = text_of((o.get("message") or {}).get("content"))
    return bool(t.strip()) and not t.lstrip().startswith("<")


def summarize(f: Path) -> dict | None:
    """Header (cwd, branch, start) and end (last request, last answer) without reading the whole file."""
    info = {"cwd": "", "branch": "", "request": "", "answer": ""}
    try:
        with open(f, "rb") as fh:
            for _ in range(40):
                l = fh.readline()
                if not l:
                    break
                try:
                    o = json.loads(l)
                except ValueError:
                    continue
                info["cwd"] = info["cwd"] or o.get("cwd") or ""
                info["branch"] = info["branch"] or o.get("gitBranch") or ""
            start = max(0, f.stat().st_size - 200_000)
            fh.seek(start)
            tail = fh.read().decode("utf-8", "replace").splitlines()[1 if start else 0:]   # the first one may be cut off
    except OSError:
        return None
    for l in reversed(tail):
        try:
            o = json.loads(l)
        except ValueError:
            continue
        info["cwd"] = info["cwd"] or o.get("cwd") or ""
        info["branch"] = o.get("gitBranch") or info["branch"]
        if not info["answer"] and o.get("type") == "assistant":
            info["answer"] = text_of((o.get("message") or {}).get("content"))[:600]
        if not info["request"] and is_prompt(o):
            info["request"] = text_of(o["message"]["content"])[:300]
        if info["request"] and info["answer"]:
            break
    return info if info["cwd"] else None


def conversations(days: int) -> list[dict]:
    cutoff = time.time() - days * 86400
    try:
        cache = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    fresh, rows = {}, []
    for f in (CLAUDE / "projects").glob("*/*.jsonl"):
        try:
            st = f.stat()
        except OSError:
            continue
        if st.st_mtime < cutoff or st.st_size < 200:
            continue
        key, sig = str(f), f"{st.st_mtime_ns}:{st.st_size}"
        r = cache.get(key)
        if not r or r.get("sig") != sig:
            r = summarize(f)
            if not r:
                continue
            r["sig"] = sig
        fresh[key] = r
        rows.append({**r, "file": key, "id": f.stem, "mtime": st.st_mtime})
    try:
        CACHE.write_text(json.dumps(fresh)); os.chmod(CACHE, 0o600)
    except OSError:
        pass
    return sorted(rows, key=lambda x: -x["mtime"])


def tabs() -> dict:
    """folder → «group:index name» of the tab that has it open (and its window id)."""
    out = {}
    for l in sh("tmux", "list-panes", "-a", "-F", "#{pane_current_path}\t#{?session_grouped,#{session_group},#{session_name}}\t#{session_name}\t#{window_index} #{window_name}\t#{window_id}").splitlines():
        p = l.split("\t")
        if len(p) == 5 and p[1] == p[2] and os.path.realpath(p[0]) not in out:
            out[os.path.realpath(p[0])] = (f"{p[1]}:{p[3]}", f"{p[2]}:{p[4]}")
    return out


def ago(t: float) -> str:
    s = int(time.time() - t)
    return f"{s // 60}m" if s < 3600 else (f"{s // 3600}h" if s < 86400 else f"{s // 86400}d")


def redact(t: str) -> str:
    r = sh(str(BIN / "ws-redact"), stdin=t)
    return r or t


def listing(days: int) -> str:
    convs, open_tabs = conversations(days), tabs()
    texts = redact("\n".join(re.sub(r"\s+", " ", c["request"])[:110] or "—" for c in convs)).splitlines() if convs else []
    lines = []
    for c, t in zip(convs, texts + [""] * len(convs)):
        tab = open_tabs.get(os.path.realpath(c["cwd"]))
        status = f"\033[32m● {tab[0][:22]}\033[0m" if tab else "\033[2m○ no tab\033[0m"
        proj = Path(c["cwd"]).name
        action = f"go{SEP}{tab[1]}" if tab else f"open{SEP}{c['cwd']}"
        lines.append(f"{action}{SEP}{c['id']}{SEP}{c['file']}{SEP}"
                      f"{ago(c['mtime']):>4}  \033[36m{proj[:22]:<22}\033[0m {c['branch'][:20]:<20} {status:<34} {t}")
    return "\n".join(lines)


def show(file: str) -> str:
    requests, latest = [], ""
    for l in open(file, encoding="utf-8", errors="replace"):
        try:
            o = json.loads(l)
        except ValueError:
            continue
        if is_prompt(o):
            requests.append(text_of(o["message"]["content"]))
        elif o.get("type") == "assistant":
            t = text_of((o.get("message") or {}).get("content"))
            latest = t or latest
    txt = "Your latest requests:\n" + "\n".join(f"  › {p[:300]}" for p in requests[-4:]) + f"\n\nClaude's latest:\n{latest[-1200:]}"
    return redact(txt)


def group_of(folder: str) -> str:
    conf = HOME / ".config/tmux-claude/roots.txt"
    if conf.exists():
        for l in conf.read_text(encoding="utf-8").splitlines():
            p = l.split("|")
            if len(p) == 3 and not l.startswith("#"):
                root = p[2].replace("~", str(HOME), 1)
                if folder == root or folder.startswith(root.rstrip("/") + "/"):
                    return p[0]
    return sh("tmux", "display", "-p", "#S").strip() or "dev"


def latest(folder: str) -> str:
    """Latest conversation of a folder: Claude keeps them under projects/<folder with every non-alphanumeric as «-»>."""
    key = re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(folder))
    found = []
    for f in (CLAUDE / "projects" / key).glob("*.jsonl"):
        try:
            st = f.stat()
        except OSError:
            continue
        if st.st_size >= 200:
            found.append((st.st_mtime, str(f)))
    return max(found)[1] if found else ""


def open_conversation(file: str) -> int:
    """New tab in the group of the conversation's folder, resuming that conversation (claude-resume --resume <id>)."""
    info, sid = summarize(Path(file)), Path(file).stem
    if not info or not re.fullmatch(r"[A-Za-z0-9_-]+", sid):
        print(f"Not a conversation that can be resumed: {file}"); return 1
    target = info["cwd"]
    if not os.path.isdir(target):
        print(f"The folder of that conversation no longer exists: {target}"); return 1
    g = group_of(target)
    if subprocess.run(["tmux", "has-session", "-t", f"={g}"], capture_output=True).returncode:  # nosec B603 B607
        sh("tmux", "new-session", "-d", "-s", g, "-c", target)
        w = sh("tmux", "list-windows", "-t", f"={g}", "-F", "#{window_id}").split()[0]
    else:
        w = sh("tmux", "new-window", "-d", "-P", "-F", "#{window_id}", "-t", f"={g}:", "-c", target, "-n", Path(target).name).strip()
    sh("tmux", "send-keys", "-t", w, f"claude-resume --resume {sid}", "Enter")   # normal level, that conversation
    sh("tmux", "switch-client", "-t", f"={g}"); sh("tmux", "select-window", "-t", w)
    return 0


def main() -> int:
    a = sys.argv[1:]
    days = int(a[a.index("--days") + 1]) if "--days" in a else 7
    if a and a[0] == "--list":
        print(listing(days)); return 0
    if len(a) > 1 and a[0] == "--show":
        print(show(a[1])); return 0
    if len(a) > 1 and a[0] == "--latest":
        f = latest(a[1])
        if f:
            print(f)
        return 0 if f else 1
    if len(a) > 1 and a[0] == "--open":
        return open_conversation(a[1])
    # No mode: the list itself lives in the finder (tmux-find), where «recent» is one of its views.
    find = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "tmux-find")
    try:
        os.execv(find, [find, "--view", "recent", "--days", str(days)])  # nosec B606 — fixed sibling script
    except OSError as e:
        print(f"tmux-find is not installed next to tmux-recent: {e}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
