#!/usr/bin/env bash
#
# cr — ruteo de modelos desde la terminal (ADR-009). Clasifica la tarea, te dice qué nivel y por qué, y
# con tu confirmación la manda a Claude de esta pestaña con el modelo correcto (o abre Claude con él).
#
# Uso:
#   cr "tarea"                 clasifica, pregunta [S/n] y la envía
#   cr -t sonnet "tarea"       fuerza el nivel (fable · opus · sonnet · haiku)
#   cr --explica "tarea"       además muestra la regla y el modelo
#   cr --dry-run "tarea"       solo clasifica; no envía nada
#   cr --sin-ia "tarea"        sin regla que coincida → opus, sin consultar a Haiku
#   cr --cambiar <nivel>       cambia el modelo del Claude de esta pestaña (lo usa el menú)
#   cr --probar                corre las 20 tareas etiquetadas contra las reglas (sin IA); exit 1 si < 90 %
# Sin regla que coincida y con el copiloto configurado (ws-copiloto), consulta a Haiku:
# {nivel, confianza}; con confianza < 0.7 sube un nivel. El texto va redactado (sin secretos).
set -uo pipefail
# shellcheck source=/dev/null
source "$HOME/.local/lib/ws-ruteo.sh" || { echo "✖ falta ~/.local/lib/ws-ruteo.sh" >&2; exit 1; }

forzado="" explica=0 seco=0 ia=1
uso() { sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

probar() {
  local ok=0 total=0 esperado tarea obtenido
  while IFS='|' read -r esperado tarea; do
    [[ -z "$esperado" ]] && continue
    total=$((total + 1)); obtenido="$(ruteo_clasificar "$tarea" | cut -d' ' -f1)"
    if [[ "$obtenido" == "$esperado" ]]; then ok=$((ok + 1)); else printf '  ✖ %-7s→ %-7s %s\n' "$esperado" "$obtenido" "$tarea"; fi
  done <<'EOF'
fable|diseña la arquitectura de la plataforma de pagos con C4
fable|escribe un ADR para elegir entre Kafka y Service Bus
fable|haz un threat model del API de clientes
fable|refactor global de todo el repo a arquitectura hexagonal
opus|depura por qué falla el login con 500
opus|revisa este stack trace de NullReferenceException
opus|hay una fuga de memoria en el worker de colas
opus|prepara el release 2.3 con plan de rollback
opus|revisa vulnerabilidades OWASP del endpoint de pagos
opus|implementa el endpoint de facturas con sus pruebas
sonnet|escribe una consulta SQL que sume las ventas por mes
sonnet|optimiza este SELECT con un JOIN lento sobre pedidos
sonnet|crea el stored procedure de alta de clientes
sonnet|corrige el typo en el README
sonnet|escribe el mensaje de commit para estos cambios
sonnet|traduce este one-pager al inglés
haiku|busca dónde se define UserService
haiku|dónde está la configuración de Redis
haiku|lista los archivos de pruebas del módulo de pagos
haiku|cuántos endpoints tiene el controlador de órdenes
EOF
  local pct=$(( ok * 100 / total ))
  echo "Reglas: $ok/$total tareas etiquetadas en su nivel ($pct %)"
  (( pct >= 90 ))
}

clasificar_ia() {   # $1 tarea → "nivel confianza" o nada
  local f="$HOME/.config/tmux-claude/ai-shell.sh" r
  [[ -f "$f" ]] || return 1
  r="$( (
    # shellcheck source=/dev/null
    source "$f" 2>/dev/null; _ai_cargar_llave 2>/dev/null || exit 1
    printf '%s' "$1" | _ai_redact | _ai_api 'Clasifica la tarea de programación en un nivel de modelo: fable (arquitectura, ADR, análisis exhaustivo, cambios de muchos archivos), opus (desarrollo diario, depuración, seguridad, entregas), sonnet (SQL, cambios acotados, textos cortos), haiku (búsquedas y preguntas simples). Responde SOLO JSON: {"nivel":"...","confianza":0.0}' 60 8
  ) 2>/dev/null)" || return 1
  r="$(grep -o '{[^}]*}' <<<"$r" | head -1)"
  jq -r 'select(.nivel|test("^(fable|opus|sonnet|haiku)$")) | "\(.nivel) \(.confianza // 0)"' <<<"$r" 2>/dev/null
}

while (( $# )); do
  case "$1" in
    -t|--tier) forzado="${2:-}"; shift 2 ;;
    --explica) explica=1; shift ;;
    --dry-run) seco=1; shift ;;
    --sin-ia) ia=0; shift ;;
    --probar) probar; exit $? ;;
    --cambiar)
      nv="${2:-}"; ruteo_modelo "$nv" >/dev/null || { echo "✖ nivel inválido: $nv" >&2; exit 2; }
      pc="$(ruteo_panel_claude "$(tmux display -p '#{window_id}')")"
      [[ -n "$pc" ]] || { tmux display-message "No hay Claude en esta pestaña"; exit 1; }
      ruteo_cambiar "$pc" "$nv"; ruteo_registrar menu "$nv" manual "" manual 0
      tmux display-message "Modelo de esta pestaña: $(ruteo_modelo "$nv")"; exit 0 ;;
    -h|--help) uso ;;
    --) shift; break ;;
    -*) echo "✖ opción desconocida: $1" >&2; uso 2 ;;
    *) break ;;
  esac
done
tarea="$*"; [[ -n "$tarea" ]] || { [[ -t 0 ]] && uso 2; tarea="$(cat)"; }
[[ -n "$tarea" ]] || uso 2

if [[ -n "$forzado" ]]; then
  ruteo_modelo "$forzado" >/dev/null || { echo "✖ nivel inválido: $forzado" >&2; exit 2; }
  nivel="$forzado" regla="manual"
else
  read -r nivel regla <<<"$(ruteo_clasificar "$tarea")"
  if [[ "$regla" == defecto && $ia -eq 1 ]] && r="$(clasificar_ia "$tarea")" && [[ -n "$r" ]]; then
    read -r nivel conf <<<"$r"; regla="haiku:$conf"
    awk -v c="$conf" 'BEGIN { exit !(c < 0.7) }' && { nivel="$(ruteo_subir "$nivel")"; regla="$regla→sube"; }
  fi
fi
id="$(ruteo_modelo "$nivel")"
printf 'Nivel: \e[1m%s\e[0m → %s' "$nivel" "$id"; (( explica )) && printf '   (regla: %s)' "$regla"; echo
(( seco )) && { ruteo_registrar cr "$nivel" "$regla" "" simulado "${#tarea}"; exit 0; }

pc=""; [[ -n "${TMUX_PANE:-}" ]] && pc="$(ruteo_panel_claude "$(tmux display -p -t "$TMUX_PANE" '#{window_id}')")"
if [[ -n "$pc" ]]; then
  actual="$(ruteo_nivel_de "$(tmux show -wqv -t "$pc" @cmodel)")"
  read -rp "¿Enviar a Claude de esta pestaña${actual:+ (ahora $actual)} con $nivel? [S/n] " r
  [[ "$r" =~ ^[nN]$ ]] && { ruteo_registrar cr "$nivel" "$regla" "$actual" rechazado "${#tarea}"; exit 0; }
  [[ "$actual" != "$nivel" ]] && ruteo_cambiar "$pc" "$nivel"
  f="$(umask 077; mkdir -p "$WS_RUTEO_RUN"; mktemp "$WS_RUTEO_RUN/cr-XXXXXX")"; printf '%s' "$tarea" > "$f"
  ruteo_pegar "$pc" "$f" enviar; tmux select-pane -t "$pc"
  ruteo_registrar cr "$nivel" "$regla" "$actual" aceptado "${#tarea}"
else
  read -rp "¿Abrir Claude aquí con $nivel ($id)? [S/n] " r
  [[ "$r" =~ ^[nN]$ ]] && { ruteo_registrar cr "$nivel" "$regla" "" rechazado "${#tarea}"; exit 0; }
  ruteo_registrar cr "$nivel" "$regla" "" aceptado "${#tarea}"
  # --model aplica solo a esta sesión: no cambia tu modelo por defecto.
  exec claude --model "$id" "$tarea"
fi
