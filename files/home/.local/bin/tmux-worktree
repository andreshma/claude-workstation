#!/usr/bin/env bash
#
# tmux-worktree <dir> <rama> — crea (si falta) el worktree de <rama> para el repo que
# contiene <dir> y lo abre en su pestaña con Claude (función twt). Lo usa el menú (w).
set -euo pipefail
dir="${1:?carpeta}"; rama="${2:-}"
fail() { tmux display -d 4000 "Worktree: $*"; exit 1; }
[[ -n "$rama" ]] || fail "falta el nombre de la rama"
git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || fail "$dir no es un repo git"
git check-ref-format --branch "$rama" >/dev/null 2>&1 || fail "nombre de rama no válido: $rama"
# shellcheck source=/dev/null
source "$HOME/.config/tmux-claude/functions.sh"
twt "$dir" "$rama" >/dev/null 2>&1 || fail "no se pudo crear $rama (¿ya existe en otro worktree?)"
