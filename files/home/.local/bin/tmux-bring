#!/usr/bin/env bash
#
# tmux-bring — opens in tmux the recent Claude conversations that have no tab, organized in one
# tmux session per group (the labels of ~/.config/tmux-claude/roots.txt: repos, code, downloads…;
# whatever falls in none goes to «other»).
#
# Usage:
#   tmux-bring                 shows the list (last 7 days) and asks before opening
#   tmux-bring --days 14       another time window
#   tmux-bring --start       starts Claude in each tab (by default it leaves it ready: it types
#                              `claude --resume <id>` and waits for your Enter, so 20 Claudes do not start at once)
#   tmux-bring --reorganize   also moves the tabs you already have in «dev» to their group's session
#   tmux-bring --dry-run       only shows what it would do
#   tmux-bring --windows       brings the ones from the WINDOWS Claude (C:\Users\…\.claude): copies each conversation
#                              to WSL (the original is untouched) and opens it here. With many, pick with fzf (Tab marks).
#   tmux-bring --windows --import-only   copies all to WSL without opening tabs: they show in each folder's `claude -r`
#   --max N                    maximum number of tabs to open without asking one by one (default 15)
# Navigating: Alt+↑/↓ switches group, Ctrl+b S lists the groups with their tabs, Alt+1…9 inside the group.
set -uo pipefail
conf="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-claude/roots.txt"
PROJ="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
TAB=$'\t'
days=7 start=0 reorg=0 dry=0 win=0 import_only=0 max=15
while (( $# )); do
  case "$1" in
    --days) days="${2:?number of days}"; shift 2 ;;
    --start) start=1; shift ;;
    --reorganize) reorg=1; shift ;;
    --dry-run) dry=1; shift ;;
    --windows) win=1; shift ;;
    --import-only) import_only=1; shift ;;
    --max) max="${2:?number}"; shift 2 ;;
    *) sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
  esac
done
command -v tmux >/dev/null && tmux list-sessions >/dev/null 2>&1 || { echo "✖ tmux is not running"; exit 1; }

#######################################
# Group of a folder: the label of the roots.txt root that contains it (the longest one wins).
#######################################
group_of() {
  local d="$1" label root best="" longest=0
  [[ -f "$conf" ]] || { echo other; return; }
  while IFS='|' read -r label _ root; do
    [[ -z "$label" || "$label" == \#* ]] && continue
    root="${root/#\~/$HOME}"
    if [[ "$d" == "$root" || "$d" == "$root"/* ]] && (( ${#root} > longest )); then best="$label"; longest=${#root}; fi
  done < "$conf"
  echo "${best:-other}"
}
name_of() {   # repo or repo@branch for worktrees <repo>.wt/<branch>
  local d="$1"
  if [[ "$d" == *.wt/* ]]; then local r="${d%%.wt/*}"; echo "$(basename "$r")@$(basename "$d")"; else basename "$d"; fi
}

# Folders that already have a tab (in any session)
declare -A open=()
while IFS= read -r d; do [[ -n "$d" ]] && open["$d"]=1; done < <(tmux list-panes -a -F '#{pane_current_path}' 2>/dev/null)

# Recent conversations: the most recent one per project folder (the real folder comes from the log, cwd field).
win_home() {
  local p=""; command -v wslvar >/dev/null && p="$(wslvar USERPROFILE 2>/dev/null || true)"
  [[ -n "$p" ]] || p="$( (cd /mnt/c 2>/dev/null && cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null) | tr -d '\r')"
  [[ -n "$p" ]] && wslpath -u "$p" 2>/dev/null
}
enc() { sed 's#[^A-Za-z0-9]#-#g' <<<"$1"; }   # project folder name, the way Claude builds it
ORIG="$PROJ"
if (( win )); then
  ORIG="$(win_home)/.claude/projects"; [[ -d "$ORIG" ]] || { echo "✖ Cannot find $ORIG"; exit 1; }
fi
declare -A conv=() mtime=() file=()
for pd in "$ORIG"/*/; do
  f="$(find "$pd" -maxdepth 1 -name '*.jsonl' -mtime "-$days" -printf '%T@ %p\n' 2>/dev/null | sort -rn | sed -n 1p | cut -d' ' -f2-)"
  [[ -n "$f" ]] || continue
  cwd="$(tail -n 80 "$f" 2>/dev/null | jq -r 'select(.cwd != null) | .cwd' 2>/dev/null | tail -1)"
  [[ -n "$cwd" ]] || continue
  if (( win )); then
    [[ "$cwd" =~ ^[A-Za-z]:\\ ]] || continue          # Windows paths only (C:\…)
    cwd="$(wslpath -u "$cwd" 2>/dev/null)" || continue
  fi
  [[ -d "$cwd" ]] || continue
  m="$(stat -c %Y "$f")"
  if [[ -z "${mtime[$cwd]:-}" ]] || (( m > ${mtime[$cwd]} )); then mtime["$cwd"]="$m"; conv["$cwd"]="$(basename "$f" .jsonl)"; file["$cwd"]="$f"; fi
done

#######################################
# Copies a conversation from the Windows Claude to WSL (and its subagents folder); never overwrites.
#######################################
import_conv() {
  local f="$1" cwd="$2" d id; id="$(basename "$f" .jsonl)"; d="$PROJ/$(enc "$cwd")"
  mkdir -p "$d"
  [[ -e "$d/$id.jsonl" ]] || cp -p "$f" "$d/$id.jsonl"
  [[ -d "${f%.jsonl}" && ! -e "$d/$id" ]] && cp -rp "${f%.jsonl}" "$d/$id"
  return 0
}
if (( win && import_only )); then
  n=0
  for pd in "$ORIG"/*/; do
    while IFS= read -r -d '' f; do
      cwd="$(tail -n 80 "$f" 2>/dev/null | jq -r 'select(.cwd != null) | .cwd' 2>/dev/null | tail -1)"
      [[ "$cwd" =~ ^[A-Za-z]:\\ ]] || continue
      cwd="$(wslpath -u "$cwd" 2>/dev/null)" || continue
      [[ -d "$cwd" ]] || continue                     # folder that no longer exists: useless in WSL
      import_conv "$f" "$cwd"; n=$((n + 1))
    done < <(find "$pd" -maxdepth 1 -name '*.jsonl' -mtime "-$days" -print0 2>/dev/null)
  done
  echo "✔ $n conversations from the Windows Claude copied to WSL (already copied ones are untouched)."
  echo "  In each tab: claude -r to pick one. The original on Windows did not change."
  exit 0
fi

list=()
for cwd in "${!conv[@]}"; do
  [[ -n "${open[$cwd]:-}" ]] && continue
  [[ "$cwd" == "$HOME" ]] && continue
  list+=("$(group_of "$cwd")${TAB}$(name_of "$cwd")${TAB}${cwd}${TAB}${conv[$cwd]}${TAB}${mtime[$cwd]}")
done
mapfile -t list < <(printf '%s\n' "${list[@]}" | sed '/^$/d' | sort -t "$TAB" -k1,1 -k2,2)

if (( ${#list[@]} == 0 )) && (( ! reorg )); then echo "✔ All conversations from the last $days days already have a tab."; exit 0; fi
if (( ${#list[@]} )); then
  echo "Conversations from the last $days days without a tab (${#list[@]}):"
  prev_g=""
  for l in "${list[@]}"; do
    IFS="$TAB" read -r g n d id m <<<"$l"
    [[ "$g" != "$prev_g" ]] && { echo "  [$g]"; prev_g="$g"; }
    printf '    %-34s %s\n' "$n" "$(date -d "@$m" '+%d/%m %H:%M')"
  done
fi
(( dry )) && { (( reorg )) && echo "(--reorganize would move the tabs in «dev» to their group)"; exit 0; }
if (( ${#list[@]} > max )) && command -v fzf >/dev/null; then
  echo "There are ${#list[@]}: pick which to open (Tab marks, Ctrl+A all, Enter opens)."
  mapfile -t list < <(printf '%s\n' "${list[@]}" | sort -t "$TAB" -k5,5nr \
    | fzf --multi --delimiter="$TAB" --with-nth=1,2 --bind 'ctrl-a:select-all' \
          --header 'Tab marks · Ctrl+A all · Enter opens' --prompt 'open> ' \
          --preview 'echo {3}; echo; date -d @{5} "+last conversation: %d/%m/%Y %H:%M"')
  (( ${#list[@]} )) || { echo "Nothing changed."; exit 0; }
fi
read -rp "Open them $( (( start )) && echo "and start Claude in each one" || echo "(ready to resume with Enter)")? [y/N] " r
[[ "$r" =~ ^([yY]([eE][sS])?|[sS]([iIíÍ])?)$ ]] || { echo "Nothing changed."; exit 0; }

ensure_session() {   # creates the group's session if missing, with an initial tab that gets replaced
  tmux has-session -t "=$1" 2>/dev/null && return 0
  tmux new-session -d -s "$1" -n "·$1" -c "$HOME"
}
for l in "${list[@]}"; do
  IFS="$TAB" read -r g n d id _ <<<"$l"
  ensure_session "$g"
  (( win )) && import_conv "${file[$d]}" "$d"
  w="$(tmux new-window -d -P -F '#{window_id}' -t "=$g:" -n "$n" -c "$d")"
  # claude-resume: at the normal level, with exactly that conversation.
  if (( start )); then tmux send-keys -t "$w" "claude-resume --resume $id" Enter
  else tmux send-keys -t "$w" "claude-resume --resume $id"; fi   # ready: Enter to resume
  echo "  opened   [$g] $n"
done

if (( reorg )); then
  while IFS="$TAB" read -r wid d; do
    g="$(group_of "$d")"; ensure_session "$g"
    tmux move-window -d -s "$wid" -t "=$g:" 2>/dev/null && echo "  moved    [$g] $(tmux display -p -t "$wid" '#W')"
  done < <(tmux list-windows -t '=dev' -F "#{window_id}${TAB}#{pane_current_path}" 2>/dev/null | awk -F "$TAB" -v h="$HOME" '$2 != h')
fi

# Removes the initial «·group» tab from the new sessions if they already have others
for s in $(tmux list-sessions -F '#S'); do
  w="$(tmux list-windows -t "=$s" -F '#{window_id} #W' | awk -v n="·$s" '$2 == n { print $1 }')"
  [[ -n "$w" ]] && (( $(tmux list-windows -t "=$s" | wc -l) > 1 )) && tmux kill-window -t "$w"
done
echo "✔ Done. Groups: $(tmux list-sessions -F '#S(#{session_windows})' | tr '\n' ' ')"
echo "  Alt+↑/↓ switches group · Ctrl+b S lists groups and tabs · Alt+1…9 inside the group"
