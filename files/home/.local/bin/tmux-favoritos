#!/usr/bin/env bash
#
# tmux-favoritos — pestañas favoritas: marca la carpeta de una pestaña con ★ y vuelve a ella desde una lista,
# esté abierta o no. La marca es de la carpeta, no de la pestaña: sobrevive a cerrar la pestaña y a reiniciar tmux.
# Ctrl+b * pone o quita la pestaña actual · Ctrl+b F abre la lista.
#
# Uso: tmux-favoritos                       lista (Enter: ir o abrir · Ctrl+X: quitar de favoritas)
#      tmux-favoritos --alternar [ventana]  pone o quita la carpeta de esa pestaña (por defecto, la actual)
#      tmux-favoritos --quitar <carpeta>    quita una carpeta de favoritas
#      tmux-favoritos --lista               la lista en texto: carpeta<TAB>fila visible
#      tmux-favoritos --marcar              pone o quita la ★ en todas las pestañas abiertas (lo llaman los hooks)
#      tmux-favoritos --barra               agrega la ★ a los formatos de la barra (idempotente)
# Archivo: ~/.config/tmux-claude/favoritos, una carpeta por línea. Se puede editar a mano.
set -uo pipefail
FAV="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-claude/favoritos"
TAB=$'\t'
MARCA='#{?@fav, ★,}'

favoritas() { [[ -f "$FAV" ]] && grep -v '^[[:space:]]*$' "$FAV"; }
es_favorita() { favoritas | grep -qxF -- "$1"; }

#######################################
# Reescribe el archivo sin una carpeta (escritura atómica: nunca queda a medias).
#######################################
quitar() {
  local tmp; tmp="$(mktemp "$FAV.XXXXXX")" || return 1
  favoritas | grep -vxF -- "$1" > "$tmp"
  mv -f "$tmp" "$FAV"
}

#######################################
# Sincroniza la opción @fav de cada pestaña abierta con el archivo.
#######################################
marcar() {
  local w d
  while IFS="$TAB" read -r w d; do
    if es_favorita "$d"; then tmux set -w -t "$w" @fav 1; else tmux set -wu -t "$w" @fav 2>/dev/null; fi
  done < <(tmux list-windows -a -F "#{window_id}${TAB}#{pane_current_path}" 2>/dev/null)
  return 0
}

#######################################
# Filas de la lista: carpeta<TAB>★ nombre · abierta o no · ruta corta.
#######################################
lista() {
  local d abiertas donde
  abiertas="$(tmux list-windows -a -F "#{pane_current_path}${TAB}#{session_name}:#{window_index} #{window_name}" 2>/dev/null)"
  while IFS= read -r d; do
    donde="$(awk -F "$TAB" -v d="$d" '$1 == d { print $2; exit }' <<<"$abiertas")"
    if [[ -n "$donde" ]]; then donde=$'\e[32m● '"${donde:0:26}"$'\e[0m'
    elif [[ -d "$d" ]]; then donde=$'\e[2m○ sin pestaña\e[0m'
    else donde=$'\e[31m✗ ya no existe\e[0m'; fi
    printf '%s\t\e[33m★\e[0m %-24s %-40s \e[2m%s\e[0m\n' "$d" "$(basename "$d" | cut -c1-24)" "$donde" "${d/#"$HOME"/\~}"
  done < <(favoritas)
}

case "${1:-}" in
  --barra)
    for o in window-status-format window-status-current-format; do
      v="$(tmux show -gv "$o" 2>/dev/null)"
      [[ "$v" == *"@fav"* ]] || tmux set -ag "$o" "$MARCA"
    done; exit 0 ;;
  --marcar) marcar; exit 0 ;;
  --lista) lista; exit 0 ;;
  --quitar) quitar "${2:?carpeta}"; marcar; exit 0 ;;
  --alternar)
    d="$(tmux display -p ${2:+-t "$2"} '#{pane_current_path}')"
    [[ -n "$d" ]] || exit 1
    mkdir -p "$(dirname "$FAV")"
    if es_favorita "$d"; then quitar "$d"; msg="☆ Quitada de favoritas: $(basename "$d")"
    else printf '%s\n' "$d" >> "$FAV"; msg="★ Favorita: $(basename "$d") · Ctrl+b F abre la lista"; fi
    marcar; "$0" --barra
    tmux display "$msg"; exit 0 ;;
esac

if [[ -z "$(favoritas)" ]]; then
  echo "Aún no hay favoritas. En una pestaña, Ctrl+b * la marca (o Menú → Pestañas y sesión)."
  read -rsn1; exit 0
fi
command -v fzf >/dev/null || { lista | cut -f2; read -rsn1; exit 0; }
yo="$(printf '%q' "$0")"
sel="$(lista | fzf --ansi --reverse --delimiter="$TAB" --with-nth=2 --prompt='favoritas> ' \
  --header 'Enter: ir o abrir · Ctrl+X: quitar de favoritas' \
  --bind "ctrl-x:execute-silent($yo --quitar {1})+reload($yo --lista)" \
  --preview 'git -C {1} log --oneline -8 2>/dev/null; echo; ls -p {1} 2>/dev/null | head -40')" || exit 0
d="${sel%%"$TAB"*}"
[[ -d "$d" ]] || { echo "Esa carpeta ya no existe: $d (Ctrl+X la quita de la lista)"; read -rsn1; exit 1; }
exec "$(dirname "$0")/tmux-open" --dir "$d"
