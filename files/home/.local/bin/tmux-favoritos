#!/usr/bin/env bash
#
# tmux-favoritos — favorite tabs: mark a tab's folder with ★ and get back to it from a list, whether it is
# open or not. The mark belongs to the folder, not the tab: it survives closing the tab and restarting tmux.
# Ctrl+b * adds or removes the current tab · Ctrl+b F opens the list.
#
# Usage: tmux-favoritos                     list (Enter: go or open · Ctrl+X: remove from favorites)
#      tmux-favoritos --alternar [window]   adds or removes that tab's folder (default: the current one)
#      tmux-favoritos --quitar <folder>     removes a folder from favorites
#      tmux-favoritos --lista               the list as text: folder<TAB>visible row
#      tmux-favoritos --marcar              sets or clears the ★ on all open tabs (called by the hooks)
#      tmux-favoritos --barra               adds the ★ to the status bar formats (idempotent)
# File: ~/.config/tmux-claude/favoritos, one folder per line. It can be edited by hand.
set -uo pipefail
FAV="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-claude/favoritos"
TAB=$'\t'
MARCA='#{?@fav, ★,}'

favoritas() { [[ -f "$FAV" ]] && grep -v '^[[:space:]]*$' "$FAV"; }
es_favorita() { favoritas | grep -qxF -- "$1"; }

#######################################
# Rewrites the file without one folder (atomic write: never left half-written).
#######################################
quitar() {
  local tmp; tmp="$(mktemp "$FAV.XXXXXX")" || return 1
  favoritas | grep -vxF -- "$1" > "$tmp"
  mv -f "$tmp" "$FAV"
}

#######################################
# Syncs the @fav option of every open tab with the file.
#######################################
marcar() {
  local w d
  while IFS="$TAB" read -r w d; do
    if es_favorita "$d"; then tmux set -w -t "$w" @fav 1; else tmux set -wu -t "$w" @fav 2>/dev/null; fi
  done < <(tmux list-windows -a -F "#{window_id}${TAB}#{pane_current_path}" 2>/dev/null)
  return 0
}

#######################################
# List rows: folder<TAB>★ name · open or not · short path.
#######################################
lista() {
  local d abiertas donde
  abiertas="$(tmux list-windows -a -F "#{pane_current_path}${TAB}#{session_name}:#{window_index} #{window_name}" 2>/dev/null)"
  while IFS= read -r d; do
    donde="$(awk -F "$TAB" -v d="$d" '$1 == d { print $2; exit }' <<<"$abiertas")"
    if [[ -n "$donde" ]]; then donde=$'\e[32m● '"${donde:0:26}"$'\e[0m'
    elif [[ -d "$d" ]]; then donde=$'\e[2m○ no tab\e[0m'
    else donde=$'\e[31m✗ no longer exists\e[0m'; fi
    printf '%s\t\e[33m★\e[0m %-24s %-40s \e[2m%s\e[0m\n' "$d" "$(basename "$d" | cut -c1-24)" "$donde" "${d/#"$HOME"/\~}"
  done < <(favoritas)
}

case "${1:-}" in
  --barra)
    for o in window-status-format window-status-current-format; do
      v="$(tmux show -gv "$o" 2>/dev/null)"
      [[ "$v" == *"@fav"* ]] || tmux set -ag "$o" "$MARCA"
    done; exit 0 ;;
  --marcar) marcar; exit 0 ;;
  --lista) lista; exit 0 ;;
  --quitar) quitar "${2:?folder}"; marcar; exit 0 ;;
  --alternar)
    d="$(tmux display -p ${2:+-t "$2"} '#{pane_current_path}')"
    [[ -n "$d" ]] || exit 1
    mkdir -p "$(dirname "$FAV")"
    if es_favorita "$d"; then quitar "$d"; msg="☆ Removed from favorites: $(basename "$d")"
    else printf '%s\n' "$d" >> "$FAV"; msg="★ Favorite: $(basename "$d") · Ctrl+b F opens the list"; fi
    marcar; "$0" --barra
    tmux display "$msg"; exit 0 ;;
esac

if [[ -z "$(favoritas)" ]]; then
  echo "No favorites yet. In a tab, Ctrl+b * marks it (or Menu → Tabs and session)."
  read -rsn1; exit 0
fi
command -v fzf >/dev/null || { lista | cut -f2; read -rsn1; exit 0; }
yo="$(printf '%q' "$0")"
sel="$(lista | fzf --ansi --reverse --delimiter="$TAB" --with-nth=2 --prompt='favorites> ' \
  --header 'Enter: go or open · Ctrl+X: remove from favorites' \
  --bind "ctrl-x:execute-silent($yo --quitar {1})+reload($yo --lista)" \
  --preview 'git -C {1} log --oneline -8 2>/dev/null; echo; ls -p {1} 2>/dev/null | head -40')" || exit 0
d="${sel%%"$TAB"*}"
[[ -d "$d" ]] || { echo "That folder no longer exists: $d (Ctrl+X removes it from the list)"; read -rsn1; exit 1; }
exec "$(dirname "$0")/tmux-open" --dir "$d"
