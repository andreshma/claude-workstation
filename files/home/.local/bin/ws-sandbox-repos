#!/usr/bin/env bash
# ws-sandbox-repos — agrega a .git/info/exclude de cada repo las rutas donde el sandbox
# de Claude Code crea archivos vacíos de relleno (archivos y directorios protegidos).
# Es idempotente. Los archivos que el repo ya versiona no se ven afectados.
set -euo pipefail
pats=(.bash_profile .bashrc .profile .zprofile .zshrc .gitconfig .gitmodules .ripgreprc
      .mcp.json .vscode .idea .claude/commands .claude/agents .claude/settings.local.json .claude/.cc-writes)
n=0
for g in "${REPOS:-@WINHOME@/source/repos}"/*/.git "$HOME"/code/*/.git; do
  [[ -d "$g" ]] || continue
  ex="$g/info/exclude"; mkdir -p "$g/info"; touch "$ex"
  for p in "${pats[@]}"; do grep -qxF "/$p" "$ex" || echo "/$p" >> "$ex"; done
  n=$((n+1))
done
echo "info/exclude actualizado en $n repos"
