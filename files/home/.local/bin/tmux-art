#!/usr/bin/env python3
"""tmux-art — ASCII art scenes for the screensaver (tmux-saver delegates them to it).

Each scene is an original landscape drawn with characters (/ \\ _ | ~ ^ * . and, in the pipes, box-drawing lines) and true color, which adapts to
the terminal size and stays alive: twinkling stars, moving water, snow, smoke, auroras.

  peaks       a mountain range at night with a moon, pines and a lake that reflects it; now and then, a shooting star
  aurora      curtains of northern lights over a snowy forest
  snowfall    a cabin with its windows lit, smoke from the chimney and falling snow
  sailboat    a sailboat crosses the sea under the moon, among clouds and swell
  fish        a seabed with fish, jellyfish, swaying seaweed and bubbles
  pipes       colored pipes that grow and fill the screen
  battle      two fleets face each other in space, with beams and explosions
  campfire    a campfire burns next to the tent, with sparks and the forest around it
  cherry      a cherry tree in bloom at sunset; the petals fall with the wind
  rain        rain over the city at night, lightning and lights reflected on the street
  galaxy      a spinning spiral galaxy
  nebula      flowing clouds of colored gas
  hyperspace  the stars rush past at full speed

With the shading engine (needs numpy: sudo apt install python3-numpy):
  ocean       sunset over the sea, with the sun's glitter running over the waves
  planet      a ringed gas giant spins in front of the stars
  donut       a spinning colored donut, with light and shine
  lava        lava lamp: blobs that merge and split
  flight      low flight over mountains, valleys and lakes
  boreal      northern lights over mountains, reflected in a lake
  clouds      flight over a sea of clouds at sunset
  blackhole   a black hole with its disk of glowing gas
  pond        raindrops open rings on a pond under the moon
  fire        flames rising across the whole screen
  tunnel      an endless tunnel of light
  fractal     a Julia fractal that changes shape

Usage: tmux-art SCENE                 runs until a key is pressed
       tmux-art SCENE --test N        draws N frames without waiting for keys (tests)
       tmux-art SCENE --text [N]     prints frame N (20 by default) as plain text, without color
       tmux-art --list               names of the scenes this machine can draw (--all: all of them)

Color: true color (24 bits) if the terminal announces it in COLORTERM; otherwise 256 colors. WS_ART_COLOR=24|256 forces it.
"""
from __future__ import annotations

import math
import os
import random
import select
import shutil
import signal
import sys
import time

try:                                                         # the shading engine needs numpy (python3-numpy)
    import numpy as np
except ImportError:
    np = None

RGB = tuple[int, int, int]


# ── Color and noise ─────────────────────────────────────────────────────────────────────────────────────────────────
def blend(a: RGB, b: RGB, t: float) -> RGB:
    t = 0.0 if t < 0 else 1.0 if t > 1 else t
    return (int(a[0] + (b[0] - a[0]) * t), int(a[1] + (b[1] - a[1]) * t), int(a[2] + (b[2] - a[2]) * t))


def gradient(stops: list[tuple[float, RGB]], t: float) -> RGB:
    """Color at t (0..1) over a list of stops (position, color)."""
    for (p0, c0), (p1, c1) in zip(stops, stops[1:]):
        if t <= p1:
            return blend(c0, c1, (t - p0) / (p1 - p0) if p1 > p0 else 0)
    return stops[-1][1]


def _h(n: int, seed: int = 0) -> float:
    """Fixed number in 0..1 for an integer (the same every time: it works as a stable texture)."""
    n = (n * 374761393 + seed * 668265263) & 0xFFFFFFFF
    n = ((n ^ (n >> 13)) * 1274126177) & 0xFFFFFFFF
    return ((n ^ (n >> 16)) & 0xFFFF) / 0xFFFF


def noise(x: float, seed: int = 0) -> float:
    """Smooth noise in 0..1 along x."""
    i = math.floor(x)
    f = x - i
    f = f * f * (3 - 2 * f)
    return _h(i, seed) * (1 - f) + _h(i + 1, seed) * f


def to256(c: RGB) -> int:
    r, g, b = c
    if abs(r - g) < 10 and abs(g - b) < 10:
        return 16 if r < 8 else 231 if r > 248 else 232 + min(23, (r - 8) // 10)
    q = lambda v: 0 if v < 48 else 1 if v < 115 else (v - 35) // 40  # noqa: E731
    return 16 + 36 * q(r) + 6 * q(g) + q(b)


# ── Canvas ──────────────────────────────────────────────────────────────────────────────────────────────────────────
class Canvas:
    """Grid of cells: character, text color and background color."""

    def __init__(self, w: int, h: int, fill: RGB = (0, 0, 0)):
        self.w, self.h = w, h
        self.ch = [[" "] * w for _ in range(h)]
        self.fg: list[list[RGB]] = [[(200, 200, 200)] * w for _ in range(h)]
        self.bg: list[list[RGB]] = [[fill] * w for _ in range(h)]

    def copy(self) -> "Canvas":
        o = Canvas.__new__(Canvas)
        o.w, o.h = self.w, self.h
        o.ch = [f[:] for f in self.ch]
        o.fg = [f[:] for f in self.fg]
        o.bg = [f[:] for f in self.bg]
        return o

    def put(self, x: int, y: int, c: str | None, fg: RGB | None = None, bg: RGB | None = None) -> None:
        if 0 <= x < self.w and 0 <= y < self.h:
            if c is not None:
                self.ch[y][x] = c
            if fg is not None:
                self.fg[y][x] = fg
            if bg is not None:
                self.bg[y][x] = bg

    def art(self, x: int, y: int, rows: list[str], fg, bg: RGB | None = None) -> None:
        """Draws a sprite; the space is transparent. fg: a color or a function (character, column, row) → color."""
        for j, row in enumerate(rows):
            for i, c in enumerate(row):
                if c != " ":
                    self.put(x + i, y + j, c, fg(c, i, j) if callable(fg) else fg, bg)

    def sky(self, stops: list[tuple[float, RGB]], until: int | None = None) -> None:
        n = until if until is not None else self.h
        for y in range(n):
            c = gradient(stops, y / max(1, n - 1))
            self.bg[y] = [c] * self.w


# ── Shared pieces ───────────────────────────────────────────────────────────────────────────────────────────────────
def profile(w: int, rng: random.Random, lo: int, hi: int, start: int, turn: float, flat: float) -> list[int]:
    """Height per column of a ridge: it goes up, down or stays flat, one step at a time (so it is drawn with / \\ _)."""
    alt, d, out = start, rng.choice((-1, 1)), []
    for _ in range(w):
        if rng.random() < turn:
            d = rng.choice((-1, 0, 1)) if rng.random() < flat else -d if d else rng.choice((-1, 1))
        if alt + d > hi:                                     # a peak at the top; a flat valley at the bottom
            d = -1 if hi - lo > 3 else 0
        elif alt + d < lo:
            d = 0
        alt += d
        out.append(alt)
    return out


def ridge(L: Canvas, heights: list[int], base: int, fill: RGB, stroke: RGB, texture: RGB | None = None, seed: int = 0) -> None:
    """Paints a ridge: the silhouette is filled with color and the edge is traced with / \\ _ against the sky."""
    prev = heights[0]
    for x, a in enumerate(heights):
        for k in range(1, a + 1):
            y = base - k + 1
            L.put(x, y, " ", None, fill)
            if texture and _h(x * 131 + k * 17, seed) > 0.975:
                L.put(x, y, ".'`,"[int(_h(x + k * 7, seed + 1) * 4)], texture)
        if a > prev:
            L.put(x, base - a + 1, "/", stroke, L.bg[max(0, base - a)][x] if base - a >= 0 else None)
        elif a < prev:
            L.put(x, base - prev + 1, "\\", stroke)
        else:
            L.put(x, base - a, "_", stroke)
        prev = a


def pine(n: int) -> list[str]:
    """Pine with n tiers: a tip, branches that spread out and the trunk."""
    rows = [" " * n + "^"]
    for k in range(1, n):
        rows.append(" " * (n - k) + "/" * k + "|" + "\\" * k)
    rows.append(" " * n + "|")
    return rows


def make_stars(w: int, h: int, rng: random.Random, density: int = 28) -> list[tuple[int, int, str, float, float]]:
    out = []
    for _ in range(max(8, w * h // density)):
        c = rng.choices(".+*'", weights=(70, 9, 6, 15))[0]
        out.append((rng.randrange(w), rng.randrange(h), c, rng.uniform(0, 6.28), rng.uniform(0.6, 2.4)))
    return out


def paint_stars(L: Canvas, stars, t: float, limit: int, tint: RGB = (255, 255, 255)) -> None:
    for x, y, c, phase, vel in stars:
        if y < limit and L.ch[y][x] == " ":
            b = 0.45 + 0.55 * (0.5 + 0.5 * math.sin(t * vel + phase))
            b *= 1.0 if c in "*+" else 0.75
            L.put(x, y, c, blend(L.bg[y][x], tint, b))


def moon(L: Canvas, cx: int, cy: int, ry: int, color: RGB, seed: int = 3, waning: float = 0.0) -> None:
    """Moon disk with craters and a halo. waning > 0 cuts a slice off it (crescent moon)."""
    rx = ry * 2
    for dy in range(-ry - 2, ry + 3):
        for dx in range(-rx - 5, rx + 6):
            d = math.hypot(dx / rx, dy / (ry + 0.35))
            x, y = cx + dx, cy + dy
            if not (0 <= x < L.w and 0 <= y < L.h):
                continue
            shadow = waning and math.hypot((dx + rx * waning) / rx, (dy + ry * 0.15) / (ry + 0.35)) < 1.0
            if d <= 1.0 and not shadow:
                light = 1.0 - 0.28 * max(0.0, (dx / rx + dy / ry) * 0.6)
                c = blend((0, 0, 0), color, light)
                r = _h(dx * 53 + dy * 911, seed)
                if r > 0.90:
                    L.put(x, y, "o", blend(c, (0, 0, 0), 0.30), c)
                elif r > 0.76:
                    L.put(x, y, ".", blend(c, (0, 0, 0), 0.22), c)
                else:
                    L.put(x, y, " ", c, c)
            elif d <= 1.38 and not shadow:
                f = L.bg[y][x]
                L.put(x, y, None, None, blend(f, color, 0.16 * (1.38 - d) / 0.38))
                if L.ch[y][x] == " " and _h(dx * 7 + dy * 131, seed) > 0.72:
                    L.put(x, y, ".", blend(f, color, 0.42))


def footer(L: Canvas, color: RGB) -> None:
    for i, c in enumerate(f" press any key to return . {time.strftime('%H:%M')} "):
        L.put(i, L.h - 1, c, color)


class Scene:
    """A scene builds its fixed part once (base) and on each frame adds what moves."""

    def __init__(self, w: int, h: int, rng: random.Random):
        self.w, self.h, self.rng = w, h, rng
        self.base = Canvas(w, h)
        self.build()

    def build(self) -> None: ...
    def frame(self, t: float) -> Canvas: ...


# ── Peaks: mountain range, moon and lake ────────────────────────────────────────────────────────────────────────────
class Peaks(Scene):
    SKY = [(0.0, (6, 8, 26)), (0.55, (20, 22, 58)), (0.85, (52, 38, 86)), (1.0, (92, 58, 96))]

    def build(self) -> None:
        w, h, rng, L = self.w, self.h, self.rng, self.base
        self.lake = max(4, h // 6)
        self.shore = shore = h - self.lake - 1          # last row of land
        L.sky(self.SKY, shore + 1)
        self.stars = make_stars(w, shore - 2, rng)
        self.lx, self.ly, self.lr = int(w * 0.72), max(4, int(h * 0.22)), max(3, h // 10)
        moon(L, self.lx, self.ly, self.lr, (244, 232, 196))
        height = shore
        far = profile(w, rng, height // 4, int(height * 0.62), int(height * 0.4), 0.11, 0.2)
        mid = profile(w, rng, height // 7, int(height * 0.38), int(height * 0.25), 0.14, 0.5)
        self.near = near = profile(w, rng, 1, max(3, height // 7), 2, 0.10, 0.9)
        ridge(L, far, shore, (44, 44, 92), (150, 150, 205), (86, 88, 140), 1)
        for x in range(w):                                  # snow: the outline of the highest part is white
            if far[x] > height * 0.44:
                for y in (shore - far[x], shore - far[x] + 1):
                    if L.ch[y][x] in "/\\_":
                        L.put(x, y, None, (236, 240, 252))
        ridge(L, mid, shore, (26, 30, 64), (96, 106, 160), (52, 60, 104), 2)
        ridge(L, near, shore, (9, 16, 24), (52, 96, 78), (24, 46, 40), 3)
        x = rng.randrange(1, 4)
        while x < w - 6:                                    # pines on the near hill
            n = rng.choice((2, 3, 3, 4, 4, 5, 6)) if h >= 28 else rng.choice((2, 3, 3, 4))
            green = blend((30, 92, 62), (70, 150, 96), rng.random())
            f = pine(n)
            L.art(x, shore - min(near[x + n], near[min(w - 1, x + n + 1)]) - len(f) + 1, f,
                   lambda c, i, j, v=green, m=len(f): (120, 86, 56) if c == "|" and j == m - 1 else blend(v, (8, 20, 16), j / (m * 1.6)), (6, 14, 18))
            x += n * 2 + rng.choice((2, 3, 5, 9, 14, 20))
        for y in range(shore + 1, h):                      # the lake
            L.bg[y] = [blend((16, 26, 60), (5, 9, 24), (y - shore - 1) / max(1, self.lake - 1))] * w
        self.meteor = (-1.0, 0, 0)

    def frame(self, t: float) -> Canvas:
        L, w, h, shore = self.base.copy(), self.w, self.h, self.shore
        paint_stars(L, self.stars, t, shore - 2, (236, 240, 255))
        t0, fx, fy = self.meteor
        if t - t0 > 14 + 9 * _h(int(t0 * 10)):
            self.meteor = t0, fx, fy = (t, self.rng.randrange(w // 8, w // 2), self.rng.randrange(1, max(2, h // 6)))
        if t0 >= 0 and t - t0 < 1.4:
            head = int((t - t0) * 26)
            for i in range(9):
                x, y = fx + head - i * 2, fy + (head - i * 2) // 4
                if 0 <= x < w and 0 <= y < shore - 3 and L.ch[y][x] in " .'+*" and L.bg[y][x][2] < 110:
                    L.put(x, y, "*" if i == 0 else "-" if i < 5 else ".", blend(L.bg[y][x], (255, 250, 225), 1 - i / 9))
        for y in range(shore + 1, h - 1):                  # water: faint ripples and the moon's path of light
            p = y - shore
            width = 2 + p * 2
            for x in range(w):
                d = abs(x - self.lx)
                v = noise(x * 0.33 + t * (0.55 + 0.1 * p) + p * 7.1, p) + 0.25 * math.sin(x * 0.5 - t * 1.3 + p)
                if d <= width and v > 0.42:
                    L.put(x, y, "~=-_"[int(_h(x + int(t * 3) * 31 + p * 5) * 4)], blend(L.bg[y][x], (248, 236, 198), (1 - d / (width + 1)) * 0.95))
                elif v > 0.80:
                    L.put(x, y, "~" if v > 0.9 else "-", blend(L.bg[y][x], (120, 150, 215), 0.42))
        for x in range(w):
            if _h(x, 9) > 0.35:
                L.put(x, shore + 1, "~-_."[int(_h(x + int(t * 1.5), 4) * 4)], (70, 96, 150))
        footer(L, (86, 92, 130))
        return L


# ── Aurora ──────────────────────────────────────────────────────────────────────────────────────────────────────────
class Aurora(Scene):
    SKY = [(0.0, (3, 6, 18)), (0.7, (6, 16, 32)), (1.0, (10, 28, 42))]
    TONES = [(0.0, (90, 255, 150)), (0.45, (56, 214, 190)), (0.8, (120, 110, 230)), (1.0, (176, 84, 208))]

    def build(self) -> None:
        w, h, rng, L = self.w, self.h, self.rng, self.base
        self.ground = ground = h - max(3, h // 9)
        L.sky(self.SKY, ground + 1)
        self.stars = make_stars(w, ground, rng, 34)
        self.front = Canvas(w, h)                           # forest and snow: painted ON TOP of the aurora
        F = self.front
        self.mask = [[False] * w for _ in range(h)]
        hill = profile(w, rng, 1, max(2, h // 8), 2, 0.08, 0.9)
        snow, shadow = (206, 220, 240), (120, 140, 176)
        prev = hill[0]
        for x, a in enumerate(hill):
            for y in range(ground - a + 1, h):
                F.put(x, y, " ", None, blend((58, 74, 110), (22, 30, 52), (y - (ground - a)) / max(1, h - ground + a)))
                self.mask[y][x] = True
                if _h(x * 97 + y * 13, 5) > 0.92:
                    F.put(x, y, ".,'"[int(_h(x + y, 6) * 3)], shadow)
            y = ground - a + 1 if a > prev else ground - prev + 1 if a < prev else ground - a
            F.put(x, y, "/" if a > prev else "\\" if a < prev else "_", snow)
            self.mask[y][x] = True
            prev = a
        x = rng.randrange(0, 5)
        while x < w - 4:
            n = rng.choice((3, 4, 5, 6, 7, 8)) if h >= 28 else rng.choice((2, 3, 4, 5))
            f = pine(n)
            y0 = ground - min(hill[min(w - 1, x + n)], hill[min(w - 1, x + n + 1)]) - len(f) + 1
            for j, row in enumerate(f):
                for i, c in enumerate(row):
                    xx, yy = x + i, y0 + j
                    if c != " " and 0 <= xx < w and 0 <= yy < h:
                        edge = c in "^" or i in (len(row) - len(row.lstrip()), len(row) - 1)
                        F.put(xx, yy, c, (190, 208, 230) if edge and _h(xx * 3 + yy, 8) > 0.45 else (28, 70, 60), (5, 14, 16))
                        self.mask[yy][xx] = True
            x += 2 * n + rng.choice((2, 3, 6, 10, 16))

    def frame(self, t: float) -> Canvas:
        L, w, ground = self.base.copy(), self.w, self.ground
        paint_stars(L, self.stars, t, ground, (220, 235, 255))
        for b, (alt, amp, length, vel) in enumerate(((0.50, 0.10, 0.34, 0.21), (0.36, 0.07, 0.24, -0.16), (0.62, 0.05, 0.20, 0.12))):
            for x in range(w):
                y0 = ground * (alt + amp * math.sin(x * 0.045 + t * vel + b * 2.1) + 0.04 * math.sin(x * 0.13 - t * vel * 1.7 + b))
                strength = (noise(x * 0.06 - t * vel * 0.9 + b * 31, 20 + b) ** 1.5) * (0.55 + 0.45 * noise(x * 0.9 + t * 0.5, 40 + b))
                if strength < 0.10:
                    continue
                n = max(2, int(ground * length * (0.45 + 0.55 * noise(x * 0.11 + t * 0.25, 60 + b))))
                for k in range(n):
                    y = int(y0) - k
                    if not 0 <= y < ground:
                        continue
                    f = k / n
                    light = strength * (1 - f) ** 0.8
                    if light < 0.07:
                        continue
                    col = gradient(self.TONES, f)
                    c = "|" if light > 0.50 else "!" if light > 0.36 else ":" if light > 0.24 else "'" if light > 0.14 else "."
                    backdrop = blend(L.bg[y][x], col, min(0.34, light * 0.42))
                    L.put(x, y, c, blend(backdrop, col, min(1.0, 0.35 + light * 1.1)), backdrop)
        F = self.front
        for y in range(self.h):
            fm = self.mask[y]
            for x in range(w):
                if fm[x]:
                    L.ch[y][x], L.fg[y][x], L.bg[y][x] = F.ch[y][x], F.fg[y][x], F.bg[y][x]
        footer(L, (120, 136, 168))
        return L


# ── Snowfall: the cabin ─────────────────────────────────────────────────────────────────────────────────────────────
class Snowfall(Scene):
    SKY = [(0.0, (14, 18, 40)), (0.6, (30, 36, 70)), (1.0, (60, 62, 100))]
    CABIN = [
        "                    __",
        "                   |  |",
        "       ____________|__|_______",
        "      /                       \\",
        "     /_________________________\\",
        "     |   ____         ____     |",
        "     |  |_|__|   __  |__|_|    |",
        "     |  |_|__|  |  | |__|_|    |",
        "     |__________|_.|___________|",
    ]

    def build(self) -> None:
        w, h, rng, L = self.w, self.h, self.rng, self.base
        self.ground = ground = h - max(4, h // 6)
        cw = len(self.CABIN[4])
        self.cx = cx = max(1, int(w * 0.30) - cw // 2)
        L.sky(self.SKY, ground + 1)
        far = profile(w, rng, 2, max(4, h // 4), max(3, h // 7), 0.10, 0.4)
        ridge(L, far, ground, (38, 44, 82), (132, 146, 196), (70, 80, 124), 11)
        for x in range(2, w - 2, 1):                        # distant forest, small
            if _h(x, 12) > 0.80 and not cx - 2 <= x <= cx + cw + 2:
                y = ground - far[x]
                L.put(x, y, "^", (70, 96, 110))
        self.hill = hill = profile(w, rng, 0, 1, 0, 0.06, 0.9)
        for x in range(max(0, cx - 3), min(w, cx + cw + 4)):
            hill[x] = 0
        snow = (226, 234, 248)
        prev = hill[0]
        for x, a in enumerate(hill):
            for y in range(ground - a + 1, h):
                L.put(x, y, " ", None, blend((112, 128, 170), (52, 62, 100), (y - (ground - a)) / max(1, h - ground + a)))
                if _h(x * 71 + y * 29, 14) > 0.93:
                    L.put(x, y, ".,'-"[int(_h(x + y * 3, 15) * 4)], (176, 190, 222))
            L.put(x, ground - a + 1 if a > prev else ground - prev + 1 if a < prev else ground - a, "/" if a > prev else "\\" if a < prev else "_", snow)
            prev = a
        self.cy = cy = ground - len(self.CABIN) + 1
        for j in range(3, 9):                                # solid body
            indent = len(self.CABIN[j]) - len(self.CABIN[j].lstrip())
            for i in range(indent, len(self.CABIN[j])):
                L.put(cx + i, cy + j, " ", None, (34, 24, 20) if j >= 5 else (58, 66, 96))
        L.put(cx + 20, cy + 1, " ", None, (44, 30, 26)); L.put(cx + 21, cy + 1, " ", None, (44, 30, 26))
        L.art(cx, cy, self.CABIN, lambda c, i, j: snow if j in (0, 2, 3, 4) else (168, 122, 86))
        self.windows = [(cx + i, cy + j) for j in (6, 7) for i in (*range(8, 14), *range(21, 27))]
        for i in range(5, 32):                               # snow piled up at the foot
            if _h(i, 16) > 0.4:
                L.put(cx + i, ground + 1, "._,"[int(_h(i, 17) * 3)], snow)
        taken = range(cx - 3, cx + cw + 4)
        x = rng.randrange(0, 4)
        while x < w - 6:                                    # snowy pines all around
            n = rng.choice((4, 5, 6, 7, 8)) if h >= 28 else rng.choice((3, 4, 5))
            if x + 2 * n >= taken.start and x < taken.stop:
                x += 3
                continue
            f = pine(n)
            y0 = ground - min(hill[min(w - 1, x + n)], hill[min(w - 1, x + n + 1)]) - len(f) + 1
            for j, row in enumerate(f):
                indent = len(row) - len(row.lstrip())
                for i, c in enumerate(row):
                    if c != " ":
                        edge = c == "^" or i in (indent, len(row) - 1) or _h((x + i) * 5 + j, 18) > 0.84
                        L.put(x + i, y0 + j, c, (130, 96, 70) if j == len(f) - 1 else snow if edge else (36, 96, 74),
                              None if j == len(f) - 1 else (10, 28, 26))
            x += 2 * n + rng.choice((3, 4, 7, 12))
        self.flakes = [[rng.uniform(0, w), rng.uniform(0, h), rng.uniform(0.25, 1.0), rng.uniform(0, 6.28)] for _ in range(max(30, w * h // 26))]
        self.smoke = [[0.0, rng.uniform(0, 1)] for _ in range(14)]

    def frame(self, t: float) -> Canvas:
        L, w, h = self.base.copy(), self.w, self.h
        light = 0.82 + 0.18 * noise(t * 3.1, 70)
        for x, y in self.windows:                           # lit windows, flickering with the fire
            L.put(x, y, None, (96, 60, 30), blend((70, 40, 16), (255, 190, 86), light))
        for i in range(0, 34):                               # glow on the snow
            L.put(self.cx + 3 + i, self.ground + 1, None, None, blend(L.bg[self.ground + 1][min(w - 1, self.cx + 3 + i)], (255, 190, 86), 0.16 * light))
        hx, hy = self.cx + 20, self.cy - 1
        for k, (_, phase) in enumerate(self.smoke):            # chimney smoke
            v = (t * 0.22 + phase) % 1.0
            x = hx + int(v * 9 + 2.2 * math.sin(v * 7 + k))
            y = hy - int(v * min(11, hy))
            if 0 <= y < h and 0 <= x < w and L.ch[y][x] in " .'*+":
                L.put(x, y, "(" if k % 3 == 0 else ")" if k % 3 == 1 else "~", blend(L.bg[y][x], (200, 204, 220), 0.75 * (1 - v)))
        for c in self.flakes:                                 # falling snow: the slow flakes go in the background
            x = int(c[0] + 2.2 * math.sin(t * 0.7 + c[3]) + t * 1.3 * c[2]) % w
            y = int(c[1] + t * (1.2 + 3.4 * c[2])) % h
            if L.ch[y][x] == " ":
                L.put(x, y, "*" if c[2] > 0.82 else "+" if c[2] > 0.7 else "." if c[2] > 0.35 else "'", blend(L.bg[y][x], (255, 255, 255), 0.35 + 0.65 * c[2]))
        footer(L, (150, 162, 198))
        return L


# ── Sailboat ────────────────────────────────────────────────────────────────────────────────────────────────────────
class Sailboat(Scene):
    SKY = [(0.0, (5, 8, 24)), (0.6, (16, 26, 58)), (1.0, (44, 52, 96))]
    BOAT = [
        "                |>",
        "                |\\",
        "               /| \\",
        "              / |  \\",
        "             /  |   \\",
        "            /   |    \\",
        "           /    |     \\",
        "          /     |      \\",
        "         /______|_______\\",
        "                |",
        "    \\___________|______________/",
        "     \\  o   o   o   o   o     /",
        "      \\______________________/",
    ]
    CLOUDS = [
        ["     .--.", "  .-(    ).", " (___.__)__)"],
        ["   _  _", "  ( `   )_", " (    )    `)", "  `--'`---'"],
        ["  .-~~-.", " (      )-.", "(___.____)_)"],
    ]

    def build(self) -> None:
        w, h, rng, L = self.w, self.h, self.rng, self.base
        self.hz = hz = int(h * 0.56)                         # horizon row
        L.sky(self.SKY, hz)
        self.stars = make_stars(w, hz - 1, rng, 30)
        self.lx, self.lr = int(w * 0.76), max(3, h // 10)
        moon(L, self.lx, max(self.lr + 1, hz - self.lr - max(2, h // 8)), self.lr, (250, 236, 190), 5, 0.42)
        for y in range(hz, h):
            L.bg[y] = [blend((22, 44, 84), (4, 12, 30), (y - hz) / max(1, h - hz - 1))] * w
        self.clouds = [(rng.randrange(w), rng.randrange(1, max(2, hz - 8)), rng.choice(self.CLOUDS), rng.uniform(0.25, 0.7)) for _ in range(max(2, w // 34))]

    def frame(self, t: float) -> Canvas:
        L, w, h, hz = self.base.copy(), self.w, self.h, self.hz
        paint_stars(L, self.stars, t, hz - 1, (236, 240, 255))
        for x0, y0, shape, vel in self.clouds:
            width = max(len(f) for f in shape)
            x = int((x0 + t * vel) % (w + width)) - width
            for j, row in enumerate(shape):
                for i, c in enumerate(row):
                    xx, yy = x + i, y0 + j
                    if c != " " and 0 <= xx < w and 0 <= yy < hz - 1 and L.bg[yy][xx][0] < 120:
                        L.put(xx, yy, c, blend(L.bg[yy][xx], (170, 182, 220), 0.55))
        for y in range(hz, h - 1):                           # swell: longer and livelier the closer it is
            p = (y - hz) / max(1, h - hz - 1)
            length = 0.42 - 0.30 * p
            for x in range(w):
                v = math.sin(x * length + t * (0.9 + 1.2 * p) + y * 1.7) + 0.6 * math.sin(x * length * 0.37 - t * 0.5 + y * 0.9) + 0.5 * (noise(x * 0.4 + y * 9 - t * 0.8, y) - 0.5)
                d = abs(x - self.lx)
                width = 2 + (y - hz) * 2
                shine = (1 - d / (width + 1)) if d <= width else 0.0
                if v > 1.05:
                    c = "^" if p > 0.5 else "'"
                elif v > 0.55:
                    c = "~"
                elif v > 0.15 and (shine or _h(x * 7 + y * 131 + int(t * 2), 3) > 0.45):
                    c = "-"
                elif v < -1.0:
                    c = "_"
                else:
                    c = "~" if shine and _h(x + y * 17 + int(t * 4), 2) > 0.5 else None
                if c:
                    base = blend(L.bg[y][x], (110, 170, 215), 0.25 + 0.5 * p + (0.2 if c in "^'" else 0))
                    L.put(x, y, c, blend(base, (252, 240, 200), shine * 0.9))
        bw = len(self.BOAT[10])
        bx = int((w * 0.3 + bw + t * 1.1) % (w + bw + 10)) - bw
        by = hz + max(1, (h - hz) // 3) - len(self.BOAT) + 2 + round(0.9 * math.sin(t * 0.9))
        sail, hull = (236, 230, 208), (184, 132, 88)
        for j, row in enumerate(self.BOAT):                # solid sails and hull, then the outline
            if 2 <= j <= 8:
                for i in range(row.index("/") + 1, row.rindex("\\")):
                    L.put(bx + i, by + j, " ", None, (60, 62, 78) if i < 16 else (72, 72, 86))
            if j >= 10:
                for i in range(row.index("\\") + 1, row.rindex("/")):
                    L.put(bx + i, by + j, " ", None, (40, 26, 20))
        L.art(bx, by, self.BOAT, lambda c, i, j: (236, 96, 80) if c == ">" else (255, 206, 110) if c == "o" else hull if j >= 9 or c == "|" else sail)
        for i in range(8, 30):                               # wake at the foot of the hull
            if _h(i + int(t * 5), 6) > 0.4:
                L.put(bx + i, by + len(self.BOAT), "~-'"[int(_h(i + int(t * 3), 7) * 3)], (200, 220, 240))
        footer(L, (110, 126, 168))
        return L


def mirror(rows: list[str]) -> list[str]:
    """The same drawing facing the other way."""
    w = max(len(f) for f in rows)
    tr = str.maketrans("()<>/\\[]{}`'", ")(><\\/][}{'`")
    return [f.ljust(w)[::-1].translate(tr) for f in rows]


# ── Pipes ───────────────────────────────────────────────────────────────────────────────────────────────────────────
class Pipes(Scene):
    BACKGROUND = (6, 8, 14)
    COLORS = [(86, 196, 255), (255, 120, 104), (140, 232, 150), (255, 204, 96), (206, 140, 255), (255, 150, 210), (110, 232, 220)]
    ELBOW = {(0, 1): "┏", (0, 3): "┓", (2, 1): "┗", (2, 3): "┛", (1, 0): "┛", (1, 2): "┓", (3, 0): "┗", (3, 2): "┏"}
    STEP = ((0, -1), (1, 0), (0, 1), (-1, 0))

    def build(self) -> None:
        self.reset(0.0)

    def reset(self, t: float) -> None:
        self.L = Canvas(self.w, self.h, self.BACKGROUND)
        self.filled, self.t0 = 0, t
        self.heads = [self.spawn() for _ in range(max(4, self.w // 18))]

    def spawn(self) -> list:
        r = self.rng
        d = r.randrange(4)
        x = r.randrange(self.w) if d in (0, 2) else (0 if d == 1 else self.w - 1)
        y = r.randrange(self.h - 1) if d in (1, 3) else (0 if d == 2 else self.h - 2)
        return [x, y, d, r.choice(self.COLORS)]

    def frame(self, t: float) -> Canvas:
        L, r = self.L, self.rng
        if self.filled > self.w * self.h * 0.5 or t - self.t0 > 80:
            self.reset(t)
            L = self.L
        for c in self.heads:
            for _ in range(2 if c[2] in (1, 3) else 1):      # moves double horizontally: cells are tall
                x, y, d, col = c
                nd = d
                if r.random() < 0.2:
                    nd = (d + r.choice((1, 3))) % 4
                if L.ch[y][x] == " ":
                    self.filled += 1
                shine = blend(col, (255, 255, 255), 0.25) if nd != d else col
                L.put(x, y, self.ELBOW[(d, nd)] if nd != d else "┃" if d in (0, 2) else "━", shine)
                x, y = x + self.STEP[nd][0], y + self.STEP[nd][1]
                if not (0 <= x < self.w and 0 <= y < self.h - 1):
                    c[:] = self.spawn()
                    break
                c[0], c[1], c[2] = x, y, nd
        S = L.copy()
        for x, y, _, col in self.heads:                    # the tip of each pipe glows
            S.put(x, y, "●", blend(col, (255, 255, 255), 0.6))
        footer(S, (90, 96, 120))
        return S


# ── Fish ────────────────────────────────────────────────────────────────────────────────────────────────────────────
class Fish(Scene):
    SHAPES = [
        ["><>"],
        ["><(((o>"],
        ["  __", "\\/ o\\", "/\\__/"],
        ["      _.-----._", " |\\ .'         `.", " | X     ))    o >", " |/ `._       _.'", "       `-----'"],
        ["   ,-.", "><{  o>", "   `-'"],
    ]
    JELLYFISH = [[" .-~~-.", "(      )", " `~||~'", "  ) ((", " (   )"], [" .-~~-.", "(      )", " `~||~'", "  ( ))", "  )  ("]]
    TONES = [(255, 170, 70), (255, 110, 110), (255, 222, 96), (120, 226, 255), (190, 150, 255), (140, 240, 170), (255, 150, 200)]

    def build(self) -> None:
        w, h, r, L = self.w, self.h, self.rng, self.base
        self.floor = h - 3
        for y in range(h):
            L.bg[y] = [gradient([(0.0, (24, 96, 150)), (0.5, (10, 48, 96)), (1.0, (3, 16, 40))], y / (h - 1))] * w
        for y in range(self.floor, h):                       # sand
            for x in range(w):
                L.put(x, y, ".,:'  "[int(_h(x * 13 + y * 7, 30) * 6)], (150, 132, 92), blend((74, 64, 44), (40, 34, 26), (y - self.floor) / 3))
        for _ in range(max(2, w // 40)):                     # rocks
            x = r.randrange(2, w - 12)
            L.art(x, self.floor - 2, ["  _.--._", " /  .   \\", "/_.___.__\\"], (120, 124, 136), (38, 44, 58))
        self.seaweed = [(r.randrange(1, w - 1), r.randrange(3, max(5, h // 3)), r.uniform(0, 6.28), blend((40, 150, 90), (120, 220, 110), r.random())) for _ in range(max(6, w // 7))]
        self.fish = []
        for _ in range(max(7, w * h // 330)):
            k = r.choices(range(5), weights=(5, 4, 4, 1, 3))[0]
            v = r.uniform(2.0, 7.5) * (0.6 if k == 3 else 1) * r.choice((-1, 1))
            self.fish.append((r.uniform(0, w), r.randrange(1, max(2, self.floor - 6)), v, self.SHAPES[k] if v > 0 else mirror(self.SHAPES[k]), r.choice(self.TONES), r.uniform(0, 6.28)))
        self.jellies = [(r.randrange(4, w - 10), r.uniform(0, 1), r.uniform(0.02, 0.05)) for _ in range(max(1, w // 60))]
        self.bubbles = [(r.randrange(2, w - 2), r.uniform(0, 1), r.uniform(0.08, 0.2), r.uniform(0, 6.28)) for _ in range(max(10, w // 5))]

    def frame(self, t: float) -> Canvas:
        L, w, h, floor = self.base.copy(), self.w, self.h, self.floor
        for y in range(floor):                               # rays of light coming down from the surface
            row, f = L.bg[y], 0.20 * (1 - y / floor)
            for x in range(w):
                v = noise((x + y * 1.6) * 0.07 + t * 0.12, 31)
                if v > 0.55:
                    row[x] = blend(row[x], (150, 220, 240), (v - 0.55) * 2.2 * f)
        for x in range(w):                                   # the surface
            L.put(x, 0, "~" if math.sin(x * 0.4 + t * 1.5) > 0 else "-", (190, 232, 250))
        for x0, height, phase, col in self.seaweed:               # swaying seaweed
            for k in range(height):
                dx = math.sin(t * 1.1 + k * 0.55 + phase) * 1.6 * k / height
                L.put(x0 + round(dx), floor - 1 - k, "(" if math.cos(t * 1.1 + k * 0.55 + phase) < 0 else ")", blend(col, (10, 50, 40), 0.5 * (1 - k / height)))
        for x0, phase, vel in self.jellies:
            v = (t * vel + phase) % 1.0
            y = int(floor - 6 - v * (floor - 4))
            L.art(x0 + round(2 * math.sin(t * 0.4 + phase * 9)), y, self.JELLYFISH[int(t * 1.6 + phase * 5) % 2], (236, 170, 250))
        for x0, y0, vel, shape, col, phase in self.fish:
            width = len(shape[0]) if len(shape) == 1 else max(len(f) for f in shape)
            x = int((x0 + t * vel) % (w + width + 6)) - width - 3
            y = y0 + round(0.8 * math.sin(t * 0.6 + phase))
            L.art(x, y, shape, lambda c, i, j, col=col: (255, 255, 255) if c == "o" else blend(col, (255, 255, 255), 0.35) if c in "()" else col)
        for x0, phase, vel, shift in self.bubbles:
            v = (t * vel + phase) % 1.0
            x, y = x0 + round(1.5 * math.sin(v * 12 + shift)), int(floor - 1 - v * (floor - 1))
            if 0 < y < floor and 0 <= x < w and L.ch[y][x] == " ":
                L.put(x, y, "." if v < 0.3 else "o" if v < 0.7 else "O", blend(L.bg[y][x], (220, 244, 255), 0.75))
        footer(L, (120, 150, 170))
        return L


# ── Battle in space ─────────────────────────────────────────────────────────────────────────────────────────────────
class Battle(Scene):
    FIGHTER = ["|\\__", "}===>-", "|/"]
    CRUISER = ["     ___/\\___", " ___/________\\__", "[=__o___o___o___>>=-", "    \\________/"]
    BOOM = [["*"], ["\\|/", "-*-", "/|\\"], [" . * . ", "* \\|/ *", "- -@- -", "* /|\\ *", " ' * ' "], ["  .   .  ", ".   '   .", "  ' . '  ", ".   .   .", "  '   '  "]]

    def build(self) -> None:
        w, h, r, L = self.w, self.h, self.rng, self.base
        for y in range(h):
            L.bg[y] = [blend((3, 4, 14), (12, 6, 26), y / (h - 1))] * w
        moon(L, int(w * 0.5), h + max(3, h // 5), max(6, h // 3), (70, 120, 190), 9)   # a planet peeks in from below
        self.stars = [(r.uniform(0, w), r.randrange(h - 1), r.choice((0.6, 0.6, 1.6, 1.6, 4.0))) for _ in range(w * h // 22)]
        self.ships = []
        for side in (0, 1):
            n = max(3, h // 7)
            for k in range(n):
                big = k == n // 2
                shape = self.CRUISER if big else self.FIGHTER
                shape = shape if side == 0 else mirror(shape)
                width = max(len(f) for f in shape)
                x = r.randrange(2, max(3, w // 4 - width // 2)) + (0 if not big else 1)
                self.ships.append({"side": side, "x": x if side == 0 else w - x - width, "y0": 2 + k * (h - 6) // n, "phase": r.uniform(0, 6.28),
                                   "shape": shape, "width": width, "life": 6 if big else 2, "max": 6 if big else 2, "respawn": 0.0, "next": r.uniform(0.2, 2.5), "hit": -9.0})
        self.beams, self.booms = [], []

    def frame(self, t: float) -> Canvas:
        L, w, h, r = self.base.copy(), self.w, self.h, self.rng
        for x0, y, vel in self.stars:                          # stars on three planes
            x = int((x0 - t * vel) % w)
            if L.ch[y][x] == " " and L.bg[y][x][2] < 60:
                L.put(x, y, "." if vel < 1 else "+" if vel < 2 else "-", blend(L.bg[y][x], (230, 236, 255), 0.35 + vel * 0.15))
        alive = []
        for n in self.ships:
            if n["life"] <= 0:
                if t >= n["respawn"]:
                    n["life"], n["next"] = n["max"], t + 1.0
                else:
                    continue
            n["y"] = n["y0"] + round(1.6 * math.sin(t * 0.5 + n["phase"]))
            n["xx"] = n["x"] + round(2 * math.sin(t * 0.23 + n["phase"] * 2))
            alive.append(n)
            if t >= n["next"]:
                n["next"] = t + r.uniform(0.5, 2.4)
                row = n["y"] + (2 if len(n["shape"]) > 3 else 1)
                self.beams.append([float(n["xx"] + n["width"] if n["side"] == 0 else n["xx"] - 3), row, 1 if n["side"] == 0 else -1, n["side"]])
        kept = []
        for ry in self.beams:
            ry[0] += 3.2 * ry[2]
            x = int(ry[0])
            hit = False
            for n in alive:
                if n["side"] != ry[3] and n["y"] <= ry[1] < n["y"] + len(n["shape"]) and n["xx"] <= x + 1 and x - 1 <= n["xx"] + n["width"]:
                    n["life"] -= 1
                    n["hit"] = t
                    hit = True
                    if n["life"] <= 0:
                        n["respawn"] = t + r.uniform(3.5, 7)
                        self.booms.append((n["xx"] + n["width"] // 2, n["y"] + len(n["shape"]) // 2, t, True))
                    else:
                        self.booms.append((x, ry[1], t, False))
                    break
            if not hit and -4 < x < w + 4:
                kept.append(ry)
                L.art(x, ry[1], ["==-" if ry[2] > 0 else "-=="], (130, 255, 170) if ry[3] == 0 else (255, 110, 100))
        self.beams = kept
        for n in alive:
            if n["life"] <= 0:
                continue
            base = (150, 200, 255) if n["side"] == 0 else (255, 176, 130)
            col = (255, 255, 255) if t - n["hit"] < 0.2 else base
            engine = blend((255, 140, 60), (255, 240, 160), noise(t * 9 + n["phase"], 50))
            L.art(n["xx"], n["y"], n["shape"], lambda c, i, j, col=col, engine=engine: engine if c in "}{[]" else (255, 226, 120) if c == "o" else col, (10, 12, 26))
        live = []
        for x, y, t0, big in self.booms:
            age = (t - t0) / (1.0 if big else 0.45)
            if age >= 1:
                continue
            live.append((x, y, t0, big))
            f = self.BOOM[min(3 if big else 1, int(age * (4 if big else 2)))]
            L.art(x - len(f[0]) // 2, y - len(f) // 2, f, gradient([(0, (255, 255, 230)), (0.4, (255, 200, 80)), (1, (200, 60, 40))], age))
        self.booms = live
        footer(L, (90, 96, 130))
        return L


RAMP = " .,:;*+o#@"


# ── Hyperspace ──────────────────────────────────────────────────────────────────────────────────────────────────────
class Hyperspace(Scene):
    def build(self) -> None:
        w, h, r, L = self.w, self.h, self.rng, self.base
        self.cx, self.cy = w / 2, (h - 1) / 2
        for y in range(h):
            for x in range(w):
                d = math.hypot((x - self.cx) / w * 2, (y - self.cy) / h * 2)
                L.bg[y][x] = blend((16, 22, 56), (2, 3, 10), min(1.0, d * 1.3))
        self.stars = [(r.uniform(0, 6.2832), r.uniform(0, 1), r.uniform(0.16, 0.5), r.choice(((255, 255, 255), (190, 214, 255), (255, 226, 190), (170, 255, 240)))) for _ in range(max(90, w * h // 26))]
        self.radius = math.hypot(w / 2, h) * 1.05

    def frame(self, t: float) -> Canvas:
        L, w, h = self.base.copy(), self.w, self.h
        for ang, phase, vel, col in self.stars:
            f = (t * vel + phase) % 1.0
            ca, sa = math.cos(ang), math.sin(ang)
            c = "-" if abs(ca) > 0.92 else "|" if abs(sa) > 0.92 else "\\" if ca * sa > 0 else "/"
            length = 1 + int(f * f * 9)
            for j in range(length):                           # the trail lengthens as it approaches
                rr = self.radius * max(0.0, f - j * 0.012) ** 2.4
                x, y = int(self.cx + ca * rr), int(self.cy + sa * rr * 0.5)
                if 0 <= x < w and 0 <= y < h - 1:
                    L.put(x, y, "." if f < 0.22 else "*" if j == 0 and f > 0.6 else c, blend(L.bg[y][x], col, min(1.0, (0.25 + f * 1.1) * (1 - j / (length + 1)))))
        footer(L, (80, 90, 130))
        return L


# ── Galaxy ──────────────────────────────────────────────────────────────────────────────────────────────────────────
class Galaxy(Scene):
    def build(self) -> None:
        w, h, r = self.w, self.h, self.rng
        self.base = Canvas(w, h, (3, 3, 10))
        self.stars = make_stars(w, h - 1, r, 40)
        scale = min(w / 2.0, (h - 1) * 1.0) * 0.98
        self.polar = []                                      # per cell: radius and angle (tilted disk)
        for y in range(h - 1):
            for x in range(w):
                u, v = (x - w / 2) / 2.0 / scale * 2, (y - (h - 1) / 2) / scale * 2 * 1.25
                u, v = u * 0.94 - v * 0.34, u * 0.34 + v * 0.94
                rr = math.hypot(u, v)
                if rr < 1.25:
                    self.polar.append((x, y, rr, math.atan2(v, u)))

    def frame(self, t: float) -> Canvas:
        L = self.base.copy()
        paint_stars(L, self.stars, t, self.h - 1, (200, 210, 255))
        spin = t * 0.16
        for x, y, rr, ang in self.polar:
            a = ang - spin
            arm = math.cos(2 * a + 7.5 * math.log(rr + 0.06))
            d = 1.5 * math.exp(-rr * 5.5) + max(0.0, arm) ** 2.2 * math.exp(-rr * 1.9) * 0.95 + 0.10 * math.exp(-rr * 2.5)
            u, v = rr * math.cos(a), rr * math.sin(a)
            g = _h(int(u * 46) * 7919 + int(v * 46) * 104729, 77)   # grain: rotates with the galaxy
            d *= 0.45 + 1.1 * g
            if d < 0.09:
                continue
            col = gradient([(0.0, (255, 244, 214)), (0.18, (255, 214, 150)), (0.45, (150, 176, 255)), (0.8, (120, 110, 230)), (1.25, (70, 60, 150))], rr)
            if g > 0.93 and rr > 0.2:
                col = (255, 150, 200)                        # pink knots where stars are born
            f = min(1.0, d)
            backdrop = blend((3, 3, 10), col, min(0.5, f * 0.42))
            L.put(x, y, RAMP[min(9, 1 + int(f * 8.99))], blend(backdrop, col, 0.35 + 0.65 * f), backdrop)
        footer(L, (80, 86, 130))
        return L


# ── Nebula ──────────────────────────────────────────────────────────────────────────────────────────────────────────
class Nebula(Scene):
    TONES = [(0.0, (6, 4, 24)), (0.25, (60, 20, 110)), (0.45, (190, 50, 140)), (0.62, (255, 140, 80)), (0.78, (255, 226, 150)), (0.9, (90, 210, 220)), (1.0, (20, 60, 130))]

    def build(self) -> None:
        self.stars = make_stars(self.w, self.h - 1, self.rng, 30)

    def frame(self, t: float) -> Canvas:
        w, h = self.w, self.h
        L = Canvas(w, h, (4, 3, 16))
        sx = [math.sin(x * 0.045 + t * 0.31) + math.sin(x * 0.021 - t * 0.17) for x in range(w)]
        for y in range(h - 1):
            yy = y * 2.0
            sy = math.sin(yy * 0.05 - t * 0.23) + math.sin(yy * 0.027 + t * 0.11)
            ch, fg, bg = L.ch[y], L.fg[y], L.bg[y]
            for x in range(w):
                v = (sx[x] + sy + math.sin((x + yy) * 0.033 + t * 0.19) + math.sin(math.hypot(x - w * 0.5, yy - h) * 0.06 - t * 0.37)) * 0.125 + 0.5
                v = v + 0.05 * (noise(x * 0.09 + yy * 0.13 + t * 0.2, 5) - 0.5)
                v = 0.0 if v < 0 else 1.0 if v > 1 else v
                col = gradient(self.TONES, v)
                light = max(0.0, 1 - abs(v - 0.62) * 3.2)
                bg[x] = blend((4, 3, 16), col, 0.34)
                fg[x] = blend(col, (255, 255, 255), 0.25 * light)
                ch[x] = RAMP[1 + int(light * 8.99)] if light > 0.04 else RAMP[int(v * 3)]
        paint_stars(L, self.stars, t, h - 1, (255, 255, 255))
        footer(L, (150, 140, 190))
        return L


# ── Campfire ────────────────────────────────────────────────────────────────────────────────────────────────────────
class Campfire(Scene):
    SKY = [(0.0, (4, 6, 18)), (1.0, (14, 16, 36))]
    TENT = ["      /\\", "     /  \\", "    / /\\ \\", "   / /  \\ \\", "  /_/____\\_\\"]
    FLAME = [(0.0, (30, 6, 4)), (0.25, (170, 30, 10)), (0.5, (246, 110, 20)), (0.75, (255, 204, 70)), (1.0, (255, 250, 220))]

    def build(self) -> None:
        w, h, r, L = self.w, self.h, self.rng, self.base
        self.ground = ground = h - max(3, h // 8)
        L.sky(self.SKY, ground + 1)
        self.stars = make_stars(w, ground - 2, r, 26)
        far = profile(w, r, 2, max(5, h // 3), h // 6, 0.10, 0.3)
        ridge(L, far, ground, (12, 14, 30), (60, 66, 110))
        for y in range(ground + 1, h):
            L.bg[y] = [blend((22, 20, 18), (10, 9, 10), (y - ground) / max(1, h - ground))] * w
            for x in range(w):
                if _h(x * 31 + y * 7, 90) > 0.86:
                    L.put(x, y, ".,'`"[int(_h(x + y, 91) * 4)], (70, 66, 56))
        for x in range(w):
            L.put(x, ground, "_" if _h(x, 92) > 0.2 else ".", (76, 82, 70))
        self.fx = fx = w // 2
        self.fw, self.fh = min(26, w // 3) | 1, min(max(8, h // 2), ground - 3)
        x = r.randrange(0, 3)
        while x < w - 4:                                    # dark forest on the sides
            n = r.choice((4, 5, 6, 7, 8, 9)) if h >= 28 else r.choice((3, 4, 5))
            if x + 2 * n < fx - self.fw - 16 or x > fx + self.fw + 4:
                L.art(x, ground - n - 1 + 1, pine(n), lambda c, i, j: (26, 54, 46), (5, 10, 12))
            x += 2 * n + r.choice((1, 2, 4, 8))
        L.art(fx - self.fw - 14, ground - 4, self.TENT, (196, 150, 96), None)
        L.art(fx - 4, ground, ["\\==/\\==/"], (120, 78, 48))
        L.art(fx - 5, ground + 1, ["(o)====(o)"], (104, 66, 40))
        self.heat = [[0.0] * self.fw for _ in range(self.fh + 1)]
        self.sparks = [[r.uniform(0, 1), r.uniform(-1, 1), r.uniform(0.25, 0.6)] for _ in range(16)]

    def frame(self, t: float) -> Canvas:
        L, r, fw, fh, C = self.base.copy(), self.rng, self.fw, self.fh, self.heat
        mid = fw // 2
        for i in range(fw):                                  # the base burns hotter at the center
            C[fh][i] = max(0.0, 1.0 - (abs(i - mid) / (mid + 0.5)) ** 1.6) * r.uniform(0.75, 1.0)
        for j in range(fh):                                  # the heat rises, drifts and cools
            below = C[j + 1]
            C[j] = [max(0.0, (below[max(0, min(fw - 1, i + r.choice((-1, 0, 0, 1))))] * 2 + below[i]) / 3 - r.uniform(0.0, 2.3 / fh)) for i in range(fw)]
        flicker = 0.82 + 0.18 * noise(t * 4, 93)
        y0, x0 = self.ground - fh, self.fx - mid
        for dx in range(-fw - 18, fw + 19):                  # glow on the ground and on the tent
            x = self.fx + dx
            if 0 <= x < self.w:
                for y in range(self.ground - 5, self.h):
                    f = 0.30 * flicker * max(0.0, 1 - abs(dx) / (fw + 18))
                    L.bg[y][x] = blend(L.bg[y][x], (255, 140, 50), f * (0.5 if y < self.ground else 1))
                    if L.ch[y][x] != " ":
                        L.fg[y][x] = blend(L.fg[y][x], (255, 180, 90), f)
        for j in range(fh):
            for i in range(fw):
                v = C[j][i]
                if v > 0.06:
                    col = gradient(self.FLAME, min(1.0, v * 1.15))
                    L.put(x0 + i, y0 + j, RAMP[min(9, 1 + int(v * 9.5))], col, blend(L.bg[y0 + j][x0 + i], col, min(0.55, v * 0.6)))
        for c in self.sparks:                               # rising sparks
            f = (t * c[2] + c[0]) % 1.0
            x, y = self.fx + int(c[1] * mid * 0.6 + 3 * math.sin(f * 9 + c[0] * 20)), self.ground - int(fh * 0.5 + f * fh * 1.1)
            if 0 <= y < self.ground and 0 <= x < self.w and L.ch[y][x] in " .'+*":
                L.put(x, y, "*" if f < 0.3 else "'" if f < 0.7 else ".", blend(L.bg[y][x], (255, 190, 90), 1 - f))
        paint_stars(L, self.stars, t, self.ground - 2, (236, 240, 255))
        footer(L, (110, 100, 96))
        return L


# ── Rain in the city ────────────────────────────────────────────────────────────────────────────────────────────────
class Rain(Scene):
    SKY = [(0.0, (10, 12, 24)), (1.0, (28, 30, 52))]

    def build(self) -> None:
        w, h, r, L = self.w, self.h, self.rng, self.base
        self.street = street = h - max(4, h // 6)
        L.sky(self.SKY, street)
        self.lights = []
        for layer, (gray, lo, hi) in enumerate((((30, 33, 54), 0.35, 0.75), ((16, 18, 30), 0.2, 0.55))):
            x = -r.randrange(0, 6)
            while x < w:
                bw, bh = r.randrange(7, 15), int(street * r.uniform(lo, hi))
                for yy in range(street - bh, street):
                    for xx in range(max(0, x), min(w, x + bw)):
                        L.put(xx, yy, " ", None, gray)
                for xx in range(max(0, x), min(w, x + bw)):
                    L.put(xx, street - bh - 1, "_", blend(gray, (150, 156, 190), 0.5))
                if r.random() < 0.35 and 0 <= x + bw // 2 < w:
                    for k in range(1, r.randrange(2, 5)):
                        L.put(x + bw // 2, street - bh - 1 - k, "|", (90, 94, 130))
                for yy in range(street - bh + 1, street - 1, 2):
                    for xx in range(x + 1, x + bw - 1, 2):
                        if 0 <= xx < w and r.random() < (0.30 if layer else 0.22):
                            col = r.choice(((255, 204, 110), (255, 226, 160), (160, 214, 255), (255, 170, 120)))
                            col = blend(gray, col, 0.9 if layer else 0.5)
                            L.put(xx, yy, "#", blend(col, (0, 0, 0), 0.25), col)
                            self.lights.append((xx, yy, col, r.random()))
                x += bw + r.randrange(0, 3)
        for y in range(street, h):
            L.bg[y] = [blend((14, 16, 30), (6, 7, 14), (y - street) / max(1, h - street))] * w
        self.drops = [(r.uniform(0, w * 1.4), r.uniform(0, 1), r.uniform(0.9, 2.2)) for _ in range(max(50, w * h // 14))]
        self.bolt = (-9.0, [])

    def frame(self, t: float) -> Canvas:
        L, w, h, street, r = self.base.copy(), self.w, self.h, self.street, self.rng
        t0, trace = self.bolt
        if t - t0 > 9 + 12 * _h(int(t0 * 7), 3):
            x, trace = r.randrange(w // 8, w - w // 8), []
            for y in range(0, int(street * r.uniform(0.35, 0.6))):
                d = r.choice((-1, 0, 0, 1))
                trace.append((x, y, "/" if d < 0 else "\\" if d > 0 else "|"))
                x += d
            self.bolt = t0, trace = (t, trace)
        age = t - t0
        flash = max(0.0, 1 - age / 0.5) * (1.0 if int(age * 14) % 2 == 0 else 0.45) if 0 <= age < 0.5 else 0.0
        if flash:
            for y in range(street):
                L.bg[y] = [blend(c, (190, 200, 255), 0.42 * flash) for c in L.bg[y]]
            for x, y, c in trace:
                if 0 <= x < w and L.bg[y][x][2] > 50:
                    L.put(x, y, c, (255, 255, 255))
        for x, y, col, f in self.lights:                      # a window flickers now and then
            if f > 0.9 and noise(t * 2 + f * 50, 8) > 0.6:
                L.put(x, y, None, None, blend(col, (0, 0, 0), 0.6))
        for y in range(street, h - 1):                        # the wet street reflects the lights
            src = street - 1 - (y - street) * 2
            for x in range(w):
                xs = x + int(1.5 * math.sin(y * 1.3 + t * 2 + x * 0.2))
                if 0 <= src < street and 0 <= xs < w:
                    c = self.base.bg[src][xs]
                    if c[0] > 90 or c[2] > 120:
                        f = 0.55 - 0.08 * (y - street)
                        L.put(x, y, "~" if _h(x + y * 9 + int(t * 6), 4) > 0.5 else "=", blend(L.bg[y][x], c, max(0.1, f)))
        for x0, phase, vel in self.drops:                     # slanted rain, livelier in the foreground
            f = (t * vel * 0.9 + phase) % 1.0
            y = int(f * (h - 1))
            x = int(x0 - y * 0.45) % w
            if y >= street and f > 0.93:
                L.put(x, y, "." if vel < 1.5 else "o", (150, 170, 210))
            elif L.ch[y][x] == " ":
                L.put(x, y, "/" if vel > 1.7 else "'" if vel < 1.2 else ",", blend(L.bg[y][x], (170, 190, 235), 0.25 + 0.3 * vel))
        footer(L, (96, 104, 140))
        return L


# ── Cherry tree in bloom ────────────────────────────────────────────────────────────────────────────────────────────
class Cherry(Scene):
    SKY = [(0.0, (30, 28, 70)), (0.45, (110, 70, 120)), (0.8, (236, 140, 130)), (1.0, (255, 204, 150))]

    def line(self, x0: float, y0: float, x1: float, y1: float, col: RGB, thick: int) -> None:
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        dx, dy = (x1 - x0), (y1 - y0)
        c = "|" if abs(dx) < abs(dy) * 0.6 else "_" if abs(dy) < abs(dx) * 0.25 else "/" if dx * dy < 0 else "\\"
        for k in range(n + 1):
            x, y = x0 + dx * k / n, y0 + dy * k / n
            for g in range(thick):
                self.base.put(int(round(x)) + g - thick // 2, int(round(y)), c if g in (0, thick - 1) else "#", col, (40, 26, 26) if thick > 1 else None)

    def branch(self, x: float, y: float, ang: float, length: float, level: int) -> None:
        x1, y1 = x + math.cos(ang) * length * 2, y - math.sin(ang) * length
        self.line(x, y, x1, y1, blend((110, 72, 60), (70, 44, 40), level / 5), max(1, 4 - level * 2))
        if level >= 4 or length < 1.6:
            self.tips.append((x1, y1))
            return
        if level >= 2:
            self.tips.append((x1, y1))
        for _ in range(2 if level else 3):
            self.branch(x1, y1, ang + self.rng.uniform(-0.75, 0.75) + (0.12 if math.cos(ang) < 0 else -0.12), length * self.rng.uniform(0.62, 0.8), level + 1)

    def build(self) -> None:
        w, h, r, L = self.w, self.h, self.rng, self.base
        self.ground = ground = h - max(3, h // 7)
        L.sky(self.SKY, ground + 1)
        moon(L, int(w * 0.80), int(ground * 0.72), max(3, h // 9), (255, 232, 190), 6)   # low sun in the haze
        far = profile(w, r, 1, max(3, h // 5), h // 8, 0.08, 0.4)
        ridge(L, far, ground, (120, 84, 120), (190, 130, 150))
        hill = profile(w, r, 0, 2, 1, 0.05, 0.9)
        prev = hill[0]
        for x, a in enumerate(hill):
            for y in range(ground - a + 1, h):
                L.put(x, y, " ", None, blend((44, 70, 56), (20, 32, 30), (y - (ground - a)) / max(1, h - ground + a)))
                if _h(x * 17 + y * 5, 95) > 0.88:
                    L.put(x, y, "\"'.,"[int(_h(x + y * 3, 96) * 4)], (90, 140, 96))
            L.put(x, ground - a + 1 if a > prev else ground - prev + 1 if a < prev else ground - a, "/" if a > prev else "\\" if a < prev else "_", (120, 170, 120))
            prev = a
        self.tips: list[tuple[float, float]] = []
        tx = int(w * 0.36)
        self.branch(tx, ground, math.pi / 2 + r.uniform(-0.12, 0.12), min(ground * 0.26, w * 0.06), 0)
        self.blossoms = []
        for px, py in self.tips:                           # crowns of blossom around each tip
            for _ in range(26):
                x, y = int(px + r.gauss(0, 3.6)), int(py + r.gauss(0, 1.5))
                if 0 <= x < w and 0 <= y < ground - 1:
                    self.blossoms.append((x, y, r.choices("@*o.", weights=(3, 4, 3, 2))[0], r.random()))
        for x in range(w):                                   # fallen petals
            if _h(x, 97) > 0.55 and abs(x - tx) < w * 0.3:
                L.put(x, ground - hill[x] + 1 + int(_h(x, 98) * 2), ".,*"[int(_h(x, 99) * 3)], (250, 180, 205))
        self.petals = [(r.uniform(0, w), r.uniform(0, 1), r.uniform(0.05, 0.14), r.uniform(0, 6.28)) for _ in range(max(24, w // 3))]

    def frame(self, t: float) -> Canvas:
        L, w, ground = self.base.copy(), self.w, self.ground
        for x, y, c, f in self.blossoms:
            shine = 0.5 + 0.5 * math.sin(t * 0.9 + f * 30 + x * 0.15)
            col = blend(blend((236, 120, 170), (255, 214, 230), f), (255, 255, 255), 0.25 * shine)
            L.put(x + (1 if shine > 0.93 and c in ".o" else 0), y, c, col)
        for x0, phase, vel, shift in self.petals:              # petals falling with the wind
            f = (t * vel + phase) % 1.0
            y = int(f * (ground + 1))
            x = int(x0 + f * w * 0.22 + 3 * math.sin(f * 14 + shift)) % w
            if L.ch[y][x] == " ":
                L.put(x, y, "*" if int(t * 3 + shift * 9) % 3 == 0 else "'" if int(t * 3 + shift * 9) % 3 == 1 else ",", blend(L.bg[y][x], (255, 196, 216), 0.9))
        footer(L, (110, 130, 120))
        return L



# ── Shading engine ──────────────────────────────────────────────────────────────────────────────────────────────────
# Each engine scene computes a color image at a higher resolution than the terminal (like a shader) and the engine
# turns it into characters: the light of each cell picks the character from a ramp (dithered so no steps show)
# and where there is a strong edge it draws the line that follows it ( | / - \ ).
RAMP_M = " .,:;+*o#%@"
EDGE_M = "|/-\\"


def _mix(a, b, t):
    return a + (b - a) * t


def _col(r: float, g: float, b: float):
    return np.array((r, g, b), dtype=np.float32)


class Engine(Scene):
    BACKGROUND, THRESHOLD, GAMMA = 0.30, 0.85, 0.85
    STARS = False                                        # stars twinkling over the dark parts (painted per cell)

    def build(self) -> None:
        w, h = self.w, self.h
        self.sx, self.sy = (2 if w * h <= 7000 else 1), 2
        H2, W2 = h * self.sy, w * self.sx
        j, i = np.mgrid[0:H2, 0:W2].astype(np.float32)
        self.V = (j + 0.5) / H2 * 2 - 1                      # -1 top … 1 bottom
        self.U = ((i + 0.5) / W2 * 2 - 1) * (w / (2.0 * h))  # real aspect ratio: a cell is twice as tall
        bayer = np.array([[0, 8, 2, 10], [12, 4, 14, 6], [3, 11, 1, 9], [15, 7, 13, 5]], dtype=np.float32) / 16
        self.dither = np.tile(bayer, (h // 4 + 1, w // 4 + 1))[:h, :w]
        self.ramp, self.edge = np.array(list(RAMP_M)), np.array(list(EDGE_M))
        self.rand = np.random.default_rng(self.rng.randrange(1 << 30))
        self.stars = make_stars(w, h - 1, self.rng, 30) if self.STARS else []
        self.prepare()

    def prepare(self) -> None: ...
    def shade(self, t: float): ...

    def frame(self, t: float) -> Canvas:
        w, h, sx, sy = self.w, self.h, self.sx, self.sy
        rgb = np.clip(self.shade(t), 0, 1).astype(np.float32)
        lum = rgb @ np.array((0.299, 0.587, 0.114), dtype=np.float32)
        cell = rgb.reshape(h, sy, w, sx, 3).mean(axis=(1, 3))
        lc = lum.reshape(h, sy, w, sx).mean(axis=(1, 3))
        p = np.pad(lum, 1, mode="edge")                      # edges (Sobel) on the fine image
        gx = ((p[:-2, 2:] + 2 * p[1:-1, 2:] + p[2:, 2:]) - (p[:-2, :-2] + 2 * p[1:-1, :-2] + p[2:, :-2])) * sx
        gy = ((p[2:, :-2] + 2 * p[2:, 1:-1] + p[2:, 2:]) - (p[:-2, :-2] + 2 * p[:-2, 1:-1] + p[:-2, 2:])) * (sy / 2.0)
        mag = np.hypot(gx, gy).reshape(h, sy, w, sx).transpose(0, 2, 1, 3).reshape(h, w, sy * sx)
        which = mag.argmax(axis=2)[..., None]
        gx = np.take_along_axis(gx.reshape(h, sy, w, sx).transpose(0, 2, 1, 3).reshape(h, w, -1), which, 2)[..., 0]
        gy = np.take_along_axis(gy.reshape(h, sy, w, sx).transpose(0, 2, 1, 3).reshape(h, w, -1), which, 2)[..., 0]
        strong = np.take_along_axis(mag, which, 2)[..., 0] > self.THRESHOLD
        k = (((np.arctan2(gy, gx) % np.pi) + np.pi / 8) // (np.pi / 4)).astype(np.int32) % 4
        n = len(RAMP_M)
        idx = np.clip(np.floor(lc ** self.GAMMA * (n - 1) + self.dither), 0, n - 1).astype(np.int32)
        idx[lc < 0.075] = 0                                  # very dark areas stay flat, with no stipple
        ch = np.where(strong, self.edge[k], self.ramp[idx])
        fg = np.clip(cell * 1.3 + 0.10 + strong[..., None] * 0.22, 0, 1)
        L = Canvas.__new__(Canvas)
        L.w, L.h = w, h
        L.ch = ch.tolist()
        L.fg = [list(map(tuple, f)) for f in (fg * 255).astype(np.uint8).tolist()]
        L.bg = [list(map(tuple, f)) for f in (cell * self.BACKGROUND * 255).astype(np.uint8).tolist()]
        if self.stars:
            dark = (lc < 0.05).tolist()
            for x, y, c, phase, vel in self.stars:
                if dark[y][x]:
                    L.ch[y][x] = c
                    L.fg[y][x] = blend(L.bg[y][x], (235, 240, 255), (0.45 + 0.55 * (0.5 + 0.5 * math.sin(t * vel + phase))) * (1.0 if c in "*+" else 0.75))
        footer(L, (150, 150, 170))
        return L


class Ocean(Engine):
    """Sunset over the sea: the sun, clouds and the glitter running over the waves."""

    def shade(self, t: float):
        U, V, hz = self.U, self.V, -0.08
        su, sv = 0.0, hz - 0.17
        s = np.clip((V + 1) / (hz + 1), 0, 1)[..., None]
        sky = np.where(s < 0.6, _mix(_col(0.05, 0.06, 0.22), _col(0.46, 0.20, 0.42), s / 0.6), _mix(_col(0.46, 0.20, 0.42), _col(1.0, 0.56, 0.24), (s - 0.6) / 0.4))
        d = np.hypot(U - su, V - sv)
        sky = sky + np.exp(-d * 4.5)[..., None] * _col(1.0, 0.62, 0.30) * 0.75
        cloud = np.sin(U * 2.6 + t * 0.05 + 1.4 * np.sin(V * 7 + U * 1.1)) * np.sin(V * 15 + U * 1.7 - t * 0.03)
        cloud = np.clip(cloud * 1.6 - 0.25, 0, 1) * np.exp(-((V - (hz - 0.52)) / 0.30) ** 2)
        sky = _mix(sky, _col(0.98, 0.50, 0.42) * (0.55 + 0.45 * np.clip(1 - d, 0, 1))[..., None], (cloud * 0.75)[..., None])
        sky = np.where((d < 0.115)[..., None], _col(1.0, 0.95, 0.74), sky)
        dv = np.maximum(V - hz, 1e-3)
        z, f = 0.33 / dv, t * 1.15
        x = U * z
        slope = 0.55 * np.cos(z * 1.9 + f + 0.6 * np.sin(x * 0.7)) + 0.30 * np.cos(z * 4.3 + x * 1.3 + f * 1.7) + 0.15 * np.cos(z * 9.1 - x * 2.9 + f * 2.3)
        slope = slope * (0.25 + 0.75 * np.clip(dv * 3.5, 0, 1))
        water = _mix(_col(0.02, 0.07, 0.17), _col(0.60, 0.30, 0.32), (0.34 + 0.34 * slope)[..., None])
        path = np.exp(-((U - su) / (0.05 + 0.6 * dv)) ** 2)
        water = water + (path * np.clip(slope * 1.4 + 0.3, 0, 1) ** 3 * 1.7)[..., None] * _col(1.0, 0.78, 0.42)
        water = _mix(water, _col(0.92, 0.50, 0.30), (np.exp(-dv * 7) * 0.75)[..., None])
        return np.where((V < hz)[..., None], sky, water)


class Planet(Engine):
    """A ringed gas giant spins slowly in front of the stars."""
    THRESHOLD, STARS = 1.0, True

    def prepare(self) -> None:
        a = self.rand
        self.dirs, self.phases = a.normal(size=(6, 3)).astype(np.float32), a.uniform(0, 6.28, 6)
        self.dirs /= np.linalg.norm(self.dirs, axis=1, keepdims=True)

    def shade(self, t: float):
        U, V, R = self.U, self.V, 0.62
        d2 = U * U + V * V
        inside = d2 < R * R
        z = np.sqrt(np.maximum(R * R - d2, 0))
        nx, ny, nz = U / R, V / R, z / R
        c, s_, a = math.cos(0.42), math.sin(0.42), t * 0.22
        y1, z1 = ny * c - nz * s_, ny * s_ + nz * c
        px, pz = nx * math.cos(a) + z1 * math.sin(a), -nx * math.sin(a) + z1 * math.cos(a)
        turb = sum(np.sin(fr * (px * dx + y1 * dy + pz * dz) + fa) / fr for fr, (dx, dy, dz), fa in zip((2.2, 3.1, 4.7, 6.3, 8.9, 12.5), self.dirs, self.phases))
        band = (0.5 + 0.5 * np.sin(y1 * 11 + turb * 2.4))[..., None]
        col = _mix(_col(0.74, 0.40, 0.22), _col(0.96, 0.86, 0.66), band)
        col = _mix(col, _col(0.50, 0.26, 0.20), (np.clip(np.sin(y1 * 23 + turb * 3) - 0.55, 0, 1) * 1.6)[..., None])
        spot = np.exp(-(((px - 0.55) / 0.22) ** 2 + ((y1 - 0.30) / 0.11) ** 2)) * (pz > 0)
        col = _mix(col, _col(0.86, 0.26, 0.16), spot[..., None])
        light = np.clip(nx * -0.55 + ny * -0.33 + nz * 0.77, 0, 1)
        planet = col * (0.03 + light ** 0.9)[..., None] + ((1 - nz) ** 2.5 * light)[..., None] * _col(0.35, 0.5, 0.95) * 0.7
        r = np.sqrt(d2)
        backdrop = _col(0.02, 0.02, 0.06) + (np.exp(-(r - R) * 10) * (0.5 - 0.5 * (U * 0.85 + V * 0.5) / (r + 1e-3)))[..., None] * _col(0.25, 0.4, 0.9) * 0.55
        out = np.where(inside[..., None], planet, backdrop)
        zr = V / math.tan(0.30)                              # rings: a tilted plane through the center
        rr = np.sqrt(U * U + V * V + zr * zr) / R
        vis = (rr > 1.28) & (rr < 2.15) & (~inside | (zr > z))
        hue = (0.50 + 0.50 * np.sin(rr * 46)) * (0.55 + 0.45 * np.sin(rr * 9 + 1)) * (np.abs(rr - 1.72) > 0.035)
        shadow = 1 - 0.85 * ((U > 0) & (np.abs(V + U * 0.35) < R * 0.9) & (zr < 0) & (rr < 2.15) & (U < R * 2.2) & (V < 0))
        return np.where(vis[..., None], _mix(out, _col(0.90, 0.80, 0.62) * (hue * shadow)[..., None], 0.85), out)


class Donut(Engine):
    """A colored donut spins in space (the classic one, with light and shine)."""
    THRESHOLD, STARS = 1.1, True

    def shade(self, t: float):
        U, V = self.U, self.V
        a, b = 0.9 + t * 0.7, 0.4 + t * 0.45
        ca, sa, cb, sb = math.cos(a), math.sin(a), math.cos(b), math.sin(b)

        def rotate(x, y, z):                                   # from camera space to donut space
            y, z = y * ca - z * sa, y * sa + z * ca
            x, z = x * cb + z * sb, -x * sb + z * cb
            return x, y, z

        n = np.sqrt(U * U * 0.81 + V * V * 0.81 + 2.56)
        ox, oy, oz = rotate(0.0, 0.0, -4.4)
        dx, dy, dz = rotate(U * 0.9 / n, V * 0.9 / n, 1.6 / n)
        R1, r2 = 1.0, 0.46
        dist = np.zeros_like(U)
        for _ in range(26):
            px, py, pz = ox + dx * dist, oy + dy * dist, oz + dz * dist
            q = np.hypot(px, pz) - R1
            d = np.hypot(q, py) - r2
            dist = dist + np.minimum(d, 1.0) * (dist < 7)
        px, py, pz = ox + dx * dist, oy + dy * dist, oz + dz * dist
        ro = np.hypot(px, pz) + 1e-6
        q = ro - R1
        hit = (np.hypot(q, py) - r2 < 0.03) & (dist < 7)
        nx, ny, nz = (px - px / ro * R1) / r2, py / r2, (pz - pz / ro * R1) / r2
        lx, ly, lz = rotate(-0.5, -0.6, -0.62)
        light = np.clip(nx * lx + ny * ly + nz * lz, 0, 1)
        hx, hy, hz = lx - dx, ly - dy, lz - dz
        hn = np.sqrt(hx * hx + hy * hy + hz * hz)
        shine = np.clip((nx * hx + ny * hy + nz * hz) / hn, 0, 1) ** 28
        a1, a2 = np.arctan2(pz, px), np.arctan2(py, q)
        hue = (a1 / 6.2832 + t * 0.04)[..., None] + np.array((0.0, 0.33, 0.67), dtype=np.float32)
        col = (0.55 + 0.45 * np.cos(6.2832 * hue)) * (0.72 + 0.28 * np.sign(np.sin(a1 * 8) * np.sin(a2 * 5)))[..., None]
        donut = col * (0.10 + 0.95 * light)[..., None] + shine[..., None] * 0.8
        backdrop = _col(0.02, 0.02, 0.06) + np.exp(-(U * U + V * V) * 1.6)[..., None] * _col(0.06, 0.04, 0.14)
        return np.where(hit[..., None], donut, backdrop)


class Lava(Engine):
    """Lava lamp: blobs that rise, sink, merge and split."""
    BACKGROUND = 0.42

    def prepare(self) -> None:
        r, asp = self.rng, self.w / (2.0 * self.h)
        self.blobs = [(asp * r.uniform(0.3, 0.92), r.uniform(0.12, 0.33), r.uniform(0, 6.28), 0.85 * r.uniform(0.5, 1.0), r.uniform(0.17, 0.5), r.uniform(0, 6.28), r.uniform(0.16, 0.36)) for _ in range(max(7, int(asp * 5)))]

    def shade(self, t: float):
        U, V = self.U, self.V
        f, gx, gy = np.zeros_like(U), np.zeros_like(U), np.zeros_like(U)
        for ax, wx, fx, ay, wy, fy, rad in self.blobs:
            dx, dy = U - ax * math.sin(t * wx + fx), V - ay * math.sin(t * wy + fy)
            q = rad * rad / (dx * dx + dy * dy + 1e-4)
            f, gx, gy = f + q, gx + q * dx, gy + q * dy
        inside = np.clip((f - 0.92) / 0.16, 0, 1)
        g = np.hypot(gx, gy) + 1e-6
        light = np.clip(0.5 + 0.5 * (gx * 0.6 + gy * 0.8) / g * np.clip(2.6 - f, 0, 1), 0, 1)
        v = np.clip((f - 1) / 2.6, 0, 1)[..., None]
        col = np.where(v < 0.5, _mix(_col(0.86, 0.10, 0.46), _col(1.0, 0.48, 0.10), v * 2), _mix(_col(1.0, 0.48, 0.10), _col(1.0, 0.92, 0.45), v * 2 - 1))
        blob = col * (0.50 + 0.70 * light)[..., None]
        backdrop = _col(0.07, 0.01, 0.13) + (np.clip(f, 0, 1) ** 2 * 0.55)[..., None] * _col(0.55, 0.05, 0.36)
        return _mix(backdrop, blob, inside[..., None])


class Flight(Engine):
    """Low flight over endless mountains, valleys and lakes."""
    STEPS, THRESHOLD = 72, 0.7

    @staticmethod
    def height(x, z):
        h = 0.55 * np.sin(x * 0.35) * np.cos(z * 0.31) + 0.30 * np.sin(x * 0.83 + 1.7) * np.sin(z * 0.71) + 0.14 * np.sin(x * 1.9 + z * 1.3) + 0.07 * np.sin(x * 4.1 - z * 3.7)
        return h + 0.35 * (1 - np.abs(np.sin(x * 0.21 + z * 0.17))) ** 3

    def shade(self, t: float):
        U, V = self.U, self.V
        H2, W2 = U.shape
        hz, water = -0.20, -0.22
        s = np.clip((V + 1) / (hz + 1.25), 0, 1)[..., None]
        haze = _col(0.80, 0.72, 0.74)
        sky = _mix(_col(0.16, 0.30, 0.62), haze, s ** 1.5)
        d = np.hypot(U - 0.42, V + 0.52)
        sky = sky + np.exp(-d * 6)[..., None] * _col(1.0, 0.85, 0.55) * 0.9
        sky = np.where((d < 0.07)[..., None], _col(1.0, 0.97, 0.85), sky)
        cols = U[0]
        x0, z0, cam = 3.0 * math.sin(t * 0.07), t * 1.5, 1.25
        rows = np.arange(H2, dtype=np.int32)[:, None]
        top = np.full(W2, H2, dtype=np.int32)
        step = np.full((H2, W2), -1, dtype=np.int32)
        color = np.empty((self.STEPS, W2, 3), dtype=np.float32)
        for k in range(self.STEPS):
            z = 0.22 * 1.066 ** k
            x, zw = x0 + cols * z * 1.15, z0 + z
            h = self.height(x, zw)
            slope = np.clip((self.height(x + 0.12, zw + 0.06) - h) * 4.5, -1, 1)
            hw = np.maximum(h, water)
            row = ((hz + (cam - hw) / z * 0.62 + 1) * 0.5 * H2)
            c = np.where((h > 0.62)[:, None], _col(0.95, 0.96, 1.0), np.where((h > 0.30)[:, None], _col(0.46, 0.41, 0.38), np.where((h > -0.12)[:, None], _col(0.22, 0.48, 0.22), _col(0.70, 0.64, 0.42))))
            c = c * (0.62 + 0.45 * slope)[:, None]
            wave = 0.5 + 0.5 * np.sin(x * 7 + zw * 5 + t * 2)
            c = np.where((h <= water)[:, None], _col(0.10, 0.32, 0.55) + (wave ** 6 * 0.5)[:, None], c)
            color[k] = _mix(c, haze, 1 - math.exp(-z * 0.13))
            upper = np.clip(row, 0, H2).astype(np.int32)
            step = np.where((rows >= upper[None, :]) & (rows < top[None, :]), k, step)
            top = np.minimum(top, upper)
        land = color[np.maximum(step, 0), np.arange(W2)[None, :]]
        return np.where((step >= 0)[..., None], land, sky)


def _hash2(i, j):
    """Fixed number in 0..1 for each pair of integers (stable texture, vectorized)."""
    n = (i.astype(np.int64) * 374761393 + j.astype(np.int64) * 668265263) & 0xFFFFFFFF
    n = ((n ^ (n >> 13)) * 1274126177) & 0xFFFFFFFF
    return (((n ^ (n >> 16)) & 0xFFFF) / 65535.0).astype(np.float32)


def noise2(x, y):
    """Smooth noise in 0..1 over the plane."""
    x, y = np.asarray(x, dtype=np.float32), np.asarray(y, dtype=np.float32)
    x, y = np.broadcast_arrays(x, y)
    i, j = np.floor(x), np.floor(y)
    fx, fy = x - i, y - j
    fx, fy = fx * fx * (3 - 2 * fx), fy * fy * (3 - 2 * fy)
    a, b, c, d = _hash2(i, j), _hash2(i + 1, j), _hash2(i, j + 1), _hash2(i + 1, j + 1)
    return a + (b - a) * fx + (c - a) * fy + (a - b - c + d) * fx * fy


def clouds2(x, y, octaves: int = 4):
    """Noise at several scales (clouds, smoke, gas), 0..1."""
    v, amp, tot = 0.0, 0.5, 0.0
    for _ in range(octaves):
        v, tot = v + amp * noise2(x, y), tot + amp
        x, y, amp = x * 2.03 + 11.3, y * 2.03 + 7.7, amp * 0.5
    return v / tot


def _palette(t, a, b, c, d):
    """Cyclic palette: a + b·cos(2π(c·t + d)), per channel."""
    return _col(*a) + _col(*b) * np.cos(6.2832 * (_col(*c) * t[..., None] + _col(*d)))


class Boreal(Engine):
    """Northern lights over mountains, reflected in a still lake."""
    STARS, THRESHOLD = True, 1.2

    def prepare(self) -> None:
        u = self.U[0]
        self.crest = -0.02 - 0.15 * clouds2(u * 1.6 + 3, u * 0 + 1.5, 4) - 0.06 * np.clip(np.sin(u * 2.1 + 1), 0, 1)

    def light(self, U, V, t):
        out = np.zeros(U.shape + (3,), dtype=np.float32)
        for k, (base, vel, hue) in enumerate(((-0.42, 0.13, 0.0), (-0.60, -0.09, 0.25), (-0.28, 0.07, 0.5))):
            x = U + 0.22 * np.sin(V * 2.2 + t * 0.21 + k * 1.7)
            yb = base + 0.13 * np.sin(x * 1.7 + t * vel + k * 2.1) + 0.05 * np.sin(x * 4.3 - t * vel * 2)
            height = np.clip(yb - V, 0, None)
            ray = noise2(x * 5 + k * 13, t * 0.16 + k) ** 1.6 * (0.55 + 0.45 * noise2(x * 34, t * 0.6 + k * 3))
            strength = ray * np.exp(-height * 3.4) * np.clip((yb - V) / 0.03, 0, 1) * 1.9
            f = np.clip(height * 1.9 + hue * 0.3, 0, 1)[..., None]
            col = np.where(f < 0.45, _mix(_col(0.30, 1.0, 0.56), _col(0.20, 0.82, 0.76), f / 0.45), _mix(_col(0.20, 0.82, 0.76), _col(0.62, 0.34, 0.86), (f - 0.45) / 0.55))
            out += col * strength[..., None]
        return out

    def shade(self, t: float):
        U, V, hz = self.U, self.V, 0.12
        sky = _mix(_col(0.01, 0.02, 0.07), _col(0.03, 0.09, 0.14), np.clip((V + 1) / (hz + 1), 0, 1)[..., None])
        upper = sky + self.light(U, V, t)
        mountain = V > (hz + self.crest)[None, :]
        upper = np.where(mountain[..., None], _col(0.03, 0.045, 0.07) + upper * 0.06, upper)
        vr = 2 * hz - V + 0.012 * np.sin(V * 90 + t * 1.5 + U * 6)                    # the lake: the same sky, upside down and rippled
        ur = U + 0.01 * np.sin(V * 70 - t * 1.2)
        refl = (sky + self.light(ur, vr, t)) * 0.62
        refl = np.where((vr > (hz + self.crest)[None, :])[..., None], _col(0.008, 0.014, 0.026), refl)
        return np.where((V < hz)[..., None], upper, refl + _col(0.0, 0.01, 0.02))


class Tunnel(Engine):
    """An endless tunnel of light."""
    THRESHOLD = 1.1

    def shade(self, t: float):
        U, V = self.U - 0.18 * math.sin(t * 0.37), self.V - 0.14 * math.cos(t * 0.29)
        r = np.hypot(U, V) + 1e-4
        depth = 0.42 / r + t * 1.4
        ang = np.arctan2(V, U) / 3.14159 + 0.25 * np.sin(depth * 0.35) + t * 0.03
        stripe = 0.5 + 0.5 * np.sin(depth * 4.2) * np.sin(ang * 3.14159 * 6)
        ring = np.clip(np.sin(depth * 2.1) * 3 - 2, 0, 1)
        col = _palette(depth * 0.07 + ang * 0.15, (0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (1.0, 0.9, 0.8), (0.0, 0.15, 0.35))
        col = col * (0.22 + 0.78 * stripe ** 1.5)[..., None] + ring[..., None] * _col(1.0, 0.95, 0.85) * 0.7
        return col * np.clip(r * 2.4, 0, 1)[..., None] ** 1.3 + np.exp(-r * 9)[..., None] * _col(0.5, 0.7, 1.0)


class Clouds(Engine):
    """Flight over a sea of clouds at sunset."""
    THRESHOLD = 0.75

    def shade(self, t: float):
        U, V, hz = self.U, self.V, -0.10
        s = np.clip((V + 1) / (hz + 1), 0, 1)[..., None]
        sky = np.where(s < 0.55, _mix(_col(0.07, 0.10, 0.32), _col(0.52, 0.28, 0.50), s / 0.55), _mix(_col(0.52, 0.28, 0.50), _col(1.0, 0.62, 0.30), (s - 0.55) / 0.45))
        d = np.hypot(U + 0.25, V - hz + 0.06)
        sky = sky + np.exp(-d * 4)[..., None] * _col(1.0, 0.66, 0.34) * 0.8
        sky = np.where((d < 0.10)[..., None], _col(1.0, 0.96, 0.78), sky)
        cirrus = np.clip(clouds2(U * 2.2 + t * 0.03, V * 9 + 4, 3) * 2 - 1.05, 0, 1) * np.clip(1 - s[..., 0] * 1.2, 0, 1)
        sky = _mix(sky, _col(1.0, 0.72, 0.62), (cirrus * 0.6)[..., None])
        dv = np.maximum(V - hz, 1e-3)
        z = 0.30 / dv
        x, zz = U * z * 1.2, z + t * 0.55
        den = clouds2(x * 0.55, zz * 0.55, 5)
        side = clouds2(x * 0.55 + 0.22, zz * 0.55 - 0.10, 5)
        light = np.clip((den - side) * 5.5 + 0.55, 0, 1)
        cloud = _mix(_col(0.30, 0.20, 0.42), _col(1.0, 0.74, 0.56), light[..., None])
        cloud = _mix(_col(0.16, 0.13, 0.34), cloud, np.clip((den - 0.36) * 4.5, 0, 1)[..., None])
        cloud = _mix(cloud, _col(0.98, 0.60, 0.36), (np.exp(-dv * 5.5) * 0.85)[..., None])
        return np.where((V < hz)[..., None], sky, cloud)


class Fire(Engine):
    """Flames rising across the whole screen."""
    BACKGROUND, THRESHOLD = 0.38, 1.0

    def shade(self, t: float):
        U, V = self.U, self.V
        base = (V + 1) / 2
        n = clouds2(U * 2.8 + 0.4 * np.sin(V * 3 + t), V * 2.4 + t * 1.9, 4)
        fine = clouds2(U * 7.5, V * 5.5 + t * 3.1, 2)
        heat = np.clip((n * 0.85 + fine * 0.25) * 1.5 * base ** 1.1 + base * 0.62 - 0.52, 0, 1)
        f = heat[..., None]
        col = np.where(f < 0.3, _mix(_col(0.03, 0.0, 0.02), _col(0.62, 0.06, 0.02), f / 0.3),
                       np.where(f < 0.6, _mix(_col(0.62, 0.06, 0.02), _col(1.0, 0.46, 0.05), (f - 0.3) / 0.3),
                                np.where(f < 0.85, _mix(_col(1.0, 0.46, 0.05), _col(1.0, 0.86, 0.30), (f - 0.6) / 0.25), _mix(_col(1.0, 0.86, 0.30), _col(1.0, 1.0, 0.86), (f - 0.85) / 0.15))))
        return col


class Pond(Engine):
    """Raindrops open rings on a pond under the moon."""
    THRESHOLD = 0.6

    def prepare(self) -> None:
        r, asp = self.rng, self.w / (2.0 * self.h)
        self.drops = [(r.uniform(-asp, asp), r.uniform(-0.9, 0.9), r.uniform(0, 5.0), r.uniform(3.6, 5.4)) for _ in range(max(9, int(asp * 7)))]

    def shade(self, t: float):
        U, V = self.U, self.V
        h = np.zeros_like(U)
        for gx, gy, t0, cycle in self.drops:
            age = (t + t0) % cycle
            d = np.hypot(U - gx, (V - gy) * 1.35)
            front = age * 0.36
            h += np.sin((d - front) * 46) * np.exp(-((d - front) / 0.085) ** 2) * math.exp(-age * 0.55) * 0.9
        h += 0.05 * np.sin(U * 9 + t * 0.8) * np.sin(V * 13 - t * 0.6)
        gy_, gx_ = np.gradient(h)
        gx_, gy_ = gx_ * self.w * 0.11, gy_ * self.h * 0.11
        water = _mix(_col(0.01, 0.06, 0.10), _col(0.05, 0.20, 0.26), np.clip(0.5 + V * 0.4 + gy_ * 0.9, 0, 1)[..., None])
        moon_ = np.exp(-(((U - 0.25 + gx_ * 0.5) / 0.20) ** 2 + ((V + 0.35 + gy_ * 0.5) / 0.26) ** 2))
        shine = np.clip(gx_ * -0.7 + gy_ * -0.9, 0, 1) ** 2
        return water + moon_[..., None] * _col(0.92, 0.90, 0.74) * 0.85 + shine[..., None] * _col(0.62, 0.80, 0.86) * 0.9


class Fractal(Engine):
    """A Julia fractal that changes shape without repeating."""
    THRESHOLD = 1.3

    def shade(self, t: float):
        scale = 1.45 - 0.25 * math.sin(t * 0.11)
        a = t * 0.13
        zr, zi = (self.U * scale * math.cos(a * 0.3) - self.V * scale * math.sin(a * 0.3)).copy(), (self.U * scale * math.sin(a * 0.3) + self.V * scale * math.cos(a * 0.3)).copy()
        cr, ci = 0.7885 * math.cos(a), 0.7885 * math.sin(a)
        count = np.zeros_like(zr)
        alive = np.ones(zr.shape, dtype=bool)
        m2 = zr * zr + zi * zi
        for _ in range(44):
            zr, zi = np.where(alive, zr * zr - zi * zi + cr, zr), np.where(alive, 2 * zr * zi + ci, zi)
            m2 = zr * zr + zi * zi
            alive = alive & (m2 < 16)
            count += alive
        smooth = count + 1 - np.log2(np.maximum(np.log2(np.maximum(m2, 1.0001)), 1e-3)) * (~alive)
        v = np.clip(smooth / 44, 0, 1)
        col = _palette(v * 2.2 + t * 0.03, (0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (1.0, 1.0, 1.0), (0.0, 0.10, 0.20)) * (0.15 + 0.85 * v ** 0.6)[..., None]
        return np.where(alive[..., None], _col(0.02, 0.01, 0.05), col)


class BlackHole(Engine):
    """A black hole with its disk of glowing gas."""
    STARS, THRESHOLD = True, 1.0

    def shade(self, t: float):
        U, V, Rs = self.U, self.V, 0.20
        r = np.hypot(U, V) + 1e-4
        ang = np.arctan2(V, U)
        pull = 1 - np.clip(Rs * Rs * 2.2 / (r * r), 0, 0.95)                          # space bends toward the center
        gas = clouds2(U * pull * 2.2 + 5, V * pull * 2.2 + 3, 4)
        backdrop = _col(0.015, 0.012, 0.04) + (np.clip(gas - 0.52, 0, 1) * 0.9)[..., None] * _col(0.30, 0.16, 0.50)

        def disk(rd, a, vel):
            swirl = clouds2(a * 2.2 + rd * 3 - t * vel / (rd + 0.1) ** 1.5 * 0.35, rd * 11, 3)
            light = np.clip((rd - 0.30) / 0.05, 0, 1) * np.clip((1.02 - rd) / 0.25, 0, 1) * (0.34 / (rd + 0.05)) ** 1.6 * (0.7 + 1.3 * swirl)
            f = np.clip((rd - 0.3) / 0.7, 0, 1)[..., None]
            return np.where(f < 0.35, _mix(_col(1.0, 0.97, 0.86), _col(1.0, 0.70, 0.26), f / 0.35), _mix(_col(1.0, 0.70, 0.26), _col(0.80, 0.20, 0.06), (f - 0.35) / 0.65)) * light[..., None]

        vd = V / 0.24                                                                # the disk, almost edge-on
        rd = np.hypot(U, vd)
        doppler = (1.0 + 0.65 * (-U / (rd + 1e-3)))[..., None]
        front = disk(rd, np.arctan2(vd, U), 1.0) * doppler
        arc = disk(np.clip((r - Rs * 1.62) / (Rs * 1.15), 0, 1) * 0.7 + 0.3, ang, 0.6) * (np.clip((r - Rs * 1.62) / 0.02, 0, 1) * np.clip((Rs * 2.9 - r) / 0.05, 0, 1) * (0.42 + 0.25 * (V < 0)))[..., None]
        ring = np.exp(-((r - Rs * 1.62) / 0.012) ** 2)[..., None] * _col(1.0, 0.86, 0.60) * 0.9
        out = backdrop + arc + ring
        out = np.where((r < Rs * 1.58)[..., None], _col(0.0, 0.0, 0.0), out)        # the shadow
        return np.where(((V > 0) | (r > Rs * 1.58))[..., None], out + front * ((V > 0) | (r > Rs * 2.9))[..., None] + front * 0.0, out)


SCENES = {"peaks": Peaks, "aurora": Aurora, "snowfall": Snowfall, "sailboat": Sailboat, "fish": Fish, "pipes": Pipes, "battle": Battle,
           "campfire": Campfire, "cherry": Cherry, "rain": Rain, "galaxy": Galaxy, "nebula": Nebula, "hyperspace": Hyperspace}
ENGINE_SCENES = {"ocean": Ocean, "boreal": Boreal, "clouds": Clouds, "planet": Planet, "blackhole": BlackHole, "flight": Flight, "pond": Pond,
         "fire": Fire, "lava": Lava, "tunnel": Tunnel, "fractal": Fractal, "donut": Donut}   # these need numpy
if np is not None:
    SCENES.update(ENGINE_SCENES)
# Scene names from before the kit was translated: still accepted on the command line.
LEGACY_SCENES = {"cumbres": "peaks", "nevada": "snowfall", "velero": "sailboat", "peces": "fish", "tuberias": "pipes", "batalla": "battle",
                 "fogata": "campfire", "cerezo": "cherry", "lluvia": "rain", "galaxia": "galaxy", "nebulosa": "nebula", "hiperespacio": "hyperspace",
                 "oceano": "ocean", "nubes": "clouds", "planeta": "planet", "agujero": "blackhole", "vuelo": "flight", "estanque": "pond",
                 "fuego": "fire", "tunel": "tunnel", "dona": "donut"}


# ── Terminal output ─────────────────────────────────────────────────────────────────────────────────────────────────
class Screen:
    """Writes only the cells that changed between one frame and the next (no flicker)."""

    def __init__(self, real: bool):
        self.real, self.prev = real, None

    def _sgr(self, fg: RGB, bg: RGB) -> str:
        if self.real:
            return f"\x1b[38;2;{fg[0]};{fg[1]};{fg[2]};48;2;{bg[0]};{bg[1]};{bg[2]}m"
        return f"\x1b[38;5;{to256(fg)};48;5;{to256(bg)}m"

    def paint(self, L: Canvas) -> None:
        out, prev, last = [], self.prev, None
        if prev is not None and (prev.w, prev.h) != (L.w, L.h):
            prev = None
        for y in range(L.h):
            ch, fg, bg = L.ch[y], L.fg[y], L.bg[y]
            x = 0
            while x < L.w:
                if prev is not None and prev.ch[y][x] == ch[x] and prev.bg[y][x] == bg[x] and (ch[x] == " " or prev.fg[y][x] == fg[x]):
                    x += 1
                    continue
                out.append(f"\x1b[{y + 1};{x + 1}H")
                while x < L.w and not (prev is not None and prev.ch[y][x] == ch[x] and prev.bg[y][x] == bg[x] and (ch[x] == " " or prev.fg[y][x] == fg[x])):
                    pair = (fg[x], bg[x])
                    if pair != last:
                        out.append(self._sgr(*pair))
                        last = pair
                    out.append(ch[x])
                    x += 1
        self.prev = L
        if out:
            sys.stdout.write("".join(out))
            sys.stdout.flush()


def term_size() -> tuple[int, int]:
    try:
        w, h = int(os.environ.get("COLUMNS", 0)), int(os.environ.get("LINES", 0))
    except ValueError:
        w = h = 0
    if not (w and h):
        w, h = shutil.get_terminal_size((100, 30))
    return max(60, w), max(20, h)


def main() -> int:
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    a[0] = LEGACY_SCENES.get(a[0], a[0])
    if a[0] == "--list":
        print("\n".join(SCENES))
        return 0
    if a[0] == "--all":                                    # also the ones that need numpy, even if it is missing
        print("\n".join({**SCENES, **ENGINE_SCENES}))
        return 0
    if a[0] in ENGINE_SCENES and np is None:                          # no numpy: warn and show a classic scene
        print(f"tmux-art: «{a[0]}» uses the shading engine and numpy is missing (sudo apt install python3-numpy); showing another scene", file=sys.stderr)
        a[0] = "aurora"
    if a[0] not in SCENES:
        print(f"tmux-art: unknown scene «{a[0]}» (available: {', '.join(SCENES)})", file=sys.stderr)
        return 2
    mode = a[1] if len(a) > 1 else ""
    n = int(a[2]) if len(a) > 2 and a[2].isdigit() else 20
    rng = random.Random(int(os.environ["WS_ART_SEED"])) if os.environ.get("WS_ART_SEED", "").isdigit() else random.Random()
    w, h = term_size()
    scene = SCENES[a[0]](w, h, rng)
    if mode == "--text":
        for i in range(n + 1):                               # scenes with memory (pipes, battle) advance frame by frame
            L = scene.frame(i * 0.12)
        print("\n".join("".join(f).rstrip() for f in L.ch))
        return 0
    color = os.environ.get("WS_ART_COLOR") or ("24" if os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit") else "256")
    screen = Screen(color == "24")
    test = mode == "--test"
    fd, old = None, None
    if not test and sys.stdin.isatty():
        import termios
        import tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)

    def leave(*_):
        sys.stdout.write("\x1b[0m\x1b[2J\x1b[H\x1b[?25h")
        sys.stdout.flush()
        if old is not None:
            import termios
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.exit(0)

    resized = [False]
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, leave)
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__(0, True))
    sys.stdout.write("\x1b[?25l\x1b[0m\x1b[2J")
    t0, i = time.monotonic(), 0
    try:
        while True:
            if resized[0]:                                    # the window was resized: build it again
                resized[0] = False
                os.environ.pop("COLUMNS", None)
                os.environ.pop("LINES", None)
                w, h = term_size()
                scene, screen.prev = SCENES[a[0]](w, h, rng), None
                sys.stdout.write("\x1b[0m\x1b[2J")
            screen.paint(scene.frame(i * 0.12 if test else time.monotonic() - t0))
            i += 1
            if test:
                if i >= n:
                    break
            elif fd is not None:
                if select.select([fd], [], [], 0.07)[0]:
                    os.read(fd, 64)
                    break
            else:
                time.sleep(0.07)
    finally:
        if not test:
            leave()
    sys.stdout.write("\x1b[0m\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
