#!/usr/bin/env bash
#
# tmux-pwsh — PowerShell popup in the tab's folder: PowerShell 7 (pwsh.exe) if it is
# installed on Windows; otherwise Windows PowerShell 5.1 (powershell.exe).
dir="$(tmux display -p '#{pane_current_path}')"
cd "$dir" 2>/dev/null || cd "$HOME" || exit 1
if command -v pwsh.exe >/dev/null; then exec pwsh.exe -NoLogo; else exec powershell.exe -NoLogo; fi
