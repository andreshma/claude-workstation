#!/usr/bin/env python3
"""tmux-palette — command palette: find and run any menu option by typing, like Ctrl+Shift+P
in VS Code. Ctrl+b Space.

Reads the installed menus (~/.config/tmux-claude/menu*.tmux, with the same parser as ws-menus), so it is
always up to date. Shows the key path so you learn it (Ctrl+b m → e → t). Enter runs the option
on the tab from which you opened the palette.
Usage: tmux-palette <pane>   ·   tmux-palette --list   (only prints «path<TAB>option<TAB>command»; for tests)
"""
import importlib.machinery
import importlib.util
import os
import re
import shutil
import subprocess  # nosec B404 — fzf and tmux with fixed arguments
import sys
import tempfile
from pathlib import Path

BIN = Path.home() / ".local/bin"


def load_ws_menus():
    loader = importlib.machinery.SourceFileLoader("ws_menus", str(BIN / "ws-menus"))
    spec = importlib.util.spec_from_loader("ws_menus", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def options() -> list[tuple[str, str, str]]:
    """[(key path, readable label, tmux command)] of every final option (no submenus)."""
    wm = load_ws_menus()
    pre = "Ctrl+b"
    rows, seen = [], set()

    def visit(f: Path, path: str):
        if f in seen or not f.exists():
            return
        seen.add(f)
        for _, label, key, cmd in wm.items(f):
            if label.strip().startswith("‹"):
                continue
            step = f"{path} → {wm.readable_key(key)}"
            if cmd.strip().startswith("source-file") and "menu" in cmd:
                m = re.search(r"(menu[\w-]*\.tmux)", cmd)
                if m:
                    visit(wm.DIR / m.group(1), step)
                continue
            rows.append((step, wm.readable(label), cmd))

    visit(wm.DIR / "menu.tmux", f"{pre} m")
    for f in sorted(wm.DIR.glob("menu*.tmux")):
        visit(f, f"({f.stem})")
    return rows


def main() -> int:
    rows = options()
    if "--list" in sys.argv:
        for r, e, c in rows:
            print(f"{r}\t{e}\t{c}")
        return 0
    if not shutil.which("fzf"):
        print("fzf is missing (ws-tools install fzf)."); return 1
    fzf_input = "\n".join(f"{i}\t{e}\t\033[2m{r}\033[0m" for i, (r, e, _) in enumerate(rows))
    sel = subprocess.run(["fzf", "--ansi", "--delimiter=\t", "--with-nth=2,3", "--reverse", "--tiebreak=begin,length",
                          "--prompt", "› ", "--header", "Type what you want to do · Enter runs · Esc closes"],
                         input=fzf_input, capture_output=True, text=True).stdout.strip()  # nosec B603 B607
    if not sel:
        return 0
    cmd = rows[int(sel.split("\t", 1)[0])][2].replace('\\"', '"')
    # Same as display-menu: the #{formats} in the command expand against the tab from which you opened the
    # palette; it runs once the popup has closed (so «the current tab» is that one too).
    pane = next((a for a in sys.argv[1:] if a.startswith("%")), "")
    if pane:
        cmd = subprocess.run(["tmux", "display", "-p", "-t", pane, cmd], capture_output=True, text=True).stdout.rstrip("\n") or cmd  # nosec B603 B607
    fd, tmp = tempfile.mkstemp(prefix="tmux-palette-", suffix=".tmux")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(cmd + "\n")
    subprocess.run(["tmux", "run-shell", "-b", "-d", "0.3", f"tmux source-file '{tmp}'; rm -f '{tmp}'"])  # nosec B603 B607
    return 0


if __name__ == "__main__":
    sys.exit(main())
