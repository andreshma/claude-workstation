#!/usr/bin/env bash
#
# tmux-status — paints each tab's Claude state with its time: what you see in the status bar, the dashboard
# (Ctrl+b D), the summary (Ctrl+b i), the menus and Telegram. The hooks (tmux-state.sh) say WHAT is happening and
# SINCE WHEN; this script turns it into text and refreshes it with the bar (tmux-background calls it on every refresh).
#
#   🧠 thinking 42s · 🔧 Bash 2m · ✋ approve Bash 5m · ❓ asking you 1m · 📦 compacting · 🐝 3 agents 4m
#   ✔ done 12m ago · ⏳ stalled 11m · ⛔ interrupted · ✖ API error
#
# Window options it READS (written by tmux-state.sh):
#   @cphase  thinking|tool|permission|question|yourturn|compacting|done|error|interrupted
#   @csince  epoch of the phase start · @cdet detail («Bash: npm test») · @cturn epoch of the prompt
#   @csub    active subagents · @cts epoch of the last event · @cpane Claude's pane
# And WRITES: @cs (text with time), @csc (colour), @cturn_txt (turn duration), @cphase=interrupted if
# «Interrupted» shows on screen after 20 s without events (Esc fires no hook).
# Stalled: @cwatch_stall minutes (10) without events while thinking or running a tool.
# Usage: tmux-status --paint <window>   ·   tmux-status --all   ·   tmux-status --dur <seconds>
set -uo pipefail

dur() {   # seconds → 42s · 7m · 1h05
  local s="${1:-0}"; (( s < 0 )) && s=0
  if (( s < 60 )); then printf '%ss' "$s"; elif (( s < 3600 )); then printf '%sm' $((s / 60)); else printf '%sh%02d' $((s / 3600)) $((s % 3600 / 60)); fi
}
tcolor() { local v; v="$(tmux show -gqv "@t_$1" 2>/dev/null)"; printf '%s' "${v:-$2}"; }

paint() {   # window
  local w="$1" phase since det sub cts turn pane now e txt col stall cs0 csc0 tt0
  # TAB separator with «-» in the empty ones: tmux 3.4 escapes control characters (\x1f) in «display -p» and
  # «read» collapses consecutive tabs (an empty field shifted the rest).
  local o fmt=""
  for o in @cphase @csince @cdet @csub @cts @cturn @cpane @cs @csc @cturn_txt; do fmt+="#{?#{${o}},#{${o}},-}"$'\t'; done
  IFS=$'\t' read -r phase since det sub cts turn pane cs0 csc0 tt0 < <(tmux display -p -t "$w" "$fmt" 2>/dev/null) || return 0
  for o in phase since det sub cts turn pane cs0 csc0 tt0; do [[ "${!o}" == - ]] && printf -v "$o" ''; done
  [[ -n "$phase" ]] || return 0
  now=$(date +%s); e=$(( now - ${since:-$now} ))
  stall="$(tmux show -gqv @cwatch_stall 2>/dev/null)"; stall=$(( ${stall:-10} * 60 ))

  # Self-correction: not everything fires a hook (Esc, permission denied, leaving Claude, a lost event), so
  # after 15 s without events it is checked against what is on screen and the state does not get stuck.
  if [[ -n "$pane" ]] && { [[ -z "$cts" ]] || (( now - cts > 15 )); }; then
    local cmd vis working=0 dialog=0 new=""
    cmd="$(tmux display -p -t "$pane" '#{pane_current_command}' 2>/dev/null)"
    if [[ -z "$cmd" || "$cmd" =~ ^(bash|zsh|fish|sh|dash)$ ]]; then
      # Claude no longer runs in that pane (it exited or closed): clear the state.
      for o in @cs @csc @cphase @csince @cdet @cturn @cturn_txt @csub; do tmux set -wu -t "$w" "$o" 2>/dev/null; done
      return 0
    fi
    vis="$(tmux capture-pane -p -t "$pane" 2>/dev/null)"
    grep -qi 'esc to interrupt' <<<"$vis" && working=1
    grep -qE '^[[:space:]│]*❯[[:space:]]*[0-9]+\.' <<<"$vis" && dialog=1
    case "$phase" in
      thinking|tool|compacting)
        if (( !working && !dialog )); then
          if grep -q 'Interrupted' <<<"$vis"; then new=interrupted; else new="done"; fi
        fi ;;
      permission|question) (( dialog )) || { (( working )) && new=thinking || new="done"; } ;;
      "done"|interrupted|error|yourturn) (( working )) && new=thinking ;;
    esac
    if [[ -n "$new" ]]; then
      tmux set -w -t "$w" @cphase "$new" \; set -w -t "$w" @csince "${cts:-$now}" 2>/dev/null
      [[ "$new" == "done" || "$new" == interrupted ]] && tmux set -wu -t "$w" @cturn 2>/dev/null
      phase="$new"; e=$(( now - ${cts:-$now} ))
    fi
  fi

  case "$phase" in
    permission)  txt="✋ approve${det:+ ${det%%:*}} $(dur "$e")"; col="$(tcolor alert colour196)" ;;
    question)    txt="❓ asking you $(dur "$e")"; col="$(tcolor alert colour196)" ;;
    yourturn)    txt="👉 waiting for you $(dur "$e")"; col="$(tcolor alert colour196)" ;;
    error)       txt="✖ API error"; col="$(tcolor alert colour196)" ;;
    compacting)  txt="📦 compacting $(dur "$e")"; col="$(tcolor think colour39)" ;;
    interrupted) txt="⛔ interrupted"; (( e >= 60 )) && txt+=" $(dur "$e") ago"; col="$(tcolor tool colour214)" ;;
    "done")      txt="✔ done"; (( e >= 60 )) && txt+=" $(dur "$e") ago"; col="$(tcolor ok colour82)" ;;
    thinking|tool)
      if [[ -n "$cts" ]] && (( now - cts > stall )); then
        txt="⏳ stalled $(dur $(( now - cts )))"; col="$(tcolor tool colour214)"
      elif [[ -n "$sub" && "$sub" != 0 ]]; then
        txt="🐝 $sub agent$([[ "$sub" == 1 ]] || echo s) $(dur $(( now - ${turn:-$since} )))"; col="$(tcolor agent colour177)"
      elif [[ "$phase" == tool ]]; then
        txt="🔧 $(cut -c1-14 <<<"${det%%:*}") $(dur "$e")"; col="$(tcolor tool colour214)"
      else
        txt="🧠 thinking $(dur "$e")"; col="$(tcolor think colour39)"
      fi ;;
    *) return 0 ;;
  esac
  # Only what changed is written: every write redraws the bar (and makes an open menu flicker).
  [[ "$txt" == "$cs0" ]] || tmux set -w -t "$w" @cs "$txt" 2>/dev/null
  [[ "$col" == "$csc0" ]] || tmux set -w -t "$w" @csc "$col" 2>/dev/null
  if [[ -n "$turn" ]]; then
    local tt; tt="$(dur $(( now - turn )))"
    [[ "$tt" == "$tt0" ]] || tmux set -w -t "$w" @cturn_txt "$tt" 2>/dev/null
  fi
}

case "${1:-}" in
  --paint) paint "${2:?window}" ;;
  --all)  while read -r w; do paint "$w"; done < <(tmux list-windows -a -F '#{window_id}' 2>/dev/null | sort -u) ;;
  --dur)    dur "${2:-0}"; echo ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
exit 0
