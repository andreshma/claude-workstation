#!/usr/bin/env bash
#
# tmux-etiqueta — per-tab status label (blocked, in review, ready…) visible in the status bar and in the
# dashboard (Ctrl+b D). Ctrl+b E opens the picker.
# Usage: tmux-etiqueta --menu <window>     picker (used by Ctrl+b E)
#      tmux-etiqueta <window> <text>       sets the label · tmux-etiqueta <window> quitar
#      tmux-etiqueta --barra               adds the label to the status bar formats (idempotent; called by
#                                          .tmux.conf on load and by tmux-theme on theme change)
set -uo pipefail
ETQ='#{?@etq, #{@etq},}'
case "${1:-}" in
  --barra)
    for o in window-status-format window-status-current-format; do
      v="$(tmux show -gv "$o" 2>/dev/null)"
      [[ "$v" == *"@etq"* ]] || tmux set -ag "$o" "$ETQ"
    done; exit 0 ;;
  --menu)
    w="${2:?window}"; m="$0"
    tmux display-menu -T "#[align=centre] Tab label " -x W -y S \
      "🔴 Blocked"              b "run-shell \"'$m' '$w' '🔴bloq'\"" \
      "🟡 In review"            r "run-shell \"'$m' '$w' '🟡rev'\"" \
      "🔵 Waiting on someone"   e "run-shell \"'$m' '$w' '🔵esp'\"" \
      "🧪 Testing"              p "run-shell \"'$m' '$w' '🧪prue'\"" \
      "🟢 Ready"                l "run-shell \"'$m' '$w' '🟢lista'\"" \
      "" \
      "Remove label"            q "run-shell \"'$m' '$w' quitar\""
    exit 0 ;;
esac
w="${1:?window}"; t="${2:?text}"
if [[ "$t" == quitar ]]; then tmux set -wu -t "$w" @etq
else tmux set -w -t "$w" @etq "${t:0:16}"; fi
"$0" --barra
