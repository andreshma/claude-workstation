#!/usr/bin/env bash
#
# tmux-etiqueta — etiqueta de estado por pestaña (bloqueada, en revisión, lista…) visible en la barra y en el
# tablero (Ctrl+b D). Ctrl+b E abre el selector.
# Uso: tmux-etiqueta --menu <ventana>      selector (lo usa Ctrl+b E)
#      tmux-etiqueta <ventana> <texto>     pone la etiqueta · tmux-etiqueta <ventana> quitar
#      tmux-etiqueta --barra               agrega la etiqueta a los formatos de la barra (idempotente; lo llama
#                                          .tmux.conf al cargar y tmux-theme al cambiar de tema)
set -uo pipefail
ETQ='#{?@etq, #{@etq},}'
case "${1:-}" in
  --barra)
    for o in window-status-format window-status-current-format; do
      v="$(tmux show -gv "$o" 2>/dev/null)"
      [[ "$v" == *"@etq"* ]] || tmux set -ag "$o" "$ETQ"
    done; exit 0 ;;
  --menu)
    w="${2:?ventana}"; m="$0"
    tmux display-menu -T "#[align=centre] Etiqueta de la pestaña " -x W -y S \
      "🔴 Bloqueada"            b "run-shell \"'$m' '$w' '🔴bloq'\"" \
      "🟡 En revisión"          r "run-shell \"'$m' '$w' '🟡rev'\"" \
      "🔵 Esperando a alguien"  e "run-shell \"'$m' '$w' '🔵esp'\"" \
      "🧪 Pruebas"              p "run-shell \"'$m' '$w' '🧪prue'\"" \
      "🟢 Lista"                l "run-shell \"'$m' '$w' '🟢lista'\"" \
      "" \
      "Quitar etiqueta"         q "run-shell \"'$m' '$w' quitar\""
    exit 0 ;;
esac
w="${1:?ventana}"; t="${2:?texto}"
if [[ "$t" == quitar ]]; then tmux set -wu -t "$w" @etq
else tmux set -w -t "$w" @etq "${t:0:16}"; fi
"$0" --barra
