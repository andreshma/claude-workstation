#!/usr/bin/env bash
#
# tmux-ux — estilo de menús y ventanas flotantes (bordes redondeados, colores) y la segunda línea del monitor.
# Lo carga ~/.config/tmux-claude/ux.tmux al arrancar o recargar. Cada opción se prueba por separado: con una tmux
# que no la conoce (< 3.3/3.4) simplemente se omite.
set -uo pipefail
while IFS='|' read -r o v; do
  [[ -n "$o" ]] && tmux set -g "$o" "$v" 2>/dev/null
done <<'OPC'
menu-style|bg=colour236,fg=colour252
menu-selected-style|bg=colour31,fg=colour231,bold
menu-border-style|fg=colour31
menu-border-lines|rounded
popup-border-style|fg=colour31
popup-border-lines|rounded
OPC
tmux set -g status-format[1] '#[align=left] #(~/.local/bin/tmux-hud)' 2>/dev/null
[[ "$(tmux show -gqv @hud)" == off ]] || tmux set -g status 2
exit 0
