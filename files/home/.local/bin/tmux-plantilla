#!/usr/bin/env bash
#
# tmux-plantilla — opens a folder with a ready-made pane layout (Claude + live tests + logs + git…),
# or saves the current tab as a template. Menu → T (open) · Menu → Session → G (save).
#
# Templates: ~/.config/tmux-claude/plantillas/<name>.conf, one instruction per line:
#   # description (the first comment line is shown when picking)
#   claude                      the main pane starts Claude
#   derecha 35% <command>       pane on the right with that % of width
#   abajo 30% <command>         pane below with that % of height
#   ventana <name> <command>    extra tab in the same folder (e.g. ventana git lazygit)
#   acomodo <layout>            exact tmux layout (written by «--guardar»)
# The commands are typed into the pane and run with Enter: if they fail, the pane stays at the shell.
# Usage: tmux-plantilla [name] [folder]    (no name: fzf picker; no folder: the current pane's)
#      tmux-plantilla --guardar <name> <window>        saves the tab as a template
#      tmux-plantilla --lista                          names and descriptions
set -uo pipefail
D="$HOME/.config/tmux-claude/plantillas"; mkdir -p "$D"
TAB=$'\t'

lista() { local f; for f in "$D"/*.conf; do [[ -f "$f" ]] || continue
  printf '%s\t%s\n' "$(basename "$f" .conf)" "$(grep -m1 '^#' "$f" | sed 's/^#[[:space:]]*//')"; done; }

if [[ "${1:-}" == --lista ]]; then lista; exit 0; fi

if [[ "${1:-}" == --guardar ]]; then
  # The menu sends: --guardar <name as you typed it> <window id>. A name with spaces arrives split into several
  # words: the window is always the last argument shaped like an id (@N) and the rest is the name.
  shift; w=""
  if (( $# )) && [[ "${!#}" == @* ]]; then w="${!#}"; set -- "${@:1:$#-1}"; fi
  nom="$*"; w="${w:-$(tmux display -p '#{window_id}')}"
  [[ "$nom" =~ ^[A-Za-z0-9_-]+$ ]] || { tmux display -d 5000 "Template: the name takes only letters, digits, - and _ (no spaces)"; exit 1; }
  f="$D/$nom.conf"; [[ -f "$f" ]] && cp "$f" "$f.bak.$(date +%Y%m%d-%H%M%S)"
  {
    echo "# $nom (saved from «$(tmux display -p -t "$w" '#{window_name}')» on $(date +%F))"
    first=1
    while IFS="$TAB" read -r pid pc; do
      args="$(ps -o args= --ppid "$pid" 2>/dev/null | head -1)"; [[ -n "$args" ]] || args="$pc"
      [[ "$pc" =~ ^(bash|zsh|fish|sh)$ ]] && args=""
      if (( first )); then [[ "$args" == *claude* ]] && echo "claude" || { [[ -n "$args" ]] && echo "principal $args"; }; first=0
      else echo "derecha 50% $args"; fi
    done < <(tmux list-panes -t "$w" -F "#{pane_pid}${TAB}#{pane_current_command}")
    echo "acomodo $(tmux display -p -t "$w" '#{window_layout}')"
  } > "$f"
  echo "Template saved: $f"; cat "$f"; exit 0
fi

nom="${1:-}"; dir="${2:-$(tmux display -p '#{pane_current_path}' 2>/dev/null || pwd)}"
if [[ -z "$nom" ]]; then
  sel="$(lista | fzf --delimiter="$TAB" --with-nth=1,2 --reverse --prompt 'template> ' --header "Open $(basename "$dir") with…" \
         --preview "cat '$D'/{1}.conf")" || exit 0
  nom="${sel%%"$TAB"*}"
fi
f="$D/$nom.conf"; [[ -f "$f" ]] || { echo "Template $nom does not exist"; exit 1; }

w="$(tmux new-window -P -F '#{window_id}' -c "$dir" -n "$(basename "$dir")")"
principal="$(tmux display -p -t "$w" '#{pane_id}')"
correr() { [[ -n "$2" ]] && tmux send-keys -t "$1" -l -- "$2" && tmux send-keys -t "$1" Enter; }
acomodo=""
while IFS= read -r l || [[ -n "$l" ]]; do
  l="${l%%$'\r'}"; [[ -z "${l// /}" || "$l" == \#* ]] && continue
  read -r inst resto <<<"$l"
  case "$inst" in
    claude) correr "$principal" "claude" ;;
    principal) correr "$principal" "$resto" ;;
    derecha|abajo)
      read -r pct cmd <<<"$resto"; [[ "$pct" =~ ^[0-9]+%$ ]] || { cmd="$resto"; pct=50%; }
      flag=-h; [[ "$inst" == abajo ]] && flag=-v
      p="$(tmux split-window "$flag" -l "$pct" -t "$principal" -c "$dir" -d -P -F '#{pane_id}')"
      correr "$p" "$cmd" ;;
    ventana)
      read -r vn cmd <<<"$resto"
      v="$(tmux new-window -d -P -F '#{pane_id}' -c "$dir" -n "$vn")"; correr "$v" "$cmd" ;;
    acomodo) acomodo="$resto" ;;
    *) tmux display "Template $nom: unknown instruction «$inst»" ;;
  esac
done < "$f"
[[ -n "$acomodo" ]] && tmux select-layout -t "$w" "$acomodo" 2>/dev/null
tmux select-pane -t "$principal"; tmux select-window -t "$w"
