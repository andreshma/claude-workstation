#!/usr/bin/env bash
#
# ws-test — behavior tests of the whole workstation (tmux + Claude + extensions).
#
# Usage:
#   ws-test            DETERMINISTIC tests: isolated HOME, tmux and Claude (Claude and the API are
#                      simulated). They do not touch your session, your tabs or your accounts, or spend usage.
#   ws-test --ia       also, NON-DETERMINISTIC tests with the real Claude and API (they spend a little
#                      usage; tolerant: they retry and validate by pattern, not by exact text).
#   ws-test --lista    lists the tests
# Exits with 1 if any deterministic test fails. The --ia ones only warn.
set -uo pipefail
IA=0
case "${1:-}" in --ia) IA=1 ;; --lista) grep -E '^prueba_[a-z_]+\(\)' "$0" | sed 's/() {.*//; s/^prueba_/  /'; exit 0 ;; esac

OK=0 FA=0 AV=0
ok()    { printf '  \e[32mok\e[0m     %s\n' "$1"; OK=$((OK + 1)); }
falla() { printf '  \e[31mFAIL\e[0m   %s\n' "$1"; FA=$((FA + 1)); }
aviso() { printf '  \e[33mwarn\e[0m   %s\n' "$1"; AV=$((AV + 1)); }
seccion() { printf '\n\e[1m== %s\e[0m\n' "$1"; }
chk() { local d="$1"; shift; if "$@" >/dev/null 2>&1; then ok "$d"; else falla "$d"; fi; }

RH="$HOME"                           # real home (only READ, to copy what is installed)
unset TMUX TMUX_PANE                 # no tmux of these tests may be able to talk to your real session
T="$(mktemp -d)"; TH="$T/home"; FB="$T/fakebin"
# Each test uses its own socket directory: a server that is shutting down does not get in the way of the next one.
SOCK=base
socket_de() { SOCK="$1"; mkdir -p "$T/s/$SOCK"; }
cleanup() {
  local d; for d in "$T"/s/*/; do [[ -d "$d" ]] || continue
    # -S with the exact path of the test socket and without TMUX: with TMUX set (running inside
    # tmux), "tmux kill-server" points at the REAL server and used to close all your tabs.
    for sock in "$d"tmux-*/default "$d"tmux-*/flot; do
      [[ -S "$sock" ]] && env -u TMUX tmux -S "$sock" kill-server 2>/dev/null
    done; done
  rm -rf "$T"
}
trap cleanup EXIT

#######################################
# Isolated environment: copy of what is installed + simulated Claude and ant (API).
#######################################
preparar() {
  mkdir -p "$TH/.local/bin" "$TH/.config" "$TH/.local/share" "$FB/versions" "$T/s" "$T/dest" "$T/repos"
  cp -a "$RH/.local/bin/." "$TH/.local/bin/" 2>/dev/null
  rm -f "$TH/.local/bin/claude" "$TH/.local/bin/ant"   # neither the real Claude nor your API session in these tests
  for d in tmux-claude claude-solo ws-telemetria; do [[ -d "$RH/.config/$d" ]] && cp -a "$RH/.config/$d" "$TH/.config/"; done
  rm -f "$TH/.config/tmux-claude/sin-ble"
  [[ -f "$RH/.tmux.conf" ]] && cp "$RH/.tmux.conf" "$TH/.tmux.conf"
  [[ -f "$RH/.blerc" ]] && cp "$RH/.blerc" "$TH/.blerc"
  [[ -d "$RH/.local/share/blesh" ]] && ln -s "$RH/.local/share/blesh" "$TH/.local/share/blesh"
  mkdir -p "$TH/.tmux/plugins"
  [[ -d "$RH/.tmux/plugins/tmux-resurrect" ]] && cp -a "$RH/.tmux/plugins/tmux-resurrect" "$TH/.tmux/plugins/"
  # Test Claude data (conversations, saved tmux) for backup/restore.
  mkdir -p "$TH/.claude/projects/-repo/s1/subagents" "$TH/.claude/todos" "$TH/.local/share/tmux/resurrect"
  for i in 1 2; do printf '{"type":"user","n":%d}\n' "$i" > "$TH/.claude/projects/-repo/c$i.jsonl"; done
  echo '{"a":1}' > "$TH/.claude/projects/-repo/s1/subagents/agent-1.jsonl"
  echo '{}' > "$TH/.claude/settings.json"; echo SECRET > "$TH/.claude/.credentials.json"
  echo '{"hasCompletedOnboarding":true,"mcpServers":{}}' > "$TH/.claude.json"

  # Simulated Claude, named after its version like the native binary (e.g. 2.1.999).
  cat > "$FB/versions/2.1.999" <<'EOF'
#!/bin/bash
# --version and any non-interactive use answer and exit: only "wait for /exit" in a pane.
[[ "${1:-}" == --version ]] && { echo "2.1.999 (Claude Code)"; exit 0; }
if [[ "${1:-}" == auth && "${2:-}" == status ]]; then
  if [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then echo "Organization: ${ORG_PERSONAL:-Personal Org}"; else echo "Organization: Company"; fi
  echo "Email: test@example.com"; exit 0
fi
if [[ " $* " == *" -p "* ]]; then cat >/dev/null; echo "ls -la"; exit 0; fi
[[ -t 0 ]] || exit 0
echo "cfg=${CLAUDE_CONFIG_DIR:-trabajo} args=$*" >> "$WST_LOG"
while IFS= read -r l; do [[ "$l" == *"/exit" ]] && exit 0; done
EOF
  chmod +x "$FB/versions/2.1.999"; ln -s "$FB/versions/2.1.999" "$FB/claude"
  # Simulated API (ant): returns the typed text + "pods -A" and its token usage.
  cat > "$FB/ant" <<'EOF'
#!/bin/bash
b="$(cat)"; t="$(jq -r '.messages[0].content' <<<"$b" | sed -n 's/^Typed text: //p')"
printf '{"content":[{"type":"text","text":"%spods -A"}],"usage":{"input_tokens":120,"output_tokens":8}}\n' "$t"
EOF
  # Simulated copilot session (only the file exists; there are never real credentials).
  mkdir -p "$TH/.config/anthropic-copiloto/credentials"; echo '{}' > "$TH/.config/anthropic-copiloto/credentials/default.json"
  chmod +x "$FB/ant"
}

# Variables of the isolated environment for each test command.
E() { env -u TMUX -u CLAUDE_CONFIG_DIR HOME="$TH" TMUX_TMPDIR="$T/s/$SOCK" PATH="$TH/.local/bin:$FB:/usr/bin:/bin" \
      TERM=xterm-256color WST_LOG="$T/claude.log" WS_TELEMETRIA_WIN="$T/win" WS_BACKUP_DEST="$T/dest" WS_BACKUP_LOCK="$T/backup.lock" WS_BACKUP_MIN_GB=0 WS_RECUPERAR_ESPERA=3 "$@"; }
tm() { E tmux "$@"; }
existe() { [[ -x "$TH/.local/bin/$1" ]]; }

#######################################
# Deterministic tests
#######################################
prueba_configuracion() {
  socket_de configuracion
  seccion "tmux configuration and menus"
  local tmp; tmp="$(mktemp)"; grep -vE '^[[:space:]]*run(-shell)?\b' "$TH/.tmux.conf" > "$tmp"
  local r; r="$(tm -f /dev/null new-session -d -s carga \; source-file "$tmp" 2>&1)"
  [[ -z "$r" ]] && ok ".tmux.conf loads without errors" || falla ".tmux.conf: $r"
  local m
  for m in "$TH"/.config/tmux-claude/menu*.tmux; do
    [[ -f "$m" ]] || continue
    r="$(tm source-file -n "$m" 2>&1)"; [[ -z "$r" ]] && ok "${m##*/}" || falla "${m##*/}: $r"
  done
  tm kill-server 2>/dev/null; rm -f "$tmp"
}

# panel_con_claude — dev session with a pane running the simulated Claude; prints the pane id.
panel_con_claude() {
  tm -f /dev/null new-session -d -s dev -n "${1:-repo}" -c "$T/repos" "bash --norc"; sleep 0.5
  local p; p="$(tm display -p -t dev: '#{pane_id}')"
  tm send-keys -t "$p" "export PATH='$TH/.local/bin:$FB:/usr/bin:/bin' WST_LOG='$T/claude.log'; claude" Enter; sleep 1
  echo "$p"
}

prueba_modo_solo() {
  socket_de modo_solo
  seccion "Solo mode"
  existe tmux-solo || { aviso "tmux-solo is not installed"; return; }
  : > "$T/claude.log"; local p; p="$(panel_con_claude api)"
  E tmux-solo esta "$p" >/dev/null 2>&1; sleep 2
  [[ "$(tm show -wqv -t dev: @csolo)" == 1 ]] && ok "switching to solo mode marks the tab" || falla "solo mode: no @csolo mark"
  tail -1 "$T/claude.log" | grep -q -- '-c --permission-mode auto --settings' && ok "reopens Claude in auto without sandbox, resuming the conversation" || falla "solo mode: Claude was not reopened with the flags ($(tail -1 "$T/claude.log"))"
  E tmux-solo normal "$p" >/dev/null 2>&1; sleep 2
  [[ -z "$(tm show -wqv -t dev: @csolo)" ]] && tail -1 "$T/claude.log" | grep -q 'args=-c$' && ok "going back to normal resumes with the sandbox" || falla "going back to normal"
  git -C "$T/repos" init -q -b main 2>/dev/null; git -C "$T/repos" -c user.email=t@t -c user.name=t -c core.hooksPath=/dev/null commit -q --allow-empty -m "chore: test repo"
  E tmux-solo worktree "$T/repos" >/dev/null 2>&1; sleep 1
  ls -d "$T"/repos.wt/solo-* >/dev/null 2>&1 && ok "worktree solo/<date> created" || falla "solo mode worktree"
  tm kill-server 2>/dev/null
}

prueba_cuentas() {
  socket_de cuentas
  seccion "Claude accounts"
  existe claude-cuenta || { aviso "claude-cuenta is not installed"; return; }
  E claude-cuenta setup >/dev/null 2>&1
  [[ -L "$TH/.claude-personal/projects" && ! -e "$TH/.claude-personal/.credentials.json" ]] \
    && ok "personal shares conversations and NOT credentials" || falla "personal account setup"
  jq -e '.hasCompletedOnboarding' "$TH/.claude-personal/.claude.json" >/dev/null 2>&1 && ok "personal gets the startup state (no login screen)" || falla "personal without the startup state"
  echo x > "$TH/.claude-personal/.credentials.json"
  : > "$T/claude.log"; local p; p="$(panel_con_claude api)"
  E claude-cuenta pestaña "$p" >/dev/null 2>&1; sleep 2
  tail -1 "$T/claude.log" | grep -q "cfg=$TH/.claude-personal args=-c" && ok "switching to personal reopens the same conversation with its login" || falla "switch to personal ($(tail -1 "$T/claude.log"))"
  E claude-cuenta pestaña "$p" >/dev/null 2>&1; sleep 2
  tail -1 "$T/claude.log" | grep -q 'cfg=trabajo args=-c' && ok "back to the work account" || falla "going back to the work account"
  E ORG_PERSONAL=Company claude-cuenta pestaña "$p" >/dev/null 2>&1
  [[ "$(tm show -wqv -t dev: @ccuenta)" == trabajo ]] && ok "refuses if both accounts are in the same organization" || falla "organization safeguard"
  # Account per project: the shell that opens in the repo (or in one of its worktrees) takes the pinned account;
  # outside it, it does not.
  local pa="$T/proy-a" pb="$T/proy-b" cs="$TH/.config/tmux-claude/cuentas.sh"
  mkdir -p "$pa/src" "$pa.wt/branch" "$pb"; ( cd "$pa" && git init -q )
  E env -u TMUX claude-cuenta proyecto personal "$pa/src" >/dev/null 2>&1
  q() { ( cd "$1" && env -u CLAUDE_CONFIG_DIR ${2:+CLAUDE_CONFIG_DIR="$2"} HOME="$TH" bash -c ". '$cs'; echo \"\${CLAUDE_CONFIG_DIR:-trabajo}\"" ); }
  [[ "$(q "$pa/src")" == "$TH/.claude-personal" && "$(q "$pa.wt/branch")" == "$TH/.claude-personal" && "$(q "$pb")" == trabajo ]] \
    && ok "account per project: the repo and its worktrees open with its account; another project, with the default one" || falla "account per project: $(q "$pa/src") / $(q "$pa.wt/branch") / $(q "$pb")"
  E env -u TMUX claude-cuenta proyecto trabajo "$pb" >/dev/null 2>&1
  [[ "$(q "$pb" "$TH/.claude-personal")" == trabajo ]] && ok "the project's account wins over the one for new tabs" || falla "the pinned account did not win: $(q "$pb" "$TH/.claude-personal")"
  E env -u TMUX claude-cuenta proyecto quitar "$pa" >/dev/null 2>&1
  [[ "$(q "$pa/src")" == trabajo ]] && E env -u TMUX claude-cuenta proyectos | grep -q "trabajo *$pb" && ok "the pinned account can be removed and listed" || falla "removing or listing the pinned account"
  q="$(E claude-cuenta estado 2>/dev/null)"; grep -q 'personal: Organization: Personal Org' <<<"$q" && ok "claude-cuenta estado shows each organization" || falla "claude-cuenta estado"
  tm kill-server 2>/dev/null
}

prueba_persistencia() {
  socket_de persistencia
  seccion "Tab persistence"
  [[ -d "$TH/.tmux/plugins/tmux-resurrect" ]] && existe tmux-recuperar || { aviso "no tmux-resurrect or tmux-recuperar"; return; }
  local R="$TH/.local/share/tmux/resurrect" conf="$T/persist.conf"
  printf 'set -g @resurrect-dir "%s"\nrun-shell "~/.local/bin/tmux-recuperar --marcar-arranque"\nrun-shell "%s/.tmux/plugins/tmux-resurrect/resurrect.tmux"\nrun-shell -b "~/.local/bin/tmux-recuperar --auto-arranque"\n' "$R" "$TH" > "$conf"
  tm -f "$conf" new-session -d -s dev -n one -c /tmp; for n in two three; do tm new-window -t dev -n "$n" -c /tmp; done; sleep 1
  E "$TH/.tmux/plugins/tmux-resurrect/scripts/save.sh" quiet; sleep 1; tm kill-server; sleep 1
  tm -f "$conf" new-session -d -s dev -n empty -c /tmp; sleep 1
  local n0; n0="$(ls "$R"/tmux_resurrect_*.txt | wc -l)"
  existe tmux-save-now && { E tmux-save-now; [[ "$(ls "$R"/tmux_resurrect_*.txt | wc -l)" == "$n0" ]] && ok "does not save in the first minutes after starting" || falla "tmux-save-now overwrote the save at startup"; }
  E "$TH/.tmux/plugins/tmux-resurrect/scripts/save.sh" quiet; sleep 6     # empty "bad" save
  [[ "$(tm list-windows -t dev | wc -l)" -ge 3 ]] && ok "restores the tabs by itself if the session ended up empty" || falla "did not restore at startup ($(tm list-windows -t dev | wc -l) tabs)"
  tm kill-server 2>/dev/null
}

prueba_flotantes() {
  socket_de flotantes
  seccion "Interactive floating windows"
  existe tmux-flot-run || { aviso "tmux-flot-run is not installed"; return; }
  tm -f /dev/null new-session -d -s dev -n outside; local val; val="$(tm display -p '#{socket_path},#{pid},0')"
  # </dev/null: with the terminal as input, `timeout` leaves `script` in the background and the system
  # stops it when it touches the terminal (it did not even get to create its file).
  E timeout 20 script -qec "TMUX='$val' tmux-flot-run bash -c 'tmux display -p \"#S\" > $T/flot.out; echo \"cwd=\$PWD\" >> $T/flot.out'" "$T/flot.typescript" </dev/null >/dev/null 2>"$T/flot.err"
  grep -q '^dev$' "$T/flot.out" 2>/dev/null && ok "inside, the commands control the outer tmux" || falla "popup: it does not see the outer tmux"
  if grep -q '^cwd=' "$T/flot.out" 2>/dev/null; then ok "runs in its own tmux session (scroll, copy, search)"
  else falla "popup: the inner session did not run"; cat "$T/flot.err" "$T/flot.typescript" 2>/dev/null | tr -d '\r'  | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | grep -v '^$' | tail -4 | sed 's/^/           /'; fi
  local sin=0 m; local -a faltan=(); for m in "$TH"/.config/tmux-claude/menu*.tmux "$TH/.tmux.conf"; do [[ -f "$m" ]] || continue
    grep 'display-popup' "$m" | grep -v 'tmux -L\|tmux-flot-run\|tmux-scratch' | grep -q '\.local/bin/' && { sin=$((sin + 1)); faltan+=("${m##*/}"); }; done
  (( sin == 0 )) && ok "all the menus use interactive popups" || aviso "popups without tmux-flot-run in: ${faltan[*]}"
  tm kill-server 2>/dev/null
}

prueba_respaldo() {
  socket_de respaldo
  seccion "Backup and restore"
  existe ws-backup-lite && existe ws-restore-lite || { aviso "no ws-backup-lite"; return; }
  E timeout 300 ws-backup-lite --ahora </dev/null >/dev/null 2>&1 && ls "$T"/dest/claude-lite-*.tar.* >/dev/null 2>&1 && ok "backup created" || { falla "ws-backup-lite"; return; }
  local r; r="$(E timeout 120 ws-restore-lite --probar </dev/null 2>&1)"
  grep -q 'Can be restored' <<<"$r" && ok "the restore test passes" || falla "ws-restore-lite --probar"
  grep -q 'no credentials inside' <<<"$r" && ok "the backup carries no credentials" || falla "credentials in the backup"
}

prueba_protector() {
  socket_de protector
  seccion "Screensaver"
  existe tmux-saver || { aviso "tmux-saver is not installed"; return; }
  local s r malas=()
  if existe tmux-arte; then   # ASCII art: every scene draws without error, in two sizes and in 256 colours
    malas=()
    for s in $(E tmux-arte --lista); do
      r="$(COLUMNS=100 LINES=30 E timeout 60 tmux-saver --test "$s" 12 2>&1 >/dev/null)" && [[ -z "$r" ]] || malas+=("$s")
      r="$(COLUMNS=60 LINES=20 WS_ARTE_COLOR=256 E timeout 60 tmux-arte "$s" --test 4 2>&1 >/dev/null)" && [[ -z "$r" ]] || malas+=("$s-small")
      [[ "$(COLUMNS=100 LINES=30 E tmux-arte "$s" --texto 12 | grep -c '[^ ]')" -ge 12 ]] || malas+=("$s-empty")
      grep -q "\\[$s\\]=" "$TH/.local/bin/tmux-escena" || malas+=("$s-no-description")
    done
    mkdir -p "$T/gal-empty"   # gallery without images (or without chafa): falls back to an art scene, no error
    r="$(COLUMNS=80 LINES=24 WS_GALERIA="$T/gal-empty" E timeout 60 tmux-saver --test galeria 3 2>&1 | head -c 300 | wc -c)"; (( r > 0 )) || malas+=("galeria-no-fallback")
    if python3 -c 'import numpy' 2>/dev/null; then
      [[ "$(E tmux-arte --lista | wc -l)" == "$(E tmux-arte --todas | wc -l)" ]] || malas+=("engine-not-listed")
    else
      aviso "no numpy: the shading engine scenes are not tested (sudo apt install python3-numpy)"
      r="$(COLUMNS=80 LINES=24 E tmux-arte oceano --test 2 2>&1 >/dev/null)"; [[ "$r" == *numpy* ]] || malas+=("engine-no-warning")
    fi
    (( ${#malas[@]} == 0 )) && ok "ASCII art: every scene draws, also on a small screen and in 256 colours" || falla "ASCII art with errors: ${malas[*]}"
    # The menu reads the list from tmux-saver: it has to name the same scenes as tmux-arte, and no retired one.
    r="$(diff <(sed -n 's/^ESCENAS=(aleatoria galeria \(.*\))$/\1/p' "$TH/.local/bin/tmux-saver" | tr ' ' '\n' | sort) <(E tmux-arte --todas | sort))"
    [[ -z "$r" ]] && ok "the scene menu and tmux-arte name the same scenes" || falla "scenes out of sync: $r"
    printf 'escena=invasion\n' > "$TH/.config/tmux-claude/apariencia"
    r="$(COLUMNS=80 LINES=24 E timeout 5 tmux-saver </dev/null 2>/dev/null | head -c 200 | wc -c)"; rm -f "$TH/.config/tmux-claude/apariencia"
    (( r > 0 )) && ok "a saved scene that was retired falls back to aleatoria" || falla "retired scene: the screensaver drew nothing"
    tm -f /dev/null new-session -d -s prot; tm set -w -t prot: @cmain "te toca"
    r="$(COLUMNS=80 LINES=24 WS_ARTE_SEMILLA=1 E timeout 3 tmux-saver </dev/null 2>/dev/null | head -c 200 | wc -c)"
    (( r > 0 )) && ok "the screensaver shows up even if a tab is at «te toca» (waiting for you)" || falla "the screensaver does not show up with a tab at «te toca»"
    tm set -w -t prot: @cmain "te necesita"
    r="$(COLUMNS=80 LINES=24 E timeout 3 tmux-saver </dev/null 2>/dev/null | head -c 200 | wc -c)"
    (( r == 0 )) && ok "and it does not cover the screen while a permission dialog is open" || falla "the screensaver came up with a permission dialog open"
    r="$(E tmux-saver --fijar cumbres)"; [[ "$(sed -n 's/^escena=//p' "$TH/.config/tmux-claude/apariencia")" == cumbres && "$(tm show -gqv @saver_scene)" == cumbres ]] \
      && ok "picking a scene saves it (the menu picker used not to save it)" || falla "tmux-saver --fijar: $r"
    E tmux-saver --fijar aleatoria >/dev/null; [[ -z "$(tm show -gqv @saver_scene)" ]] && ! E tmux-saver --fijar does-not-exist 2>/dev/null \
      && ok "«aleatoria» releases the pinned scene and an unknown name is rejected" || falla "tmux-saver --fijar aleatoria"
    tm kill-server 2>/dev/null
  fi
}

prueba_terminal() {
  socket_de terminal
  seccion "Terminal: ble.sh, completion and copilot"
  [[ -f "$TH/.config/tmux-claude/shell.sh" ]] || { aviso "shell.sh is not installed"; return; }
  printf 'source ~/.config/tmux-claude/shell.sh\n' > "$TH/.bashrc"
  tm -f /dev/null new-session -d -s term -x 160 -y 30 "bash -i"; local res="" i
  for (( i = 0; i < 15; i++ )); do
    sleep 2; tm send-keys -t term 'echo "BLE=${BLE_VERSION:-no} AI=$(declare -F _ai_sugerir >/dev/null && echo yes) SOURCES=${_ble_complete_auto_source[*]}"' Enter; sleep 1
    res="$(tm capture-pane -p -J -t term | grep -E '^BLE=' | tail -1)"; [[ -n "$res" ]] && break
  done
  [[ "$res" == *"AI=yes"* ]] && ok "the terminal loads the copilot (Alt+a/e/x)" || falla "shell.sh did not load ($res)"
  if [[ -n "$res" && "$res" != *"BLE=no"* ]]; then
    ok "ble.sh active (suggestions in grey)"
    tm send-keys -t term C-u; tm send-keys -t term -l 'kubectl get '
    for (( i = 0; i < 20; i++ )); do tm capture-pane -p -J -t term | grep -q 'kubectl get pods -A' && break; sleep 0.5; done
    tm send-keys -t term Right; sleep 0.5; tm send-keys -t term C-a; tm send-keys -t term -l 'echo ACCEPTED: '; tm send-keys -t term Enter; sleep 1
    tm capture-pane -p -J -t term | grep -q '^ACCEPTED: kubectl get pods -A' && ok "the AI suggests in grey and → accepts it" || falla "AI suggestion in grey"
  else aviso "ble.sh is not active"; fi
  tm kill-server 2>/dev/null
  # Unit: secret redaction and circuit breaker.
  # The test token is assembled at run time: written out in full in this file, the secret scanner of
  # ws-verify and of the gate would (rightly) flag it as a possible real token.
  local tok="ghp""_ABCDEFGHIJKLMNOPQRSTUV12"
  local red; red="$(printf '%s password=Sup3r --account-key abc Bearer abcdefghijklmnop' "$tok" \
                    | E bash -c "source ~/.config/tmux-claude/ai-shell.sh 2>/dev/null; _ai_redact")"
  [[ "$red" == *"[REDACTED]"* && "$red" != *ghp_ABC* && "$red" != *Sup3r* && "$red" != *"key abc"* && "$red" != *abcdefghijklmnop* ]] && ok "the copilot removes secrets before sending" || falla "redaction: $red"
  printf '#!/bin/bash\ncat >/dev/null; exit 1\n' > "$FB/ant.fail"; chmod +x "$FB/ant.fail"
  red="$(E bash -c "mkdir -p '$T/cb'; ln -sf '$FB/ant.fail' '$T/cb/ant'; export PATH='$T/cb':\$PATH
          source ~/.config/tmux-claude/ai-shell.sh 2>/dev/null; for i in 1 2 3; do echo x | _ai_consulta r 5 >/dev/null; done
          _ai_api_abierta && echo open || echo paused")"
  [[ "$red" == *paused* ]] && ok "after 3 failures the API is paused and the fallback is used" || falla "circuit breaker"
}

prueba_tapas_sandbox() {
  seccion "Sandbox placeholders in your repos (read-only)"
  local base="${REPOS:-}" r p con=()
  [[ -d "$base" ]] || { aviso "REPOS is not set"; return; }
  # Placeholder = EMPTY file or folder in a protected path, unknown to git.
  for r in "$base"/*/; do
    [[ -d "$r/.git" ]] || continue
    while IFS= read -r p; do
      git -C "$r" ls-files --error-unmatch "${p#"$r"}" >/dev/null 2>&1 || { con+=("$(basename "$r")"); break; }
    done < <(find "$r" -maxdepth 2 -empty \( -path "${r}.claude/*" -o -name .mcp.json -o -name .vscode -o -name .gitmodules \) 2>/dev/null)
  done
  (( ${#con[@]} == 0 )) && ok "no empty sandbox placeholders" || aviso "sandbox placeholders in: ${con[*]} (close Claude there and see docs/runbook.md)"
}

prueba_telemetria() {
  socket_de telemetria
  existe ws-telemetria || { aviso "ws-telemetria is not installed"; return; }
  [[ -f "$TH/.config/ws-telemetria/tablero.plantilla.html" ]] || { aviso "the dashboard template is missing"; return; }
  # Transcript in Claude Code's real format: one prompt, one repeated answer (streaming) and another one.
  local d="$TH/.claude/projects/-mnt-c-repos-pii-mx"; mkdir -p "$d"
  {
    printf '%s\n' '{"type":"user","sessionId":"s9","cwd":"/mnt/c/repos/pii-mx","gitBranch":"main","timestamp":"2026-11-16T10:00:00Z","message":{"content":"private-prompt-text"}}'
    for id in m1 m1 m2; do
      printf '{"type":"assistant","sessionId":"s9","cwd":"/mnt/c/repos/pii-mx","timestamp":"2026-11-16T10:00:05Z","message":{"id":"%s","model":"claude-sonnet-5-5","content":[{"type":"tool_use","name":"Bash"}],"usage":{"input_tokens":10,"output_tokens":1000,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}\n' "$id"
    done
  } > "$d/s9.jsonl"
  E ws-telemetria build >/dev/null 2>&1 && [[ -s "$TH/.local/share/ws-telemetria/tablero.html" ]] && ok "builds the dashboard" || { falla "ws-telemetria build"; return; }
  local r; r="$(E ws-telemetria resumen 2>&1)"
  grep -q 'pii-mx' <<<"$r" && ok "aggregates per project" || falla "summary without the project: $r"
  # 2 unique answers (the repeated m1 is not counted twice): 2000 output + 20 input.
  grep -q '"out": 2000' "$TH/.local/share/ws-telemetria/turnos.jsonl" && ok "does not count repeated answers twice" || falla "token count duplicated"
  ! grep -q 'private-prompt-text' "$TH/.local/share/ws-telemetria/"{tablero.html,turnos.jsonl} && ok "does not store the text of the prompts" || falla "the prompt text was stored"
  [[ -s "$T/win/tablero.html" ]] && ok "copies the dashboard to the Windows folder" || falla "no copy on Windows"
  # Only your prompts open a turn: neither the output of a local command nor a meta entry; two messages in a row
  # without an answer from Claude are a single turn (with the words of both).
  local d10="$TH/.claude/projects/-mnt-c-repos-turns"; mkdir -p "$d10"
  printf '%s\n' '{"type":"user","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:00Z","isMeta":true,"message":{"content":"meta context from the system"}}' \
    '{"type":"user","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:01Z","message":{"content":"<local-command-stdout>output of a command</local-command-stdout>"}}' \
    '{"type":"user","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:02Z","message":{"content":"first"}}' \
    '{"type":"user","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:09Z","message":{"content":"second real"}}' \
    '{"type":"assistant","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:20Z","message":{"id":"t10","model":"claude-sonnet-5-5","content":[{"type":"text","text":"done"}],"usage":{"input_tokens":1,"output_tokens":1}}}' > "$d10/s10.jsonl"
  rm -f "$TH/.local/share/ws-telemetria/.ultimo"; E ws-telemetria build >/dev/null 2>&1
  [[ "$(jq -c 'select(.sesion == "s10") | [.inicio, .prompt_palabras, .respuestas]' "$TH/.local/share/ws-telemetria/turnos.jsonl")" == '["2026-11-16T12:00:09Z",3,1]' ]] \
    && ok "turns: only your prompts open a turn and consecutive ones without an answer are merged" || falla "turns of s10: $(jq -c 'select(.sesion == "s10")' "$TH/.local/share/ws-telemetria/turnos.jsonl" | head -3)"
  # Trends: series per week (local Monday), model family and hour map; no raw model names as a series.
  local tj; tj="$(python3 - "$TH/.local/share/ws-telemetria/tablero.html" <<'PY'
import json, re, sys
d = json.loads(re.search(r"const D = (\{.*?\});\nconst \$", open(sys.argv[1], encoding="utf-8").read(), re.S).group(1))
t = d.get("tendencias") or {}
s = [f for f in t.get("semanas", []) if f.get("turnos")]
print(len(t.get("semanas", [])), len(s), s[0]["semana"] if s else "-", ",".join(t.get("familias", [])),
      sum(map(sum, t.get("calor", []))), len(t.get("dias", [])), s[0]["modelos"].get("sonnet", 0) > 0 if s else False)
PY
)"
  [[ "$tj" == "12 1 2026-W47 sonnet 2 30 True" ]] && ok "trends: 12 weeks, the turn's week, model family, hour map and 30 days" || falla "dashboard trends: $tj"
  # A branch with </script> must not close the dashboard's data block (script injection).
  local dx="$TH/.claude/projects/-mnt-c-repos-xss"; mkdir -p "$dx"
  printf '%s\n' '{"type":"user","sessionId":"sx","cwd":"/mnt/c/repos/xss","gitBranch":"x</script><script>alert(1)</script>","timestamp":"2026-11-16T11:00:00Z","message":{"content":"hello world test"}}' \
    '{"type":"assistant","sessionId":"sx","cwd":"/mnt/c/repos/xss","gitBranch":"x</script><script>alert(1)</script>","timestamp":"2026-11-16T11:00:05Z","message":{"id":"mx","model":"claude-sonnet-5-5","content":[],"usage":{"input_tokens":1,"output_tokens":1}}}' > "$dx/sx.jsonl"
  rm -f "$TH/.local/share/ws-telemetria/.ultimo"; E ws-telemetria build >/dev/null 2>&1
  ! grep -q '</script><script>alert' "$TH/.local/share/ws-telemetria/tablero.html" && ok "the dashboard escapes </script> in the data" || falla "script injection in the dashboard"
  python3 - "$TH/.local/share/ws-telemetria/tablero.html" <<'PY' && ok "estimation ratios: text, model and cost per turn, word and token" || falla "dashboard without estimation ratios"
import json, re, sys
d = json.loads(re.search(r"const D = (\{.*?\});\nconst \$", open(sys.argv[1], encoding="utf-8").read(), re.S).group(1)).get("razones") or {}
n = {x["nombre"]: x["valor"] for x in d.get("razones", [])}
sys.exit(0 if n.get("Your words per turn", 0) > 0 and "Output tokens per visible word from Claude" in n and "Cost per turn of yours" in n else 1)
PY
  grep -q 'function tendencias' "$TH/.local/share/ws-telemetria/tablero.html" && ok "the dashboard has the trends section" || falla "template without trends"
}

#######################################
# NON-deterministic tests (real Claude and API)
#######################################
reintenta() { local i; for i in 1 2 3; do "$@" && return 0; sleep 2; done; return 1; }

ia_cuentas() {
  local om op
  om="$(env -u CLAUDE_CONFIG_DIR timeout 20 claude auth status --text </dev/null 2>/dev/null | sed -n 's/^Organization: //p')"
  op="$( [[ -d "$RH/.claude-personal" ]] && CLAUDE_CONFIG_DIR="$RH/.claude-personal" timeout 20 claude auth status --text </dev/null 2>/dev/null | sed -n 's/^Organization: //p')"
  [[ -n "$om" ]] && ok "work account logged in ($om)" || aviso "work account not logged in"
  if [[ -n "$op" ]]; then [[ "$op" != "$om" ]] && ok "personal with its own organization ($op)" || aviso "both accounts are in the same organization"; fi
}
ia_claude_p() { timeout 60 claude -p --model haiku --tools "" --no-session-persistence "Reply with exactly this word: ready" </dev/null 2>/dev/null | grep -qi ready; }
ia_copiloto() {
  local r; r="$(printf 'Request: list the hidden files of this folder\n' | bash -c 'source ~/.config/tmux-claude/ai-shell.sh 2>/dev/null; _ai_consulta "Return ONLY the bash command, on one line." 100')"
  grep -qE '(^|[ ;|&])(ls|find)( |$)' <<<"$r"
}
ia_api_ghost() {
  local t0 r; t0=$(date +%s%N)
  r="$(printf 'Typed text: git commi\n' | bash -c 'source ~/.config/tmux-claude/ai-shell.sh 2>/dev/null; _ai_cargar_llave; _ai_api "$_AI_GHOST_REGLAS" 60 5')" || return 1
  IA_LAT=$(( ($(date +%s%N) - t0) / 1000000 ))
  [[ "$r" == "git commi"* ]]
}
ia_modo_auto() {
  local token="auto-test-$RANDOM"
  ( cd "$(mktemp -d)" && timeout 120 claude -p --permission-mode auto --no-session-persistence \
      "Run this command with Bash: echo $token  and reply with its output only." </dev/null 2>/dev/null ) | grep -q "$token"
}

correr_ia() {
  seccion "With the real Claude and API (non-deterministic)"
  command -v claude >/dev/null || { aviso "claude is not in PATH"; return; }
  ia_cuentas
  reintenta ia_claude_p && ok "claude -p answers (Haiku)" || aviso "claude -p did not answer as expected"
  reintenta ia_copiloto && ok "the copilot proposes a valid command (ls/find)" || aviso "the copilot did not propose a recognizable command"
  if command -v ant >/dev/null && compgen -G "$RH/.config/anthropic-copiloto/credentials/*.json" >/dev/null; then
    IA_LAT=0; reintenta ia_api_ghost && ok "API: coherent grey suggestion (${IA_LAT} ms)" || aviso "API: the suggestion did not start with the typed text"
  else aviso "no copilot session (ws-copiloto login): the API test is skipped"; fi
  reintenta ia_modo_auto && ok "auto mode runs a command and returns its output" || aviso "auto mode did not return the expected output"
}

#######################################
preparar
prueba_ruteo() {
  seccion "Model routing (cr + hook)"
  [[ -x "$RH/.local/bin/cr" && -x "$RH/.claude/hooks/ws-ruteo.sh" ]] || { aviso "routing is not installed"; return; }
  local r; r="$(HOME="$RH" "$RH/.local/bin/cr" --probar 2>&1)"
  if [[ $? -eq 0 ]]; then ok "$(tail -1 <<<"$r")"; else falla "$(tail -1 <<<"$r")"; fi
  socket_de ruteo
  # Spanish on purpose: these prompts are what the routing rules classify (rules match prompts typed in Spanish).
  local tt="$T/s/ruteo" run="$T/run-ruteo" sock pane sql='escribe una consulta SQL que sume ventas por mes'
  mkdir -p "$run"
  TMUX_TMPDIR="$tt" tmux -f /dev/null new -d -s r -x 80 -y 20
  sock="$(ls -d "$tt"/tmux-*/default)"; pane="$(TMUX_TMPDIR="$tt" tmux display -p -t r '#{pane_id}')"
  TMUX_TMPDIR="$tt" tmux set -w -t r @cmodel "Opus 5.5"
  hk() { printf '{"prompt":%s}' "$(jq -Rn --arg p "$1" '$p')" | env TMUX="$sock,1,0" TMUX_PANE="$pane" \
           XDG_RUNTIME_DIR="$run" WS_RUTEO_LOG="$T/log-ruteo" WS_RUTEO_SIN_POPUP=1 HOME="$RH" "$RH/.claude/hooks/ws-ruteo.sh"; }
  [[ -z "$(hk 'implementa el endpoint de facturas con pruebas')" ]] && ok "hook: no rule → does not ask" || falla "the hook asked without a rule"
  [[ -z "$(hk 'depura por qué falla el login con 500')" ]] && ok "hook: same level → does not ask" || falla "the hook asked at the same level"
  [[ "$(hk "$sql")" == *'"block"'* ]] && ok "hook: SQL on Opus → asks for confirmation" || falla "the hook did not ask for confirmation"
  [[ "$(stat -c %a "$run/ws-ruteo/prompt-${pane#%}" 2>/dev/null)" == 600 ]] && ok "hook: stores the text (0600) to resend it" || falla "text not stored with 0600"
  printf '%s' "$sql" | sha256sum | cut -c1-64 > "$run/ws-ruteo/pass-${pane#%}"
  [[ -z "$(hk "$sql")" ]] && ok "hook: the confirmed resend goes through without asking" || falla "the confirmed resend asked again"
  [[ -z "$(hk '/model claude-sonnet-5-5 por favor')" ]] && ok "hook: ignores / commands" || falla "the hook blocked a / command"
  TMUX_TMPDIR="$tt" tmux set -g @cruteo off
  [[ -z "$(hk "$sql")" ]] && ok "hook: routing off → does not ask" || falla "routing off and it still asked"
  # Going down with high context: does not block; suggests the cheap subagent. With little context it does ask.
  TMUX_TMPDIR="$tt" tmux set -gu @cruteo
  TMUX_TMPDIR="$tt" tmux set -w -t r @cctx 62
  local s; s="$(hk "$sql")"
  [[ "$s" != *'"block"'* && "$s" == *sql-rapido* ]] && ok "going down with high context → suggests the subagent, does not switch the model" || falla "going down with high context: $s"
  TMUX_TMPDIR="$tt" tmux set -w -t r @cctx 12
  [[ "$(hk "$sql")" == *'"block"'* ]] && ok "going down with little context → asks" || falla "going down with little context did not ask"
  [[ -z "$(hk "$sql /model claude-fable-5-2")" ]] && ok "hook: text with /model appended → does not ask (no loop)" || falla "the hook asked with /model appended"
  TMUX_TMPDIR="$tt" tmux set -w -t r @cruteo_si "sonnet:$(date +%s)"
  [[ -z "$(hk "$sql")" ]] && ok "hook: just switched by the routing → does not ask again" || falla "the hook asked again after the switch"
  TMUX_TMPDIR="$tt" tmux set -wu -t r @cruteo_si
}

prueba_telegram() {
  seccion "Telegram: notifications and answering with buttons (simulated API)"
  local W="$RH/.local/bin/ws-telegram"
  [[ -x "$W" ]] || { aviso "ws-telegram is not installed"; return; }
  [[ "$(HOME="$RH" "$W" autoprueba 2>&1)" == ok ]] && ok "reads the dialog options and redacts secrets" || falla "ws-telegram autoprueba"
  socket_de telegram
  local tt="$T/s/telegram" g="$T/tg" sock pane
  mkdir -p "$g/cfg" "$g/st" "$g/log"; printf 'chat_id=42\nbot=test_bot\n' > "$g/cfg/config"
  # Simulated Telegram API: logs what is sent; getUpdates delivers the button requested in $g/cb ("<from> <option>").
  cat > "$g/curl" <<'EOF'
#!/usr/bin/env bash
cfg=""; while (( $# )); do [[ "$1" == -K ]] && cfg="$2"; shift; done
m="$(sed -n 's|.*/bot[^/]*/\([A-Za-z]*\)".*|\1|p' "$cfg")"; body="$(cat)"; G="${WS_TG_FAKE:?}"
printf '%s %s\n' "$m" "$body" >> "$G/calls"
case "$m" in
  sendMessage) echo '{"ok":true,"result":{"message_id":7}}' ;;
  getUpdates)
    if [[ -f "$G/msg" ]]; then read -r de rmid txt < "$G/msg"; rm -f "$G/msg"
      jq -nc --argjson de "$de" --argjson r "$rmid" --arg t "$txt" '{ok: true, result: [{update_id: 9, message: {message_id: 99, from: {id: $de}, chat: {id: $de}, text: $t, reply_to_message: {message_id: $r}}}]}'
    elif [[ -f "$G/cb" ]]; then read -r de op < "$G/cb"; rm -f "$G/cb"
      n="$(basename "$(ls "$G"/st/pendientes/*.json 2>/dev/null | head -1)" .json)"
      printf '{"ok":true,"result":[{"update_id":5,"callback_query":{"id":"c1","from":{"id":%s},"message":{"chat":{"id":%s}},"data":"%s:%s"}}]}\n' "$de" "$de" "$n" "$op"
    else echo '{"ok":true,"result":[]}'; fi ;;
  *) echo '{"ok":true,"result":true}' ;;
esac
EOF
  chmod +x "$g/curl"
  TMUX_TMPDIR="$tt" tmux -f /dev/null new -d -s tg -x 100 -y 20 \
    "bash -c 'printf \" Do you want to proceed?\n ❯ 1. Yes\n   2. Yes, and do not ask again\n   3. No (esc)\n\"; read -rsn1 k; echo CHOSEN:\$k; sleep 60'"
  sock="$(ls -d "$tt"/tmux-*/default)"; pane="$(TMUX_TMPDIR="$tt" tmux display -p -t tg '#{pane_id}')"; sleep 0.5
  tg_env() { env TMUX="$sock,1,0" HOME="$RH" WS_TELEGRAM_CFG="$g/cfg" WS_TELEGRAM_ST="$g/st" WS_TELEGRAM_LOG="$g/log" \
               WS_TELEGRAM_TOKEN=test WS_TELEGRAM_CURL="$g/curl" WS_TELEGRAM_SIN_SERVICIO=1 WS_TG_FAKE="$g" "$@"; }
  tg_env "$W" avisar wait "$pane" "Claude needs your permission to use Bash"
  [[ "$(jq '.opciones | length' "$g"/st/salida/*.json 2>/dev/null)" == 3 ]] && ok "the notification carries the 3 options on screen" || falla "notification without options"
  echo "99 1" > "$g/cb"; tg_env "$W" servicio --una-vez
  grep -q '"inline_keyboard"' "$g/calls" 2>/dev/null && ok "sends the message with buttons" || falla "did not send buttons"
  ! grep -q 'CHOSEN' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t tg)" && grep -q no_autorizado "$g"/log/*.jsonl \
    && ok "ignores buttons from another chat" || falla "accepted a button from another chat"
  echo "42 1" > "$g/cb"; tg_env "$W" servicio --una-vez; sleep 0.5
  grep -q 'CHOSEN:1' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t tg)" && ok "your button 1 reaches the tab" || falla "the button did not reach the tab"
  [[ -z "$(ls "$g"/st/pendientes/ 2>/dev/null)" ]] && ok "the code is single-use" || falla "the code is still valid"
  grep -q 'You answered' "$g/calls" && ok "marks the message as answered" || falla "did not mark the message"
  # Routing popup answered from Telegram: the answer goes to its file, only if the popup is still waiting.
  mkdir -p "$g/run/ws-ruteo"; : > "$g/run/ws-ruteo/remoto-7.esperando"
  tg_env "$W" preguntar "$pane" "Model routing: test" "s=Switch to sonnet;n=Stay;x=Edit" "$g/run/ws-ruteo/remoto-7"
  echo "42 s" > "$g/cb"; tg_env "$W" servicio --una-vez
  [[ "$(cat "$g/run/ws-ruteo/remoto-7" 2>/dev/null)" == s ]] && ok "answers the routing popup from Telegram" || falla "the routing answer did not arrive"
  # Claude inside a floating window: it reads and types on the -L flot server, not on the outer tab.
  TMUX_TMPDIR="$tt" tmux -L flot -f /dev/null new -d -s ftest \
    "bash -c 'printf \" Do you want to proceed?\n ❯ 1. Yes\n   2. No (esc)\n\"; read -rsn1 k; echo FLOT:\$k; sleep 60'"; sleep 0.5
  rm -f "$g"/st/pendientes/*.json
  TMUX_TMPDIR="$tt" tg_env "$W" avisar wait "flot:ftest" "Claude needs your permission" "$pane"
  echo "42 2" > "$g/cb"; TMUX_TMPDIR="$tt" tg_env "$W" servicio --una-vez; sleep 0.5
  grep -q 'FLOT:2' <<<"$(TMUX_TMPDIR="$tt" tmux -L flot capture-pane -p -t ftest)" && ok "in a popup, the button reaches the popup" || falla "the button did not reach the popup"
  TMUX_TMPDIR="$tt" tmux -L flot kill-server 2>/dev/null
  # `!` commands proposed by Claude: one per message; ▶ Run runs only that command in that tab.
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n cmd "bash -c 'read -r l; echo \"RAN:\$l\"; sleep 60'"
  local pc; pc="$(TMUX_TMPDIR="$tt" tmux display -p -t tg:cmd '#{pane_id}')"
  rm -f "$g"/st/pendientes/*.json "$g"/st/salida/*.json; : > "$g/calls"
  tg_env "$W" avisar "done" "$pc" 'Finished in 0m 5s: run `! echo hello` and also `! sudo rm -rf /tmp/x`'
  [[ "$(find "$g/st/salida" -name '*_c*.json' | wc -l)" == 2 ]] && ok "each ! command goes in its own message" || falla "commands not separated"
  : > "$g/cfg/ejecutar-sin-pin"   # first the direct button (explicit option); below, with the PIN (the default)
  echo "42 r" > "$g/cb"
  WS_TELEGRAM_SIN_CHEQUEO_CLAUDE=1 WS_TELEGRAM_ESPERA=10 tg_env "$W" servicio --una-vez; sleep 11
  grep -q 'RAN:!echo hello' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pc")" && ok "▶ Run runs that command in the tab" || falla "the command was not run"
  grep -q 'Result' "$g/calls" && ok "sends the result as a reply" || falla "the result did not arrive"
  grep -q 'Do it on the PC' "$g/calls" && ok "dangerous commands arrive without a button" || falla "a dangerous command got a button"
  # With the PIN (the default): the button does not run anything; it asks for the PIN and only runs with the right one.
  rm -f "$g/cfg/ejecutar-sin-pin" "$g"/st/pendientes/*.json "$g"/st/salida/*.json; : > "$g/calls"
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n cmd2 "bash -c 'read -r l; echo \"RAN:\$l\"; sleep 60'"
  local pc2; pc2="$(TMUX_TMPDIR="$tt" tmux display -p -t tg:cmd2 '#{pane_id}')"
  tg_env "$W" avisar "done" "$pc2" 'Finished in 0m 6s: run `! echo two` and also `! sudo rm -rf /tmp/y`'
  echo "42 r" > "$g/cb"; WS_TELEGRAM_PIN=4821 WS_TELEGRAM_SIN_CHEQUEO_CLAUDE=1 tg_env "$W" servicio --una-vez; sleep 1
  ! grep -q 'RAN' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pc2")" && grep -q 'with your PIN' "$g/calls" && [[ -f "$g/st/por-ejecutar/7.json" ]] \
    && ok "▶ Run runs nothing: it asks for the PIN" || falla "Run with PIN: it ran without the PIN or did not ask for it"
  echo "42 7 0000" > "$g/msg"; WS_TELEGRAM_PIN=4821 WS_TELEGRAM_SIN_CHEQUEO_CLAUDE=1 tg_env "$W" servicio --una-vez; sleep 1
  ! grep -q 'RAN' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pc2")" && ok "wrong PIN: does not run" || falla "ran with a wrong PIN"
  echo "42 7 4821" > "$g/msg"; WS_TELEGRAM_PIN=4821 WS_TELEGRAM_SIN_CHEQUEO_CLAUDE=1 WS_TELEGRAM_ESPERA=10 tg_env "$W" servicio --una-vez; sleep 11
  grep -q 'RAN:!echo two' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pc2")" && [[ ! -f "$g/st/por-ejecutar/7.json" ]] \
    && ok "with the right PIN it runs, only once" || falla "did not run with the right PIN"
  rm -f "$g/st/pin-fallos"
  # Alerts: Claude error with the account button; high context with /compact; the /compact button reaches the tab.
  mkdir -p "$g/bin"; ln -sf "$(command -v sleep)" "$g/bin/2.1.999"
  # direct exec: tmux reports the foreground process (like the Claude binary, named after its version)
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n errors "printf 'API Error: 529 Overloaded\\n'; exec $g/bin/2.1.999 120"
  sleep 0.5; printf 'alertas=on\nresumen_hora=99\ncontexto_pct=80\nconsumo_usd_h=999999\n' > "$g/cfg/ajustes"
  TMUX_TMPDIR="$tt" tmux set -w -t tg:errors @cctx 85
  rm -f "$g"/st/salida/*.json "$g"/st/pendientes/*.json; : > "$g/calls"
  WS_TELEGRAM_SIN_ESTACION=1 tg_env "$W" revisar
  grep -qs 'Overloaded' "$g"/st/salida/*_a.json && ok "alert: Claude stopped because of an error" || falla "there was no error alert"
  grep -qs '/compact' "$g"/st/salida/*_a.json && ok "alert: high context with the /compact button" || falla "there was no context alert"
  WS_TELEGRAM_SIN_ESTACION=1 tg_env "$W" revisar
  [[ "$(ls "$g"/st/salida/*_a.json 2>/dev/null | wc -l)" == 2 ]] && ok "alerts are not repeated on every check" || falla "repeated alerts"
  tg_env "$W" servicio --una-vez
  rm -f "$g"/st/pendientes/*.json
  tg_env "$W" alerta-prueba "$(TMUX_TMPDIR="$tt" tmux display -p -t tg:errors '#{pane_id}')"
  tg_env "$W" servicio --una-vez
  echo "42 k" > "$g/cb"; tg_env "$W" servicio --una-vez; sleep 1
  grep -q '/compact' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t tg:errors)" && ok "the /compact button reaches the tab" || falla "the /compact button did not arrive"
  # Long answer: the commands at the start arrive too (only the last 1200 characters used to be looked at).
  rm -f "$g"/st/salida/*.json; local largo; largo="$(mktemp)"
  { printf 'First run `! node --version` and then check.\n'; head -c 6000 /dev/zero | tr '\0' 'x'; printf '\nDone.\n'; } > "$largo"
  tg_env "$W" avisar "done" "$pc" "Finished in 2m 0s: …Done." "$pc" "$largo"
  grep -qs 'node --version' "$g"/st/salida/*_c*.json && ok "commands from a long answer arrive too" || falla "the command of a long answer was lost"
  [[ ! -e "$largo" ]] && ok "the full message is deleted once read" || falla "the file with the full message was left behind"
  # The same command in the same tab arrives only once (even if Claude repeats it in later turns).
  rm -f "$g"/st/salida/*.json
  tg_env "$W" avisar "done" "$pc" 'Finished in 0m 3s: run `! git status`'
  tg_env "$W" avisar "done" "$pc" 'Finished in 0m 4s: again, run `! git status`'
  [[ "$(grep -ls '"git status"' "$g"/st/salida/*_c*.json | wc -l)" == 1 ]] && ok "a repeated command arrives only once" || falla "the command was repeated"
  # Text reply with the PIN to an open question: only as a Reply, single use; a wrong PIN sends nothing.
  rm -f "$g"/st/salida/*.json "$g"/st/pendientes/*.json; : > "$g/cfg/texto"
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n txt "bash -c 'read -r l; echo \"ARRIVED:\$l\"; sleep 60'"
  local pt; pt="$(TMUX_TMPDIR="$tt" tmux display -p -t tg:txt '#{pane_id}')"
  # Spanish on purpose: the open-question detector must also match a question opened with «¿».
  WS_TELEGRAM_PIN=4821 tg_env "$W" avisar "done" "$pt" "Finished in 0m 4s: ¿Uso cursor opaco o el id?"
  WS_TELEGRAM_PIN=4821 tg_env "$W" servicio --una-vez
  [[ -f "$g/st/abiertas/7.json" ]] && grep -q 'Reply to this message' "$g/calls" && ok "the open question invites a reply" || falla "the open question was not kept"
  echo "42 7 1111 use a cursor" > "$g/msg"; WS_TELEGRAM_PIN=4821 tg_env "$W" servicio --una-vez; sleep 0.5
  ! grep -q 'ARRIVED' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pt")" && ok "wrong PIN: nothing is sent" || falla "it was sent with a wrong PIN"
  echo "42 7 4821 use an opaque cursor" > "$g/msg"; WS_TELEGRAM_PIN=4821 tg_env "$W" servicio --una-vez; sleep 0.8
  grep -q 'ARRIVED:.*Reply from Telegram.*use an opaque cursor' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -J -t "$pt")" \
    && ok "with the PIN, your reply reaches Claude, marked" || falla "the text reply did not arrive"
  [[ ! -f "$g/st/abiertas/7.json" ]] && ok "the open question is single-use" || falla "the question is still open"
  # Replying to a notification that did NOT say ↩ (e.g. «finished») also reaches that tab.
  rm -f "$g"/st/salida/*.json "$g"/st/abiertas/*.json; : > "$g/cfg/texto"
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n txt2 "bash -c 'read -r l; echo \"ARRIVED2:\$l\"; sleep 60'"
  local pt2; pt2="$(TMUX_TMPDIR="$tt" tmux display -p -t tg:txt2 '#{pane_id}')"
  WS_TELEGRAM_PIN=4821 tg_env "$W" avisar "done" "$pt2" "Finished in 2m 0s: done, all set."
  WS_TELEGRAM_PIN=4821 tg_env "$W" servicio --una-vez
  echo "42 7 4821 now add tests" > "$g/msg"; WS_TELEGRAM_PIN=4821 tg_env "$W" servicio --una-vez; sleep 0.8
  grep -q 'ARRIVED2:.*now add tests' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -J -t "$pt2")" \
    && ok "a Reply to any notification of the tab reaches Claude" || falla "a Reply to a notification without ↩ did not arrive"
  rm -f "$g/cfg/texto"
  rm -f "$g/cfg/texto"
  python3 -m py_compile "$RH/.local/bin/tmux-resumen" 2>/dev/null && ok "tmux-resumen compiles" || falla "tmux-resumen does not compile"
}

prueba_grupos() {
  seccion "Tab groups and bringing conversations in"
  [[ -x "$RH/.local/bin/tmux-traer" ]] || { aviso "tmux-traer is not installed"; return; }
  socket_de grupos
  local gh="$T/home-grupos" tt="$T/s/grupos" r="$T/repos-grupos" d k
  mkdir -p "$gh/.config/tmux-claude" "$r/repos/api" "$r/repos/web" "$r/code/tool"
  printf 'repos|1|%s\ncode|1|%s\n' "$r/repos" "$r/code" > "$gh/.config/tmux-claude/roots.txt"
  for d in "$r/repos/api" "$r/code/tool"; do
    k="$(sed 's#[/.]#-#g' <<<"$d")"; mkdir -p "$gh/.claude/projects/$k"
    printf '{"type":"user","cwd":"%s"}\n' "$d" > "$gh/.claude/projects/$k/s-$(basename "$d").jsonl"
  done
  TMUX_TMPDIR="$tt" tmux -f /dev/null new -d -s dev -c "$r/repos/web" "sleep 120"
  # Spanish on purpose: the confirmations keep accepting «s» (sí) next to y/yes.
  echo s | env HOME="$gh" TMUX_TMPDIR="$tt" "$RH/.local/bin/tmux-traer" --reorganizar >/dev/null 2>&1
  local l; l="$(TMUX_TMPDIR="$tt" tmux list-windows -a -F '#S:#W')"
  grep -qx 'repos:api' <<<"$l" && grep -qx 'code:tool' <<<"$l" && ok "opens each conversation without a tab in the session of its group" || falla "groups: $l"
  grep -q '^repos:' <<<"$l" && ! grep -q '^dev:' <<<"$l" && ok "--reorganizar moves the tabs from dev to their group" || falla "reorganizar: $l"
  grep -q 'claude --resume s-api' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t '=repos:api')" && ok "leaves the tab ready to resume (Enter)" || falla "did not leave the resume command"
}

prueba_trazas() {
  seccion "Traces, estimation, weekly report and budgets"
  local h="$RH/.claude/hooks/ws-trazas.sh" r d="$TH/.claude/projects/-mnt-c-repos-estima" hoy ses
  [[ -x "$h" ]] || { aviso "ws-trazas.sh is not installed"; return; }
  existe ws-telemetria || return
  r="$(mktemp -d)"; ses="s-trace"; hoy="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  ( cd "$r" && git init -q && git checkout -qb feature/EST-42-pagos && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -q --allow-empty -m "chore: init" )
  ev() { jq -nc --arg r "$r" --arg s "$ses" "$1" | E env WS_TRAZAS_DIR="$TH/.local/share/ws-telemetria/trazas" XDG_RUNTIME_DIR="$T" bash "$h"; }
  ev '{hook_event_name:"SessionStart",session_id:$s,cwd:$r,source:"startup"}'
  ev '{hook_event_name:"UserPromptSubmit",session_id:$s,cwd:$r,prompt:"private-trace-text does it work?"}'
  ev '{hook_event_name:"PreToolUse",session_id:$s,cwd:$r,tool_name:"Bash",tool_use_id:"tb1"}'
  ev '{hook_event_name:"PostToolUse",session_id:$s,cwd:$r,tool_name:"Bash",tool_use_id:"tb1",tool_input:{command:"pytest -q --option=private_value_123"},tool_response:{stdout:"ok"}}'
  ev '{hook_event_name:"PostToolUse",session_id:$s,cwd:$r,tool_name:"Edit",tool_use_id:"te1",tool_input:{file_path:($r+"/src/a.py"),old_string:"x",new_string:"x\ny"}}'
  ev '{hook_event_name:"PostToolUseFailure",session_id:$s,cwd:$r,tool_name:"mcp__azure__list",tool_use_id:"tm1",tool_input:{},error:"timed out"}'
  ev '{hook_event_name:"PostToolUse",session_id:$s,cwd:$r,tool_name:"Bash",tool_use_id:"tc1",tool_input:{command:"git add -A && git -c user.name=t commit -m \"feat: x\" && git log --grep commit"},tool_response:{stdout:"ok"}}'
  ev '{hook_event_name:"Stop",session_id:$s,cwd:$r}'
  ev '{hook_event_name:"SessionEnd",session_id:$s,cwd:$r,reason:"exit"}'
  local f; f="$TH/.local/share/ws-telemetria/trazas/$(date +%F).jsonl"
  [[ "$(grep -c "\"sesion\":\"$ses\"" "$f" 2>/dev/null)" == 8 ]] && ok "the hook leaves one trace per event (8)" || falla "traces: $(wc -l < "$f" 2>/dev/null) lines"
  [[ "$(grep '"id":"tc1"' "$f" | jq -r .commits)" == 1 ]] && ok "counts the command's git commit (and not a git log that mentions it)" || falla "commits of the command: $(grep '"id":"tc1"' "$f")"
  # End of a session without its start: takes the time of the conversation's first message and counts the commits
  # from there.
  local tp2="$T/conv-no-start.jsonl"; printf '{"type":"user","timestamp":"%s","message":{"content":"x"}}\n' "$(date -u -d '-2 minutes' +%FT%TZ)" > "$tp2"
  ( cd "$r" && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -q --allow-empty -m "feat: from the conversation" )
  jq -nc --arg r "$r" --arg tp "$tp2" '{hook_event_name:"SessionEnd",session_id:"s-no-start",cwd:$r,reason:"other",transcript_path:$tp}' \
    | E env WS_TRAZAS_DIR="$TH/.local/share/ws-telemetria/trazas" XDG_RUNTIME_DIR="$T" bash "$h"
  [[ "$(grep '"sesion":"s-no-start"' "$f" | jq -r '[.commits, .desde] | @tsv')" == $'2\tconversacion' ]] \
    && ok "on ending without a start, it counts the commits since the first message" || falla "end without start: $(grep '"sesion":"s-no-start"' "$f")"
  grep -q '"accion":"pytest","programas":\["pytest"\]' "$f" && grep -q '"ticket":"EST-42"' "$f" && grep -q '"error_tipo":"timeout"' "$f" \
    && ok "action, ticket of the branch and error type" || falla "trace fields: $(tail -3 "$f")"
  ! grep -qE 'private_value|private-trace-text' "$f" && ok "stores neither full commands nor the prompt text" || falla "the trace stored content"
  mkdir -p "$d"
  printf '{"type":"user","sessionId":"%s","cwd":"/mnt/c/repos/estima","gitBranch":"feature/EST-42-pagos","timestamp":"%s","message":{"content":"x"}}\n{"type":"assistant","sessionId":"%s","cwd":"/mnt/c/repos/estima","timestamp":"%s","message":{"id":"e1","model":"claude-opus-5-5","content":[],"usage":{"input_tokens":1000,"output_tokens":100000}}}\n' \
    "$ses" "$hoy" "$ses" "$hoy" > "$d/$ses.jsonl"
  grep -q 'pytest' <<<"$(E ws-telemetria trazas --dias 1 2>&1)" && ok "ws-telemetria trazas" || falla "ws-telemetria trazas"
  grep -q 'EST-42' <<<"$(E ws-telemetria estimar 2>&1)" && ok "ws-telemetria estimar (per ticket)" || falla "ws-telemetria estimar"
  grep -q '^# Week' <<<"$(E ws-telemetria semana --actual 2>&1)" && ok "ws-telemetria semana (Markdown)" || falla "ws-telemetria semana"
  printf 'estima=1\n' > "$TH/.config/ws-telemetria/presupuestos.conf"
  grep -qP '^estima\t\d+' <<<"$(E ws-telemetria presupuestos --alertas 2>&1)" && ok "an exceeded budget shows up in --alertas" || falla "presupuestos --alertas"
  E ws-telemetria build >/dev/null 2>&1; grep -q 'EST-42' "$TH/.local/share/ws-telemetria/tablero.html" && ok "the dashboard has the estimate per ticket" || falla "dashboard without the estimate"
  rm -rf "$r" "$TH/.config/ws-telemetria/presupuestos.conf"
}

prueba_maravillas() {
  socket_de maravillas
  seccion "tmux: pane → Claude, palette, notify me, extract, labels, focus, logs"
  existe tmux-panel && existe ws-redactar || { aviso "patch 52 is not installed"; return; }
  # Test data assembled at run time («pass""word», «PRIV""ATE»): that way the kit's secret scanner is not fooled.
  local r; r="$(printf 'ok %s_%s and %s=Sup3r! %s abcdefghijk123\n%s\nabc8Q~%s\n-----BEGIN RSA %s KEY-----\nMIIx\n-----END RSA %s KEY-----\n' \
    ghp "$(printf 'a%.0s' {1..30})" "pass""word" "Bear""er" 'normal text' "$(printf 'b%.0s' {1..34})" "PRIV""ATE" "PRIV""ATE" | E ws-redactar)"
  ! grep -qE 'aaaaaaaaaa|Sup3r|abcdefghijk|bbbbbbbbbb|MIIx' <<<"$r" && grep -q 'normal text' <<<"$r" \
    && ok "ws-redactar masks tokens, passwords, Bearer, Azure secrets and private keys" || falla "ws-redactar: $r"
  r="$(printf 'see https://dev.azure.com/org/p?x=1 in /mnt/c/repos/app/src/a.ts:12\ncommit 3f9a2c1d ABC-77 id 8c1d2f3a-1b2c-4d5e-8f90-a1b2c3d4e5f6\n' | E tmux-extraer --lista)"
  for t in url path hash ticket guid; do grep -q "^$t" <<<"$r" || { falla "tmux-extraer did not find $t: $r"; r=""; break; }; done
  [[ -n "$r" ]] && ok "tmux-extraer finds URL, path, hash, ticket and GUID"
  E env WS_AVISO_LOG="$T/notices" WS_AVISAME_PAUSA=0.3 tmux -f /dev/null new-session -d -s dev -x 120 -y 30 "printf 'hello\n%s=xyz\n' pass""word; sleep 60"
  local p; p="$(tm display -p -t dev '#{pane_id}')"; sleep 0.5
  r="$(E tmux-panel --texto "$p")"
  grep -q hello <<<"$r" && ! grep -q xyz <<<"$r" && ok "tmux-panel builds the block for Claude, redacted" || falla "tmux-panel: $r"
  tm split-window -t dev "bash --norc --noprofile"; local p2; p2="$(tm display -p -t dev '#{pane_id}')"; sleep 0.3
  E tmux-avisame "$p2" >/dev/null 2>&1; sleep 0.5; tm send-keys -t "$p2" 'sleep 1.5' Enter
  local i; for i in $(seq 1 30); do grep -q 'Finished «sleep»' "$T/notices" 2>/dev/null && break; sleep 0.5; done
  grep -q 'Finished «sleep»' "$T/notices" 2>/dev/null && ok "tmux-avisame notifies when the command finishes" || falla "tmux-avisame did not notify"
  E tmux-etiqueta "$(tm display -p -t dev '#{window_id}')" '🟡rev'; E tmux-etiqueta --barra
  [[ "$(tm show -wv -t dev @etq)" == '🟡rev' && "$(tm show -gv window-status-format | grep -o '@etq' | wc -l)" -le 2 ]] \
    && ok "tmux-etiqueta sets the label and the status bar shows it (no duplicates)" || falla "tmux-etiqueta"
  local wf df; wf="$(tm display -p -t dev '#{window_id}')"; df="$(tm display -p -t dev '#{pane_current_path}')"
  # Start from an empty list: the copy of your real favorites may already hold this folder, and the toggle
  # would then remove it instead of adding it.
  rm -f "$TH/.config/tmux-claude/favoritos"
  E tmux-favoritos --alternar "$wf" >/dev/null 2>&1
  [[ "$(tm show -wqv -t "$wf" @fav)" == 1 ]] && grep -qxF "$df" "$TH/.config/tmux-claude/favoritos" && E tmux-favoritos --lista | grep -qF "$df" \
    && ok "tmux-favoritos marks the tab, saves it and lists it" || falla "tmux-favoritos did not mark it: $(cat "$TH/.config/tmux-claude/favoritos" 2>&1)"
  E tmux-favoritos --barra; E tmux-favoritos --barra
  [[ "$(tm show -gv window-status-format | grep -o '@fav' | wc -l)" -le 2 ]] && ok "the favorites ★ goes into the status bar without duplicates" || falla "tmux-favoritos --barra duplicates"
  E tmux-favoritos --alternar "$wf" >/dev/null 2>&1
  [[ -z "$(tm show -wqv -t "$wf" @fav)" ]] && ! grep -qxF "$df" "$TH/.config/tmux-claude/favoritos" \
    && ok "tmux-favoritos removes the tab from favorites" || falla "tmux-favoritos did not remove it"
  tm set -g status-right 'ORIGINAL'; E tmux-enfoque 25 >/dev/null
  local en; en="$(tm show -gv status-right)"; E tmux-enfoque off >/dev/null
  [[ "$en" == *"🎯 focus"* && "$(tm show -gv status-right)" == ORIGINAL && -z "$(tm show -gqv @enf_fin)" ]] \
    && ok "focus mode changes the status bar and leaves it as it was" || falla "tmux-enfoque: $en / $(tm show -gv status-right)"
  r="$(printf 'all good\nERROR: failure %s=abc123\n' "tok""en" | E env WS_AVISO_LOG="$T/notices2" tmux-logs --filtro test)"
  for i in $(seq 1 20); do [[ -s "$T/notices2" ]] && break; sleep 0.25; done   # the notification goes out in the background
  grep -q 'ERROR' <<<"$r" && grep -q 'Error in logs:test' "$T/notices2" && ! grep -q abc123 "$T/notices2" \
    && ok "tmux-logs paints the error and notifies (redacted)" || falla "tmux-logs: $(cat "$T/notices2" 2>/dev/null)"
  r="$(E tmux-paleta --lista 2>&1)"
  (( $(wc -l <<<"$r") > 40 )) && grep -q 'Send the neighboring pane to Claude' <<<"$r" && ok "the palette lists the options of every menu ($(wc -l <<<"$r"))" || falla "tmux-paleta: ${r:0:200}"
  tm source-file -n "$TH/.config/tmux-claude/maravillas.tmux" && ok "maravillas.tmux loads" || falla "maravillas.tmux does not load"
  tm kill-server 2>/dev/null
}

prueba_tmux53() {
  socket_de tmux53
  seccion "tmux: CI/PR in the status bar, templates, recording, history and swarm"
  existe tmux-enjambre && existe tmux-plantilla || { aviso "patch 53 is not installed"; return; }
  local r="$T/r53" i w
  mkdir -p "$r" && ( cd "$r" && git init -q && git checkout -qb feature/ABC-9-x && git remote add origin https://github.com/example/r53.git && git config user.email t@t && git config user.name t \
    && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -q --allow-empty -m "chore: init" )
  grep -q 'ABC-9' <<<"$(E env WS_RAMA_TTL=0 tmux-rama "$r")" && ok "tmux-rama: ticket of the branch (CI/PR if gh/az are there)" || falla "tmux-rama"
  E env WS_HISTORIAL_DIR="$T/hist" tmux -f /dev/null new-session -d -s dev -x 160 -y 40 -c "$r" "bash --norc --noprofile"
  E env WS_FONDO_CADA=0 tmux-fondo; [[ "$(tm show -gv window-status-format)" == *@crama* ]] && ok "tmux-fondo adds CI/PR to the status bar" || falla "tmux-fondo"
  mkdir -p "$TH/.config/tmux-claude/plantillas"
  printf '# test\nprincipal echo main-ok\nderecha 30%% echo right-ok\nventana extra true\n' > "$TH/.config/tmux-claude/plantillas/p53.conf"
  E tmux-plantilla p53 "$r"; sleep 0.5
  w="$(tm display -p -t dev '#{window_id}')"
  [[ "$(tm list-panes -t "$w" | wc -l)" == 2 ]] && tm list-windows -t dev -F '#W' | grep -qx extra \
    && ok "tmux-plantilla builds panes and tabs" || falla "tmux-plantilla: $(tm list-windows -t dev -F '#W #{window_panes}' | tr '\n' ' ')"
  E tmux-plantilla --guardar g53 "$w" >/dev/null && grep -q '^acomodo ' "$TH/.config/tmux-claude/plantillas/g53.conf" \
    && ok "saves the tab as a template (with its layout)" || falla "tmux-plantilla --guardar"
  local p; p="$(tm display -p -t "dev:0" '#{pane_id}')"
  E env WS_GRABAR_DIR="$TH/grabaciones" tmux-grabar "$p"; sleep 0.3; tm send-keys -t "$p" 'echo recorded-53' Enter; sleep 0.8
  E env WS_GRABAR_DIR="$TH/grabaciones" tmux-grabar "$p"; sleep 0.5
  local c; c="$(ls "$TH"/grabaciones/*.cast 2>/dev/null | head -1)"
  [[ -n "$c" ]] && head -1 "$c" | grep -q '"version": 2' && grep -q 'recorded-53' "$c" && [[ -s "${c%.cast}.txt" ]] \
    && ok "tmux-grabar leaves a replayable .cast and a .txt" || falla "tmux-grabar: ${c:-no file}"
  tm send-keys -t "$p" 'echo history-unique-53' Enter; sleep 0.4
  E env WS_HISTORIAL_DIR="$T/hist" tmux-historial --muestrear; E env WS_HISTORIAL_DIR="$T/hist" tmux-historial --muestrear
  [[ "$(cat "$T"/hist/*/*.log 2>/dev/null | grep -cx 'history-unique-53')" == 1 ]] \
    && ok "tmux-historial stores what is new without repeating" || falla "tmux-historial: $(cat "$T"/hist/*/*.log 2>/dev/null | grep -cx history-unique-53)"
  ( cd "$r" && printf 'y\n' | E env EDITOR=true tmux-enjambre nuevo "add validation" >/dev/null 2>&1 )
  local id; id="$(ls "$TH/.local/share/tmux-enjambre/" 2>/dev/null | sed -n 's/\.json$//p' | head -1)"
  local wt; wt="$(jq -r '.tareas[0].ruta' "$TH/.local/share/tmux-enjambre/$id.json" 2>/dev/null)"
  [[ -n "$id" && -d "$wt" ]] && tm has-session -t "enj-$id" 2>/dev/null && git -C "$r" rev-parse -q --verify "enjambre/$id/1" >/dev/null \
    && ok "tmux-enjambre creates the worktree, the branch and the group with Claude" || { falla "tmux-enjambre nuevo"; tm kill-server; return; }
  ( cd "$wt" && echo x > new.txt && git add new.txt && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -qm "feat: x" )
  printf 'y\n' | E tmux-enjambre integrar "$id" >/dev/null 2>&1
  [[ "$(git -C "$r" branch --show-current)" == "enjambre/$id/integracion" && -f "$r/new.txt" ]] \
    && ok "integrates the branches into enjambre/<id>/integracion (no push)" || falla "tmux-enjambre integrar"
  git -C "$r" switch -q feature/ABC-9-x
  printf 'y\n' | E tmux-enjambre limpiar "$id" >/dev/null 2>&1
  [[ ! -d "$wt" ]] && ! tm has-session -t "enj-$id" 2>/dev/null && ok "cleans up worktrees and tabs" || falla "tmux-enjambre limpiar"
  tm kill-server 2>/dev/null
}

prueba_barra_extra() {
  socket_de barraextra
  seccion "Status bar: personal segments and ws-cache"
  existe ws-cache && existe tmux-fondo || { aviso "patch 53b is not installed"; return; }
  local f="$T/barra-extra.conf"
  printf '# comment\n#(echo segment-53b)\n' > "$f"
  tm -f /dev/null new-session -d -s dev; tm set -g status-right 'BASE'
  E env WS_BARRA_EXTRA="$f" tmux-fondo --barra; E env WS_BARRA_EXTRA="$f" tmux-fondo --barra
  local sr; sr="$(tm show -gv status-right)"
  [[ "$sr" == "BASE #(echo segment-53b)" ]] && ok "adds the segment only once (and not the comments)" || falla "status-right: $sr"
  tm set -g status-right 'BASE'; E env WS_BARRA_EXTRA="$f" tmux-fondo --barra
  [[ "$(tm show -gv status-right)" == *segment-53b* ]] && ok "puts it back if the theme rewrites the status bar" || falla "did not put it back"
  local a b; mkdir -p "$T/xdg-cache"
  a="$(E env XDG_RUNTIME_DIR="$T/xdg-cache" ws-cache 30 date +%s%N)"; sleep 0.1; b="$(E env XDG_RUNTIME_DIR="$T/xdg-cache" ws-cache 30 date +%s%N)"
  [[ -n "$a" && "$a" == "$b" ]] && ok "ws-cache returns what is stored while it is fresh" || falla "ws-cache: $a / $b"
  # Slow startup hooks: the stale value is returned at once and refreshed behind; past --max it runs and waits.
  local c="$T/xdg-cache2" lento="$T/slow.sh" t0 r; mkdir -p "$c"
  printf '#!/usr/bin/env bash\nsleep 1; date +%%s%%N\n' > "$lento"; chmod +x "$lento"
  a="$(E env XDG_RUNTIME_DIR="$c" ws-cache --max 1800 0 "$lento")"
  t0=$(date +%s%N); b="$(E env XDG_RUNTIME_DIR="$c" ws-cache --max 1800 0 "$lento")"; r=$(( ($(date +%s%N) - t0) / 1000000 ))
  [[ -n "$a" && "$a" == "$b" ]] && (( r < 700 )) && ok "ws-cache: the stale value comes out at once (${r} ms) and is refreshed behind" || falla "ws-cache stale: ${r} ms · $a / $b"
  sleep 1.6; b="$(E env XDG_RUNTIME_DIR="$c" ws-cache --max 1800 60 "$lento")"
  [[ -n "$b" && "$a" != "$b" ]] && ok "ws-cache: the background refresh did store the new result" || falla "ws-cache did not refresh: $a / $b"
  touch -d '-2 hours' "$c"/ws-cache-*/????????????????
  a="$(E env XDG_RUNTIME_DIR="$c" ws-cache --max 1800 60 "$lento")"
  [[ -n "$a" && "$a" != "$b" ]] && ok "ws-cache --max: what is too old is not used; it runs and waits" || falla "ws-cache --max: $a / $b"
  r="$(jq -r '[.hooks.SessionStart[].hooks[] | select((.args // []) | map(test("\\.ps1$")) | any) | .command | test("ws-cache$")] | all' "$RH/.claude/settings.json" 2>/dev/null)"
  [[ "$r" == "true" ]] && ok "the startup PowerShell hooks do not block (they go through ws-cache)" || falla "a SessionStart .ps1 runs directly: $r"
  # The sandbox hides the credentials on BOTH sides: the Linux home and the Windows profile (visible in /mnt/c).
  r="$(jq -r '.sandbox.filesystem.denyRead as $d | [".ssh", ".aws", ".azure", ".kube", ".git-credentials", "AppData/Roaming/GitHub CLI"] | map(. as $p | ($d | map(test("^//mnt/c/Users/[^/]+/" + ($p | gsub("\\."; "\\.")) + "$")) | any)) | all' "$RH/.claude/settings.json" 2>/dev/null)"
  [[ "$r" == "true" ]] && ok "the sandbox does not let the Windows profile credentials be read" || falla "Windows credentials missing from sandbox.filesystem.denyRead: $r"
  # Notices of clashes with the sandbox: the hook classifies network, credential reads and writes, and stays quiet
  # for ordinary errors.
  local hk="$RH/.claude/hooks/ws-sandbox-aviso.sh" sd="$T/sbx"
  if [[ -x "$hk" ]]; then
    sbx() { jq -nc --arg c "$1" --arg o "$2" '{tool_name: "Bash", cwd: "/x/repo", session_id: "s", tool_input: {command: $c}, tool_response: {stderr: $o}}' | env -u TMUX_PANE WS_TELEMETRIA_DIR="$sd" bash "$hk"; }
    sbx 'curl https://example.test/a' 'deny network-outbound example.test:443 (x)'
    sbx 'cat /mnt/c/Users/u/.git-credentials' 'cat: x: No such file or directory'
    sbx 'echo x > .git/hooks/pre-push' 'bash: .git/hooks/pre-push: Read-only file system'
    sbx 'ls /does/not/exist' 'ls: /does/not/exist: No such file or directory'; sbx 'cat README.md' 'hello'
    r="$(jq -r '.tipo' "$sd"/raw/sandbox-*.jsonl 2>/dev/null | tr '\n' ' ')"
    [[ "$r" == "red lectura escritura " ]] && ! grep -q 'example.test/a\|README' "$sd"/raw/sandbox-*.jsonl \
      && ok "sandbox notices: logs network, credential reads and writes; nothing for ordinary errors, nor the full command" || falla "ws-sandbox-aviso: $r"
    r="$(jq -r '[.hooks.PostToolUse, .hooks.PostToolUseFailure] | map(map(.hooks[].command) | any(test("ws-sandbox-aviso"))) | all' "$RH/.claude/settings.json" 2>/dev/null)"
    [[ "$r" == "true" ]] && ok "the sandbox notice is hooked to the result of every command" || falla "ws-sandbox-aviso is not hooked: $r"
  fi
  r="$(jq -r '.permissions.ask as $a | ["mcp__azure__keyvault", "mcp__claude_ai_Microsoft_365__*send*", "mcp__mempalace__*delete*", "Bash(pwsh.exe *)"] | map(. as $x | $a | index($x) != null) | all' "$RH/.claude/settings.json" 2>/dev/null)"
  [[ "$r" == "true" ]] && ok "the MCP tools that send, delete or touch secrets, and PowerShell, always ask for confirmation" || falla "ask rules for MCP or PowerShell are missing: $r"
  tm kill-server 2>/dev/null
}

prueba_personal() {
  seccion "Versioned personal configuration (ws-personal)"
  existe ws-personal || { aviso "ws-personal is not installed"; return; }
  local P="$T/personal" g=(env WS_PERSONAL_DIR="$T/personal" GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t)
  mkdir -p "$TH/.config/ws-local/segmentos"; printf '#(echo x)\n' > "$TH/.config/ws-local/barra-extra.conf"
  printf 'echo MP\n' > "$TH/.config/ws-local/segmentos/mp.sh"; chmod 755 "$TH/.config/ws-local/segmentos/mp.sh"
  E "${g[@]}" ws-personal init >/dev/null 2>&1
  [[ "$(git -C "$P" log --oneline 2>/dev/null | wc -l)" -ge 1 && -x "$P/home/.config/ws-local/segmentos/mp.sh" ]] \
    && ok "init: repo with your configuration (keeps execute permissions)" || falla "ws-personal init"
  printf 'x %s=abc12345\n' "pass""word" > "$TH/.config/ws-local/note.txt"
  ! E "${g[@]}" ws-personal sync >/dev/null 2>&1 && ! git -C "$P" ls-files | grep -q note.txt \
    && ok "with something that looks like a secret it does not commit" || falla "ws-personal stored a secret"
  rm -f "$TH/.config/ws-local/note.txt" "$TH/.config/ws-local/barra-extra.conf"
  printf 'y\n' | E "${g[@]}" ws-personal restaurar >/dev/null 2>&1
  [[ -f "$TH/.config/ws-local/barra-extra.conf" ]] && ok "restaurar brings back what is versioned" || falla "ws-personal restaurar"
}

prueba_estado() {
  socket_de estado
  seccion "Detailed Claude state (phase, time, what it is doing, without getting stuck)"
  local h="$RH/.claude/hooks/tmux-state.sh"
  [[ -x "$h" ]] && existe tmux-estado || { aviso "patch 56 is not installed"; return; }
  # Each tab simulates a running Claude (not a shell) with a given screen.
  tm -f /dev/null new-session -d -s dev -n base "exec sleep 600"
  local p w; p="$(tm display -p -t dev:base '#{pane_id}')"; w="$(tm display -p -t dev:base '#{window_id}')"
  ev() { printf '%s' "$2" | E env TMUX_PANE="$p" bash "$h" "$1"; }
  cs() { tm show -wqv -t "$1" @cs; }
  ev prompt '{"prompt":"x"}'
  [[ "$(tm show -wqv -t "$w" @cfase)" == pensando && "$(cs "$w")" == "🧠 thinking"* ]] && ok "prompt → 🧠 thinking" || falla "prompt: $(cs "$w")"
  ev tool '{"tool_name":"Bash","tool_input":{"command":"npm test"}}'
  [[ "$(cs "$w")" == "🔧 Bash"* && "$(tm show -wqv -t "$w" @cdet)" == "Bash: npm test" ]] && ok "tool → 🔧 Bash and what it is doing (Bash: npm test)" || falla "tool: $(cs "$w")"
  tm set -w -t "$w" @cdesde "$(( $(date +%s) - 130 ))"; tm set -w -t "$w" @cts "$(date +%s)"; E tmux-estado --todas
  [[ "$(cs "$w")" == "🔧 Bash 2m" ]] && ok "the time advances with the status bar (2m)" || falla "time: $(cs "$w")"
  ev wait '{"notification_type":"permission_prompt","message":"Claude needs your permission to use Bash"}'
  [[ "$(cs "$w")" == "✋ approve Bash"* && "$(tm show -wqv -t "$w" @cmain)" == "te necesita" ]] && ok "permission → ✋ approve Bash (the watcher still sees «te necesita»)" || falla "permission: $(cs "$w")"
  ev wait '{"notification_type":"elicitation_dialog","message":"Pick an option"}'
  [[ "$(cs "$w")" == "❓ asking you"* ]] && ok "question → ❓ asking you" || falla "question: $(cs "$w")"
  ev compact '{"trigger":"auto"}'
  [[ "$(cs "$w")" == "📦 compacting"* ]] && ok "PreCompact → 📦 compacting" || falla "compact: $(cs "$w")"
  ev start '{"source":"compact"}'
  [[ "$(tm show -wqv -t "$w" @cfase)" == pensando ]] && ok "after an automatic compact it keeps thinking" || falla "after compacting: $(tm show -wqv -t "$w" @cfase)"
  # «Waiting for you»: Claude's last message decides between 👉 waiting for you and ✔ done (without tmux: --pide).
  # Spanish on purpose: the three transcripts are what Claude writes when the owner works in Spanish.
  local tq="$T/tq.jsonl" tn="$T/tn.jsonl" tc="$T/tc.jsonl"
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"Hice el cambio.\n\n¿Lo subo o prefieres revisarlo antes?"}]}}' > "$tq"
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"Para aplicarlo, corre:\n\n```bash\nbash install.sh\n```"}]}}' > "$tc"
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"¿Qué archivo?"}]}}' '{"type":"assistant","message":{"content":[{"type":"text","text":"Listo: las 12 pruebas pasan y el cambio quedó guardado."}]}}' > "$tn"
  bash "$h" --pide "$tq" && bash "$h" --pide "$tc" && ! bash "$h" --pide "$tn" \
    && ok "waiting for you: detects a closing question and a request to run something; not an informative ending" || falla "«waiting for you» detection"
  ev "done" "$(jq -nc --arg t "$tq" '{transcript_path: $t}')"
  [[ "$(cs "$w")" == "👉 waiting for you"* && "$(tm show -wqv -t "$w" @cmain)" == "te toca" ]] && ok "Stop with a question → 👉 waiting for you (the watcher counts it)" || falla "waiting for you: $(cs "$w")"
  ev prompt '{"prompt":"x"}'; ev tool '{"tool_name":"Bash","tool_input":{"command":"npm test"}}'
  ev "done" '{}'
  [[ "$(cs "$w")" == "✔ done" && "$(tm show -wqv -t "$w" @cdet)" == "last: Bash: npm test" && -n "$(tm show -wqv -t "$w" @cturno_txt)" ]] \
    && ok "Stop → ✔ done, with the last thing it did and the duration of the turn" || falla "done: $(cs "$w") / $(tm show -wqv -t "$w" @cdet)"
  # Self-correction (no hook reports it): from what is on screen.
  pestana() {   # name text-on-screen phase seconds-ago → window id
    tm new-window -d -t dev -n "$1" "printf '%b\n' '$2'; exec sleep 600"; sleep 0.3
    local v; v="$(tm display -p -t "dev:$1" '#{window_id}')"
    tm set -w -t "$v" @cfase "$3"; tm set -w -t "$v" @cpane "$(tm display -p -t "dev:$1" '#{pane_id}')"
    tm set -w -t "$v" @cts "$(( $(date +%s) - $4 ))"; tm set -w -t "$v" @cdesde "$(( $(date +%s) - $4 ))"; echo "$v"
  }
  local wi wl ws wp wb
  wi="$(pestana int '  ⎿  Interrupted by user\n> ' pensando 30)"
  wl="$(pestana idle '● Done, finished.\n> ' herramienta 30)"
  ws="$(pestana spin '✻ Thinking… (esc to interrupt)' pensando 700)"
  wp="$(pestana perm 'Do you want to proceed?\n❯ 1. Yes\n  2. No' permiso 40)"
  tm new-window -d -t dev -n shell "bash --norc --noprofile"; sleep 0.3
  wb="$(tm display -p -t dev:shell '#{window_id}')"; tm set -w -t "$wb" @cfase pensando
  tm set -w -t "$wb" @cpane "$(tm display -p -t dev:shell '#{pane_id}')"; tm set -w -t "$wb" @cts "$(( $(date +%s) - 30 ))"
  E tmux-estado --todas
  [[ "$(cs "$wi")" == "⛔ interrupted"* ]] && ok "Esc (Interrupted on screen) → ⛔ interrupted" || falla "interrupted: $(cs "$wi")"
  [[ "$(cs "$wl")" == "✔ done"* ]] && ok "no hook but Claude already waits for your message → ✔ done (it does not get stuck)" || falla "stuck: $(cs "$wl")"
  [[ "$(cs "$ws")" == "⏳ stalled 11m" ]] && ok "working without events for 11 min → ⏳ stalled" || falla "stalled: $(cs "$ws")"
  [[ "$(cs "$wp")" == "✋ approve"* ]] && ok "the permission dialog is still on screen → still ✋ approve" || falla "permission visible: $(cs "$wp")"
  [[ -z "$(cs "$wb")" ]] && ok "Claude no longer runs in the tab → the state is cleared" || falla "left Claude: $(cs "$wb")"
  tm kill-server 2>/dev/null
}

prueba_ux() {
  socket_de ux
  seccion "Menus and UX: active tabs, scenes, monitor, model switch"
  existe tmux-activas && existe tmux-hud || { aviso "patch 58 is not installed"; return; }
  tm -f /dev/null new-session -d -s repos -n api "exec sleep 600"; tm new-window -d -t repos -n web "exec sleep 600"
  tm new-session -d -s code -n kit "exec sleep 600"
  local ahora; ahora=$(date +%s)
  # With tmux-estado installed the state is repainted from @cfase/@cdet: they are set the way the hooks set them.
  tm set -w -t repos:api @cfase herramienta; tm set -w -t repos:api @cdet "Bash: npm test"; tm set -w -t repos:api @cs "🔧 Bash 2m"
  tm set -w -t repos:api @cts "$ahora"; tm set -w -t repos:api @cdesde "$ahora"
  tm set -w -t code:kit @cfase permiso; tm set -w -t code:kit @cdet "Bash: terraform plan"; tm set -w -t code:kit @cs "✋ approve Bash"
  tm set -w -t code:kit @cts "$ahora"; tm set -w -t code:kit @cdesde "$ahora"
  sleep 1.2
  local r; r="$(E tmux-activas --lista --minutos 0 | cut -f2- | sed 's/\x1b\[[0-9;]*m//g')"
  [[ "$(head -1 <<<"$r")" == *kit*approve* && "$(sed -n 2p <<<"$r")" == *api*Bash* && "$(wc -l <<<"$r")" == 2 ]] \
    && ok "active tabs: first what is waiting for you, then what is working; idle ones are left out" || falla "tmux-activas: $r"
  mkdir -p "$TH/.local/bin"; [[ -f "$TH/.local/bin/tmux-saver" ]] || printf 'ESCENAS=(aurora oceano)\n' > "$TH/.local/bin/tmux-saver"
  tm set -g @saver_scene oceano
  r="$(E tmux-escena --lista)"
  grep -qP '^oceano\t✓' <<<"$r" && grep -q '^aleatoria' <<<"$r" && ok "scene picker: list with the current one marked" || falla "tmux-escena: $r"
  local pr="$TH/.claude/projects/-rec-a"; mkdir -p "$pr"
  printf '%s\n' '{"type":"user","cwd":"/rec/a","gitBranch":"feature/REC-1","message":{"content":"fix the billing login right now please"}}' \
    '{"type":"assistant","message":{"content":[{"type":"text","text":"Done, the billing login is fixed."}]}}' > "$pr/rec1.jsonl"
  r="$(E env XDG_RUNTIME_DIR="$T" tmux-recientes --lista | sed 's/\x1b\[[0-9;]*m//g')"
  grep -q $'^abrir\t/rec/a\trec1\t' <<<"$r" && grep -q 'feature/REC-1.*fix the billing login' <<<"$r" \
    && ok "recent: lists conversations with branch and last request, ready to resume" || falla "tmux-recientes: $r"
  r="$(E tmux-hud)"; [[ "$r" == *CPU*RAM*NET*Claude* ]] && ok "monitor: CPU, RAM, network and Claude on the second line" || falla "tmux-hud: $r"
  # Model switch from the menu: clears what is typed if Claude is waiting; if it is working, it does not interrupt it.
  if [[ -f "$RH/.local/lib/ws-ruteo.sh" ]] && existe cr; then
    mkdir -p "$TH/.local/lib" "$T/fake-claude"; cp "$RH/.local/lib/ws-ruteo.sh" "$TH/.local/lib/"
    # Fake «Claude»: a copy of cat named claude (tmux recognizes Claude by the process name),
    # which ignores Ctrl+C and echoes every line it receives.
    cp "$(command -v cat)" "$T/fake-claude/claude"
    local sock; sock="$(ls -d "$T/s/$SOCK"/tmux-*/default)"
    cm() {   # window text-on-screen → what the «Claude» received
      tm new-window -d -t repos -n "$1" "printf '%s\\n' '$2'; trap '' INT; exec $T/fake-claude/claude"; sleep 0.4
      local pc; pc="$(tm display -p -t "repos:$1" '#{pane_id}')"
      tm select-window -t "repos:$1"; tm send-keys -t "$pc" -l 'previous text'; sleep 0.2   # the menu acts on the current tab
      E env TMUX="$sock,1,0" TMUX_PANE="$pc" WS_RUTEO_LOG="$T/ruteo.log" cr --cambiar sonnet >/dev/null 2>&1; sleep 0.6
      tm capture-pane -p -t "$pc"
    }
    r="$(cm waits 'waiting')"
    grep -qx '/model claude-sonnet-5-5' <<<"$r" && ! grep -q 'previous text/model' <<<"$r" && ok "model: if Claude is waiting, it clears what is typed and sends /model alone" || falla "model (waiting): $r"
    r="$(cm works 'Working… (esc to interrupt)')"
    grep -q 'previous text/model claude-sonnet-5-5' <<<"$r" && ok "model: if Claude is working, it does not interrupt it (no Ctrl+C is sent)" || falla "model (working): $r"
  else aviso "routing is not installed: the model switch test is skipped"; fi
  tm kill-server 2>/dev/null
}

prueba_nivel() {
  socket_de nivel
  seccion "Protection per tab: completo, normal, puro"
  existe tmux-nivel || { aviso "patch 59 is not installed"; return; }
  local s="$T/s59.json" r
  printf '%s' '{"permissions":{"allow":["Bash(ls:*)"],"ask":["Bash(terraform apply*)"],"deny":["Read(~/.aws/**)"]},"sandbox":{"enabled":true,"excludedCommands":["docker"]},"hooks":{"PreToolUse":[{"hooks":[{"type":"command","command":"~/.claude/hooks/audit.sh tool"},{"type":"command","command":"~/.claude/hooks/guard.sh"}]},{"hooks":[{"type":"command","command":"~/.claude/hooks/tmux-state.sh tool"}]}]},"statusLine":{"type":"command","command":"~/.claude/statusline.sh"}}' > "$s"
  r="$(E tmux-nivel --perfil completo "$s")"
  jq -e '(.sandbox | (.enabled == true) and (.allowUnsandboxedCommands == false) and (has("excludedCommands") | not))
         and (.permissions.deny == ["Read(~/.aws/**)"]) and (.permissions.allow | length == 1) and ([.hooks[][].hooks[].command] | any(test("guard")))' <<<"$r" >/dev/null \
    && ok "completo: sandbox with no escape hatches or excluded commands; keeps permissions and hooks" || falla "completo: $r"
  r="$(E env PATH="$T/fc59x:$TH/.local/bin:/usr/bin:/bin" WS_NIVELES_DIR="$T/niv" tmux-nivel --comando completo 2>&1)" || true
  [[ "$r" == *"cannot remove the commands excluded"* || "$r" == *"--setting-sources project,local"* ]] \
    && ok "completo starts without the user settings (or says so if Claude does not allow it)" || falla "completo command: $r"
  # «completo» with a folder: reads stay in that project (denies the roots.txt folders and re-allows the repo).
  mkdir -p "$T/ais/code/a/src" "$T/ais/code/b" "$TH/.config/tmux-claude"; git -C "$T/ais/code/a" init -q 2>/dev/null
  cp "$TH/.config/tmux-claude/roots.txt" "$T/roots.bak" 2>/dev/null; printf 'code|1|%s\n' "$T/ais/code" > "$TH/.config/tmux-claude/roots.txt"
  r="$(E env WS_WINHOME=/does/not/exist tmux-nivel --perfil completo "$s" "$T/ais/code/a/src" | jq -r --arg d "/$T/ais/code" '[(.sandbox.filesystem.denyRead | index($d) != null), (.sandbox.filesystem.allowRead | index($d + "/a") != null), (.sandbox.filesystem.allowRead | index($d + "/b") == null)] | all')"
  [[ -f "$T/roots.bak" ]] && cp "$T/roots.bak" "$TH/.config/tmux-claude/roots.txt"
  [[ "$r" == "true" ]] && ok "completo: sandboxed commands only read the tab's project" || falla "completo without isolating reads: $r"
  r="$(E tmux-nivel --perfil puro "$s")"
  jq -e '(.permissions.ask == null) and (.permissions.allow == null) and (.permissions.deny == ["Read(~/.aws/**)"]) and (.sandbox.enabled == false)
         and ([.hooks[][].hooks[].command] | any(test("guard"))) and ([.hooks[][].hooks[].command] | any(test("tmux-state")))
         and (.statusLine.command | test("statusline"))' <<<"$r" >/dev/null \
    && ok "puro: no sandbox or allow/ask; keeps the floor (deny and guard), the status line and the state" || falla "puro: $r"
  # The kit does not pre-authorize reads of cloud credentials and ships the deny floor (ADR-013).
  jq -e '(.permissions.allow | any(test("^Bash\\(az \\* ")) | not)
         and (.permissions.deny | (index("Read(~/.ssh/**)") != null) and (index("Bash(ws-secret get*)") != null) and (index("Bash(git config *ws.gate*)") != null))' \
     "$RH/.claude/settings.json" >/dev/null && ok "settings: no az wildcards in allow and with the deny floor" || falla "settings without the ADR-013 floor"
  mkdir -p "$T/fc59"; printf '#!/bin/bash\n[[ "$1" == --help ]] && echo "  --setting-sources <sources>"\n' > "$T/fc59/claude"; chmod +x "$T/fc59/claude"
  r="$(E env PATH="$T/fc59:$TH/.local/bin:/usr/bin:/bin" WS_NIVELES_DIR="$T/niv" tmux-nivel --comando puro)"
  [[ "$r" == "claude -c --setting-sources project,local --settings '$T/niv/puro.json'" && "$(stat -c %a "$T/niv/puro.json")" == 600 ]] \
    && ok "puro starts with --setting-sources project,local and its profile (0600)" || falla "puro command: $r"
  tm -f /dev/null new-session -d -s dev "bash --norc --noprofile"; local p w; p="$(tm display -p -t dev '#{pane_id}')"; w="$(tm display -p -t dev '#{window_id}')"
  E env PATH="$T/fc59:$TH/.local/bin:/usr/bin:/bin" WS_NIVELES_DIR="$T/niv" tmux-nivel completo "$p" >/dev/null 2>&1; sleep 0.4
  [[ "$(tm show -wqv -t "$w" @cnivel)" == completo && "$(tm capture-pane -p -t "$p")" == *"claude -c --setting-sources project,local --settings"*completo*.json* ]] \
    && ok "switching level restarts Claude with its profile and marks the tab (🔒)" || falla "tmux-nivel completo: level=$(tm show -wqv -t "$w" @cnivel) · $(tm capture-pane -p -t "$p" | grep -v '^$' | tail -3)"
  tm kill-server 2>/dev/null
}

prueba_reinicio_todas() {
  socket_de reinicio
  seccion "Restart Claude in all tabs"
  existe tmux-claude-restart && grep -q -- '--todas' "$TH/.local/bin/tmux-claude-restart" || { aviso "restart of all tabs is not installed"; return; }
  local p1 p2 w1 w2 antes r p
  # The simulated Claude is a bash script and tmux would see it as «bash» (a terminal without Claude, which --todas
  # skips). Here it is launched under another process name, like the real Claude.
  tm -f /dev/null new-session -d -s dev -n free -c "$T/repos" "bash --norc"; sleep 0.5
  p1="$(tm display -p -t dev: '#{pane_id}')"; w1="$(tm display -p -t "$p1" '#{window_id}')"
  tm new-window -d -t dev -n working -c "$T/repos" "bash --norc"; sleep 0.4
  p2="$(tm display -p -t dev:working '#{pane_id}')"; w2="$(tm display -p -t "$p2" '#{window_id}')"
  for p in "$p1" "$p2"; do
    tm send-keys -t "$p" "export PATH='$TH/.local/bin:$FB:/usr/bin:/bin' WST_LOG='$T/claude.log'; ( exec -a claude-test bash '$FB/claude' )" Enter
  done; sleep 1
  tm set -w -t "$w1" @cpane "$p1" \; set -w -t "$w1" @cfase listo \; set -w -t "$w2" @cpane "$p2" \; set -w -t "$w2" @cfase pensando
  r="$(E tmux-claude-restart --todas --lista)"
  [[ "$r" == *"restart"*"free"* && "$r" == *"busy"*"working"*"(pensando)"* ]] && ok "--lista: restarts the idle one and leaves the one that is working" || falla "restart --lista: «$r» (tmux sees: $(tm list-panes -a -F '#{pane_current_command}' | tr '\n' ' '))"
  antes="$(wc -l < "$T/claude.log" 2>/dev/null || echo 0)"
  E tmux-claude-restart --todas >/dev/null 2>&1; sleep 2
  [[ "$(wc -l < "$T/claude.log")" == "$(( antes + 1 ))" && "$(tm capture-pane -p -t "$p1")" == *claude-resume* && "$(tm capture-pane -p -t "$p2")" != *claude-resume* ]] \
    && ok "exits and re-enters only in the idle tab, resuming the conversation" || falla "restart of all tabs: $(tm capture-pane -p -t "$p1" | tail -2)"
  tm kill-server 2>/dev/null
}

prueba_menus_coherencia() {
  seccion "Menus: what they promise exists (without opening tmux)"
  local mm sinp=""
  for mm in "$TH"/.config/tmux-claude/menu*.tmux; do
    [[ "$(grep -c 'status-interval' "$mm")" == 3 && "$(tail -1 "$mm")" == "set -gF status-interval"* ]] || sinp+=" ${mm##*/}"
  done
  [[ -z "$sinp" ]] && ok "each menu pauses the status bar refresh while it is open and restores it on closing" || falla "menus that do not pause the status bar:$sinp"
  local c="$TH/.config/tmux-claude" f k fz="" sn="" teclas
  # 1. Every function a script opens by name (fn=…) is defined in functions.sh.
  for f in $(grep -rhoE '\bfn=[a-z_]+' "$TH/.local/bin" 2>/dev/null | sort -u | cut -d= -f2); do
    bash -c ". '$c/functions.sh' 2>/dev/null; declare -F '$f' >/dev/null" || fz+=" $f"
  done
  [[ -z "$fz" ]] && ok "the functions that open tabs exist (tw, two…)" || falla "undefined functions:$fz"
  # 2. Every «(Ctrl+b X)» a menu announces has its bind in the configuration (bind [-r] X …, without the -n ones).
  teclas=" $(grep -hE '^bind(-key)?( -r)? +[^-]' "$TH/.tmux.conf" "$c"/ux.tmux "$c"/maravillas.tmux 2>/dev/null \
              | sed -E 's/^bind(-key)?( -r)? +//' | awk '{ print $1 }' | tr -d "'\"\\\\" | tr '\n' ' ')"
  while IFS= read -r k; do   # with read and not with for: a key like «*» must not expand to the files of the folder
    [[ -n "$k" ]] || continue
    [[ "$teclas" == *" $k "* ]] || sn+=" $k"
  done < <(grep -rhoE '\(Ctrl\+b [^ )]+\)' "$c"/menu*.tmux 2>/dev/null | sed -E 's/\(Ctrl\+b (.*)\)/\1/' | sort -u)
  [[ -z "$sn" ]] && ok "every «Ctrl+b X» shortcut announced in a menu exists" || falla "shortcuts announced without a bind:$sn"
  # 3. The help does not mention entries that are gone.
  ! grep -qiE 'Playwright|stop and GIF|presentation mode' "$TH/.local/bin/tmux-help" 2>/dev/null && ok "the help does not announce retired options" || falla "tmux-help announces options that do not exist"
  # 4. Every script a menu calls is installed and executable.
  fz=""
  # shellcheck disable=SC2088  # the tilde is part of the text searched for in the menus
  for f in $(grep -rhoE '~/\.local/bin/[A-Za-z0-9_-]+' "$c"/menu*.tmux "$c"/ux.tmux "$c"/maravillas.tmux "$TH/.tmux.conf" 2>/dev/null | sort -u); do
    [[ -x "$TH/${f#\~/}" ]] || fz+=" ${f##*/}"
  done
  [[ -z "$fz" ]] && ok "all the scripts the menus call are installed" || falla "missing scripts:$fz"
}

prueba_otel() {
  seccion "Local OpenTelemetry collector (ws-otel)"
  existe ws-otel && existe ws-telemetria || { aviso "ws-otel is not installed"; return; }
  local puerto=$(( 20000 + RANDOM % 20000 )) run="$T/otel-run" u t r f
  mkdir -p "$run"; u="http://127.0.0.1:$puerto"; t="$(date +%s)000000000"
  O() { E env WS_OTEL_PUERTO="$puerto" XDG_RUNTIME_DIR="$run" ws-otel "$@"; }
  O iniciar >/dev/null 2>&1 && O estado >/dev/null 2>&1 && ok "the collector starts in the background and listens only on 127.0.0.1" || { falla "ws-otel did not start"; return; }
  post() { curl -s -o /dev/null -w '%{http_code}' -m 5 -X POST -H "Content-Type: ${3:-application/json}" "$u/v1/$1" -d "$2"; }
  r="$(post logs '{"resourceLogs":[{"resource":{"attributes":[{"key":"user.email","value":{"stringValue":"person@example.com"}}]},"scopeLogs":[{"logRecords":[
    {"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"api_request"}},{"key":"model","value":{"stringValue":"claude-sonnet-5-5"}},{"key":"duration_ms","value":{"stringValue":"1200"}},{"key":"ttft_ms","value":{"intValue":"350"}},{"key":"cost_usd","value":{"doubleValue":0.05}}]},
    {"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"claude_code.api_error"}},{"key":"status_code","value":{"stringValue":"529"}},{"key":"error","value":{"stringValue":"private-error-detail"}}]},
    {"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"claude_code.user_prompt"}},{"key":"prompt","value":{"stringValue":"free-text-otel token=secret-value-otel"}},{"key":"prompt_length","value":{"intValue":"18"}}]},
    {"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"claude_code.tool_decision"}},{"key":"tool_name","value":{"stringValue":"Bash"}},{"key":"decision","value":{"stringValue":"reject"}},{"key":"source","value":{"stringValue":"user_reject"}},{"key":"tool_parameters","value":{"stringValue":"{\"bash_command\":\"kubectl get pods --key=private-value-otel\"}"}}]}]}]}]}')"
  r+=" $(post metrics '{"resourceMetrics":[{"scopeMetrics":[{"metrics":[{"name":"claude_code.active_time.total","unit":"s","sum":{"dataPoints":[{"timeUnixNano":"'"$t"'","asDouble":120,"attributes":[{"key":"type","value":{"stringValue":"user"}}]}]}}]}]}]}')"
  r+=" $(post traces '{"resourceSpans":[{"scopeSpans":[{"spans":[{"name":"claude_code.llm_request","traceId":"a","spanId":"b","startTimeUnixNano":"'"$t"'","endTimeUnixNano":"'"$t"'","attributes":[{"key":"ttft_ms","value":{"intValue":"350"}}]}]}]}]}')"
  r+=" $(post logs 'xx' application/x-protobuf) $(curl -s -o /dev/null -w '%{http_code}' -m 5 -X POST "$u/other" -d '{}')"
  [[ "$r" == "200 200 200 415 404" ]] && ok "receives events, metrics and traces as JSON; rejects protobuf and other paths" || falla "collector responses: $r"
  f="$(ls "$TH"/.local/share/ws-telemetria/otel/*.jsonl 2>/dev/null | head -1)"
  [[ -n "$f" && "$(stat -c %a "$f")" == 600 ]] && grep -q 'free-text-otel' "$f" && grep -q 'private-error-detail' "$f" && ! grep -q 'secret-value-otel' "$f" \
     && grep -q '"programa":"kubectl"' "$f" && ok "stores everything (0600), with the secrets masked and the command's program apart" || falla "collector file: ${f:-no file}"
  # No-content mode: same posts, without texts or identity.
  local run0="$T/otel-run0" d0="$T/otel-none" p0=$(( puerto + 1 ))
  mkdir -p "$run0"; E env WS_OTEL_PUERTO="$p0" XDG_RUNTIME_DIR="$run0" WS_OTEL_DIR="$d0" WS_OTEL_CONTENIDO=0 ws-otel iniciar >/dev/null 2>&1
  curl -s -o /dev/null -m 5 -X POST -H 'Content-Type: application/json' "http://127.0.0.1:$p0/v1/logs" -d '{"resourceLogs":[{"resource":{"attributes":[{"key":"user.email","value":{"stringValue":"person@example.com"}}]},"scopeLogs":[{"logRecords":[{"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"claude_code.user_prompt"}},{"key":"prompt","value":{"stringValue":"free-text-otel"}},{"key":"prompt_length","value":{"intValue":"16"}}]}]}]}]}'
  E env WS_OTEL_PUERTO="$p0" XDG_RUNTIME_DIR="$run0" ws-otel detener >/dev/null 2>&1
  grep -q '"prompt_length":16' "$d0"/*.jsonl 2>/dev/null && ! grep -qE 'free-text-otel|person@example' "$d0"/*.jsonl \
    && ok "with WS_OTEL_CONTENIDO=0 it stores neither texts nor identity" || falla "no-content mode: $(cat "$d0"/*.jsonl 2>/dev/null | head -2)"
  rm -f "$TH/.local/share/ws-telemetria/.ultimo"; E ws-telemetria build >/dev/null 2>&1
  r="$(python3 - "$TH/.local/share/ws-telemetria/tablero.html" <<'PY'
import json, re, sys
d = json.loads(re.search(r"const D = (\{.*?\});\nconst \$", open(sys.argv[1], encoding="utf-8").read(), re.S).group(1)).get("otel") or {}
a = d.get("api") or {}
print(a.get("llamadas"), a.get("med_ms"), a.get("errores"), a.get("ttft_med_ms"), (d.get("errores") or [{}])[0].get("codigo"),
      (d.get("permisos") or [{}])[0].get("rechaza"), (d.get("activo") or [{}])[0].get("tuyo_min"))
PY
)"
  [[ "$r" == "1 1200.0 1 350 529 1 2.0" ]] && ok "the dashboard adds up latency, errors per code, permissions and active time" || falla "otel block of the dashboard: $r"
  O detener >/dev/null 2>&1; ! O estado >/dev/null 2>&1 && ok "the collector stops" || falla "ws-otel is still running"
}

prueba_informe() {
  seccion "Full report (ws-informe)"
  existe ws-informe && existe ws-telemetria || { aviso "ws-informe is not installed"; return; }
  # Spanish on purpose: the prompts feed the recurring-prompt normalizer, which works on prompts typed in Spanish.
  local d="$TH/.claude/projects/-mnt-c-repos-inf" ts i r; mkdir -p "$d"; ts="$(date -u +%FT%TZ)"
  for i in 1 2 3; do
    printf '{"type":"user","sessionId":"inf%s","cwd":"/mnt/c/repos/inf","timestamp":"%s","message":{"content":"Revisa el PR de cobros y dime los riesgos %s"}}\n{"type":"assistant","sessionId":"inf%s","cwd":"/mnt/c/repos/inf","timestamp":"%s","message":{"id":"inf%s","model":"claude-opus-5-5","content":[{"type":"tool_use","name":"Task","input":{"subagent_type":"reviewer-inf","model":"haiku"}}],"usage":{"input_tokens":10,"output_tokens":100}}}\n{"type":"user","sessionId":"inf%s","timestamp":"%s","message":{"content":"<command-name>/compact</command-name>"}}\n' \
      "$i" "$ts" "$i" "$i" "$ts" "$i" "$i" "$ts" > "$d/inf$i.jsonl"
  done
  r="$(E env WS_INFORME_SIN_WINDOWS=1 ws-informe --json 2>&1)"
  jq -e '(.agentes | any(.tipo == "reviewer-inf" and .usos == 3)) and (.recurrentes | any(.frase | test("revisa pr cobros"))) and (.comandos | any(.comando == "/compact"))' <<<"$r" >/dev/null \
    && ok "measures agents, recurring prompts and slash commands" || falla "ws-informe --json: ${r:0:300}"
  jq -e '(.tokens.salida > 0) and (.tokens.palabras_tuyas > 0) and (.tendencia.semanas | length == 12) and (.estimacion_base | length >= 1)
         and (.ideas | type == "array") and (.aprendizaje.memorias >= 0) and (.recurrentes | all(.frase | test("^session being continued") | not))' <<<"$r" >/dev/null \
    && ok "measures tokens, words, weekly trend, estimation baseline, learning and ideas" || falla "ws-informe --json without the new blocks"
  E env WS_INFORME_SIN_WINDOWS=1 ws-informe >/dev/null 2>&1
  local f; f="$(ls "$TH"/.local/share/ws-telemetria/informes/informe-*.html 2>/dev/null | head -1)"
  [[ -n "$f" ]] && grep -q 'Recurring prompts' "$f" && grep -q 'Tokens and words' "$f" && grep -q 'Estimation baseline' "$f" && ! grep -q 'cobros y dime los riesgos 2' "$f" \
    && ok "builds the HTML and Markdown report without the text of the prompts" || falla "HTML report: ${f:-no file}"
}

prueba_traspaso() {
  seccion "Export work to another Claude and learn from you"
  existe ws-traspaso && existe ws-aprender || { aviso "patch 61 is not installed"; return; }
  local fc="$T/fc61" r="$T/r61" d f; mkdir -p "$fc" "$r"
  cat > "$fc/claude" <<'FAKE'
#!/bin/bash
echo "$*" >> "$WST_LOG.61"
p="${*: -1}"
case "$p" in
  *"HANDOFF PACKAGE"*) cat >/dev/null; printf '## Goal\nFinish the billing\n' ;;
  *"STABLE FACTS"*) echo '[{"sujeto":"Andrés","predicado":"prefers","objeto":"Conventional Commits","evidencia":"x"},{"sujeto":"Andrés","predicado":"uses","objeto":"tmux","evidencia":"y"}]' ;;
  *"slash commands"*) cat >/dev/null; echo '[{"nombre":"review-billing","descripcion":"Reviews a billing PR","prompt":"Review $ARGUMENTS"}]' ;;
  *"mempalace_kg_add"*) cat > "$WST_LOG.61.kg"; echo "Saved 1" ;;
esac
FAKE
  chmod +x "$fc/claude"
  ( cd "$r" && git init -q && git checkout -qb feature/COB-7 && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -q --allow-empty -m "chore: init" )
  d="$TH/.claude/projects/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$r")"; mkdir -p "$d"
  printf '%s\n' '{"type":"user","message":{"content":"fix the billing; password=abc12345"}}' \
    '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"TodoWrite","input":{"todos":[{"content":"Validate amounts","status":"completed"},{"content":"Test retries","status":"pending"}]}},{"type":"tool_use","name":"Edit","input":{"file_path":"'"$r"'/src/billing.ts"}}]}}' > "$d/s1.jsonl"
  local cg=(env PATH="$fc:$TH/.local/bin:/usr/bin:/bin" WST_LOG="$T/log" WS_TRASPASO_SIN_WINDOWS=1 WS_INFORME_SIN_WINDOWS=1)
  E "${cg[@]}" ws-traspaso "$r" --conversacion >/dev/null 2>&1
  f="$(ls "$TH"/.local/share/ws-telemetria/traspasos/r61-*.md 2>/dev/null | head -1)"
  [[ -n "$f" ]] && grep -q '## Goal' "$f" && grep -q 'feature/COB-7' "$f" && grep -q '\[ \] Test retries' "$f" && grep -q 'src/billing.ts' "$f" \
    && [[ -f "${f%.md}.jsonl" ]] && ! grep -q 'abc12345' "$f" \
    && ok "handoff: Claude's summary, branch, tasks, files and conversation; secrets redacted" || falla "ws-traspaso: $(head -c 400 "$f" 2>/dev/null)"
  printf '1\n' | E "${cg[@]}" ws-aprender hechos >/dev/null 2>&1
  grep -q 'Conventional Commits' "$T/log.61.kg" 2>/dev/null && ! grep -q '"tmux"' "$T/log.61.kg" \
    && ok "learn: only the facts you choose are saved to MemPalace" || falla "ws-aprender hechos: $(cat "$T/log.61.kg" 2>/dev/null)"
  grep -q 'mcp__mempalace__mempalace_diary_read' "$T/log.61" && ok "learn: Claude only reads MemPalace when proposing" || falla "ws-aprender without the read tools"
  # Spanish on purpose: recurring prompts for the normalizer of ws-informe (see prueba_informe).
  for i in 1 2 3; do printf '{"type":"user","sessionId":"ap%s","cwd":"/mnt/c/repos/ap","timestamp":"%s","message":{"content":"Revisa el PR de cobros por favor ahora %s"}}\n' "$i" "$(date -u +%FT%TZ)" "$i" > "$d/ap$i.jsonl"; done
  printf '1\n' | E "${cg[@]}" WS_APRENDER_COMANDOS="$T/cmds" ws-aprender comandos >/dev/null 2>&1
  [[ -f "$T/cmds/review-billing.md" ]] && grep -q 'ARGUMENTS' "$T/cmds/review-billing.md" && ok "commands: creates the /command you chose" || falla "ws-aprender comandos"
}

