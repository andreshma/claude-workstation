#!/usr/bin/env bash
#
# ws-test — behavior tests of the whole workstation (tmux + Claude + extensions).
#
# Usage:
#   ws-test            DETERMINISTIC tests: isolated HOME, tmux and Claude (Claude and the API are
#                      simulated). They do not touch your session, your tabs or your accounts, or spend usage.
#   ws-test --ai       also, NON-DETERMINISTIC tests with the real Claude and API (they spend a little
#                      usage; tolerant: they retry and validate by pattern, not by exact text).
#   ws-test --list    lists the tests
# Exits with 1 if any deterministic test fails. The --ai ones only warn.
set -uo pipefail
AI=0
case "${1:-}" in --ai) AI=1 ;; --list) grep -E '^test_[a-z_]+\(\)' "$0" | sed 's/() {.*//; s/^test_/  /'; exit 0 ;; esac

OK=0 FAILED=0 WARNED=0
ok()   { printf '  \e[32mok\e[0m     %s\n' "$1"; OK=$((OK + 1)); }
fail() { printf '  \e[31mFAIL\e[0m   %s\n' "$1"; FAILED=$((FAILED + 1)); }
warn() { printf '  \e[33mwarn\e[0m   %s\n' "$1"; WARNED=$((WARNED + 1)); }
section() { printf '\n\e[1m== %s\e[0m\n' "$1"; }
chk() { local d="$1"; shift; if "$@" >/dev/null 2>&1; then ok "$d"; else fail "$d"; fi; }

RH="$HOME"                           # real home (only READ, to copy what is installed)
unset TMUX TMUX_PANE                 # no tmux of these tests may be able to talk to your real session
# Nor run with the profile of the tab you start them from (ws-profile, ADR-021).
unset WS_PROFILE WS_PROFILE_PANE WS_MEMORY AZURE_CONFIG_DIR GH_CONFIG_DIR KUBECONFIG AZURE_TOKEN_CREDENTIALS WS_AGENT
# The fixtures marked «Spanish on purpose» need the Spanish patterns: «es» means English AND Spanish (see ws-lang),
# whatever language you have chosen. The tests of the selector itself set their own.
export WS_LANG=es
T="$(mktemp -d)"; TH="$T/home"; FB="$T/fakebin"
# Each test uses its own socket directory: a server that is shutting down does not get in the way of the next one.
SOCK=base
use_socket() { SOCK="$1"; mkdir -p "$T/s/$SOCK"; }
cleanup() {
  local d; for d in "$T"/s/*/; do [[ -d "$d" ]] || continue
    # -S with the exact path of the test socket and without TMUX: with TMUX set (running inside
    # tmux), "tmux kill-server" points at the REAL server and used to close all your tabs.
    for sock in "$d"tmux-*/default "$d"tmux-*/popup; do
      [[ -S "$sock" ]] && env -u TMUX tmux -S "$sock" kill-server 2>/dev/null
    done; done
  rm -rf "$T"
}
trap cleanup EXIT

#######################################
# Isolated environment: copy of what is installed + simulated Claude and ant (API).
#######################################
setup() {
  mkdir -p "$TH/.local/bin" "$TH/.config" "$TH/.local/share" "$FB/versions" "$T/s" "$T/dest" "$T/repos"
  cp -a "$RH/.local/bin/." "$TH/.local/bin/" 2>/dev/null
  rm -f "$TH/.local/bin/claude" "$TH/.local/bin/ant"   # neither the real Claude nor your API session in these tests
  # The kit's libraries (ws-routing.sh, ws-lang.sh and its packs); not the rest of ~/.local/lib.
  mkdir -p "$TH/.local/lib"; for d in "$RH"/.local/lib/ws-*; do [[ -e "$d" ]] && cp -a "$d" "$TH/.local/lib/"; done
  for d in tmux-claude claude-solo ws-telemetry; do [[ -d "$RH/.config/$d" ]] && cp -a "$RH/.config/$d" "$TH/.config/"; done
  # What the normal level adds (only the kit file: the generated profiles of your home stay out).
  mkdir -p "$TH/.config/claude-levels"
  [[ -f "$RH/.config/claude-levels/normal-adds.json" ]] && cp "$RH/.config/claude-levels/normal-adds.json" "$TH/.config/claude-levels/"
  # Your own choices come along with the copy and could flip a test: they are dropped from the copy only.
  rm -f "$TH/.config/tmux-claude/"{no-ble,appearance,settings,lang}
  [[ -f "$RH/.tmux.conf" ]] && cp "$RH/.tmux.conf" "$TH/.tmux.conf"
  [[ -f "$RH/.blerc" ]] && cp "$RH/.blerc" "$TH/.blerc"
  [[ -d "$RH/.local/share/blesh" ]] && ln -s "$RH/.local/share/blesh" "$TH/.local/share/blesh"
  mkdir -p "$TH/.tmux/plugins"
  [[ -d "$RH/.tmux/plugins/tmux-resurrect" ]] && cp -a "$RH/.tmux/plugins/tmux-resurrect" "$TH/.tmux/plugins/"
  # Test Claude data (conversations, saved tmux) for backup/restore.
  mkdir -p "$TH/.claude/projects/-repo/s1/subagents" "$TH/.claude/todos" "$TH/.local/share/tmux/resurrect"
  for i in 1 2; do printf '{"type":"user","n":%d}\n' "$i" > "$TH/.claude/projects/-repo/c$i.jsonl"; done
  echo '{"a":1}' > "$TH/.claude/projects/-repo/s1/subagents/agent-1.jsonl"
  echo '{}' > "$TH/.claude/settings.json"; echo SECRET > "$TH/.claude/.credentials.json"
  echo '{"hasCompletedOnboarding":true,"mcpServers":{}}' > "$TH/.claude.json"

  # Simulated Claude, named after its version like the native binary (e.g. 2.1.999).
  cat > "$FB/versions/2.1.999" <<'EOF'
#!/bin/bash
# --version and any non-interactive use answer and exit: only "wait for /exit" in a pane.
[[ "${1:-}" == --version ]] && { echo "2.1.999 (Claude Code)"; exit 0; }
[[ "${1:-}" == --help ]] && { echo "  --setting-sources <sources>"; exit 0; }
if [[ "${1:-}" == auth && "${2:-}" == status ]]; then
  if [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then echo "Organization: ${ORG_PERSONAL:-Personal Org}"; else echo "Organization: Company"; fi
  echo "Email: test@example.com"; exit 0
fi
if [[ " $* " == *" -p "* ]]; then cat >/dev/null; echo "ls -la"; exit 0; fi
[[ -t 0 ]] || exit 0
echo "cfg=${CLAUDE_CONFIG_DIR:-work} args=$*" >> "$WST_LOG"
while IFS= read -r l; do [[ "$l" == *"/exit" ]] && exit 0; done
EOF
  chmod +x "$FB/versions/2.1.999"; ln -s "$FB/versions/2.1.999" "$FB/claude"
  # Simulated API (ant): returns the typed text + "pods -A" and its token usage.
  cat > "$FB/ant" <<'EOF'
#!/bin/bash
b="$(cat)"; t="$(jq -r '.messages[0].content' <<<"$b" | sed -n 's/^Typed text: //p')"
printf '{"content":[{"type":"text","text":"%spods -A"}],"usage":{"input_tokens":120,"output_tokens":8}}\n' "$t"
EOF
  # Simulated copilot session (only the file exists; there are never real credentials).
  mkdir -p "$TH/.config/anthropic-copilot/credentials"; echo '{}' > "$TH/.config/anthropic-copilot/credentials/default.json"
  chmod +x "$FB/ant"
}

# Variables of the isolated environment for each test command.
# The XDG folders are unset so the scripts use the isolated home: CI runners set XDG_CONFIG_HOME, and the kit's
# scripts then read and wrote favorites and folder roots outside it.
E() { env -u TMUX -u CLAUDE_CONFIG_DIR -u CLAUDECODE -u WS_PROFILE -u WS_MEMORY -u XDG_CONFIG_HOME -u XDG_DATA_HOME -u XDG_STATE_HOME -u XDG_CACHE_HOME HOME="$TH" TMUX_TMPDIR="$T/s/$SOCK" PATH="$TH/.local/bin:$FB:/usr/bin:/bin" \
      TERM=xterm-256color WST_LOG="$T/claude.log" WS_TELEMETRY_WIN="$T/win" WS_BACKUP_DEST="$T/dest" WS_BACKUP_LOCK="$T/backup.lock" WS_BACKUP_MIN_GB=0 WS_RECOVER_WAIT=3 "$@"; }
tm() { E tmux "$@"; }
have() { [[ -x "$TH/.local/bin/$1" ]]; }
# fake_tmux <dir> — puts in <dir> a «tmux» that starts nothing: it logs each call in $FAKE_TMUX_LOG, answers
# `show … @option` with $FAKE_TMUX_<option> and any -p / -P query with a fixed id. For checks that only compare
# what a script asks tmux to do (old and new spelling of a setting), without a server.
fake_tmux() {
  mkdir -p "$1"
  cat > "$1/tmux" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >> "${FAKE_TMUX_LOG:-/dev/null}"
case "${1:-}" in
  show|show-options) o="${!#}"; v="FAKE_TMUX_${o#@}"; [[ -n "${!v:-}" ]] && echo "${!v}" ;;
  *) [[ " $* " == *" -p "* || " $* " == *" -P "* ]] && echo "%1" ;;
esac
exit 0
EOF
  chmod +x "$1/tmux"
}

#######################################
# Deterministic tests
#######################################
test_config() {
  use_socket config
  section "tmux configuration and menus"
  local tmp; tmp="$(mktemp)"; grep -vE '^[[:space:]]*run(-shell)?\b' "$TH/.tmux.conf" > "$tmp"
  local r; r="$(tm -f /dev/null new-session -d -s load \; source-file "$tmp" 2>&1)"
  [[ -z "$r" ]] && ok ".tmux.conf loads without errors" || fail ".tmux.conf: $r"
  local m
  for m in "$TH"/.config/tmux-claude/menu*.tmux; do
    [[ -f "$m" ]] || continue
    r="$(tm source-file -n "$m" 2>&1)"; [[ -z "$r" ]] && ok "${m##*/}" || fail "${m##*/}: $r"
  done
  tm kill-server 2>/dev/null; rm -f "$tmp"
}

# pane_with_claude — dev session with a pane running the simulated Claude; prints the pane id.
pane_with_claude() {
  tm -f /dev/null new-session -d -s dev -n "${1:-repo}" -c "$T/repos" "bash --norc"; sleep 0.5
  local p; p="$(tm display -p -t dev: '#{pane_id}')"
  tm send-keys -t "$p" "export PATH='$TH/.local/bin:$FB:/usr/bin:/bin' WST_LOG='$T/claude.log'; claude" Enter; sleep 1
  echo "$p"
}

# conversation_in <folder> [no] — gives the folder a conversation Claude can continue (what claude-resume looks for);
# with «no», removes it: a tab where Claude never received a message.
conversation_in() {
  local d; d="$TH/.claude/projects/${1//[^A-Za-z0-9]/-}"
  if [[ "${2:-}" == no ]]; then rm -rf "$d"; else mkdir -p "$d" && echo '{"type":"user"}' > "$d/c1.jsonl"; fi
}

test_solo_mode() {
  use_socket solo_mode
  section "Solo mode"
  have tmux-solo || { warn "tmux-solo is not installed"; return; }
  : > "$T/claude.log"; local p; p="$(pane_with_claude api)"
  # A tab where Claude never received a message: «claude -c» would end with «No conversation found to continue».
  conversation_in "$T/repos" no
  E tmux-solo this "$p" >/dev/null 2>&1; sleep 2
  [[ "$(tm show -wqv -t dev: @csolo)" == 1 ]] && ok "switching to solo mode marks the tab" || fail "solo mode: no @csolo mark"
  tail -1 "$T/claude.log" | grep -q -- 'args=--permission-mode auto --settings .*/solo\.json$' && ok "in a tab without a conversation, solo mode starts a new Claude with the same flags" || fail "solo mode without a conversation ($(tail -1 "$T/claude.log"))"
  conversation_in "$T/repos"
  E tmux-solo this "$p" >/dev/null 2>&1; sleep 2
  tail -1 "$T/claude.log" | grep -q -- 'args=--continue --permission-mode auto --settings' && ok "reopens Claude in auto inside the sandbox, resuming the conversation" || fail "solo mode: Claude was not reopened with the flags ($(tail -1 "$T/claude.log"))"
  E tmux-solo normal "$p" >/dev/null 2>&1; sleep 2
  [[ -z "$(tm show -wqv -t dev: @csolo)" ]] && tail -1 "$T/claude.log" | grep -q 'args=--continue --settings .*/normal\.json$' && ok "going back to normal resumes at the normal level" || fail "going back to normal ($(tail -1 "$T/claude.log"))"
  git -C "$T/repos" init -q -b main 2>/dev/null; git -C "$T/repos" -c user.email=t@t -c user.name=t -c core.hooksPath=/dev/null commit -q --allow-empty -m "chore: test repo"
  E tmux-solo worktree "$T/repos" >/dev/null 2>&1; sleep 1
  ls -d "$T"/repos.wt/solo-* >/dev/null 2>&1 && ok "worktree solo/<date> created" || fail "solo mode worktree"
  tm kill-server 2>/dev/null
}

test_accounts() {
  use_socket accounts
  section "Claude accounts"
  have claude-account || { warn "claude-account is not installed"; return; }
  E claude-account setup >/dev/null 2>&1
  [[ -L "$TH/.claude-personal/projects" && ! -e "$TH/.claude-personal/.credentials.json" ]] \
    && ok "personal shares conversations and NOT credentials" || fail "personal account setup"
  jq -e '.hasCompletedOnboarding' "$TH/.claude-personal/.claude.json" >/dev/null 2>&1 && ok "personal gets the startup state (no login screen)" || fail "personal without the startup state"
  echo x > "$TH/.claude-personal/.credentials.json"
  : > "$T/claude.log"; local p; p="$(pane_with_claude api)"
  # A tab where Claude never received a message: the switch starts a new Claude instead of failing to continue.
  conversation_in "$T/repos" no
  E claude-account tab "$p" >/dev/null 2>&1; sleep 2
  tail -1 "$T/claude.log" | grep -q "cfg=$TH/.claude-personal args=--settings [^ ]*/normal\.json\$" && ok "in a tab without a conversation, switching account starts a new Claude with its login" || fail "switch without a conversation ($(tail -1 "$T/claude.log"))"
  conversation_in "$T/repos"
  E claude-account tab "$p" >/dev/null 2>&1; sleep 2
  tail -1 "$T/claude.log" | grep -q 'cfg=work args=--continue --settings [^ ]*/normal\.json$' && ok "back to the work account" || fail "going back to the work account ($(tail -1 "$T/claude.log"))"
  E claude-account tab "$p" >/dev/null 2>&1; sleep 2
  tail -1 "$T/claude.log" | grep -q "cfg=$TH/.claude-personal args=--continue" && ok "switching to personal reopens the same conversation with its login" || fail "switch to personal ($(tail -1 "$T/claude.log"))"
  E claude-account tab "$p" >/dev/null 2>&1; sleep 2   # the checks below start from the work account
  E ORG_PERSONAL=Company claude-account tab "$p" >/dev/null 2>&1
  [[ "$(tm show -wqv -t dev: @caccount)" == work ]] && ok "refuses if both accounts are in the same organization" || fail "organization safeguard"
  # Account per project: the shell that opens in the repo (or in one of its worktrees) takes the pinned account;
  # outside it, it does not.
  local pa="$T/proj-a" pb="$T/proj-b" cs="$TH/.config/tmux-claude/accounts.sh"
  mkdir -p "$pa/src" "$pa.wt/branch" "$pb"; ( cd "$pa" && git init -q )
  E env -u TMUX claude-account project personal "$pa/src" >/dev/null 2>&1
  q() { ( cd "$1" && env -u CLAUDE_CONFIG_DIR ${2:+CLAUDE_CONFIG_DIR="$2"} HOME="$TH" bash -c ". '$cs'; echo \"\${CLAUDE_CONFIG_DIR:-work}\"" ); }
  [[ "$(q "$pa/src")" == "$TH/.claude-personal" && "$(q "$pa.wt/branch")" == "$TH/.claude-personal" && "$(q "$pb")" == work ]] \
    && ok "account per project: the repo and its worktrees open with its account; another project, with the default one" || fail "account per project: $(q "$pa/src") / $(q "$pa.wt/branch") / $(q "$pb")"
  E env -u TMUX claude-account project work "$pb" >/dev/null 2>&1
  [[ "$(q "$pb" "$TH/.claude-personal")" == work ]] && ok "the project's account wins over the one for new tabs" || fail "the pinned account did not win: $(q "$pb" "$TH/.claude-personal")"
  E env -u TMUX claude-account project remove "$pa" >/dev/null 2>&1
  [[ "$(q "$pa/src")" == work ]] && E env -u TMUX claude-account projects | grep -q "work *$pb" && ok "the pinned account can be removed and listed" || fail "removing or listing the pinned account"
  q="$(E claude-account status 2>/dev/null)"; grep -q 'personal: Organization: Personal Org' <<<"$q" && ok "claude-account status shows each organization" || fail "claude-account status"
  tm kill-server 2>/dev/null
}

test_persistence() {
  use_socket persistence
  section "Tab persistence"
  [[ -d "$TH/.tmux/plugins/tmux-resurrect" ]] && have tmux-recover || { warn "no tmux-resurrect or tmux-recover"; return; }
  local R="$TH/.local/share/tmux/resurrect" conf="$T/persist.conf"
  printf 'set -g @resurrect-dir "%s"\nrun-shell "~/.local/bin/tmux-recover --mark-startup"\nrun-shell "%s/.tmux/plugins/tmux-resurrect/resurrect.tmux"\nrun-shell -b "~/.local/bin/tmux-recover --auto-startup"\n' "$R" "$TH" > "$conf"
  tm -f "$conf" new-session -d -s dev -n one -c /tmp; for n in two three; do tm new-window -t dev -n "$n" -c /tmp; done; sleep 1
  E "$TH/.tmux/plugins/tmux-resurrect/scripts/save.sh" quiet; sleep 1
  # A good save gets its date refreshed on every check, so the date means «last confirmed».
  touch -d '2 hours ago' "$(readlink -f "$R/last")"; E tmux-recover --validate
  (( $(date +%s) - $(stat -c %Y "$(readlink -f "$R/last")") < 60 )) \
    && ok "checking a good save refreshes its date (confirmed now)" || fail "tmux-recover --validate did not refresh the date of the save"
  tm kill-server; sleep 1
  # The save is days old on purpose: resurrect discards saves equal to the previous one, so tabs that did not change
  # keep an old file, and an age limit used to leave them unrestored.
  touch -d '3 days ago' "$R"/tmux_resurrect_*.txt
  tm -f "$conf" new-session -d -s dev -n empty -c /tmp; sleep 1
  local n0; n0="$(ls "$R"/tmux_resurrect_*.txt | wc -l)"
  have tmux-save-now && { E tmux-save-now; [[ "$(ls "$R"/tmux_resurrect_*.txt | wc -l)" == "$n0" ]] && ok "does not save in the first minutes after starting" || fail "tmux-save-now overwrote the save at startup"; }
  E "$TH/.tmux/plugins/tmux-resurrect/scripts/save.sh" quiet; sleep 6     # empty "bad" save
  [[ "$(tm list-windows -t dev | wc -l)" -ge 3 ]] && ok "restores the tabs by itself if the session ended up empty, even from a save that is days old" || fail "did not restore at startup ($(tm list-windows -t dev | wc -l) tabs)"
  tm kill-server 2>/dev/null
}

test_popups() {
  use_socket popups
  section "Interactive floating windows"
  have tmux-popup-run || { warn "tmux-popup-run is not installed"; return; }
  tm -f /dev/null new-session -d -s dev -n outside; local val; val="$(tm display -p '#{socket_path},#{pid},0')"
  # </dev/null: with the terminal as input, `timeout` leaves `script` in the background and the system
  # stops it when it touches the terminal (it did not even get to create its file).
  E timeout 20 script -qec "TMUX='$val' tmux-popup-run bash -c 'tmux display -p \"#S\" > $T/popup.out; echo \"cwd=\$PWD\" >> $T/popup.out'" "$T/popup.typescript" </dev/null >/dev/null 2>"$T/popup.err"
  grep -q '^dev$' "$T/popup.out" 2>/dev/null && ok "inside, the commands control the outer tmux" || fail "popup: it does not see the outer tmux"
  if grep -q '^cwd=' "$T/popup.out" 2>/dev/null; then ok "runs in its own tmux session (scroll, copy, search)"
  else fail "popup: the inner session did not run"; cat "$T/popup.err" "$T/popup.typescript" 2>/dev/null | tr -d '\r'  | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' | grep -v '^$' | tail -4 | sed 's/^/           /'; fi
  [[ ! -e "$T/s/popups/tmux-$(id -u)/popup" ]] && ok "the popup server's socket file is removed when its last window closes" || fail "tmux-popup-run left its dead socket behind"
  local n=0 m; local -a missing=(); for m in "$TH"/.config/tmux-claude/menu*.tmux "$TH/.tmux.conf"; do [[ -f "$m" ]] || continue
    grep 'display-popup' "$m" | grep -v 'tmux -L\|tmux-popup-run\|tmux-scratch' | grep -q '\.local/bin/' && { n=$((n + 1)); missing+=("${m##*/}"); }; done
  (( n == 0 )) && ok "all the menus use interactive popups" || warn "popups without tmux-popup-run in: ${missing[*]}"
  tm kill-server 2>/dev/null
}

test_backup() {
  use_socket backup
  section "Backup and restore"
  have ws-backup-lite && have ws-restore-lite || { warn "no ws-backup-lite"; return; }
  E timeout 300 ws-backup-lite --now </dev/null >/dev/null 2>&1 && ls "$T"/dest/claude-lite-*.tar.* >/dev/null 2>&1 && ok "backup created" || { fail "ws-backup-lite"; return; }
  local r; r="$(E timeout 120 ws-restore-lite --test </dev/null 2>&1)"
  grep -q 'Can be restored' <<<"$r" && ok "the restore test passes" || fail "ws-restore-lite --test"
  grep -q 'no credentials inside' <<<"$r" && ok "the backup carries no credentials" || fail "credentials in the backup"
}

test_saver() {
  use_socket saver
  section "Screensaver"
  have tmux-saver || { warn "tmux-saver is not installed"; return; }
  local s r bad=()
  if have tmux-art; then   # ASCII art: every scene draws without error, in two sizes and in 256 colours
    bad=()
    for s in $(E tmux-art --list); do
      r="$(COLUMNS=100 LINES=30 E timeout 60 tmux-saver --test "$s" 12 2>&1 >/dev/null)" && [[ -z "$r" ]] || bad+=("$s")
      r="$(COLUMNS=60 LINES=20 WS_ART_COLOR=256 E timeout 60 tmux-art "$s" --test 4 2>&1 >/dev/null)" && [[ -z "$r" ]] || bad+=("$s-small")
      [[ "$(COLUMNS=100 LINES=30 E tmux-art "$s" --text 12 | grep -c '[^ ]')" -ge 12 ]] || bad+=("$s-empty")
      grep -q "\\[$s\\]=" "$TH/.local/bin/tmux-scene" || bad+=("$s-no-description")
    done
    mkdir -p "$T/gal-empty"   # gallery without images (or without chafa): falls back to an art scene, no error
    r="$(COLUMNS=80 LINES=24 WS_GALLERY="$T/gal-empty" E timeout 60 tmux-saver --test gallery 3 2>&1 | head -c 300 | wc -c)"; (( r > 0 )) || bad+=("gallery-no-fallback")
    if python3 -c 'import numpy' 2>/dev/null; then
      [[ "$(E tmux-art --list | wc -l)" == "$(E tmux-art --all | wc -l)" ]] || bad+=("engine-not-listed")
    else
      warn "no numpy: the shading engine scenes are not tested (sudo apt install python3-numpy)"
      r="$(COLUMNS=80 LINES=24 E tmux-art ocean --test 2 2>&1 >/dev/null)"; [[ "$r" == *numpy* ]] || bad+=("engine-no-warning")
    fi
    (( ${#bad[@]} == 0 )) && ok "ASCII art: every scene draws, also on a small screen and in 256 colours" || fail "ASCII art with errors: ${bad[*]}"
    # The menu reads the list from tmux-saver: it has to name the same scenes as tmux-art, and no retired one.
    r="$(diff <(sed -n 's/^SCENES=(random gallery \(.*\))$/\1/p' "$TH/.local/bin/tmux-saver" | tr ' ' '\n' | sort) <(E tmux-art --all | sort))"
    [[ -z "$r" ]] && ok "the scene menu and tmux-art name the same scenes" || fail "scenes out of sync: $r"
    printf 'scene=invasion\n' > "$TH/.config/tmux-claude/appearance"
    r="$(COLUMNS=80 LINES=24 E timeout 5 tmux-saver </dev/null 2>/dev/null | head -c 200 | wc -c)"; rm -f "$TH/.config/tmux-claude/appearance"
    (( r > 0 )) && ok "a saved scene that was retired falls back to random" || fail "retired scene: the screensaver drew nothing"
    # Preferences saved before the rename: the Spanish key and scene name are still read; the English key wins.
    printf 'escena=cumbres\n' > "$TH/.config/tmux-claude/appearance"; r="$(E tmux-saver --saved-scene)"
    printf 'scene=ocean\n' >> "$TH/.config/tmux-claude/appearance"
    if [[ "$r" == peaks && "$(E tmux-saver --saved-scene)" == ocean ]]; then ok "an appearance file from before the rename (escena=cumbres) is still read"; else fail "old appearance file: «$r»"; fi
    rm -f "$TH/.config/tmux-claude/appearance"
    tm -f /dev/null new-session -d -s saver
    printf 'tema=claro\nescena=nevada\nminutos=7\n' > "$TH/.config/tmux-claude/appearance"; E tmux-theme apply >/dev/null 2>&1
    if [[ "$(tm show -gqv @theme_mode)" == light && "$(tm show -gqv @saver_scene)" == snowfall && "$(tm show -gqv lock-after-time)" == 420 ]]
    then ok "tmux-theme applies an old appearance file (tema=claro, escena=, minutos=)"; else fail "old appearance file: theme=$(tm show -gqv @theme_mode) scene=$(tm show -gqv @saver_scene)"; fi
    rm -f "$TH/.config/tmux-claude/appearance"; tm set -gu @saver_scene
    tm set -w -t saver: @cmain "your turn"
    r="$(COLUMNS=80 LINES=24 WS_ART_SEED=1 E timeout 3 tmux-saver </dev/null 2>/dev/null | head -c 200 | wc -c)"
    (( r > 0 )) && ok "the screensaver shows up even if a tab is at «your turn» (waiting for you)" || fail "the screensaver does not show up with a tab at «your turn»"
    tm set -w -t saver: @cmain "needs you"
    r="$(COLUMNS=80 LINES=24 E timeout 3 tmux-saver </dev/null 2>/dev/null | head -c 200 | wc -c)"
    (( r == 0 )) && ok "and it does not cover the screen while a permission dialog is open" || fail "the screensaver came up with a permission dialog open"
    r="$(E tmux-saver --pin peaks)"; [[ "$(sed -n 's/^scene=//p' "$TH/.config/tmux-claude/appearance")" == peaks && "$(tm show -gqv @saver_scene)" == peaks ]] \
      && ok "picking a scene saves it (the menu picker used not to save it)" || fail "tmux-saver --pin: $r"
    E tmux-saver --pin random >/dev/null; [[ -z "$(tm show -gqv @saver_scene)" ]] && ! E tmux-saver --pin does-not-exist 2>/dev/null \
      && ok "«random» releases the pinned scene and an unknown name is rejected" || fail "tmux-saver --pin random"
    tm kill-server 2>/dev/null
  fi
}

test_terminal() {
  use_socket terminal
  section "Terminal: ble.sh, completion and copilot"
  [[ -f "$TH/.config/tmux-claude/shell.sh" ]] || { warn "shell.sh is not installed"; return; }
  printf 'source ~/.config/tmux-claude/shell.sh\n' > "$TH/.bashrc"
  tm -f /dev/null new-session -d -s term -x 160 -y 30 "bash -i"; local res="" i
  for (( i = 0; i < 15; i++ )); do
    sleep 2; tm send-keys -t term 'echo "BLE=${BLE_VERSION:-no} AI=$(declare -F _ai_suggest >/dev/null && echo yes) SOURCES=${_ble_complete_auto_source[*]}"' Enter; sleep 1
    res="$(tm capture-pane -p -J -t term | grep -E '^BLE=' | tail -1)"; [[ -n "$res" ]] && break
  done
  [[ "$res" == *"AI=yes"* ]] && ok "the terminal loads the copilot (Alt+a/e/x)" || fail "shell.sh did not load ($res)"
  if [[ -n "$res" && "$res" != *"BLE=no"* ]]; then
    ok "ble.sh active (suggestions in grey)"
    tm send-keys -t term C-u; tm send-keys -t term -l 'kubectl get '
    for (( i = 0; i < 20; i++ )); do tm capture-pane -p -J -t term | grep -q 'kubectl get pods -A' && break; sleep 0.5; done
    tm send-keys -t term Right; sleep 0.5; tm send-keys -t term C-a; tm send-keys -t term -l 'echo ACCEPTED: '; tm send-keys -t term Enter; sleep 1
    tm capture-pane -p -J -t term | grep -q '^ACCEPTED: kubectl get pods -A' && ok "the AI suggests in grey and → accepts it" || fail "AI suggestion in grey"
  else warn "ble.sh is not active"; fi
  tm kill-server 2>/dev/null
  # Unit: secret redaction and circuit breaker.
  # The test token is assembled at run time: written out in full in this file, the secret scanner of
  # ws-verify and of the gate would (rightly) flag it as a possible real token.
  local tok="ghp""_ABCDEFGHIJKLMNOPQRSTUV12"
  local red; red="$(printf '%s password=Sup3r --account-key abc Bearer abcdefghijklmnop' "$tok" \
                    | E bash -c "source ~/.config/tmux-claude/ai-shell.sh 2>/dev/null; _ai_redact")"
  [[ "$red" == *"[REDACTED]"* && "$red" != *ghp_ABC* && "$red" != *Sup3r* && "$red" != *"key abc"* && "$red" != *abcdefghijklmnop* ]] && ok "the copilot removes secrets before sending" || fail "redaction: $red"
  printf '#!/bin/bash\ncat >/dev/null; exit 1\n' > "$FB/ant.fail"; chmod +x "$FB/ant.fail"
  red="$(E bash -c "mkdir -p '$T/cb'; ln -sf '$FB/ant.fail' '$T/cb/ant'; export PATH='$T/cb':\$PATH
          source ~/.config/tmux-claude/ai-shell.sh 2>/dev/null; for i in 1 2 3; do echo x | _ai_query r 5 >/dev/null; done
          _ai_api_open && echo open || echo paused")"
  [[ "$red" == *paused* ]] && ok "after 3 failures the API is paused and the fallback is used" || fail "circuit breaker"
}

test_sandbox_placeholders() {
  section "Sandbox placeholders in your repos (read-only)"
  local base="${REPOS:-}" r p found=()
  [[ -d "$base" ]] || { warn "REPOS is not set"; return; }
  # Placeholder = EMPTY file or folder in a protected path, unknown to git.
  for r in "$base"/*/; do
    [[ -d "$r/.git" ]] || continue
    while IFS= read -r p; do
      git -C "$r" ls-files --error-unmatch "${p#"$r"}" >/dev/null 2>&1 || { found+=("$(basename "$r")"); break; }
    done < <(find "$r" -maxdepth 2 -empty \( -path "${r}.claude/*" -o -name .mcp.json -o -name .vscode -o -name .gitmodules \) 2>/dev/null)
  done
  (( ${#found[@]} == 0 )) && ok "no empty sandbox placeholders" || warn "sandbox placeholders in: ${found[*]} (close Claude there and see docs/runbook.md)"
}

test_telemetry() {
  use_socket telemetry
  have ws-telemetry || { warn "ws-telemetry is not installed"; return; }
  [[ -f "$TH/.config/ws-telemetry/dashboard.template.html" ]] || { warn "the dashboard template is missing"; return; }
  # Transcript in Claude Code's real format: one prompt, one repeated answer (streaming) and another one.
  local d="$TH/.claude/projects/-mnt-c-repos-pii-mx"; mkdir -p "$d"
  {
    printf '%s\n' '{"type":"user","sessionId":"s9","cwd":"/mnt/c/repos/pii-mx","gitBranch":"main","timestamp":"2026-11-16T10:00:00Z","message":{"content":"private-prompt-text"}}'
    for id in m1 m1 m2; do
      printf '{"type":"assistant","sessionId":"s9","cwd":"/mnt/c/repos/pii-mx","timestamp":"2026-11-16T10:00:05Z","message":{"id":"%s","model":"claude-sonnet-5-5","content":[{"type":"tool_use","name":"Bash"}],"usage":{"input_tokens":10,"output_tokens":1000,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}\n' "$id"
    done
  } > "$d/s9.jsonl"
  E ws-telemetry build >/dev/null 2>&1 && [[ -s "$TH/.local/share/ws-telemetry/dashboard.html" ]] && ok "builds the dashboard" || { fail "ws-telemetry build"; return; }
  local r; r="$(E ws-telemetry summary 2>&1)"
  grep -q 'pii-mx' <<<"$r" && ok "aggregates per project" || fail "summary without the project: $r"
  # 2 unique answers (the repeated m1 is not counted twice): 2000 output + 20 input.
  grep -q '"out": 2000' "$TH/.local/share/ws-telemetry/turns.jsonl" && ok "does not count repeated answers twice" || fail "token count duplicated"
  ! grep -q 'private-prompt-text' "$TH/.local/share/ws-telemetry/"{dashboard.html,turns.jsonl} && ok "does not store the text of the prompts" || fail "the prompt text was stored"
  [[ -s "$T/win/dashboard.html" ]] && ok "copies the dashboard to the Windows folder" || fail "no copy on Windows"
  # Only your prompts open a turn: neither the output of a local command nor a meta entry; two messages in a row
  # without an answer from Claude are a single turn (with the words of both).
  local d10="$TH/.claude/projects/-mnt-c-repos-turns"; mkdir -p "$d10"
  printf '%s\n' '{"type":"user","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:00Z","isMeta":true,"message":{"content":"meta context from the system"}}' \
    '{"type":"user","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:01Z","message":{"content":"<local-command-stdout>output of a command</local-command-stdout>"}}' \
    '{"type":"user","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:02Z","message":{"content":"first"}}' \
    '{"type":"user","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:09Z","message":{"content":"second real"}}' \
    '{"type":"assistant","sessionId":"s10","cwd":"/mnt/c/repos/turns","timestamp":"2026-11-16T12:00:20Z","message":{"id":"t10","model":"claude-sonnet-5-5","content":[{"type":"text","text":"done"}],"usage":{"input_tokens":1,"output_tokens":1}}}' > "$d10/s10.jsonl"
  rm -f "$TH/.local/share/ws-telemetry/.last"; E ws-telemetry build >/dev/null 2>&1
  [[ "$(jq -c 'select(.session == "s10") | [.start, .prompt_words, .responses]' "$TH/.local/share/ws-telemetry/turns.jsonl")" == '["2026-11-16T12:00:09Z",3,1]' ]] \
    && ok "turns: only your prompts open a turn and consecutive ones without an answer are merged" || fail "turns of s10: $(jq -c 'select(.session == "s10")' "$TH/.local/share/ws-telemetry/turns.jsonl" | head -3)"
  # Trends: series per week (local Monday), model family and hour map; no raw model names as a series.
  local tj; tj="$(python3 - "$TH/.local/share/ws-telemetry/dashboard.html" <<'PY'
import json, re, sys
d = json.loads(re.search(r"const D = (\{.*?\});\nconst \$", open(sys.argv[1], encoding="utf-8").read(), re.S).group(1))
t = d.get("trends") or {}
s = [f for f in t.get("weeks", []) if f.get("turns")]
print(len(t.get("weeks", [])), len(s), s[0]["week"] if s else "-", ",".join(t.get("families", [])),
      sum(map(sum, t.get("heat", []))), len(t.get("days", [])), s[0]["models"].get("sonnet", 0) > 0 if s else False)
PY
)"
  [[ "$tj" == "12 1 2026-W47 sonnet 2 30 True" ]] && ok "trends: 12 weeks, the turn's week, model family, hour map and 30 days" || fail "dashboard trends: $tj"
  # A branch with </script> must not close the dashboard's data block (script injection).
  local dx="$TH/.claude/projects/-mnt-c-repos-xss"; mkdir -p "$dx"
  printf '%s\n' '{"type":"user","sessionId":"sx","cwd":"/mnt/c/repos/xss","gitBranch":"x</script><script>alert(1)</script>","timestamp":"2026-11-16T11:00:00Z","message":{"content":"hello world test"}}' \
    '{"type":"assistant","sessionId":"sx","cwd":"/mnt/c/repos/xss","gitBranch":"x</script><script>alert(1)</script>","timestamp":"2026-11-16T11:00:05Z","message":{"id":"mx","model":"claude-sonnet-5-5","content":[],"usage":{"input_tokens":1,"output_tokens":1}}}' > "$dx/sx.jsonl"
  rm -f "$TH/.local/share/ws-telemetry/.last"; E ws-telemetry build >/dev/null 2>&1
  ! grep -q '</script><script>alert' "$TH/.local/share/ws-telemetry/dashboard.html" && ok "the dashboard escapes </script> in the data" || fail "script injection in the dashboard"
  python3 - "$TH/.local/share/ws-telemetry/dashboard.html" <<'PY' && ok "estimation ratios: text, model and cost per turn, word and token" || fail "dashboard without estimation ratios"
import json, re, sys
d = json.loads(re.search(r"const D = (\{.*?\});\nconst \$", open(sys.argv[1], encoding="utf-8").read(), re.S).group(1)).get("ratios") or {}
n = {x["name"]: x["value"] for x in d.get("ratios", [])}
sys.exit(0 if n.get("Your words per turn", 0) > 0 and "Output tokens per visible word from Claude" in n and "Cost per turn of yours" in n else 1)
PY
  grep -q 'function trends' "$TH/.local/share/ws-telemetry/dashboard.html" && ok "the dashboard has the trends section" || fail "template without trends"
}

#######################################
# NON-deterministic tests (real Claude and API)
#######################################
retry() { local i; for i in 1 2 3; do "$@" && return 0; sleep 2; done; return 1; }

ai_accounts() {
  local om op
  om="$(env -u CLAUDE_CONFIG_DIR timeout 20 claude auth status --text </dev/null 2>/dev/null | sed -n 's/^Organization: //p')"
  op="$( [[ -d "$RH/.claude-personal" ]] && CLAUDE_CONFIG_DIR="$RH/.claude-personal" timeout 20 claude auth status --text </dev/null 2>/dev/null | sed -n 's/^Organization: //p')"
  [[ -n "$om" ]] && ok "work account logged in ($om)" || warn "work account not logged in"
  if [[ -n "$op" ]]; then [[ "$op" != "$om" ]] && ok "personal with its own organization ($op)" || warn "both accounts are in the same organization"; fi
}
ai_claude_p() { timeout 60 claude -p --model haiku --tools "" --no-session-persistence "Reply with exactly this word: ready" </dev/null 2>/dev/null | grep -qi ready; }
ai_copilot() {
  local r; r="$(printf 'Request: list the hidden files of this folder\n' | bash -c 'source ~/.config/tmux-claude/ai-shell.sh 2>/dev/null; _ai_query "Return ONLY the bash command, on one line." 100')"
  grep -qE '(^|[ ;|&])(ls|find)( |$)' <<<"$r"
}
ai_api_ghost() {
  local t0 r; t0=$(date +%s%N)
  r="$(printf 'Typed text: git commi\n' | bash -c 'source ~/.config/tmux-claude/ai-shell.sh 2>/dev/null; _ai_load_key; _ai_api "$_AI_GHOST_RULES" 60 5')" || return 1
  AI_LAT=$(( ($(date +%s%N) - t0) / 1000000 ))
  [[ "$r" == "git commi"* ]]
}
ai_auto_mode() {
  local token="auto-test-$RANDOM"
  ( cd "$(mktemp -d)" && timeout 120 claude -p --permission-mode auto --no-session-persistence \
      "Run this command with Bash: echo $token  and reply with its output only." </dev/null 2>/dev/null ) | grep -q "$token"
}

run_ai() {
  section "With the real Claude and API (non-deterministic)"
  command -v claude >/dev/null || { warn "claude is not in PATH"; return; }
  ai_accounts
  retry ai_claude_p && ok "claude -p answers (Haiku)" || warn "claude -p did not answer as expected"
  retry ai_copilot && ok "the copilot proposes a valid command (ls/find)" || warn "the copilot did not propose a recognizable command"
  if command -v ant >/dev/null && compgen -G "$RH/.config/anthropic-copilot/credentials/*.json" >/dev/null; then
    AI_LAT=0; retry ai_api_ghost && ok "API: coherent grey suggestion (${AI_LAT} ms)" || warn "API: the suggestion did not start with the typed text"
  else warn "no copilot session (ws-copilot login): the API test is skipped"; fi
  retry ai_auto_mode && ok "auto mode runs a command and returns its output" || warn "auto mode did not return the expected output"
}

#######################################
setup
test_routing() {
  section "Model routing (cr + hook)"
  [[ -x "$RH/.local/bin/cr" && -x "$RH/.claude/hooks/ws-routing.sh" ]] || { warn "routing is not installed"; return; }
  local r; r="$(HOME="$RH" "$RH/.local/bin/cr" --test 2>&1)"
  if [[ $? -eq 0 ]]; then ok "$(tail -1 <<<"$r")"; else fail "$(tail -1 <<<"$r")"; fi
  use_socket routing
  # Spanish on purpose: these prompts are what the routing rules classify (rules match prompts typed in Spanish).
  local tt="$T/s/routing" run="$T/run-routing" sock pane sql='escribe una consulta SQL que sume ventas por mes'
  mkdir -p "$run"
  # «bajar_max_ctx=» written before the rename is read like «downgrade_max_ctx=»: with the limit at 70 %, a tab at
  # 62 % is asked to switch down instead of getting the subagent suggestion (the default limit is 30 %). The hook
  # runs against a tmux that starts nothing (fake_tmux): Opus tab, 62 % of context.
  local ft="$T/fake-tmux-routing" hr="$T/home-routing" k v=()
  fake_tmux "$ft"; mkdir -p "$hr/.local" "$hr/.config"; ln -s "$RH/.local/lib" "$hr/.local/lib"; cp -a "$RH/.config/ws-routing" "$hr/.config/"
  for k in bajar_max_ctx=70 downgrade_max_ctx=70 ''; do
    printf '%s\n' "$k" > "$hr/.config/ws-routing/settings.conf"
    v+=("$(printf '{"prompt":%s}' "$(jq -Rn --arg p "$sql" '$p')" | env PATH="$ft:$PATH" TMUX_PANE=%1 FAKE_TMUX_cmodel="Opus 5.5" FAKE_TMUX_cctx=62 \
            XDG_RUNTIME_DIR="$run/old-key" WS_ROUTING_LOG="$T/log-routing-old" WS_ROUTING_NO_POPUP=1 HOME="$hr" bash "$RH/.claude/hooks/ws-routing.sh")")
  done
  if [[ "${v[0]}" == *'"block"'* && "${v[0]}" == "${v[1]}" && "${v[2]}" == *sql-quick* && "${v[2]}" != *'"block"'* ]]
  then ok "hook: the old «bajar_max_ctx=» setting is still read (same as downgrade_max_ctx=)"; else fail "bajar_max_ctx: «${v[0]}» / default: «${v[2]}»"; fi
  TMUX_TMPDIR="$tt" tmux -f /dev/null new -d -s r -x 80 -y 20
  sock="$(ls -d "$tt"/tmux-*/default)"; pane="$(TMUX_TMPDIR="$tt" tmux display -p -t r '#{pane_id}')"
  TMUX_TMPDIR="$tt" tmux set -w -t r @cmodel "Opus 5.5"
  hk() { printf '{"prompt":%s}' "$(jq -Rn --arg p "$1" '$p')" | env TMUX="$sock,1,0" TMUX_PANE="$pane" \
           XDG_RUNTIME_DIR="$run" WS_ROUTING_LOG="$T/log-routing" WS_ROUTING_NO_POPUP=1 HOME="$RH" "$RH/.claude/hooks/ws-routing.sh"; }
  [[ -z "$(hk 'implementa el endpoint de facturas con pruebas')" ]] && ok "hook: no rule → does not ask" || fail "the hook asked without a rule"
  [[ -z "$(hk 'depura por qué falla el login con 500')" ]] && ok "hook: same level → does not ask" || fail "the hook asked at the same level"
  [[ "$(hk "$sql")" == *'"block"'* ]] && ok "hook: SQL on Opus → asks for confirmation" || fail "the hook did not ask for confirmation"
  [[ "$(stat -c %a "$run/ws-routing/prompt-${pane#%}" 2>/dev/null)" == 600 ]] && ok "hook: stores the text (0600) to resend it" || fail "text not stored with 0600"
  printf '%s' "$sql" | sha256sum | cut -c1-64 > "$run/ws-routing/pass-${pane#%}"
  [[ -z "$(hk "$sql")" ]] && ok "hook: the confirmed resend goes through without asking" || fail "the confirmed resend asked again"
  [[ -z "$(hk '/model claude-sonnet-5-5 por favor')" ]] && ok "hook: ignores / commands" || fail "the hook blocked a / command"
  TMUX_TMPDIR="$tt" tmux set -g @croute off
  [[ -z "$(hk "$sql")" ]] && ok "hook: routing off → does not ask" || fail "routing off and it still asked"
  # Going down with high context: does not block; suggests the cheap subagent. With little context it does ask.
  TMUX_TMPDIR="$tt" tmux set -gu @croute
  TMUX_TMPDIR="$tt" tmux set -w -t r @cctx 62
  local s; s="$(hk "$sql")"
  [[ "$s" != *'"block"'* && "$s" == *sql-quick* ]] && ok "going down with high context → suggests the subagent, does not switch the model" || fail "going down with high context: $s"
  TMUX_TMPDIR="$tt" tmux set -w -t r @cctx 12
  [[ "$(hk "$sql")" == *'"block"'* ]] && ok "going down with little context → asks" || fail "going down with little context did not ask"
  [[ -z "$(hk "$sql /model claude-fable-5-2")" ]] && ok "hook: text with /model appended → does not ask (no loop)" || fail "the hook asked with /model appended"
  TMUX_TMPDIR="$tt" tmux set -w -t r @croute_yes "sonnet:$(date +%s)"
  [[ -z "$(hk "$sql")" ]] && ok "hook: just switched by the routing → does not ask again" || fail "the hook asked again after the switch"
  TMUX_TMPDIR="$tt" tmux set -wu -t r @croute_yes
}

test_telegram() {
  section "Telegram: notifications and answering with buttons (simulated API)"
  local W="$RH/.local/bin/ws-telegram"
  [[ -x "$W" ]] || { warn "ws-telegram is not installed"; return; }
  [[ "$(HOME="$RH" "$W" selftest 2>&1)" == ok ]] && ok "reads the dialog options and redacts secrets" || fail "ws-telegram selftest"
  # Marker files from before the rename still count (they are user settings): «apagado» keeps the notifications
  # off and «ejecutar-sin-pin» keeps ▶ Run without the PIN. No tmux needed.
  local oc="$T/tg-old"; mkdir -p "$oc"; printf 'chat_id=42\n' > "$oc/config"
  tg_old() { env HOME="$RH" WS_TELEGRAM_CFG="$oc" WS_TELEGRAM_ST="$T/tg-old-st" WS_TELEGRAM_LOG="$T/tg-old-log" WS_TELEGRAM_NO_SERVICE=1 "$W" "$@"; }
  if tg_old active && : > "$oc/apagado" && ! tg_old active && grep -q '· off' <<<"$(tg_old status)"
  then ok "the old «apagado» marker still keeps Telegram off"; else fail "ws-telegram ignores the old «apagado» marker"; fi
  rm -f "$oc/apagado"
  if grep -q 'asks for PIN' <<<"$(tg_old run)" && : > "$oc/ejecutar-sin-pin" && grep -q 'Status: no PIN' <<<"$(tg_old run)"
  then ok "the old «ejecutar-sin-pin» marker still keeps ▶ Run without the PIN"; else fail "ws-telegram ignores the old «ejecutar-sin-pin» marker"; fi
  use_socket telegram
  local tt="$T/s/telegram" g="$T/tg" sock pane
  mkdir -p "$g/cfg" "$g/st" "$g/log"; printf 'chat_id=42\nbot=test_bot\n' > "$g/cfg/config"
  # Simulated Telegram API: logs what is sent; getUpdates delivers the button requested in $g/cb ("<from> <option>").
  cat > "$g/curl" <<'EOF'
#!/usr/bin/env bash
cfg=""; while (( $# )); do [[ "$1" == -K ]] && cfg="$2"; shift; done
m="$(sed -n 's|.*/bot[^/]*/\([A-Za-z]*\)".*|\1|p' "$cfg")"; body="$(cat)"; G="${WS_TG_FAKE:?}"
printf '%s %s\n' "$m" "$body" >> "$G/calls"
case "$m" in
  sendMessage) echo '{"ok":true,"result":{"message_id":7}}' ;;
  getUpdates)
    if [[ -f "$G/msg" ]]; then read -r from rmid txt < "$G/msg"; rm -f "$G/msg"
      jq -nc --argjson from "$from" --argjson r "$rmid" --arg t "$txt" '{ok: true, result: [{update_id: 9, message: {message_id: 99, from: {id: $from}, chat: {id: $from}, text: $t, reply_to_message: {message_id: $r}}}]}'
    elif [[ -f "$G/cb" ]]; then read -r from opt < "$G/cb"; rm -f "$G/cb"
      n="$(basename "$(ls "$G"/st/pending/*.json 2>/dev/null | head -1)" .json)"
      printf '{"ok":true,"result":[{"update_id":5,"callback_query":{"id":"c1","from":{"id":%s},"message":{"chat":{"id":%s}},"data":"%s:%s"}}]}\n' "$from" "$from" "$n" "$opt"
    else echo '{"ok":true,"result":[]}'; fi ;;
  *) echo '{"ok":true,"result":true}' ;;
esac
EOF
  chmod +x "$g/curl"
  TMUX_TMPDIR="$tt" tmux -f /dev/null new -d -s tg -x 100 -y 20 \
    "bash -c 'printf \" Do you want to proceed?\n ❯ 1. Yes\n   2. Yes, and do not ask again\n   3. No (esc)\n\"; read -rsn1 k; echo CHOSEN:\$k; sleep 60'"
  sock="$(ls -d "$tt"/tmux-*/default)"; pane="$(TMUX_TMPDIR="$tt" tmux display -p -t tg '#{pane_id}')"; sleep 0.5
  tg_env() { env TMUX="$sock,1,0" HOME="$RH" WS_TELEGRAM_CFG="$g/cfg" WS_TELEGRAM_ST="$g/st" WS_TELEGRAM_LOG="$g/log" \
               WS_TELEGRAM_TOKEN=test WS_TELEGRAM_CURL="$g/curl" WS_TELEGRAM_NO_SERVICE=1 WS_TG_FAKE="$g" \
               WS_BURN_DIR="$g/burn" "$@"; }   # not the machine's /tmp/claude-burn-<uid> (your real plan usage)
  tg_env "$W" notify wait "$pane" "Claude needs your permission to use Bash"
  [[ "$(jq '.options | length' "$g"/st/outbox/*.json 2>/dev/null)" == 3 ]] && ok "the notification carries the 3 options on screen" || fail "notification without options"
  echo "99 1" > "$g/cb"; tg_env "$W" service --once
  grep -q '"inline_keyboard"' "$g/calls" 2>/dev/null && ok "sends the message with buttons" || fail "did not send buttons"
  ! grep -q 'CHOSEN' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t tg)" && grep -q unauthorized "$g"/log/*.jsonl \
    && ok "ignores buttons from another chat" || fail "accepted a button from another chat"
  echo "42 1" > "$g/cb"; tg_env "$W" service --once; sleep 0.5
  grep -q 'CHOSEN:1' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t tg)" && ok "your button 1 reaches the tab" || fail "the button did not reach the tab"
  [[ -z "$(ls "$g"/st/pending/ 2>/dev/null)" ]] && ok "the code is single-use" || fail "the code is still valid"
  grep -q 'You answered' "$g/calls" && ok "marks the message as answered" || fail "did not mark the message"
  # Emergency stop (ws-stop-all): a button pressed on the phone sends nothing.
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n stop "bash -c 'printf \" Do you want to proceed?\n ❯ 1. Yes\n   2. No (esc)\n\"; read -rsn1 k; echo STOPPED:\$k; sleep 60'"
  local pst; sleep 0.5; pst="$(TMUX_TMPDIR="$tt" tmux display -p -t tg:stop '#{pane_id}')"
  mkdir -p "$g/state"; : > "$g/state/ws-stop-all"; rm -f "$g"/st/pending/*.json
  WS_STATE_DIR="$g/state" tg_env "$W" notify wait "$pst" "Claude needs your permission to use Bash"
  echo "42 1" > "$g/cb"; WS_STATE_DIR="$g/state" tg_env "$W" service --once; sleep 0.5
  ! grep -q 'STOPPED' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pst")" && grep -qs 'stop-all' "$g"/log/*.jsonl \
    && ok "with the emergency stop on, a button sends nothing" || fail "a button reached the tab during the emergency stop"
  rm -rf "$g/state"; rm -f "$g"/st/pending/*.json
  # Routing popup answered from Telegram: the answer goes to its file, only if the popup is still waiting.
  mkdir -p "$g/run/ws-routing"; : > "$g/run/ws-routing/remote-7.waiting"
  tg_env "$W" ask "$pane" "Model routing: test" "s=Switch to sonnet;n=Stay;x=Edit" "$g/run/ws-routing/remote-7"
  echo "42 s" > "$g/cb"; tg_env "$W" service --once
  [[ "$(cat "$g/run/ws-routing/remote-7" 2>/dev/null)" == s ]] && ok "answers the routing popup from Telegram" || fail "the routing answer did not arrive"
  # Claude inside a floating window: it reads and types on the -L popup server, not on the outer tab.
  TMUX_TMPDIR="$tt" tmux -L popup -f /dev/null new -d -s ftest \
    "bash -c 'printf \" Do you want to proceed?\n ❯ 1. Yes\n   2. No (esc)\n\"; read -rsn1 k; echo POPUP:\$k; sleep 60'"; sleep 0.5
  rm -f "$g"/st/pending/*.json
  TMUX_TMPDIR="$tt" tg_env "$W" notify wait "popup:ftest" "Claude needs your permission" "$pane"
  echo "42 2" > "$g/cb"; TMUX_TMPDIR="$tt" tg_env "$W" service --once; sleep 0.5
  grep -q 'POPUP:2' <<<"$(TMUX_TMPDIR="$tt" tmux -L popup capture-pane -p -t ftest)" && ok "in a popup, the button reaches the popup" || fail "the button did not reach the popup"
  TMUX_TMPDIR="$tt" tmux -L popup kill-server 2>/dev/null
  # `!` commands proposed by Claude: one per message; ▶ Run runs only that command in that tab.
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n cmd "bash -c 'read -r l; echo \"RAN:\$l\"; sleep 60'"
  local pc; pc="$(TMUX_TMPDIR="$tt" tmux display -p -t tg:cmd '#{pane_id}')"
  rm -f "$g"/st/pending/*.json "$g"/st/outbox/*.json; : > "$g/calls"
  tg_env "$W" notify "done" "$pc" 'Finished in 0m 5s: run `! echo hello` and also `! sudo rm -rf /tmp/x`'
  [[ "$(find "$g/st/outbox" -name '*_c*.json' | wc -l)" == 2 ]] && ok "each ! command goes in its own message" || fail "commands not separated"
  : > "$g/cfg/run-no-pin"   # first the direct button (explicit option); below, with the PIN (the default)
  echo "42 r" > "$g/cb"
  WS_TELEGRAM_NO_CLAUDE_CHECK=1 WS_TELEGRAM_WAIT=10 tg_env "$W" service --once; sleep 11
  grep -q 'RAN:!echo hello' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pc")" && ok "▶ Run runs that command in the tab" || fail "the command was not run"
  grep -q 'Result' "$g/calls" && ok "sends the result as a reply" || fail "the result did not arrive"
  grep -q 'Do it on the PC' "$g/calls" && ok "dangerous commands arrive without a button" || fail "a dangerous command got a button"
  # With the PIN (the default): the button does not run anything; it asks for the PIN and only runs with the right one.
  rm -f "$g/cfg/run-no-pin" "$g"/st/pending/*.json "$g"/st/outbox/*.json; : > "$g/calls"
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n cmd2 "bash -c 'read -r l; echo \"RAN:\$l\"; sleep 60'"
  local pc2; pc2="$(TMUX_TMPDIR="$tt" tmux display -p -t tg:cmd2 '#{pane_id}')"
  tg_env "$W" notify "done" "$pc2" 'Finished in 0m 6s: run `! echo two` and also `! sudo rm -rf /tmp/y`'
  echo "42 r" > "$g/cb"; WS_TELEGRAM_PIN=4821 WS_TELEGRAM_NO_CLAUDE_CHECK=1 tg_env "$W" service --once; sleep 1
  ! grep -q 'RAN' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pc2")" && grep -q 'with your PIN' "$g/calls" && [[ -f "$g/st/to-run/7.json" ]] \
    && ok "▶ Run runs nothing: it asks for the PIN" || fail "Run with PIN: it ran without the PIN or did not ask for it"
  echo "42 7 0000" > "$g/msg"; WS_TELEGRAM_PIN=4821 WS_TELEGRAM_NO_CLAUDE_CHECK=1 tg_env "$W" service --once; sleep 1
  ! grep -q 'RAN' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pc2")" && ok "wrong PIN: does not run" || fail "ran with a wrong PIN"
  echo "42 7 4821" > "$g/msg"; WS_TELEGRAM_PIN=4821 WS_TELEGRAM_NO_CLAUDE_CHECK=1 WS_TELEGRAM_WAIT=10 tg_env "$W" service --once; sleep 11
  grep -q 'RAN:!echo two' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pc2")" && [[ ! -f "$g/st/to-run/7.json" ]] \
    && ok "with the right PIN it runs, only once" || fail "did not run with the right PIN"
  rm -f "$g/st/pin-fails"
  # Alerts: Claude error with the account button; high context with /compact; the /compact button reaches the tab.
  mkdir -p "$g/bin"; ln -sf "$(command -v sleep)" "$g/bin/2.1.999"
  # direct exec: tmux reports the foreground process (like the Claude binary, named after its version)
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n errors "printf 'API Error: 529 Overloaded\\n'; exec $g/bin/2.1.999 120"
  sleep 0.5; printf 'alerts=on\nsummary_hour=99\ncontext_pct=80\nusage_usd_h=999999\n' > "$g/cfg/settings"
  TMUX_TMPDIR="$tt" tmux set -w -t tg:errors @cctx 85
  rm -f "$g"/st/outbox/*.json "$g"/st/pending/*.json; : > "$g/calls"
  WS_TELEGRAM_NO_WORKSTATION=1 tg_env "$W" check
  grep -qs 'Overloaded' "$g"/st/outbox/*_a.json && ok "alert: Claude stopped because of an error" || fail "there was no error alert"
  grep -qs '/compact' "$g"/st/outbox/*_a.json && ok "alert: high context with the /compact button" || fail "there was no context alert"
  WS_TELEGRAM_NO_WORKSTATION=1 tg_env "$W" check
  [[ "$(ls "$g"/st/outbox/*_a.json 2>/dev/null | wc -l)" == 2 ]] && ok "alerts are not repeated on every check" || fail "repeated alerts"
  tg_env "$W" service --once
  rm -f "$g"/st/pending/*.json
  tg_env "$W" alert-test "$(TMUX_TMPDIR="$tt" tmux display -p -t tg:errors '#{pane_id}')"
  tg_env "$W" service --once
  echo "42 k" > "$g/cb"; tg_env "$W" service --once; sleep 1
  grep -q '/compact' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t tg:errors)" && ok "the /compact button reaches the tab" || fail "the /compact button did not arrive"
  # Long answer: the commands at the start arrive too (only the last 1200 characters used to be looked at).
  rm -f "$g"/st/outbox/*.json; local long_msg; long_msg="$(mktemp)"
  { printf 'First run `! node --version` and then check.\n'; head -c 6000 /dev/zero | tr '\0' 'x'; printf '\nDone.\n'; } > "$long_msg"
  tg_env "$W" notify "done" "$pc" "Finished in 2m 0s: …Done." "$pc" "$long_msg"
  grep -qs 'node --version' "$g"/st/outbox/*_c*.json && ok "commands from a long answer arrive too" || fail "the command of a long answer was lost"
  [[ ! -e "$long_msg" ]] && ok "the full message is deleted once read" || fail "the file with the full message was left behind"
  # The same command in the same tab arrives only once (even if Claude repeats it in later turns).
  rm -f "$g"/st/outbox/*.json
  tg_env "$W" notify "done" "$pc" 'Finished in 0m 3s: run `! git status`'
  tg_env "$W" notify "done" "$pc" 'Finished in 0m 4s: again, run `! git status`'
  [[ "$(grep -ls '"git status"' "$g"/st/outbox/*_c*.json | wc -l)" == 1 ]] && ok "a repeated command arrives only once" || fail "the command was repeated"
  # Text reply with the PIN to an open question: only as a Reply, single use; a wrong PIN sends nothing.
  rm -f "$g"/st/outbox/*.json "$g"/st/pending/*.json; : > "$g/cfg/text"
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n txt "bash -c 'read -r l; echo \"ARRIVED:\$l\"; sleep 60'"
  local pt; pt="$(TMUX_TMPDIR="$tt" tmux display -p -t tg:txt '#{pane_id}')"
  # Spanish on purpose: the open-question detector must also match a question opened with «¿».
  WS_TELEGRAM_PIN=4821 tg_env "$W" notify "done" "$pt" "Finished in 0m 4s: ¿Uso cursor opaco o el id?"
  WS_TELEGRAM_PIN=4821 tg_env "$W" service --once
  [[ -f "$g/st/open/7.json" ]] && grep -q 'Reply to this message' "$g/calls" && ok "the open question invites a reply" || fail "the open question was not kept"
  echo "42 7 1111 use a cursor" > "$g/msg"; WS_TELEGRAM_PIN=4821 tg_env "$W" service --once; sleep 0.5
  ! grep -q 'ARRIVED' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t "$pt")" && ok "wrong PIN: nothing is sent" || fail "it was sent with a wrong PIN"
  echo "42 7 4821 use an opaque cursor" > "$g/msg"; WS_TELEGRAM_PIN=4821 tg_env "$W" service --once; sleep 0.8
  grep -q 'ARRIVED:.*Reply from Telegram.*use an opaque cursor' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -J -t "$pt")" \
    && ok "with the PIN, your reply reaches Claude, marked" || fail "the text reply did not arrive"
  [[ ! -f "$g/st/open/7.json" ]] && ok "the open question is single-use" || fail "the question is still open"
  # Replying to a notification that did NOT say ↩ (e.g. «finished») also reaches that tab.
  rm -f "$g"/st/outbox/*.json "$g"/st/open/*.json; : > "$g/cfg/text"
  TMUX_TMPDIR="$tt" tmux new-window -d -t tg -n txt2 "bash -c 'read -r l; echo \"ARRIVED2:\$l\"; sleep 60'"
  local pt2; pt2="$(TMUX_TMPDIR="$tt" tmux display -p -t tg:txt2 '#{pane_id}')"
  WS_TELEGRAM_PIN=4821 tg_env "$W" notify "done" "$pt2" "Finished in 2m 0s: done, all set."
  WS_TELEGRAM_PIN=4821 tg_env "$W" service --once
  echo "42 7 4821 now add tests" > "$g/msg"; WS_TELEGRAM_PIN=4821 tg_env "$W" service --once; sleep 0.8
  grep -q 'ARRIVED2:.*now add tests' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -J -t "$pt2")" \
    && ok "a Reply to any notification of the tab reaches Claude" || fail "a Reply to a notification without ↩ did not arrive"
  rm -f "$g/cfg/text"
  rm -f "$g/cfg/text"
  python3 -m py_compile "$RH/.local/bin/tmux-summary" 2>/dev/null && ok "tmux-summary compiles" || fail "tmux-summary does not compile"
}

test_groups() {
  section "Tab groups and bringing conversations in"
  [[ -x "$RH/.local/bin/tmux-bring" ]] || { warn "tmux-bring is not installed"; return; }
  # «grupos=off» written before the rename works like «groups=off»: the new tab goes to the current session.
  # Compared through what tmux-open asks tmux to do (fake_tmux), so no server is needed.
  local ft="$T/fake-tmux-groups" xc="$T/xdg-groups" on_new on_old default
  fake_tmux "$ft"; mkdir -p "$xc/tmux-claude" "$T/open-here"; printf 'repos|1|%s\n' "$T" > "$xc/tmux-claude/roots.txt"
  asked() {   # line of the settings file → the tmux calls tmux-open makes to open a folder
    printf '%s' "$1" > "$xc/tmux-claude/settings"; : > "$T/open.log"
    E env PATH="$ft:$TH/.local/bin:/usr/bin:/bin" XDG_CONFIG_HOME="$xc" FAKE_TMUX_LOG="$T/open.log" tmux-open --dir "$T/open-here" >/dev/null 2>&1
    cat "$T/open.log"
  }
  on_new="$(asked $'groups=off\n')"; on_old="$(asked $'grupos=off\n')"; default="$(asked '')"
  if [[ "$on_new" == *new-window* && "$on_old" == "$on_new" && "$default" != "$on_new" ]]
  then ok "the old «grupos=off» setting is still read (same as groups=off)"; else fail "grupos=off: «$on_old» / groups=off: «$on_new» / default: «$default»"; fi
  # A folder outside every root used to get an empty group name, and tmux refused to create the session.
  local outside; mkdir -p "$T/only-root"; printf 'repos|1|%s\n' "$T/only-root" > "$xc/tmux-claude/roots.txt"
  outside="$(asked '')"
  [[ "$outside" == *"=other"* && "$outside" != *"-t = "* && "$outside" != *"-s  "* ]] \
    && ok "a folder outside every root opens in the group «other»" || fail "folder outside the roots: «$outside»"
  # Personal roots (~/.config/ws-local/roots.txt) are read next to the kit's file, which every install replaces.
  mkdir -p "$xc/ws-local"; printf 'mine|1|%s\n' "$T" > "$xc/ws-local/roots.txt"
  outside="$(asked '')"; rm -rf "$xc/ws-local"
  [[ "$outside" == *"=mine"* ]] && ok "your own roots in ws-local/roots.txt are used too" || fail "personal roots: «$outside»"
  use_socket groups
  local gh="$T/home-groups" tt="$T/s/groups" r="$T/repos-groups" d k
  mkdir -p "$gh/.config/tmux-claude" "$r/repos/api" "$r/repos/web" "$r/code/tool"
  printf 'repos|1|%s\ncode|1|%s\n' "$r/repos" "$r/code" > "$gh/.config/tmux-claude/roots.txt"
  for d in "$r/repos/api" "$r/code/tool"; do
    k="$(sed 's#[/.]#-#g' <<<"$d")"; mkdir -p "$gh/.claude/projects/$k"
    printf '{"type":"user","cwd":"%s"}\n' "$d" > "$gh/.claude/projects/$k/s-$(basename "$d").jsonl"
  done
  TMUX_TMPDIR="$tt" tmux -f /dev/null new -d -s dev -c "$r/repos/web" "sleep 120"
  # Spanish on purpose: the confirmations keep accepting «s» (sí) next to y/yes.
  echo s | env -u XDG_CONFIG_HOME HOME="$gh" TMUX_TMPDIR="$tt" "$RH/.local/bin/tmux-bring" --reorganize >/dev/null 2>&1
  local l; l="$(TMUX_TMPDIR="$tt" tmux list-windows -a -F '#S:#W')"
  grep -qx 'repos:api' <<<"$l" && grep -qx 'code:tool' <<<"$l" && ok "opens each conversation without a tab in the session of its group" || fail "groups: $l"
  grep -q '^repos:' <<<"$l" && ! grep -q '^dev:' <<<"$l" && ok "--reorganize moves the tabs from dev to their group" || fail "reorganize: $l"
  grep -q 'claude-resume --resume s-api' <<<"$(TMUX_TMPDIR="$tt" tmux capture-pane -p -t '=repos:api')" && ok "leaves the tab ready to resume (Enter), at the normal level" || fail "did not leave the resume command"
}

test_traces() {
  section "Traces, estimation, weekly report and budgets"
  local h="$RH/.claude/hooks/ws-traces.sh" r d="$TH/.claude/projects/-mnt-c-repos-estimate" now_utc ses
  [[ -x "$h" ]] || { warn "ws-traces.sh is not installed"; return; }
  have ws-telemetry || return
  r="$(mktemp -d)"; ses="s-trace"; now_utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  ( cd "$r" && git init -q && git checkout -qb feature/EST-42-payments && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -q --allow-empty -m "chore: init" )
  ev() { jq -nc --arg r "$r" --arg s "$ses" "$1" | E env WS_TRACES_DIR="$TH/.local/share/ws-telemetry/traces" XDG_RUNTIME_DIR="$T" bash "$h"; }
  ev '{hook_event_name:"SessionStart",session_id:$s,cwd:$r,source:"startup"}'
  ev '{hook_event_name:"UserPromptSubmit",session_id:$s,cwd:$r,prompt:"private-trace-text does it work?"}'
  ev '{hook_event_name:"PreToolUse",session_id:$s,cwd:$r,tool_name:"Bash",tool_use_id:"tb1"}'
  ev '{hook_event_name:"PostToolUse",session_id:$s,cwd:$r,tool_name:"Bash",tool_use_id:"tb1",tool_input:{command:"pytest -q --option=private_value_123"},tool_response:{stdout:"ok"}}'
  ev '{hook_event_name:"PostToolUse",session_id:$s,cwd:$r,tool_name:"Edit",tool_use_id:"te1",tool_input:{file_path:($r+"/src/a.py"),old_string:"x",new_string:"x\ny"}}'
  ev '{hook_event_name:"PostToolUseFailure",session_id:$s,cwd:$r,tool_name:"mcp__azure__list",tool_use_id:"tm1",tool_input:{},error:"timed out"}'
  ev '{hook_event_name:"PostToolUse",session_id:$s,cwd:$r,tool_name:"Bash",tool_use_id:"tc1",tool_input:{command:"git add -A && git -c user.name=t commit -m \"feat: x\" && git log --grep commit"},tool_response:{stdout:"ok"}}'
  ev '{hook_event_name:"Stop",session_id:$s,cwd:$r}'
  ev '{hook_event_name:"SessionEnd",session_id:$s,cwd:$r,reason:"exit"}'
  local f; f="$TH/.local/share/ws-telemetry/traces/$(date +%F).jsonl"
  [[ "$(grep -c "\"session\":\"$ses\"" "$f" 2>/dev/null)" == 8 ]] && ok "the hook leaves one trace per event (8)" || fail "traces: $(wc -l < "$f" 2>/dev/null) lines"
  [[ "$(grep '"id":"tc1"' "$f" | jq -r .commits)" == 1 ]] && ok "counts the command's git commit (and not a git log that mentions it)" || fail "commits of the command: $(grep '"id":"tc1"' "$f")"
  # End of a session without its start: takes the time of the conversation's first message and counts the commits
  # from there.
  local tp2="$T/conv-no-start.jsonl"; printf '{"type":"user","timestamp":"%s","message":{"content":"x"}}\n' "$(date -u -d '-2 minutes' +%FT%TZ)" > "$tp2"
  ( cd "$r" && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -q --allow-empty -m "feat: from the conversation" )
  jq -nc --arg r "$r" --arg tp "$tp2" '{hook_event_name:"SessionEnd",session_id:"s-no-start",cwd:$r,reason:"other",transcript_path:$tp}' \
    | E env WS_TRACES_DIR="$TH/.local/share/ws-telemetry/traces" XDG_RUNTIME_DIR="$T" bash "$h"
  [[ "$(grep '"session":"s-no-start"' "$f" | jq -r '[.commits, .since] | @tsv')" == $'2\tconversation' ]] \
    && ok "on ending without a start, it counts the commits since the first message" || fail "end without start: $(grep '"session":"s-no-start"' "$f")"
  grep -q '"action":"pytest","programs":\["pytest"\]' "$f" && grep -q '"ticket":"EST-42"' "$f" && grep -q '"error_type":"timeout"' "$f" \
    && ok "action, ticket of the branch and error type" || fail "trace fields: $(tail -3 "$f")"
  ! grep -qE 'private_value|private-trace-text' "$f" && ok "stores neither full commands nor the prompt text" || fail "the trace stored content"
  mkdir -p "$d"
  printf '{"type":"user","sessionId":"%s","cwd":"/mnt/c/repos/estimate","gitBranch":"feature/EST-42-payments","timestamp":"%s","message":{"content":"x"}}\n{"type":"assistant","sessionId":"%s","cwd":"/mnt/c/repos/estimate","timestamp":"%s","message":{"id":"e1","model":"claude-opus-5-5","content":[],"usage":{"input_tokens":1000,"output_tokens":100000}}}\n' \
    "$ses" "$now_utc" "$ses" "$now_utc" > "$d/$ses.jsonl"
  grep -q 'pytest' <<<"$(E ws-telemetry traces --days 1 2>&1)" && ok "ws-telemetry traces" || fail "ws-telemetry traces"
  grep -q 'EST-42' <<<"$(E ws-telemetry estimate 2>&1)" && ok "ws-telemetry estimate (per ticket)" || fail "ws-telemetry estimate"
  r="$(E ws-telemetry estimate --by rama 2>&1)"
  grep -q '^Estimation by branch' <<<"$r" && grep -q 'feature/EST-42' <<<"$r" && ! E ws-telemetry estimate --by other >/dev/null 2>&1 \
    && ok "estimate --by still accepts the old values (rama, proyecto) and rejects an unknown one" || fail "estimate --by rama: ${r:0:200}"
  # ws-telemetry sql: the view folds the Spanish column names of old days into the English ones. DuckDB is simulated:
  # it answers the column list (DESCRIBE) and prints the view it is asked to create.
  mkdir -p "$T/fduck"
  # shellcheck disable=SC2016  # the fake's own $1 and $2
  printf '%s\n' '#!/bin/bash' 'if [[ "$1" == -cmd ]]; then printf "%s\n" "$2"; exit 0; fi' \
    'printf "%s\n" ts,VARCHAR evento,VARCHAR event,VARCHAR tipo,VARCHAR ms,BIGINT' > "$T/fduck/duckdb"; chmod +x "$T/fduck/duckdb"
  r="$(E env PATH="$T/fduck:$TH/.local/bin:/usr/bin:/bin" ws-telemetry sql 2>&1)"
  [[ "$r" == *'COALESCE("evento", "event")'*' AS "event"'* && "$r" == *"WHEN 'herramienta' THEN 'tool'"*' AS "type"'* && "$r" == *'EXCLUDE ('*'"tipo"'* ]] \
    && ok "ws-telemetry sql: old days show under the English column names and values" || fail "ws-telemetry sql view: ${r:0:300}"
  grep -q '^# Week' <<<"$(E ws-telemetry week --current 2>&1)" && ok "ws-telemetry week (Markdown)" || fail "ws-telemetry week"
  printf 'estimate=1\n' > "$TH/.config/ws-telemetry/budgets.conf"
  grep -qP '^estimate\t\d+' <<<"$(E ws-telemetry budgets --alerts 2>&1)" && ok "an exceeded budget shows up in --alerts" || fail "budgets --alerts"
  E ws-telemetry build >/dev/null 2>&1; grep -q 'EST-42' "$TH/.local/share/ws-telemetry/dashboard.html" && ok "the dashboard has the estimate per ticket" || fail "dashboard without the estimate"
  # Traces written before the rename (Spanish keys and values) add up exactly like the ones written now.
  local old="$T/traces-old" new="$T/traces-new" ts; ts="$(date -u +%FT%TZ)"; mkdir -p "$old/traces" "$new/traces"
  printf '{"ts":"%s","ts_ms":1,"evento":"PostToolUse","sesion":"s","proyecto":"p","rama":"","ticket":"","subagente":false,"tipo":"herramienta","herramienta":"Bash","accion":"pytest","programas":["pytest"],"tuberia":1,"fondo":false,"ok":true,"interrumpido":false,"bytes_entrada":23,"bytes_salida":15,"id":"a","dur_ms":40}\n{"ts":"%s","ts_ms":2,"evento":"PostToolUseFailure","sesion":"s","proyecto":"p","rama":"","ticket":"","subagente":false,"tipo":"herramienta","herramienta":"mcp__azure__list","mcp":"azure","mcp_metodo":"list","accion":"list","ok":false,"error_tipo":"salida_no_cero","interrumpido":false,"bytes_entrada":2,"bytes_salida":0,"id":"b"}\n' \
    "$ts" "$ts" > "$old/traces/$(date +%F).jsonl"
  printf '{"ts":"%s","ts_ms":1,"event":"PostToolUse","session":"s","project":"p","branch":"","ticket":"","subagent":false,"type":"tool","tool":"Bash","action":"pytest","programs":["pytest"],"pipeline":1,"background":false,"ok":true,"interrupted":false,"bytes_in":23,"bytes_out":15,"id":"a","dur_ms":40}\n{"ts":"%s","ts_ms":2,"event":"PostToolUseFailure","session":"s","project":"p","branch":"","ticket":"","subagent":false,"type":"tool","tool":"mcp__azure__list","mcp":"azure","mcp_method":"list","action":"list","ok":false,"error_type":"nonzero_exit","interrupted":false,"bytes_in":2,"bytes_out":0,"id":"b"}\n' \
    "$ts" "$ts" > "$new/traces/$(date +%F).jsonl"
  local so sn; so="$(E env WS_TELEMETRY_DIR="$old" ws-telemetry traces --days 1 --json 2>&1)"; sn="$(E env WS_TELEMETRY_DIR="$new" ws-telemetry traces --days 1 --json 2>&1)"
  if [[ "$so" == "$sn" ]] && grep -q 'nonzero_exit' <<<"$so" && grep -q 'pytest' <<<"$so"
  then ok "traces from before the rename (Spanish fields) give the same summary as the new ones"; else fail "old and new traces differ: $(diff <(echo "$so") <(echo "$sn") | head -4)"; fi
  rm -rf "$r" "$TH/.config/ws-telemetry/budgets.conf"
}

test_extras() {
  use_socket extras
  section "tmux: pane → Claude, palette, notify me, extract, labels, focus, logs"
  have tmux-pane && have ws-redact || { warn "patch 52 is not installed"; return; }
  # Test data assembled at run time («pass""word», «PRIV""ATE»): that way the kit's secret scanner is not fooled.
  local r; r="$(printf 'ok %s_%s and %s=Sup3r! %s abcdefghijk123\n%s\nabc8Q~%s\n-----BEGIN RSA %s KEY-----\nMIIx\n-----END RSA %s KEY-----\n' \
    ghp "$(printf 'a%.0s' {1..30})" "pass""word" "Bear""er" 'normal text' "$(printf 'b%.0s' {1..34})" "PRIV""ATE" "PRIV""ATE" | E ws-redact)"
  ! grep -qE 'aaaaaaaaaa|Sup3r|abcdefghijk|bbbbbbbbbb|MIIx' <<<"$r" && grep -q 'normal text' <<<"$r" \
    && ok "ws-redact masks tokens, passwords, Bearer, Azure secrets and private keys" || fail "ws-redact: $r"
  r="$(printf 'see https://dev.azure.com/org/p?x=1 in /mnt/c/repos/app/src/a.ts:12\ncommit 3f9a2c1d ABC-77 id 8c1d2f3a-1b2c-4d5e-8f90-a1b2c3d4e5f6\n' | E tmux-extract --list)"
  for t in url path hash ticket guid; do grep -q "^$t" <<<"$r" || { fail "tmux-extract did not find $t: $r"; r=""; break; }; done
  [[ -n "$r" ]] && ok "tmux-extract finds URL, path, hash, ticket and GUID"
  E env WS_NOTIFY_LOG="$T/notices" WS_NOTIFY_ME_PAUSE=0.3 tmux -f /dev/null new-session -d -s dev -x 120 -y 30 "printf 'hello\n%s=xyz\n' pass""word; sleep 60"
  local p; p="$(tm display -p -t dev '#{pane_id}')"; sleep 0.5
  r="$(E tmux-pane --text "$p")"
  grep -q hello <<<"$r" && ! grep -q xyz <<<"$r" && ok "tmux-pane builds the block for Claude, redacted" || fail "tmux-pane: $r"
  tm split-window -t dev "bash --norc --noprofile"; local p2; p2="$(tm display -p -t dev '#{pane_id}')"; sleep 0.3
  E tmux-notify-me "$p2" >/dev/null 2>&1; sleep 0.5; tm send-keys -t "$p2" 'sleep 1.5' Enter
  local i; for i in $(seq 1 30); do grep -q 'Finished «sleep»' "$T/notices" 2>/dev/null && break; sleep 0.5; done
  grep -q 'Finished «sleep»' "$T/notices" 2>/dev/null && ok "tmux-notify-me notifies when the command finishes" || fail "tmux-notify-me did not notify"
  E tmux-label "$(tm display -p -t dev '#{window_id}')" '🟡rev'; E tmux-label --bar
  [[ "$(tm show -wv -t dev @label)" == '🟡rev' && "$(tm show -gv window-status-format | grep -o '@label' | wc -l)" -le 2 ]] \
    && ok "tmux-label sets the label and the status bar shows it (no duplicates)" || fail "tmux-label"
  local wf df; wf="$(tm display -p -t dev '#{window_id}')"; df="$(tm display -p -t dev '#{pane_current_path}')"
  # Start from an empty list: the copy of your real favorites may already hold this folder, and the toggle
  # would then remove it instead of adding it.
  rm -f "$TH/.config/tmux-claude/favorites"
  E tmux-favorites --toggle "$wf" >/dev/null 2>&1
  [[ "$(tm show -wqv -t "$wf" @fav)" == 1 ]] && grep -qxF "$df" "$TH/.config/tmux-claude/favorites" && E tmux-favorites --list | grep -qF "$df" \
    && ok "tmux-favorites marks the tab, saves it and lists it" || fail "tmux-favorites did not mark it: $(cat "$TH/.config/tmux-claude/favorites" 2>&1)"
  E tmux-favorites --bar; E tmux-favorites --bar
  [[ "$(tm show -gv window-status-format | grep -o '@fav' | wc -l)" -le 2 ]] && ok "the favorites ★ goes into the status bar without duplicates" || fail "tmux-favorites --bar duplicates"
  E tmux-favorites --toggle "$wf" >/dev/null 2>&1
  [[ -z "$(tm show -wqv -t "$wf" @fav)" ]] && ! grep -qxF "$df" "$TH/.config/tmux-claude/favorites" \
    && ok "tmux-favorites removes the tab from favorites" || fail "tmux-favorites did not remove it"
  tm set -g status-right 'ORIGINAL'; E tmux-focus 25 >/dev/null
  local en; en="$(tm show -gv status-right)"; E tmux-focus off >/dev/null
  [[ "$en" == *"🎯 focus"* && "$(tm show -gv status-right)" == ORIGINAL && -z "$(tm show -gqv @focus_end)" ]] \
    && ok "focus mode changes the status bar and leaves it as it was" || fail "tmux-focus: $en / $(tm show -gv status-right)"
  r="$(printf 'all good\nERROR: failure %s=abc123\n' "tok""en" | E env WS_NOTIFY_LOG="$T/notices2" tmux-logs --filter test)"
  for i in $(seq 1 20); do [[ -s "$T/notices2" ]] && break; sleep 0.25; done   # the notification goes out in the background
  grep -q 'ERROR' <<<"$r" && grep -q 'Error in logs:test' "$T/notices2" && ! grep -q abc123 "$T/notices2" \
    && ok "tmux-logs paints the error and notifies (redacted)" || fail "tmux-logs: $(cat "$T/notices2" 2>/dev/null)"
  r="$(E tmux-palette --list 2>&1)"
  (( $(wc -l <<<"$r") > 40 )) && grep -q 'Send the neighboring pane to Claude' <<<"$r" && ok "the palette lists the options of every menu ($(wc -l <<<"$r"))" || fail "tmux-palette: ${r:0:200}"
  tm source-file -n "$TH/.config/tmux-claude/extras.tmux" && ok "extras.tmux loads" || fail "extras.tmux does not load"
  tm kill-server 2>/dev/null
}

test_tmux53() {
  use_socket tmux53
  section "tmux: CI/PR in the status bar, templates, recording, history and swarm"
  have tmux-swarm && have tmux-template || { warn "patch 53 is not installed"; return; }
  local r="$T/r53" i w
  # A template saved before the rename (Spanish instructions) builds the same panes and tabs as its English twin.
  # Compared through what tmux-template asks tmux to do (fake_tmux), so no server is needed.
  local ft="$T/fake-tmux-53" td="$TH/.config/tmux-claude/templates" es en
  fake_tmux "$ft"; mkdir -p "$td" "$T/tpl"
  printf '# old\nprincipal echo a\nderecha 30%% echo b\nabajo 40%% echo c\nventana extra true\nacomodo even-vertical\n' > "$td/old53.conf"
  printf '# new\nmain echo a\nright 30%% echo b\nbelow 40%% echo c\nwindow extra true\nlayout even-vertical\n' > "$td/new53.conf"
  es="$(E env PATH="$ft:$TH/.local/bin:/usr/bin:/bin" FAKE_TMUX_LOG="$T/tpl/es.log" tmux-template old53 "$T/tpl" 2>&1; cat "$T/tpl/es.log")"
  en="$(E env PATH="$ft:$TH/.local/bin:/usr/bin:/bin" FAKE_TMUX_LOG="$T/tpl/en.log" tmux-template new53 "$T/tpl" 2>&1; cat "$T/tpl/en.log")"
  if [[ "$es" == "$en" && "$es" == *"split-window -v -l 40%"* && "$es" == *"select-layout"*"even-vertical"* && "$es" != *"unknown instruction"* ]]
  then ok "tmux-template still reads the Spanish instructions of old templates"; else fail "old template: $(diff <(echo "$es") <(echo "$en") | head -4)"; fi
  rm -f "$td/old53.conf" "$td/new53.conf"
  mkdir -p "$r" && ( cd "$r" && git init -q && git checkout -qb feature/ABC-9-x && git remote add origin https://github.com/example/r53.git && git config user.email t@t && git config user.name t \
    && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -q --allow-empty -m "chore: init" )
  grep -q 'ABC-9' <<<"$(E env WS_BRANCH_TTL=0 tmux-branch "$r")" && ok "tmux-branch: ticket of the branch (CI/PR if gh/az are there)" || fail "tmux-branch"
  E env WS_HISTORY_DIR="$T/hist" tmux -f /dev/null new-session -d -s dev -x 160 -y 40 -c "$r" "bash --norc --noprofile"
  E env WS_BACKGROUND_EVERY=0 tmux-background; [[ "$(tm show -gv window-status-format)" == *@cbranch* ]] && ok "tmux-background adds CI/PR to the status bar" || fail "tmux-background"
  mkdir -p "$TH/.config/tmux-claude/templates"
  printf '# test\nmain echo main-ok\nright 30%% echo right-ok\nwindow extra true\n' > "$TH/.config/tmux-claude/templates/p53.conf"
  E tmux-template p53 "$r"; sleep 0.5
  w="$(tm display -p -t dev '#{window_id}')"
  [[ "$(tm list-panes -t "$w" | wc -l)" == 2 ]] && tm list-windows -t dev -F '#W' | grep -qx extra \
    && ok "tmux-template builds panes and tabs" || fail "tmux-template: $(tm list-windows -t dev -F '#W #{window_panes}' | tr '\n' ' ')"
  E tmux-template --save g53 "$w" >/dev/null && grep -q '^layout ' "$TH/.config/tmux-claude/templates/g53.conf" \
    && ok "saves the tab as a template (with its layout)" || fail "tmux-template --save"
  local p; p="$(tm display -p -t "dev:0" '#{pane_id}')"
  E env WS_RECORD_DIR="$TH/recordings" tmux-record "$p"; sleep 0.3; tm send-keys -t "$p" 'echo recorded-53' Enter; sleep 0.8
  E env WS_RECORD_DIR="$TH/recordings" tmux-record "$p"; sleep 0.5
  local c; c="$(ls "$TH"/recordings/*.cast 2>/dev/null | head -1)"
  [[ -n "$c" ]] && head -1 "$c" | grep -q '"version": 2' && grep -q 'recorded-53' "$c" && [[ -s "${c%.cast}.txt" ]] \
    && ok "tmux-record leaves a replayable .cast and a .txt" || fail "tmux-record: ${c:-no file}"
  tm send-keys -t "$p" 'echo history-unique-53' Enter; sleep 0.4
  E env WS_HISTORY_DIR="$T/hist" tmux-history --sample; E env WS_HISTORY_DIR="$T/hist" tmux-history --sample
  [[ "$(cat "$T"/hist/*/*.log 2>/dev/null | grep -cx 'history-unique-53')" == 1 ]] \
    && ok "tmux-history stores what is new without repeating" || fail "tmux-history: $(cat "$T"/hist/*/*.log 2>/dev/null | grep -cx history-unique-53)"
  ( cd "$r" && printf 'y\n' | E env EDITOR=true tmux-swarm new "add validation" >/dev/null 2>&1 )
  local id; id="$(ls "$TH/.local/share/tmux-swarm/" 2>/dev/null | sed -n 's/\.json$//p' | head -1)"
  local wt; wt="$(jq -r '.tasks[0].path' "$TH/.local/share/tmux-swarm/$id.json" 2>/dev/null)"
  [[ -n "$id" && -d "$wt" ]] && tm has-session -t "swarm-$id" 2>/dev/null && git -C "$r" rev-parse -q --verify "swarm/$id/1" >/dev/null \
    && ok "tmux-swarm creates the worktree, the branch and the group with Claude" || { fail "tmux-swarm new"; tm kill-server; return; }
  ( cd "$wt" && echo x > new.txt && git add new.txt && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -qm "feat: x" )
  printf 'y\n' | E tmux-swarm integrate "$id" >/dev/null 2>&1
  [[ "$(git -C "$r" branch --show-current)" == "swarm/$id/integration" && -f "$r/new.txt" ]] \
    && ok "integrates the branches into swarm/<id>/integration (no push)" || fail "tmux-swarm integrate"
  git -C "$r" switch -q feature/ABC-9-x
  printf 'y\n' | E tmux-swarm clean "$id" >/dev/null 2>&1
  [[ ! -d "$wt" ]] && ! tm has-session -t "swarm-$id" 2>/dev/null && ok "cleans up worktrees and tabs" || fail "tmux-swarm clean"
  tm kill-server 2>/dev/null
}

test_bar_extra() {
  use_socket bar_extra
  section "Status bar: personal segments and ws-cache"
  have ws-cache && have tmux-background || { warn "patch 53b is not installed"; return; }
  local f="$T/bar-extra.conf"
  printf '# comment\n#(echo segment-53b)\n' > "$f"
  tm -f /dev/null new-session -d -s dev; tm set -g status-right 'BASE'
  E env WS_BAR_EXTRA="$f" tmux-background --bar; E env WS_BAR_EXTRA="$f" tmux-background --bar
  local sr; sr="$(tm show -gv status-right)"
  [[ "$sr" == "BASE #(echo segment-53b)" ]] && ok "adds the segment only once (and not the comments)" || fail "status-right: $sr"
  tm set -g status-right 'BASE'; E env WS_BAR_EXTRA="$f" tmux-background --bar
  [[ "$(tm show -gv status-right)" == *segment-53b* ]] && ok "puts it back if the theme rewrites the status bar" || fail "did not put it back"
  local a b; mkdir -p "$T/xdg-cache"
  a="$(E env XDG_RUNTIME_DIR="$T/xdg-cache" ws-cache 30 date +%s%N)"; sleep 0.1; b="$(E env XDG_RUNTIME_DIR="$T/xdg-cache" ws-cache 30 date +%s%N)"
  [[ -n "$a" && "$a" == "$b" ]] && ok "ws-cache returns what is stored while it is fresh" || fail "ws-cache: $a / $b"
  # Slow startup hooks: the stale value is returned at once and refreshed behind; past --max it runs and waits.
  local c="$T/xdg-cache2" slow="$T/slow.sh" t0 r; mkdir -p "$c"
  printf '#!/usr/bin/env bash\nsleep 1; date +%%s%%N\n' > "$slow"; chmod +x "$slow"
  a="$(E env XDG_RUNTIME_DIR="$c" ws-cache --max 1800 0 "$slow")"
  t0=$(date +%s%N); b="$(E env XDG_RUNTIME_DIR="$c" ws-cache --max 1800 0 "$slow")"; r=$(( ($(date +%s%N) - t0) / 1000000 ))
  [[ -n "$a" && "$a" == "$b" ]] && (( r < 700 )) && ok "ws-cache: the stale value comes out at once (${r} ms) and is refreshed behind" || fail "ws-cache stale: ${r} ms · $a / $b"
  sleep 1.6; b="$(E env XDG_RUNTIME_DIR="$c" ws-cache --max 1800 60 "$slow")"
  [[ -n "$b" && "$a" != "$b" ]] && ok "ws-cache: the background refresh did store the new result" || fail "ws-cache did not refresh: $a / $b"
  touch -d '-2 hours' "$c"/ws-cache-*/????????????????
  a="$(E env XDG_RUNTIME_DIR="$c" ws-cache --max 1800 60 "$slow")"
  [[ -n "$a" && "$a" != "$b" ]] && ok "ws-cache --max: what is too old is not used; it runs and waits" || fail "ws-cache --max: $a / $b"
  r="$(jq -r '[.hooks.SessionStart[].hooks[] | select((.args // []) | map(test("\\.ps1$")) | any) | .command | test("ws-cache$")] | all' "$RH/.claude/settings.json" 2>/dev/null)"
  [[ "$r" == "true" ]] && ok "the startup PowerShell hooks do not block (they go through ws-cache)" || fail "a SessionStart .ps1 runs directly: $r"
  # The sandbox hides the credentials on BOTH sides: the Linux home and the Windows profile (visible in /mnt/c).
  r="$(jq -r '.sandbox.filesystem.denyRead as $d | [".ssh", ".aws", ".azure", ".kube", ".git-credentials", "AppData/Roaming/GitHub CLI"] | map(. as $p | ($d | map(test("^//mnt/c/Users/[^/]+/" + ($p | gsub("\\."; "\\.")) + "$")) | any)) | all' "$RH/.claude/settings.json" 2>/dev/null)"
  [[ "$r" == "true" ]] && ok "the sandbox does not let the Windows profile credentials be read" || fail "Windows credentials missing from sandbox.filesystem.denyRead: $r"
  # Notices of clashes with the sandbox: the hook classifies network, credential reads and writes, and stays quiet
  # for ordinary errors.
  local hk="$RH/.claude/hooks/ws-sandbox-notice.sh" sd="$T/sbx"
  if [[ -x "$hk" ]]; then
    sbx() { jq -nc --arg c "$1" --arg o "$2" '{tool_name: "Bash", cwd: "/x/repo", session_id: "s", tool_input: {command: $c}, tool_response: {stderr: $o}}' | env -u TMUX_PANE WS_TELEMETRY_DIR="$sd" bash "$hk"; }
    sbx 'curl https://example.test/a' 'deny network-outbound example.test:443 (x)'
    sbx 'cat /mnt/c/Users/u/.git-credentials' 'cat: x: No such file or directory'
    sbx 'echo x > .git/hooks/pre-push' 'bash: .git/hooks/pre-push: Read-only file system'
    sbx 'ls /does/not/exist' 'ls: /does/not/exist: No such file or directory'; sbx 'cat README.md' 'hello'
    r="$(jq -r '.type' "$sd"/raw/sandbox-*.jsonl 2>/dev/null | tr '\n' ' ')"
    [[ "$r" == "network read write " ]] && ! grep -q 'example.test/a\|README' "$sd"/raw/sandbox-*.jsonl \
      && ok "sandbox notices: logs network, credential reads and writes; nothing for ordinary errors, nor the full command" || fail "ws-sandbox-notice: $r"
    r="$(jq -r '[.hooks.PostToolUse, .hooks.PostToolUseFailure] | map(map(.hooks[].command) | any(test("ws-sandbox-notice"))) | all' "$RH/.claude/settings.json" 2>/dev/null)"
    [[ "$r" == "true" ]] && ok "the sandbox notice is hooked to the result of every command" || fail "ws-sandbox-notice is not hooked: $r"
  fi
  r="$(jq -r '.permissions.ask as $a | ["mcp__azure__keyvault", "mcp__claude_ai_Microsoft_365__*send*", "mcp__mempalace__*delete*", "Bash(pwsh.exe *)"] | map(. as $x | $a | index($x) != null) | all' "$RH/.claude/settings.json" 2>/dev/null)"
  [[ "$r" == "true" ]] && ok "the MCP tools that send, delete or touch secrets, and PowerShell, always ask for confirmation" || fail "ask rules for MCP or PowerShell are missing: $r"
  tm kill-server 2>/dev/null
}

test_personal() {
  section "Versioned personal configuration (ws-personal)"
  have ws-personal || { warn "ws-personal is not installed"; return; }
  local P="$T/personal" g=(env WS_PERSONAL_DIR="$T/personal" GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t)
  mkdir -p "$TH/.config/ws-local/segments"; printf '#(echo x)\n' > "$TH/.config/ws-local/bar-extra.conf"
  printf 'echo MP\n' > "$TH/.config/ws-local/segments/mp.sh"; chmod 755 "$TH/.config/ws-local/segments/mp.sh"
  printf 'mine|1|/srv/mine\n' > "$TH/.config/ws-local/roots.txt"
  E "${g[@]}" ws-personal init >/dev/null 2>&1
  grep -qxF '.config/ws-local/roots.txt' "$P/include.txt" && [[ "$(cat "$P/home/.config/ws-local/roots.txt" 2>/dev/null)" == 'mine|1|/srv/mine' ]] \
    && ok "your own folder roots (ws-local/roots.txt) are versioned by default" || fail "ws-personal does not version ws-local/roots.txt"
  [[ "$(git -C "$P" log --oneline 2>/dev/null | wc -l)" -ge 1 && -x "$P/home/.config/ws-local/segments/mp.sh" ]] \
    && ok "init: repo with your configuration (keeps execute permissions)" || fail "ws-personal init"
  printf 'x %s=abc12345\n' "pass""word" > "$TH/.config/ws-local/note.txt"
  ! E "${g[@]}" ws-personal sync >/dev/null 2>&1 && ! git -C "$P" ls-files | grep -q note.txt \
    && ok "with something that looks like a secret it does not commit" || fail "ws-personal stored a secret"
  rm -f "$TH/.config/ws-local/note.txt" "$TH/.config/ws-local/bar-extra.conf"; echo changed > "$TH/.config/ws-local/roots.txt"
  printf 'y\n' | E "${g[@]}" ws-personal restore >/dev/null 2>&1
  [[ -f "$TH/.config/ws-local/bar-extra.conf" ]] && ok "restore brings back what is versioned" || fail "ws-personal restore"
  [[ "$(cat "$TH"/.local/share/ws-kit/backup.*/.config/ws-local/roots.txt 2>/dev/null)" == changed ]] && ! compgen -G "$TH/.config/ws-local/*.bak.*" >/dev/null \
    && ok "restore copies what it replaces to ~/.local/share/ws-kit/backup.<date>/, not next to the file" || fail "ws-personal restore: no backup of the replaced file"
}

test_state() {
  use_socket state
  section "Detailed Claude state (phase, time, what it is doing, without getting stuck)"
  local h="$RH/.claude/hooks/tmux-state.sh"
  [[ -x "$h" ]] && have tmux-status || { warn "patch 56 is not installed"; return; }
  # Each tab simulates a running Claude (not a shell) with a given screen.
  tm -f /dev/null new-session -d -s dev -n base "exec sleep 600"
  local p w; p="$(tm display -p -t dev:base '#{pane_id}')"; w="$(tm display -p -t dev:base '#{window_id}')"
  ev() { printf '%s' "$2" | E env TMUX_PANE="$p" bash "$h" "$1"; }
  cs() { tm show -wqv -t "$1" @cs; }
  ev prompt '{"prompt":"x"}'
  [[ "$(tm show -wqv -t "$w" @cphase)" == thinking && "$(cs "$w")" == "🧠 thinking"* ]] && ok "prompt → 🧠 thinking" || fail "prompt: $(cs "$w")"
  ev tool '{"tool_name":"Bash","tool_input":{"command":"npm test"}}'
  [[ "$(cs "$w")" == "🔧 Bash"* && "$(tm show -wqv -t "$w" @cdet)" == "Bash: npm test" ]] && ok "tool → 🔧 Bash and what it is doing (Bash: npm test)" || fail "tool: $(cs "$w")"
  tm set -w -t "$w" @csince "$(( $(date +%s) - 130 ))"; tm set -w -t "$w" @cts "$(date +%s)"; E tmux-status --all
  [[ "$(cs "$w")" == "🔧 Bash 2m" ]] && ok "the time advances with the status bar (2m)" || fail "time: $(cs "$w")"
  ev wait '{"notification_type":"permission_prompt","message":"Claude needs your permission to use Bash"}'
  [[ "$(cs "$w")" == "✋ approve Bash"* && "$(tm show -wqv -t "$w" @cmain)" == "needs you" ]] && ok "permission → ✋ approve Bash (the watcher still sees «needs you»)" || fail "permission: $(cs "$w")"
  ev wait '{"notification_type":"elicitation_dialog","message":"Pick an option"}'
  [[ "$(cs "$w")" == "❓ asking you"* ]] && ok "question → ❓ asking you" || fail "question: $(cs "$w")"
  ev compact '{"trigger":"auto"}'
  [[ "$(cs "$w")" == "📦 compacting"* ]] && ok "PreCompact → 📦 compacting" || fail "compact: $(cs "$w")"
  ev start '{"source":"compact"}'
  [[ "$(tm show -wqv -t "$w" @cphase)" == thinking ]] && ok "after an automatic compact it keeps thinking" || fail "after compacting: $(tm show -wqv -t "$w" @cphase)"
  # «Waiting for you»: Claude's last message decides between 👉 waiting for you and ✔ done (without tmux: --asks).
  # Spanish on purpose: the three transcripts are what Claude writes when the owner works in Spanish.
  local tq="$T/tq.jsonl" tn="$T/tn.jsonl" tc="$T/tc.jsonl"
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"Hice el cambio.\n\n¿Lo subo o prefieres revisarlo antes?"}]}}' > "$tq"
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"Para aplicarlo, corre:\n\n```bash\nbash install.sh\n```"}]}}' > "$tc"
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"¿Qué archivo?"}]}}' '{"type":"assistant","message":{"content":[{"type":"text","text":"Listo: las 12 pruebas pasan y el cambio quedó guardado."}]}}' > "$tn"
  HOME="$RH" bash "$h" --asks "$tq" && HOME="$RH" bash "$h" --asks "$tc" && ! HOME="$RH" bash "$h" --asks "$tn" \
    && ok "waiting for you: detects a closing question and a request to run something; not an informative ending" || fail "«waiting for you» detection"
  ev "done" "$(jq -nc --arg t "$tq" '{transcript_path: $t}')"
  [[ "$(cs "$w")" == "👉 waiting for you"* && "$(tm show -wqv -t "$w" @cmain)" == "your turn" ]] && ok "Stop with a question → 👉 waiting for you (the watcher counts it)" || fail "waiting for you: $(cs "$w")"
  ev prompt '{"prompt":"x"}'; ev tool '{"tool_name":"Bash","tool_input":{"command":"npm test"}}'
  ev "done" '{}'
  [[ "$(cs "$w")" == "✔ done" && "$(tm show -wqv -t "$w" @cdet)" == "last: Bash: npm test" && -n "$(tm show -wqv -t "$w" @cturn_txt)" ]] \
    && ok "Stop → ✔ done, with the last thing it did and the duration of the turn" || fail "done: $(cs "$w") / $(tm show -wqv -t "$w" @cdet)"
  # Self-correction (no hook reports it): from what is on screen.
  tab() {   # name text-on-screen phase seconds-ago → window id
    tm new-window -d -t dev -n "$1" "printf '%b\n' '$2'; exec sleep 600"; sleep 0.3
    local v; v="$(tm display -p -t "dev:$1" '#{window_id}')"
    tm set -w -t "$v" @cphase "$3"; tm set -w -t "$v" @cpane "$(tm display -p -t "dev:$1" '#{pane_id}')"
    tm set -w -t "$v" @cts "$(( $(date +%s) - $4 ))"; tm set -w -t "$v" @csince "$(( $(date +%s) - $4 ))"; echo "$v"
  }
  local wi wl ws wp wb
  wi="$(tab int '  ⎿  Interrupted by user\n> ' thinking 30)"
  wl="$(tab idle '● Done, finished.\n> ' tool 30)"
  ws="$(tab spin '✻ Thinking… (esc to interrupt)' thinking 700)"
  wp="$(tab perm 'Do you want to proceed?\n❯ 1. Yes\n  2. No' permission 40)"
  tm new-window -d -t dev -n shell "bash --norc --noprofile"; sleep 0.3
  wb="$(tm display -p -t dev:shell '#{window_id}')"; tm set -w -t "$wb" @cphase thinking
  tm set -w -t "$wb" @cpane "$(tm display -p -t dev:shell '#{pane_id}')"; tm set -w -t "$wb" @cts "$(( $(date +%s) - 30 ))"
  E tmux-status --all
  [[ "$(cs "$wi")" == "⛔ interrupted"* ]] && ok "Esc (Interrupted on screen) → ⛔ interrupted" || fail "interrupted: $(cs "$wi")"
  [[ "$(cs "$wl")" == "✔ done"* ]] && ok "no hook but Claude already waits for your message → ✔ done (it does not get stuck)" || fail "stuck: $(cs "$wl")"
  [[ "$(cs "$ws")" == "⏳ stalled 11m" ]] && ok "working without events for 11 min → ⏳ stalled" || fail "stalled: $(cs "$ws")"
  [[ "$(cs "$wp")" == "✋ approve"* ]] && ok "the permission dialog is still on screen → still ✋ approve" || fail "permission visible: $(cs "$wp")"
  [[ -z "$(cs "$wb")" ]] && ok "Claude no longer runs in the tab → the state is cleared" || fail "left Claude: $(cs "$wb")"
  tm kill-server 2>/dev/null
}

test_ux() {
  use_socket ux
  section "Menus and UX: active tabs, scenes, monitor, model switch"
  have tmux-active && have tmux-hud || { warn "patch 58 is not installed"; return; }
  tm -f /dev/null new-session -d -s repos -n api "exec sleep 600"; tm new-window -d -t repos -n web "exec sleep 600"
  tm new-session -d -s code -n kit "exec sleep 600"
  local now; now=$(date +%s)
  # With tmux-status installed the state is repainted from @cphase/@cdet: they are set the way the hooks set them.
  tm set -w -t repos:api @cphase tool; tm set -w -t repos:api @cdet "Bash: npm test"; tm set -w -t repos:api @cs "🔧 Bash 2m"
  tm set -w -t repos:api @cts "$now"; tm set -w -t repos:api @csince "$now"
  tm set -w -t code:kit @cphase permission; tm set -w -t code:kit @cdet "Bash: terraform plan"; tm set -w -t code:kit @cs "✋ approve Bash"
  tm set -w -t code:kit @cts "$now"; tm set -w -t code:kit @csince "$now"
  sleep 1.2
  local r; r="$(E tmux-active --list --minutes 0 | cut -f2- | sed 's/\x1b\[[0-9;]*m//g')"
  [[ "$(head -1 <<<"$r")" == *kit*approve* && "$(sed -n 2p <<<"$r")" == *api*Bash* && "$(wc -l <<<"$r")" == 2 ]] \
    && ok "active tabs: first what is waiting for you, then what is working; idle ones are left out" || fail "tmux-active: $r"
  mkdir -p "$TH/.local/bin"; [[ -f "$TH/.local/bin/tmux-saver" ]] || printf 'SCENES=(aurora ocean)\n' > "$TH/.local/bin/tmux-saver"
  tm set -g @saver_scene ocean
  r="$(E tmux-scene --list)"
  grep -qP '^ocean\t✓' <<<"$r" && grep -q '^random' <<<"$r" && ok "scene picker: list with the current one marked" || fail "tmux-scene: $r"
  local pr="$TH/.claude/projects/-rec-a"; mkdir -p "$pr"
  printf '%s\n' '{"type":"user","cwd":"/rec/a","gitBranch":"feature/REC-1","message":{"content":"fix the billing login right now please"}}' \
    '{"type":"assistant","message":{"content":[{"type":"text","text":"Done, the billing login is fixed."}]}}' > "$pr/rec1.jsonl"
  r="$(E env XDG_RUNTIME_DIR="$T" tmux-recent --list | sed 's/\x1b\[[0-9;]*m//g')"
  grep -q $'^open\t/rec/a\trec1\t' <<<"$r" && grep -q 'feature/REC-1.*fix the billing login' <<<"$r" \
    && ok "recent: lists conversations with branch and last request, ready to resume" || fail "tmux-recent: $r"
  r="$(E tmux-hud)"; [[ "$r" == *CPU*RAM*NET*Claude* ]] && ok "monitor: CPU, RAM, network and Claude on the second line" || fail "tmux-hud: $r"
  # Model switch from the menu: clears what is typed if Claude is waiting; if it is working, it does not interrupt it.
  if [[ -f "$RH/.local/lib/ws-routing.sh" ]] && have cr; then
    mkdir -p "$T/fake-claude"
    # Fake «Claude»: a copy of cat named claude (tmux recognizes Claude by the process name),
    # which ignores Ctrl+C and echoes every line it receives.
    cp "$(command -v cat)" "$T/fake-claude/claude"
    local sock; sock="$(ls -d "$T/s/$SOCK"/tmux-*/default)"
    cm() {   # window text-on-screen → what the «Claude» received
      tm new-window -d -t repos -n "$1" "printf '%s\\n' '$2'; trap '' INT; exec $T/fake-claude/claude"; sleep 0.4
      local pc; pc="$(tm display -p -t "repos:$1" '#{pane_id}')"
      tm select-window -t "repos:$1"; tm send-keys -t "$pc" -l 'previous text'; sleep 0.2   # the menu acts on the current tab
      E env TMUX="$sock,1,0" TMUX_PANE="$pc" WS_ROUTING_LOG="$T/routing.log" cr --switch sonnet >/dev/null 2>&1; sleep 0.6
      tm capture-pane -p -t "$pc"
    }
    r="$(cm waits 'waiting')"
    grep -qx '/model claude-sonnet-5-5' <<<"$r" && ! grep -q 'previous text/model' <<<"$r" && ok "model: if Claude is waiting, it clears what is typed and sends /model alone" || fail "model (waiting): $r"
    r="$(cm works 'Working… (esc to interrupt)')"
    grep -q 'previous text/model claude-sonnet-5-5' <<<"$r" && ok "model: if Claude is working, it does not interrupt it (no Ctrl+C is sent)" || fail "model (working): $r"
  else warn "routing is not installed: the model switch test is skipped"; fi
  tm kill-server 2>/dev/null
}

test_find() {
  use_socket find
  section "Finder: tabs, active, favorites and recent conversations in one list (tmux-find)"
  have tmux-find && have tmux-active && have tmux-favorites && have tmux-recent || { warn "tmux-find is not installed"; return; }
  local fc="$T/fake-claude-find" d="$T/find" fav="$TH/.config/tmux-claude/favorites" r rc n k wapi wweb wkit wask wbusy pkit pask pbusy
  # Fake «Claude»: a copy of cat named claude (the finder recognizes Claude by the process name), which ignores
  # Ctrl+C and echoes every line it receives.
  mkdir -p "$fc" "$d/open" "$d/closed" "$d/plain"; cp "$(command -v cat)" "$fc/claude"; touch "$d/plain/README.md"
  tm -f /dev/null new-session -d -s repos -n api -c "$d/open" "exec sleep 600"; tm new-window -d -t repos -n web "exec sleep 600"
  tm new-session -d -s code -n kit "printf '%s\\n' 'Do you want to proceed?' '❯ 1. Yes' '  2. No'; trap '' INT; exec $fc/claude"
  tm new-window -d -t code -n ask "printf '%s\\n' 'waiting'; trap '' INT; exec $fc/claude"
  tm new-window -d -t code -n busy "printf '%s\\n' 'Working… (esc to interrupt)'; trap '' INT; exec $fc/claude"; sleep 0.6
  wapi="$(tm display -p -t repos:api '#{window_id}')"; wweb="$(tm display -p -t repos:web '#{window_id}')"
  wkit="$(tm display -p -t code:kit '#{window_id}')"; wask="$(tm display -p -t code:ask '#{window_id}')"; wbusy="$(tm display -p -t code:busy '#{window_id}')"
  pkit="$(tm display -p -t code:kit '#{pane_id}')"; pask="$(tm display -p -t code:ask '#{pane_id}')"; pbusy="$(tm display -p -t code:busy '#{pane_id}')"
  tm select-window -t repos:web
  local now; now=$(date +%s)
  tm set -w -t code:kit @cphase permission; tm set -w -t code:kit @cdet "Bash: terraform plan"; tm set -w -t code:kit @cs "✋ approve Bash"
  tm set -w -t code:kit @cmain "needs you"; tm set -w -t code:kit @cts "$now"; tm set -w -t code:kit @csince "$now"
  # Favorites: one folder with an open tab, one without. Conversations: one per folder (the «closed» one has no tab).
  mkdir -p "${fav%/*}"; printf '%s\n' "$d/open" "$d/closed" > "$fav"
  conv() {   # folder id request → writes the conversation where Claude keeps it and prints the file
    local dir; dir="$TH/.claude/projects/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$1")"; mkdir -p "$dir"
    printf '%s\n' '{"type":"user","cwd":"'"$1"'","gitBranch":"feature/FIND-1","message":{"content":"'"$3"'"}}' \
      '{"type":"assistant","message":{"content":[{"type":"text","text":"Done: '"$3"'."}]}}' > "$dir/$2.jsonl"
    echo "$dir/$2.jsonl"
  }
  local copen cclosed; copen="$(conv "$d/open" find-open 'refactor the open billing module please')"
  cclosed="$(conv "$d/closed" find-closed 'migrate the closed reports to the new schema')"
  F() { E env XDG_RUNTIME_DIR="$T" tmux-find "$@"; }
  sleep 1.2   # «active» with --minutes 0 leaves out what had no activity in this very second

  # 1. The four views, in one row format.
  r="$(F --list all)"
  [[ "$(head -1 <<<"$r")" == "tab:code:$wkit"$'\t'*kit*approve* && "$(grep -c $'^tab:repos:@' <<<"$r")" == 2 && "$(wc -l <<<"$r")" == 5 ]] \
    && ok "view all: every open tab, first the one waiting for you" || fail "tmux-find --list all: $r"
  r="$(F --list active --minutes 0)"
  [[ "$r" == "tab:code:$wkit"$'\t'*kit*approve* && "$(wc -l <<<"$r")" == 1 ]] && ok "view active: the rows of tmux-active as tab: refs" || fail "tmux-find --list active: $r"
  r="$(F --list favorites)"
  [[ "$(sed -n 1p <<<"$r")" == "tab:repos:$wapi"$'\t'*$'\t'"$d/open" && "$(sed -n 2p <<<"$r")" == "dir:$d/closed"$'\t'*$'\t'"$d/closed" ]] \
    && ok "view favorites: a favorite with a tab is a tab: row, one without is a dir: row; both keep their folder" || fail "tmux-find --list favorites: $r"
  r="$(F --list recent)"
  grep -qF "tab:repos:$wapi"$'\t' <<<"$r" && grep -q $'\t'"$copen\$" <<<"$r" && grep -qF "conv:$cclosed"$'\t' <<<"$r" \
    && ok "view recent: a conversation with a tab is a tab: row (it keeps its file), one without is a conv: row" || fail "tmux-find --list recent: $r"
  r="$(for k in all active favorites recent; do F --list "$k" --minutes 0; done)"
  n="$(grep -cvP '^(tab:[^:\t]+:@[0-9]+|dir:/[^\t]*|conv:/[^\t]*\.jsonl)\t[^\t]+\t[^\t]*$' <<<"$r")"
  [[ "$n" == 0 && "$(wc -l <<<"$r")" -ge 10 ]] && ok "every row of every view is <ref><TAB>text<TAB>extra" || fail "tmux-find: $n rows out of format: $r"
  F --list nowhere >/dev/null 2>&1; [[ $? == 2 ]] && ok "an unknown view is refused" || fail "tmux-find --list nowhere did not fail"

  # 2. The right pane.
  r="$(F --preview "tab:code:$wkit")"; grep -q 'Do you want to proceed' <<<"$r" && ok "preview of a tab: its live screen" || fail "tmux-find --preview tab: $r"
  r="$(F --preview "conv:$cclosed")"
  grep -q 'Your latest requests' <<<"$r" && grep -q 'migrate the closed reports' <<<"$r" && grep -q 'Done: migrate' <<<"$r" \
    && ok "preview of a conversation: your latest requests and Claude's last answer" || fail "tmux-find --preview conv: $r"
  r="$(F --preview "dir:$d/closed")"; grep -q 'migrate the closed reports' <<<"$r" && ok "preview of a folder: its latest conversation" || fail "tmux-find --preview dir: $r"
  r="$(F --preview "dir:$d/plain")"; grep -q 'README.md' <<<"$r" && ! grep -q 'Your latest' <<<"$r" && ok "preview of a folder without conversations: its listing" || fail "tmux-find --preview dir (plain): $r"

  # 3. Quick reply: clears what is typed when Claude is waiting; does not interrupt it when it is working.
  tm send-keys -t "$pask" -l 'previous text'; sleep 0.2
  r="$(F --reply "tab:code:$wask" 'hello from the finder')"; sleep 0.6
  [[ "$r" == "Sent to"* ]] && tm capture-pane -p -t "$pask" | grep -qx 'hello from the finder' \
    && ok "quick reply: the line reaches Claude alone (what was typed is cleared first)" || fail "tmux-find --reply: $r / $(tm capture-pane -p -t "$pask" | tr '\n' '|')"
  tm send-keys -t "$pbusy" -l 'previous text'; sleep 0.2
  F --reply "tab:code:$wbusy" 'queued line' >/dev/null; sleep 0.6
  tm capture-pane -p -t "$pbusy" | grep -qx 'previous textqueued line' && ok "quick reply: if Claude is working, no Ctrl+C is sent" || fail "tmux-find --reply (working): $(tm capture-pane -p -t "$pbusy" | tr '\n' '|')"
  r="$(F --reply "tab:code:$wask" '')"; [[ "$r" == Cancelled* ]] && ok "quick reply: an empty line cancels" || fail "tmux-find --reply (empty): $r"
  r="$(F --reply "tab:code:$wkit" 'not into a dialog')"; rc=$?
  [[ $rc != 0 && "$r" == *"waiting for your approval"* ]] && ! tm capture-pane -p -t "$pkit" | grep -q 'not into a dialog' \
    && ok "quick reply: nothing is typed into a permission dialog" || fail "tmux-find --reply (dialog): exit $rc «$r»"
  r="$(F --reply "tab:repos:$wapi" 'not into a shell')"; rc=$?
  [[ $rc != 0 && "$r" == "No Claude running"* ]] && ok "quick reply: nothing is typed into a tab without Claude" || fail "tmux-find --reply (no Claude): exit $rc «$r»"
  local accepted=""
  for k in --reply --approve --reject --peek-start; do
    for r in "dir:$d/closed" "conv:$cclosed"; do
      F "$k" "$r" x >/dev/null 2>&1 || continue
      accepted+=" $k:${r%%:*}"
    done
  done
  [[ -z "$accepted" ]] && ok "reply, approve, reject and open here refuse a folder or a conversation without a tab" || fail "accepted without a tab:$accepted"

  # 4. Approve and reject: only in the «permission» phase, with the same keys as the Telegram buttons.
  tm set -w -t code:kit @cphase tool
  r="$(F --approve "tab:code:$wkit")"; rc=$?; sleep 0.3
  [[ $rc != 0 && "$r" == *"not waiting for approval"* ]] && ! tm capture-pane -p -t "$pkit" | grep -qx '1' \
    && ok "approve: outside the permission phase nothing is sent" || fail "tmux-find --approve (phase tool): exit $rc «$r»"
  tm set -w -t code:kit @cphase permission
  r="$(F --approve "tab:code:$wkit")"; sleep 0.3
  [[ "$r" == Approved* ]] && tm capture-pane -p -t "$pkit" | grep -qx '1' && ok "approve: sends option 1 to the dialog" || fail "tmux-find --approve: $r / $(tm capture-pane -p -t "$pkit" | tr '\n' '|')"
  r="$(F --reject "tab:code:$wkit")"; sleep 0.3
  [[ "$r" == Rejected* ]] && tm capture-pane -p -t "$pkit" | grep -qxF '1^[' && ok "reject: sends Escape to the dialog" || fail "tmux-find --reject: $r / $(tm capture-pane -p -t "$pkit" | tr '\n' '|')"
  tm set -w -t code:ask @cphase permission
  r="$(F --approve "tab:code:$wask")"; rc=$?
  [[ $rc != 0 && "$r" == *"no dialog"* ]] && ok "approve: without a dialog on screen nothing is sent" || fail "tmux-find --approve (no dialog): exit $rc «$r»"
  tm set -wu -t code:ask @cphase

  # 5. Open here: a temporary session grouped with the tab's session, removed afterwards; your own client stays put.
  n="$(F --peek-start "tab:repos:$wapi")"
  [[ "$n" == find-peek-* && "$(tm display -p -t "=$n:" '#{session_grouped} #{session_group} #{window_id}')" == "1 repos $wapi" \
     && "$(tm display -p -t '=repos:' '#{window_id}')" == "$wweb" ]] \
    && ok "open here: a session grouped with the tab's group shows the tab; the group's own current tab does not move" \
    || fail "tmux-find --peek-start: «$n» $(tm display -p -t "=$n:" '#{session_grouped} #{session_group} #{window_id}' 2>&1) / $(tm display -p -t '=repos:' '#{window_id}')"
  [[ "$(F --list all | grep -c $'^tab:repos:@')" == 2 ]] && ok "open here: the temporary session does not repeat tabs in the list" || fail "tmux-find --list all repeats tabs: $(F --list all)"
  F --peek-end "$n"; ! tm has-session -t "=$n" 2>/dev/null && ok "open here: the temporary session is removed" || fail "tmux-find --peek-end left $n"
  F --peek-end repos >/dev/null 2>&1; rc=$?
  [[ $rc != 0 ]] && tm has-session -t '=repos' 2>/dev/null && ok "open here: only its own temporary sessions can be removed" || fail "tmux-find --peek-end repos: exit $rc"
  # The whole path, attached to a real terminal (script) and detached from outside as Ctrl+b d would.
  E env XDG_RUNTIME_DIR="$T" timeout 20 script -qec "tmux-find --peek 'tab:repos:$wapi'" /dev/null </dev/null >/dev/null 2>&1 &
  local sp=$! i; n=""
  for i in $(seq 1 25); do
    n="$(tm list-sessions -F '#{session_name} #{session_attached}' 2>/dev/null | awk '$1 ~ /^find-peek-/ && $2 >= 1 { print $1; exit }')"
    [[ -n "$n" ]] && break; sleep 0.2
  done
  if [[ -n "$n" ]]; then
    tm detach-client -s "=$n" 2>/dev/null; wait "$sp" 2>/dev/null
    ! tm has-session -t "=$n" 2>/dev/null && ok "open here: leaving it (detach) removes the temporary session" || fail "open here: $n stayed after detaching"
  else
    kill "$sp" 2>/dev/null; wait "$sp" 2>/dev/null
    tm list-sessions -F '#{session_name}' 2>/dev/null | grep '^find-peek-' | while IFS= read -r n; do tm kill-session -t "=$n"; done
    warn "open here: could not attach from this terminal (script); the attached path was not tested"
  fi

  # 6. The old entry points open the finder on their view.
  local ep="$T/find-entry"; mkdir -p "$ep"; cp "$TH/.local/bin/tmux-active" "$TH/.local/bin/tmux-favorites" "$TH/.local/bin/tmux-recent" "$ep/"
  printf '#!/bin/sh\necho "find $*"\n' > "$ep/tmux-find"; chmod +x "$ep/tmux-find"
  r="$(E "$ep/tmux-active"; E "$ep/tmux-favorites"; E "$ep/tmux-recent")"
  [[ "$r" == $'find --view active --minutes 15\nfind --view favorites\nfind --view recent --days 7' ]] \
    && ok "tmux-active, tmux-favorites and tmux-recent without a mode open the finder on their view" || fail "old entry points: ${r//$'\n'/ · }"
  rm -f "$fav" "$copen" "$cclosed"
  tm kill-server 2>/dev/null
}

test_level() {
  use_socket level
  section "Protection per tab: full, normal, bare"
  have tmux-level || { warn "patch 59 is not installed"; return; }
  local s="$T/s59.json" r
  printf '%s' '{"permissions":{"allow":["Bash(ls:*)"],"ask":["Bash(terraform apply*)"],"deny":["Read(~/.aws/**)"]},"sandbox":{"enabled":true,"excludedCommands":["docker"]},"hooks":{"PreToolUse":[{"hooks":[{"type":"command","command":"~/.claude/hooks/audit.sh tool"},{"type":"command","command":"~/.claude/hooks/guard.sh"}]},{"hooks":[{"type":"command","command":"~/.claude/hooks/tmux-state.sh tool"}]}]},"statusLine":{"type":"command","command":"~/.claude/statusline.sh"}}' > "$s"
  r="$(E tmux-level --profile full "$s")"
  jq -e '(.sandbox | (.enabled == true) and (.allowUnsandboxedCommands == false) and (has("excludedCommands") | not))
         and (.permissions.deny == ["Read(~/.aws/**)"]) and (.permissions.allow | length == 1) and ([.hooks[][].hooks[].command] | any(test("guard")))' <<<"$r" >/dev/null \
    && ok "full: sandbox with no escape hatches or excluded commands; keeps permissions and hooks" || fail "full: $r"
  r="$(E env PATH="$T/fc59x:$TH/.local/bin:/usr/bin:/bin" WS_LEVELS_DIR="$T/levels" tmux-level --command full 2>&1)" || true
  [[ "$r" == *"cannot remove the commands excluded"* || "$r" == *"--setting-sources project,local"* ]] \
    && ok "full starts without the user settings (or says so if Claude does not allow it)" || fail "full command: $r"
  # «full» with a folder: reads stay in that project (denies the roots.txt folders and re-allows the repo).
  mkdir -p "$T/ais/code/a/src" "$T/ais/code/b" "$TH/.config/tmux-claude"; git -C "$T/ais/code/a" init -q 2>/dev/null
  cp "$TH/.config/tmux-claude/roots.txt" "$T/roots.bak" 2>/dev/null; printf 'code|1|%s\n' "$T/ais/code" > "$TH/.config/tmux-claude/roots.txt"
  r="$(E env WS_WINHOME=/does/not/exist tmux-level --profile full "$s" "$T/ais/code/a/src" | jq -r --arg d "/$T/ais/code" '[(.sandbox.filesystem.denyRead | index($d) != null), (.sandbox.filesystem.allowRead | index($d + "/a") != null), (.sandbox.filesystem.allowRead | index($d + "/b") == null)] | all')"
  [[ -f "$T/roots.bak" ]] && cp "$T/roots.bak" "$TH/.config/tmux-claude/roots.txt"
  [[ "$r" == "true" ]] && ok "full: sandboxed commands only read the tab's project" || fail "full without isolating reads: $r"
  r="$(E tmux-level --profile bare "$s")"
  jq -e '(.permissions.ask == null) and (.permissions.allow == null) and (.permissions.deny == ["Read(~/.aws/**)"]) and (.sandbox.enabled == false)
         and ([.hooks[][].hooks[].command] | any(test("guard"))) and ([.hooks[][].hooks[].command] | any(test("tmux-state")))
         and (.statusLine.command | test("statusline"))' <<<"$r" >/dev/null \
    && ok "bare: no sandbox or allow/ask; keeps the floor (deny and guard), the status line and the state" || fail "bare: $r"
  if [[ "$(E tmux-level --profile completo "$s")" == "$(E tmux-level --profile full "$s")" && "$(E tmux-level --profile puro "$s")" == "$r" ]] \
    && ! E tmux-level --profile other "$s" >/dev/null 2>&1
  then ok "the old level names (completo, puro) are still accepted as input"; else fail "tmux-level does not accept completo/puro"; fi
  # The kit does not pre-authorize reads of cloud credentials and ships the deny floor (ADR-013).
  jq -e '(.permissions.allow | any(test("^Bash\\(az \\* ")) | not)
         and (.permissions.deny | (index("Read(~/.ssh/**)") != null) and (index("Bash(ws-secret get*)") != null) and (index("Bash(git config *ws.gate*)") != null))' \
     "$RH/.claude/settings.json" >/dev/null && ok "settings: no az wildcards in allow and with the deny floor" || fail "settings without the ADR-013 floor"
  mkdir -p "$T/fc59"; printf '#!/bin/bash\n[[ "$1" == --help ]] && echo "  --setting-sources <sources>"\n' > "$T/fc59/claude"; chmod +x "$T/fc59/claude"
  r="$(E env PATH="$T/fc59:$TH/.local/bin:/usr/bin:/bin" WS_LEVELS_DIR="$T/levels" tmux-level --command bare)"
  [[ "$r" == "claude-resume --setting-sources project,local --settings '$T/levels/bare.json'" && "$(stat -c %a "$T/levels/bare.json")" == 600 ]] \
    && ok "bare starts with --setting-sources project,local and its profile (0600)" || fail "bare command: $r"
  r="$(E env WS_LEVELS_DIR="$T/levels" tmux-level --command normal 2>&1)"
  [[ "$r" == "claude-resume --settings '$T/levels/normal.json'" && "$(stat -c %a "$T/levels/normal.json")" == 600 ]] \
    && jq -e '.sandbox.excludedCommands | index("az *") and index("git push *")' "$T/levels/normal.json" >/dev/null \
    && ok "normal starts through claude-resume with the profile that adds the sandbox exclusions (0600)" || fail "normal command: $r"
  # ADR-022: solo excludes nothing and every excluded command of normal asks; solo-net brings them back, asking.
  r="$(E env WS_LEVELS_DIR="$T/levels" tmux-level --settings-file solo 2>&1)"
  jq -e '(.sandbox | has("excludedCommands") | not) and (.permissions.ask | index("Bash(gh *)") and index("Bash(git push *)"))' "$r" >/dev/null 2>&1 \
    && ok "the solo profile excludes no command and makes normal's excluded commands ask" || fail "solo profile: $r"
  r="$(E env WS_LEVELS_DIR="$T/levels" tmux-level --settings-file solo-net 2>&1)"
  jq -e '(.sandbox.excludedCommands | index("az *")) and (.permissions.ask | index("Bash(az *)"))' "$r" >/dev/null 2>&1 \
    && ok "solo --with-network-tools excludes them again, each one asking" || fail "solo-net profile: $r"
  # ADR-024: a jailed MCP server sees neither ~/.ssh nor another profile's logins.
  if have ws-mcp-jail && E ws-mcp-jail --probe; then
    mkdir -p "$TH/.ssh" "$TH/.config/ws-agent/other" "$TH/.local/share/ws-kit/npm/fake/node_modules/.bin"
    echo KEY > "$TH/.ssh/id_t"; echo TOK > "$TH/.config/ws-agent/other/t"
    printf '#!/bin/sh\ncat "$HOME/.ssh/id_t" "$HOME/.config/ws-agent/other/t" 2>/dev/null; echo end\n' \
      > "$TH/.local/share/ws-kit/npm/fake/node_modules/.bin/fake"; chmod +x "$TH/.local/share/ws-kit/npm/fake/node_modules/.bin/fake"
    r="$(E ws-mcp-jail --name fake -- "$TH/.local/share/ws-kit/npm/fake/node_modules/.bin/fake" </dev/null 2>&1)"
    [[ "$r" == end ]] && ok "ws-mcp-jail: a jailed MCP server reads neither ~/.ssh nor another profile's logins" || fail "ws-mcp-jail: $r"
  else warn "ws-mcp-jail: bubblewrap cannot create namespaces here (the jailed MCP servers would not start)"; fi
  jq -e '.sandbox | has("excludedCommands") | not' "$RH/.claude/settings.json" >/dev/null \
    && ok "the user settings exclude no command from the sandbox (strict base; normal adds them)" || fail "settings.json still has sandbox.excludedCommands"
  r="$(printf '%s' '{"permissions":{"allow":["Bash(ls:*)"],"deny":["Read(~/.aws/**)"],"disableBypassPermissionsMode":"disable"}}' > "$T/s-bp.json"; E tmux-level --profile bare "$T/s-bp.json")"
  jq -e '.permissions == {deny: ["Read(~/.aws/**)"], disableBypassPermissionsMode: "disable"}' <<<"$r" >/dev/null \
    && ok "bare keeps the bypass-mode lock in the floor" || fail "bare without disableBypassPermissionsMode: $r"
  mkdir -p "$TH/.config/ws-agent/ops"
  r="$(E env WS_LEVELS_DIR="$T/levels" tmux-level --command normal --agent ops 2>&1)"
  [[ "$r" == "WS_AGENT=ops AZURE_CONFIG_DIR='$TH/.config/ws-agent/ops/azure' GH_CONFIG_DIR='$TH/.config/ws-agent/ops/gh' KUBECONFIG='$TH/.config/ws-agent/ops/kube/config' claude-resume --settings"* ]] \
    && ! E env WS_LEVELS_DIR="$T/levels" tmux-level --command normal --agent missing >/dev/null 2>&1 \
    && ok "an agent identity starts Claude with its own az, gh and kubectl credentials (and an unknown one is refused)" || fail "agent identity: $r"
  rm -rf "$TH/.config/ws-agent"
  mkdir -p "$T/lvl"; conversation_in "$T/lvl" no; : > "$T/claude.log"
  tm -f /dev/null new-session -d -s dev -c "$T/lvl" "bash --norc --noprofile"; local p w; p="$(tm display -p -t dev '#{pane_id}')"; w="$(tm display -p -t dev '#{window_id}')"
  E env PATH="$T/fc59:$TH/.local/bin:/usr/bin:/bin" WS_LEVELS_DIR="$T/levels" tmux-level full "$p" >/dev/null 2>&1; sleep 1
  [[ "$(tm show -wqv -t "$w" @clevel)" == full && "$(tm capture-pane -pJ -t "$p")" == *"claude-resume --setting-sources project,local --settings"*full*.json* ]] \
    && ok "switching level restarts Claude with its profile and marks the tab (🔒)" || fail "tmux-level full: level=$(tm show -wqv -t "$w" @clevel) · $(tm capture-pane -p -t "$p" | grep -v '^$' | tail -3)"
  # A tab where Claude never received a message: the level still gets a running Claude, with the same flags.
  tail -1 "$T/claude.log" | grep -q 'args=--setting-sources project,local --settings .*full' \
    && ok "in a tab without a conversation, the level starts a new Claude with its profile" || fail "tmux-level without a conversation: $(tail -1 "$T/claude.log")"
  # The simulated Claude is a bash script, which tmux-level takes for a shell: it is closed by hand before the switch.
  conversation_in "$T/lvl"; tm send-keys -t "$p" /exit Enter; sleep 0.4
  E env PATH="$T/fc59:$TH/.local/bin:/usr/bin:/bin" WS_LEVELS_DIR="$T/levels" tmux-level bare "$p" >/dev/null 2>&1; sleep 1
  tail -1 "$T/claude.log" | grep -q 'args=--continue --setting-sources project,local --settings .*bare\.json' \
    && ok "with a conversation, the level continues it with the same flags" || fail "tmux-level with a conversation: $(tail -1 "$T/claude.log")"
  tm kill-server 2>/dev/null
}

test_restart_all() {
  use_socket restart
  section "Restart Claude in all tabs"
  have tmux-claude-restart && grep -q -- '--all' "$TH/.local/bin/tmux-claude-restart" || { warn "restart of all tabs is not installed"; return; }
  local p1 p2 w1 w2 before r p
  # The simulated Claude is a bash script and tmux would see it as «bash» (a terminal without Claude, which --all
  # skips). Here it is launched under another process name, like the real Claude.
  tm -f /dev/null new-session -d -s dev -n free -c "$T/repos" "bash --norc"; sleep 0.5
  p1="$(tm display -p -t dev: '#{pane_id}')"; w1="$(tm display -p -t "$p1" '#{window_id}')"
  tm new-window -d -t dev -n working -c "$T/repos" "bash --norc"; sleep 0.4
  p2="$(tm display -p -t dev:working '#{pane_id}')"; w2="$(tm display -p -t "$p2" '#{window_id}')"
  for p in "$p1" "$p2"; do
    tm send-keys -t "$p" "export PATH='$TH/.local/bin:$FB:/usr/bin:/bin' WST_LOG='$T/claude.log'; ( exec -a claude-test bash '$FB/claude' )" Enter
  done; sleep 1
  tm set -w -t "$w1" @cpane "$p1" \; set -w -t "$w1" @cphase "done" \; set -w -t "$w2" @cpane "$p2" \; set -w -t "$w2" @cphase thinking
  r="$(E tmux-claude-restart --all --list)"
  [[ "$r" == *"restart"*"free"* && "$r" == *"busy"*"working"*"(thinking)"* ]] && ok "--list: restarts the idle one and leaves the one that is working" || fail "restart --list: «$r» (tmux sees: $(tm list-panes -a -F '#{pane_current_command}' | tr '\n' ' '))"
  before="$(wc -l < "$T/claude.log" 2>/dev/null || echo 0)"
  E tmux-claude-restart --all >/dev/null 2>&1; sleep 2
  [[ "$(wc -l < "$T/claude.log")" == "$(( before + 1 ))" && "$(tm capture-pane -p -t "$p1")" == *claude-resume* && "$(tm capture-pane -p -t "$p2")" != *claude-resume* ]] \
    && ok "exits and re-enters only in the idle tab, resuming the conversation" || fail "restart of all tabs: $(tm capture-pane -p -t "$p1" | tail -2)"
  tm kill-server 2>/dev/null
}

test_menus_consistency() {
  section "Menus: what they promise exists (without opening tmux)"
  local mm unpaused=""
  for mm in "$TH"/.config/tmux-claude/menu*.tmux; do
    [[ "$(grep -c 'status-interval' "$mm")" == 3 && "$(tail -1 "$mm")" == "set -gF status-interval"* ]] || unpaused+=" ${mm##*/}"
  done
  [[ -z "$unpaused" ]] && ok "each menu pauses the status bar refresh while it is open and restores it on closing" || fail "menus that do not pause the status bar:$unpaused"
  local c="$TH/.config/tmux-claude" f k fz="" sn="" keys
  # 1. Every function a script opens by name (fn=…) is defined in functions.sh.
  for f in $(grep -rhoE '\bfn=[a-z_]+' "$TH/.local/bin" 2>/dev/null | sort -u | cut -d= -f2); do
    bash -c ". '$c/functions.sh' 2>/dev/null; declare -F '$f' >/dev/null" || fz+=" $f"
  done
  [[ -z "$fz" ]] && ok "the functions that open tabs exist (tw, two…)" || fail "undefined functions:$fz"
  # 2. Every «(Ctrl+b X)» a menu announces has its bind in the configuration (bind [-r] X …, without the -n ones).
  keys=" $(grep -hE '^bind(-key)?( -r)? +[^-]' "$TH/.tmux.conf" "$c"/ux.tmux "$c"/extras.tmux 2>/dev/null \
              | sed -E 's/^bind(-key)?( -r)? +//' | awk '{ print $1 }' | tr -d "'\"\\\\" | tr '\n' ' ')"
  while IFS= read -r k; do   # with read and not with for: a key like «*» must not expand to the files of the folder
    [[ -n "$k" ]] || continue
    [[ "$keys" == *" $k "* ]] || sn+=" $k"
  done < <(grep -rhoE '\(Ctrl\+b [^ )]+\)' "$c"/menu*.tmux 2>/dev/null | sed -E 's/\(Ctrl\+b (.*)\)/\1/' | sort -u)
  [[ -z "$sn" ]] && ok "every «Ctrl+b X» shortcut announced in a menu exists" || fail "shortcuts announced without a bind:$sn"
  # 3. The help does not mention entries that are gone.
  ! grep -qiE 'Playwright|stop and GIF|presentation mode' "$TH/.local/bin/tmux-help" 2>/dev/null && ok "the help does not announce retired options" || fail "tmux-help announces options that do not exist"
  # 4. Every script a menu calls is installed and executable.
  fz=""
  # shellcheck disable=SC2088  # the tilde is part of the text searched for in the menus
  for f in $(grep -rhoE '~/\.local/bin/[A-Za-z0-9_-]+' "$c"/menu*.tmux "$c"/ux.tmux "$c"/extras.tmux "$TH/.tmux.conf" 2>/dev/null | sort -u); do
    [[ -x "$TH/${f#\~/}" ]] || fz+=" ${f##*/}"
  done
  [[ -z "$fz" ]] && ok "all the scripts the menus call are installed" || fail "missing scripts:$fz"
  # 5. One finder: the four pickers are views of tmux-find, each key opens its view and the main menu has one entry.
  local v bind nokey=""
  for v in "f:tmux-find" "M-s:tmux-find" "a:tmux-find --view active" "F:tmux-find --view favorites" "j:tmux-find --view recent"; do
    bind="$(grep -hE "^bind (-n )?${v%%:*} " "$TH/.tmux.conf" "$c"/ux.tmux "$c"/extras.tmux 2>/dev/null)"
    [[ "$bind" == *"tmux-popup-run ~/.local/bin/${v#*:}\"" ]] || nokey+=" ${v%%:*}"
  done
  [[ -z "$nokey" ]] && ok "Ctrl+b f, Alt+s, Ctrl+b a, Ctrl+b F and Ctrl+b j open the finder on their view" || fail "keys that do not open the finder:$nokey"
  [[ "$(grep -c 'tmux-find' "$c/menu.tmux")" == 1 ]] && ! grep -rqs --exclude='*.bak.*' 'tmux-pick' "$c" "$TH/.tmux.conf" \
    && ! grep -qE 'bin/tmux-(active|favorites|recent)[^-]' "$c/menu.tmux" \
    && ok "the main menu has one finder entry and nothing calls tmux-pick" || fail "menu.tmux: $(grep -c 'tmux-find' "$c/menu.tmux") finder entries, or an old picker is still called"
  # 6. Merged entries: each thing lives in one menu.
  only_in() {   # text menu → the text appears in that menu and in no other
    local m; grep -qF -- "$1" "$c/$2" || return 1
    for m in "$c"/menu*.tmux; do [[ "${m##*/}" == "$2" ]] || ! grep -qF -- "$1" "$m" || return 1; done
  }
  only_in 'tmux-solo new' menu-claude-level.tmux && only_in 'tmux-solo worktree' menu-claude-level.tmux \
    && ok "solo mode (this tab, new tab, new worktree) lives in the Protection menu only" || fail "solo entries are not only in menu-claude-level.tmux"
  only_in 'send-keys /tasks Enter' menu-claude.tmux && only_in 'send-keys C-t' menu-claude.tmux && only_in 'tmux-agents' menu-claude.tmux \
    && only_in 'send-keys C-x C-k' menu-claude.tmux && grep -q -- '── Tasks and subagents ──' "$c/menu-claude.tmux" \
    && ok "tasks and subagents (4 entries) live in one section of the Claude menu" || fail "tasks and subagents are not only in menu-claude.tmux"
  only_in 'tmux-recover' menu-session.tmux && [[ "$(grep -c 'tmux-recover' "$c/menu-session.tmux")" == 1 ]] && ! grep -q 'scripts/restore.sh' "$c"/menu*.tmux \
    && ok "restoring tabs from a save is one entry (tmux-recover)" || fail "menu-session.tmux: restore is not a single tmux-recover entry"
}

test_otel() {
  section "Local OpenTelemetry collector (ws-otel)"
  have ws-otel && have ws-telemetry || { warn "ws-otel is not installed"; return; }
  local port=$(( 20000 + RANDOM % 20000 )) run="$T/otel-run" u t r f
  mkdir -p "$run"; u="http://127.0.0.1:$port"; t="$(date +%s)000000000"
  O() { E env WS_OTEL_PORT="$port" XDG_RUNTIME_DIR="$run" ws-otel "$@"; }
  O start >/dev/null 2>&1 && O status >/dev/null 2>&1 && ok "the collector starts in the background and listens only on 127.0.0.1" || { fail "ws-otel did not start"; return; }
  post() { curl -s -o /dev/null -w '%{http_code}' -m 5 -X POST -H "Content-Type: ${3:-application/json}" "$u/v1/$1" -d "$2"; }
  r="$(post logs '{"resourceLogs":[{"resource":{"attributes":[{"key":"user.email","value":{"stringValue":"person@example.com"}}]},"scopeLogs":[{"logRecords":[
    {"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"api_request"}},{"key":"model","value":{"stringValue":"claude-sonnet-5-5"}},{"key":"duration_ms","value":{"stringValue":"1200"}},{"key":"ttft_ms","value":{"intValue":"350"}},{"key":"cost_usd","value":{"doubleValue":0.05}}]},
    {"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"claude_code.api_error"}},{"key":"status_code","value":{"stringValue":"529"}},{"key":"error","value":{"stringValue":"private-error-detail"}}]},
    {"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"claude_code.user_prompt"}},{"key":"prompt","value":{"stringValue":"free-text-otel token=secret-value-otel"}},{"key":"prompt_length","value":{"intValue":"18"}}]},
    {"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"claude_code.tool_decision"}},{"key":"tool_name","value":{"stringValue":"Bash"}},{"key":"decision","value":{"stringValue":"reject"}},{"key":"source","value":{"stringValue":"user_reject"}},{"key":"tool_parameters","value":{"stringValue":"{\"bash_command\":\"kubectl get pods --key=private-value-otel\"}"}}]}]}]}]}')"
  r+=" $(post metrics '{"resourceMetrics":[{"scopeMetrics":[{"metrics":[{"name":"claude_code.active_time.total","unit":"s","sum":{"dataPoints":[{"timeUnixNano":"'"$t"'","asDouble":120,"attributes":[{"key":"type","value":{"stringValue":"user"}}]}]}}]}]}]}')"
  r+=" $(post traces '{"resourceSpans":[{"scopeSpans":[{"spans":[{"name":"claude_code.llm_request","traceId":"a","spanId":"b","startTimeUnixNano":"'"$t"'","endTimeUnixNano":"'"$t"'","attributes":[{"key":"ttft_ms","value":{"intValue":"350"}}]}]}]}]}')"
  r+=" $(post logs 'xx' application/x-protobuf) $(curl -s -o /dev/null -w '%{http_code}' -m 5 -X POST "$u/other" -d '{}')"
  [[ "$r" == "200 200 200 415 404" ]] && ok "receives events, metrics and traces as JSON; rejects protobuf and other paths" || fail "collector responses: $r"
  f="$(ls "$TH"/.local/share/ws-telemetry/otel/*.jsonl 2>/dev/null | head -1)"
  [[ -n "$f" && "$(stat -c %a "$f")" == 600 ]] && grep -q 'free-text-otel' "$f" && grep -q 'private-error-detail' "$f" && ! grep -q 'secret-value-otel' "$f" \
     && grep -q '"program":"kubectl"' "$f" && ok "stores everything (0600), with the secrets masked and the command's program apart" || fail "collector file: ${f:-no file}"
  # No-content mode: same posts, without texts or identity.
  local run0="$T/otel-run0" d0="$T/otel-none" p0=$(( port + 1 ))
  mkdir -p "$run0"; E env WS_OTEL_PORT="$p0" XDG_RUNTIME_DIR="$run0" WS_OTEL_DIR="$d0" WS_OTEL_CONTENT=0 ws-otel start >/dev/null 2>&1
  curl -s -o /dev/null -m 5 -X POST -H 'Content-Type: application/json' "http://127.0.0.1:$p0/v1/logs" -d '{"resourceLogs":[{"resource":{"attributes":[{"key":"user.email","value":{"stringValue":"person@example.com"}}]},"scopeLogs":[{"logRecords":[{"timeUnixNano":"'"$t"'","attributes":[{"key":"event.name","value":{"stringValue":"claude_code.user_prompt"}},{"key":"prompt","value":{"stringValue":"free-text-otel"}},{"key":"prompt_length","value":{"intValue":"16"}}]}]}]}]}'
  E env WS_OTEL_PORT="$p0" XDG_RUNTIME_DIR="$run0" ws-otel stop >/dev/null 2>&1
  grep -q '"prompt_length":16' "$d0"/*.jsonl 2>/dev/null && ! grep -qE 'free-text-otel|person@example' "$d0"/*.jsonl \
    && ok "with WS_OTEL_CONTENT=0 it stores neither texts nor identity" || fail "no-content mode: $(cat "$d0"/*.jsonl 2>/dev/null | head -2)"
  rm -f "$TH/.local/share/ws-telemetry/.last"; E ws-telemetry build >/dev/null 2>&1
  r="$(python3 - "$TH/.local/share/ws-telemetry/dashboard.html" <<'PY'
import json, re, sys
d = json.loads(re.search(r"const D = (\{.*?\});\nconst \$", open(sys.argv[1], encoding="utf-8").read(), re.S).group(1)).get("otel") or {}
a = d.get("api") or {}
print(a.get("calls"), a.get("med_ms"), a.get("errors"), a.get("ttft_med_ms"), (d.get("errors") or [{}])[0].get("code"),
      (d.get("permissions") or [{}])[0].get("rejects"), (d.get("active") or [{}])[0].get("user_min"))
PY
)"
  [[ "$r" == "1 1200.0 1 350 529 1 2.0" ]] && ok "the dashboard adds up latency, errors per code, permissions and active time" || fail "otel block of the dashboard: $r"
  O stop >/dev/null 2>&1; ! O status >/dev/null 2>&1 && ok "the collector stops" || fail "ws-otel is still running"
}

test_report() {
  section "Full report (ws-report)"
  have ws-report && have ws-telemetry || { warn "ws-report is not installed"; return; }
  # Spanish on purpose: the prompts feed the recurring-prompt normalizer, which works on prompts typed in Spanish.
  local d="$TH/.claude/projects/-mnt-c-repos-inf" ts i r; mkdir -p "$d"; ts="$(date -u +%FT%TZ)"
  for i in 1 2 3; do
    printf '{"type":"user","sessionId":"inf%s","cwd":"/mnt/c/repos/inf","timestamp":"%s","message":{"content":"Revisa el PR de cobros y dime los riesgos %s"}}\n{"type":"assistant","sessionId":"inf%s","cwd":"/mnt/c/repos/inf","timestamp":"%s","message":{"id":"inf%s","model":"claude-opus-5-5","content":[{"type":"tool_use","name":"Task","input":{"subagent_type":"reviewer-inf","model":"haiku"}}],"usage":{"input_tokens":10,"output_tokens":100}}}\n{"type":"user","sessionId":"inf%s","timestamp":"%s","message":{"content":"<command-name>/compact</command-name>"}}\n' \
      "$i" "$ts" "$i" "$i" "$ts" "$i" "$i" "$ts" > "$d/inf$i.jsonl"
  done
  r="$(E env WS_REPORT_NO_WINDOWS=1 ws-report --json 2>&1)"
  jq -e '(.agents | any(.type == "reviewer-inf" and .uses == 3)) and (.recurring | any(.phrase | test("revisa pr cobros"))) and (.commands | any(.command == "/compact"))' <<<"$r" >/dev/null \
    && ok "measures agents, recurring prompts and slash commands" || fail "ws-report --json: ${r:0:300}"
  jq -e '(.tokens.output > 0) and (.tokens.your_words > 0) and (.trend.weeks | length == 12) and (.estimate_base | length >= 1)
         and (.ideas | type == "array") and (.learning.memories >= 0) and (.recurring | all(.phrase | test("^session being continued") | not))' <<<"$r" >/dev/null \
    && ok "measures tokens, words, weekly trend, estimation baseline, learning and ideas" || fail "ws-report --json without the new blocks"
  E env WS_REPORT_NO_WINDOWS=1 ws-report >/dev/null 2>&1
  local f; f="$(ls "$TH"/.local/share/ws-telemetry/reports/report-*.html 2>/dev/null | head -1)"
  [[ -n "$f" ]] && grep -q 'Recurring prompts' "$f" && grep -q 'Tokens and words' "$f" && grep -q 'Estimation baseline' "$f" && ! grep -q 'cobros y dime los riesgos 2' "$f" \
    && ok "builds the HTML and Markdown report without the text of the prompts" || fail "HTML report: ${f:-no file}"
}

test_handoff() {
  section "Export work to another Claude and learn from you"
  have ws-handoff && have ws-learn || { warn "patch 61 is not installed"; return; }
  local fc="$T/fc61" r="$T/r61" d f; mkdir -p "$fc" "$r"
  cat > "$fc/claude" <<'FAKE'
#!/bin/bash
echo "$*" >> "$WST_LOG.61"
p="${*: -1}"
case "$p" in
  *"HANDOFF PACKAGE"*) cat >/dev/null; printf '## Goal\nFinish the billing\n' ;;
  *"STABLE FACTS"*) echo '[{"subject":"user","predicate":"prefers","object":"Conventional Commits","evidence":"x"},{"subject":"user","predicate":"uses","object":"tmux","evidence":"y"}]' ;;
  *"slash commands"*) cat >/dev/null; echo '[{"name":"review-billing","description":"Reviews a billing PR","prompt":"Review $ARGUMENTS"}]' ;;
  *"mempalace_kg_add"*) in="$(cat)"; printf '%s' "$in" > "$WST_LOG.61.kg"
    jq -c 'to_entries[] | {type: "assistant", message: {content: [{type: "tool_use", id: "t\(.key)", name: "mcp__mempalace__mempalace_kg_add", input: .value}]}},
           {type: "user", message: {content: [{type: "tool_result", tool_use_id: "t\(.key)"}]}}' <<<"$in" ;;
esac
FAKE
  chmod +x "$fc/claude"
  ( cd "$r" && git init -q && git checkout -qb feature/COB-7 && git -c core.hooksPath=/dev/null -c user.email=t@t -c user.name=t commit -q --allow-empty -m "chore: init" )
  d="$TH/.claude/projects/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$r")"; mkdir -p "$d"
  printf '%s\n' '{"type":"user","message":{"content":"fix the billing; password=abc12345"}}' \
    '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"TodoWrite","input":{"todos":[{"content":"Validate amounts","status":"completed"},{"content":"Test retries","status":"pending"}]}},{"type":"tool_use","name":"Edit","input":{"file_path":"'"$r"'/src/billing.ts"}}]}}' > "$d/s1.jsonl"
  local cg=(env PATH="$fc:$TH/.local/bin:/usr/bin:/bin" WST_LOG="$T/log" WS_HANDOFF_NO_WINDOWS=1 WS_REPORT_NO_WINDOWS=1)
  E "${cg[@]}" ws-handoff "$r" --conversation >/dev/null 2>&1
  f="$(ls "$TH"/.local/share/ws-telemetry/handoffs/r61-*.md 2>/dev/null | head -1)"
  [[ -n "$f" ]] && grep -q '## Goal' "$f" && grep -q 'feature/COB-7' "$f" && grep -q '\[ \] Test retries' "$f" && grep -q 'src/billing.ts' "$f" \
    && [[ -f "${f%.md}.jsonl" ]] && ! grep -q 'abc12345' "$f" \
    && ok "handoff: Claude's summary, branch, tasks, files and conversation; secrets redacted" || fail "ws-handoff: $(head -c 400 "$f" 2>/dev/null)"
  printf '1\n' | E "${cg[@]}" ws-learn facts >/dev/null 2>&1
  grep -q 'Conventional Commits' "$T/log.61.kg" 2>/dev/null && ! grep -q '"tmux"' "$T/log.61.kg" \
    && ok "learn: only the facts you choose are saved to MemPalace" || fail "ws-learn facts: $(cat "$T/log.61.kg" 2>/dev/null)"
  grep -q 'mcp__mempalace__mempalace_diary_read' "$T/log.61" && ok "learn: Claude only reads MemPalace when proposing" || fail "ws-learn without the read tools"
  grep -q -- '--allowedTools mcp__mempalace__mempalace_kg_add' "$T/log.61" \
    && grep -qs '"type": "facts-saved".*Conventional Commits' "$TH"/.local/share/ws-telemetry/learning/*.jsonl \
    && ok "learn: the save goes through ws-memory (only kg_add, checked in the tool results, logged)" || fail "ws-learn facts did not go through ws-memory"
  # Spanish on purpose: recurring prompts for the normalizer of ws-report (see test_report).
  for i in 1 2 3; do printf '{"type":"user","sessionId":"ap%s","cwd":"/mnt/c/repos/ap","timestamp":"%s","message":{"content":"Revisa el PR de cobros por favor ahora %s"}}\n' "$i" "$(date -u +%FT%TZ)" "$i" > "$d/ap$i.jsonl"; done
  printf '1\n' | E "${cg[@]}" WS_LEARN_COMMANDS="$T/cmds" ws-learn commands >/dev/null 2>&1
  [[ -f "$T/cmds/review-billing.md" ]] && grep -q 'ARGUMENTS' "$T/cmds/review-billing.md" && ok "commands: creates the /command you chose" || fail "ws-learn commands"
}

#######################################
# == Language selector (ws-lang)
# The tests of the language selector (ws-lang, the packs in ~/.local/lib/ws-lang/, rules.es.conf, `cr --test` per
# language, and every consumer of the packs), all without tmux. What they rely on here:
#   · setup copies ~/.local/lib/ws-* (ws-lang.sh and the packs) and ~/.local/bin (ws-lang) into the isolated home,
#     and drops the copied ~/.config/tmux-claude/lang, so the isolated home starts without a saved language;
#   · this file exports WS_LANG=es for the fixtures marked «Spanish on purpose»: a test of the selector must set
#     its own value, e.g. `E env WS_LANG=en …` or `E env -u WS_LANG …` to read the lang file.
# The hooks run from the installed ~/.claude/hooks with HOME set to the isolated home (as the other sections do).
#######################################
test_lang() {
  section "Language selector (ws-lang)"
  have ws-lang && [[ -r "$TH/.local/lib/ws-lang.sh" ]] || { warn "ws-lang is not installed"; return; }
  local lf="$TH/.config/tmux-claude/lang" r rc
  # lg <en|es|file> command… — runs it in the isolated home with that language; «file» removes WS_LANG (this suite
  # exports es), so the saved setting decides.
  lg() { local l="$1"; shift; if [[ "$l" == file ]]; then E env -u WS_LANG "$@"; else E env WS_LANG="$l" "$@"; fi; }

  # 1. The command: default, saving, the environment over the file, invalid values, toggle.
  rm -f "$lf"
  [[ "$(lg file ws-lang --get)" == en && "$(lg file ws-lang --name)" == English ]] && ok "no saved language → en (English)" || fail "ws-lang --get without a saved language: $(lg file ws-lang --get 2>&1)"
  r="$(lg file ws-lang es 2>&1)"; rc=$?
  [[ $rc -eq 0 && "$(cat "$lf" 2>/dev/null)" == es && "$(stat -c %a "$lf" 2>/dev/null)" == 644 ]] && ok "ws-lang es saves one word in ~/.config/tmux-claude/lang" || fail "ws-lang es (exit $rc): $r"
  [[ "$(lg file ws-lang --get)" == es && "$(lg file ws-lang --name)" == Spanish ]] && ok "the saved language is read back (--get es, --name Spanish)" || fail "ws-lang --get after ws-lang es: $(lg file ws-lang --get 2>&1)"
  [[ "$(lg file ws-lang 2>&1)" == "Language: Spanish (es)"* ]] && ok "ws-lang without arguments shows the current language" || fail "ws-lang: $(lg file ws-lang 2>&1 | head -1)"
  [[ "$(lg en ws-lang --get)" == en && "$(lg en ws-lang --name)" == English ]] && ok "WS_LANG=en overrides the saved es" || fail "WS_LANG=en with es saved: $(lg en ws-lang --get 2>&1)"
  lg file ws-lang xx >/dev/null 2>&1; rc=$?
  [[ $rc -eq 2 && "$(cat "$lf" 2>/dev/null)" == es ]] && ok "an unknown language is refused (exit 2) and nothing is saved" || fail "ws-lang xx: exit $rc, saved «$(cat "$lf" 2>/dev/null)»"
  r="$(lg file ws-lang --toggle >/dev/null 2>&1; lg file ws-lang --get; lg file ws-lang --toggle >/dev/null 2>&1; lg file ws-lang --get)"
  [[ "$r" == $'en\nes' ]] && ok "--toggle switches es → en → es" || fail "ws-lang --toggle twice: ${r//$'\n'/ }"
  echo fr > "$lf"; r="$(lg file ws-lang --get)"; rm -f "$lf"
  [[ "$r" == en && "$(lg fr ws-lang --get)" == en ]] && ok "anything other than en or es (in the file or in WS_LANG) means en" || fail "invalid language: file «$r», WS_LANG «$(lg fr ws-lang --get 2>&1)»"

  # 2. The library and the packs: English always; with es, «<en>|<es>»; a key may exist only in the Spanish pack.
  # shellcheck disable=SC2016  # $HOME and $@ belong to the inner bash
  lpat() { local l="$1"; shift; lg "$l" bash -c 'source "$HOME/.local/lib/ws-lang.sh" && "$@"' _ "$@"; }
  [[ "$(lpat en ws_lang_pat notify.command)" == run ]] && ok "pack: en gives only the English expression" || fail "ws_lang_pat notify.command (en): $(lpat en ws_lang_pat notify.command 2>&1)"
  # Spanish on purpose: the value of the key in the Spanish pack.
  [[ "$(lpat es ws_lang_pat notify.command)" == 'run|ejecuta|ejecútalo|corre|córrelo|lanza' ]] && ok "pack: es gives English|Spanish" || fail "ws_lang_pat notify.command (es): $(lpat es ws_lang_pat notify.command 2>&1)"
  echo es > "$lf"; r="$(lpat file ws_lang_pat notify.command)"; rm -f "$lf"
  [[ "$r" == run\|* && "$r" == "$(lpat es ws_lang_pat notify.command)" ]] && ok "pack: the saved language counts when WS_LANG is not set" || fail "ws_lang_pat with es saved: $r"
  r="$(lpat en ws_lang_pat state.question)"; rc=$?
  [[ -z "$r" && $rc -eq 1 && -n "$(lpat es ws_lang_pat state.question)" ]] && ok "pack: a key only in the Spanish pack is empty (exit 1) with en" || fail "ws_lang_pat state.question (en): «$r» exit $rc"
  r="$(lpat es ws_lang_pat nope)"; rc=$?
  [[ -z "$r" && $rc -eq 1 ]] && ok "pack: an unknown key gives nothing (exit 1)" || fail "ws_lang_pat nope: «$r» exit $rc"
  r="$(lpat en ws_lang_list report.stopwords)"
  [[ -n "$r" && "$r" != *\|* && "$(lpat es ws_lang_list report.stopwords)" == "$r "?* ]] && ok "pack: word lists are joined with a space" || fail "ws_lang_list report.stopwords: en «$r» · es «$(lpat es ws_lang_list report.stopwords 2>&1)»"

  # 3 and 4. Routing rules per language (cr): rules.conf is English; rules.es.conf adds Spanish only with es.
  if have cr && [[ -r "$RH/.config/ws-routing/rules.conf" && -r "$RH/.config/ws-routing/rules.es.conf" ]]; then
    local rt=(env WS_ROUTING_RULES="$RH/.config/ws-routing/rules.conf" WS_ROUTING_LOG="$T/log-lang")
    r="$(lg en "${rt[@]}" cr --test 2>&1)"; rc=$?
    [[ $rc -eq 0 && "$(tail -1 <<<"$r")" == "Rules (en): 20/20 labelled tasks at their level (100 %)" ]] && ok "cr --test with en: the 20 English tasks" || fail "cr --test (en): $(tail -1 <<<"$r")"
    r="$(lg es "${rt[@]}" cr --test 2>&1)"; rc=$?
    [[ $rc -eq 0 && "$(tail -1 <<<"$r")" == "Rules (en es): 40/40 labelled tasks at their level (100 %)" ]] && ok "cr --test with es: the English and the Spanish tasks" || fail "cr --test (es): $(tail -1 <<<"$r")"
    # Spanish on purpose: a prompt only the Spanish rules classify.
    local task='diseña la arquitectura de pagos'
    r="$(lg es "${rt[@]}" cr --dry-run --no-ai --explain "$task" 2>&1)"
    [[ "$r" == *fable* && "$r" == *"(rule: architecture)"* ]] && ok "cr with es: a Spanish prompt matches its rule (architecture → fable)" || fail "cr (es) «$task»: $r"
    r="$(lg en "${rt[@]}" cr --dry-run --no-ai --explain "$task" 2>&1)"
    [[ "$r" == *opus* && "$r" == *"(rule: default)"* ]] && ok "cr with en: the same Spanish prompt matches no rule (default → opus)" || fail "cr (en) «$task»: $r"
    r="$(lg en "${rt[@]}" cr --dry-run --no-ai --explain 'design the architecture of the payments service' 2>&1)"
    [[ "$r" == *fable* && "$r" == *"(rule: architecture)"* && "$r" == "$(lg es "${rt[@]}" cr --dry-run --no-ai --explain 'design the architecture of the payments service' 2>&1)" ]] \
      && ok "cr: an English prompt is classified the same with en and with es" || fail "cr, English prompt: $r"
  else warn "routing is not installed: cr per language not tested"; fi

  # 5. Subagent hint (intent-route.sh).
  local ih="$RH/.claude/hooks/intent-route.sh"
  if [[ -f "$ih" ]]; then
    lih() { printf '{"prompt":%s}' "$(jq -Rn --arg p "$2" '$p')" | lg "$1" bash "$ih" 2>&1; }
    # Spanish on purpose: prompts typed in Spanish.
    [[ "$(lih es 'busca dónde se define UserService')" == *explorer* && "$(lih es 'Diseña la arquitectura de pagos')" == *architect* ]] \
      && ok "intent hook with es: Spanish prompts get their subagent hint" || fail "intent-route (es): «$(lih es 'busca dónde se define UserService')»"
    [[ -z "$(lih en 'busca dónde se define UserService')$(lih en 'Diseña la arquitectura de pagos')" ]] \
      && ok "intent hook with en: Spanish prompts get no hint" || fail "intent-route (en) gave a hint for a Spanish prompt"
    [[ "$(lih en 'design the architecture')" == *architect* && "$(lih es 'design the architecture')" == *architect* \
       && "$(lih en 'find where UserService is defined')" == *explorer* && "$(lih es 'find where UserService is defined')" == *explorer* ]] \
      && ok "intent hook: English prompts get their hint with en and with es" || fail "intent-route, English prompt: en «$(lih en 'design the architecture')» · es «$(lih es 'design the architecture')»"
  else warn "intent-route.sh is not installed"; fi

  # 6. «Waiting for you» (tmux-state.sh --asks: test mode, no tmux).
  local sh="$RH/.claude/hooks/tmux-state.sh"
  if [[ -f "$sh" ]]; then
    lasks() { lg "$1" bash "$sh" --asks /nonexistent "$2"; }
    # Spanish on purpose: answers written by Claude in Spanish (an imperative verb; a question opened with «¿»).
    lasks es 'Corre npm test y pégame la salida.' && lasks es 'Hecho. ¿Lo subo ahora? Avisa.' \
      && ok "waiting for you with es: Spanish verbs and «¿…?» count" || fail "tmux-state --asks (es) missed a Spanish request"
    ! lasks en 'Corre npm test y pégame la salida.' && ! lasks en 'Hecho. ¿Lo subo ahora? Avisa.' \
      && ok "waiting for you with en: Spanish verbs and «¿…?» do not count" || fail "tmux-state --asks (en) matched a Spanish request"
    lasks en 'Run this and tell me the result.' && lasks es 'Run this and tell me the result.' && ! lasks en 'All tests pass.' && ! lasks es 'Listo, todo en orden.' \
      && ok "waiting for you: English requests count with en and with es; a plain ending never does" || fail "tmux-state --asks, English request or plain ending"
  else warn "tmux-state.sh is not installed"; fi

  # 7. Telegram: the selftest in both languages, and the commands taken from an answer written in Spanish.
  if have ws-telegram; then
    [[ "$(lg en ws-telegram selftest 2>&1)" == ok && "$(lg es ws-telegram selftest 2>&1)" == ok ]] && ok "ws-telegram selftest passes with en and with es" || fail "ws-telegram selftest: en «$(lg en ws-telegram selftest 2>&1)» · es «$(lg es ws-telegram selftest 2>&1)»"
    local tl="$T/tg-lang" a b
    mkdir -p "$tl/cfg"; printf 'chat_id=42\n' > "$tl/cfg/config"
    # ltg <en|es> <n> <answer> — the commands ws-telegram proposes for a finished answer, joined with «|» (the
    # notification is only queued: no service, no network; the tmux title is empty without a server).
    ltg() {
      lg "$1" env WS_TELEGRAM_CFG="$tl/cfg" WS_TELEGRAM_ST="$tl/st-$1-$2" WS_TELEGRAM_LOG="$tl/log" WS_TELEGRAM_NO_SERVICE=1 \
        ws-telegram notify "done" %0 "$3" >/dev/null 2>&1
      cat "$tl/st-$1-$2"/outbox/*_c*.json 2>/dev/null | jq -r '.command' | paste -sd'|'
    }
    # Spanish on purpose: these fixtures test extraction from answers written in Spanish.
    a=$'Corre `! npm test` y luego:\n```bash\n! az account show\n```\n! ls -la\n¡Listo! nada'
    b=$'Corre `git status`:\n```bash\n# instala\n$ npm ci\n```\n```python\nimport os\n```\n```\ndocker compose ps\nprint(x)\n```\nY ejecuta `pnpm lint`; el archivo `src/app.ts` no.'
    r="$(ltg es 1 "$a")"
    [[ "$r" == 'npm test|az account show|ls -la' ]] && ok "Telegram with es: the ! commands of a Spanish answer" || fail "Telegram extraction (es): $r"
    r="$(ltg es 2 "$b")"
    [[ "$r" == 'npm ci|docker compose ps|git status|pnpm lint' ]] && ok "Telegram with es: commands after a Spanish verb (corre, ejecuta) and in code blocks" || fail "Telegram extraction without ! (es): $r"
    r="$(ltg en 2 "$b")"
    [[ "$r" == 'npm ci|docker compose ps' ]] && ok "Telegram with en: the Spanish verbs propose nothing (only the code blocks)" || fail "Telegram extraction without ! (en): $r"
  else warn "ws-telegram is not installed"; fi

  # 8. The menu entry: one line, shows the tmux option @ws_lang and switches with ws-lang --toggle.
  local mw="$TH/.config/tmux-claude/menu-workstation.tmux"
  r="$(grep -F 'ws-lang --toggle' "$mw" 2>/dev/null)"
  [[ -n "$r" && "$(wc -l <<<"$r")" == 1 && "$r" == *'@ws_lang'* ]] && ok "menu Workstation: one entry shows the language (@ws_lang) and switches it" || fail "menu-workstation.tmux: language entry «$r»"
  grep -qF 'ws-lang --sync' "$TH/.tmux.conf" 2>/dev/null && ok ".tmux.conf sets @ws_lang at start (ws-lang --sync)" || fail ".tmux.conf does not run ws-lang --sync"
  if have ws-menus; then
    r="$(E ws-menus 2>/dev/null)"
    [[ "$r" == "# Menu check"* ]] && ! grep -qE '^- menu-workstation\.tmux: key «|calls ws-lang, which does not exist' <<<"$r" \
      && ok "ws-menus: no repeated key in the Workstation menu and ws-lang exists" || fail "ws-menus: $(grep -E '^- menu-workstation\.tmux: key «|calls ws-lang' <<<"$r" | head -1)"
  else warn "ws-menus is not installed"; fi

  # 9. Without the library (a half-installed kit): the hooks stay quiet and the routing stays English.
  local nl="$T/home-nolang"; mkdir -p "$nl/.local/lib" "$nl/.config"
  if [[ -f "$ih" ]]; then
    r="$(printf '{"prompt":"design the architecture"}' | lg es env HOME="$nl" bash "$ih" 2>&1)"; rc=$?
    [[ -z "$r" && $rc -eq 0 ]] && ok "no ws-lang.sh: the intent hook prints nothing and exits 0" || fail "intent-route without ws-lang.sh: exit $rc «$r»"
  fi
  if [[ -f "$sh" ]]; then
    lg es env HOME="$nl" bash "$sh" --asks /nonexistent 'Shall I push it now?' && ! lg es env HOME="$nl" bash "$sh" --asks /nonexistent 'Run this and tell me the result.' \
      && ok "no ws-lang.sh: «waiting for you» keeps only the closing question mark" || fail "tmux-state --asks without ws-lang.sh"
  fi
  if [[ -r "$TH/.local/lib/ws-routing.sh" && -r "$RH/.config/ws-routing/rules.conf" ]]; then
    cp "$TH/.local/lib/ws-routing.sh" "$nl/.local/lib/"
    # Spanish on purpose (second prompt): without the library the Spanish rules are not loaded, even with es.
    # shellcheck disable=SC2016  # $HOME and $@ belong to the inner bash
    r="$(lg es env HOME="$nl" WS_ROUTING_RULES="$RH/.config/ws-routing/rules.conf" bash -c 'source "$HOME/.local/lib/ws-routing.sh"; routing_classify "$1"; routing_classify "$2"' \
           _ 'design the architecture of the payments service' 'diseña la arquitectura de pagos' 2>&1)"
    [[ "$r" == $'fable architecture\nopus default' ]] && ok "no ws-lang.sh: the routing still classifies English prompts (Spanish ones → default)" || fail "routing_classify without ws-lang.sh: ${r//$'\n'/ · }"
  fi
  rm -f "$lf"   # the isolated home ends as it started: without a saved language
}

# Per-tab profiles (ADR-021) on a real tmux server: switching a tab to an isolated profile starts a NEW conversation
# with that profile's login and fence, the tab's shell gets its credentials and memory off, a level change keeps the
# profile, the bar shows its label, and back to work gives your own sessions again.
test_profiles() {
  use_socket prof
  section "Per-tab profiles (ws-profile)"
  have ws-profile || { warn "ws-profile is not installed"; return; }
  local A="$TH/.claude-profiles/acme" C="$TH/.config/ws-agent/acme" p w r
  E ws-profile new acme --tenant 00000000-0000-0000-0000-0000000000aa --no-login >/dev/null 2>&1
  [[ -f "$TH/.config/ws-profiles/acme/profile.conf" && -L "$A/settings.json" && ! -e "$A/projects" && -d "$C/azure" ]] \
    && ok "ws-profile new: the kit setup linked, its own conversations, its credential folders" || fail "ws-profile new: $(ls -A "$A" 2>&1 | tr '\n' ' ')"
  echo x > "$A/.credentials.json"
  : > "$T/claude.log"; p="$(pane_with_claude prof)"; w="$(tm display -p -t "$p" '#{window_id}')"
  conversation_in "$T/repos"
  E ws-profile tab acme "$p" >/dev/null 2>&1; sleep 2
  tail -1 "$T/claude.log" | grep -q "cfg=$A args=--settings [^ ]*/normal@acme\.json$" \
    && ok "tab → acme: a NEW conversation (another store) with acme's login and its fence" || fail "tab → acme: $(tail -1 "$T/claude.log")"
  [[ "$(tm show -wqv -t "$w" @cprofile)" == acme && "$(tm show -wqv -t "$w" @cprofile_label)" == acme ]] \
    && ok "the tab is marked with its profile and label" || fail "tab options: $(tm show -w -t "$w" 2>&1 | grep cprofile | tr '\n' ' ')"
  E tmux-background --bar >/dev/null 2>&1
  [[ "$(tm show -gv window-status-format)" == *"@cprofile_label"* && "$(tm show -gv window-status-current-format)" == *"@cprofile_label"* ]] \
    && ok "the status bar shows the label of a custom profile" || fail "the bar has no profile label"
  # The simulated Claude is closed by hand; then the tab's shell is asked what it runs with.
  tm send-keys -t "$p" /exit Enter; sleep 0.4
  tm send-keys -t "$p" "echo \"\$WS_PROFILE|\$WS_MEMORY|\$AZURE_CONFIG_DIR|\$GH_CONFIG_DIR\" > '$T/prof.env'" Enter; sleep 0.5
  [[ "$(cat "$T/prof.env" 2>/dev/null)" == "acme|off|$C/azure|$C/gh" ]] \
    && ok "the tab's shell runs with acme's az and gh folders (a hand-typed az uses them) and memory off" || fail "tab shell: $(cat "$T/prof.env" 2>/dev/null)"
  r="$(jq -nc '{tool_name: "mcp__mempalace__mempalace_search", tool_input: {query: "client"}}' | E env WS_PROFILE=acme WS_MEMORY=off bash "$RH/.claude/hooks/memory-gate.sh" >/dev/null 2>&1; echo $?)"
  [[ "$r" == 2 ]] && ok "memory off: the tab's Claude cannot read or write MemPalace" || fail "memory-gate with memory off: exit $r"
  r="$A/projects/${T//[^A-Za-z0-9]/-}-repos"; mkdir -p "$r" && echo '{"type":"user"}' > "$r/c1.jsonl"   # acme's own conversation there
  E tmux-level normal "$p" >/dev/null 2>&1; sleep 1.5
  tail -1 "$T/claude.log" | grep -q "cfg=$A args=--continue --settings [^ ]*/normal@acme\.json$" \
    && ok "a level change keeps the tab's profile and resumes ITS conversation" || fail "tmux-level in an acme tab: $(tail -1 "$T/claude.log")"
  tm send-keys -t "$p" /exit Enter; sleep 0.4
  E ws-profile tab work "$p" >/dev/null 2>&1; sleep 1.5
  tail -1 "$T/claude.log" | grep -q "cfg=work args=--settings [^ ]*/normal@work\.json$" \
    && ok "back to work: a new conversation with your own login, fenced from acme's" || fail "tab → work: $(tail -1 "$T/claude.log")"
  tm send-keys -t "$p" /exit Enter; sleep 0.4
  tm send-keys -t "$p" "echo \"\$WS_PROFILE|\${AZURE_CONFIG_DIR:-unset}|\${CLAUDE_CONFIG_DIR:-unset}\" > '$T/prof.env'" Enter; sleep 0.5
  [[ "$(cat "$T/prof.env" 2>/dev/null)" == "work|unset|unset" ]] && ok "…and the shell gets your own az and Claude again" || fail "work shell: $(cat "$T/prof.env" 2>/dev/null)"
  tm kill-server 2>/dev/null
  rm -rf "$TH/.config/ws-profiles" "$TH/.claude-profiles" "$TH/.config/ws-agent" "$TH/.config/claude-levels/"*@*.json
}

# The checks ws-verify makes on the running server, against a throwaway one: TMUX_TMPDIR and HOME point it there.
test_live_server() {
  use_socket live
  section "ws-verify --live: the running tmux server (PATH, save, tabs, scripts, sockets)"
  have ws-verify && grep -q -- '--clean-sockets' "$TH/.local/bin/ws-verify" || { warn "ws-verify --live is not installed"; return; }
  local R="$TH/.local/share/tmux/resurrect" sd r rc before; sd="$T/s/live/tmux-$(id -u)"
  mkdir -p "$R"; before="$(readlink "$R/last" 2>/dev/null || true)"
  plain() { sed 's/\x1b\[[0-9;]*m//g'; }
  tm -f /dev/null new-session -d -s dev -n one; tm new-window -d -t dev -n two
  tm new-session -d -t dev -s dev-m2                      # linked session (monitor 2): its tabs are the group's
  printf 'window\tdev\t0\nwindow\tdev\t1\n' > "$R/tmux_resurrect_live.txt"; ln -sfn tmux_resurrect_live.txt "$R/last"
  r="$(E ws-verify --live 2>&1 | plain)"; rc=${PIPESTATUS[0]}
  [[ $rc == 0 && "$r" == *"ok     the server's PATH has ~/.local/bin"* && "$r" == *"ok     the save has the open tabs (2)"* && "$r" == *"· 0 failed"* ]] \
    && ok "a healthy server passes, and a linked session does not count as more tabs" || fail "ws-verify --live on a healthy server (rc=$rc): $(grep -E 'FAIL|Result' <<<"$r" | head -3 | tr '\n' ' ')"
  [[ "$r" == *"ok     save: the server started"* ]] && ok "the save is not judged in the first 5 minutes of the server" || fail "ws-verify --live judged the save of a server that just started"
  # Everything wrong at once: no ~/.local/bin in the server's PATH, a tab that is not in the save, a finder session
  # nobody is attached to, a key bound to a script that does not exist and the socket of a server that ended.
  tm set-environment -g PATH /usr/bin:/bin; tm new-window -d -t dev -n three
  tm new-session -d -t dev -s find-peek-77
  # shellcheck disable=SC2088  # tmux expands the tilde when the key runs
  tm bind-key F9 run-shell "~/.local/bin/ws-not-installed x"
  tm -L wsdead -f /dev/null new-session -d -s x; tm -L wsdead kill-server; tm -L wslive -f /dev/null new-session -d -s x; sleep 0.3
  r="$(E ws-verify --live 2>&1 | plain)"; rc=${PIPESTATUS[0]}
  [[ $rc == 1 && "$r" == *"FAIL   the server's PATH lacks ~/.local/bin"*"→ tmux set-environment -g PATH"* ]] \
    && ok "a server without ~/.local/bin in its PATH fails, with the command that fixes it" || fail "ws-verify --live did not see the server's PATH (rc=$rc)"
  [[ "$r" == *"FAIL   the save has 2 tabs and 3 are open"* ]] && ok "a save that does not have the open tabs fails" || fail "ws-verify --live: tabs: $(grep 'the save has' <<<"$r")"
  [[ "$r" == *"FAIL   leftover finder sessions without a client: find-peek-77"*"tmux kill-session -t =find-peek-77"* ]] \
    && ok "a leftover find-peek-* session without a client fails" || fail "ws-verify --live did not see the leftover finder session"
  [[ "$r" == *"FAIL   the status bar, a key or a hook calls scripts that are missing or not executable: ws-not-installed"* ]] \
    && ok "a key bound to a script that is not installed fails" || fail "ws-verify --live did not see the missing script: $(grep 'scripts' <<<"$r")"
  [[ "$r" == *"FAIL   1 stale tmux sockets in $sd: wsdead"*"→ ws-verify --clean-sockets"* ]] \
    && ok "the socket of a server that ended is reported; a live one is not" || fail "ws-verify --live: sockets: $(grep -i 'socket' <<<"$r")"
  r="$(E ws-verify --clean-sockets 2>&1)"
  [[ "$r" == *"1 stale tmux sockets removed"* && ! -e "$sd/wsdead" && -S "$sd/wslive" && -S "$sd/default" ]] && tm has-session -t dev \
    && ok "--clean-sockets removes only the sockets no server answers on" || fail "ws-verify --clean-sockets: $r · $(ls "$sd" | tr '\n' ' ')"
  tm -L wslive kill-server 2>/dev/null; tm kill-server 2>/dev/null
  rm -f "$R/tmux_resurrect_live.txt" "$R/last"; [[ -n "$before" ]] && ln -sfn "$before" "$R/last"
}

