#!/usr/bin/env python3
"""ws-aprender — lets Claude learn from you, with your approval (HITL). Menu → Usage → a / k.

  ws-aprender hechos [--dias 14]  Claude (with the MemPalace tools, read-only) reviews your diary and your recent
                                  sessions and PROPOSES stable facts about you: preferences, conventions,
                                  architecture decisions, tools, projects. You choose which ones; only those are
                                  saved to the MemPalace graph (mempalace_kg_add). That way any Claude with
                                  MemPalace looks them up before answering.
  ws-aprender comandos            from the requests you repeat (ws-informe), Claude proposes your own slash commands
                                  (~/.claude/commands/<name>.md). You choose which are created; never overwrites.
Log of what was learned: ~/.local/share/ws-telemetria/aprendizaje/YYYY-MM-DD.jsonl.
"""
from __future__ import annotations

import datetime as dt
import json
import os
import re
import shutil
import subprocess  # nosec B404 — claude, ws-informe, fzf with fixed arguments
import sys
from pathlib import Path

HOME = Path.home()
BIN = HOME / ".local/bin"
DATOS = Path(os.environ.get("WS_TELEMETRIA_DIR", HOME / ".local/share/ws-telemetria"))
CMDS = Path(os.environ.get("WS_APRENDER_COMANDOS", HOME / ".claude/commands"))
LEER = "mcp__mempalace__mempalace_diary_read,mcp__mempalace__mempalace_search,mcp__mempalace__mempalace_kg_query,mcp__mempalace__mempalace_kg_stats"
ESCRIBIR = "mcp__mempalace__mempalace_kg_add"


def claude(prompt: str, herramientas: str = "", entrada: str = "", t: int = 600) -> str:
    if not shutil.which("claude"):
        sys.exit("✖ Claude is not in PATH")
    # No TMUX_PANE: the tab's hooks (routing, state) must not treat this call as a message of yours.
    args = ["env", "-u", "TMUX_PANE", "-u", "TMUX", "claude", "-p", "--model", "sonnet", "--no-session-persistence",
            *(["--allowedTools", herramientas] if herramientas else ["--tools", ""]), prompt]
    try:
        return subprocess.run(args, input=entrada, capture_output=True, text=True, timeout=t).stdout  # nosec B603
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit(f"✖ Claude did not answer: {e}")


def json_de(texto: str):
    m = re.search(r"\[[\s\S]*\]", texto)
    try:
        return json.loads(m.group(0)) if m else []
    except ValueError:
        return []


def elegir(opciones: list[str]) -> list[int]:
    """Chosen indexes: fzf multi (Tab) if there is a terminal; otherwise a line of numbers (e.g. "1 3 4" or "all")."""
    if not opciones:
        return []
    if sys.stdin.isatty() and shutil.which("fzf"):
        r = subprocess.run(["fzf", "--multi", "--reverse", "--prompt", "save> ", "--header", "Tab marks · Enter saves the marked ones · Esc saves nothing"],  # nosec B603 B607
                           input="\n".join(f"{i + 1}\t{o}" for i, o in enumerate(opciones)), capture_output=True, text=True).stdout
        return [int(l.split("\t", 1)[0]) - 1 for l in r.splitlines() if l.strip()]
    for i, o in enumerate(opciones, 1):
        print(f"  {i}. {o}")
    r = input("Which ones do I save? (numbers separated by spaces, \"all\" or Enter for none): ").strip().lower()
    if r in ("all", "todos"):
        return list(range(len(opciones)))
    return [int(x) - 1 for x in r.split() if x.isdigit() and 0 < int(x) <= len(opciones)]


def registrar(tipo: str, datos) -> None:
    d = DATOS / "aprendizaje"; d.mkdir(parents=True, exist_ok=True)
    with open(d / f"{dt.date.today():%Y-%m-%d}.jsonl", "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"ts": dt.datetime.now().isoformat(timespec="seconds"), "tipo": tipo, "datos": datos}, ensure_ascii=False) + "\n")


def hechos(dias: int) -> int:
    print(f"Claude is reviewing your diary and sessions from the last {dias} days in MemPalace (read-only)…")
    r = claude(f"Use the MemPalace tools (diary_read, search, kg_query, kg_stats) to review the last {dias} days of the user "
               "Andrés (wing andres and the projects). Propose STABLE FACTS about him that are worth remembering: "
               "work preferences, conventions, architecture decisions in force, tools and active projects. "
               "Skip what is already in the graph (query it) and anything short-lived. No secrets or sensitive personal data. "
               "Answer ONLY with a JSON array: [{\"sujeto\":\"Andrés\",\"predicado\":\"prefers\",\"objeto\":\"…\",\"evidencia\":\"…\"}] "
               "with at most 15 items.", LEER)
    props = [h for h in json_de(r) if isinstance(h, dict) and h.get("sujeto") and h.get("predicado") and h.get("objeto")]
    if not props:
        print("Claude proposed no new facts."); return 0
    elegidos = elegir([f"{h['sujeto']} · {h['predicado']} · {h['objeto']}  ({h.get('evidencia', '')[:80]})" for h in props])
    if not elegidos:
        print("Nothing was saved."); return 0
    sel = [props[i] for i in elegidos]
    out = claude("Save EXACTLY these facts to the MemPalace graph, one by one, with mempalace_kg_add "
                 "(subject, predicate, object; source = 'ws-aprender'). Do not add or change anything. At the end say how many you saved.",
                 ESCRIBIR, json.dumps(sel, ensure_ascii=False))
    registrar("hechos", sel)
    print(out.strip() or f"Saved {len(sel)} facts.")
    return 0


def comandos() -> int:
    try:
        d = json.loads(subprocess.run([str(BIN / "ws-informe"), "--json"], capture_output=True, text=True, timeout=600).stdout)  # nosec B603
    except (OSError, subprocess.SubprocessError, ValueError):
        sys.exit("✖ Could not read the recurring requests (ws-informe --json)")
    rec = d.get("recurrentes") or []
    if not rec:
        print("No request is repeated often enough (3 or more times)."); return 0
    r = claude("These are the openings of requests the user repeats in Claude Code (normalized). Propose personal slash "
               "commands that solve them in one go. Answer ONLY with a JSON array: [{\"nombre\":\"review-pr\","
               "\"descripcion\":\"…\",\"prompt\":\"command text in Markdown; use $ARGUMENTS where the variable part goes\"}] "
               "with at most 8. Lowercase names with hyphens.", "", json.dumps(rec, ensure_ascii=False))
    props = [c for c in json_de(r) if isinstance(c, dict) and re.fullmatch(r"[a-z0-9][a-z0-9-]{1,40}", str(c.get("nombre", "")))]
    if not props:
        print("Claude proposed no commands."); return 0
    elegidos = elegir([f"/{c['nombre']} — {c.get('descripcion', '')}" for c in props])
    CMDS.mkdir(parents=True, exist_ok=True); hechos_ = []
    for i in elegidos:
        c = props[i]; f = CMDS / f"{c['nombre']}.md"
        if f.exists():
            print(f"  skipped /{c['nombre']} ({f} already exists)"); continue
        f.write_text(f"---\ndescription: {c.get('descripcion', '')}\n---\n\n{c['prompt']}\n", encoding="utf-8")
        print(f"  done    /{c['nombre']} → {f}"); hechos_.append(c["nombre"])
    registrar("comandos", hechos_)
    if hechos_:
        print("Use them in any Claude: /" + " · /".join(hechos_) + "  (ws-personal agregar .claude/commands/ to version them)")
    return 0


def main() -> int:
    a = sys.argv[1:]
    if not a or a[0] not in ("hechos", "comandos"):
        print(__doc__); return 2
    if a[0] == "hechos":
        return hechos(int(a[a.index("--dias") + 1]) if "--dias" in a else 14)
    return comandos()


if __name__ == "__main__":
    sys.exit(main())
