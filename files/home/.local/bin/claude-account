#!/usr/bin/env bash
#
# claude-account — the two Claude accounts (work and personal), now the built-in profiles of ws-profile (ADR-021):
# work is ~/.claude, personal is ~/.claude-personal, each with its own login (CLAUDE_CONFIG_DIR) and both sharing
# conversations, history, todos and the whole setup, so after switching accounts `claude -c` continues the same
# conversation. This command keeps its commands and messages; ws-profile does the work (and adds more profiles).
#
# Usage:
#   claude-account setup              prepares ~/.claude-personal (links, MCP and startup state); leaves ~/.claude alone
#   claude-account login personal     signs in to the personal account (pick the organization)
#   claude-account logout personal    signs out of the personal account only (the work one is untouched)
#   claude-account tab [PANE]         switches the tab to the other account and resumes the conversation
#   claude-account use work|personal       account for new tabs
#   claude-account project work|personal|remove [folder | --pane ID]
#                                    pins the account of a project (its repo and worktrees): every new tab opened
#                                    there uses that account, whatever the default is. No folder: the current one.
#   claude-account projects           lists the projects with a pinned account
#   claude-account status             default account, organization of each one and projects with a pinned account
set -euo pipefail
PATH="$HOME/.local/bin:$PATH"   # tmux menus may start it with a minimal PATH (tmux-level, claude-resume)
P="$HOME/.claude-personal"
WP="$HOME/.local/bin/ws-profile"
# shellcheck source=../lib/ws-profile.sh
. "$HOME/.local/lib/ws-profile.sh"

msg() { if [[ -n "${TMUX:-}" ]]; then tmux display "$1"; else echo "$1"; fi; }

# auth_txt work|personal — login status of that account (text). stdin from /dev/null:
# `timeout` puts Claude in another process group and, if it touches the terminal, it stays stopped.
auth_txt() {
  if [[ "$1" == personal ]]; then CLAUDE_CONFIG_DIR="$P" timeout -k 2 15 claude auth status --text </dev/null 2>&1
  else env -u CLAUDE_CONFIG_DIR timeout -k 2 15 claude auth status --text </dev/null 2>&1; fi
}

# org_of work|personal — name of the organization that account is signed in to.
org_of() { { auth_txt "$1" || true; } | sed -n 's/^Organization: //p'; }

tab() {
  local pane="${1:-$(tmux display -p '#{pane_id}')}" current target om op
  current="$("$WP" --of-pane "$pane")"
  [[ "$current" == personal ]] && target=work || target=personal   # any other profile goes to personal
  if [[ "$target" == personal ]] && [[ ! -f "$P/.credentials.json" ]]; then
    msg "The personal account is not signed in: Menu → Claude → Log in to the personal account"; exit 1
  fi
  # Safeguard: if both accounts are in the same organization, switching would spend the wrong usage.
  om="$(org_of work)"; op="$(org_of personal)"
  if [[ -n "$om" && "$om" == "$op" ]]; then
    msg "Both accounts are in the same organization ($om): check with claude-account status"; exit 1
  fi
  [[ "$target" == personal && -z "$op" ]] && { msg "The personal account does not report a session: claude-account status"; exit 1; }
  "$WP" tab "$target" "$pane" --quiet
  msg "$(tmux display -p -t "$pane" '#W'): account $target ($( [[ "$target" == personal ]] && echo "$op" || echo "$om" )), same conversation"
}

case "${1:-status}" in
  setup)  "$WP" setup personal ;;
  login)  [[ "${2:-}" == personal ]] || { echo "usage: claude-account login personal" >&2; exit 2; }
          "$WP" login personal claude; echo; "$0" status ;;
  # Signs out of the personal session ONLY (a normal /logout or claude auth logout would close the work one).
  logout) [[ "${2:-}" == personal ]] || { echo "usage: claude-account logout personal" >&2; exit 2; }
          "$WP" logout personal ;;
  tab)    shift; tab "$@" ;;
  use)    [[ "${2:-}" == work || "${2:-}" == personal ]] || { echo "usage: claude-account use work|personal" >&2; exit 2; }
          "$WP" use "$2" quiet; msg "New tabs: account $2" ;;
  project) [[ "${2:-}" =~ ^(work|personal|remove)$ ]] || { echo "usage: claude-account project work|personal|remove [folder | --pane ID]" >&2; exit 2; }
          shift; "$WP" project "$@" --quiet
          r="${2:-.}"; [[ "$r" == --pane ]] && r="$(tmux display -p -t "${3:?pane}" '#{pane_current_path}')"
          r="$(basename "$(realpath -e "$r")")"
          if [[ "$1" == remove ]]; then msg "$r: no pinned account (uses the one for new tabs)"
          else msg "$r: new tabs always use the $1 account"; fi ;;
  projects) "$WP" projects | sed 's/(no project with a pinned profile)/(no project with a pinned account)/' ;;
  status) wsp_default; echo "New tabs: $([[ "$REPLY" == personal ]] && echo personal || echo work)"
          for c in work personal; do
            printf '%-9s ' "$c:"
            if [[ "$c" == personal && ! -d "$P" ]]; then echo "not prepared (claude-account setup)"; continue; fi
            t="$(auth_txt "$c")" && rc=0 || rc=$?
            if (( rc == 124 || rc == 137 )); then printf 'no answer in 15 s'
            elif grep -qi '^Organization:' <<<"$t"; then grep -iE '^(Organization|Email):' <<<"$t" | tr '\n' ' '
            else printf '%s' "$(head -1 <<<"$t")"; fi
            echo
          done
          echo "Projects with a pinned account:"; "$0" projects ;;
  *) sed -n '8,18p' "$0"; exit 2 ;;
esac
