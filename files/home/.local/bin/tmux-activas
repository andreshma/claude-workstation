#!/usr/bin/env bash
#
# tmux-activas — de un vistazo, las pestañas que están trabajando AHORA o tuvieron actividad reciente, de todos los
# grupos, sin navegar una por una. Ctrl+b a (o Menú → a).
#   Primero lo que te espera (✋ aprobar, ❓ pregunta, ✖ error), luego lo que trabaja (🧠 🔧 🐝 📦) y al final lo
#   que terminó hace poco (✔ listo hace < 15 min, ⛔ interrumpido). Agrupado por grupo (sesión tmux).
#   Enter va a la pestaña · Ctrl+R actualiza (se actualiza sola cada 3 s si tu fzf lo permite) · Esc cierra
# Uso: tmux-activas [--minutos 15]   ·   tmux-activas --lista [--minutos N]   (solo las filas; pruebas)
set -uo pipefail
TAB=$'\t'
MIN=15
for ((i = 1; i <= $#; i++)); do [[ "${!i}" == --minutos ]] && { j=$((i + 1)); MIN="${!j}"; }; done

lista() {
  [[ -x "$HOME/.local/bin/tmux-estado" ]] && "$HOME/.local/bin/tmux-estado" --todas
  local ahora; ahora=$(date +%s)
  tmux list-windows -a -F "#{?session_grouped,#{session_group},#{session_name}}${TAB}#{session_name}${TAB}#{window_id}${TAB}#{window_index} #{window_name}${TAB}#{?#{@cfase},#{@cfase},-}${TAB}#{?#{@cs},#{@cs},-}${TAB}#{?#{@cdet},#{@cdet},-}${TAB}#{?#{@cts},#{@cts},0}${TAB}#{window_activity}${TAB}#{?#{@etq},#{@etq},}" 2>/dev/null |
  awk -F"$TAB" -v OFS="$TAB" -v ahora="$ahora" -v min="$MIN" '
    $1 != $2 { next }                       # sesión enlazada (monitor 2): ya sale con su grupo
    {
      f = $5; ult = ($8 > $9 ? $8 : $9); hace = ahora - ult
      if (f ~ /^(permiso|pregunta|tetoca|error)$/)        p = 0
      else if (f ~ /^(pensando|herramienta|compactando)$/) p = 1
      else if (hace <= min * 60)                         p = 2
      else next
      det = ($7 == "-" ? "" : $7); est = ($6 == "-" ? (f == "-" ? "actividad" : f) : $6)
      printf "%d%s%s%s%s:%s%s\033[36m%-10.10s\033[0m %-22.22s %-24.24s %-40.40s %s\n", p, OFS, $1, OFS, $2, $3, OFS, "[" $1 "]", $4, est, det, $10
    }' | sort -t"$TAB" -k1,1n -k2,2 | cut -f3-
}

if [[ " $* " == *" --lista "* ]]; then lista; exit 0; fi
command -v fzf >/dev/null || { lista | cut -f2-; read -rsn1; exit 0; }
encabezado="$(printf '%-10s %-22s %-24s %-40s %s' GRUPO PESTAÑA ESTADO 'QUÉ HACE' ETIQUETA)"
extra=()
# fzf ≥ 0.36: --listen permite actualizar la lista desde afuera cada 3 s.
if fzf --help 2>/dev/null | grep -q -- '--listen'; then
  puerto=$(( 20000 + RANDOM % 20000 ))
  extra=(--listen "127.0.0.1:$puerto")
  ( sleep 3; while kill -0 $$ 2>/dev/null; do
      curl -s -XPOST "127.0.0.1:$puerto" -d "reload($0 --lista --minutos $MIN)" >/dev/null 2>&1 || break; sleep 3; done ) &
fi
sel="$(lista | fzf --ansi --delimiter="$TAB" --with-nth=2 --no-sort --reverse --cycle "${extra[@]}" \
        --header="$encabezado"$'\n'"Activas ahora y con actividad en los últimos $MIN min · Enter va · Ctrl+R actualiza · Esc cierra" \
        --bind "ctrl-r:reload($0 --lista --minutos $MIN)" --prompt 'activas> ')" || exit 0
destino="${sel%%"$TAB"*}"
tmux switch-client -t "=${destino%%:*}" 2>/dev/null
tmux select-window -t "${destino#*:}" 2>/dev/null
