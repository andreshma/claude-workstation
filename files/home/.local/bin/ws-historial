#!/usr/bin/env bash
#
# ws-historial — busca posibles secretos en el historial de bash SIN mostrarlos: solo número de línea y
# el primer comando de la línea (curl, export…). Fuente única del patrón para ws-auditoria.
#
# Uso:
#   ws-historial              lista las líneas sospechosas (sale con 1 si hay alguna)
#   ws-historial --contar     imprime solo cuántas hay (para ws-auditoria)
#   ws-historial --limpiar    las borra tras confirmar. Sin respaldo a propósito: el respaldo guardaría
#                             los mismos secretos. Borrar NO sustituye rotar las credenciales.
set -euo pipefail

f="${WS_HISTFILE:-$HOME/.bash_history}"
# Mayúsculas y minúsculas (grep -i). Formatos con valor después de = o de un espacio.
PATRON='(ghp_|github_pat_|sk-ant-|xox[bp]-|AKIA[0-9A-Z]{16}|AccountKey=|SharedAccessSignature|client_secret=|(pass(word|wd)?|pwd|secret|token|api[_-]?key)=[^ &'"'"'"]{6,}|--(password|client-secret|secret|token)[= ]+[^ ]{6,}|Authorization: *Bearer +[A-Za-z0-9._-]{20,})'

[[ -f "$f" ]] || { [[ "${1:-}" == --contar ]] && echo 0 || echo "ok  no existe $f"; exit 0; }

# Números de línea sospechosos; si la anterior es una marca de tiempo (#1700000000) también se borra.
mapfile -t L < <(grep -niE -- "$PATRON" "$f" | cut -d: -f1 | sort -un)

case "${1:-}" in
  --contar) echo "${#L[@]}"; exit 0 ;;
  ""|--limpiar) ;;
  *) echo "Uso: ws-historial [--contar|--limpiar]" >&2; exit 2 ;;
esac

if (( ${#L[@]} == 0 )); then echo "ok  sin secretos aparentes en ${f/#"$HOME"/\~}"; exit 0; fi

echo "Posibles secretos en ${f/#"$HOME"/\~} (no se muestran valores):"
for n in "${L[@]}"; do printf '  línea %-6s %s …\n' "$n" "$(sed -n "${n}p" "$f" | awk '{print $1}')"; done

[[ "${1:-}" == --limpiar ]] || { echo "Rota esas credenciales y luego: ws-historial --limpiar"; exit 1; }

read -rp "¿Borrar estas ${#L[@]} líneas del historial? [s/N] " r
[[ "$r" =~ ^[sS]$ ]] || { echo "  No se borró nada."; exit 1; }
expr=""
for n in "${L[@]}"; do
  expr+="${n}d;"
  (( n > 1 )) && sed -n "$((n - 1))p" "$f" | grep -qE '^#[0-9]+$' && expr+="$((n - 1))d;"
done
sed -i "$expr" "$f"
chmod 600 "$f"
echo "  listo   ${#L[@]} líneas borradas; quedan $(ws_n=$(grep -ciE -- "$PATRON" "$f" || true); echo "${ws_n:-0}") sospechosas."
echo "  Importante: en cada terminal que siga abierta corre  history -c; history -r  (o ciérrala);"
echo "  si no, al salir puede volver a escribir esas líneas."
