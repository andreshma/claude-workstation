#!/usr/bin/env bash
#
# tmux-az-sub — switches the active Azure subscription (WSL-native az), picked with fzf,
# and refreshes the tmux status bar. Warns if the chosen one looks like production, because
# Claude's guard blocks mutations there. Used by the menu (z).
set -uo pipefail
TAB=$'\t'
command -v az >/dev/null || { echo "az is missing in WSL."; read -rsn1; exit 1; }
cur="$(az account show --query id -o tsv 2>/dev/null)"
list="$(az account list --query "[?state=='Enabled'].[name, id, tenantId]" -o tsv 2>/dev/null)"
if [[ -z "$list" ]]; then echo "No Azure session in WSL: run az login."; read -rsn1; exit 1; fi
sel="$(awk -F "$TAB" -v OFS="$TAB" -v c="$cur" '{ print ($2 == c ? "* " : "  ") $1, $2, $3 }' <<<"$list" |
  fzf --reverse --delimiter="$TAB" --with-nth=1 --prompt='subscription> ' --header='* = active')" || exit 0
name="$(cut -f1 <<<"$sel")"; name="${name:2}"
az account set --subscription "$(cut -f2 <<<"$sel")" || { read -rsn1; exit 1; }
tmux refresh-client -S 2>/dev/null
if grep -qiE 'prod|production|-pro$' <<<"$name"; then tmux display -d 5000 "Azure: $name  (PRODUCTION: the guard blocks changes by Claude)"
else tmux display -d 3000 "Azure: $name"; fi
