#!/usr/bin/env bash
#
# ws-gate — the workstation's quality and security gate. Invoked by the global git hooks
# (_chain) and by Claude Code; also used by hand to review a whole repo.
#
#   ws-gate pre-commit            secrets, forbidden or large files, lint of what you commit
#   ws-gate commit-msg <file>     Conventional Commits and no Co-authored-by; from a Claude Code session it adds
#                                 the Agent-Session (and Agent) trailers (ADR-020)
#   ws-gate pre-push <remote>     push to main/master, dependencies (osv-scanner), IaC (checkov),
#                                 tflint and clippy on what changed (stdin = git refs)
#   ws-gate file <file>           lint of a single file (Claude uses it after editing)
#   ws-gate repo [folder]         full report of the repo in Markdown (prints the path)
#   ws-gate repo-view [folder]    same, and opens it in less (used by the menu, Q)
#   ws-gate bypasses [folder]     repos under the folder (default $REPOS and ~/code) where the gate does not run in
#                                 full: a local core.hooksPath, ws.gate.skip or a ws.gate.allowNo* opt-out (ws-audit)
#
# Per-repo configuration (git config):
#   ws.gate.skip       comma-separated list: lint,size,osv,checkov,tflint,clippy,msg
#   ws.gate.allowMain  true to allow a direct push to main/master (e.g. personal repos)
#   ws.gate.strict     true so that checkov and tflint also block on pre-push
#   ws.gate.allowNoGitleaks  true to commit without gitleaks installed (each such commit is logged in
#                      ~/.local/state/ws-gate/opt-outs.log); without it, a missing gitleaks blocks the commit
#   ws.gate.allowNoOsv       the same for osv-scanner on a push that changes a lock file or manifest
#   ws.gate.allowNoCheckov   the same for checkov on a push that changes Terraform, Bicep, a Dockerfile, a
#                      Kubernetes manifest or a CI workflow
#   ws.gate.agentTrailer     false to leave out the Agent-Session trailer in this repository (logged)
# If the repo has a .pre-commit-config.yaml, its lint rules and only secrets and size are checked here.
# Throwaway repositories (under /tmp or /var/tmp AND without any remote) skip Conventional Commits and lint at commit
# time, saying so once; see throwaway() below (ADR-023).
# The secret scan is mandatory (ADR 0013): gitleaks missing = commit blocked. osv-scanner and checkov are mandatory
# only when the push has files they apply to (WS-SEC-004): missing = push blocked, unless the opt-out above. The other
# tools that are not installed are skipped with a warning. ws-tools install gate installs the three, pinned.
set -uo pipefail
MAX_MB=5
RED=$'\033[31m'; YEL=$'\033[33m'; DIM=$'\033[2m'; RST=$'\033[0m'
fail=0; warn=0
err()  { printf '%s✖ %s%s\n' "$RED" "$*" "$RST" >&2; fail=1; }
wrn()  { printf '%s! %s%s\n' "$YEL" "$*" "$RST" >&2; warn=1; }
note() { printf '%s· %s%s\n' "$DIM" "$*" "$RST" >&2; }
has()  { command -v "$1" >/dev/null 2>&1; }
skip() { [[ ",$(git config --get ws.gate.skip 2>/dev/null)," == *",$1,"* ]]; }
root() { git rev-parse --show-toplevel 2>/dev/null; }

#######################################
# Throwaway repositories (tests, scratch work): a repository whose working tree AND git directory both live under
# the system temp dir (/tmp, /var/tmp) and that has no remote at all. There, and only there, the commit-time quality
# checks that make no sense (Conventional Commits, lint) are skipped, with the reason printed once per repository.
# Secrets, forbidden files, size and the Co-authored-by rule still apply, and a push from a repository under the
# temp dir re-checks the message of every pushed commit. A repository with any remote, or outside the temp dir, is
# never a throwaway. WS_GATE_TEMP_ROOTS (colon-separated, for tests) can only narrow the roots: an entry that is not
# itself under /tmp or /var/tmp is ignored, so it cannot turn a real repository into a throwaway.
#######################################
temp_roots() {
  local r IFS=:
  for r in ${WS_GATE_TEMP_ROOTS:-/tmp:/var/tmp}; do
    r="$(realpath -m -- "$r" 2>/dev/null)" || continue
    case "$r/" in /tmp/*|/var/tmp/*) printf '%s\n' "$r" ;; esac
  done
}
# under_temp <path> — 0 if the path (resolved) is inside one of the temp roots.
under_temp() {
  local p t; p="$(realpath -e -- "$1" 2>/dev/null)" || return 1
  while IFS= read -r t; do [[ "$p/" == "$t"/* ]] && return 0; done < <(temp_roots)
  return 1
}
# in_temp — the working tree and the (common) git directory of this repository are both under the temp dir.
in_temp() {
  local top common
  top="$(root)" || return 1; common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  under_temp "$top" && under_temp "$common"
}
throwaway() {
  in_temp || return 1
  [[ -z "$(git remote 2>/dev/null)" ]] || return 1
  local mark; mark="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)/ws-gate-throwaway"
  if [[ ! -e "$mark" ]]; then
    note "throwaway repository (under the temp dir, no remote): Conventional Commits and lint are skipped here;"
    note "secrets, forbidden files, size and Co-authored-by still apply, and a push re-checks every message"
    : > "$mark" 2>/dev/null || true
  fi
  return 0
}

# msg_problem <first line> — prints why a commit subject breaks Conventional Commits (nothing when it is fine).
TYPES='feat|fix|chore|docs|refactor|test|ci|perf|style|build'
msg_problem() {
  case "$1" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) return 0 ;; esac
  grep -qE "^($TYPES)(\([a-z0-9._/-]+\))?!?: [^ ].*" <<<"$1" || printf 'message does not follow Conventional Commits: "%s"\n' "$1"
}

#######################################
# Agent attribution (ADR-020, WS-AI-026): a commit made from a Claude Code session gets the trailers
# «Agent-Session: <profile>/<session id>» and, when the tab runs under an agent identity, «Agent: <WS_AGENT>»; never
# Co-authored-by. Claude Code sets CLAUDE_CODE_CHILD_SESSION=1 (and CLAUDE_CODE_SESSION_ID) only in the commands it
# starts, so a commit from a plain shell carries nothing. A trailer already in the message is replaced, so the agent
# cannot write a false one. This is attribution, not a boundary: a process can unset the variables.
# ws.gate.agentTrailer=false turns it off in a repository (logged as an opt-out).
#######################################
agent_trailer() {
  local file="$1" sid prof agent
  [[ "${CLAUDE_CODE_CHILD_SESSION:-}" == 1 || -n "${CLAUDE_CODE_SESSION_ID:-}" ]] || return 0
  if [[ "$(git config --type=bool --get ws.gate.agentTrailer 2>/dev/null)" == false ]]; then
    opt_out agentTrailer "$(root)"; return 0
  fi
  sid="${CLAUDE_CODE_SESSION_ID:-unknown}"; [[ "$sid" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || sid=unknown
  prof="${WS_PROFILE:-}"
  if ! [[ "$prof" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]]; then
    case "${CLAUDE_CONFIG_DIR:-}" in
      ""|"$HOME/.claude"|"$HOME/.claude/") prof=work ;; "$HOME/.claude-personal"|"$HOME/.claude-personal/") prof=personal ;;
      "$HOME/.claude-profiles/"*) prof="${CLAUDE_CONFIG_DIR#"$HOME/.claude-profiles/"}"; prof="${prof%/}" ;;
      *) prof=other ;;
    esac
    [[ "$prof" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] || prof=other
  fi
  # git interpret-trailers matches keys by prefix («Agent» and «Agent-Session» collide under --if-exists replace),
  # so any existing Agent or Agent-Session line (a forged one included) is removed first and both are then added.
  local args=(--trailer "Agent-Session: $prof/$sid")
  agent="${WS_AGENT:-}"
  [[ "$agent" =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] && args+=(--trailer "Agent: $agent")
  sed -i -E '/^(agent-session|agent)[[:space:]]*:/Id' "$file" 2>/dev/null
  git interpret-trailers --in-place --if-exists add "${args[@]}" "$file" 2>/dev/null \
    || wrn "could not add the Agent-Session trailer"
}

# opt_out <what> <repo> — records a use of an opt-out of the gate (date, repo, what) for ws-audit and reviews.
opt_out() {
  local d="${XDG_STATE_HOME:-$HOME/.local/state}/ws-gate"
  mkdir -p "$d" 2>/dev/null && printf '%s\t%s\t%s\n' "$(date -Is)" "$2" "$1" >> "$d/opt-outs.log" 2>/dev/null || true
}

#######################################
# A scanner the push needs is not installed (WS-SEC-004): blocks, unless the repo opted out with ws.gate.<opt>,
# which warns and is logged like allowNoGitleaks. Arguments: tool, opt-out key, what was not checked, repo.
#######################################
missing_tool() {
  if [[ "$(git config --type=bool --get "ws.gate.$2" 2>/dev/null)" == true ]]; then
    wrn "no $1: $3 were NOT checked (ws.gate.$2 is set; logged)"
    opt_out "$2" "$4"
  else
    err "$1 is missing, so $3 cannot be checked: ws-tools install $1 (or ws-tools install gate)"
    note "only if you must push without it in this repo: git config ws.gate.$2 true (logged)"
  fi
}

# applies_iac <file> — a file checkov must see: Terraform, Bicep, a Dockerfile, a CI workflow or a Kubernetes manifest.
applies_iac() {
  case "$1" in
    *.tf|*.bicep|*Dockerfile*|*.dockerfile|*Containerfile*|.github/workflows/*.yml|.github/workflows/*.yaml) return 0 ;;
    .gitlab-ci.yml|azure-pipelines.yml|azure-pipelines.yaml) return 0 ;;
    *.yml|*.yaml) [[ -f "$2" ]] && grep -qE '^apiVersion:' "$2" 2>/dev/null && grep -qE '^kind:' "$2" 2>/dev/null ;;
    *) return 1 ;;
  esac
}

#######################################
# Lists the repositories under the given folders where the gate does not run in full: a repository-local
# core.hooksPath (it replaces the global dispatcher), ws.gate.skip or a scanner opt-out (ws.gate.allowNoGitleaks,
# allowNoOsv, allowNoCheckov).
# Arguments: folders (default: $REPOS and ~/code). Outputs: "repo<TAB>finding" lines. Returns: 1 if any.
#######################################
bypasses() {
  local d g r hp o found=0 global; global="$(git config --global --get core.hooksPath 2>/dev/null)"
  (( $# )) || set -- ${REPOS:+"$REPOS"} "$HOME/code"
  for d in "$@"; do
    [[ -d "$d" ]] || continue
    while IFS= read -r g; do
      r="${g%/.git}"
      hp="$(git -C "$r" config --local --get core.hooksPath 2>/dev/null)"
      if [[ -n "$hp" && "$hp" != "$global" ]]; then
        printf '%s\tlocal core.hooksPath=%s (the global gate does not run)\n' "$r" "$hp"; found=1
      fi
      hp="$(git -C "$r" config --get ws.gate.skip 2>/dev/null)"
      [[ -n "$hp" ]] && { printf '%s\tws.gate.skip=%s\n' "$r" "$hp"; found=1; }
      for o in allowNoGitleaks allowNoOsv allowNoCheckov; do
        [[ "$(git -C "$r" config --type=bool --get "ws.gate.$o" 2>/dev/null)" == true ]] \
          && { printf '%s\tws.gate.%s=true\n' "$r" "$o"; found=1; }
      done
    done < <(find "$d" -maxdepth 3 -name .git \( -type d -o -type f \) 2>/dev/null | sort)
  done
  return "$found"
}

# lint_file <file> — checks a file according to its type; prints the findings and returns 1 if there are any.
lint_file() {
  local f="$1" r out rc=0 base; r="$(root)"; base="${f##*/}"
  [[ -f "$f" ]] || return 0
  run() { if ! out="$("$@" 2>&1)"; then printf '%s\n' "$out" | head -40; rc=1; fi; }
  case "$f" in
    *.sh|*.bash) has shellcheck && run shellcheck -S warning "$f" ;;
    *.py)        has ruff && { run ruff check --quiet "$f"; run ruff format --check --quiet "$f"; } ;;
    *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.vue)
      [[ -n "${WS_GATE_NO_REPO_CODE:-}" ]] && return 0   # from the edit hook: nothing that runs code from the repo
      [[ -x "$r/node_modules/.bin/eslint" ]] && run "$r/node_modules/.bin/eslint" --no-warn-ignored "$f"
      [[ -x "$r/node_modules/.bin/prettier" ]] && run "$r/node_modules/.bin/prettier" --check --log-level warn "$f" ;;
    *.css|*.scss|*.html)
      [[ -n "${WS_GATE_NO_REPO_CODE:-}" ]] && return 0
      [[ -x "$r/node_modules/.bin/prettier" ]] && run "$r/node_modules/.bin/prettier" --check --log-level warn "$f" ;;
    *.rs)        has rustfmt && run rustfmt --check --edition 2021 "$f" ;;
    *.tf)        has terraform && run terraform fmt -check -diff "$f" ;;
    *.json)      run jq empty "$f" ;;
    *.yml|*.yaml) has yamllint && run yamllint -d relaxed --no-warnings "$f" ;;
  esac
  case "$base" in
    Dockerfile|Dockerfile.*|*.dockerfile|Containerfile)
      if has hadolint; then run hadolint --failure-threshold warning "$f"; fi ;;
  esac
  return "$rc"
}

pre_commit() {
  local f r own_cfg=0 size; r="$(root)" || return 0
  mapfile -d '' files < <(git diff --cached --name-only --diff-filter=ACMR -z)
  (( ${#files[@]} )) || return 0
  [[ -f "$r/.pre-commit-config.yaml" ]] && own_cfg=1

  if has gitleaks; then
    gitleaks protect --staged --redact --no-banner >/dev/null 2>&1 || {
      err "gitleaks found possible secrets. Details: gitleaks protect --staged --redact -v"; }
  elif [[ "$(git config --type=bool --get ws.gate.allowNoGitleaks 2>/dev/null)" == true ]]; then
    wrn "no gitleaks: secrets were NOT checked (ws.gate.allowNoGitleaks is set; logged)"
    opt_out "allowNoGitleaks" "$r"
  else
    err "gitleaks is missing, so secrets cannot be checked: ws-tools install base"
    note "only if you must commit without it in this repo: git config ws.gate.allowNoGitleaks true (logged)"
  fi

  for f in "${files[@]}"; do
    case "${f##*/}" in
      .env|.env.local|.env.*.local|.env.production|*.pem|*.key|*.pfx|*.p12|id_rsa*|id_ed25519*|*.kdbx|*.tfstate|*.tfstate.backup)
        err "file that must not be versioned: $f (use the vault or .gitignore)" ;;
    esac
    if ! skip size && [[ -f "$r/$f" ]]; then
      size=$(stat -c %s "$r/$f")
      if (( size > MAX_MB * 1024 * 1024 )) && [[ "$(git check-attr filter -- "$f" | awk '{print $NF}')" != lfs ]]; then
        err "$f is $(( size / 1024 / 1024 )) MB (maximum $MAX_MB MB; use Git LFS or an artifact store)"
      fi
    fi
  done

  if (( own_cfg )); then note "the repo has a .pre-commit-config.yaml: its lint rules"
  elif ! skip lint && ! throwaway; then
    for f in "${files[@]}"; do
      if ! lint_file "$r/$f" >&2; then err "lint: $f"; fi
    done
  fi
}

commit_msg() {
  local file="${1:?message file}" first why
  first="$(grep -v '^#' "$file" | grep -m1 .)"
  if grep -qiE '^co-authored-by:' "$file"; then err "the message has Co-authored-by (not allowed)"; fi
  if ! skip msg && ! throwaway; then
    why="$(msg_problem "$first")"
    if [[ -n "$why" ]]; then
      err "$why"; note "format: type(scope): description in the imperative · types: ${TYPES//|/ }"
    elif (( ${#first} > 100 )); then wrn "first line is ${#first} characters long (recommended ≤ 100)"; fi
  fi
  (( fail )) || agent_trailer "$file"
}

# push_msgs <range…> — in a repository under the temp dir (where commit-msg may have skipped the format check),
# every pushed commit must follow Conventional Commits and carry no Co-authored-by.
push_msgs() {
  local c why
  in_temp || return 0
  while IFS= read -r c; do
    if git log -1 --format=%B "$c" | grep -qiE '^co-authored-by:'; then err "commit ${c:0:9} has Co-authored-by (not allowed)"; fi
    skip msg && continue
    why="$(msg_problem "$(git log -1 --format=%s "$c")")"
    [[ -n "$why" ]] && err "commit ${c:0:9}: $why (repository under the temp dir: every pushed message is checked)"
  done < <(git rev-list --no-merges "$@" 2>/dev/null)
}

pre_push() {
  local lsha rref rsha zero=0000000000000000000000000000000000000000 range changed=() r
  r="$(root)" || return 0
  while read -r _ lsha rref rsha; do
    [[ "$lsha" == "$zero" ]] && continue
    if [[ "$rref" =~ ^refs/heads/(main|master)$ && "$(git config --get ws.gate.allowMain)" != true ]]; then
      err "direct push to ${rref#refs/heads/}: use a branch and a PR (or git config ws.gate.allowMain true in personal repos)"
    fi
    if [[ "$rsha" == "$zero" ]]; then
      range="$(git merge-base "$lsha" origin/HEAD 2>/dev/null || git rev-list --max-parents=0 "$lsha" | tail -1)..$lsha"
      push_msgs "$lsha" --not --remotes
    else range="$rsha..$lsha"; push_msgs "$range"; fi
    mapfile -t -O "${#changed[@]}" changed < <(git diff --name-only "$range" 2>/dev/null)
  done
  (( ${#changed[@]} )) || return 0
  local strict; strict="$(git config --get ws.gate.strict)"

  local locks=() f
  for f in "${changed[@]}"; do
    case "${f##*/}" in package-lock.json|pnpm-lock.yaml|yarn.lock|bun.lock|requirements*.txt|poetry.lock|uv.lock|Pipfile.lock|pdm.lock|Cargo.lock|packages.lock.json|go.sum|go.mod|composer.lock|Gemfile.lock|pom.xml|gradle.lockfile|pubspec.lock|mix.lock)
      [[ -f "$r/$f" ]] && locks+=(-L "$r/$f") ;; esac
  done
  if (( ${#locks[@]} )) && ! skip osv; then
    if has osv-scanner; then
      local js max
      js="$(osv-scanner scan source --format json "${locks[@]}" 2>/dev/null)"
      max="$(jq -r '[.results[]?.packages[]?.groups[]?.max_severity | tonumber? ] | max // 0' <<<"$js" 2>/dev/null)"
      local n; n="$(jq -r '[.results[]?.packages[]?.vulnerabilities[]?] | length' <<<"$js" 2>/dev/null)"
      if awk -v m="${max:-0}" 'BEGIN { exit !(m >= 9.0) }'; then err "osv-scanner: $n vulnerabilities, at least one CRITICAL (CVSS ${max})"
      elif (( ${n:-0} > 0 )); then wrn "osv-scanner: $n vulnerabilities (max CVSS ${max}); review them before the PR"; fi
    else missing_tool osv-scanner allowNoOsv "the dependencies of this push" "$r"; fi
  fi

  # iac: what checkov scans (every YAML too, as before); needs: whether the push has a file checkov applies to.
  local iac=() dirs=() needs=0
  for f in "${changed[@]}"; do
    case "$f" in
      *.tf|*.bicep|*Dockerfile*|*.dockerfile|*Containerfile*|*.yaml|*.yml) [[ -f "$r/$f" ]] && iac+=("$r/$f") ;;
    esac
    applies_iac "$f" "$r/$f" && needs=1
  done
  if (( ${#iac[@]} )) && ! skip checkov; then
    if has checkov; then
      local out cargs=(); for f in "${iac[@]}"; do cargs+=(-f "$f"); done
      out="$(checkov --compact --quiet --skip-download "${cargs[@]}" 2>/dev/null)"
      if grep -q 'FAILED' <<<"$out"; then
        printf '%s\n' "$out" | grep -E 'Check:|FAILED|File:' | head -30 >&2
        if [[ "$strict" == true ]]; then err "checkov: findings in IaC"; else wrn "checkov: findings in IaC"; fi
      fi
    elif (( needs )); then missing_tool checkov allowNoCheckov "the IaC, container and workflow files of this push" "$r"
    else note "no checkov: the YAML files were not checked"; fi
  fi

  mapfile -t dirs < <(for f in "${changed[@]}"; do [[ "$f" == *.tf ]] && dirname "$r/$f"; done | sort -u)
  if (( ${#dirs[@]} )) && ! skip tflint && has tflint; then
    for d in "${dirs[@]}"; do
      tflint --chdir "$d" --format compact >/tmp/ws-gate-tflint.$$ 2>&1 || {
        head -20 /tmp/ws-gate-tflint.$$ >&2
        if [[ "$strict" == true ]]; then err "tflint: $d"; else wrn "tflint: $d"; fi; }
    done; rm -f /tmp/ws-gate-tflint.$$
  fi

  if printf '%s\n' "${changed[@]}" | grep -qE '(\.rs|Cargo\.toml)$' && ! skip clippy && has cargo && [[ -f "$r/Cargo.toml" ]]; then
    ( cd "$r" && cargo clippy --quiet -- -D warnings >/tmp/ws-gate-clippy.$$ 2>&1 ) || {
      head -30 /tmp/ws-gate-clippy.$$ >&2; wrn "clippy: findings in Rust"; }
    rm -f /tmp/ws-gate-clippy.$$
  fi
}

repo_report() {
  local r="${1:-$PWD}" out ts name f
  r="$(git -C "$r" rev-parse --show-toplevel 2>/dev/null)" || { echo "Not a git repo: ${1:-$PWD}"; return 1; }
  name="${r##*/}"; ts="$(date +%Y%m%d-%H%M)"; mkdir -p "$HOME/quality-reports"
  out="$HOME/quality-reports/$name-$ts.md"
  {
    printf '# Quality and security review — %s\n\n%s · branch `%s` · commit `%s`\n\n' "$name" "$(date '+%F %H:%M')" \
      "$(git -C "$r" branch --show-current)" "$(git -C "$r" rev-parse --short HEAD)"
    printf '## Secrets (full history)\n\n```\n'
    if has gitleaks; then gitleaks detect --source "$r" --redact --no-banner 2>&1 | tail -5; else echo "no gitleaks"; fi
    printf '```\n\n## Lint per file\n\n'
    local n=0 bad=0
    while IFS= read -r -d '' f; do
      n=$((n + 1)); if ! res="$(lint_file "$r/$f" 2>&1)"; then bad=$((bad + 1)); printf '### %s\n\n```\n%s\n```\n\n' "$f" "$(head -15 <<<"$res")"; fi
    done < <(git -C "$r" ls-files -z)
    printf '%d files checked, %d with findings.\n\n## Dependencies (osv-scanner)\n\n```\n' "$n" "$bad"
    if has osv-scanner; then osv-scanner scan source -r "$r" 2>&1 | tail -40; else echo "no osv-scanner"; fi
    printf '```\n\n## IaC and containers (checkov)\n\n```\n'
    if has checkov; then checkov -d "$r" --compact --quiet --skip-download 2>&1 | tail -60; else echo "no checkov"; fi
    printf '```\n\n## Container images\n\nReview the built images with `docker scout cves <image>`.\n'
  } > "$out"
  printf '%s\n' "$out"
}

case "${1:-}" in
  pre-commit) pre_commit ;;
  commit-msg) commit_msg "${2:-}" ;;
  pre-push)   pre_push ;;
  file)       lint_file "${2:?file}"; exit $? ;;
  repo)       repo_report "${2:-}"; exit $? ;;
  bypasses)   shift; bypasses "$@"; exit $? ;;
  repo-view)  echo "Reviewing $(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")…"
              f="$(repo_report "${2:-}")" || { read -rsn1; exit 1; }; less -R "$f"; exit 0 ;;
  *) sed -n '3,/^set -uo/p' "$0" | sed '$d'; exit 2 ;;
esac
if (( fail )); then printf '%sGate: blocked. Fix what is marked with ✖ (or git config ws.gate.skip …).%s\n' "$RED" "$RST" >&2; exit 1; fi
(( warn )) && printf '%sGate: passes with warnings.%s\n' "$YEL" "$RST" >&2
exit 0
