#!/usr/bin/env bash
#
# ws-gate — compuerta de calidad y seguridad de la estación. La invocan los hooks globales
# de git (_chain) y Claude Code; también se usa a mano para revisar un repo completo.
#
#   ws-gate pre-commit            secretos, archivos prohibidos o grandes, lint de lo que subes
#   ws-gate commit-msg <archivo>  Conventional Commits y sin Co-authored-by
#   ws-gate pre-push <remoto>     push a main/master, dependencias (osv-scanner), IaC (checkov),
#                                 tflint y clippy sobre lo que cambió (stdin = refs de git)
#   ws-gate file <archivo>        lint de un solo archivo (lo usa Claude tras editar)
#   ws-gate repo [carpeta]        reporte completo del repo en Markdown (imprime la ruta)
#   ws-gate repo-view [carpeta]   igual, y lo abre en less (lo usa el menú, Q)
#
# Configuración por repo (git config):
#   ws.gate.skip       lista separada por comas: lint,size,osv,checkov,tflint,clippy,msg
#   ws.gate.allowMain  true para permitir push directo a main/master (p. ej. repos personales)
#   ws.gate.strict     true para que checkov y tflint también bloqueen en pre-push
# Si el repo trae .pre-commit-config.yaml, su lint manda y aquí solo se revisan secretos y tamaño.
# Las herramientas que no estén instaladas se omiten con aviso (ws-tools las instala).
set -uo pipefail
MAX_MB=5
RED=$'\033[31m'; YEL=$'\033[33m'; DIM=$'\033[2m'; RST=$'\033[0m'
fail=0; warn=0
err()  { printf '%s✖ %s%s\n' "$RED" "$*" "$RST" >&2; fail=1; }
wrn()  { printf '%s! %s%s\n' "$YEL" "$*" "$RST" >&2; warn=1; }
note() { printf '%s· %s%s\n' "$DIM" "$*" "$RST" >&2; }
has()  { command -v "$1" >/dev/null 2>&1; }
skip() { [[ ",$(git config --get ws.gate.skip 2>/dev/null)," == *",$1,"* ]]; }
root() { git rev-parse --show-toplevel 2>/dev/null; }

# lint_file <archivo> — revisa un archivo según su tipo; imprime los hallazgos y devuelve 1 si hay.
lint_file() {
  local f="$1" r out rc=0 base; r="$(root)"; base="${f##*/}"
  [[ -f "$f" ]] || return 0
  run() { if ! out="$("$@" 2>&1)"; then printf '%s\n' "$out" | head -40; rc=1; fi; }
  case "$f" in
    *.sh|*.bash) has shellcheck && run shellcheck -S warning "$f" ;;
    *.py)        has ruff && { run ruff check --quiet "$f"; run ruff format --check --quiet "$f"; } ;;
    *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.vue)
      [[ -n "${WS_GATE_SIN_CODIGO_REPO:-}" ]] && return 0   # desde el hook de edición: nada que ejecute código del repo
      [[ -x "$r/node_modules/.bin/eslint" ]] && run "$r/node_modules/.bin/eslint" --no-warn-ignored "$f"
      [[ -x "$r/node_modules/.bin/prettier" ]] && run "$r/node_modules/.bin/prettier" --check --log-level warn "$f" ;;
    *.css|*.scss|*.html)
      [[ -n "${WS_GATE_SIN_CODIGO_REPO:-}" ]] && return 0
      [[ -x "$r/node_modules/.bin/prettier" ]] && run "$r/node_modules/.bin/prettier" --check --log-level warn "$f" ;;
    *.rs)        has rustfmt && run rustfmt --check --edition 2021 "$f" ;;
    *.tf)        has terraform && run terraform fmt -check -diff "$f" ;;
    *.json)      run jq empty "$f" ;;
    *.yml|*.yaml) has yamllint && run yamllint -d relaxed --no-warnings "$f" ;;
  esac
  case "$base" in
    Dockerfile|Dockerfile.*|*.dockerfile|Containerfile)
      if has hadolint; then run hadolint --failure-threshold warning "$f"; fi ;;
  esac
  return "$rc"
}

pre_commit() {
  local f r own_cfg=0 size; r="$(root)" || return 0
  mapfile -d '' files < <(git diff --cached --name-only --diff-filter=ACMR -z)
  (( ${#files[@]} )) || return 0
  [[ -f "$r/.pre-commit-config.yaml" ]] && own_cfg=1

  if has gitleaks; then
    gitleaks protect --staged --redact --no-banner >/dev/null 2>&1 || {
      err "gitleaks encontró posibles secretos. Detalle: gitleaks protect --staged --redact -v"; }
  else wrn "sin gitleaks: no se revisaron secretos"; fi

  for f in "${files[@]}"; do
    case "${f##*/}" in
      .env|.env.local|.env.*.local|.env.production|*.pem|*.key|*.pfx|*.p12|id_rsa*|id_ed25519*|*.kdbx|*.tfstate|*.tfstate.backup)
        err "archivo que no debe versionarse: $f (usa el vault o .gitignore)" ;;
    esac
    if ! skip size && [[ -f "$r/$f" ]]; then
      size=$(stat -c %s "$r/$f")
      if (( size > MAX_MB * 1024 * 1024 )) && [[ "$(git check-attr filter -- "$f" | awk '{print $NF}')" != lfs ]]; then
        err "$f pesa $(( size / 1024 / 1024 )) MB (máximo $MAX_MB MB; usa Git LFS o un almacenamiento de artefactos)"
      fi
    fi
  done

  if (( own_cfg )); then note "el repo tiene .pre-commit-config.yaml: su lint manda"
  elif ! skip lint; then
    for f in "${files[@]}"; do
      if ! lint_file "$r/$f" >&2; then err "lint: $f"; fi
    done
  fi
}

commit_msg() {
  local file="${1:?archivo del mensaje}" first types='feat|fix|chore|docs|refactor|test|ci|perf|style|build'
  first="$(grep -v '^#' "$file" | grep -m1 .)"
  if grep -qiE '^co-authored-by:' "$file"; then err "el mensaje tiene Co-authored-by (no permitido)"; fi
  skip msg && return 0
  case "$first" in Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) return 0 ;; esac
  if ! grep -qE "^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*" <<<"$first"; then
    err "mensaje fuera de Conventional Commits: \"$first\""
    note "formato: type(scope): descripción en imperativo · tipos: ${types//|/ }"
  elif (( ${#first} > 100 )); then wrn "primera línea de ${#first} caracteres (recomendado ≤ 100)"; fi
}

pre_push() {
  local lsha rref rsha zero=0000000000000000000000000000000000000000 range changed=() r
  r="$(root)" || return 0
  while read -r _ lsha rref rsha; do
    [[ "$lsha" == "$zero" ]] && continue
    if [[ "$rref" =~ ^refs/heads/(main|master)$ && "$(git config --get ws.gate.allowMain)" != true ]]; then
      err "push directo a ${rref#refs/heads/}: usa una rama y PR (o git config ws.gate.allowMain true en repos personales)"
    fi
    if [[ "$rsha" == "$zero" ]]; then
      range="$(git merge-base "$lsha" origin/HEAD 2>/dev/null || git rev-list --max-parents=0 "$lsha" | tail -1)..$lsha"
    else range="$rsha..$lsha"; fi
    mapfile -t -O "${#changed[@]}" changed < <(git diff --name-only "$range" 2>/dev/null)
  done
  (( ${#changed[@]} )) || return 0
  local strict; strict="$(git config --get ws.gate.strict)"

  local locks=() f
  for f in "${changed[@]}"; do
    case "${f##*/}" in package-lock.json|pnpm-lock.yaml|yarn.lock|requirements*.txt|poetry.lock|uv.lock|Pipfile.lock|Cargo.lock|packages.lock.json|go.sum|composer.lock|Gemfile.lock)
      [[ -f "$r/$f" ]] && locks+=(-L "$r/$f") ;; esac
  done
  if (( ${#locks[@]} )) && ! skip osv; then
    if has osv-scanner; then
      local js max
      js="$(osv-scanner scan source --format json "${locks[@]}" 2>/dev/null)"
      max="$(jq -r '[.results[]?.packages[]?.groups[]?.max_severity | tonumber? ] | max // 0' <<<"$js" 2>/dev/null)"
      local n; n="$(jq -r '[.results[]?.packages[]?.vulnerabilities[]?] | length' <<<"$js" 2>/dev/null)"
      if awk -v m="${max:-0}" 'BEGIN { exit !(m >= 9.0) }'; then err "osv-scanner: $n vulnerabilidades, al menos una CRÍTICA (CVSS ${max})"
      elif (( ${n:-0} > 0 )); then wrn "osv-scanner: $n vulnerabilidades (máx. CVSS ${max}); revísalas antes del PR"; fi
    else wrn "sin osv-scanner: no se revisaron dependencias"; fi
  fi

  local iac=() dirs=()
  for f in "${changed[@]}"; do
    case "$f" in *.tf|*.bicep|*Dockerfile*|*.dockerfile|*.yaml|*.yml) [[ -f "$r/$f" ]] && iac+=("$r/$f") ;; esac
  done
  if (( ${#iac[@]} )) && ! skip checkov; then
    if has checkov; then
      local out cargs=(); for f in "${iac[@]}"; do cargs+=(-f "$f"); done
      out="$(checkov --compact --quiet --skip-download "${cargs[@]}" 2>/dev/null)"
      if grep -q 'FAILED' <<<"$out"; then
        printf '%s\n' "$out" | grep -E 'Check:|FAILED|File:' | head -30 >&2
        if [[ "$strict" == true ]]; then err "checkov: hallazgos en IaC"; else wrn "checkov: hallazgos en IaC"; fi
      fi
    else note "sin checkov: no se revisó IaC"; fi
  fi

  mapfile -t dirs < <(for f in "${changed[@]}"; do [[ "$f" == *.tf ]] && dirname "$r/$f"; done | sort -u)
  if (( ${#dirs[@]} )) && ! skip tflint && has tflint; then
    for d in "${dirs[@]}"; do
      tflint --chdir "$d" --format compact >/tmp/ws-gate-tflint.$$ 2>&1 || {
        head -20 /tmp/ws-gate-tflint.$$ >&2
        if [[ "$strict" == true ]]; then err "tflint: $d"; else wrn "tflint: $d"; fi; }
    done; rm -f /tmp/ws-gate-tflint.$$
  fi

  if printf '%s\n' "${changed[@]}" | grep -qE '(\.rs|Cargo\.toml)$' && ! skip clippy && has cargo && [[ -f "$r/Cargo.toml" ]]; then
    ( cd "$r" && cargo clippy --quiet -- -D warnings >/tmp/ws-gate-clippy.$$ 2>&1 ) || {
      head -30 /tmp/ws-gate-clippy.$$ >&2; wrn "clippy: hallazgos en Rust"; }
    rm -f /tmp/ws-gate-clippy.$$
  fi
}

repo_report() {
  local r="${1:-$PWD}" out ts name f
  r="$(git -C "$r" rev-parse --show-toplevel 2>/dev/null)" || { echo "No es un repo git: ${1:-$PWD}"; return 1; }
  name="${r##*/}"; ts="$(date +%Y%m%d-%H%M)"; mkdir -p "$HOME/reportes-calidad"
  out="$HOME/reportes-calidad/$name-$ts.md"
  {
    printf '# Revisión de calidad y seguridad — %s\n\n%s · rama `%s` · commit `%s`\n\n' "$name" "$(date '+%F %H:%M')" \
      "$(git -C "$r" branch --show-current)" "$(git -C "$r" rev-parse --short HEAD)"
    printf '## Secretos (historial completo)\n\n```\n'
    if has gitleaks; then gitleaks detect --source "$r" --redact --no-banner 2>&1 | tail -5; else echo "sin gitleaks"; fi
    printf '```\n\n## Lint por archivo\n\n'
    local n=0 bad=0
    while IFS= read -r -d '' f; do
      n=$((n + 1)); if ! res="$(lint_file "$r/$f" 2>&1)"; then bad=$((bad + 1)); printf '### %s\n\n```\n%s\n```\n\n' "$f" "$(head -15 <<<"$res")"; fi
    done < <(git -C "$r" ls-files -z)
    printf '%d archivos revisados, %d con hallazgos.\n\n## Dependencias (osv-scanner)\n\n```\n' "$n" "$bad"
    if has osv-scanner; then osv-scanner scan source -r "$r" 2>&1 | tail -40; else echo "sin osv-scanner"; fi
    printf '```\n\n## IaC y contenedores (checkov)\n\n```\n'
    if has checkov; then checkov -d "$r" --compact --quiet --skip-download 2>&1 | tail -60; else echo "sin checkov"; fi
    printf '```\n\n## Imágenes de contenedor\n\nRevisa las imágenes construidas con `docker scout cves <imagen>`.\n'
  } > "$out"
  printf '%s\n' "$out"
}

case "${1:-}" in
  pre-commit) pre_commit ;;
  commit-msg) commit_msg "${2:-}" ;;
  pre-push)   pre_push ;;
  file)       lint_file "${2:?archivo}"; exit $? ;;
  repo)       repo_report "${2:-}"; exit $? ;;
  repo-view)  echo "Revisando $(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")…"
              f="$(repo_report "${2:-}")" || { read -rsn1; exit 1; }; less -R "$f"; exit 0 ;;
  *) sed -n '3,22p' "$0"; exit 2 ;;
esac
if (( fail )); then printf '%sCompuerta: bloqueado. Corrige lo marcado con ✖ (o git config ws.gate.skip …).%s\n' "$RED" "$RST" >&2; exit 1; fi
(( warn )) && printf '%sCompuerta: pasa con avisos.%s\n' "$YEL" "$RST" >&2
exit 0
