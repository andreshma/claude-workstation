#!/usr/bin/env bash
#
# tmux-difundir — sends the same text to several tabs with Claude at once (/compact to all, the same question
# in three repos…). Menu → Claude → D, or the command palette (Ctrl+b Space).
#   1. Pick the tabs (Tab marks, Ctrl+A all)  2. Type the text or pick a frequent one
#   3. Confirm: it is pasted into each Claude and, if you say yes, sent with Enter.
# Never offers commands that erase context or conversation (/clear, /reset). Usage: tmux-difundir
set -uo pipefail
TAB=$'\t'
# Pane with Claude in each tab marked by the hooks (@cs = Claude state).
mapfile -t filas < <(tmux list-panes -a -F "#{pane_id}${TAB}#{@cs}${TAB}#{pane_current_command}${TAB}#{session_name}:#{window_index} #{window_name}${TAB}#{?#{@cctx},ctx #{@cctx}%,}" \
  | awk -F"$TAB" '$2 != "" && $3 ~ /^(claude|node|[0-9]+\.[0-9]+\.[0-9]+)$/')
(( ${#filas[@]} )) || { echo "There are no tabs with Claude."; sleep 1.5; exit 0; }
sel="$(printf '%s\n' "${filas[@]}" | fzf --multi --delimiter="$TAB" --with-nth=4,2,5 --reverse --bind ctrl-a:select-all \
        --prompt 'tabs> ' --header 'Tab marks · Ctrl+A all · Enter continues')" || exit 0
mapfile -t paneles < <(cut -f1 <<<"$sel")
texto="$(printf '%s\n' "/compact" "/context" "/cost" "Where did you leave off? Summarize in 3 lines." "(type another…)" \
         | fzf --reverse --prompt 'text> ' --header "For ${#paneles[@]} tabs · pick or type" --print-query | tail -1)" || exit 0
if [[ "$texto" == "(type another…)" || -z "$texto" ]]; then read -e -r -p 'Text: ' texto || exit 0; fi
[[ -n "${texto// /}" ]] || exit 0
if grep -qiE '^/(clear|reset|logout|exit)\b' <<<"$texto"; then echo "✖ That command is not broadcast (it erases context or closes Claude)."; sleep 2; exit 1; fi
read -r -p "Send «${texto:0:60}» with Enter to ${#paneles[@]} tabs? [y=send · p=paste only · N] " r
[[ "$r" =~ ^[yYsSpP]$ ]] || exit 0
f="$(mktemp)"; printf '%s' "$texto" > "$f"
for p in "${paneles[@]}"; do
  tmux load-buffer -b ws-difundir "$f" && tmux paste-buffer -p -b ws-difundir -t "$p"
  [[ "$r" =~ ^[yYsS]$ ]] && { sleep 0.2; tmux send-keys -t "$p" Enter; }
done
tmux delete-buffer -b ws-difundir 2>/dev/null; rm -f "$f"
tmux display -d 2500 "Sent to ${#paneles[@]} tabs"
