#!/usr/bin/env bash
#
# tmux-difundir — manda el mismo texto a varias pestañas con Claude a la vez (/compact a todas, la misma pregunta
# en tres repos…). Menú → Claude → D, o la paleta (Ctrl+b Espacio).
#   1. Eliges las pestañas (Tab marca, Ctrl+A todas)  2. Escribes el texto o eliges uno frecuente
#   3. Confirmas: se pega en cada Claude y, si dices que sí, se envía con Enter.
# Nunca ofrece comandos que borran contexto o conversación (/clear, /reset). Uso: tmux-difundir
set -uo pipefail
TAB=$'\t'
# Panel con Claude en cada pestaña marcada por los hooks (@cs = estado de Claude).
mapfile -t filas < <(tmux list-panes -a -F "#{pane_id}${TAB}#{@cs}${TAB}#{pane_current_command}${TAB}#{session_name}:#{window_index} #{window_name}${TAB}#{?#{@cctx},ctx #{@cctx}%,}" \
  | awk -F"$TAB" '$2 != "" && $3 ~ /^(claude|node|[0-9]+\.[0-9]+\.[0-9]+)$/')
(( ${#filas[@]} )) || { echo "No hay pestañas con Claude."; sleep 1.5; exit 0; }
sel="$(printf '%s\n' "${filas[@]}" | fzf --multi --delimiter="$TAB" --with-nth=4,2,5 --reverse --bind ctrl-a:select-all \
        --prompt 'pestañas> ' --header 'Tab marca · Ctrl+A todas · Enter sigue')" || exit 0
mapfile -t paneles < <(cut -f1 <<<"$sel")
texto="$(printf '%s\n' "/compact" "/context" "/cost" "¿En qué te quedaste? Resume en 3 líneas." "(escribir otro…)" \
         | fzf --reverse --prompt 'texto> ' --header "Para ${#paneles[@]} pestañas · elige o escribe" --print-query | tail -1)" || exit 0
if [[ "$texto" == "(escribir otro…)" || -z "$texto" ]]; then read -e -r -p 'Texto: ' texto || exit 0; fi
[[ -n "${texto// /}" ]] || exit 0
if grep -qiE '^/(clear|reset|logout|exit)\b' <<<"$texto"; then echo "✖ Ese comando no se difunde (borra contexto o cierra Claude)."; sleep 2; exit 1; fi
read -r -p "¿Enviar «${texto:0:60}» con Enter en ${#paneles[@]} pestañas? [s=enviar · p=solo pegar · N] " r
[[ "$r" =~ ^[sSpP]$ ]] || exit 0
f="$(mktemp)"; printf '%s' "$texto" > "$f"
for p in "${paneles[@]}"; do
  tmux load-buffer -b ws-difundir "$f" && tmux paste-buffer -p -b ws-difundir -t "$p"
  [[ "$r" =~ ^[sS]$ ]] && { sleep 0.2; tmux send-keys -t "$p" Enter; }
done
tmux delete-buffer -b ws-difundir 2>/dev/null; rm -f "$f"
tmux display -d 2500 "Enviado a ${#paneles[@]} pestañas"
