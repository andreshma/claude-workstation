#!/usr/bin/env bash
#
# tmux-theme — dark, light or automatic (follows Windows) theme for the workstation:
# tmux colors (status bar, tabs, menus, popups), Windows Terminal background and text
# (OSC 10/11/12 sequences to each client) and recoloring of the Claude states.
#
# Usage: tmux-theme oscuro|claro|auto   saves the choice and applies it
#        tmux-theme apply               applies what is saved (when tmux starts and on attach)
#        tmux-theme check               auto mode only: reapplies if Windows changed
# Preferences in ~/.config/tmux-claude/apariencia (tema=, protector=, escena=, minutos=).
set -uo pipefail
dir="$HOME/.config/tmux-claude"; cfg="$dir/apariencia"
get() { sed -n "s/^$1=//p" "$cfg" 2>/dev/null | tail -1; }
put() { touch "$cfg"; if grep -q "^$1=" "$cfg"; then sed -i "s/^$1=.*/$1=$2/" "$cfg"; else echo "$1=$2" >> "$cfg"; fi; }

# windows_theme — "claro" or "oscuro" from the Windows app mode (oscuro if it cannot be read).
windows_theme() {
  local v; v="$(reg.exe query 'HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize' /v AppsUseLightTheme 2>/dev/null | tr -d '\r' | awk '/AppsUseLightTheme/ { print $NF }')"
  [[ "$v" == 0x1 ]] && echo claro || echo oscuro
}

# osc <theme> — terminal background, text and cursor of each attached client.
osc() {
  local bg fg cur tty
  if [[ "$1" == claro ]]; then bg='#f6f7f8'; fg='#24292f'; cur='#0969da'; else bg='#1e1e1e'; fg='#d4d4d4'; cur='#aeafad'; fi
  while IFS= read -r tty; do
    [[ -w "$tty" ]] && printf '\033]11;%s\007\033]10;%s\007\033]12;%s\007' "$bg" "$fg" "$cur" > "$tty"
  done < <(tmux list-clients -F '#{client_tty}' 2>/dev/null)
}

# recolor <theme> — moves the states already painted on each tab to the theme's palette.
recolor() {
  local -A map; local w o v
  if [[ "$1" == claro ]]; then map=([colour82]=colour28 [colour39]=colour25 [colour214]=colour130 [colour196]=colour160 [colour177]=colour90)
  else map=([colour28]=colour82 [colour25]=colour39 [colour130]=colour214 [colour160]=colour196 [colour90]=colour177); fi
  while IFS= read -r w; do
    for o in @csc @cmainc @cctxc; do
      v="$(tmux show -wqv -t "$w" "$o")"; [[ -n "$v" && -n "${map[$v]:-}" ]] && tmux set -w -t "$w" "$o" "${map[$v]}"
    done
  done < <(tmux list-windows -a -F '#{window_id}' 2>/dev/null)
}

apply() {
  local mode actual; mode="$(get tema)"; mode="${mode:-oscuro}"
  if [[ "$mode" == auto ]]; then actual="$(windows_theme)"; else actual="$mode"; fi
  tmux source-file "$dir/theme-$actual.tmux" 2>/dev/null; tmux set -g @theme_mode "$mode"
  osc "$actual"; recolor "$actual"
  # screensaver (tmux-saver)
  local on min; on="$(get protector)"; min="$(get minutos)"
  if [[ "${on:-on}" == on ]]; then tmux set -g lock-after-time $(( ${min:-10} * 60 )) \; set -g @saver on
  else tmux set -g lock-after-time 0 \; set -g @saver off; fi
  tmux set -g lock-command "$HOME/.local/bin/tmux-saver" \; set -g @saver_scene "$(get escena || true)"
  tmux refresh-client -S 2>/dev/null
}

case "${1:-apply}" in
  oscuro|claro|auto) put tema "$1"; apply; tmux display "Theme: $1$([[ $1 == auto ]] && echo " ($(tmux show -gqv @theme_actual))")" ;;
  apply) apply ;;
  check) [[ "$(get tema)" == auto && "$(windows_theme)" != "$(tmux show -gqv @theme_actual)" ]] && apply ;;
  *) echo "usage: tmux-theme oscuro|claro|auto|apply|check" >&2; exit 2 ;;
esac
exit 0
