#!/usr/bin/env python3
"""ws-telemetry — Claude usage by session, turn, project and model, and resources by project.

Implements ADR-008 (local telemetry first). Sources, all local and read-only:
  · Claude Code transcripts (~/.claude/projects/**.jsonl): exact tokens per response
    (input, output, cache written/read, reasoning), model, session, folder, branch, subagents
  · terminal copilot usage (raw/YYYY-MM-DD.jsonl, written by ai-shell.sh)
  · samples of Claude processes (/proc): CPU, memory and disk operations by project
It never stores the text of prompts or responses: only lengths, counts and tool names.
The cost is the EQUIVALENT AT API PRICES (your Team plan is not billed per token); the price
table is in PRICES and can be overridden in ~/.config/ws-telemetry/prices.json.

Usage:
  ws-telemetry build [--if-due]   processes and regenerates the dashboard (with --if-due: if ≥ 1 min has passed)
  ws-telemetry open                regenerates and opens the dashboard in the Windows browser
  ws-telemetry summary             summary in the terminal (today and 7 days, by project)
  ws-telemetry sql                 queries turns and traces with DuckDB (if installed)
  ws-telemetry traces [--days 7] [--json]          tools: uses, times, errors, approx. cost, Bash, MCP, files
  ws-telemetry estimate [--by ticket|branch|project] [--days 90] [--csv|--json] [filter]
                                                    active hours, turns, cost, model, lines and commits by ticket
  ws-telemetry week [YYYY-Www] [--current] [--telegram]     weekly report in Markdown (against the previous week)
  ws-telemetry budgets [--alerts]                 month's spend against ~/.config/ws-telemetry/budgets.conf
  ws-telemetry budgets --override <project> [hours]   lets work go on in a project over a hard budget (24 h by default)
  ws-telemetry prompts [--days 7] [--json] [--alerts [--rate N]]   approval fatigue: approvals per hour, time to answer,
                                                    answers under 2 s and permanent allow rules (WS-AI-006)
  ws-telemetry export                              CSV of turns, traces and estimation for Excel or Power BI
"""
from __future__ import annotations

import datetime as dt
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from collections import Counter, defaultdict
from pathlib import Path

HOME = Path.home()
CLAUDE = Path(os.environ.get("WS_TELEMETRY_CLAUDE", HOME / ".claude"))
DATA = Path(os.environ.get("WS_TELEMETRY_DIR", HOME / ".local/share/ws-telemetry"))
RAW, CACHE = DATA / "raw", DATA / "cache"
RETENTION_DAYS = 395            # 13 months
STATE = Path(os.environ.get("WS_STATE_DIR") or HOME / ".local/state")
REFRESH_S = 60


# ---------------------------------------------------------------------------------------------
# Legacy vocabulary: files written before the kit moved to English keep their Spanish field names and
