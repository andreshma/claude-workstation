#!/usr/bin/env bash
#
# tmux-enjambre — swarm: several Claude instances in parallel on the same goal: each subtask in its own worktree
# and branch, in its own tab, with a progress dashboard and a final integration that YOU approve. Menu → c → Z.
#
#   tmux-enjambre nuevo [goal]     1) you type the goal  2) Claude (Opus, no tools) proposes 2–6 independent
#                                  subtasks  3) you edit them in your editor  4) you confirm  5) it creates
#                                  <repo>.wt/enj-<id>-N with branch enjambre/<id>/N and a tmux group «enj-<id>»:
#                                  tab 0 = dashboard, 1..N = Claude with its subtask (normal permission mode).
#   tmux-enjambre tablero <id>     progress: commits, files, Claude state, last commit (refreshes itself)
#   tmux-enjambre integrar <id>    branch enjambre/<id>/integracion from the base + merge --no-ff of each branch,
#                                  in order. On a conflict it stops and lets you resolve it. Never pushes.
#   tmux-enjambre limpiar <id>     (asks) removes worktrees and tabs; deletes only branches already integrated.
#   tmux-enjambre lista            saved swarms
# State: ~/.local/share/tmux-enjambre/<id>.json. Cost and hours per branch: ws-telemetria estimar --por rama.
set -uo pipefail
D="$HOME/.local/share/tmux-enjambre"; mkdir -p "$D" && chmod 700 "$D"
die() { echo "✖ $*" >&2; exit 1; }
estado() { jq -r "$1" "$D/$2.json"; }

nuevo() {
  local raiz base repo meta id n tareas f i wt rama s
  raiz="$(git rev-parse --show-toplevel 2>/dev/null)" || die "Run this inside a git repo"
  cd "$raiz" || exit 1
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] || die "There are uncommitted changes: commit or stash first (the branches start from HEAD)"
  base="$(git branch --show-current)"; repo="$(basename "$raiz")"
  meta="${*:-}"; [[ -n "$meta" ]] || read -e -r -p 'Swarm goal: ' meta
  [[ -n "${meta// /}" ]] || exit 0
  id="$(date +%m%d-%H%M)"
  f="$(mktemp --suffix=.md)"
  echo "Asking Claude to split it into independent subtasks…"
  {
    echo "# Swarm $id · $repo ($base)"
    echo "# Goal: $meta"
    echo "# One subtask per block, separated by a line with ---. Delete or edit whatever you want."
    echo "# Lines starting with # are ignored. Save and close the editor to continue."
    echo
    git ls-files | head -400 | env -u TMUX_PANE -u TMUX timeout 180 claude -p --model opus --tools "" --no-session-persistence \
      --append-system-prompt "You are a tech lead. Reply ONLY with the subtasks, separated by a line with ---. No introduction. Write them in the language of the goal." \
      "Split this goal into 2 to 4 subtasks that can be done IN PARALLEL by different people, each on its own branch, touching different files to avoid conflicts. For each one: title on the first line, what to do, which files or folders it touches and the done criterion. Goal: $meta. Repo files (stdin)." 2>/dev/null \
      || printf 'Subtask 1: …\n---\nSubtask 2: …\n'
  } > "$f"
  "${EDITOR:-nano}" "$f"
  mapfile -t tareas < <(grep -v '^#' "$f" | awk 'BEGIN{RS="\n---+\n"} {gsub(/^\n+|\n+$/,""); if (length($0)) {gsub(/\n/,"\\n"); print}}')
  n=${#tareas[@]}; (( n >= 1 && n <= 6 )) || die "I need 1 to 6 subtasks (there are $n)"
  echo; for i in "${!tareas[@]}"; do printf '  %d. %s\n' $((i + 1)) "$(head -1 <<<"${tareas[$i]//\\n/$'\n'}")"; done
  read -r -p $'\n'"Create $n worktrees, branches enjambre/$id/1..$n and $n tabs with Claude? [y/N] " s
  [[ "$s" =~ ^([yY]([eE][sS])?|[sS]([iIíÍ])?)$ ]] || { echo "Cancelled."; exit 0; }
  grep -qxF '.enjambre-tarea.md' "$(git rev-parse --git-common-dir)/info/exclude" 2>/dev/null \
    || echo '.enjambre-tarea.md' >> "$(git rev-parse --git-common-dir)/info/exclude"
  tmux new-session -d -s "enj-$id" -n dashboard -c "$raiz"   # the dashboard starts once the state is saved
  local js='[]'
  for i in "${!tareas[@]}"; do
    rama="enjambre/$id/$((i + 1))"; wt="$(dirname "$raiz")/$repo.wt/enj-$id-$((i + 1))"
    git worktree add -q -b "$rama" "$wt" HEAD || die "Could not create the worktree $wt"
    {
      echo "You are part of a swarm: several Claude instances work IN PARALLEL on the same goal, each on its own branch."
      echo "Overall goal: $meta"; echo
      echo "YOUR subtask ($((i + 1)) of $n):"; printf '%b\n' "${tareas[$i]}"; echo
      echo "Rules: work only in this folder ($wt), branch $rama. Do not touch what belongs to other subtasks."
      echo "Make atomic commits with Conventional Commits and without Co-authored-by. Do not push."
      echo "When you finish, reply with «DONE» and a 3-line summary."
    } > "$wt/.enjambre-tarea.md"
    # Spanish on purpose: accented letters are kept in tab names taken from subtask titles typed in Spanish.
    tmux new-window -d -t "enj-$id:" -n "$((i + 1))-$(head -1 <<<"${tareas[$i]//\\n/$'\n'}" | tr -c 'A-Za-z0-9áéíóúñ_-' '-' | cut -c1-18)" -c "$wt" \
      "bash -lc 'claude \"\$(cat .enjambre-tarea.md)\"; exec bash -l'"
    js="$(jq -c --arg r "$rama" --arg w "$wt" --arg t "${tareas[$i]}" '. + [{rama: $r, ruta: $w, tarea: $t}]' <<<"$js")"
  done
  jq -n --arg id "$id" --arg raiz "$raiz" --arg base "$base" --arg meta "$meta" --argjson t "$js" \
    '{id: $id, raiz: $raiz, base: $base, meta: $meta, creado: (now | todate), tareas: $t}' > "$D/$id.json"
  rm -f "$f"
  tmux respawn-window -k -t "enj-$id:dashboard" "'$0' tablero '$id'"
  tmux switch-client -t "enj-$id" 2>/dev/null || echo "Open the group: tmux attach -t enj-$id"
  echo "Swarm $id ready. Dashboard: tab 0 of group enj-$id · Integrate: tmux-enjambre integrar $id"
}

tablero() {
  local id="$1" r c a m e w
  [[ -f "$D/$id.json" ]] || die "Swarm $id does not exist"
  while :; do
    clear; printf '\e[1m🐝 Swarm %s\e[0m · %s\n\e[2mbase %s · %s\e[0m\n\n' "$id" "$(estado .meta "$id" | cut -c1-90)" "$(estado .base "$id")" "$(date +%H:%M:%S)"
    printf '%-26s %7s %9s %-12s %s\n' BRANCH COMMITS FILES CLAUDE "LAST COMMIT"
    while IFS=$'\t' read -r r w; do
      c="$(git -C "$w" rev-list --count "$(estado .base "$id")..HEAD" 2>/dev/null || echo '?')"
      a="$(git -C "$w" diff --name-only "$(estado .base "$id")" 2>/dev/null | wc -l)"
      m="$(git -C "$w" log -1 --format=%s "$(estado .base "$id")..HEAD" 2>/dev/null | cut -c1-50)"
      e="$(tmux list-windows -t "enj-$id" -F '#{pane_current_path}	#{@cs}' 2>/dev/null | awk -F'\t' -v p="$w" '$1 == p {print $2; exit}')"
      printf '%-26s %7s %9s %-12s %s\n' "$r" "$c" "$a" "${e:--}" "${m:--}"
    done < <(jq -r '.tareas[] | [.rama, .ruta] | @tsv' "$D/$id.json")
    printf '\n\e[2mRefreshes every 10 s · i = integrate · q = quit the dashboard\e[0m'
    read -rsn1 -t 10 k && case "$k" in q) exit 0 ;; i) clear; integrar "$id"; read -rsn1 -p 'Press a key to return to the dashboard' ;; esac
  done
}

integrar() {
  local id="$1" raiz base int r s
  [[ -f "$D/$id.json" ]] || die "Swarm $id does not exist"
  raiz="$(estado .raiz "$id")"; base="$(estado .base "$id")"; int="enjambre/$id/integracion"
  cd "$raiz" || exit 1
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] || die "The main repo has uncommitted changes"
  echo "Branches to integrate onto $base:"; jq -r '.tareas[].rama' "$D/$id.json" | while read -r r; do
    printf '  %-26s %s commits\n' "$r" "$(git rev-list --count "$base..$r" 2>/dev/null)"; done
  read -r -p "Create $int and merge --no-ff each one (no push)? [y/N] " s; [[ "$s" =~ ^([yY]([eE][sS])?|[sS]([iIíÍ])?)$ ]] || return 0
  git switch -q -c "$int" "$base" 2>/dev/null || git switch -q "$int" || die "Could not switch to $int"
  while read -r r; do
    git merge-base --is-ancestor "$r" HEAD 2>/dev/null && { echo "  done   $r"; continue; }
    if git merge -q --no-ff --no-edit -m "chore(swarm): integrate $r" "$r"; then echo "  ok     $r"
    elif [[ -n "$(git diff --name-only --diff-filter=U)" ]]; then
      echo "✖ Conflict integrating $r. Resolve it here ($raiz), commit and run again: tmux-enjambre integrar $id"; return 1
    else git merge --abort 2>/dev/null; echo "✖ Could not integrate $r (git error above; not a conflict)"; return 1; fi
  done < <(jq -r '.tareas[].rama' "$D/$id.json")
  echo; git diff --stat "$base"..HEAD | tail -15
  echo "Done on branch $int (no push). Review, test and open the PR whenever you want."
}

limpiar() {
  local id="$1" s r w
  [[ -f "$D/$id.json" ]] || die "Swarm $id does not exist"
  read -r -p "Remove the worktrees and tabs of swarm $id? (branches not integrated are kept) [y/N] " s
  [[ "$s" =~ ^([yY]([eE][sS])?|[sS]([iIíÍ])?)$ ]] || return 0
  cd "$(estado .raiz "$id")" || exit 1
  while IFS=$'\t' read -r r w; do
    git worktree remove "$w" 2>/dev/null || echo "  warn   $w has changes: not removed (git worktree remove --force if you want)"
    git branch -d "$r" >/dev/null 2>&1 && echo "  deleted $r (already integrated)" || echo "  kept    $r"
  done < <(jq -r '.tareas[] | [.rama, .ruta] | @tsv' "$D/$id.json")
  git worktree prune; mv "$D/$id.json" "$D/$id.json.terminado"
  tmux kill-session -t "enj-$id" 2>/dev/null; echo "Swarm $id cleaned up."
}

case "${1:-}" in
  nuevo) shift; nuevo "$@" ;;
  tablero) tablero "${2:?id}" ;;
  integrar) integrar "${2:?id}" ;;
  limpiar) limpiar "${2:?id}" ;;
  lista) for f in "$D"/*.json; do [[ -f "$f" ]] && jq -r '"\(.id)  \(.base)  \(.tareas | length) branches  \(.meta[0:70])"' "$f"; done ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
