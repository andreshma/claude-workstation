#!/usr/bin/env bash
#
# tmux-enjambre — varias instancias de Claude en paralelo sobre la misma meta: cada subtarea en su worktree y su
# rama, en su propia pestaña, con un tablero de avance y una integración final que TÚ apruebas. Menú → c → Z.
#
#   tmux-enjambre nuevo [meta]     1) escribes la meta  2) Claude (Opus, sin herramientas) propone 2–6 subtareas
#                                  independientes  3) las editas en tu editor  4) confirmas  5) se crean
#                                  <repo>.wt/enj-<id>-N con rama enjambre/<id>/N y un grupo tmux «enj-<id>»:
#                                  pestaña 0 = tablero, 1..N = Claude con su subtarea (modo de permisos normal).
#   tmux-enjambre tablero <id>     avance: commits, archivos, estado de Claude, último commit (se refresca solo)
#   tmux-enjambre integrar <id>    rama enjambre/<id>/integracion desde la base + merge --no-ff de cada rama, en
#                                  orden. Si hay conflicto, se detiene y te deja resolverlo. Nunca hace push.
#   tmux-enjambre limpiar <id>     (pregunta) quita worktrees y pestañas; borra solo ramas ya integradas.
#   tmux-enjambre lista            enjambres guardados
# Estado: ~/.local/share/tmux-enjambre/<id>.json. Costo y horas por rama: ws-telemetria estimar --por rama.
set -uo pipefail
D="$HOME/.local/share/tmux-enjambre"; mkdir -p "$D" && chmod 700 "$D"
die() { echo "✖ $*" >&2; exit 1; }
estado() { jq -r "$1" "$D/$2.json"; }

nuevo() {
  local raiz base repo meta id n tareas f i wt rama s
  raiz="$(git rev-parse --show-toplevel 2>/dev/null)" || die "Corre esto dentro de un repo de git"
  cd "$raiz" || exit 1
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] || die "Hay cambios sin commit: haz commit o stash antes (las ramas salen del HEAD)"
  base="$(git branch --show-current)"; repo="$(basename "$raiz")"
  meta="${*:-}"; [[ -n "$meta" ]] || read -e -r -p 'Meta del enjambre: ' meta
  [[ -n "${meta// /}" ]] || exit 0
  id="$(date +%m%d-%H%M)"
  f="$(mktemp --suffix=.md)"
  echo "Pidiendo a Claude una división en subtareas independientes…"
  {
    echo "# Enjambre $id · $repo ($base)"
    echo "# Meta: $meta"
    echo "# Una subtarea por bloque, separadas por una línea con ---. Borra o edita lo que quieras."
    echo "# Las líneas que empiezan con # se ignoran. Guarda y cierra el editor para seguir."
    echo
    git ls-files | head -400 | env -u TMUX_PANE -u TMUX timeout 180 claude -p --model opus --tools "" --no-session-persistence \
      --append-system-prompt "Eres un tech lead. Responde SOLO con las subtareas, separadas por una línea con ---. Sin introducción." \
      "Divide esta meta en 2 a 4 subtareas que puedan hacerse EN PARALELO por personas distintas, cada una en su propia rama, tocando archivos distintos para evitar conflictos. Para cada una: título en la primera línea, qué hacer, qué archivos o carpetas toca y criterio de terminado. Meta: $meta. Archivos del repo (stdin)." 2>/dev/null \
      || printf 'Subtarea 1: …\n---\nSubtarea 2: …\n'
  } > "$f"
  "${EDITOR:-nano}" "$f"
  mapfile -t tareas < <(grep -v '^#' "$f" | awk 'BEGIN{RS="\n---+\n"} {gsub(/^\n+|\n+$/,""); if (length($0)) {gsub(/\n/,"\\n"); print}}')
  n=${#tareas[@]}; (( n >= 1 && n <= 6 )) || die "Necesito de 1 a 6 subtareas (hay $n)"
  echo; for i in "${!tareas[@]}"; do printf '  %d. %s\n' $((i + 1)) "$(head -1 <<<"${tareas[$i]//\\n/$'\n'}")"; done
  read -r -p $'\n'"¿Crear $n worktrees, ramas enjambre/$id/1..$n y $n pestañas con Claude? [s/N] " s
  [[ "$s" =~ ^[sS]$ ]] || { echo "Cancelado."; exit 0; }
  grep -qxF '.enjambre-tarea.md' "$(git rev-parse --git-common-dir)/info/exclude" 2>/dev/null \
    || echo '.enjambre-tarea.md' >> "$(git rev-parse --git-common-dir)/info/exclude"
  tmux new-session -d -s "enj-$id" -n tablero -c "$raiz"   # el tablero arranca cuando el estado ya está guardado
  local js='[]'
  for i in "${!tareas[@]}"; do
    rama="enjambre/$id/$((i + 1))"; wt="$(dirname "$raiz")/$repo.wt/enj-$id-$((i + 1))"
    git worktree add -q -b "$rama" "$wt" HEAD || die "No pude crear el worktree $wt"
    {
      echo "Eres parte de un enjambre: varias instancias de Claude trabajan EN PARALELO sobre la misma meta, cada una en su rama."
      echo "Meta general: $meta"; echo
      echo "TU subtarea ($((i + 1)) de $n):"; printf '%b\n' "${tareas[$i]}"; echo
      echo "Reglas: trabaja solo en esta carpeta ($wt), rama $rama. No toques lo que es de otras subtareas."
      echo "Haz commits atómicos con Conventional Commits y sin Co-authored-by. No hagas push."
      echo "Cuando termines, responde con «LISTO» y un resumen de 3 líneas."
    } > "$wt/.enjambre-tarea.md"
    tmux new-window -d -t "enj-$id:" -n "$((i + 1))-$(head -1 <<<"${tareas[$i]//\\n/$'\n'}" | tr -c 'A-Za-z0-9áéíóúñ_-' '-' | cut -c1-18)" -c "$wt" \
      "bash -lc 'claude \"\$(cat .enjambre-tarea.md)\"; exec bash -l'"
    js="$(jq -c --arg r "$rama" --arg w "$wt" --arg t "${tareas[$i]}" '. + [{rama: $r, ruta: $w, tarea: $t}]' <<<"$js")"
  done
  jq -n --arg id "$id" --arg raiz "$raiz" --arg base "$base" --arg meta "$meta" --argjson t "$js" \
    '{id: $id, raiz: $raiz, base: $base, meta: $meta, creado: (now | todate), tareas: $t}' > "$D/$id.json"
  rm -f "$f"
  tmux respawn-window -k -t "enj-$id:tablero" "'$0' tablero '$id'"
  tmux switch-client -t "enj-$id" 2>/dev/null || echo "Abre el grupo: tmux attach -t enj-$id"
  echo "Enjambre $id listo. Tablero: pestaña 0 del grupo enj-$id · Integrar: tmux-enjambre integrar $id"
}

tablero() {
  local id="$1" r c a m e w
  [[ -f "$D/$id.json" ]] || die "No existe el enjambre $id"
  while :; do
    clear; printf '\e[1m🐝 Enjambre %s\e[0m · %s\n\e[2mbase %s · %s\e[0m\n\n' "$id" "$(estado .meta "$id" | cut -c1-90)" "$(estado .base "$id")" "$(date +%H:%M:%S)"
    printf '%-26s %7s %9s %-12s %s\n' RAMA COMMITS ARCHIVOS CLAUDE "ÚLTIMO COMMIT"
    while IFS=$'\t' read -r r w; do
      c="$(git -C "$w" rev-list --count "$(estado .base "$id")..HEAD" 2>/dev/null || echo '?')"
      a="$(git -C "$w" diff --name-only "$(estado .base "$id")" 2>/dev/null | wc -l)"
      m="$(git -C "$w" log -1 --format=%s "$(estado .base "$id")..HEAD" 2>/dev/null | cut -c1-50)"
      e="$(tmux list-windows -t "enj-$id" -F '#{pane_current_path}	#{@cs}' 2>/dev/null | awk -F'\t' -v p="$w" '$1 == p {print $2; exit}')"
      printf '%-26s %7s %9s %-12s %s\n' "$r" "$c" "$a" "${e:--}" "${m:--}"
    done < <(jq -r '.tareas[] | [.rama, .ruta] | @tsv' "$D/$id.json")
    printf '\n\e[2mSe refresca cada 10 s · i = integrar · q = salir del tablero\e[0m'
    read -rsn1 -t 10 k && case "$k" in q) exit 0 ;; i) clear; integrar "$id"; read -rsn1 -p 'Una tecla para volver al tablero' ;; esac
  done
}

integrar() {
  local id="$1" raiz base int r s
  [[ -f "$D/$id.json" ]] || die "No existe el enjambre $id"
  raiz="$(estado .raiz "$id")"; base="$(estado .base "$id")"; int="enjambre/$id/integracion"
  cd "$raiz" || exit 1
  [[ -z "$(git status --porcelain --untracked-files=no)" ]] || die "El repo principal tiene cambios sin commit"
  echo "Ramas a integrar sobre $base:"; jq -r '.tareas[].rama' "$D/$id.json" | while read -r r; do
    printf '  %-26s %s commits\n' "$r" "$(git rev-list --count "$base..$r" 2>/dev/null)"; done
  read -r -p "¿Crear $int y hacer merge --no-ff de cada una (sin push)? [s/N] " s; [[ "$s" =~ ^[sS]$ ]] || return 0
  git switch -q -c "$int" "$base" 2>/dev/null || git switch -q "$int" || die "No pude cambiar a $int"
  while read -r r; do
    git merge-base --is-ancestor "$r" HEAD 2>/dev/null && { echo "  ya     $r"; continue; }
    if git merge -q --no-ff --no-edit -m "chore(enjambre): integrar $r" "$r"; then echo "  ok     $r"
    elif [[ -n "$(git diff --name-only --diff-filter=U)" ]]; then
      echo "✖ Conflicto al integrar $r. Resuélvelo aquí ($raiz), haz commit y vuelve a correr: tmux-enjambre integrar $id"; return 1
    else git merge --abort 2>/dev/null; echo "✖ No se pudo integrar $r (error de git arriba; no es conflicto)"; return 1; fi
  done < <(jq -r '.tareas[].rama' "$D/$id.json")
  echo; git diff --stat "$base"..HEAD | tail -15
  echo "Listo en la rama $int (sin push). Revisa, prueba y abre el PR cuando quieras."
}

limpiar() {
  local id="$1" s r w
  [[ -f "$D/$id.json" ]] || die "No existe el enjambre $id"
  read -r -p "¿Quitar worktrees y pestañas del enjambre $id? (las ramas sin integrar se conservan) [s/N] " s
  [[ "$s" =~ ^[sS]$ ]] || return 0
  cd "$(estado .raiz "$id")" || exit 1
  while IFS=$'\t' read -r r w; do
    git worktree remove "$w" 2>/dev/null || echo "  aviso  $w tiene cambios: no lo quité (git worktree remove --force si quieres)"
    git branch -d "$r" >/dev/null 2>&1 && echo "  borrada $r (ya integrada)" || echo "  conservo $r"
  done < <(jq -r '.tareas[] | [.rama, .ruta] | @tsv' "$D/$id.json")
  git worktree prune; mv "$D/$id.json" "$D/$id.json.terminado"
  tmux kill-session -t "enj-$id" 2>/dev/null; echo "Enjambre $id limpio."
}

case "${1:-}" in
  nuevo) shift; nuevo "$@" ;;
  tablero) tablero "${2:?id}" ;;
  integrar) integrar "${2:?id}" ;;
  limpiar) limpiar "${2:?id}" ;;
  lista) for f in "$D"/*.json; do [[ -f "$f" ]] && jq -r '"\(.id)  \(.base)  \(.tareas | length) ramas  \(.meta[0:70])"' "$f"; done ;;
  *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
