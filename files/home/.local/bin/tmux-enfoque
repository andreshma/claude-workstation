#!/usr/bin/env bash
#
# tmux-enfoque — focus mode: minimal status bar with a countdown and no Windows notifications for N minutes
# (Telegram stays on: urgent things reach your phone). When it ends, everything goes back and you get notified.
# Menu → Views → f.
# Usage: tmux-enfoque 25|50|90   starts (minutes)
#      tmux-enfoque off          ends early             · tmux-enfoque restante   mm:ss (used by the status bar)
#      tmux-enfoque --menu       picker                  · tmux-enfoque estado
# Log: ~/.local/share/ws-telemetria/enfoque/YYYY-MM-DD.jsonl (planned vs actual, whether you ended it early).
set -uo pipefail
D="$HOME/.local/share/ws-telemetria/enfoque"
fin() { tmux show -gqv @enf_fin; }
registrar() { mkdir -p "$D" && chmod 700 "$D"
  jq -nc --argjson i "$1" --argjson p "$2" --arg c "$3" '{ts: (now | todate), inicio: ($i | todate), planeado_min: $p,
    real_min: (((now - $i) / 60) | floor), completo: ($c == "si")}' >> "$D/$(date +%F).jsonl" 2>/dev/null; }

case "${1:-estado}" in
  --menu)
    m="$0"
    tmux display-menu -T "#[align=centre] Focus mode " -x C -y C \
      "25 minutes" 2 "run-shell -b \"'$m' 25\"" "50 minutes" 5 "run-shell -b \"'$m' 50\"" \
      "90 minutes" 9 "run-shell -b \"'$m' 90\"" "" "#{?@enf_fin,,-}End now" t "run-shell -b \"'$m' off\""
    ;;
  restante)
    f="$(fin)"; [[ -n "$f" ]] || exit 0
    r=$(( f - $(date +%s) )); (( r < 0 )) && r=0; printf '%02d:%02d' $((r / 60)) $((r % 60)) ;;
  estado)
    if [[ -n "$(fin)" ]]; then echo "Focus: $("$0" restante) left"; else echo "Focus: off"; fi ;;
  off|--fin)
    f="$(fin)"; [[ -n "$f" ]] || { tmux display "You are not in focus mode"; exit 0; }
    i="$(tmux show -gqv @enf_ini)"; p="$(tmux show -gqv @enf_plan)"
    tmux set -g status-right "$(tmux show -gqv @enf_prev_right)"
    tmux set -g status-interval "$(tmux show -gqv @enf_prev_int)"
    tmux set -gu @enf_fin; tmux set -gu @enf_ini; tmux set -gu @enf_plan
    if [[ "$1" == --fin ]]; then
      registrar "${i:-0}" "${p:-0}" si
      ws-aviso --forzar "🎯 Your focus block is over (${p} min)" "Check the tabs waiting for you: Ctrl+b m → a"
    else registrar "${i:-0}" "${p:-0}" no; tmux display "Focus mode ended"; fi ;;
  *)
    [[ "$1" =~ ^[0-9]+$ ]] || { sed -n '2,12p' "$0"; exit 2; }
    [[ -n "$(fin)" ]] && "$0" off >/dev/null
    ini=$(date +%s); f=$(( ini + $1 * 60 ))
    tmux set -g @enf_prev_right "$(tmux show -gv status-right)"
    tmux set -g @enf_prev_int "$(tmux show -gv status-interval)"
    tmux set -g @enf_fin "$f"; tmux set -g @enf_ini "$ini"; tmux set -g @enf_plan "$1"
    tmux set -g status-interval 5
    tmux set -g status-right "#[bold] 🎯 focus #(~/.local/bin/tmux-enfoque restante) #[default]"
    tmux run-shell -b "sleep $(( $1 * 60 )); [ \"\$(tmux show -gqv @enf_fin)\" = '$f' ] && '$0' --fin"
    tmux display -d 2500 "🎯 Focus $1 min: no Windows notifications (Telegram stays on). Menu → Views → f to end" ;;
esac
