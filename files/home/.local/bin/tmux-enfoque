#!/usr/bin/env bash
#
# tmux-enfoque — modo enfoque: barra mínima con cuenta regresiva y sin avisos de Windows durante N minutos
# (Telegram sigue: lo urgente te llega al celular). Al terminar, todo vuelve como estaba y te avisa.
# Menú → Sesión → f.
# Uso: tmux-enfoque 25|50|90     empieza (minutos)
#      tmux-enfoque off          termina antes          · tmux-enfoque restante   mm:ss (lo usa la barra)
#      tmux-enfoque --menu       selector                · tmux-enfoque estado
# Registro: ~/.local/share/ws-telemetria/enfoque/AAAA-MM-DD.jsonl (planeado vs real, si lo terminaste antes).
set -uo pipefail
D="$HOME/.local/share/ws-telemetria/enfoque"
fin() { tmux show -gqv @enf_fin; }
registrar() { mkdir -p "$D" && chmod 700 "$D"
  jq -nc --argjson i "$1" --argjson p "$2" --arg c "$3" '{ts: (now | todate), inicio: ($i | todate), planeado_min: $p,
    real_min: (((now - $i) / 60) | floor), completo: ($c == "si")}' >> "$D/$(date +%F).jsonl" 2>/dev/null; }

case "${1:-estado}" in
  --menu)
    m="$0"
    tmux display-menu -T "#[align=centre] Modo enfoque " -x C -y C \
      "25 minutos" 2 "run-shell -b \"'$m' 25\"" "50 minutos" 5 "run-shell -b \"'$m' 50\"" \
      "90 minutos" 9 "run-shell -b \"'$m' 90\"" "" "#{?@enf_fin,,-}Terminar ahora" t "run-shell -b \"'$m' off\""
    ;;
  restante)
    f="$(fin)"; [[ -n "$f" ]] || exit 0
    r=$(( f - $(date +%s) )); (( r < 0 )) && r=0; printf '%02d:%02d' $((r / 60)) $((r % 60)) ;;
  estado)
    if [[ -n "$(fin)" ]]; then echo "Enfoque: quedan $("$0" restante)"; else echo "Enfoque: apagado"; fi ;;
  off|--fin)
    f="$(fin)"; [[ -n "$f" ]] || { tmux display "No estás en modo enfoque"; exit 0; }
    i="$(tmux show -gqv @enf_ini)"; p="$(tmux show -gqv @enf_plan)"
    tmux set -g status-right "$(tmux show -gqv @enf_prev_right)"
    tmux set -g status-interval "$(tmux show -gqv @enf_prev_int)"
    tmux set -gu @enf_fin; tmux set -gu @enf_ini; tmux set -gu @enf_plan
    if [[ "$1" == --fin ]]; then
      registrar "${i:-0}" "${p:-0}" si
      ws-aviso --forzar "🎯 Terminó tu bloque de enfoque (${p} min)" "Revisa las pestañas que te esperan: Ctrl+b m → a"
    else registrar "${i:-0}" "${p:-0}" no; tmux display "Modo enfoque terminado"; fi ;;
  *)
    [[ "$1" =~ ^[0-9]+$ ]] || { sed -n '2,12p' "$0"; exit 2; }
    [[ -n "$(fin)" ]] && "$0" off >/dev/null
    ini=$(date +%s); f=$(( ini + $1 * 60 ))
    tmux set -g @enf_prev_right "$(tmux show -gv status-right)"
    tmux set -g @enf_prev_int "$(tmux show -gv status-interval)"
    tmux set -g @enf_fin "$f"; tmux set -g @enf_ini "$ini"; tmux set -g @enf_plan "$1"
    tmux set -g status-interval 5
    tmux set -g status-right "#[bold] 🎯 enfoque #(~/.local/bin/tmux-enfoque restante) #[default]"
    tmux run-shell -b "sleep $(( $1 * 60 )); [ \"\$(tmux show -gqv @enf_fin)\" = '$f' ] && '$0' --fin"
    tmux display -d 2500 "🎯 Enfoque $1 min: sin avisos de Windows (Telegram sigue). Menú → Sesión → f para terminar" ;;
esac
