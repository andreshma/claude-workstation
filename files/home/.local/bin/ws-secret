#!/usr/bin/env bash
#
# ws-secret — stores and reads secrets in Windows Credential Manager (encrypted with
# your Windows user, DPAPI) from WSL. Nothing is written to Linux files or exported
# variables: the value travels over stdin/stdout between processes.
#
# Usage:
#   ws-secret set NAME        asks for the value without showing it and stores it as "ws/NAME"
#   ws-secret get NAME        prints the value (to capture it in memory: v="$(ws-secret get X)")
#   ws-secret delete NAME     deletes it
#   ws-secret has NAME        exits with 0 if it exists (without printing it)
# The secrets are visible in Windows at: Control Panel → Credential Manager →
# Windows Credentials → Generic Credentials → ws/NAME.
set -euo pipefail
accion="${1:-}"; nombre="${2:-}"
[[ "$accion" =~ ^(set|get|delete|has)$ && "$nombre" =~ ^[A-Za-z0-9._-]+$ ]] \
  || { sed -n '7,11p' "$0" >&2; exit 2; }
PS="$(command -v powershell.exe || true)"
# Without the Windows path in PATH (services launched by tmux or setsid): the standard PowerShell 5.1 path.
[[ -n "$PS" ]] || { p=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe; [[ -x "$p" ]] && PS="$p"; }
[[ -n "$PS" ]] || { echo "✖ ws-secret needs powershell.exe (Windows interop)" >&2; exit 1; }

# PowerShell 5.1 with CredRead/CredWrite from advapi32 (no external modules). It is passed encoded
# so it does not depend on quoting; the secret never goes on the command line.
read -r -d '' SCRIPT <<'PS1' || true
param([string]$Accion, [string]$Nombre)
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'   # without the CLIXML noise of "Preparing modules"
Add-Type -TypeDefinition @"
using System; using System.Runtime.InteropServices; using System.Text;
public static class WsCred {
  [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
  public struct CREDENTIAL {
    public int Flags; public int Type; public string TargetName; public string Comment;
    public System.Runtime.InteropServices.ComTypes.FILETIME LastWritten;
    public int CredentialBlobSize; public IntPtr CredentialBlob; public int Persist;
    public int AttributeCount; public IntPtr Attributes; public string TargetAlias; public string UserName;
  }
  [DllImport("advapi32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
  static extern bool CredRead(string target, int type, int flags, out IntPtr cred);
  [DllImport("advapi32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
  static extern bool CredWrite(ref CREDENTIAL cred, int flags);
  [DllImport("advapi32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
  static extern bool CredDelete(string target, int type, int flags);
  [DllImport("advapi32.dll")] static extern void CredFree(IntPtr cred);
  public static string Read(string t) {
    IntPtr p; if (!CredRead(t, 1, 0, out p)) return null;
    try { var c = (CREDENTIAL)Marshal.PtrToStructure(p, typeof(CREDENTIAL));
          return Marshal.PtrToStringUni(c.CredentialBlob, c.CredentialBlobSize / 2); }
    finally { CredFree(p); }
  }
  public static bool Write(string t, string s) {
    var b = Encoding.Unicode.GetBytes(s); var c = new CREDENTIAL();
    c.Type = 1; c.TargetName = t; c.Persist = 2; c.UserName = Environment.UserName;
    c.CredentialBlobSize = b.Length; c.CredentialBlob = Marshal.AllocCoTaskMem(b.Length);
    try { Marshal.Copy(b, 0, c.CredentialBlob, b.Length); return CredWrite(ref c, 0); }
    finally { Marshal.FreeCoTaskMem(c.CredentialBlob); }
  }
  public static bool Delete(string t) { return CredDelete(t, 1, 0); }
}
"@
$t = "ws/$Nombre"
switch ($Accion) {
  'get'    { $v = [WsCred]::Read($t); if ($null -eq $v) { exit 3 }; [Console]::Out.Write($v) }
  'has'    { if ($null -eq [WsCred]::Read($t)) { exit 3 } }
  'set'    { $v = [Console]::In.ReadLine(); if (-not $v) { exit 4 }; if (-not [WsCred]::Write($t, $v)) { exit 5 } }
  'delete' { if (-not [WsCred]::Delete($t)) { exit 3 } }
}
PS1
# Full script = literal here-string with the code + call with action and name (already validated
# above with a regular expression, so they cannot break the quotes).
enc="$({ printf "\$src = @'\n%s\n'@\n" "$SCRIPT"
         printf "& ([scriptblock]::Create(\$src)) '%s' '%s'\n" "$accion" "$nombre"; } \
       | iconv -f utf-8 -t utf-16le | base64 -w0)"
run() { "$PS" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand "$enc"; }

case "$accion" in
  set)
    if [[ -t 0 ]]; then read -rsp "Value for ws/$nombre (not shown): " v; echo >&2; else IFS= read -r v; fi
    [[ -n "$v" ]] || { echo "✖ empty; nothing stored" >&2; exit 1; }
    printf '%s\n' "$v" | run && echo "✔ stored in Windows Credential Manager as ws/$nombre" >&2
    unset v ;;
  # </dev/null: only "set" reads from stdin; that way PowerShell never waits for input.
  get)    run </dev/null | tr -d '\r' ;;
  has)    run </dev/null >/dev/null 2>&1 ;;
  delete) run </dev/null && echo "✔ deleted ws/$nombre" >&2 ;;
esac
