#!/usr/bin/env bash
#
# _chain <hook> [args] — despachador de los hooks globales de git (core.hooksPath).
# 1) corre la compuerta de la estación (ws-gate) en pre-commit, commit-msg y pre-push;
# 2) después, el hook propio del repo (.git/hooks/<hook>), si existe; así los repos que usan
#    pre-commit, husky u otros siguen funcionando.
# Ojo: un repo con core.hooksPath local (p. ej. husky) reemplaza este despachador.
hook="${1:?hook}"; shift
gate="$HOME/.local/bin/ws-gate"
input=""
[[ "$hook" == pre-push ]] && input="$(cat)"

if [[ -x "$gate" ]]; then
  case "$hook" in
    pre-commit|commit-msg) "$gate" "$hook" "$@" || exit 1 ;;
    pre-push) printf '%s\n' "$input" | "$gate" pre-push "$@" || exit 1 ;;
  esac
fi

own="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/$hook"
if [[ -x "$own" ]]; then
  if [[ "$hook" == pre-push ]]; then printf '%s\n' "$input" | "$own" "$@"; exit $?; fi
  exec "$own" "$@"
fi
exit 0
