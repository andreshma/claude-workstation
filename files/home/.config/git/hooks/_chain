#!/usr/bin/env bash
#
# _chain <hook> [args] — dispatcher for the global git hooks (core.hooksPath).
# 1) runs the workstation gate (ws-gate) on pre-commit, commit-msg and pre-push;
# 2) then the repo's own hook (.git/hooks/<hook>), if it exists; that way repos that use
#    pre-commit, husky or others keep working.
# Note: a repo with a local core.hooksPath (e.g. husky) replaces this dispatcher.
hook="${1:?hook}"; shift
gate="$HOME/.local/bin/ws-gate"
input=""
[[ "$hook" == pre-push ]] && input="$(cat)"

if [[ -x "$gate" ]]; then
  case "$hook" in
    pre-commit|commit-msg) "$gate" "$hook" "$@" || exit 1 ;;
    pre-push) printf '%s\n' "$input" | "$gate" pre-push "$@" || exit 1 ;;
  esac
fi

own="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/$hook"
if [[ -x "$own" ]]; then
  if [[ "$hook" == pre-push ]]; then printf '%s\n' "$input" | "$own" "$@"; exit $?; fi
  exec "$own" "$@"
fi
exit 0
