# menu-usage.tmux — Submenu: usage, traces, estimates, weekly report and budgets.
# Generated by patch 58 (menus with sections). Backspace returns to the previous menu.
# While the menu is open the status bar does not refresh: a refresh redraws the menu on top and flickers.
if -F '#{!=:#{status-interval},0}' 'set -gF @si_prev "#{status-interval}"'
set -g status-interval 0
display-menu -O -T "#[align=centre] 📊  Usage and reports " -x C -y C -- \
  "-#[nodim]── Reports ──" "" "" \
  "Reports ›" i "source-file ~/.config/tmux-claude/menu-usage-reports.tmux" \
  "Learn from me: facts for MemPalace (you choose)" a "display-popup -E -w 92% -h 85% -T ' Learn from me ' \"~/.local/bin/tmux-popup-run ~/.local/bin/tmux-pause 'ws-learn facts'\"" \
  "Create «/» commands from what you repeat" k "display-popup -E -w 92% -h 85% -T ' Custom commands ' \"~/.local/bin/tmux-popup-run ~/.local/bin/tmux-pause 'ws-learn commands'\"" \
  "-#[nodim]── Usage ──" "" "" \
  "Usage dashboard (browser)" c "run-shell -b '~/.local/bin/ws-telemetry open'" \
  "Tools: timings, errors and cost (7 days)" r "display-popup -E -w 92% -h 85% -T ' Tools ' \"~/.local/bin/tmux-popup-run ~/.local/bin/tmux-pause 'ws-telemetry traces'\"" \
  "Estimate per ticket (90 days)" t "display-popup -E -w 92% -h 85% -T ' Estimate ' \"~/.local/bin/tmux-popup-run ~/.local/bin/tmux-pause 'ws-telemetry estimate'\"" \
  "Budgets for the month" p "display-popup -E -w 92% -h 85% -T ' Budgets ' \"~/.local/bin/tmux-popup-run ~/.local/bin/tmux-pause 'ws-telemetry budgets'\"" \
  "Export CSV for Excel or Power BI" x "run-shell -b '~/.local/bin/ws-telemetry export >/dev/null && tmux display \"CSV in %UserProfile%\\ws-telemetry\\data\"'" \
  '' \
  "‹ Back" BSpace "source-file ~/.config/tmux-claude/menu.tmux"
set -gF status-interval '#{?@si_prev,#{@si_prev},15}'
