# menu-views.tmux — Submenu: monitor, focus, second monitor/mirror, popups, history and recording.
# Generated by patch 58 (menus with sections). Backspace returns to the previous menu.
# While the menu is open the status bar does not refresh: a refresh redraws the menu on top and flickers.
if -F '#{!=:#{status-interval},0}' 'set -gF @si_prev "#{status-interval}"'
set -g status-interval 0
display-menu -O -T "#[align=centre] ◫  Views and utilities " -x C -y C -- \
  "-#[nodim]── View ──" "" "" \
  "#{?#{==:#{status},2},Hide,Show} compute monitor (Ctrl+b v)" v "run-shell -b '~/.local/bin/tmux-hud --toggle'" \
  "Focus mode: 25/50/90 min, no notifications" f "run-shell -b '~/.local/bin/tmux-focus --menu'" \
  "Second monitor (same group, independent)" m "run-shell -b '~/.local/bin/tmux-monitor2'" \
  "Read-only mirror (screen sharing)" e "run-shell -b '~/.local/bin/tmux-monitor2 --mirror'" \
  "-#[nodim]── Popups ──" "" "" \
  "Persistent floating shell (Ctrl+b g)" g "display-popup -E -w 80% -h 75% -T ' Shell ' -d \"##{pane_current_path}\" \"~/.local/bin/tmux-popup-run --persistent env WS_TAB=#{window_id} bash -l\"" \
  "Floating PowerShell (Ctrl+b P)" P "display-popup -E -w 80% -h 75% -T ' PowerShell ' \"~/.local/bin/tmux-popup-run ~/.local/bin/tmux-pwsh\"" \
  "-#[nodim]── History and recording ──" "" "" \
  "Search the history of all panes" h "display-popup -E -w 85% -h 75% -T ' History ' \"~/.local/bin/tmux-popup-run ~/.local/bin/tmux-history\"" \
  "Searchable history: #{?#{==:#{@history},on},turn off,turn on}" y "run-shell -b '~/.local/bin/tmux-history #{?#{==:#{@history},on},off,on}'" \
  "#{?@recording,Stop recording,Record this pane}" r "run-shell -b '~/.local/bin/tmux-record #{pane_id}'" \
  "Open the recordings folder" V "run-shell -b 'mkdir -p @WINHOME@/Videos/Claude; explorer.exe \"$(wslpath -w @WINHOME@/Videos/Claude)\" || true'" \
  '' \
  "‹ Back" BSpace "source-file ~/.config/tmux-claude/menu.tmux"
set -gF status-interval '#{?@si_prev,#{@si_prev},15}'
