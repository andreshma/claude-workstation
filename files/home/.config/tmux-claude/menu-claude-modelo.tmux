# menu-claude-modelo.tmux — Submenu: model for this tab (changes only this tab; your default model is not touched).
# Generated by patch 58 (menus with sections). Backspace returns to the previous menu.
# While the menu is open the status bar does not refresh: a refresh redraws the menu on top and flickers.
if -F '#{!=:#{status-interval},0}' 'set -gF @si_prev "#{status-interval}"'
set -g status-interval 0
display-menu -O -T "#[align=centre] Model for this tab · now #{?#{@cmodel},#{@cmodel},—} " -x C -y C -- \
  "Fable 5.2   · architecture, ADRs, exhaustive analysis#{?#{m/i:*fable*,#{@cmodel}}, ✓,}" f "run-shell -b '~/.local/bin/cr --cambiar fable'" \
  "Opus 5.5    · day-to-day, debugging, security#{?#{m/i:*opus*,#{@cmodel}}, ✓,}" o "run-shell -b '~/.local/bin/cr --cambiar opus'" \
  "Sonnet 5.5  · SQL, scoped changes, short texts#{?#{m/i:*sonnet*,#{@cmodel}}, ✓,}" s "run-shell -b '~/.local/bin/cr --cambiar sonnet'" \
  "Haiku 5.5   · searches and simple questions#{?#{m/i:*haiku*,#{@cmodel}}, ✓,}" h "run-shell -b '~/.local/bin/cr --cambiar haiku'" \
  "Claude model picker (Alt+P)" M "send-keys M-p" \
  "-#[nodim]── Automatic routing ──" "" "" \
  "#{?#{==:#{@cruteo},off},Turn on,Turn off} automatic routing in ALL tabs (asks before switching)" r "if -F '#{==:#{@cruteo},off}' 'set -g @cruteo on' 'set -g @cruteo off'" \
  '' \
  "‹ Back" BSpace "source-file ~/.config/tmux-claude/menu-claude.tmux"
set -gF status-interval '#{?@si_prev,#{@si_prev},15}'
