# menu-consumo.tmux — Submenu: usage, traces, estimates, weekly report and budgets.
# Generated by patch 58 (menus with sections). Backspace returns to the previous menu.
# While the menu is open the status bar does not refresh: a refresh redraws the menu on top and flickers.
if -F '#{!=:#{status-interval},0}' 'set -gF @si_prev "#{status-interval}"'
set -g status-interval 0
display-menu -O -T "#[align=centre] 📊  Usage and reports " -x C -y C -- \
  "-#[nodim]── Reports ──" "" "" \
  "Full report with Claude findings (usage, agents, MemPalace, recall)" i "display-popup -E -w 92% -h 85% -T ' Report with Claude ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-informe --ia --ia-memoria --abrir'\"" \
  "Quick report, without Claude" j "display-popup -E -w 92% -h 85% -T ' Quick report ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-informe --abrir'\"" \
  "Learn from me: facts for MemPalace (you choose)" a "display-popup -E -w 92% -h 85% -T ' Learn from me ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-aprender hechos'\"" \
  "Create «/» commands from what you repeat" k "display-popup -E -w 92% -h 85% -T ' Custom commands ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-aprender comandos'\"" \
  "-#[nodim]── Usage ──" "" "" \
  "Usage dashboard (browser)" c "run-shell -b '~/.local/bin/ws-telemetria abrir'" \
  "Tools: timings, errors and cost (7 days)" r "display-popup -E -w 92% -h 85% -T ' Tools ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-telemetria trazas'\"" \
  "Estimate per ticket (90 days)" t "display-popup -E -w 92% -h 85% -T ' Estimate ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-telemetria estimar'\"" \
  "Report for last week" s "display-popup -E -w 92% -h 85% -T ' Week ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-telemetria semana | less -R'\"" \
  "Budgets for the month" p "display-popup -E -w 92% -h 85% -T ' Budgets ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-telemetria presupuestos'\"" \
  "Export CSV for Excel or Power BI" x "run-shell -b '~/.local/bin/ws-telemetria exportar >/dev/null && tmux display \"CSV in %UserProfile%\\ws-telemetria\\datos\"'" \
  '' \
  "‹ Back" BSpace "source-file ~/.config/tmux-claude/menu.tmux"
set -gF status-interval '#{?@si_prev,#{@si_prev},15}'
