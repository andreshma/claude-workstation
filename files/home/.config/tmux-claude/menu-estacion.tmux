# menu-estacion.tmux — Submenu: health, backups, security, Azure, notifications and updates.
# Generated by patch 58 (menus with sections). Backspace returns to the previous menu.
# While the menu is open the status bar does not refresh: a refresh redraws the menu on top and flickers.
if -F '#{!=:#{status-interval},0}' 'set -gF @si_prev "#{status-interval}"'
set -g status-interval 0
display-menu -O -T "#[align=centre] ⚙  Workstation " -x C -y C -- \
  "-#[nodim]── Health and backups ──" "" "" \
  "Workstation check" v "display-popup -E -w 92% -h 85% -T ' Check ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-check; ws-health'\"" \
  "Back up Claude now" b "display-popup -E -w 92% -h 85% -T ' Backup ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-backup-lite'\"" \
  "Test the latest backup" B "display-popup -E -w 92% -h 85% -T ' Backup test ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-restore-lite'\"" \
  "Your personal configuration: sync" P "display-popup -E -w 92% -h 85% -T ' Personal configuration ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-personal sync; ws-personal estado'\"" \
  "Restart Claude in all idle tabs (picks up the new configuration)" R "confirm-before -p \"Exit and re-enter every Claude tab that is not working? They resume their conversation (y/n)\" \"run-shell -b '~/.local/bin/tmux-claude-restart --todas'\"" \
  "Update the workstation from the kit" U "display-popup -E -w 92% -h 85% -T ' Update ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-actualizar'\"" \
  "-#[nodim]── Security and cloud ──" "" "" \
  "Repo quality and security" Q "display-popup -E -w 95% -h 90% -T ' Repo quality ' -d \"#{pane_current_path}\" \"~/.local/bin/tmux-flot-run ~/.local/bin/ws-gate repo-view\"" \
  "Claude audit" u "display-popup -E -w 90% -h 80% -T ' Audit ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'claude-report'\"" \
  "Switch Azure subscription" z "display-popup -E -w 80% -h 70% -T ' Azure subscription ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-az-sub\"" \
  "Installed tools" I "display-popup -E -w 92% -h 85% -T ' Tools ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-pause 'ws-tools'\"" \
  "-#[nodim]── Notifications ──" "" "" \
  "Windows notifications: #{?#{==:#{@cnotify},off},off,on}" n "if -F '#{==:#{@cnotify},off}' 'set -g @cnotify on ; display \"Windows notifications on\"' 'set -g @cnotify off ; display \"Windows notifications off\"'" \
  "Telegram: turn notifications on or off" g "run-shell -b '~/.local/bin/ws-telegram alternar'" \
  "Telegram: text replies on/off (PIN)" G "run-shell -b '~/.local/bin/ws-telegram texto alternar'" \
  '' \
  "‹ Back" BSpace "source-file ~/.config/tmux-claude/menu.tmux"
set -gF status-interval '#{?@si_prev,#{@si_prev},15}'
