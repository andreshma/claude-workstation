# menu-sesion.tmux — Submenu: move between tabs and groups, the current tab, save and restore.
# Generated by patch 58 (menus with sections). Backspace returns to the previous menu.
# While the menu is open the status bar does not refresh: a refresh redraws the menu on top and flickers.
if -F '#{!=:#{status-interval},0}' 'set -gF @si_prev "#{status-interval}"'
set -g status-interval 0
display-menu -O -T "#[align=centre] 🗂  Tabs and session · #S › #W " -x C -y C -- \
  "-#[nodim]── Move around ──" "" "" \
  "Go by number…" N "command-prompt -p 'Tab number:' \"select-window -t ':%%'\"" \
  "Groups and tabs (Alt+←/→ tab, Alt+↑/↓ group)" S "choose-tree -sZ -O name" \
  "-#[nodim]── This tab ──" "" "" \
  "Summary: what, where and where it left off (double click)" i "display-popup -E -w 84% -h 70% -T ' Tab summary ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-resumen\"" \
  "#{?@fav,Remove from favorites ☆,Add to favorites ★} (Ctrl+b *)" '*' "run-shell -b '~/.local/bin/tmux-favoritos --alternar #{window_id}'" \
  "Tab label (Ctrl+b E)" E "run-shell -b '~/.local/bin/tmux-etiqueta --menu #{window_id}'" \
  "Rename tab" r "command-prompt -I \"#W\" \"rename-window -- '%%'\"" \
  "Close tab" x "confirm-before -p \"Close tab #W? (y/n)\" kill-window" \
  "-#[nodim]── Save and restore ──" "" "" \
  "Save session now" s "run-shell ~/.tmux/plugins/tmux-resurrect/scripts/save.sh" \
  "Restore saved session" R "confirm-before -p \"Restore? Tabs that are already open may be duplicated (y/n)\" \"run-shell ~/.tmux/plugins/tmux-resurrect/scripts/restore.sh\"" \
  "Recover tabs from an earlier save" u "display-popup -E -w 90% -h 70% -T ' Recover tabs ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-recuperar\"" \
  "Bring recent conversations into tmux" t "display-popup -E -w 90% -h 80% -T ' Bring conversations ' \"~/.local/bin/tmux-flot-run ~/.local/bin/tmux-traer\"" \
  "Save this tab as a template" G "command-prompt -p 'Template name:' \"run-shell -b '~/.local/bin/tmux-plantilla --guardar %% #{window_id}'\"" \
  '' \
  "‹ Back" BSpace "source-file ~/.config/tmux-claude/menu.tmux"
set -gF status-interval '#{?@si_prev,#{@si_prev},15}'
