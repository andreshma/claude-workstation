# menu-claude-nivel.tmux — Submenu: Claude protection level in this tab (ADR-012). Restarts Claude and resumes the conversation.
# Generated by patch 58 (menus with sections). Backspace returns to the previous menu.
# While the menu is open the status bar does not refresh: a refresh redraws the menu on top and flickers.
if -F '#{!=:#{status-interval},0}' 'set -gF @si_prev "#{status-interval}"'
set -g status-interval 0
display-menu -O -T "#[align=centre] 🛡  Protection · #W · #{?@cnivel,#{@cnivel},normal} " -x C -y C -- \
  "Full: sandbox with no escape hatches + kit rules#{?#{==:#{@cnivel},completo}, ✓,}" c "confirm-before -p \"Restart #W with full protection? Resumes the conversation (y/n)\" \"run-shell -b '~/.local/bin/tmux-nivel completo #{pane_id}'\"" \
  "Normal: your usual configuration#{?@cnivel,, ✓}" n "confirm-before -p \"Restart #W with normal protection? Resumes the conversation (y/n)\" \"run-shell -b '~/.local/bin/tmux-nivel normal #{pane_id}'\"" \
  "Pure: no kit sandbox or permissions (the floor stays)#{?#{==:#{@cnivel},puro}, ✓,}" p "confirm-before -p \"Restart #W as pure Claude (no sandbox; the floor stays)? (y/n)\" \"run-shell -b '~/.local/bin/tmux-nivel puro #{pane_id}'\"" \
  "-#[nodim]── Other ways to start ──" "" "" \
  "#{?#{@csolo},Leave solo mode,Solo mode: auto without sandbox (asks you for critical actions)}" s "confirm-before -p \"#{?#{@csolo},Return #W to normal mode?,Switch #W to solo mode: auto without sandbox?} (y/n)\" \"run-shell -b '~/.local/bin/tmux-solo #{?#{@csolo},normal,esta} #{pane_id}'\"" \
  "Restart without changing the protection (resumes the conversation)" C "confirm-before -p \"Restart Claude in #W? (y/n)\" \"run-shell -b '~/.local/bin/tmux-claude-restart #{pane_id}'\"" \
  "-#[nodim]── View ──" "" "" \
  "Active rules (/permissions)" r "send-keys /permissions Enter" \
  "Sandbox status (/sandbox)" x "send-keys /sandbox Enter" \
  '' \
  "‹ Back" BSpace "source-file ~/.config/tmux-claude/menu-claude.tmux"
set -gF status-interval '#{?@si_prev,#{@si_prev},15}'
