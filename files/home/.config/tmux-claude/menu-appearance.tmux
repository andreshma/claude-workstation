# menu-appearance.tmux — Submenu: theme (dark, light, automatic) and screensaver.
# Generated by patch 58 (menus with sections). Backspace returns to the previous menu.
# While the menu is open the status bar does not refresh: a refresh redraws the menu on top and flickers.
if -F '#{!=:#{status-interval},0}' 'set -gF @si_prev "#{status-interval}"'
set -g status-interval 0
display-menu -O -T "#[align=centre] 🎨  Appearance · theme #{?@theme_mode,#{@theme_mode},dark} " -x C -y C -- \
  "-#[nodim]── Theme ──" "" "" \
  "Dark theme#{?#{==:#{@theme_mode},dark}, ✓,}" o "run-shell '~/.local/bin/tmux-theme dark'" \
  "Light theme#{?#{==:#{@theme_mode},light}, ✓,}" c "run-shell '~/.local/bin/tmux-theme light'" \
  "Automatic: follows Windows#{?#{==:#{@theme_mode},auto}, ✓,}" a "run-shell '~/.local/bin/tmux-theme auto'" \
  "#{?#{@cs},,-}Claude theme in this tab (/theme)" t "send-keys /theme Enter" \
  "-#[nodim]── Screensaver ──" "" "" \
  "Pick a scene from a list (current: #{?@saver_scene,#{@saver_scene},random})" s "display-popup -E -w 80% -h 60% -T ' Screensaver scenes ' \"~/.local/bin/tmux-popup-run ~/.local/bin/tmux-scene\"" \
  "Start it now" p "lock-client" \
  "Next scene" n "run-shell '~/.local/bin/tmux-saver --next-scene'" \
  "Screensaver: #{?#{==:#{@saver},off},off,on (10 min)}" e "run-shell '~/.local/bin/tmux-saver --toggle'" \
  '' \
  "‹ Back" BSpace "source-file ~/.config/tmux-claude/menu.tmux"
set -gF status-interval '#{?@si_prev,#{@si_prev},15}'
