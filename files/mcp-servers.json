{
  "mempalace": {
    "type": "stdio",
    "command": "@WINHOME@/.local/bin/mempalace-mcp.exe",
    "args": [],
    "env": {
      "HF_HUB_OFFLINE": "1",
      "WSLENV": "HF_HUB_OFFLINE"
    },
    "jail": false,
    "jailOptOut": "Windows executable reached through WSL interop: it runs in Windows, outside every Linux namespace, so bubblewrap cannot confine it (ws-mcp-jail refuses it). Residual risk accepted until MemPalace ships a Linux build; ws-audit reports it.",
    "keepalive": true
  },
  "recall": {
    "type": "stdio",
    "command": "@WINHOME@/source/repos/recall/.venv/Scripts/python.exe",
    "args": [
      "-I",
      "-m",
      "recall",
      "mcp"
    ],
    "env": {
      "HF_HUB_OFFLINE": "1",
      "WSLENV": "HF_HUB_OFFLINE"
    },
    "alwaysLoad": true,
    "jail": false,
    "jailOptOut": "Windows Python (.venv/Scripts/python.exe) reached through WSL interop: bubblewrap cannot confine a Windows process. Residual risk accepted until recall runs from a Linux venv; ws-audit reports it.",
    "keepalive": true
  },
  "microsoft-learn": {
    "type": "http",
    "url": "https://learn.microsoft.com/api/mcp"
  },
  "azure": {
    "type": "stdio",
    "command": "@HOME@/.local/share/ws-kit/npm/azure-mcp/node_modules/.bin/azmcp",
    "args": [
      "server",
      "start"
    ],
    "env": {},
    "jail": {
      "net": true,
      "azureConfig": true
    },
    "keepalive": true
  },
  "ms-release-comms": {
    "type": "http",
    "url": "https://www.microsoft.com/releasecommunications/mcp"
  },
  "chrome-devtools": {
    "type": "stdio",
    "command": "@HOME@/.local/share/ws-kit/npm/chrome-devtools-mcp/node_modules/.bin/chrome-devtools-mcp",
    "args": [
      "--isolated",
      "--no-usage-statistics",
      "--no-performance-crux",
      "--redact-network-headers"
    ],
    "env": {
      "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1",
      "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
    },
    "jail": {
      "net": true
    },
    "keepalive": true
  }
}
