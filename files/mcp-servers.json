{
  "mempalace": {
    "type": "stdio",
    "command": "@WINHOME@/.local/bin/mempalace-mcp.exe",
    "args": [],
    "env": {
      "HF_HUB_OFFLINE": "1",
      "WSLENV": "HF_HUB_OFFLINE"
    }
  },
  "recall": {
    "type": "stdio",
    "command": "@WINHOME@/source/repos/recall/.venv/Scripts/python.exe",
    "args": [
      "-I",
      "-m",
      "recall",
      "mcp"
    ],
    "env": {
      "HF_HUB_OFFLINE": "1",
      "WSLENV": "HF_HUB_OFFLINE"
    },
    "alwaysLoad": true
  },
  "microsoft-learn": {
    "type": "http",
    "url": "https://learn.microsoft.com/api/mcp"
  },
  "azure": {
    "type": "stdio",
    "command": "@HOME@/.local/share/ws-kit/npm/azure-mcp/node_modules/.bin/azmcp",
    "args": [
      "server",
      "start"
    ],
    "env": {}
  },
  "ms-release-comms": {
    "type": "http",
    "url": "https://www.microsoft.com/releasecommunications/mcp"
  },
  "chrome-devtools": {
    "type": "stdio",
    "command": "@HOME@/.local/share/ws-kit/npm/chrome-devtools-mcp/node_modules/.bin/chrome-devtools-mcp",
    "args": [
      "--isolated",
      "--no-usage-statistics",
      "--no-performance-crux",
      "--redact-network-headers"
    ],
    "env": {
      "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1",
      "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
    }
  }
}
